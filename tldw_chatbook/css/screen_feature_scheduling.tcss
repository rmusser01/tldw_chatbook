/* ========================================
 * FEATURES: Scheduling
 * ========================================
 * Scheduling workbench specific styles
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent/fr scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


/* The liveness Static + bottom status strip are auto-height siblings of
 * #scheduling-workbench (redesign PR-4 task 5 retired the TabbedContent
 * this rationale used to name); without an explicit 1fr the auto-height
 * workbench row measures its fr children against the whole content area
 * and overflows past the footer. */
#schedules-shell {
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

/* redesign PR-2, Task 3: the bottom status strip (plan ruling 4) -- it sits
 * below the whole workbench, not inside the list pane, hosting the existing
 * SyncStatusWidget (owner indicator + sync health) and a conflicts badge
 * that PUSHES the conflicts view over the list (redesign PR-4 task 5: the
 * Conflicts tab it used to switch to is retired). SyncStatusWidget takes the
 * remaining width so the badge sits flush right; `align` centers the
 * badge (height:1, from .scheduling-queue-chip) against the taller
 * padded SyncStatusWidget row. */
#scheduling-status-strip {
    height: auto;
    border-top: solid $ds-grid-line;
    align: left middle;
}

#scheduling-status-strip > SyncStatusWidget {
    width: $ds-width-fill;
}

#scheduling-workbench {
    layout: horizontal;
    height: $ds-height-fill;
    min-height: $ds-size-10;
    padding: $ds-space-1;
    margin: $ds-space-0;
    overflow: hidden;
    border: solid $ds-grid-line;
}

/* Intentional ~30/45/25 width split for the scheduling workbench design plan,
 * expressed with fr units so the three panes share leftover space with the
 * fixed-width vertical dividers. This avoids percentage-based overflow/wrapping
 * and differs from workflows/acp which use a 25/50/25 fr ratio. */
#scheduling-list-pane { width: $ds-fr-3; min-width: $ds-size-30; border: solid $ds-grid-line; padding: $ds-space-1; }
#scheduling-detail-pane { width: $ds-fr-4; min-width: $ds-size-52; border: solid $ds-grid-line; padding: $ds-space-1; }
#scheduling-inspector-pane { width: $ds-fr-2; min-width: $ds-size-34; border: solid $ds-grid-line; padding: $ds-space-1; }

#scheduling-task-detail-groups,
#scheduling-automation-detail-body {
    height: auto;
}

/* The queue table must fill its pane, or empty queues collapse to a single
 * clipped row at short heights (80x24). */
#scheduling-task-table {
    height: $ds-height-fill;
}

/* redesign PR-4, task 5: the Automations tab's own three-pane split
 * (#scheduling-automations-split / -pane / -detail-pane / -history-pane)
 * is retired with the tab. The ids below that still start with
 * `#scheduling-automation-detail-` are DefinitionDetail's own CHILD ids,
 * not that pane's -- they follow the widget wherever it is mounted. */
#scheduling-automation-detail-empty-state {
    color: $text-muted;
    text-align: center;
    padding: $ds-space-3 $ds-space-1;
}

/* The two detail panes' body cards: the definitions pane's question and
 * (final review F10) the reminder pane's body text, same card. */
#scheduling-automation-detail-question,
#scheduling-task-detail-body-card {
    height: auto;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $text;
}

#scheduling-queue-filter {
    height: $ds-size-1;
    border: none;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    background: $surface-darken-1;
}

/* redesign PR-2, Task 2: the chip row (spec S3) -- compact single-row
 * buttons, same height:1/border:none idiom the filter Input above uses,
 * so the row costs one line rather than a full 3-row Button box. */
#scheduling-queue-chips {
    height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#scheduling-queue-chips .scheduling-queue-chip {
    height: $ds-size-1;
    border: none;
    min-width: $ds-size-8;
    margin-right: $ds-space-1;
    background: $surface-darken-1;
}

/* redesign PR-4, task 6 (spec §11): the collapsed-chip control -- one
 * button standing in for the four named chips below 84 columns. Same
 * flat single-row look as the chips it replaces (it deliberately does
 * NOT carry `.scheduling-queue-chip`: that class is what the compact
 * rule below hides). `display: none` by default, so it only ever appears
 * at the widths where the four chips are gone. */
#scheduling-chip-cycle {
    display: none;
    height: $ds-size-1;
    border: none;
    width: auto;
    min-width: $ds-size-8;
    background: $surface-darken-1;
}

SchedulesWorkbench.schedules-workbench-compact #scheduling-workbench {
    padding: $ds-space-0;
}

/* redesign PR-4, task 6: this used to pin the rail to 24 columns, which
 * left ~20 usable ones -- narrow enough that the header's three Buttons
 * wrapped their labels, and an auto-height row of wrapped Buttons grew to
 * SIXTEEN rows, leaving the queue table a single line at 110x40. Sharing
 * the width with the detail pane (which keeps its own min-width) fits the
 * header on one row again and gives the table back its space. */
SchedulesWorkbench.schedules-workbench-compact #scheduling-list-pane {
    width: $ds-width-fill;
    min-width: $ds-size-28;
}

SchedulesWorkbench.schedules-workbench-compact #scheduling-detail-pane {
    width: $ds-width-fill;
    min-width: $ds-size-32;
}

SchedulesWorkbench.schedules-workbench-compact #scheduling-inspector-pane {
    width: $ds-size-20;
    min-width: $ds-size-16;
}

/* Pane headers */
#scheduling-list-title,
#scheduling-task-detail-header,
#scheduling-task-inspector-header,
#scheduling-automation-detail-header {
    text-style: bold;
    color: $text;
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-0;
    border-bottom: solid $ds-grid-line;
    margin-bottom: $ds-space-1;
}

#scheduling-list-header {
    height: auto;
}

#scheduling-list-header #scheduling-list-title {
    width: $ds-width-fill;
}

#scheduling-new-task {
    width: auto;
    min-width: $ds-size-9;
}

/* redesign PR-2, Task 3: the rail's Mark-all-read button -- hidden by
 * default (see SchedulesWorkbench.on_mount / _update_mark_all_read_
 * visibility), same height:auto row as Create above it. */
#scheduling-mark-all-read {
    width: auto;
    min-width: $ds-size-9;
    margin-left: $ds-space-1;
}

/* redesign PR-4, task 2: the rail's Results relocation affordance,
 * beside Mark-all-read -- same auto-width row shape, always visible
 * (never hidden, unlike Mark-all-read). */
#scheduling-results-badge {
    width: auto;
    min-width: $ds-size-9;
    margin-left: $ds-space-1;
}

/* Empty state */
#scheduling-task-detail-empty-state {
    color: $text-muted;
    text-align: center;
    padding: $ds-space-3 $ds-space-1;
}

/* Lifecycle action row */
#scheduling-task-detail-lifecycle {
    height: auto;
    padding: $ds-space-1 $ds-space-0;
    margin-top: $ds-space-1;
}

#scheduling-task-detail-lifecycle Button {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

/* redesign PR-4, task 4: the legacy transfer action row (schedules-
   handoff spec §6, PR-5 task 7) is retired along with its buttons -- the
   Runs-on row's own dropdown/mini-bar is the one transfer surface now. */

/* task-31823: the reminder pane's second compact action row (Duplicate ·
 * View runs · View results) -- the rest of spec §5's deferred kebab
 * list, same auto-height shape as the lifecycle row above. */
#scheduling-task-detail-secondary-actions {
    height: auto;
    padding: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* Follow-in-Console prominence */
#schedules-follow-in-console {
    margin-top: $ds-space-1;
    width: $ds-width-full;
    text-style: bold;
}

/* schedules-redesign PR-3, Task 4: the definitions pane's header
 * Pause/Resume row -- same one-Button lifecycle-row shape as
 * `#scheduling-task-detail-lifecycle` above. `DefinitionDetail` mounts
 * under two different ids (Automations tab + Queue tab sibling), so both
 * selectors share this declaration rather than one id-scoped rule. */
#scheduling-automation-detail-lifecycle {
    height: auto;
    padding: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* task-31823: the definitions pane's own second compact action row --
 * `.detail-secondary-action-button` above already covers the buttons. */
#scheduling-automation-detail-secondary-actions {
    height: auto;
    padding: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* Status badge base (detail pane) */
#scheduling-task-status-badge {
    width: auto;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    text-style: bold;
    color: $text;
    border: none;
    text-align: center;
}

/* 31712 AC#6: same "empty state replaces the real content" idiom as
 * `#scheduling-task-detail-empty-state` above -- distinguishes "no task
 * selected" from a selected task whose metadata rows read "-" too. */
#scheduling-task-inspector-empty-state {
    color: $text-muted;
    text-align: center;
    padding: $ds-space-3 $ds-space-1;
}

/* Inspector metadata */
#scheduling-inspector-metadata {
    height: auto;
    padding-bottom: $ds-space-1;
}

#scheduling-inspector-metadata Horizontal {
    height: auto;
    width: $ds-width-full;
    padding: $ds-space-0;
    margin: $ds-space-0;
}

.scheduling-inspector-label {
    color: $text-muted;
    padding: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    width: $ds-size-10;
}

.scheduling-inspector-value {
    color: $text;
    width: $ds-width-fill;
    height: auto;
}

#scheduling-conflict-card {
    height: auto;
    margin-top: $ds-space-1;
}

#scheduling-pane-notice {
    color: $text-muted;
    text-style: italic;
    height: auto;
    padding: $ds-space-0;
}
