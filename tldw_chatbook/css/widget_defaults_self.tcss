/* ===== WIDGET: ConsolePromptQueueRegion (UI/Console_Modules/prompt_queue.py) ===== */

    ConsolePromptQueueRegion {
        display: none;
        height: 1;
        min-height: 1;
        max-height: 1;
        width: 100%;
        background: $panel;
        color: $text;
    }

    ConsolePromptQueueRegion.-visible {
        display: block;
    }

    ConsolePromptQueueRegion > #console-prompt-queue-row {
        height: 1;
        width: 100%;
        layout: horizontal;
    }









    ConsolePromptQueueRegion.-narrow #console-prompt-queue-preview {
