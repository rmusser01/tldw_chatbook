/* ===== WIDGET: MainNavigationBar (UI/Navigation/main_navigation.py) ===== */

    MainNavigationBar {
        height: 3;
        min-height: 3;
        width: 100%;
        dock: top;
        background: $background;
        border-bottom: solid $surface-lighten-2;
        layout: horizontal;
        overflow: hidden;
