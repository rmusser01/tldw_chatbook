/* ========================================
 * COMPONENTS: Buttons
 * ======================================== 
 * All button variants and states
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


/* Base button style with enhanced UX */
Button {
    /* No border by default - rely on background color for visual appearance */
    border: none;
}

/* Shared hover state with readable, non-obscuring cues */
Button:hover {
    background: $ds-hover-bg;
    color: $ds-hover-fg;
    text-style: $ds-text-strong;
}

/* Enhanced focus state with visible, non-obscuring cues */
Button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

/* When both hovering AND focused */
Button:hover:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

/* Disabled state.
   TASK-25822: the darkened surface plus muted-but-readable text IS the cue --
   an additional `opacity: 50%` composited the label down to 1.34:1 and made
   the control look absent. Two non-colour cues remain (surface + weight). */
Button:disabled,
Button.-style-default:disabled,
Button.-style-flat:disabled {
    opacity: 100%;
    text-opacity: 100%;
    text-style: none;
    background: $ds-disabled-bg;
    color: $ds-text-disabled-readable;
}

Button:disabled:hover {
    background: $ds-disabled-bg;
    text-style: none;
}

.sidebar-toggle {
    width: $ds-width-fill;              /* Equal flexible width */
    height: $ds-control-height;
    /* margin-right: 1; Removed default margin, apply specific below */
    border: none;
    /* Enabled but recessed chrome: sunken resting surface, not the
       disabled token (PR #2632 review follow-up). */
    background: $ds-surface-sunken;
    color: $ds-text-primary;
}
.sidebar-toggle:hover { background: $ds-surface-raised; }

.action-button {
    margin-right: $ds-space-inline;
    min-width: $ds-size-12;
}

.action-button.primary {
    background: $primary;
    color: $text;
}

.action-button.primary.large {
    min-width: $ds-size-20;
    height: $ds-size-3;
    text-style: $ds-text-strong;
}

.button-group {
    width: $ds-width-full;
    height: auto;
    margin: $ds-space-section $ds-space-0;
}

.button-group-left {
    align: left top;
}

.button-group-center {
    align: center top;
}

.button-group-right {
    align: right top;
}
