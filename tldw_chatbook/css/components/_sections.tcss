/* COMPONENTS: Sections — canonical .section-title/.section-header/
 * .subsection-title, usage-weight winners tokenized on arrival
 * (ADR-161 task 4). */

.section-title {
    text-style: $ds-text-strong;
    color: $primary;
    text-align: center;
    height: auto;
    margin-bottom: $ds-space-section;
}

.section-header {
    text-style: $ds-text-strong;
    color: $primary;
    /* Former stats_screen.css global defaults; its separate padding-left
       rule reset the other edges to zero in Textual. Preserve that computed
       geometry when consolidating the final duplicate into this owner. */
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
    margin-top: $ds-space-2;
    margin-bottom: $ds-space-1;
    border-left: thick $primary;
}

.subsection-title {
    text-style: $ds-text-strong;
    color: $secondary;
    /* 4 values: Textual rejects 3 */
    margin: $ds-space-section $ds-space-0 $ds-space-stack $ds-space-0;
}
