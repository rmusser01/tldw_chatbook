/* ========================================
 * COMPONENTS: DS Primitives (atomic layer)
 * ========================================
 * The token-native primitive containers that grew up inside the
 * agentic-terminal monolith and form the base layer other families
 * compose from: panels, toolbars, field rows, callouts, approval cards,
 * and the destination header. Family reference:
 * backlog/docs/component-patterns.md (ADR-161).
 *
 * ADR-161 task 9: extracted from components/_agentic_terminal.tcss and
 * tokenized on arrival; FIRST among the component sheets so later
 * component/feature sheets override at equal specificity exactly as they
 * did when these rules sat later in the manifest. The move is
 * bundle-internal only (two-track rule): the per-screen
 * screen_agentic_*.tcss sources are untouched, and no local $ds-*
 * fallbacks live here.
 *
 * Density variants: the .density-compact/.density-comfortable halves that
 * touch THIS family's classes ride with the family; the ds-inspector /
 * ds-recovery-callout halves of the same comma rules stay in the monolith
 * (those classes are not family members -- task 10 decides their home).
 * ======================================== */

.ds-destination-header {
    height: auto;
    min-height: $ds-destination-header-min-height;
    padding: $ds-space-1 $ds-space-2;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: tall $ds-action-focus;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-style: $ds-text-strong;
}

.ds-panel {
    height: auto;
    min-height: $ds-panel-min-height;
    padding: $ds-space-1 $ds-space-2;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.ds-approval-card {
    height: auto;
    padding: $ds-space-1 $ds-space-2;
    border: thick $ds-status-approval-required;
    background: $ds-status-approval-required 12%;
    color: $ds-text-primary;
}

/* Field rows are label-above-value: every current user (Personas card and
   editors) composes them as Vertical containers, so the row must not force a
   horizontal layout (it jammed "Name"+value side by side and squeezed Inputs
   into the leftover width). */
.ds-field-row {
    height: auto;
    min-height: $ds-field-row-min-height;
    padding: $ds-space-0 $ds-space-1;
}

.ds-toolbar {
    height: auto;
    min-height: $ds-toolbar-min-height;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.ds-info-callout {
    border: round $ds-status-info;
    background: $ds-status-info 10%;
    padding: $ds-space-0 $ds-space-1;
    height: auto;
}

.density-compact .ds-panel,
.density-compact .ds-approval-card {
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.density-compact .ds-destination-header {
    min-height: $ds-destination-header-compact-min-height;
    padding: $ds-space-0 $ds-space-1;
}

.density-comfortable .ds-panel,
.density-comfortable .ds-approval-card {
    padding: $ds-space-1 $ds-space-2;
    margin: $ds-space-1 $ds-space-1;
}

.density-comfortable .ds-destination-header {
    min-height: $ds-destination-header-comfortable-min-height;
    padding: $ds-space-1 $ds-space-2;
}
