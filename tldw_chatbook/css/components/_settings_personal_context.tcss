/* Canonical Settings > My Profile. Dense, text-labelled, narrow-safe controls. */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


#personal-context-settings-panel {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    padding: $ds-space-0 $ds-space-1 $ds-space-1 $ds-space-1;
}

#personal-context-status {
    width: auto;
    height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    text-style: bold;
}

.personal-context-toolbar {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-gutter: 0 1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.personal-context-toolbar Button {
    width: $ds-width-full;
    min-width: $ds-size-0;
    margin: $ds-space-0;
}

.personal-context-scope-row {
    height: auto;
    min-height: $ds-size-3;
}

.personal-context-scope-row Select {
    width: $ds-width-fill;
    min-width: $ds-size-12;
}

#personal-context-record-list {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    max-height: $ds-size-10;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.personal-context-record-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-3;
    margin: $ds-space-0;
    text-align: left;
}

.personal-context-record-selected {
    border-left: thick $accent;
}

#personal-context-editor {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    margin: $ds-space-1 $ds-space-0;
}

#personal-context-editor Input,
#personal-context-editor Select {
    width: $ds-width-full;
    min-width: $ds-size-0;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#personal-context-editor-error {
    color: $error;
    height: auto;
    min-height: $ds-size-1;
}

RecoveryPassphraseDialog {
    align: center middle;
}

#personal-context-recovery-dialog {
    width: $ds-size-60;
    max-width: $ds-percent-92;
    height: auto;
    padding: $ds-space-1 $ds-space-2;
    border: thick $accent;
    background: $surface;
}

#personal-context-recovery-dialog Input {
    width: $ds-width-full;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#personal-context-recovery-dialog .button-container {
    width: $ds-width-full;
    height: auto;
    align: center middle;
}

#settings-workbench.settings-workbench-compact #personal-context-settings-panel {
    padding: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#settings-workbench.settings-workbench-compact .personal-context-toolbar {
    grid-size: 1;
    grid-columns: 1fr;
    grid-gutter: 0;
}

#settings-workbench.settings-workbench-compact .personal-context-scope-row {
    layout: vertical;
}

#settings-workbench.settings-workbench-compact .personal-context-scope-row .settings-input-label,
#settings-workbench.settings-workbench-compact .personal-context-scope-row Select {
    width: $ds-width-full;
}
