    min-height: 1;
    max-height: 1;
    margin: 0;
}

#library-shell-grid.library-notes-compact #library-note-loading {
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#library-shell-grid.library-notes-compact #library-note-loading-viewport {
    height: 1fr;
    min-height: 0;
    margin: 0;
    overflow-y: auto;
    overflow-x: hidden;
}

/* TASK-19010: lasting Notes sync inherits the retained Neon Workbench canvas.
   Authority/status and the nearest valid action stay fixed; setup, review, and
   recovery effects share one bounded scroll owner at the 60x20 floor. */
.library-notes-lasting-sync-canvas {
    width: 100%;
    height: 1fr;
    min-height: 0;
    padding: 0 1;
    overflow: hidden;
}

#notes-sync-authority,
#notes-sync-roots-authority,
.library-notes-lasting-status {
    width: 100%;
    height: auto;
    min-height: 1;
    max-height: 2;
    text-wrap: wrap;
    text-overflow: clip;
}

#notes-sync-body,
#notes-sync-roots-body {
    width: 100%;
    height: 1fr;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-gutter: stable;
}

#notes-sync-pinned-actions,
#notes-sync-roots-pinned-actions {
    width: 100%;
    height: auto;
    min-height: 1;
    max-height: 3;
    background: $surface-darken-1;
}

#notes-sync-fold-hint,
#notes-sync-disconnect-copy,
.library-disabled-reason {
    width: 100%;
    height: auto;
    min-height: 1;
    max-height: 2;
    color: $text-muted;
    background: $surface-darken-1;
    text-wrap: wrap;
    text-overflow: clip;
}

.library-notes-sync-review-row,
.library-notes-sync-root-row,
.library-notes-sync-root-actions {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.library-notes-sync-attention-actions {
    width: 100%;
    height: auto;
    min-height: 1;
}

.library-notes-sync-conflict-choices,
.library-notes-sync-comparison,
.library-notes-sync-receipt,
.library-notes-sync-history-row {
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 1;
    overflow: hidden;
}

.library-notes-sync-comparison,
.library-notes-sync-receipt,
.library-notes-sync-history-row {
    margin: 0 0 1 0;
    padding: 0 1;
    background: $surface-darken-1;
}

.notes-sync-conflict-view,
.library-notes-sync-attention-actions > .notes-sync-conflict-choice {
    width: 100%;
    min-width: 0;
}

.notes-sync-conflict-choice.is-selected {
    background: $accent 18%;
    text-style: bold;
}

.notes-sync-conflict-title,
.notes-sync-conflict-path,
.notes-sync-conflict-effect,
.notes-sync-conflict-selected {
    width: 100%;
    height: auto;
    min-height: 1;
    text-wrap: wrap;
    text-overflow: clip;
}

.notes-sync-conflict-path,
.notes-sync-conflict-effect,
.notes-sync-conflict-selected {
    color: $text-muted;
}

.notes-sync-comparison-diff {
    width: 100%;
    min-width: 0;
    height: 8;
    min-height: 4;
    overflow-x: auto;
    overflow-y: auto;
}

.notes-sync-receipt-actions,
.notes-sync-history-actions {
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 1;
}

.notes-sync-receipt-actions > Button,
.notes-sync-history-actions > Button {
    min-width: 0;
}

.notes-sync-history-page {
    width: auto;
    min-width: 6;
    height: 1;
    content-align: left middle;
}

.library-notes-sync-root-status {
    color: $text-muted;
}

.library-notes-sync-root-actions > Button {
    width: 100%;
}

.library-notes-sync-attention-actions > Button {
    width: 100%;
}

#library-shell-grid.library-notes-compact .library-notes-lasting-sync-canvas {
    padding: 0;
}

#library-shell-grid.library-notes-compact #notes-sync-authority,
#library-shell-grid.library-notes-compact #notes-sync-roots-authority,
#library-shell-grid.library-notes-compact .library-notes-lasting-status,
#library-shell-grid.library-notes-compact #notes-sync-fold-hint {
    height: 1;
    min-height: 1;
    max-height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* Governed Console exchange capture surfaces (ADR-089). */
#console-inspector-policy-status {
    height: auto;
    color: $text-muted;
}

ConsoleCapturePolicyDialog,
ConsoleExchangeExportDialog {
    align: center middle;
}

#capture-policy-dialog,
#exchange-export-dialog {
    width: 76;
    max-width: 96%;
    height: 22;
    max-height: 96%;
    border: tall $primary;
    background: $surface;
    padding: 1 2;
}

#capture-policy-title,
#exchange-export-title {
    height: 1;
    text-style: bold;
}

#capture-policy-body,
#exchange-export-body {
    height: 1fr;
    scrollbar-gutter: stable;
}

#capture-policy-scopes,
#capture-policy-details,
#exchange-export-profiles,
#exchange-export-destinations {
    height: auto;
}

#capture-policy-effective,
#capture-policy-reason,
#capture-policy-count,
#capture-policy-status,
#exchange-export-profile-copy,
#exchange-export-full-reason,
#exchange-export-status {
    height: auto;
}

#capture-policy-reason,
#exchange-export-full-reason {
    color: $warning;
}

#capture-policy-actions,
#exchange-export-actions {
    height: 3;
    min-height: 3;
    align-horizontal: right;
}

#capture-policy-actions Button,
#exchange-export-actions Button {
    min-width: 10;
    margin-left: 1;
}

#capture-policy-status.-error,
#exchange-export-status.-error {
    color: $error;
}

#exchange-export-path {
    height: 3;
}
