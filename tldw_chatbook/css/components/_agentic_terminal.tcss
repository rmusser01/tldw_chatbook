/* ========================================
 * COMPONENTS: Agentic Terminal Design System
 * ========================================
 * Shared shell primitives for Home, Console, destination wrappers, status,
 * recovery, source authority, approvals, events, forms, toolbars, and shortcuts.
 *
 * Semantic token contract:
 * ds-surface-panel, ds-text-primary, ds-action-focus,
 * ds-status-ready, ds-status-running, ds-status-warning, ds-status-error,
 * ds-status-paused, ds-status-blocked, ds-status-approval-required,
 * ds-authority-local, ds-authority-server, ds-authority-workspace,
 * ds-source-role-context, ds-source-role-evidence,
 * ds-source-role-editable-target, ds-source-role-output-seed.
 *
 * Required readable status labels:
 * Ready, Running, Paused, Blocked, Unavailable, Approval required, Unsaved, Recovered.
 * ======================================== */

.ds-destination-header {
    height: auto;
    min-height: 3;
    padding: 1 2;
    margin: 0 0 1 0;
    border: tall $ds-action-focus;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-style: bold;
}

.ds-panel {
    height: auto;
    min-height: 3;
    padding: 1 2;
    margin: 0 0 1 0;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.ds-inspector {
    height: auto;
    min-width: 24;
    padding: 1;
    border: round $ds-grid-line;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
}

.ds-status-badge {
    width: auto;
    height: 1;
    padding: 0 1;
    text-style: bold;
    color: $ds-text-primary;
    background: $ds-surface-raised;
}

/* F-054/F-057: these two badges carry whole SENTENCES (the inspector's
   empty-state explainer, the servers-mode aggregate summary), not one-word
   chips -- they must wrap at narrow widths instead of clipping mid-word.
   ID selectors beat the `.ds-status-badge` class rule above on
   specificity; every other `.ds-status-badge` consumer keeps the fixed
   height. `width: 1fr` is required alongside: the class rule's
   `width: auto` would otherwise size the badge to its content's natural
   width (no wrap at all -- the line just overflows its pane). Kept in
   lockstep with the matching overrides in MCPInspector.DEFAULT_CSS and
   MCPServersMode.DEFAULT_CSS, which cover the bare test harnesses that
   never load this bundle. */
#mcp-inspector-state,
#mcp-overview-summary {
    width: 1fr;
    height: auto;
    min-height: 1;
}

.ds-recovery-callout {
    height: auto;
    padding: 1 2;
    border: round $ds-status-warning;
    background: $ds-status-warning 10%;
    color: $ds-text-primary;
}

.ds-source-role {
    width: auto;
    height: 1;
    padding: 0 1;
    border: round $ds-source-role-context;
    color: $ds-text-primary;
    background: $ds-surface-raised;
}

.ds-approval-card {
    height: auto;
    padding: 1 2;
    border: thick $ds-status-approval-required;
    background: $ds-status-approval-required 12%;
    color: $ds-text-primary;
}

.ds-event-row {
    height: auto;
    min-height: 1;
    padding: 0 1;
    border-bottom: solid $ds-grid-line;
    color: $ds-text-primary;
}

/* Field rows are label-above-value: every current user (Personas card and
   editors) composes them as Vertical containers, so the row must not force a
   horizontal layout (it jammed "Name"+value side by side and squeezed Inputs
   into the leftover width). */
.ds-field-row {
    height: auto;
    min-height: 2;
    padding: 0 1;
}

.ds-toolbar {
    height: auto;
    min-height: 1;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

/* task-2853 review round 2: the "N selected" counter that opens a
   Select-mode ds-toolbar row (Library media/conversations/notes canvases)
   had no explicit width, so inside this Horizontal it resolved as
   unbounded and claimed nearly the entire row -- live tmux verification
   (a real 170-column terminal, not a headless Pilot test) showed it
   pushing every sibling Button off-screen entirely: present in the DOM
   (query_one finds it fine) but genuinely invisible on screen. General
   rule for every such counter, not a one-off: pin it to its own content
   width, the same value Button's own DEFAULT_CSS already uses for its
   siblings in that row. */
.library-toolbar-count {
    width: auto;
}

ConsoleSettingsModal {
    align: center middle;
}

#console-settings-modal {
    width: 92;
    max-width: 95%;
    height: 90%;
    max-height: 95%;
    overflow: hidden;
    scrollbar-size: 1 1;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: 1 2;
}

#console-settings-body {
    height: 1fr;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

.console-settings-modal-section {
    height: auto;
    margin: 1 0 0 0;
}

.console-settings-primary-section {
    padding: 0 1;
    border: round $ds-action-focus;
    background: $ds-surface-raised;
}

.console-settings-modal-row {
    height: auto;
    min-height: 1;
}

.console-settings-modal-label {
    width: 16;
    min-width: 16;
    max-width: 16;
    height: 1;
    min-height: 1;
    content-align: left middle;
}

.console-settings-control {
    width: 1fr;
    min-width: 0;
}

ConsoleSettingsModal Input {
    width: 1fr;
    min-width: 0;
    height: 3;
    min-height: 3;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

ConsoleSettingsModal Select {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

ConsoleSettingsModal Checkbox {
    height: 1;
    min-height: 1;
}

ConsoleSettingsModal Select > SelectCurrent {
    width: 1fr;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    content-align: left middle;
}

ConsoleSettingsModal Select > SelectCurrent Static#label {
    width: 1fr;
    height: 1;
    background: transparent;
    color: $ds-text-primary;
}

ConsoleSettingsModal Select > SelectCurrent .arrow {
    background: transparent;
    color: $ds-text-muted;
}

ConsoleSettingsModal Input:focus {
    height: 3;
    min-height: 3;
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

ConsoleSettingsModal Input > .input--cursor {
    background: $ds-input-focus-accent;
    color: $ds-surface-panel;
}

ConsoleSettingsModal Input > .input--selection {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}

ConsoleSettingsModal Select:focus {
    border: none;
    border-bottom: none;
    outline: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

ConsoleSettingsModal Select:focus > SelectCurrent {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

ConsoleSettingsModal Select > SelectOverlay {
    padding: 0 1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    min-width: 30;
}

ConsoleSettingsModal Select > SelectOverlay Option {
    padding: 0 2;
    min-height: 3;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
}

ConsoleSettingsModal Select > SelectOverlay Option:hover {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

ConsoleSettingsModal Select > SelectOverlay Option.-selected {
    padding: 0 2;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-settings-modal-actions {
    height: 1;
    min-height: 1;
    margin: 1 0 0 0;
    align-horizontal: right;
}

#console-settings-cancel,
#console-settings-save {
    width: 12;
    min-width: 12;
    height: 1;
    min-height: 1;
}

.console-settings-error {
    height: auto;
    min-height: 1;
    max-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $ds-status-error 10%;
    color: $ds-text-primary;
}

ConsolePromptPickerModal {
    align: center middle;
}

#console-prompt-picker-modal {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 85%;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: 1 2;
}

#console-prompt-picker-filter {
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-prompt-picker-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

#console-prompt-picker-results {
    height: auto;
    max-height: 20;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

.console-prompt-picker-row {
    width: 100%;
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-prompt-picker-row-highlighted {
    border: tall $ds-action-focus;
    background: $ds-input-focus-bg;
    text-style: bold;
}

.console-prompt-picker-row-blocked {
    color: $ds-text-muted;
}

#console-prompt-picker-reason {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $ds-status-error 10%;
    color: $ds-text-primary;
}

#console-prompt-picker-empty {
    height: auto;
    margin: 1 0;
    color: $ds-text-muted;
}

ConsoleStylePickerModal {
    align: center middle;
}

#console-style-picker-modal {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 85%;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: 1 2;
}

#console-style-picker-filter {
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-style-picker-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

#console-style-picker-results {
    height: auto;
    max-height: 20;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

.console-style-picker-row {
    width: 100%;
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-style-picker-row-highlighted {
    border: tall $ds-action-focus;
    background: $ds-input-focus-bg;
    text-style: bold;
}

#console-style-picker-empty {
    height: auto;
    margin: 1 0;
    color: $ds-text-muted;
}

#console-style-picker-detail {
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-muted;
}

ConsoleSystemPromptModal {
    align: center middle;
}

#console-system-prompt-modal {
    width: 84;
    max-width: 95%;
    height: 32;
    max-height: 90%;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: 1 2;
}

.console-system-prompt-row {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.console-system-prompt-label {
    width: 8;
    min-width: 8;
    max-width: 8;
    height: 1;
    min-height: 1;
    content-align: left middle;
}

#console-system-prompt-scope {
    color: $ds-text-muted;
}

#console-system-prompt-text {
    width: 100%;
    height: 1fr;
    min-height: 10;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-system-prompt-text:focus {
    border: tall $ds-input-focus-accent;
    background: $ds-input-focus-bg;
}

#console-system-prompt-name {
    width: 1fr;
    min-width: 0;
    height: 3;
    min-height: 3;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-system-prompt-save-status {
    color: $ds-text-muted;
}

.console-system-prompt-actions {
    height: 3;
    min-height: 3;
    align-horizontal: right;
}

/* TASK-199: one shared Prompt-variable dialog for Console and Library lanes.
   Only the variable field owns scrolling; destination, authorization, status,
   and actions remain fixed and reachable at the 64x24 support floor. */
PromptVariablesDialog {
    align: center middle;
}

#prompt-variables-dialog {
    width: 76;
    max-width: 96%;
    height: 90%;
    max-height: 36;
    min-height: 18;
    padding: 1 2;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    overflow-x: hidden;
    overflow-y: hidden;
}

#prompt-variables-destination {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

#prompt-variables-system-authorization {
    width: 100%;
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

#prompt-variables-dialog #prompt-variables-apply-system {
    width: 5;
    min-width: 5;
    max-width: 5;
    height: 3;
    min-height: 3;
    padding: 0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-overflow: clip;
}

#prompt-variables-system-state {
    width: 5;
    min-width: 5;
    max-width: 5;
    height: 3;
    min-height: 3;
    content-align: center middle;
    color: $ds-text-primary;
    text-style: bold;
}

#prompt-variables-system-copy {
    width: 1fr;
    min-width: 0;
    height: 2;
    min-height: 2;
    content-align: left top;
    color: $ds-text-primary;
    text-wrap: wrap;
    text-overflow: clip;
}

#prompt-variables-scroll {
    width: 100%;
    height: 1fr;
    min-height: 3;
    border-top: solid $ds-grid-line;
    border-bottom: solid $ds-grid-line;
    background: $ds-surface-panel;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

.prompt-variable-row {
    width: 100%;
    height: auto;
    min-height: 5;
    margin: 0 0 1 0;
}

.prompt-variable-label {
    width: 100%;
    height: auto;
    min-height: 1;
    color: $ds-text-muted;
}

#prompt-variables-dialog .prompt-variable-input {
    width: 100%;
    height: 3;
    min-height: 3;
    border: none;
    border-left: solid $ds-grid-line;
    background: $surface-darken-1;
    color: $ds-text-primary;
}

#prompt-variables-dialog .prompt-variable-input:focus {
    border-left: thick $ds-action-focus;
    background: $ds-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#prompt-variables-status {
    width: 100%;
    height: 1;
    min-height: 1;
    color: $ds-status-warning;
}

#prompt-variables-actions {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 1 0 0 0;
    align-horizontal: right;
}

#prompt-variables-cancel,
#prompt-variables-original,
#prompt-variables-apply {
    height: 3;
    min-height: 3;
    margin: 0 0 0 1;
    border: none;
}

#prompt-variables-cancel,
#prompt-variables-apply {
    width: 10;
    min-width: 10;
}

#prompt-variables-original {
    width: 27;
    min-width: 27;
}

#prompt-variables-actions Button:focus {
    outline: heavy $ds-action-focus;
}

#prompt-variables-actions Button:disabled {
    opacity: 100%;
    text-opacity: 100%;
    background: $surface-darken-1;
    color: $text-muted;
}

/* TASK-870: "View full log" read-only run-log viewer, sized/laid out the
   same way as the system prompt editor above (a large text body plus a
   single action row), minus the multi-field editing chrome that modal
   doesn't need. */
ConsoleRunLogModal {
    align: center middle;
}

#console-run-log-modal {
    width: 96;
    max-width: 95%;
    height: 36;
    max-height: 90%;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: 1 2;
}

#console-run-log-text {
    width: 100%;
    height: 1fr;
    min-height: 10;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-run-log-actions {
    height: 3;
    min-height: 3;
    align-horizontal: right;
    margin: 1 0 0 0;
}

#console-system-prompt-clear,
#console-system-prompt-cancel,
#console-system-prompt-apply {
    width: 12;
    min-width: 12;
    height: 3;
    min-height: 3;
}

#home-dashboard,
#console-shell,
#library-shell,
#artifacts-shell,
#personas-shell,
#watchlists-collections-shell,
#schedules-shell,
#mcp-shell,
#acp-shell,
#skills-shell,
#settings-shell {
    height: 100%;
    min-height: 0;
}

#home-title,
#console-title,
#library-title,
#artifacts-title,
#personas-title,
#watchlists-collections-title,
#schedules-title,
#workflows-title,
#mcp-title,
#acp-title,
#skills-title,
#settings-title {
    height: $ds-destination-header-height;
    min-height: $ds-destination-header-height;
    padding: 0 1;
    margin: 0;
    border: none;
}

#home-purpose,
#console-purpose,
#library-purpose,
#artifacts-purpose,
#mcp-purpose,
#console-status-row,
#library-status-row,
#console-mode-bar,
#artifacts-mode-strip,
#personas-mode-strip,
#watchlists-header-bar,
#schedules-filter-strip,
#workflows-mode-strip,
#mcp-mode-strip,
#acp-purpose,
#acp-mode-strip,
#skills-mode-strip,
#settings-category-strip {
    height: $ds-destination-compact-strip-height;
    min-height: $ds-destination-compact-strip-height;
    padding: 0 1;
    margin: 0;
    border: none;
}

#watchlists-header-bar {
    /* The backend Select needs three rows; auto height consumes the shell. */
    height: 3;
    min-height: 3;
}

.destination-action-button {
    height: 1;
    min-height: 1;
    padding: 0 1;
}

/* The mic button stays real-clickable (never Textual `disabled`) while
   dictation is unavailable -- a genuinely disabled widget can never be
   pressed again, which would remove the only re-probe trigger that exists
   (task-15). Dimming here restores the *appearance* of disabled, carried
   before by `disabled`'s own styling, without the *semantics*: the tooltip
   alone is not enough, since it is invisible to anyone who does not hover,
   and to the rendered terminal text a screen reader would read. */
.console-dictation-unavailable {
    text-opacity: 60%;
}

.home-dashboard-region,
.library-region,
#artifacts-list-pane,
#artifacts-detail-pane,
#artifacts-inspector-pane,
#personas-list-pane,
#personas-detail-pane,
#personas-inspector-pane,
#watchlists-detail-pane,
#watchlists-inspector-pane,
#workflows-list-pane,
#workflows-detail-pane,
#workflows-inspector-pane,
#mcp-server-tree-pane,
#mcp-detail-pane,
#mcp-readiness-pane,
#acp-list-pane,
#acp-detail-pane,
#acp-inspector-pane,
#skills-list-pane,
#skills-detail-pane,
#skills-inspector-pane,
#settings-category-pane,
#settings-detail-pane,
#settings-impact-pane,
#ccp-character-library-pane,
#ccp-behavior-detail-pane,
#ccp-attachment-inspector-pane {
    width: 1fr;
    min-width: 0;
    height: 100%;
    min-height: 0;
    padding: 1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

/* Console's runtime frame (_frame_console_region) is the single border
   source for .console-region; no CSS border here to avoid a doubled frame. */
.console-region {
    width: 1fr;
    min-width: 0;
    height: 100%;
    min-height: 0;
    padding: 1;
    background: $ds-surface-panel;
}

#settings-category-pane {
    width: 30;
    max-width: 34;
    /* min-width (task-1342): worst label is "> Privacy & Security *" (22
       cells) plus Button line-pad (2), border (2), padding (2), list
       scrollbar (1) and pane border (2) -- 31; width:30 alone clips the
       dirty "*" marker off edited categories. */
    min-width: 32;
    overflow-y: hidden;
    overflow-x: hidden;
}

#settings-category-list {
    width: 100%;
    height: 1fr;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    /* task-1712: $ds-grid-line blended into the panel, hiding that four
       categories sit below the fold on common heights -- the overflow
       cue must actually read as one. */
    scrollbar-color: $ds-text-muted;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

/* Qodo PR #1147: both panes are fixed-header-over-scroll-body now (the
   detail pane since task-1716, the impact pane since task-1560) -- the
   scrollbar theming has to sit on the -body children that actually
   scroll, or the real scroll containers render stock scrollbars. The
   outer panes keep only their column width and clip. */
#settings-detail-pane {
    width: 6fr;
    overflow-y: hidden;
    overflow-x: hidden;
}

#settings-impact-pane {
    /* min-width: longest inspector word is "Read-only/WIP;" (14 cells) plus
       border (2), padding (2), scrollbar (1) and row padding (2), so words
       wrap on whitespace instead of folding mid-word (task-1342). */
    width: 2fr;
    min-width: 21;
    overflow-y: hidden;
    overflow-x: hidden;
}

#settings-detail-pane-body,
#settings-impact-pane-body {
    width: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

/* Narrow-width compact workbench (task-1342), following the personas
   precedent (personas-workbench-compact): at <=90 cols the 3:6:2 split
   leaves slivers, so the category pane becomes a fixed-width sidebar, the
   inspector pane and its divider drop out, and the detail pane takes the
   rest. The search help/status rows hide so category rows stay visible at
   24-row heights. */
#settings-workbench.settings-workbench-compact {
    padding: 0;
}

#settings-category-pane.settings-workbench-compact-pane {
    width: 32;
    min-width: 32;
    padding: 0 1;
}

#settings-detail-pane.settings-workbench-compact-pane {
    width: 1fr;
    min-width: 0;
    padding: 0 1;
}

#settings-impact-pane.settings-workbench-compact-pane,
#settings-workbench.settings-workbench-compact #settings-detail-impact-divider {
    display: none;
}

#settings-workbench.settings-workbench-compact .settings-category-search-help,
#settings-workbench.settings-workbench-compact .settings-category-search-status {
    display: none;
}

#home-triage-grid {
    padding: 0 1;
    margin: 0;
    border: solid $ds-column-line;
    background: $ds-surface-panel;
}

#home-header-line {
    height: $ds-home-compact-row-height;
    min-height: $ds-home-compact-row-height;
    padding: 0 1;
    margin: 0;
    border: none;
}

#home-rail,
#home-canvas {
    border: solid $ds-column-line;
    background: $ds-surface-panel;
}

.home-rail-row {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.home-rail-row-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.home-rail-section-body {
    height: auto;
    min-height: 0;
}

.home-rail-empty-copy {
    color: $ds-text-muted;
    padding: 0 1;
}

#home-next-action-callout {
    color: $ds-text-muted;
    padding: 0 1;
}

.destination-pane-divider {
    width: 1;
    min-width: 1;
    height: 100%;
    min-height: 0;
    background: $ds-grid-line;
}

#home-canvas-actions .ds-toolbar {
    height: auto;
    min-height: $ds-home-control-button-height;
    padding: 0 1;
    margin: 0;
    border: none;
    background: $ds-surface-panel;
}

.home-canvas-action {
    height: $ds-home-control-button-height;
    min-height: $ds-home-control-button-height;
    margin: 0 1 0 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    border: none;
}

/* Canvas actions gain .console-action-primary (mirrors the project's live
   "primary action button" convention) when they are the primary control
   for the currently selected row -- see HomeScreen._home_action_button /
   HomeCanvasState.primary_control_id. No id-scoped rule here anymore: the
   primary control follows selection (Retry when failed, Approve when
   approval-pending, Review flashcards when the due-flashcards row is
   selected, Open details otherwise), not one permanently-accented button. */

#library-shell-grid {
    padding: 0 1;
    margin: 0;
    border: solid $ds-column-line;
    background: $ds-surface-panel;
}

#library-header-line {
    height: $ds-home-compact-row-height;
    min-height: $ds-home-compact-row-height;
    padding: 0 1;
    margin: 0;
    border: none;
}

#library-rail {
    border: solid $ds-column-line;
    background: $ds-surface-panel;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    /* F-020: $ds-grid-line blended into the panel -- a clipped rail showed
    a track with no readable thumb, so Create/Details below the fold were
    undiscoverable. $ds-text-muted is the task-1712 fix for this same bug
    class (#settings-category-list): the overflow cue must read as one. */
    scrollbar-color: $ds-text-muted;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

#library-canvas {
    border: solid $ds-column-line;
    background: $ds-surface-panel;
}

/* Adaptive readers keep the ordinary narrow shell's edge-to-edge canvas
   without inheriting the legacy library-notes-compact descendant rules. */
#library-shell-grid.library-adaptive-compact {
    padding: 0;
    margin: 0;
    border: none;
}

#library-shell-grid.library-adaptive-compact #library-canvas {
    padding: 0;
    margin: 0;
    border: none;
    overflow-x: hidden;
    overflow-y: hidden;
}

#library-emergency-return {
    width: 100%;
    height: 1;
    min-height: 1;
    border: none;
}

.library-adaptive-reader-shell {
    width: 1fr;
    min-width: 0;
    height: 100%;
    min-height: 0;
}

.library-adaptive-reader-shell > .library-adaptive-reader-work {
    width: 1fr;
    min-width: 0;
}

.library-adaptive-reader-shell > .library-adaptive-reader-pane-grip {
    width: 5;
    min-width: 5;
    max-width: 5;
    height: 100%;
    min-height: 0;
    margin: 0;
    padding: 0;
    border: none !important;
    content-align: center middle;
}

#library-media-reader-shell > .library-media-pane-grip {
    background: $ds-surface-raised;
    color: $ds-text-muted;
}

#library-media-reader-shell > .library-media-pane-grip:focus {
    background: $ds-input-focus-bg;
    color: $ds-action-focus;
}

#library-conversations-reader-shell > .library-adaptive-reader-pane-grip {
    background: $ds-surface-raised;
    color: $ds-text-muted;
}

#library-conversations-reader-shell > .library-adaptive-reader-pane-grip:focus {
    background: $ds-input-focus-bg;
    color: $ds-action-focus;
}

#library-conversation-reader {
    width: 1fr;
    min-width: 0;
    height: 100%;
    min-height: 0;
    padding: 0 1;
    background: $ds-surface-panel;
}

.library-conversation-reader-modes,
.library-conversation-reader-actions {
    width: 100%;
    height: auto;
    min-height: 0;
    margin: 0 0 1 0;
}

.library-conversation-reader-modes > Button,
.library-conversation-reader-actions > Button {
    width: auto;
    min-width: 0;
    margin: 0;
    padding: 0 1;
}

#library-conversation-reader-status {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

#library-conversation-reader-find {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-conversation-reader-find:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-conversation-reader-messages,
#library-conversation-reader-info-body {
    width: 100%;
    height: 1fr;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
}

#library-conversation-reader-messages {
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-text-muted;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

.library-conversation-reader-message {
    width: 100%;
    height: auto;
    min-height: 2;
    padding: 0 1;
    margin: 0 0 1 0;
    border-left: solid $ds-grid-line;
    color: $ds-text-primary;
}

.library-conversation-reader-message:focus {
    outline: none;
    border-left: solid $ds-focus-accent;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}

#library-conversation-reader-info-body {
    color: $ds-text-primary;
}

/* Reader toolbars can be as narrow as 50 columns while Items remains open.
   Textual Button's default 16-column minimum pushed More and Info beyond the
   painted Reader at that width even though both widgets stayed mounted. Keep
   these two compact, label-sized rows fully reachable without changing their
   text or focus geometry. */
#library-media-reader-primary-toolbar > Button,
#library-media-reader-mode-toolbar > Button {
    width: auto;
    min-width: 0;
    margin: 0;
    padding: 0;
}

#library-hub-attention {
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 1;
}

#library-hub-attention-copy {
    width: 1fr;
    min-width: 0;
    height: auto;
    min-height: 1;
}

#library-hub-attention-action {
    width: auto;
    min-width: 8;
}

#library-conversations-canvas {
    height: 100%;
    min-height: 0;
}

#library-conversations-list {
    height: 1fr;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-text-muted;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

.library-source-pager {
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 0;
}

.library-source-pager-status {
    width: 100%;
    min-width: 0;
    height: 1;
    content-align: center middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    color: $ds-text-muted;
}

.library-source-pager-controls {
    width: 100%;
    min-width: 0;
    height: auto;
    align: center middle;
}

.library-source-pager-controls > .library-canvas-action {
    width: auto;
    min-width: 0;
}

.library-rail-empty-copy {
    color: $ds-text-muted;
    padding: 0 1;
}

.library-details-group {
    text-style: bold;
    color: $ds-text-primary;
    margin: 1 0 0 0;
    padding: 0 1;
}

.library-details-group-first {
    margin: 0;
}

.library-details-row {
    padding: 0 1;
}

.library-rail-row {
    width: 100%;
    min-width: 0;
    /* F-011: one-line rows (was height/min-height 2 + margin-bottom 1 --
    3 terminal lines per row), so the Create section and the Details
    disclosure stay reachable at 100x30. Handoff rows (Study) keep a
    second discriminator line via their inline style in
    Widgets/Library/library_rail.py. */
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.library-rail-row-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Flashcards-due emphasis on the create-flashcards rail row. Bright uses an
   accent text color (not a background fill) so the row stands out without
   reading as selected -- real selection is `.library-rail-row-selected`'s
   background treatment below, and this row must stay visually distinct from
   that state. Dim uses the muted text color already used for rail hints
   elsewhere in this file so a zero-due
   state reads as quiet. */
.library-rail-row-due-bright {
    color: $ds-action-focus;
    text-style: bold;
}

.library-rail-row-due-dim {
    color: $ds-text-muted;
    text-style: none;
}

.library-conversation-row {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.library-conversation-row-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* task-4025: the Trash view's rows share the media list's row contract
   verbatim (one comma-joined rule, not a forked copy) -- the trash rows
   keep their OWN class only so `_focus_library_list_entry`'s
   `.library-media-row` query can never grab a trash row. */
.library-media-row, .library-media-trash-row {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.library-media-row-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* task-2856 AC1/AC4: entering the Media list now parks real DOM focus on
   the first row and Up/Down move it between rows -- previously this class
   had no dedicated ``:focus`` rule at all and fell back to the generic
   ``*:focus{outline:solid}`` (core/_reset.tcss). Same readable contract
   ``.library-media-row-selected`` above already uses; `outline: none`
   suppresses the generic fallback so this is the only cue (never
   `outline: heavy`, which eats a compact row's label -- round-3 lesson). */
.library-media-row:focus, .library-media-trash-row:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

.library-notes-row {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

/* task-2856 AC1/AC4: same readable-focus contract as .library-media-row:focus
   above -- entering the Notes list now parks DOM focus on the first row and
   Up/Down move it between rows. */
.library-notes-row:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}
.library-notes-folder-row {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.library-notes-folder-row:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

.library-notes-tree-note-row {
    height: 1;
    min-height: 1;
    margin: 0;
}

.library-notes-tree-connected {
    color: $ds-focus-accent;
}

.library-notes-tree-needs-attention {
    color: $ds-status-warning;
}

.library-notes-folder-row.is-selected,
.library-notes-tree-note-row.is-selected {
    text-style: bold;
    background: $ds-focus-bg;
}


/* Same look as .library-notes-row, on a separate class: the notes Create
   view's Blank note / template rows must not also match the list view's
   ".library-notes-row" press handler (opening the editor for the pressed
   row's note_id), which would double-dispatch alongside the Create view's
   own handlers on every press. */
.library-notes-create-row {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

/* Same look as .library-notes-row: prompts list rows (library_prompts_canvas.py). */
.library-prompt-row {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

/* task-2856 AC1/AC4: same readable-focus contract as .library-media-row:focus
   above -- entering the Prompts list now parks DOM focus on the first row
   and Up/Down move it between rows. */
.library-prompt-row:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

/* "From a template" group label: separates the primary Blank note action
   from the template rows (same top-rule section grammar as the media
   viewer's Content/Analysis/Highlights headers). */
#library-notes-template-section {
    width: 100%;
    text-style: bold;
    color: $ds-text-primary;
    border-top: solid $ds-grid-line;
    padding: 1 0 0 0;
    margin: 1 0 1 0;
}

.library-canvas-action {
    height: $ds-home-control-button-height;
    min-height: $ds-home-control-button-height;
    margin: 0 1 0 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    border: none;
}

/* task-4023 AC#1 (RC-07): Legible Disabled (TASK-1801/DESIGN.md) for the
   Library's action buttons. Measured live before this rule: select-mode
   bulk buttons 1.39:1, the empty-list Select toggle 1.45:1, Collections'
   three form actions 2.30:1 -- all far under the product's 3:1
   disabled-label floor, because THREE dimmers compound (the theme's
   `text-disabled: auto 38%`, Textual Button's own `bold dim` + `color:
   auto 50%`, and _buttons.tcss's `Button:disabled { opacity: 50% }`).
   Same recipe as the composer-menu and prompt-history-restore escapes:
   neutralise every layer, state a colour that clears 3:1 on its own
   background, and let the darkened surface carry "inert". Disabled also
   carries a non-colour "○" label marker (library_shell_state.
   library_disabled_action_label) so colour is never the sole carrier.
   App tier on purpose -- widget DEFAULT_CSS cannot override Textual's own
   Button:disabled styling (same tier, widget wins); (0,2,1) specificity
   beats _buttons.tcss's `Button:disabled` (0,1,1) per property. */
Button.library-canvas-action:disabled,
Button.library-source-action:disabled {
    opacity: 100%;
    text-opacity: 100%;
    text-style: none;
    color: $ds-text-muted;
    background: $surface-darken-1;
}

/* TASK-15504: File Notes and Session Git are trust-sensitive local-file
   surfaces. Their disabled actions previously inherited three compounding
   dimmers and could become unreadable. Keep the label at full opacity, use
   semantic readable ink on an inert surface, and pair it with the visible
   disabled marker supplied by the widgets. This lives at the app tier
   because widget DEFAULT_CSS cannot override Textual's Button rule. */
LibraryFileNotesWorkspace Button:disabled,
LibraryFileNotesGitPanel Button:disabled {
    opacity: 100%;
    text-opacity: 100%;
    text-style: none;
    color: $ds-text-primary;
    background: $surface-darken-1;
}

.file-notes-git-commit-error,
#file-notes-save-status.-error {
    opacity: 100%;
    text-opacity: 100%;
    color: $ds-status-error-readable;
    background: $error-darken-3;
}

/* TASK-15509: Session Git previously redeclared a fixed focus palette inside
   widget DEFAULT_CSS, masking theme-level design-system overrides. Keep a
   built-in semantic fallback in the widget for isolated mounting, then let
   the app tier own the shared workbench focus surface in production. */
LibraryFileNotesGitPanel .file-notes-git-row:focus,
LibraryFileNotesGitPanel .file-notes-git-row.-highlight,
LibraryFileNotesGitPanel .file-notes-git-commit-included-row:focus,
LibraryFileNotesGitPanel .file-notes-git-commit-included-row.-highlight {
    background: $primary-background;
    color: $text;
    text-style: bold underline;
    outline: none;
}

LibraryFileNotesGitPanel Button.-style-default:focus {
    background: $primary-background;
    color: $text;
    text-style: bold underline;
    outline: none;
}

LibraryFileNotesGitPanel #file-notes-git-push-body:focus,
LibraryFileNotesGitPanel #file-notes-git-commit-body:focus {
    outline: heavy $primary;
}

/* Disabled-action recovery remains on screen and uses readable semantic ink.
   These lines carry the reason and next step, so muted telemetry contrast is
   not sufficient across the complete shipped theme catalog. */
#file-notes-action-status,
#file-notes-git-status,
#file-notes-git-push-result-reason,
#file-notes-git-commit-check-again-reason {
    opacity: 100%;
    text-opacity: 100%;
    color: $ds-text-primary;
}

/* task-3302 (MI-05): keyboard focus on these compact 1-row buttons was
   color-only (components/_buttons.tcss `Button:focus` sets background/
   underline and `outline: none`) -- invisible in monochrome, and a
   byte-identical plain-text pane across Tab. Heavy SIDE rails give the
   structural cue without the full `outline: heavy`, which overwrites a
   1-row compact button's only row (the task-2041 label-eating trap);
   the left/right edges land on the button's own `padding: 0 1` cells,
   so the label survives and dimensions never change on focus/blur.
   Typed selector on purpose: (0,2,1) plus later-in-bundle position
   beats both `Button:focus` (0,1,1) and `Button:hover:focus` (0,2,1,
   earlier module), so the rails persist while hovered too. */
Button.library-canvas-action:focus {
    outline-left: heavy $ds-focus-accent;
    outline-right: heavy $ds-focus-accent;
}

/* F-015/F-016: the rail search box takes the same field treatment as its
sibling filters (#library-conversations-filter / #library-notes-filter):
a deliberate $ds-grid-line frame on the raised surface instead of the
near-invisible Textual default border (which read as a borderless void
with stray left-edge border fragments), and padding 0 1 so the full
"Search Library…" placeholder still fits at 100 columns. */
#library-search-input {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-conversations-filter {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-notes-header {
    width: 100%;
    min-width: 0;
    height: auto;
    content-align: left middle;
}

/* Supporting Database-mode placement copy below the pinned authority row. */
#library-notes-database-purpose {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

#library-notes-authority {
    width: 100%;
    height: auto;
    min-height: 1;
    color: $ds-text-muted;
}

#file-notes-authority {
    width: 100%;
    height: auto;
    min-height: 1;
    max-height: 2;
    color: $ds-text-muted;
    text-wrap: wrap;
    overflow: hidden hidden;
}

#library-notes-filter {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-notes-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-notes-status {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

#library-notes-empty {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

/* Prompts list canvas (library_prompts_canvas.py): same look as the notes
   list's header/filter/empty siblings above -- visual parity, not a
   separate design. */
#library-prompts-header {
    width: 100%;
    min-width: 0;
    height: auto;
    content-align: left middle;
}

#library-prompts-filter {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-prompts-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-prompts-empty {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

/* Toolbar Import… row (library_prompts_canvas.py, Task 5): the path Input
   matches the filter box's field look; the outcome line is muted like the
   editor's save-status Static. */
#library-prompts-import-path {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-prompts-import-path:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-prompts-import-status {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

/* Toolbar Import… row (library_skills_canvas.py, Task 5): the path Input
   matches the filter box's field look; the outcome line is muted like the
   editor's save-status Static. */
#library-skills-import-path {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-skills-import-path:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-skills-import-status {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

/* Skills list canvas (library_skills_canvas.py, Task 3): same look as the
   prompts list's header/filter/empty/row siblings above -- visual parity,
   not a separate design. */
.library-skill-row {
    width: 100%;
    min-width: 0;
    /* task-424: 1 high + no margin -- the secondary Static below it is
       part of the same row block (prompts pack both lines into one 2-high
       Button label instead; the separation margin lives on the secondary
       line here). */
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

/* task-2856 AC1/AC4: same readable-focus contract as .library-media-row:focus
   above -- entering the Skills list now parks DOM focus on the first row
   and Up/Down move it between rows. This class is only 1 row high (see the
   comment on the base rule above), which is exactly the shape `outline:
   heavy` eats the label on (round-3 lesson) -- background/color/text-style
   only, no outline geometry. */
.library-skill-row:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

/* Needs-review (trust-blocked) skills stay selectable -- the trust panel
   needs them visible -- but render dim, same modifier-class pattern as
   ``.console-prompt-picker-row-blocked``. */
.library-skill-row-blocked {
    color: $ds-text-muted;
}

/* Row secondary line: the flags/description Static rendered right below
   each skill row's Button. Same muted tier as every other secondary/empty
   line in this canvas family. */
.library-skill-row-secondary {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

#library-skills-header {
    width: 100%;
    min-width: 0;
    height: auto;
    content-align: left middle;
}

#library-skills-filter {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-skills-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-skills-empty {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

/* Skill detail/trust editor (library_skills_canvas.py, Task 4): Name/
   Description/Argument hint/Allowed tools/Model share the SAME field look
   as the prompt editor's own Inputs (visual parity, not a separate
   design) -- dual-pinned against #library-prompt-name in
   test_library_skills_canvas.py. */
#library-skill-name,
#library-skill-description,
#library-skill-argument-hint,
#library-skill-allowed-tools,
#library-skill-model {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-skill-name:focus,
#library-skill-description:focus,
#library-skill-argument-hint:focus,
#library-skill-allowed-tools:focus,
#library-skill-model:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

/* Bounded editor: same floor/ceiling as #library-prompt-system/-user so the
   Body TextArea stays compact instead of ballooning to fill the canvas. */
#library-skill-body {
    height: auto;
    min-height: 6;
    max-height: 14;
    margin: 0 0 1 0;
}

/* Advanced Skill tool restriction: one bounded native chooser regardless of
   catalog size. The outer editor owns page scrolling; this viewport owns the
   keyboard-scrolled tool rows. */
#library-skill-basic-fields,
#library-skill-argument-fields,
#library-skill-advanced-fields {
    width: 100%;
    height: auto;
}

#library-skill-tool-picker {
    width: 100%;
    height: 10;
    min-height: 4;
    max-height: 10;
    margin: 0 0 1 0;
}

#library-skill-supporting,
#library-skill-save-status,
#library-skill-conflict-copy {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

/* Warnings line (shadow-name / save-marks-needs-review): a warning tier
   color, not muted -- unlike the read-only supporting-files/status lines
   above, these are actionable, attention-worthy copy. */
#library-skill-warnings {
    width: 100%;
    height: auto;
    color: $ds-status-warning;
    margin: 0 0 1 0;
}

/* Trust panel: state line dims while blocked/needs-review, same modifier-
   class pattern as .library-skill-row-blocked above. The changed-files
   line under it is muted like every other secondary line in this canvas
   family. */
#library-skill-trust-state {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

#library-skill-trust-state.library-skill-trust-state-blocked {
    color: $ds-text-muted;
}

#library-skill-trust-review-files {
    width: 100%;
    height: auto;
    min-height: 1;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

/* First-run trust setup state (Fix wave, Skills Phase-1 gate FIX 2): the
   explanation line replacing the normal changed-files line while
   ``trust_status == "trust_uninitialized"``. Same muted secondary-line
   look as #library-skill-trust-review-files above -- informational, not a
   warning tier (unlike #library-skill-warnings). */
#library-skill-trust-setup-explanation {
    width: 100%;
    height: auto;
    min-height: 1;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

#library-notes-create-header {
    width: 100%;
    min-width: 0;
    height: auto;
    content-align: left middle;
}

/* Note editor: title/keywords Inputs match the filter box's field look
   (tall border, focus accent) rather than defaulting to Textual's bare
   Input styling. */
#library-note-title,
#library-note-keywords {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-note-title:focus,
#library-note-keywords:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

/* Bounded editor: a bare TextArea in this scrolling canvas defaults to
   height:1fr, which would balloon to fill available space and crowd out
   the keywords/meta/action row beneath it. height:auto with a floor and a
   generous ceiling keeps short notes compact while long notes scroll
   inside the field itself instead of pushing the rest of the editor off
   screen. */
#library-note-body {
    height: auto;
    min-height: 12;
    max-height: 20;
    margin: 0 0 1 0;
}

/* The read-only Markdown preview takes the TextArea's place one-for-one.
   The focusable wrapper is its sole scroll owner; Markdown grows naturally
   inside it so keyboard paging can reach the complete document. */
#library-note-preview-region {
    height: auto;
    min-height: 12;
    max-height: 20;
    margin: 0 0 1 0;
    border: solid $ds-grid-line;
    overflow-y: auto;
    overflow-x: hidden;
}

#library-note-context-region {
    border: solid $ds-grid-line;
}

#library-note-preview-region:focus,
#library-note-context-region:focus {
    border: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
}

#library-note-preview-body {
    height: auto;
    min-height: 0;
    margin: 0;
    padding: 0 1;
    border: none;
    overflow-y: hidden;
    overflow-x: hidden;
}

/* Muted meta line: same tier as the media viewer's metadata block
   (#library-media-viewer-meta) so both editors read consistently. */
#library-note-meta {
    width: 100%;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

#library-note-conflict-copy,
#library-note-delete-confirm-copy {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

#library-note-conflict-copy:focus {
    outline: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Prompt editor (library_prompts_canvas.py): same field/meta/conflict look
   as the note editor's siblings above -- visual parity, not a separate
   design. Name/Author/Details/Keywords are single-line Inputs; System
   prompt/User prompt are the bounded TextAreas below. */
#library-prompt-name,
#library-prompt-author,
#library-prompt-details,
#library-prompt-keywords {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-prompt-name:focus,
#library-prompt-author:focus,
#library-prompt-details:focus,
#library-prompt-keywords:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

/* Dim one-line field labels above each Input/TextArea -- the prompt editor
   has several ambiguous text fields (unlike the note editor's single body),
   so each needs its own caption; muted like the note editor's meta line. */
.library-prompt-field-label {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
}

/* One-line dim hint under the System prompt/User prompt labels (Task 8c
   U7): explains the two-part prompt model to a new user. Same muted tier
   as .library-prompt-field-label above; the trailing margin separates it
   from the TextArea beneath it. */
.library-prompt-field-hint {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

/* Bounded editors: same floor/ceiling as #library-note-body so System/User
   prompt stay compact instead of ballooning to fill the canvas. */
#library-prompt-system,
#library-prompt-user {
    height: auto;
    min-height: 6;
    max-height: 14;
    margin: 0 0 1 0;
}

#library-prompt-meta {
    width: 100%;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

#library-prompt-conflict-copy,
#library-prompt-save-status {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

/* TASK-196: retained history is a compact disclosure inside the editor's
   existing scroll owner. It deliberately adds neither another card nor a
   VerticalScroll; the persistent action strip remains a sibling below. */
#library-prompt-history-region,
#library-prompt-history-collapsible {
    width: 100%;
    height: auto;
    min-height: 0;
}

#library-prompt-history-region {
    margin: 1 0 1 0;
}

#library-prompt-history-collapsible > CollapsibleTitle {
    width: 100%;
    color: $ds-text-primary;
    text-style: bold;
}

.library-prompt-history-row {
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
    content-align: left middle;
}

.library-prompt-history-row.history-selected {
    outline: tall $ds-focus-accent;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}

#library-prompt-history-metadata,
#library-prompt-history-compatibility,
#library-prompt-history-restore-reason,
#library-prompt-history-outcome,
#library-prompt-history-keywords-disclosure,
#library-prompt-history-outcome-keywords,
.library-prompt-history-error,
.library-prompt-history-success {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

.library-prompt-history-metadata,
#library-prompt-history-compatibility,
#library-prompt-history-restore-reason,
#library-prompt-history-keywords-disclosure,
#library-prompt-history-outcome-keywords {
    color: $ds-text-muted;
}

.library-prompt-history-error {
    color: $ds-status-error-readable;
}

.library-prompt-history-success {
    color: $ds-status-ready;
}

#library-prompt-history-system,
#library-prompt-history-user {
    width: 100%;
    height: auto;
    min-height: 4;
    max-height: 10;
    margin: 0 0 1 0;
}

#library-prompt-history-region .library-canvas-action {
    max-width: 100%;
    margin: 0 0 1 0;
}

/* TASK-196 / TASK-1801: the reason line explains why restore is gated, but
   the disabled action label must remain discoverable too. Neutralise the
   app + Textual compound opacity stack and let the dark surface, rather
   than illegible ink, communicate the inert state. `$text-muted` measures
   above the product's 3:1 disabled-label floor on this surface. */
#library-prompt-history-restore:disabled {
    opacity: 100%;
    text-opacity: 100%;
    color: $text-muted;
    background: $surface-darken-1;
}

/* TASK-202: the prompt editor owns two rows. The only vertical scroll owner
   is the content row; the action area measures to its controls below it. This
   prevents a tall editor from pushing its completion controls past the canvas. */
#library-prompts-canvas,
#library-prompt-work-pane {
    height: 1fr;
    min-height: 0;
    min-width: 0;
}

/* Disabled labels carry a visible marker, so the two management actions
   must share the retained Items width instead of keeping intrinsic widths. */
#library-prompts-selection-management-actions {
    width: 100%;
    min-width: 0;
}

#library-prompts-selection-management-actions > .library-canvas-action,
#library-shell-grid.library-notes-compact #library-prompts-selection-management-actions > .library-canvas-action {
    width: 1fr;
    min-width: 0;
}

#library-prompt-editor-shell {
    width: 100%;
    height: 1fr;
    min-height: 0;
}

#library-prompt-editor-content {
    width: 100%;
    height: 1fr;
    min-height: 0;
    overflow-x: hidden;
}

#library-prompt-advanced-extras {
    height: auto;
    margin-bottom: 1;
}

#library-prompt-editor-actions {
    width: 100%;
    height: auto;
    min-height: 0;
    padding: 1 0 0 0;
    background: $ds-surface-raised;
}

/* The groups deliberately stack in source order at every width. This avoids
   a fragile wrapped Horizontal while keeping every long action label visible
   in narrow terminals. */
#library-prompt-actions-primary,
#library-prompt-actions-content,
#library-prompt-actions-lifecycle {
    width: 100%;
    height: auto;
    min-height: 0;
    margin: 0 0 1 0;
}

#library-prompt-actions-lifecycle {
    margin-bottom: 0;
}

#library-prompt-editor-actions .library-canvas-action {
    width: 100%;
    min-width: 0;
    margin: 0;
}

#library-prompt-actions-lifecycle .library-media-action-danger {
    margin: 0 0 0 4;
}

/* Ingest canvas: local-file ingest form + job queue. Mirrors the notes
   sync panel's render-safe stacked shape (VerticalScroll root -- L3a
   clipping lesson -- no Select, no Horizontal mixing 1fr + fixed-width
   children). */
#library-ingest-header {
    width: 100%;
    text-style: bold;
    color: $ds-text-primary;
    margin: 0 0 1 0;
}

.library-ingest-quiet-line {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

/* task-14822: the tooling-warning wall folds to ONE line. This is the
   summary that replaces it -- environment context, so it keeps the quiet
   weight; its `⚠` glyph, not a colour, carries the severity (the
   monochrome rule). No bottom margin: the fold's title row belongs to it,
   and the blank row `.library-ingest-quiet-line` adds per line is exactly
   what turned 11 warnings into ~22 rows. */
.library-ingest-tooling-summary {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0;
}

/* task-14822: the unsupported-file and empty-file lines are OUTCOMES of
   this import, not facts about the install -- they used to share
   `.library-ingest-quiet-line` with the tooling warnings and read at
   identical weight, so "5 unsupported files will be skipped" drowned in
   eleven amber environment notes. Bold + primary text is the same
   "this is about YOUR selection" weight `#library-ingest-header` uses. */
.library-ingest-outcome-line {
    width: 100%;
    height: auto;
    color: $ds-text-primary;
    text-style: bold;
    margin: 0 0 1 0;
}

.library-ingest-field {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

/* task-3302 (MI-05): focus on these top-level fields was color-only -- the
   tall border swapped color but kept identical glyphs, so Tab produced a
   byte-identical plain-text pane (confirmed in two live walks). The heavy
   accent outline is DESIGN.md's focus contract and exactly what the panel
   option fields already get (`LibraryIngestCanvas Input:focus`, task-2014)
   -- that rule loses to this class selector on specificity, which is how
   these four fields shipped color-only. Outline draws OVER the widget's
   own edge cells, so dimensions stay stable on focus/blur. */
.library-ingest-field:focus {
    border: tall $ds-input-focus-accent;
    outline: heavy $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

/* TASK-15702: persistent metadata labels survive populated values while a
   compact three-column row shortens the path-to-commit distance. */
#library-ingest-metadata-row {
    width: 100%;
    height: auto;
    layout: horizontal;
}

.library-ingest-metadata-field {
    width: 1fr;
    height: auto;
    margin-right: 1;
}

.library-ingest-metadata-field:last-of-type {
    margin-right: 0;
}

.library-ingest-metadata-field .library-ingest-field {
    margin-bottom: 0;
}

/* Keep forecast, consent/error copy, and the primary action together at the
   viewport edge. The queue owns the space after a successful submission. */
#library-ingest-commit-bar {
    dock: bottom;
    width: 100%;
    height: auto;
    padding: 1;
    border-top: solid $ds-grid-line;
    background: $ds-surface-raised;
}

#library-ingest-commit-bar .library-ingest-quiet-line {
    margin-bottom: 0;
}

/* Accent treatment mirrors .console-action-primary
   (the project's live "primary action button" convention) so Start ingest
   reads as the one button that matters on this canvas. */
#library-ingest-start {
    margin-top: 0;
    background: $ds-action-focus 35%;
    color: $ds-text-primary;
    text-style: bold;
}

#library-ingest-start:disabled {
    background: $ds-surface-raised;
    color: $ds-text-disabled;
    text-style: none;
}

#library-ingest-queue-heading {
    width: 100%;
    text-style: bold;
    color: $ds-text-primary;
    border-top: solid $ds-grid-line;
    padding: 1 0 0 0;
    margin: 1 0 1 0;
}

#library-ingest-queue-counts {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

#library-ingest-queue-empty {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
}

.library-ingest-row {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    color: $ds-text-primary;
}

.library-ingest-progress {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0 0 1 2;
}

.library-ingest-row-with-progress {
    margin-bottom: 0;
}

/* (L3b AB wave, A3) A row followed by action button(s) (Open in Library /
   Retry / Dismiss) trims its own bottom margin to 0 -- the actions
   wrapper's own `.library-ingest-row-actions` margin below supplies the
   spacing instead (tight gap above, blank line below), so the button(s)
   read as belonging to THIS row rather than the row underneath it. Plain
   rows (queued/running, or a defensively action-less done row) keep the
   base `.library-ingest-row` bottom margin for normal row-to-row
   spacing. */
.library-ingest-row-with-actions {
    margin: 0 0 0 0;
}

/* (L5, fix batch F1b) The wrapper around a row's action button(s) --
   Retry+Dismiss on a failed row, or Open in Library alone on a done row
   (the two never coexist on the same row). Carries the spacing the
   individual `.library-ingest-row-action` buttons used to carry alone
   (A3, above) now applied once to the whole group: indented 2 cells so it
   visually nests under its row, no gap above (tight to the row it
   belongs to, whose own margin is trimmed via
   `.library-ingest-row-with-actions` above), one blank line below before
   whatever comes next (another row, or "Clear finished"). `height: auto`
   keeps it from inheriting `Horizontal`'s `1fr` default, which would
   otherwise fight every other row for the VerticalScroll's height. */
.library-ingest-row-actions {
    height: auto;
    margin: 0 0 1 2;
}

/* Shared by every per-row action button (Open in Library / Retry /
   Dismiss) inside `.library-ingest-row-actions` above -- now just a small
   right gap between same-row siblings (Retry from Dismiss) so the pair
   reads as two distinct buttons rather than running together; the
   wrapper itself supplies the row's own indent/top/bottom spacing. */
.library-ingest-row-action {
    margin: 0 1 0 0;
}

/* (L3b AB wave, B2) "Clear finished" sits below every queue row -- a top
   margin separates it from the last row's own action button instead of
   reading as one more per-row action. */
#library-ingest-clear-finished {
    margin-top: 1;
}

/* Export canvas (F4 Task 2): in-canvas chatbook export form. Own classes
   rather than reusing `.library-ingest-*` -- the two canvases' CSS stays
   independently discoverable even though the rules mirror the ingest
   canvas's field/quiet-line styling exactly. */
.library-export-quiet-line {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

.library-export-field {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.library-export-field:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

/* Accent treatment mirrors #library-ingest-start / .console-action-primary
   (the project's live "primary action button" convention) so Export
   chatbook reads as the one button that matters on this canvas. */
#library-export-submit {
    margin-top: 1;
    background: $ds-action-focus 35%;
    color: $ds-text-primary;
    text-style: bold;
}

/* task-4023 AC#1 (RC-07): this ID rule outranks the shared
   `.library-canvas-action:disabled` escape above, so it must be
   self-sufficient. Its previous `$ds-text-disabled` label (the alpha-38%
   token) measured 1.44:1 live -- the very compound this rule tried to
   avoid -- and it never neutralised _buttons.tcss's `opacity: 50%`. */
#library-export-submit:disabled {
    opacity: 100%;
    text-opacity: 100%;
    background: $surface-darken-1;
    color: $ds-text-muted;
    text-style: none;
}

#library-media-title {
    width: 100%;
    min-width: 0;
    height: auto;
    content-align: left middle;
}

#library-media-canvas {
    height: 100%;
    min-height: 0;
}

#library-media-type-filter {
    width: auto;
    min-width: 0;
    margin: 0 0 1 0;
}

/* task-14900: Media list|preview side by side above the screen's one
   measured width regime. The workbench Horizontal (Collections'
   `#library-collections-workbench` grammar) splits its panes 1fr|1fr by
   default; the `library-notes-compact` class -- which the Library screen
   already maintains on `#library-canvas` at compose time and on every
   measured `on_resize` crossing of LIBRARY_NOTES_COMPACT_BREAKPOINT --
   switches it to the dense preview-free list. In the wide split each pane owns
   its own vertical scroll, which is the point: no more scrolling the whole
   canvas between list and preview while the right half sits blank. */
#library-media-workbench {
    width: 100%;
    height: 1fr;
    min-height: 0;
}

#library-media-list,
#library-media-preview,
#library-media-detail-empty {
    width: 1fr;
    min-width: 0;
    height: 100%;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
}

#library-media-list {
    overflow-y: hidden;
}

#library-media-row-scroll {
    width: 100%;
    min-width: 0;
    overflow-y: auto;
    overflow-x: hidden;
}

#library-media-preview,
#library-media-detail-empty {
    margin: 0 0 0 1;
    padding: 0 1;
}

/* The detail half's placeholder (Collections' "No Collection selected."
   grammar): muted, and hidden the moment the preview owns the pane. */
#library-media-detail-empty {
    color: $ds-text-muted;
}

#library-media-workbench.has-preview #library-media-detail-empty {
    display: none;
}

/* Below the breakpoint Media becomes a dense list: the mounted preview is
   removed from paint/focus participation by the canvas, while the list owns
   the remaining height and keeps its pager pinned below the row scroller. */
#library-shell-grid.library-notes-compact #library-media-workbench {
    layout: vertical;
    height: 1fr;
    min-height: 0;
}

#library-shell-grid.library-notes-compact #library-media-list {
    width: 100%;
    height: 100%;
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow-y: hidden;
}

#library-shell-grid.library-notes-compact #library-media-row-scroll {
    height: 1fr;
    min-height: 0;
}

#library-shell-grid.library-notes-compact .library-media-row {
    height: 1;
    min-height: 1;
    margin: 0;
}

#library-shell-grid.library-notes-compact #library-media-preview {
    display: none;
}

#library-shell-grid.library-notes-compact #library-media-detail-empty {
    display: none;
}

/* Title: brightest + bold so it anchors the viewer; metadata recedes (muted)
   so the two read as distinct tiers instead of one wall of text. */
#library-media-viewer-title {
    width: 100%;
    text-style: bold;
    color: $ds-text-primary;
    margin: 0 0 1 0;
}

#library-media-viewer-meta {
    width: 100%;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

/* Section headers: bold + a thin top rule so Content / Analysis / Highlights
   read as real section boundaries the eye can find without reading. */
#library-media-viewer-content-title,
#library-media-viewer-analysis-title,
#library-media-viewer-highlights-title {
    width: 100%;
    text-style: bold;
    color: $ds-text-primary;
    border-top: solid $ds-grid-line;
    padding: 1 0 0 0;
    margin: 1 0 1 0;
}

#library-media-content-search {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-media-content-search:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-media-content-search-status {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

/* task-15774: while a search is ACTIVE, the whole search-controls block
   (box + match count + Prev/Next) docks to the top of the scrolling viewer
   -- the find-bar convention, and the same pinned-edge chrome idiom as
   #library-ingest-commit-bar's dock: bottom. In flow, the stack above the
   controls (Back, title, metadata, section header) exceeds an 80x24
   viewport, so the match count and Prev/Next sat below the fold exactly
   while the user was operating them. Dock-on-active keeps them painted at
   every size and scroll position; an inactive search keeps the in-flow
   layout, so no space is stolen when nobody is searching. The raised
   background + bottom rule stop scrolled content bleeding through the
   pinned bar; the collapsed child margins keep the bar to 6 rows of a
   24-row terminal instead of 8. */
#library-media-content-search-controls.-library-media-search-active {
    dock: top;
    width: 100%;
    background: $ds-surface-raised;
    border-bottom: solid $ds-grid-line;
}

#library-media-content-search-controls.-library-media-search-active #library-media-content-search,
#library-media-content-search-controls.-library-media-search-active #library-media-content-search-status {
    margin: 0;
}

#library-media-viewer {
    height: 100%;
    overflow-y: auto;
    /* Never scroll horizontally: without this the vertical scroll container
       sizes its content to the widest child's natural width, so a long
       unbroken line (analysis summary, URL) sets a wide virtual width and
       width:100% children match it instead of wrapping. Constrain to the
       visible width so long lines wrap. */
    overflow-x: hidden;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

/* Text bodies default to width:auto (shrink-to-content); fill the width so
   long lines wrap within the (now horizontally-constrained) viewer. */
#library-media-viewer Static {
    width: 100%;
}

/* Task 21665: an eligible local original is an additive reading aid. Keep it
   bounded inside the Reader's existing scroll surface; the complete stored
   text remains directly below it and owns its own established scroll region. */
#library-media-image-preview {
    width: 100%;
    height: auto;
    max-height: 18;
    overflow: hidden;
    align: center middle;
    border: solid $ds-grid-line;
    margin: 0 0 1 0;
}

#library-media-image-preview-status {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

#library-media-image-preview-toggle,
#library-media-image-preview-retry {
    width: auto;
    margin: 0 0 1 0;
}

#library-media-viewer-content {
    /* Bounded so short content stays compact and long content scrolls inside
       this region; height:1fr here ballooned the pane and split the sections.
       max-height is generous so typical content shows in full (only long
       transcripts engage the inner scroll), reducing nested-scroll friction. */
    height: auto;
    max-height: 18;
    min-height: 3;
    margin: 0 0 1 0;
    border: solid $ds-grid-line;
    padding: 0 1;
}

#library-media-edit-form {
    height: auto;
    margin: 0 0 1 0;
}

/* Persistent per-field label: muted, bold, hugging its input above the row. */
.library-media-edit-label {
    width: 100%;
    height: 1;
    color: $ds-text-muted;
    text-style: bold;
    margin: 0;
}

/* Destructive Delete: pushed off the primary actions (a gap) and de-emphasized
   so it is neither adjacent to Edit nor visually competing with it. */
.library-media-action-danger {
    margin: 0 0 0 4;
    color: $ds-text-muted;
}

/* Each highlight is an indented card so its quote, meta, and delete read as
   one unit -- a per-row delete then clearly belongs to a single highlight. */
.library-media-highlight-row {
    width: 100%;
    height: auto;
    border-left: solid $ds-grid-line;
    padding: 0 0 0 1;
    margin: 0 0 1 0;
}

.library-media-highlight-meta {
    width: 100%;
    color: $ds-text-muted;
}

.library-media-highlight-delete {
    color: $ds-text-muted;
}

#library-media-edit-form Input {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-media-edit-form Input:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-media-highlight-add-collapsible {
    height: auto;
    margin: 0 0 1 0;
}

#library-media-highlight-add-collapsible Input {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-media-highlight-add-collapsible Input:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#console-workspace-grid {
    height: $ds-console-workspace-grid-height;
    min-height: 20;
    padding: 0;
    margin: 0;
    overflow: hidden;
    border-top: solid $ds-grid-line;
    border-bottom: solid $ds-grid-line;
    background: $ds-surface-panel;
}

#console-workbench-header {
    /* The destination identity header is the visible Console header (ADR-015);
       layout comes from .workbench-header in _workbench.tcss. */
    height: auto;
    min-height: 2;
    padding: 0 1;
    margin: 0;
}

#console-workbench-header.console-header-inline {
    layout: horizontal;
    height: 1;
    min-height: 1;
    border: none;
}

#console-workbench-header.console-header-inline .workbench-header-title {
    width: auto;
    height: 1;
    min-height: 1;
}

#console-workbench-header.console-header-inline .workbench-header-subtitle {
    /* Keep the subtitle visible in compact density too: the shared
       `.density-compact .workbench-header-subtitle { display: none }` hid it to
       save a row in the old stacked header, but the inline header is one row at
       any density, so hiding it only wastes the horizontal space. This id+class
       rule (1,2,0) beats that density rule (0,2,0). */
    display: block;
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    margin: 0 1;
}

#console-workbench-header.console-header-inline .workbench-header-status {
    width: auto;
    height: 1;
    min-height: 1;
}

#console-workbench-mode-strip,
#console-workbench-command-strip {
    display: none;
    height: 0;
    min-height: 0;
    max-height: 0;
    padding: 0;
    margin: 0;
    border: none;
}

#console-control-bar {
    height: auto;
    min-height: 1;
    max-height: 2;
    padding: 0 1;
    margin: 0;
    border: none;
    background: $ds-surface-panel;
    overflow: hidden;
}

.console-control-chip-row,
.console-control-action-row {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    max-height: 1;
    layout: horizontal;
    align: left middle;
}

#console-auto-speak-row {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    max-height: 1;
    layout: horizontal;
    align: left middle;
}

#console-speech-controls,
#console-auto-speak-control,
#console-hands-free-control {
    width: auto;
    height: 1;
    min-height: 1;
    max-height: 1;
    layout: horizontal;
    align: left middle;
}

#console-speech-controls {
    margin: 0 2 0 0;
}

#console-auto-speak-label,
#console-hands-free-label {
    width: auto;
    height: 1;
    margin-right: 1;
}

#console-auto-speak,
#console-hands-free-switch {
    width: 5;
    min-width: 5;
    max-width: 5;
    height: 1;
    min-height: 1;
    max-height: 1;
    padding: 0;
    margin: 0;
    border: none;
}

#console-auto-speak {
    margin-right: 1;
}

#console-auto-speak-retry,
#console-auto-speak-resume {
    width: auto;
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0 1 0 0;
}

#console-status-chips {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    max-height: 1;
    layout: horizontal;
    border: none;
    padding: 0 1;
    /* TASK-17650: cancel .ds-panel's bottom margin — it rendered as a
       permanent blank row between the chips and the footer. */
    margin: 0;
}

/* TASK-15704: both mounted presentations stay one row high. The fixed restore
   control leads; the copy or scroll viewport consumes only the remaining
   width, so neither can push past the strip at narrow terminal sizes. */
#console-status-expanded,
#console-status-collapsed {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    max-height: 1;
    layout: horizontal;
    align: left middle;
}

/* TASK-2154.5 (LY-03): expanded chip overflow scrolls horizontally (focus
   auto-scroll for keyboard, Shift+wheel / trackpad swipe for mouse) instead
   of silently clipping later chips. The scrollbar itself is hidden because
   the inner viewport is a single row -- same contract as the native tab
   strip. */
#console-status-chip-scroll {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    max-height: 1;
    layout: horizontal;
    overflow-x: auto;
    overflow-y: hidden;
    border: none;
    padding: 0;
    scrollbar-size-horizontal: 0;
}

#console-status-collapse,
#console-status-expand {
    width: 9;
    min-width: 9;
    max-width: 9;
    height: 1;
    min-height: 1;
    max-height: 1;
    border: none;
    padding: 0;
}

#console-status-collapsed-copy {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    color: $ds-text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.console-control-chip {
    width: auto;
    /* RAG-46: a ~10x1-cell hit target is easy to miss with mouse/touch. Raised
       from 7 to 12 (min-width) and the horizontal padding from `0 1` to `0 2`
       to widen both the box and its clickable interior; short labels like
       "RAG: off" now render with more breathing room instead of a
       near-flush-to-edge fit. */
    min-width: 12;
    /* task-1671: 22 cut model ids mid-token ("Model: claude-3-hai…").
       The ask was 25 chars of the MODEL NAME, and the "Model: " prefix
       costs 7 with 2 more for padding -- hence 34. Chips are width:auto,
       so this cap only bites long labels: "Library search: off" and
       friends are unchanged. Focus still lifts the cap entirely. */
    max-width: 34;
    height: 1;
    min-height: 1;
    margin: 0 1 0 0;
    padding: 0 2;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

.console-chip-dim {
    color: $ds-text-muted;
}

.console-chip-alert {
    color: $ds-text-primary;
    text-style: bold;
}

/* task-4 (PR3 cost ticker): the cost chip's "cache expired" state -- not
   an alert (nothing needs the user's attention) and not a plain dim
   readiness pill either, so it gets its own informational color rather
   than reusing either. */
.console-chip-cold {
    color: $ds-status-info;
}

/* task-7: the temporary-chat chip -- distinct from the neutral readiness
   chips above so "this chat is not saved" reads as a state worth noticing,
   not just another setting pill. */
#console-temporary-chip {
    color: $warning;
    text-style: italic;
}

/* Keyboard reachability: chips ellipsize at 22 cells, so focusing a chip
   lifts the width cap to reveal the full label (the tooltip carries the
   same text on hover). Later chips clip under the bar's hidden overflow. */
.console-control-chip:focus {
    max-width: 100%;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    /* TASK-383: the global `*:focus { outline: solid }` fallback OVERLAYS a box
       onto this height-1 chip, replacing the label with border glyphs (the
       "empty outlined box" defect). The high-contrast bg/fg + bold underline
       above already give a non-obscuring focus cue, so suppress the outline
       that would otherwise hide the label. */
    outline: none;
}

.console-control-action {
    width: auto;
    min-width: 7;
    height: 1;
    min-height: 1;
    margin: 0 1 0 0;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $ds-text-primary;
    content-align: left middle;
}

.console-control-action:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-control-summary-line {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
}

.console-hidden-control {
    display: none;
}

#console-staged-context-tray,
#console-session-context,
#console-workspaces-context,
#console-workspace-context,
#console-run-inspector {
    width: 1fr;
    min-width: 0;
    height: 100%;
    min-height: 0;
}

#console-main-column,
#console-right-rail {
    width: 1fr;
    min-width: 0;
    height: 100%;
    min-height: 20;
}

#console-staged-context-tray,
#console-session-context,
#console-workspaces-context,
#console-workspace-context {
    width: 100%;
    min-width: 0;
}

#console-staged-context-tray {
    height: auto;
    min-height: 0;
}

#console-session-context,
#console-workspaces-context,
#console-workspace-context {
    height: auto;
    min-height: 0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

#console-workspace-handoff-rows {
    height: auto;
    min-height: 0;
}

#console-workspace-conversations-header {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    margin: 1 0 0 0;
    layout: horizontal;
    align: left middle;
}

.console-workspace-action.console-workspace-conversations-toggle {
    width: 3;
    min-width: 3;
    max-width: 3;
    margin: 0;
}

#console-workspace-selected-conversation {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    color: $ds-text-muted;
    background: $ds-surface-panel;
}

/* The row is 3 rows tall so the bordered Input inside it can show its value:
   a `tall` border spends one row above and one below the text, so a 1-row
   input paints its top edge and nothing else. */
#console-workspace-conversation-search-row {
    width: 100%;
    min-width: 0;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    layout: horizontal;
    align: left middle;
}

#console-workspace-conversation-search {
    width: 1fr;
    min-width: 0;
    height: 3;
    min-height: 3;
    margin: 0 1 0 0;
}

#console-workspace-conversation-search-clear {
    width: auto;
    min-width: 7;
    height: 1;
    min-height: 1;
    margin: 0;
}

#console-workspace-conversations {
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 0;
    overflow-y: hidden;
    overflow-x: hidden;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-workspace-conversation-row {
    height: auto;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-workspace-conversation-row-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-conversation-browser-section-header {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    layout: horizontal;
    align: left middle;
}

.console-conversation-browser-section-title {
    width: 1fr;
    min-width: 0;
}

.console-conversation-browser-group-header {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    layout: horizontal;
    align: left middle;
}

.console-conversation-browser-group-title {
    width: 1fr;
    min-width: 0;
    color: $ds-text-muted;
}

.console-conversation-browser-row-line {
    width: 100%;
    min-width: 0;
    height: auto;
    layout: horizontal;
}

.console-conversation-star {
    width: 3;
    min-width: 3;
    max-width: 3;
    height: 2;
    min-height: 2;
    margin: 0 1 1 0;
}

#console-left-rail {
    height: 100%;
    min-height: 0;
    overflow: hidden;
}

#console-left-rail:focus {
    outline: none;
    background: $ds-surface-panel;
}

#console-left-rail-body {
    width: 100%;
    min-width: 0;
    height: 1fr;
    min-height: 0;
    padding: 0;
    overflow-y: auto;
    overflow-x: hidden;
    /* TASK-1191: do not remove `scrollbar-gutter: stable`.
     * ConsoleWorkspaceContextTray._fit_height_to_content's single fit pass
     * (Widgets/Console/console_workspace_context.py) depends on this rail's
     * content width never shifting when rows are added/removed and the
     * scrollbar toggles on/off -- `stable` reserves the gutter column
     * unconditionally, so a toggling scrollbar cannot change
     * `content_region.width` out from under an already-scheduled fit pass.
     * Without it, that width shift could feed back into another relabel
     * recompose after the single pass already ran, reopening the
     * multi-pass settle race TASK-1191 retired. */
    scrollbar-gutter: stable;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

#console-left-rail-body:focus {
    outline: none;
    border: none;
    background: $ds-surface-panel;
}

#console-session-context:focus,
#console-workspaces-context:focus,
#console-workspace-context:focus {
    outline: none;
    border: none;
    background: $ds-surface-panel;
}

#console-workspace-conversations:focus {
    outline: none;
    border: none;
    background: $ds-surface-panel;
}

.console-left-rail-section {
    margin: 0 0 1 0;
    /* TASK-2154.3 (LY-07): no horizontal padding here -- the enclosing
       .console-rail-section-body already supplies the single content indent
       (rail IA spec section 3). The second indent spent 2 of the rail's
       ~23 content cells and pushed the 12-col label + 10-col value status
       pairs one cell past the row's right edge. */
    padding: 0;
}

#console-inspector-rail-body {
    width: 100%;
    min-width: 0;
    height: 1fr;
    min-height: 0;
    padding: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

#console-send-authority-summary {
    width: 100%;
    min-width: 0;
    height: 6;
    min-height: 6;
    max-height: 6;
    padding: 0 1;
    overflow: hidden;
}

#console-send-authority-summary:focus {
    outline: heavy $ds-action-focus;
}

#console-send-authority-heading {
    text-style: bold;
    color: $ds-text-primary;
}

.console-send-authority-row {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    max-height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#console-inspector-more,
#console-inspector-more-body {
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 0;
}

#console-inspector-more-toggle {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    margin: 1 0 0 0;
    padding: 0 1;
    text-align: left;
}

#console-main-column {
    width: 13fr;
    min-width: 60;
    padding: 0;
}

#console-right-rail {
    width: 4fr;
    min-width: 34;
    overflow: hidden;
}

#console-staged-context-tray,
#console-session-context,
#console-workspaces-context,
#console-workspace-context,
#console-run-inspector {
    border: solid $ds-column-line;
    background: $ds-surface-panel;
}

#console-right-rail,
#console-transcript-region {
    background: $ds-surface-panel;
}

#console-staged-context-tray.console-frame-quiet,
#console-session-context.console-frame-quiet,
#console-workspaces-context.console-frame-quiet,
#console-workspace-context.console-frame-quiet {
    border: none;
    background: $ds-surface-panel;
}

#console-run-inspector {
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 0;
    border: none;
}

#console-run-inspector-state {
    height: auto;
    min-height: 0;
}

.console-rail-handle {
    width: 13;
    min-width: 13;
    max-width: 13;
    height: 100%;
    min-height: 20;
    padding: 0;
    border: none;
    background: $ds-surface-panel;
}

.console-rail-handle-right {
    width: 11;
    min-width: 11;
    max-width: 11;
    height: auto;
    min-height: 3;
    max-height: 6;
    border: none;
    background: transparent;
}

.console-inspector-rail-handle {
    height: 100%;
    min-height: 20;
    max-height: 100%;
    background: $ds-surface-panel;
}

.console-rail-handle-button {
    width: 11;
    min-width: 0;
    max-width: 11;
    height: 100%;
    min-height: 100%;
    max-height: 100%;
    text-align: center;
    content-align: center middle;
}

.console-rail-handle-button-right {
    width: 11;
    max-width: 11;
    height: 3;
    min-height: 3;
    max-height: 3;
}

.console-rail-handle-vertical {
    width: 3;
    min-width: 3;
    max-width: 3;
    height: 100%;
    min-height: 20;
    max-height: 100%;
    align-horizontal: center;
}

.console-rail-handle-button.console-rail-handle-button-vertical {
    width: 1;
    min-width: 1;
    max-width: 1;
    height: 1fr;
    min-height: 7;
    max-height: 100%;
}

/* TASK-345: controls that previously had NO :focus rule fell back to
   Textual's imperceptible default shift. Non-obscuring contract vocabulary
   only (ds tokens + bold underline; no accent, no reverse). */
.console-rail-collapse-button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-switcher-result:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-workspace-conversation-row Button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-workspace-action-row Button:focus,
.console-rail-header Button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-rail-collapse-button {
    width: 3;
    min-width: 3;
    max-width: 3;
    height: 1;
    min-height: 1;
    text-align: left;
    content-align: left middle;
}

.console-rail-handle-badge {
    height: auto;
    min-height: 1;
    width: 100%;
    text-align: center;
    color: $ds-text-primary;
    background: $ds-surface-raised;
}

.console-rail-handle-badge-vertical {
    width: 1;
    min-width: 1;
    max-width: 1;
}

.console-rail-header {
    height: 1;
    min-height: 1;
    layout: horizontal;
}

.console-rail-title {
    width: 1fr;
    min-width: 0;
    text-align: left;
    content-align: left middle;
}

.console-rail-section-header {
    height: auto;
    min-height: 2;
    border-top: solid $ds-column-line;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    content-align: center middle;
}

.console-rail-section-title {
    width: 1fr;
    text-style: bold;
    color: $ds-text-primary;
}

.console-rail-section-toggle {
    width: 3;
    min-width: 3;
    text-style: bold;
}

.console-rail-section-toggle:focus {
    background: $ds-action-focus 30%;
    text-style: underline bold;
}

.console-workspace-conversations-header {
    height: auto;
    min-height: 2;
    border-top: solid $ds-column-line;
    content-align: center middle;
}

.console-rail-section-body {
    height: auto;
    min-height: 0;
    padding: 0 0 0 1;
    margin-bottom: 1;
}

#console-character-avatar-frame {
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 0;
    align: center middle;
}

/* Shared direct-section body. The owner applies the measured content-row
   allocation inline; no CSS ceiling may override a smaller Context grant. */
ConsoleBoundedSection {
    height: auto;
    min-height: 0;
}

.console-bounded-section-viewport {
    height: auto;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-gutter: stable;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

.console-bounded-section-viewport:focus,
.console-bounded-section-viewport:focus-within {
    background: $ds-action-focus 12%;
}

#console-workspace-tree {
    width: 100%;
    min-width: 0;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-gutter: stable;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

#console-workspace-tree:focus {
    background: $ds-action-focus 12%;
}

#console-workspace-tree > .tree--cursor {
    text-style: bold;
}

.console-bounded-section-hint {
    display: none;
    height: 1;
    min-height: 1;
    color: $ds-text-muted;
    background: $ds-surface-panel;
    text-style: italic;
}

.console-model-section-line {
    height: auto;
    min-height: 1;
}

.console-model-section-label {
    width: 12;
    min-width: 12;
    color: $ds-text-muted;
}

.console-model-section-value {
    width: 1fr;
    min-width: 10;
    color: $ds-text-primary;
}

#console-model-section-provider .console-model-section-value,
#console-model-section-model .console-model-section-value {
    text-wrap: wrap;
    max-height: 3;
    overflow: hidden;
}

#console-model-section-temperature .console-model-section-value,
#console-model-section-max-tokens .console-model-section-value {
    text-wrap: nowrap;
}

#console-model-section-recovery {
    color: $ds-status-blocked;
}

.console-agent-section-line {
    height: 1;
    color: $ds-text-primary;
}

.console-agent-section-steps {
    height: auto;
    color: $ds-text-muted;
    text-style: dim;
}

/* PR2b Task 4: `.console-agent-section-subagents` retired -- the plain
   Static this class styled at `#console-agent-section-subagents` was
   replaced by a `ConsoleInspectorSection` (styled entirely by its own
   `.console-inspector-section*` rules above); nothing composes this class
   anymore. */

.console-agent-section-fleet-summary {
    height: auto;
    color: $ds-status-running;
    text-style: dim;
}

.console-agent-drilldown-back {
    margin-top: 1;
}

#console-rail-system-line {
    height: 1;
    color: $ds-text-primary;
}

#console-rail-system-line.console-rail-system-line-dim {
    color: $ds-text-muted;
}

.console-inspector-group-heading {
    height: 1;
    min-height: 1;
    margin: 1 0 0 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-inspector-status-summary {
    height: 1;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-inspector-action {
    height: 1;
    min-height: 1;
    margin: 0;
}

.console-inspector-disabled-reason {
    height: 0;
    min-height: 0;
}

/* PR2b Task 3: the reusable Inspector-style section component (header +
   optional chevron + optional right-aligned summary, row body, optional
   "View all" tail). Ships the grammar once -- Agents (Task 4) is the first
   consumer; Changes/Sources/Workspace sections follow later against these
   same classes (spec section 7). */
.console-inspector-section {
    height: auto;
    min-height: 0;
    margin: 0 0 1 0;
}

.console-inspector-section-header {
    height: 1;
    min-height: 1;
    layout: horizontal;
    align: left middle;
}

.console-inspector-section-title {
    width: 1fr;
    min-width: 0;
    height: 1;
    text-style: bold;
    color: $ds-text-primary;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.console-inspector-section-summary {
    width: auto;
    min-width: 0;
    height: 1;
    color: $ds-text-muted;
    text-align: right;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.console-inspector-section-toggle {
    width: 3;
    min-width: 3;
    height: 1;
    text-style: bold;
}

.console-inspector-section-toggle:focus {
    background: $ds-action-focus 30%;
    text-style: underline bold;
}

.console-inspector-section-body {
    height: auto;
    min-height: 0;
    padding: 0 0 0 1;
}

.console-inspector-section-row {
    height: auto;
    min-height: 2;
    padding: 0 1;
}

.console-inspector-section-row:focus {
    background: $ds-action-focus 20%;
}

.console-inspector-section-row-primary {
    height: 1;
    color: $ds-text-primary;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.console-inspector-section-row-secondary {
    height: 1;
    color: $ds-text-muted;
    text-style: dim;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* Status-colored variants of the row's PRIMARY line only -- the secondary
   (dimmed detail) line stays muted regardless of status. Class names are
   built via f-string interpolation in console_inspector_section.py, which
   is out of scope for test_css_class_coverage_contract.py by design (its
   docstring: "f-strings ... are out of scope"); these rules are shipped
   for real styling, not to satisfy that contract. */
.console-inspector-section-row-running > .console-inspector-section-row-primary {
    color: $ds-status-running;
}

.console-inspector-section-row-done > .console-inspector-section-row-primary {
    color: $ds-status-ready;
}

.console-inspector-section-row-error > .console-inspector-section-row-primary {
    color: $ds-status-error;
}

.console-inspector-section-row-blocked > .console-inspector-section-row-primary {
    color: $ds-status-blocked;
}

.console-inspector-section-view-all {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 1 0 0 0;
}

.console-live-work-source-readiness {
    height: auto;
    min-height: 0;
    margin: 0;
}

#console-live-work-section,
#console-live-work-header,
#console-pending-launch-card {
    height: auto;
    min-height: 0;
}

#console-live-work-section {
    margin: 1 0 0 0;
}

/* Context (staged sources) section pinned at the top of the Inspector rail
   body (task-400): bottom margin separates it from the run inspector below. */
.console-inspector-context-section {
    margin: 0 0 1 0;
    padding: 0 1;
}

.console-live-work-source-row {
    height: auto;
    min-height: 1;
}

.console-settings-summary {
    height: auto;
    min-height: 0;
    padding: 0 1;
}

.console-left-rail-section.console-settings-summary {
    margin: 0 0 1 0;
    padding: 0 1;
    border: none;
    background: $ds-surface-panel;
}

.console-inspector-session-settings {
    margin: 1 0 0 0;
    padding: 0 1;
    border: none;
    background: $ds-surface-panel;
}

.console-settings-header {
    height: 1;
    min-height: 1;
    layout: horizontal;
    align: left middle;
}

.console-settings-title {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    max-height: 1;
}

.console-settings-row {
    height: 1;
    min-height: 1;
    max-height: 1;
    overflow: hidden hidden;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#console-settings-open {
    width: auto;
    min-width: 9;
    max-width: 14;
    height: 1;
    min-height: 1;
    margin: 0;
}

#console-transcript-region,
#console-session-surface {
    height: 1fr;
    min-height: 0;
}

#console-session-surface {
    padding: 0;
    margin: 0;
    border: none;
}

#console-transcript-region {
    padding: 0 1;
    border: none;
    background: $ds-surface-panel;
}

#console-left-rail.console-edge-region-focused #console-context-rail-collapse,
#console-context-rail-handle.console-edge-region-focused #console-context-rail-open,
#console-right-rail.console-edge-region-focused #console-inspector-rail-collapse,
#console-inspector-rail-handle.console-edge-region-focused #console-inspector-rail-open {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* TASK-17651: the composer is a dense-form one-row field (task-1586
   convention), not a framed region. Zero chrome rows: no border box, no
   vertical padding — the bar IS its 1-4 draft rows. The one-column left
   edge is the structural marker; it recolors for the has-draft state and
   flips to thick focus accent (same column width, no layout shift). */
#console-native-composer {
    height: auto;
    min-height: $ds-console-composer-height;
    /* TASK-17654: moves with ConsoleComposerBar.MAX_DRAFT_ROWS. */
    max-height: 8;
    padding: 0 1;
    /* TASK-17657/17659: DELIBERATE one-row gap on each side of the composer
       (owner calls) — the bar floats clear of the status row above and the
       footer below. Not the TASK-17650 phantom: both rows are pinned by the
       single-separator contract test. Compact mode drops them. */
    margin: 1 0;
    layout: vertical;
    align: left middle;
    border: none;
    border-left: solid $ds-control-edge;
    background: $ds-surface-panel;
}

#console-native-composer.console-composer-has-draft {
    border-left: solid $ds-status-ready;
}

#console-native-composer.console-composer-focused {
    border-left: thick $ds-action-focus;
    background: $ds-input-focus-bg;
}

#console-native-composer:focus {
    /* The global *:focus outline (core/_reset.tcss) draws its corner
       glyphs INSIDE the one-row bar (there are no padding rows left to
       absorb it); the dense-form edge + background above is the focus
       treatment. */
    outline: none;
}

#console-native-composer.console-composer-setup-blocked #console-command-visible-text {
    color: $ds-status-warning;
}

#console-composer-expanded,
#console-composer-collapsed {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    layout: horizontal;
    align: left middle;
}

#console-prompt-improvement-recovery {
    display: none;
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    layout: horizontal;
    align: right middle;
}

#console-prompt-improvement-status {
    width: 1fr;
    min-width: 0;
    height: 1;
    color: $ds-status-ready;
    content-align: left middle;
    padding: 0 1;
}

#console-prompt-improvement-undo {
    width: 8;
    min-width: 8;
}

#console-prompt-improvement-review {
    width: 16;
    min-width: 16;
}

#console-native-composer.console-composer-collapsed {
    height: 1;
    min-height: 1;
    max-height: 1;
    padding: 0;
    border: none;
    border-left: solid $ds-control-edge;
    background: $ds-surface-raised;
}

#console-composer-status,
.console-composer-recovery,
.console-send-disabled-reason,
.console-control-label {
    height: 1;
    min-height: 1;
}

#console-composer-collapse {
    width: 12;
    min-width: 12;
}

#console-composer-collapsed-status {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    text-overflow: ellipsis;
    text-wrap: nowrap;
    color: $ds-text-muted;
}

#console-collapsed-stop-generation {
    width: 8;
    min-width: 8;
}

#console-composer-expand {
    width: 12;
    min-width: 12;
}

#console-command-visible-text {
    width: 1fr;
    min-width: 0;
    height: auto;
    min-height: 1;
    /* TASK-17654: moves with ConsoleComposerBar.MAX_DRAFT_ROWS. */
    max-height: 8;
    margin: 0 1 0 0;
    padding: 0 1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    overflow: hidden;
}

#console-native-composer.console-composer-has-draft #console-command-visible-text,
#console-native-composer:focus-within #console-command-visible-text,
#console-command-visible-text:focus {
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-composer-actions {
    width: 45;
    min-width: 45;
    max-width: 45;
    height: 1;
    min-height: 1;
    layout: horizontal;
    /* Left-aligned so Send stays flush against the draft it submits;
       Stop's budgeted-but-hidden slot sits after Mic at the right edge. */
    align: left middle;
}

.console-composer-recovery {
    width: 0;
    min-width: 0;
    max-width: 0;
    margin: 0 1 0 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-status-warning;
    text-style: bold;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

.console-send-disabled-reason {
    width: 0;
    min-width: 0;
    max-width: 0;
    margin: 0 1 0 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-status-warning;
    text-style: bold;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

/* TASK-2154.6 (FR-04): the idle "type a message" guidance is not a blocker,
   so it renders quietly instead of in the warning style above. */
.console-send-disabled-reason-idle {
    color: $ds-text-muted;
    text-style: none;
}

.console-voice-status {
    width: 0;
    min-width: 0;
    margin: 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-status-running;
    text-style: bold;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

.console-voice-status-error {
    color: $ds-status-error;
}

#console-command-input {
    display: none;
    width: 0;
    min-width: 0;
    height: 0;
    min-height: 0;
}

#console-composer-status {
    width: auto;
    min-width: 0;
}

#console-session-surface .chat-input-area {
    display: none;
}

.console-transcript-system-event {
    height: auto;
    min-height: 1;
    margin: 1 0 0 0;
    padding: 0 1;
    border-left: solid $ds-status-warning;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-chat-tabs,
#console-chat-tabs #chat-sessions-container,
#console-chat-tabs .chat-session {
    height: 100%;
    min-height: 0;
}

#console-transcript-surface {
    height: 1fr;
    min-height: 0;
    layers: console-background console-content;
}

#console-transcript-background-effect {
    layer: console-background;
    width: 100%;
    height: 100%;
    color: $ds-text-muted;
    background: transparent;
}

#console-native-transcript {
    height: 1fr;
    min-height: 0;
    padding: 0 1;
    /* TASK-20937.3: neither the transcript nor its region owns a frame
       edge. The workbench grid closes the surface at top/bottom, while
       Context and Inspect own the two interior dividers. */
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
    scrollbar-size: 1 1;
}

#console-transcript-surface #console-native-transcript {
    layer: console-content;
    height: 1fr;
    min-height: 0;
    background: transparent;
}

#console-transcript-title,
.console-transcript-title {
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    background: $ds-surface-panel;
    color: $ds-text-muted;
    text-style: none;
}

#console-transcript-region.console-transcript-region-focused #console-transcript-title {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

#console-native-tab-strip,
.console-session-tab-strip {
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    margin-bottom: 1;
    background: $ds-surface-panel;
}

/* Scrollable tab strip: overflow scrolls horizontally (wheel, keyboard, or
   scroll-to-active) instead of silently clipping tabs. The scrollbar itself
   is hidden because the strip is a single row tall. */
#console-native-tab-strip {
    scrollbar-size-horizontal: 0;
}

.console-session-tab,
#console-new-chat-tab,
#console-new-temporary-tab {
    width: auto;
    min-width: 8;
    height: 1;
    min-height: 1;
    /* TASK-2154.4 (LY-02): no CSS padding here -- Button's own line-pad (1
       cell each side, not zero-able in CSS) already provides the visual gap,
       and stacking padding on top of it left plain Buttons only width-4
       label cells: 'Temporary' (9 chars) clipped to 'Temporar' in its
       12-wide button. (Session tabs escaped: their nowrap+clip DEFAULT_CSS
       paints past the line-pad area up to the widget edge.) padding: 0
       leaves the label budget at width-2. */
    padding: 0;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-session-close-button {
    padding: 0;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-style: bold;
}

.console-session-tab-active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-session-tab-active:hover,
.console-session-tab-active:hover:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

#console-native-transcript:focus {
    /* TASK-17651: no border in either state (stable geometry, zero rows).
       TASK-20937.3 puts the non-color pane cue on the stable title row;
       the scrollbar recolor remains a secondary color cue.
       The global *:focus outline (core/_reset.tcss) would overpaint the
       outermost transcript CONTENT rows now that no border absorbs it —
       the reset's own documented DataTable pattern: opt out, recolor. */
    border: none;
    outline: none;
    scrollbar-color: $ds-focus-accent;
}

.console-transcript-rule {
    height: 1;
    min-height: 1;
    color: $ds-column-line;
    /* TASK-17658: the separator is a hatch fill, not a fixed-length dash
       string — it reaches edge to edge at any terminal width. */
    hatch: horizontal $ds-column-line;
}

.console-transcript-message {
    height: auto;
    min-height: 1;
    padding: 0 1;
    margin: 0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

/* TASK-19426: one causal Assistant turn owns its activity disclosures,
   final answer, and adjuncts. The left-edge ownership accent is singular;
   nested activity rows stay quiet so they read as evidence inside the turn
   rather than as neighboring transcript cards. */
.console-assistant-turn {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0;
    padding: 0 1 1 1;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.-dark-mode .console-assistant-turn {
    border-left: tall $ds-chat-assistant-accent-dark;
}

.-light-mode .console-assistant-turn {
    border-left: tall $ds-chat-assistant-accent-light;
}

.console-assistant-turn > .console-message-header,
.console-assistant-activity-stack,
.console-assistant-adjunct-stack {
    width: 100%;
    height: auto;
    min-height: 0;
}

.console-assistant-turn > .console-message-header {
    height: 1;
    min-height: 1;
}

.console-assistant-activity-stack {
    padding: 0 1;
}

.console-assistant-turn > .console-transcript-message {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
}

/* Selection belongs to the answer, not its entire ownership surface. */
.console-assistant-turn > .console-transcript-message-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}

.console-activity-disclosure {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0;
    padding: 0;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-activity-header {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    overflow: hidden;
}

.console-activity-label {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    overflow: hidden;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.console-activity-status {
    width: 9;
    min-width: 9;
    max-width: 9;
    height: 1;
    min-height: 1;
    text-align: right;
    text-style: bold;
}

.console-activity-status-success {
    background: $ds-status-ready 10%;
    color: $ds-text-primary;
}

.console-activity-status-blocked {
    background: $ds-status-blocked 16%;
    color: $ds-text-primary;
}

.console-activity-status-failed {
    background: $ds-status-error 16%;
    color: $ds-text-primary;
}

.console-activity-status-done {
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-activity-status-live {
    background: $ds-status-running 12%;
    color: $ds-text-primary;
}

.console-activity-status-stopped,
.console-activity-status-unavailable {
    background: $ds-status-warning 12%;
    color: $ds-text-primary;
}

/* These height-one headers opt out of the global outline because it would
   paint over their only content row. Text + background + underline provide
   the non-color focus cue without changing geometry in either theme. */
.console-activity-header:focus {
    outline: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-activity-header-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

.console-activity-header:focus > .console-activity-status,
.console-activity-header-selected > .console-activity-status {
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-style: bold underline;
}

.console-activity-disclosure-selected > .console-activity-action-stack {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}

.console-activity-action-stack {
    width: 100%;
    height: auto;
    min-height: 0;
    padding: 0 1;
}

.console-activity-detail-stack {
    width: 1fr;
    min-width: 0;
    height: auto;
    min-height: 0;
    margin: 0 1 1 1;
    padding: 0 1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-activity-disclosure-expanded > .console-activity-detail-stack {
    background: $ds-surface-panel;
}

.console-activity-detail-stack .console-transcript-message {
    width: 100%;
    height: auto;
    padding: 0;
    background: transparent;
}

.console-activity-detail-stack .console-transcript-tool-diff {
    padding: 0 0 0 2;
}

.console-thinking-detail {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    text-wrap: wrap;
}

.console-transcript-message-roleplay-user,
.console-transcript-message-role-user {
    background: $primary 8%;
}

.console-transcript-message-roleplay-character,
.console-transcript-message-role-assistant {
    background: $accent 8%;
}

.console-transcript-speaker-label,
.console-transcript-message-body {
    height: auto;
}

.console-transcript-speaker-label {
    color: $ds-text-primary;
    text-style: bold;
}

.console-message-header {
    width: 100%;
    height: 1;
    min-height: 1;
}

.console-message-header > .console-transcript-speaker-label {
    width: 1fr;
    height: 1;
    min-height: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.console-message-speech-presentation {
    width: 14;
    min-width: 14;
    height: 1;
    min-height: 1;
    align: right middle;
}

.console-message-speech-status {
    width: 10;
    min-width: 10;
    height: 1;
    min-height: 1;
    color: $ds-text-muted;
    text-align: right;
}

Button.console-message-speech-action {
    width: 4;
    min-width: 4;
    max-width: 4;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: $ds-text-primary;
}

Button.console-message-speech-action:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-transcript-roleplay-user-label {
    color: $ds-chat-user-accent;
    text-style: bold;
}

.console-transcript-roleplay-character-label {
    color: $ds-chat-user-accent;
    text-style: bold;
}

.console-transcript-role-assistant-label {
    color: $ds-chat-user-accent;
    text-style: bold;
}

.-dark-mode .console-transcript-roleplay-user-label {
    color: $ds-chat-user-accent-dark;
}

.-light-mode .console-transcript-roleplay-user-label {
    color: $ds-chat-user-accent-light;
}

.-dark-mode .console-transcript-roleplay-character-label,
.-dark-mode .console-transcript-role-assistant-label {
    color: $ds-chat-assistant-accent-dark;
}

.-light-mode .console-transcript-roleplay-character-label,
.-light-mode .console-transcript-role-assistant-label {
    color: $ds-chat-assistant-accent-light;
}

/* Immersive RP is opt-in: prose follows the semantic speaker accent while
   Markdown's own code/link nodes retain their more specific readable styles. */
.console-transcript-message-immersive-user > .console-transcript-message-body,
.console-transcript-message-immersive-user > .console-markdown-body {
    color: $ds-chat-user-accent;
}

.-dark-mode .console-transcript-message-immersive-user > .console-transcript-message-body,
.-dark-mode .console-transcript-message-immersive-user > .console-markdown-body {
    color: $ds-chat-user-accent-dark;
}

.-light-mode .console-transcript-message-immersive-user > .console-transcript-message-body,
.-light-mode .console-transcript-message-immersive-user > .console-markdown-body {
    color: $ds-chat-user-accent-light;
}

.console-transcript-message-immersive-assistant > .console-transcript-message-body,
.console-transcript-message-immersive-assistant > .console-markdown-body,
.console-transcript-message-immersive-character > .console-transcript-message-body,
.console-transcript-message-immersive-character > .console-markdown-body {
    color: $ds-chat-user-accent;
}

.-dark-mode .console-transcript-message-immersive-assistant > .console-transcript-message-body,
.-dark-mode .console-transcript-message-immersive-assistant > .console-markdown-body,
.-dark-mode .console-transcript-message-immersive-character > .console-transcript-message-body,
.-dark-mode .console-transcript-message-immersive-character > .console-markdown-body {
    color: $ds-chat-assistant-accent-dark;
}

.-light-mode .console-transcript-message-immersive-assistant > .console-transcript-message-body,
.-light-mode .console-transcript-message-immersive-assistant > .console-markdown-body,
.-light-mode .console-transcript-message-immersive-character > .console-transcript-message-body,
.-light-mode .console-transcript-message-immersive-character > .console-markdown-body {
    color: $ds-chat-assistant-accent-light;
}

/* TASK-1990.1/TASK-22454: flavor assistant / character prose without rewriting
   Markdown. Quoted speech, quoted inner thought, emphasis-as-action, and strong
   emphasis are Content component spans; visible delimiters, text styles, labels,
   and Markdown structure continue to carry meaning without color. */
.-dark-mode .console-transcript-message-immersive-assistant .console-roleplay-markdown-block > .console-rp-speech,
.-dark-mode .console-transcript-message-immersive-character .console-roleplay-markdown-block > .console-rp-speech {
    color: $ds-chat-rp-speech-dark;
}

.-light-mode .console-transcript-message-immersive-assistant .console-roleplay-markdown-block > .console-rp-speech,
.-light-mode .console-transcript-message-immersive-character .console-roleplay-markdown-block > .console-rp-speech {
    color: $ds-chat-rp-speech-light;
}

.-dark-mode .console-transcript-message-immersive-assistant .console-roleplay-markdown-block > .console-rp-thought,
.-dark-mode .console-transcript-message-immersive-character .console-roleplay-markdown-block > .console-rp-thought {
    color: $ds-chat-rp-thought-dark;
    text-style: italic;
}

.-light-mode .console-transcript-message-immersive-assistant .console-roleplay-markdown-block > .console-rp-thought,
.-light-mode .console-transcript-message-immersive-character .console-roleplay-markdown-block > .console-rp-thought {
    color: $ds-chat-rp-thought-light;
    text-style: italic;
}

.-dark-mode .console-transcript-message-immersive-assistant .console-roleplay-markdown-block > .console-rp-action,
.-dark-mode .console-transcript-message-immersive-character .console-roleplay-markdown-block > .console-rp-action {
    color: $ds-chat-rp-action-dark;
    text-style: italic;
}

.-light-mode .console-transcript-message-immersive-assistant .console-roleplay-markdown-block > .console-rp-action,
.-light-mode .console-transcript-message-immersive-character .console-roleplay-markdown-block > .console-rp-action {
    color: $ds-chat-rp-action-light;
    text-style: italic;
}

.-dark-mode .console-transcript-message-immersive-assistant .console-roleplay-markdown-block > .console-rp-strong,
.-dark-mode .console-transcript-message-immersive-character .console-roleplay-markdown-block > .console-rp-strong {
    color: $ds-chat-rp-strong-dark;
    text-style: bold;
}

.-light-mode .console-transcript-message-immersive-assistant .console-roleplay-markdown-block > .console-rp-strong,
.-light-mode .console-transcript-message-immersive-character .console-roleplay-markdown-block > .console-rp-strong {
    color: $ds-chat-rp-strong-light;
    text-style: bold;
}

/* Failure is operational state, so it outranks roleplay identity tinting. */
.console-transcript-message-failed {
    background: $error 8%;
}

.console-transcript-message-failed > .console-transcript-speaker-label {
    width: auto;
    background: $error-darken-3;
    color: $ds-status-error-readable;
}

.console-transcript-message-failed > .console-transcript-message-body,
.console-transcript-message-failed > .console-markdown-body {
    color: $ds-text-primary;
}

.console-transcript-message-failed.console-transcript-message-markdown .console-roleplay-markdown-block > .console-rp-speech,
.console-transcript-message-failed.console-transcript-message-markdown .console-roleplay-markdown-block > .console-rp-thought,
.console-transcript-message-failed.console-transcript-message-markdown .console-roleplay-markdown-block > .console-rp-action,
.console-transcript-message-failed.console-transcript-message-markdown .console-roleplay-markdown-block > .console-rp-strong {
    color: $ds-text-primary;
}

.console-transcript-message-selected {
    min-height: 2;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-transcript-message-selected > .console-transcript-speaker-label {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}


.console-transcript-message-selected > .console-transcript-message-body,
.console-transcript-message-selected > .console-markdown-body {
    color: $ds-focus-fg;
}

.console-transcript-message-selected.console-transcript-message-markdown .console-roleplay-markdown-block > .console-rp-speech,
.console-transcript-message-selected.console-transcript-message-markdown .console-roleplay-markdown-block > .console-rp-thought,
.console-transcript-message-selected.console-transcript-message-markdown .console-roleplay-markdown-block > .console-rp-action,
.console-transcript-message-selected.console-transcript-message-markdown .console-roleplay-markdown-block > .console-rp-strong {
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Turn file card selection parity with the message rows above. These rules
   live HERE, not in the widget's DEFAULT_CSS: they need the real
   $ds-focus-* tokens, and a widget-local `$var:` "fallback" would shadow
   the bundle's values for that whole CSS source (TASK-16811). */
ConsoleTurnFileCard.console-turn-file-card-selected {
    background: $ds-focus-bg;
}
ConsoleTurnFileCard.console-turn-file-card-selected .console-turn-file-header {
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* TASK-1846: this is the record of what an agent did to the user's machine
   -- what it read, what it wrote, what left the box. It rendered `dim italic`
   in muted grey, making the audit trail the LEAST legible text in the
   transcript. Tools are the egress boundary; their trace should read at
   least as clearly as ordinary prose. Italic is kept as the quiet
   distinguishing mark from user/assistant rows; `dim` is not. */
.console-transcript-message-tool {
    color: $ds-text-primary;
    text-style: italic;
}

/* TASK-1366: inline diff row under an expanded file-write TOOL marker.
   Indented to read as belonging to the marker above it; height stays
   auto so the mounted DiffView sizes itself. */
.console-transcript-tool-diff {
    height: auto;
    padding: 0 0 0 4;
}

.console-transcript-message-system {
    color: $ds-text-muted;
}

.console-transcript-citation-sources {
    width: auto;
    min-width: 13;
    height: 3;
    min-height: 3;
    margin: 0 0 1 1;
    padding: 0 1;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-muted;
}

.console-transcript-citation-sources:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

/* task-17169: inline review-note marker under an annotated message. A
   non-interactive Static (the note text IS the viewer), quiet like the
   citation chip but full-width so multi-line notes wrap. */
.console-transcript-annotations {
    width: 1fr;
    height: auto;
    margin: 0 0 1 1;
    padding: 0 1;
    background: $ds-surface-panel;
    color: $ds-text-muted;
}

/* console selection phase 5: docked status line for keyboard text-selection
   mode (`s`), same muted palette as the annotations marker above but pinned
   to the transcript's bottom edge like the jump pill (below), one row tall.
   Hidden until `_enter_keyboard_selection` shows it. */
.console-kb-selection-hint {
    dock: bottom;
    width: 100%;
    height: 1;
    padding: 0 1;
    background: $ds-surface-panel;
    color: $ds-text-muted;
}

/* TASK-385: a selected Tool/System row must read the same as a selected
   user/assistant row. The muted `-tool`/`-system` rules above share the
   single-class specificity of `-selected` and follow it in source order, so
   they would otherwise strip the selection treatment off the text. These
   two-class selectors out-specify them and re-assert the focus colours + bold
   underline for the selected state. */
.console-transcript-message-tool.console-transcript-message-selected,
.console-transcript-message-system.console-transcript-message-selected {
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* TASK-371: docked "jump to latest" pill shown while the reader is scrolled up
   during (or just after) a streaming reply. Pinned to the transcript's bottom
   edge, high-contrast so it reads as an actionable status, click to re-attach. */
.console-transcript-jump-pill {
    dock: bottom;
    width: 100%;
    height: 1;
    content-align: center middle;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

/* TASK-2154.11 (DS-05): the pill is keyboard-focusable now. Its resting
   style already uses the focus colours, so the focused cue adds the
   underline; the height-1 row must suppress the global `*:focus {
   outline: solid }` fallback, which would overlay border glyphs and hide
   the label (same defect class as TASK-383's chip rule above). */
.console-transcript-jump-pill:focus {
    outline: none;
    text-style: bold underline;
}

/* task-558: the image-generation card row (border/border_title are set in
   Python -- ConsoleGenerationCard.__init__ -- since Textual widget borders
   aren't otherwise reachable from a class rule here; this adds the
   surrounding spacing/background the plain .console-transcript-message row
   gets, which the card previously had none of). */
.console-generation-card {
    height: auto;
    margin: 0 0 1 0;
    padding: 1;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-generation-card-details {
    height: auto;
    min-height: 1;
    padding: 1 0 0 0;
}

.console-generation-card-image-placeholder {
    color: $ds-text-muted;
    text-style: dim italic;
}

/* task-3401.5/.9: video generation card + silent in-card preview (mirrors
   the image generation card's panel treatment; the preview frame reuses the
   inline-image max bounds from Python -- ConsoleVideoPreview -- and only
   needs spacing/colors here). */
.console-video-card {
    height: auto;
    margin: 0 0 1 0;
    padding: 1;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-video-card-status {
    color: $ds-text-primary;
    text-style: bold;
}

.console-video-card-status-expired {
    color: $ds-text-muted;
    text-style: dim italic;
}

.console-video-card-details {
    height: auto;
    min-height: 1;
    padding: 1 0 0 0;
}

.console-video-preview {
    height: auto;
    padding: 0 0 1 0;
}

.console-video-preview-frame {
    color: $ds-text-primary;
    height: auto;
}

.console-video-preview-progress {
    color: $ds-text-muted;
    height: 1;
}

/* task-3401.10: modal full-player screen -- centered panel, frame area above
   a status line (position/drift/dropped/mode) and the hints line (only
   implemented actions, decision 031). */
VideoPlayerScreen {
    align: center middle;
}

VideoPlayerScreen .video-player-frame {
    height: auto;
    max-height: 26;
    padding: 0 1;
}

#video-player-status {
    color: $ds-text-muted;
    height: 1;
    padding: 0 1;
}

#video-player-hints {
    color: $ds-text-muted;
    text-style: dim;
    height: 1;
    padding: 0 1;
}

.console-transcript-action-row {
    height: 3;
    min-height: 3;
    margin: 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-transcript-action-guide {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    color: $ds-text-muted;
}

.console-modal-header {
    height: 1;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

ConsoleCitationSourcesModal {
    align: center middle;
}

#console-citation-sources-modal {
    width: 94;
    max-width: 96%;
    height: 34;
    max-height: 90%;
    padding: 1 2;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

#console-citation-sources-state {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

#console-citation-sources-body {
    width: 100%;
    height: 1fr;
    min-height: 8;
}

#console-citation-source-list {
    width: 34%;
    min-width: 18;
    height: 100%;
    margin: 0 1 0 0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

#console-citation-source-list ListItem {
    width: 100%;
    height: auto;
    min-height: 2;
    padding: 0 1;
    color: $ds-text-primary;
}

#console-citation-source-detail {
    width: 1fr;
    height: 100%;
    min-width: 0;
    padding: 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

#console-citation-source-marker {
    height: auto;
    min-height: 1;
    color: $ds-text-muted;
    text-style: bold;
}

#console-citation-source-title {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-primary;
    text-style: bold;
}

#console-citation-source-chunk {
    width: 100%;
    height: auto;
    min-height: 1;
    color: $ds-text-primary;
}

#console-citation-sources-close {
    width: 12;
    min-width: 12;
    height: 3;
    min-height: 3;
    margin: 1 0 0 0;
}

.console-transcript-action-button {
    width: auto;
    min-width: 5;
    height: 3;
    min-height: 3;
    padding: 0 1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-transcript-action-button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

.console-workspace-selector-row {
    margin: 0 0 1 0;
    padding: 0 1;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-style: bold;
}

.console-workspace-status-pair {
    height: auto;
    min-height: 1;
    margin: 0;
}

.console-workspace-status-label {
    color: $ds-text-muted;
    text-style: bold;
}

.console-workspace-status-value {
    color: $ds-text-primary;
}

.console-workspace-empty-copy {
    color: $ds-text-muted;
}

/* TASK-716: pressable-but-blocked Library source actions render dim; the
   press handler explains the block instead of a dead disabled button. */
.library-source-action-blocked {
    color: $ds-text-muted;
}

/* TASK-717: conversation rows whose record is proven missing render dim and
   inert instead of impersonating openable chats. */
.console-workspace-conversation-row-broken {
    color: $ds-text-muted;
    text-style: italic;
}

.console-workspace-action-row {
    /* The fixed tray reserves one cell for its native-scroll sibling's
       scrollbar lane; keep the compact strip inside the tray clip. */
    width: 99%;
    max-width: 100%;
    height: auto;
    min-height: 1;
    /* TASK-2154.3 (LY-07): the rail IA spec's 12-col left indent (buttons
       aligned under the value column) assumed a ~35-col rail. The real rail
       renders at 24-30 cols, so the indent left only 3-6 cells for the
       buttons -- Switch clipped to "Switc", the former RAG Scope label to
       "RAG S"/"RA", and
       New rendered past the rail clip (invisible but clickable). Left-align
       the rows: Switch + New = 13 cells and RAG = 5 both fit the
       23-cell content width at the rail's 30-col minimum. */
    margin: 0;
}

.console-workspace-context-action-row {
    width: 99%;
    max-width: 100%;
    height: 1;
    min-height: 1;
    margin: 0;
}

#console-workspace-tree-selection-context {
    width: 99%;
    max-width: 100%;
    height: 1;
    min-height: 1;
    max-height: 1;
    color: $ds-text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.console-workspace-action {
    height: 1;
    min-height: 1;
    margin: 0 1 0 0;
    /* TASK-712: Textual's default Button min-width (16) made Switch consume
       the whole action row, pushing New's label past the rail clip -
       invisible but still clickable. Size the compact actions to their
       labels so both fit the row. */
    min-width: 5;
    width: auto;
}

#console-workspace-search {
    width: 100%;
    min-width: 0;
    height: 3;
    min-height: 3;
}

#console-workspace-tree-star {
    width: 100%;
    min-width: 6;
    height: 1;
    min-height: 1;
    margin: 0;
}

#console-workspace-search-status {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#console-transcript-empty-state,
.console-transcript-empty-panel {
    height: 100%;
    min-height: 100%;
    width: 100%;
    layout: vertical;
    /* LY-12 (TASK-2154.24): center the empty/ready state so a fresh session
       reads as intentionally empty, not as a broken bottom-anchored void. */
    align: center middle;
    padding: 1 2;
    background: transparent;
    color: $ds-text-primary;
}

#console-shell .workbench-recovery-callout,
#console-control-bar,
#console-workspace-grid,
#console-transcript-region,
#console-native-composer {
    opacity: 100%;
}

.console-transcript-empty-body {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0;
    text-align: center;
    color: $ds-text-muted;
}

/* TASK-2154.8 (FR-03): in-panel provider recovery action for the quiet empty
   state (provider blocked, no blocking card); mirrors the setup modal's
   compact action styling so the affordance reads as the same control. */
.console-empty-provider-action {
    width: auto;
    min-width: 12;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    background: $ds-focus-bg;
    color: $ds-text-primary;
    content-align: left middle;
}

.console-empty-provider-action:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-setup-step {
    height: auto;
    min-height: 1;
    color: $ds-text-primary;
    /* TASK-389 made a height-1 line ellipsize on unavoidable overflow instead
       of silently clipping. TASK-441: ellipsizing still drops the tail of the
       sentence, so wrap onto a second row instead -- height:auto (Static's
       default text-wrap is already "wrap") lets the widget grow to fit
       however many rows a narrow terminal's capped card width needs, and
       .console-setup-modal-card's own height:auto absorbs the extra row. */
}

.console-setup-step-done {
    color: $ds-text-muted;
}

.console-setup-step-active {
    text-style: bold;
}

.console-setup-step-pending {
    color: $ds-text-muted;
}

/* First-run blocking setup modal: a Console-scoped overlay layer painted over
 * the whole Console shell (rail + transcript + composer) while setup is
 * incomplete. The app tab bar lives outside the shell and stays reachable. */
#console-shell {
    layers: console-workbench console-setup-overlay;
}

/* task-18812 / ADR-071: focus mode. The -focus class lives on the
   ChatScreen itself (MainNavigationBar is composed by BaseAppScreen as a
   sibling of #console-shell, so #console-shell-rooted selectors cannot
   reach it). display:none only — no raw visual values (ADR-042). The
   one-line #screen-footer-status status bar is intentionally KEPT. */
ChatScreen.-focus MainNavigationBar {
    display: none;
}

ChatScreen.-focus #console-workbench-header {
    display: none;
}

/* TASK-2154.1 (LY-09): at 60x18 the transcript body shrinks to a single row;
   the empty panel's default padding (1 2) and body margin would consume it
   with blank space, hiding the ready line. Compact mode drops the vertical
   chrome so the empty-state copy always paints. */
#console-shell.-console-compact .console-transcript-empty-panel {
    padding: 0 1;
}

#console-shell.-console-compact .console-transcript-empty-body {
    margin: 0;
}

/* TASK-2154.1 (LY-09): the tab strip's separator margin costs one row the
   transcript body needs at 60x18 -- title (1) + strip (1) + margin (1)
   already consume the whole region budget there, leaving the empty panel
   clipped to zero height. Compact mode drops the separator. */
#console-shell.-console-compact #console-native-tab-strip,
#console-shell.-console-compact .console-session-tab-strip {
    margin-bottom: 0;
}

/* TASK-2154.1 (LY-09): keep the historical compact override explicit so
   neither focus nor compact mode can resurrect the removed transcript frame. */
#console-shell.-console-compact #console-native-transcript,
#console-shell.-console-compact #console-native-transcript:focus {
    border: none;
}

/* TASK-17657: the composer's breathing-room row is a luxury compact mode
   cannot afford — same grammar as the tab strip's dropped margin. */
#console-shell.-console-compact #console-native-composer {
    margin: 0;
}

#console-setup-modal {
    layer: console-setup-overlay;
    display: none;
    width: 100%;
    height: 100%;
    align: center middle;
    /* $background is a distinctly darker token than the Console shell's own
     * $ds-surface-panel background, so this alpha fill actually blends to a
     * dimmed shade (verified: ~#191d21 vs the shell's flat #242f38) instead
     * of a same-color no-op like the previous $ds-surface-panel 80% fill. */
    background: $background 60%;
    layers: console-setup-snow console-setup-card;
}

.console-setup-modal-backdrop-snow {
    layer: console-setup-snow;
    width: 100%;
    height: 100%;
    color: $ds-text-muted;
}

/* Console's rendered frame color (#6f7782) — see Console_Modules.frame.CONSOLE_FRAME_COLOR. */
.console-setup-modal-card {
    layer: console-setup-card;
    /* TASK-389: 62 gave 56 content cells (−2 border −4 padding); the honest
       step-3 line "…Composer unlocks after setup" is 59 cells, so its last word
       wrapped off. 66 gives 60 content cells so the full sentence fits. */
    width: 66;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    layout: vertical;
    border: solid #6f7782;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-setup-modal-title {
    height: 1;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0;
    color: $ds-text-primary;
    text-style: bold;
}

/* Task-2852: receipt line for a "Use in Console" handoff (e.g. Library
   Search/RAG evidence) staged while setup is still incomplete -- without
   this, evidence staged just before landing here was invisible under the
   opaque setup overlay (the staged-evidence strip it lives in is part of
   the covered workbench). height: auto (not a fixed height: 1) so a long
   source name wraps instead of clipping, matching .console-setup-step. */
.console-setup-modal-staged-notice {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0;
    color: $ds-status-info;
}

/* TASK-2154.8 (FR-10): plain-language "what is a provider" line under the
   card title; wraps like the step rows do on narrow terminals. */
.console-setup-modal-subtitle {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0;
    color: $ds-text-muted;
}

.console-setup-modal-action {
    width: auto;
    min-width: 12;
    height: 1;
    min-height: 1;
    margin: 1 0 0 0;
    padding: 0 1;
    border: none;
    background: $ds-focus-bg;
    color: $ds-text-primary;
    content-align: left middle;
}

.console-setup-modal-action:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

#console-chat-tabs {
    display: none;
}

#console-session-surface .chat-empty-state {
    min-height: 5;
    padding: 0 1;
    text-align: left;
    content-align: left top;
    border-bottom: solid $ds-grid-line;
    background: $ds-surface-panel;
}

#console-session-surface .chat-log {
    padding: 0 1;
    background: $ds-surface-panel;
    border: tall $ds-grid-line;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
    scrollbar-size: 1 1;
}

#console-send-message,
#console-stop-generation {
    width: 6;
    min-width: 6;
}

/* Attach and Save Chatbook moved into the composer's ☰ menu, so their
   sizing rules went with them -- a fixed width for a button that no
   longer renders is dead weight the next reader has to disprove. */
#console-send-message,
#console-stop-generation {
    height: 1;
    min-height: 1;
}

.console-action-primary {
    border: none;
    height: 1;
    min-height: 1;
    background: $ds-action-focus 35%;
    color: $ds-text-primary;
    text-style: bold;
}

.console-action-secondary {
    border: none;
    height: 1;
    min-height: 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-action-subdued {
    border: none;
    height: 1;
    min-height: 1;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: none;
}

.console-action-disabled {
    border: none;
    height: 1;
    min-height: 1;
    background: $ds-surface-panel;
    color: $ds-text-disabled;
    text-style: none;
}

.console-action-disabled:hover,
.console-action-disabled:focus,
.console-action-disabled:hover:focus {
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-disabled;
    text-style: none;
    outline: none;
}

#console-stop-generation.console-stop-active {
    border: none;
    background: $ds-status-warning 20%;
    color: $ds-text-primary;
    text-style: bold;
}

.console-control-label,
.console-staged-context-row,
.console-staged-context-summary,
.console-staged-context-recovery {
    width: auto;
    min-width: 0;
    height: auto;
}

.console-staged-context-header {
    height: auto;
    min-height: 1;
}

#console-staged-context-title {
    width: 1fr;
    text-style: bold;
}

#console-staged-context-count {
    width: auto;
    text-align: right;
    color: $ds-text-muted;
}

.console-staged-source-row {
    height: auto;
    min-height: 2;
    margin: 1 0 0 0;
}

.console-staged-source-name {
    text-wrap: wrap;
    max-height: 2;
    overflow: hidden;
}

.console-staged-source-status {
    height: 1;
    color: $ds-text-muted;
}

.console-staged-source-status.ready { color: $ds-status-ready; }
.console-staged-source-status.running { color: $ds-status-running; }
.console-staged-source-status.blocked { color: $ds-status-blocked; }

#console-staged-context-empty {
    color: $ds-text-muted;
}

/* RAG UX v2 PR-4 (task-1): the staged-evidence strip -- the MAIN-surface
   reader of the pending live-work launch, mounted directly above the
   composer (the status chips sit below the composer). Hidden entirely
   (`display` toggled from the widget)
   when nothing is staged, so it costs zero rows on the common path.
   M3 (final review): `min-height: 1` overrides the shared `.ds-panel`
   `min-height: 3` -- with 1-2 rows of real content (a header row plus N
   evidence rows) that left blank filler rows beneath the last row.
   Sibling to the `#console-status-chips` `min-height: 1` override above
   for the same reason on that other small fixed-content Console panel. */
#console-staged-evidence-strip {
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 1;
    max-height: 6;
    border: none;
    padding: 0 1;
    margin: 0;
}

.console-staged-evidence-header {
    width: 100%;
    height: 1;
    min-height: 1;
    layout: horizontal;
}

.console-staged-evidence-heading {
    width: 1fr;
    min-width: 0;
    height: 1;
    color: $ds-text-muted;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

.console-staged-evidence-unstage {
    width: auto;
    min-width: 9;
    height: 1;
    min-height: 1;
    border: none;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-staged-evidence-row {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    color: $ds-text-primary;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

.console-staged-evidence-row.blocked {
    color: $ds-status-blocked;
}

.console-staged-evidence-row.running {
    color: $ds-status-running;
}

.console-staged-evidence-row.muted {
    color: $ds-text-muted;
}

.console-staged-evidence-overflow,
.console-staged-evidence-notice {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    color: $ds-text-muted;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

/* task-9: Inspector retrieval-scope row -- sibling of the Sources tray,
   never a row inside it. */
#console-retrieval-scope-row {
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 1;
    max-height: 1;
    margin: 1 0 0 0;
}

.console-retrieval-scope-label {
    width: 1fr;
    min-width: 0;
    color: $ds-text-muted;
}

.console-retrieval-scope-action {
    width: auto;
    margin-left: 1;
}

.console-compact-model-bar {
    width: auto;
    min-width: 0;
}


#artifacts-workbench,
#personas-workbench,
#watchlists-workbench,
#workflows-workbench,
#mcp-workbench,
#acp-workbench,
#skills-workbench,
#settings-workbench,
#evals-workbench {
    height: 1fr;
    /* Must stay below the worst-case available height at small terminal
       sizes, otherwise content overflows and the footer status bar
       intercepts clicks on the covered rows. Pane content scrolls
       internally. */
    min-height: 10;
    padding: 1;
    margin: 0;
    overflow: hidden;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

/* Settings density: the workbench panes themselves carry borders and
   padding, so the frame would only double them up. */
#settings-workbench {
    padding: 0;
    border: none;
}

#artifacts-list-pane,
#artifacts-detail-pane,
#artifacts-inspector-pane,
#personas-list-pane,
#personas-detail-pane,
#personas-inspector-pane,
#watchlists-detail-pane,
#watchlists-inspector-pane,
#workflows-list-pane,
#workflows-detail-pane,
#workflows-inspector-pane,
#mcp-server-tree-pane,
#mcp-detail-pane,
#mcp-readiness-pane,
#acp-list-pane,
#acp-detail-pane {
    margin: 0 1 0 0;
}

#artifacts-inspector-pane,
#personas-inspector-pane,
#watchlists-inspector-pane,
#workflows-inspector-pane,
#mcp-readiness-pane,
#acp-inspector-pane {
    margin: 0;
}

#personas-list-pane,
#personas-detail-pane,
#personas-inspector-pane,
#watchlists-detail-pane,
#watchlists-inspector-pane,
#workflows-list-pane,
#workflows-detail-pane,
#workflows-inspector-pane,
#acp-list-pane,
#acp-detail-pane,
#acp-inspector-pane,
#evals-library-pane,
#evals-detail-pane,
#evals-inspector-pane {
    height: 100%;
    min-height: 0;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

#personas-inspector-pane {
    width: 2fr;
    min-width: 30;
    border: solid $ds-grid-line;
    padding: 1;
}

#personas-readiness-console {
    width: 100%;
    min-width: 0;
    height: auto;
    text-wrap: wrap;
}

/* Workbench column split (2:4:2). Required here because the generic
   .destination-workbench-pane width (1fr) outranks the screen's DEFAULT_CSS,
   which would squeeze the work area to a third of its intended width. */
#personas-library-pane {
    width: 2fr;
    min-width: 24;
}

#personas-work-area {
    width: 4fr;
    min-width: 40;
}

#personas-workbench.personas-workbench-compact {
    padding: 0;
}

#personas-library-pane.personas-workbench-compact-pane {
    width: 1fr;
    min-width: 16;
    padding: 0 1;
}

#personas-work-area.personas-workbench-compact-pane {
    width: 3fr;
    min-width: 34;
    padding: 0 1;
}

#personas-inspector-pane.personas-workbench-compact-pane {
    width: 1fr;
    min-width: 22;
    padding: 0 1;
}

#workflows-list-pane,
#acp-list-pane {
    width: 2fr;
    min-width: 30;
    border: solid $ds-grid-line;
    padding: 1;
}

#workflows-detail-pane,
#acp-detail-pane {
    width: 4fr;
    min-width: 52;
    border: solid $ds-grid-line;
    padding: 1;
}

#workflows-inspector-pane,
#acp-inspector-pane {
    width: 2fr;
    min-width: 34;
    border: solid $ds-grid-line;
    padding: 1;
}

.acp-selected-session-row {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.acp-inspector-group-title {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 1 0 0 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

#personas-list-detail-divider,
#personas-detail-inspector-divider,
#watchlists-list-detail-divider,
#watchlists-detail-inspector-divider,
#schedules-list-detail-divider,
#schedules-detail-inspector-divider,
#workflows-list-detail-divider,
#workflows-detail-inspector-divider,
#acp-list-detail-divider,
#acp-detail-inspector-divider {
    background: $ds-grid-line;
}

.artifacts-column-title,
.personas-column-title,
.watchlists-column-title,
.schedules-column-title,
.workflows-column-title,
.acp-column-title,
.skills-column-title,
.ccp-column-title,
.settings-column-title {
    width: 100%;
    height: 1;
    min-height: 1;
    padding: 0 1;
    margin: 0 0 1 0;
    background: $ds-surface-raised;
    /* task-1625: the pane titles are the screen's one visual-voice
       carrier -- Focus Phosphor per DESIGN.md, bold, nowhere else. */
    color: $accent;
    text-style: bold;
}

.settings-active-section {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

Button.settings-category-button {
    width: 100%;
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    padding: 0 1;
    /* Textual 8 Buttons default to line-pad: 1, reserving one cell on each
       side of the label (line-pad: 0 is not expressible in CSS). The
       #settings-category-pane min-width absorbs those 2 cells so labels
       never wrap into this clipped second line (task-1342). */
    content-align: left middle;
    text-align: left;
    background: $ds-surface-panel;
}

Button.settings-category-button.settings-active-section {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

Button.settings-category-button:focus {
    outline: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

Button.settings-category-button.settings-active-section:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

Button.settings-category-button.settings-active-section:hover,
Button.settings-category-button.settings-active-section:hover:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

Button.settings-category-button.settings-primary-search-match {
    color: $ds-text-primary;
    text-style: bold;
}

Button.settings-category-button.settings-secondary-search-match {
    color: $ds-text-muted;
}

#settings-category-search {
    width: 100%;
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    padding: 0 1;
    /* No border: at height 1 a border would clip the content row. The
       raised background carries the "this is a field" affordance, and
       focus/active below swap background+weight only, so the strip never
       changes height (stable-border-geometry contract). */
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#settings-category-search:focus {
    border: none;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
    text-style: bold;
    outline: none;
}

#settings-category-search.settings-category-search-active {
    border: none;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
}

.settings-category-search-help {
    width: 100%;
    min-height: 1;
    padding: 0 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

.settings-category-search-status {
    width: 100%;
    min-height: 2;
    padding: 0 1;
    margin: 0 0 1 0;
    color: $ds-text-primary;
    background: $ds-surface-panel;
}

.settings-search-empty {
    width: 100%;
    min-height: 3;
    padding: 1;
    margin: 1 0 0 0;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-muted;
}

#settings-shell Button:focus,
#settings-shell Button:hover:focus {
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold underline;
    outline: none;
}

.settings-category-group-title {
    width: 100%;
    height: 1;
    min-height: 1;
    padding: 0 1;
    margin: 0;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
    text-style: bold;
}

/* Collapsible rail-group toggle (Domain Defaults): renders like a group
   heading but behaves like the compact category buttons. */
Button.settings-category-group-toggle {
    width: 100%;
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    content-align: left middle;
    text-align: left;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
    text-style: bold;
}

Button.settings-category-group-toggle:focus {
    outline: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

/* Section headers inside the settings detail pane get a raised bar and a
   blank line above, so each content block reads as a distinct section.
   (The class itself is shared; scope stays inside settings.) */
#settings-detail-pane .destination-section {
    width: 100%;
    height: 1;
    min-height: 1;
    padding: 0 1;
    margin: 1 0 0 0;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.settings-state-banner {
    width: 100%;
    min-height: 1;
    padding: 0 1;
    margin: 0;
    /* task-1625: the State strip reads as a raised status surface (the
       task-345 focus steel at low alpha), not another flat prose row --
       it now leads with the persistence badge (task-1717), so it earns
       the emphasis. */
    background: $ds-focus-bg 30%;
    color: $ds-text-primary;
    text-style: bold;
}

.settings-detail-row {
    width: 100%;
    min-height: 1;
    padding: 0 1;
    margin: 0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

/* The narrow Scope Inspector keeps the airy row rhythm: its prose wraps at
   ~30 columns, so the blank line between rows earns its keep there (and
   the F6 fold-geometry contract measures against it). */
#settings-impact-pane .settings-detail-row {
    margin: 0 0 1 0;
}

.settings-input-row {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0;
}

/* The provider search is content-sized, while its OptionList owns a bounded
   scrolling viewport. Explicit sizing keeps following fields in document
   order at both the standard and compact Settings workbench widths. */
#settings-provider-picker-block {
    width: 100%;
    height: auto;
    min-height: 9;
}

#settings-provider-picker {
    width: 100%;
    height: 6;
    min-height: 6;
    max-height: 6;
}

.settings-select-row {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0;
}

.settings-input-label {
    /* task-1713: 12 cells truncated most labels ("Palette limit" ->
       "Palette", "Tool result display cap" -> "Tool result"), which read
       as unit-less mystery numerics in the critique. */
    width: 24;
    min-width: 12;
    height: 1;
    min-height: 1;
    padding: 0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-style: bold;
}

.settings-select-row .settings-input-label {
    height: 3;
    min-height: 3;
    content-align: left middle;
}

/* The Library/RAG detail card (Search/Embedding/Chunking/Vector store/
 * Reranking groups) has the longest field labels in Settings ("Default
 * results", "Embedding model ⚠", "Distance metric ⚠", "Rerank results", ...).
 * The generic 12-column label width clips them to their first wrapped word
 * (Static wraps at the column width but the row stays height:1, so only
 * that first line paints) -- e.g. "Default results" rendered as just
 * "Default", and "Reranker model"/"Reranker top-k" (pre UX-review-2026-07
 * naming) both rendered as the identical "Reranker". Widen the column for
 * this card only so every RAG label fits on one line unambiguously; other
 * Settings categories keep the base 12-column rhythm.
 */
#settings-library-rag-card .settings-input-label {
    width: 20;
    min-width: 20;
}

.settings-compact-input {
    width: 1fr;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    /* task-1586 control convention: the one-column left edge marks "this
       row is editable" at rest; full borders stay off because they cost
       a row above and below on these one-row fields. */
    border: none;
    border-left: solid $ds-control-edge;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
}

.settings-compact-input:focus {
    border: none;
    border-left: thick $ds-action-focus;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    /* No underline: it made placeholder copy read as a link (task-185). */
    text-style: bold;
    outline: none;
}

.settings-compact-input.settings-invalid-input,
.settings-compact-select.settings-invalid-input {
    background: $ds-status-error 18%;
    color: $ds-text-primary;
    text-style: bold;
    outline: none;
}

.settings-compact-input.settings-invalid-input:focus,
.settings-compact-select.settings-invalid-input:focus {
    /* task-1369: keep the error tint while focused so the invalid marker is
       not lost; slightly stronger than the unfocused 18% to still read as
       focused. */
    background: $ds-status-error 28%;
    color: $ds-text-primary;
    text-opacity: 1;
    text-style: bold;
    outline: none;
}

.settings-compact-select {
    width: 1fr;
    height: 3;
    min-height: 3;
    margin: 0;
    padding: 0;
    border: solid $ds-grid-line;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
}

.settings-compact-select > SelectCurrent {
    width: 1fr;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
    content-align: left middle;
}

.settings-compact-select:focus {
    border: solid $ds-action-focus;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
    outline: none;
}

.settings-compact-select:focus > SelectCurrent {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

.settings-compact-select > SelectOverlay {
    padding: 0 1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    min-width: 30;
}

.settings-compact-select > SelectOverlay Option {
    padding: 0 2;
    min-height: 3;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
}

.settings-compact-select > SelectOverlay Option:hover {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

.settings-compact-select > SelectOverlay Option.-selected {
    padding: 0 2;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.settings-provider-manual-hidden {
    display: none;
}

/* task-189: generation-profile rows a provider does not support are hidden
   entirely; the Generation defaults disclosure shows one summary line instead
   of per-row "Unavailable for <provider>" placeholders. */
.settings-gated-profile-hidden {
    display: none;
}

.settings-status-row {
    width: 100%;
    min-height: 1;
    padding: 0 1;
    margin: 0;
    background: $ds-surface-inspector;
    color: $ds-text-muted;
}

/* task-1341: intentional instant-apply controls are visually separated from
   staged fields with a bordered group plus an inline italic hint.
   task-1367: explicit height:auto -- the default Vertical 1fr never resolves
   inside the auto-height providers card and clipped every control. */
.settings-instant-apply-group {
    height: auto;
    border: solid $ds-column-line;
    background: $ds-surface-panel;
    padding: 0 1;
}

.settings-instant-apply-hint {
    color: $ds-text-muted;
    text-style: italic;
    padding: 0 1;
}

.settings-storage-check-result {
    min-height: 7;
}

.settings-dirty-category {
    color: $ds-status-unsaved;
    text-style: bold;
}

/* RAG profile-manager region (task-2): read-only note for a built-in active
   profile -- attention-worthy like #library-skill-warnings above, not muted
   like the surrounding .settings-status-row lines. */
.settings-library-rag-readonly-banner {
    color: $ds-status-warning;
    text-style: bold;
}

/* RAG profile editor (task-3 review): reranker top-k vs default-results
   advisory -- same attention-worthy treatment as the readonly banner above.
   Purely informational (never gates Save; see soft_config_warnings). */
.settings-library-rag-soft-warning {
    color: $ds-status-warning;
    text-style: bold;
}

/* Task 4 (541 v2 UX AC1): profile-picker PREVIEW banner -- shown only while
   the editor is displaying a browsed, non-active profile read-only. Same
   attention-worthy treatment as the readonly banner above (hidden by
   default via Static.display, toggled by _set_library_rag_preview_banner). */
.settings-library-rag-preview-banner {
    color: $ds-status-warning;
    text-style: bold;
}

RagProfileNameModal,
RagProfileSwitchConfirmModal {
    align: center middle;
}

.settings-rag-profile-modal {
    width: 60;
    height: auto;
    padding: 1 2;
    border: thick $ds-action-focus;
    background: $ds-surface-panel;
}

_CredentialEditorModal,
_CredentialClearModal {
    align: center middle;
}

.settings-speech-credential-modal {
    width: 70;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: thick $ds-action-focus;
    background: $ds-surface-panel;
}

/* task-2835: keyboard-reachable mirror of the focused control's tooltip,
   one muted line pinned under the Settings workbench. */
#settings-focus-help {
    height: 1;
    padding: 0 1;
    color: $ds-text-muted;
    background: $ds-surface-panel;
}

.settings-focus-card {
    width: 100%;
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

#settings-advanced-config-card {
    height: 1fr;
    min-height: 0;
}

.settings-secondary-card {
    /* task-1625: border titles ("Profiles") were dim grey on the border
       line -- near-invisible in the critique captures. */
    border-title-color: $ds-text-primary;
    border-title-style: bold;
    width: 100%;
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
    border: solid $ds-column-line;
    background: $ds-surface-panel;
}

/* Task 5 (541 v2 UX AC5): first-run starter panel -- replaces the "wall of
   disabled fields" a brand-new install used to show with a direct next
   step (Clone/Backfill). Accent border (same treatment as
   .settings-rag-profile-modal above) so it reads as the primary call to
   action, not just another secondary card. Hidden by default via
   Static.display, toggled by `_refresh_rag_first_run_panel_state`/composed
   directly by `_render_library_rag_detail`. */
.settings-library-rag-starter-panel {
    border: thick $ds-action-focus;
}

#settings-console-behavior-card {
    min-height: 12;
}

.settings-action-row {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0;
}

.settings-action-row Button {
    height: 1;
    min-height: 1;
    margin: 0 1 0 0;
}

.settings-action-row Button:focus,
#settings-impact-pane Button:focus {
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold underline;
    outline: none;
}

/* UX review item 7 (delete danger styling): visually separate the RAG
   profile-manager's destructive Delete button from the other three
   (Set active/Clone/Rename) in the same row -- variant="error" alone
   (settings_screen.py) gives it distinct color, but it still read as just
   another button in the row without the extra gap. */
.settings-library-rag-profile-delete-button {
    margin-left: 2;
}

.settings-sync-safety-row {
    width: 100%;
    padding: 0 1;
    background: $ds-surface-raised;
}

.settings-advanced-safety-status {
    background: $ds-status-unsaved 10%;
    color: $ds-status-unsaved;
    text-style: bold;
}

#settings-advanced-config-editor {
    height: 1fr;
    min-height: 10;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

/* Settings > Image Gen: the whole panel and its nested backend-editor
   scroll region default to Textual's framework-level width/height
   fallback (1fr) since neither `Vertical`/`VerticalScroll` declares one
   in DEFAULT_CSS for a widget shaped like this -- fine for a SINGLE
   dominant 1fr child (see InternalPromptsPanel's #internal-prompts-list),
   but this panel has MANY siblings (Backends block, the backend-editor
   region, Generation defaults, Style templates, Save/Revert) all
   competing for the SAME bounded 1fr height, which starved the backend-
   editor region down to ~1 row (verified live: region height 1 vs
   virtual_size height 46) and clipped everything below it (Generation
   defaults, Save/Revert) off the bottom entirely -- `settings-detail-
   pane` (the ancestor Settings already scrolls the WHOLE category
   through) is the one and only scroll owner here. */
#settings-imagegen-panel {
    height: auto;
}

#settings-imagegen-editor {
    height: auto;
}

/* Settings > Speech & TTS: the Settings detail pane is the single scroll
   owner. The panel must grow to its content instead of becoming a hidden-
   overflow 1fr viewport that strands Save below the terminal. */
#settings-speech-tts-panel {
    height: auto;
}

.settings-speech-provider-form,
.settings-speech-credential,
.settings-speech-control-stack {
    width: 100%;
    height: auto;
}

/* Mode-specific audio.cpp groups remain mounted so switching modes preserves
   focus and dormant values. They must size to their content; Textual's
   Vertical default of 1fr would otherwise add hundreds of blank rows and
   strand Save below the Settings scroll owner. */
#settings-speech-audio-cpp-external-fields,
#settings-speech-audio-cpp-managed-fields,
#settings-speech-audio-cpp-managed-lifecycle-fields,
#settings-speech-audio-cpp-manual-json-fields,
#settings-speech-audio-cpp-guided-fields,
#settings-speech-audio-cpp-guided-advanced-fields,
.settings-speech-audio-cpp-packages,
.settings-speech-audio-cpp-package-row {
    width: 100%;
    height: auto;
}

.settings-speech-audio-cpp-package-row {
    min-height: 1;
    margin: 1 0;
    padding: 0 1;
    background: $ds-surface-panel;
}

.settings-speech-audio-cpp-package-copy {
    width: 100%;
    height: auto;
    min-height: 1;
}

.settings-speech-audio-cpp-package-remove {
    width: auto;
    min-width: 0;
    height: 1;
    min-height: 1;
    margin: 1 0 0 0;
}

/* Field errors live below their control. As a third child of a Horizontal,
   the shared width:100% status row reduced otherwise usable controls to two
   cells even while empty. */
.settings-speech-input-row {
    height: auto;
    min-height: 1;
    align: left top;
}

.settings-speech-input-row.settings-select-row {
    min-height: 3;
}

.settings-speech-field-error {
    display: none;
    width: 100%;
    min-height: 1;
    margin: 0;
    color: $ds-status-error;
}

.settings-speech-field-error-visible {
    display: block;
}

.settings-speech-path-control {
    width: 100%;
    height: 1;
    min-height: 1;
}

.settings-speech-path-control .settings-compact-input {
    width: 1fr;
}

.settings-speech-path-picker {
    width: auto;
    min-width: 9;
    height: 1;
    min-height: 1;
    margin: 0 0 0 1;
}

.settings-speech-stacked .settings-speech-input-row {
    layout: vertical;
    height: auto;
    min-height: 3;
    margin-bottom: 1;
}

.settings-speech-stacked .settings-speech-input-row .settings-input-label,
.settings-speech-stacked .settings-speech-input-row .settings-speech-control-stack,
.settings-speech-stacked .settings-speech-input-row > Input,
.settings-speech-stacked .settings-speech-input-row > Select,
.settings-speech-stacked .settings-speech-input-row > Switch {
    width: 100%;
    min-width: 0;
}

.settings-speech-stacked #settings-speech-actions {
    layout: vertical;
    height: 4;
}

.settings-speech-stacked #settings-speech-actions Button {
    width: 100%;
    min-width: 0;
    margin-right: 0;
}

#settings-speech-details,
#settings-speech-scope-inspector {
    width: 100%;
    height: auto;
    min-height: 3;
    margin: 1 0 0 0;
    padding: 0;
    border: none;
    background: transparent;
}

#settings-speech-inspector {
    width: 100%;
    height: auto;
}

#settings-speech-details > CollapsibleTitle,
#settings-speech-scope-inspector > CollapsibleTitle {
    width: 100%;
    min-width: 0;
    height: 3;
    min-height: 3;
    padding: 1;
}

#settings-speech-details > Contents,
#settings-speech-scope-inspector > Contents {
    width: 100%;
    height: auto;
    padding: 0 1;
    background: transparent;
}

/* One row per backend inside the Backends block -- label, status badge,
   Enabled checkbox, default marker, Test button. height:auto (not the
   base .settings-input-row's fixed height:1) so the row never clips a
   wrapped Checkbox/Button. */
.settings-imagegen-backend-row {
    width: 100%;
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
    align: left middle;
}

/* min-width 6 (not Button's own default 16) + no left margin: at a
   120-column launch the "Preference Detail" pane is only ~53 columns
   wide, and this row packs 5 pieces (label, badge, checkbox, default
   marker, Test) -- every column here is contested (verified live:
   without this, the DEFAULT backend's row -- the one carrying "★
   Default" -- clipped Test entirely off the visible/clickable area). */
.settings-imagegen-backend-row Button {
    height: 1;
    min-height: 1;
    min-width: 6;
    margin: 0;
}

/* _conversations.tcss's bare `Checkbox { width: 100%; height: 2; }` is an
   unscoped TYPE selector that reaches every Checkbox app-wide (verified
   live: region.width computed to the ROW's full width, overlapping/
   clipping the marker and Test button that come after it in the SAME
   row) -- override both Enabled checkboxes (one per backend row) and the
   standalone "Context LLM enabled" checkbox back to a natural, single-
   line size within this panel specifically; never touching that shared
   global rule, which other screens may rely on. The backend-row Checkbox
   also drops its horizontal padding (unlike the roomier standalone
   context_llm_enabled one) -- same narrow-terminal column budget as the
   Button rule above. */
.settings-imagegen-backend-row Checkbox {
    width: auto;
    height: 1;
    min-height: 1;
    margin-bottom: 0;
    border: none;
    padding: 0;
}



#settings-imagegen-context_llm_enabled {
    width: auto;
    height: 1;
    min-height: 1;
    margin-bottom: 0;
    border: none;
    padding: 0 1;
}

/* No horizontal padding (final review): "Not configured" (14 chars) is
   the longest value this ever holds -- padding just wasted 2 more
   contested columns in the narrow-terminal row budget above. */
.settings-imagegen-badge {
    width: auto;
    min-width: 14;
    color: $ds-text-muted;
}

/* No min-width (final review): reserving 10 columns even when this row
   isn't the default (the common case -- 5 of 6 rows) was pure waste on a
   narrow terminal, where every column in a backend row is contested; let
   it shrink to 0 for an empty marker and grow only for "★ Default". */
.settings-imagegen-default-marker {
    width: auto;
    color: $ds-status-info;
    text-style: bold;
}

.settings-imagegen-hint {
    width: 100%;
    min-height: 1;
    padding: 0 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

.settings-imagegen-key-source {
    color: $ds-status-warning;
}

/* Task 5: the secret field's row grows an inline Clear button next to the
   masked Input -- Button's own default min-width (16) plus the fixed-
   width label would overflow the base .settings-input-row's width:100%/
   height:1 (no wrap headroom), so this row gets its own auto-height class
   and the Clear button gets a narrower min-width. */
.settings-imagegen-secret-row {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.settings-imagegen-secret-row Button.settings-imagegen-clear-button {
    width: auto;
    min-width: 8;
    height: 1;
    min-height: 1;
    margin: 0 0 0 1;
}

/* SwarmUI's swarm_token is optional for local installs -- its "missing"
   source line must not read as an error like the four remote API keys. */
.settings-imagegen-key-source-neutral {
    color: $ds-text-muted;
}

#library-source-browser {
    width: $ds-library-source-browser-width;
    min-width: $ds-library-source-browser-width;
    max-width: $ds-library-source-browser-width;
    height: 100%;
    min-height: 20;
    padding: 1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    overflow-y: auto;
}

.library-hub-spacer {
    height: 1;
    min-height: 1;
}

#library-source-inspector {
    width: 2fr;
    min-width: 0;
    height: 100%;
    min-height: 20;
    padding: 1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    overflow-y: auto;
}

#library-source-detail {
    width: 5fr;
    min-width: 0;
    height: 100%;
    min-height: 20;
    padding: 1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    overflow-y: auto;
}

.ds-shortcut-bar {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: $ds-surface-inspector;
    color: $ds-text-muted;
}

.density-compact .ds-panel,
.density-compact .ds-inspector,
.density-compact .ds-approval-card,
.density-compact .ds-recovery-callout {
    padding: 0 1;
    margin: 0 0 1 0;
}

.density-compact .ds-destination-header {
    min-height: 2;
    padding: 0 1;
}

.density-comfortable .ds-panel,
.density-comfortable .ds-inspector,
.density-comfortable .ds-approval-card,
.density-comfortable .ds-recovery-callout {
    padding: 1 2;
    margin: 1 1;
}

.density-comfortable .ds-destination-header {
    min-height: 4;
    padding: 1 2;
}

.is-active {
    border: round $ds-action-focus;
    text-style: bold;
}

.personas-mode-chip.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.personas-mode-chip.is-active:focus {
    outline: none;
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Keyboard-browse cursor: visually distinct from the flat subdued bg.
   $ds-grid-line (#26364D) is lighter than $ds-surface-raised/#ds-focus-bg
   (#142033) so browsed rows are visible without special-casing focus state.
   Place BEFORE the .is-active rules so equal-specificity cascade gives
   .is-active the final word. */
ListItem.personas-library-row.-highlight,
ListItem.personas-conversation-row.-highlight {
    background: $ds-grid-line;
    color: $ds-text-primary;
    text-style: bold;
}

/* Selected/active row: wins because it appears later in the sheet. */
ListItem.personas-library-row.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

/* Active row that is also the browse cursor: .is-active styling wins
   (later in sheet, same specificity as the -highlight rule above). */
ListItem.personas-library-row.is-active.-highlight {
    outline: none;
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

/* task-445: the global `*:focus { outline: solid $ds-focus-accent; }`
   fallback (core/_reset.tcss) draws its outline around the ListView's own
   box once it takes keyboard focus after a row is selected -- and that box
   is taller than the 1-2 rows it holds (it fills the rail's remaining
   height), so the outline rendered as a tall empty bordered rectangle
   hanging below the selected row (RP UX review). Rows already show
   selection via .is-active/.-highlight backgrounds above, so the fallback
   outline is both redundant and visually broken here. */
#personas-library-rows:focus {
    outline: none;
}

.library-source-action {
    width: $ds-library-source-action-width;
    min-width: $ds-library-source-action-min-width;
    height: $ds-library-source-action-height;
    min-height: $ds-library-source-action-height;
    margin: 0;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $ds-text-primary;
    content-align: left middle;
    text-style: none;
}

.library-source-action-spacer {
    height: 0;
    min-height: 0;
}

.library-source-active-marker {
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

.library-source-group-rule {
    height: 1;
    min-height: 1;
    margin: 0;
    color: $ds-text-muted;
}

.library-source-action:focus {
    border: none;
    background: transparent;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

.library-source-action.is-active,
.library-source-action.is-active:focus {
    border: none;
    background: transparent;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

#library-collection-form Input {
    height: 3;
    min-height: 3;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-collection-form Input:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-collection-actions {
    height: 1;
    min-height: 1;
    margin-top: 1;
    align: left middle;
}

#library-collection-actions Button {
    height: 1;
    min-height: 1;
    margin-right: 1;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $ds-text-primary;
    content-align: left middle;
    text-style: none;
}

#library-collection-actions Button:focus {
    border: none;
    background: transparent;
    color: $ds-focus-fg;
    outline: none;
    text-style: bold underline;
}

/* task-4023 AC#1 (RC-07): the ID-scoped Button rule above (1,0,1)
   outranks the shared `Button.library-source-action:disabled` escape
   (0,2,1) for color/background, so this container needs its own
   disabled variant at (1,1,1). Measured 2.30:1 before (the three
   compounding dimmers over `$ds-text-primary`); `$ds-text-muted` on
   this row's own surface clears the 3:1 floor while staying plainly
   dimmer than the enabled `$ds-text-primary` label beside it. The
   background stays transparent to match this row's resting/focus
   convention -- the "○" label marker (library_disabled_action_label)
   is the structural inert cue here. */
#library-collection-actions Button:disabled {
    opacity: 100%;
    text-opacity: 100%;
    border: none;
    background: transparent;
    color: $ds-text-muted;
    text-style: none;
}

/* Regression fix: #library-canvas (this panel's parent) and this panel's
 * own body never scrolled, so once the Query/Scope/Results/History regions'
 * combined natural height exceeded the fixed canvas box, whatever fell
 * past the bottom edge was silently clipped and permanently unreachable --
 * not just visually cut off, but gone, with no way to scroll to it. That
 * is what made multi-result searches render only the first row: rows past
 * whatever vertical room the Query and Scope regions left behind vanished.
 * Making the panel scrollable keeps every mounted row reachable regardless
 * of how many results (or how much recovery/callout copy) the current
 * state renders. */
#library-search-rag-panel {
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

.library-rag-region {
    width: 100%;
    min-width: 0;
    margin: 0 0 1 0;
}

/* Auto-height: the query row used to be a Horizontal (Input + Button side
 * by side) inside this container, sized with a hand-counted fixed height
 * (14, 17 with the recovery line). Stacking the query Input and Run button
 * as their own full-width rows (house canvas grammar) made that hand count
 * fragile -- content growth (e.g. the mode-toggle button) silently overflowed
 * the fixed height, clipping/overlapping the callout and Run button. Sizing
 * to content avoids re-counting rows by hand every time this region changes. */
#library-rag-query-controls {
    height: auto;
    min-height: 0;
}

/* Auto-height: B2 replaced the fixed pipe-drawn scope table (heading +
 * summary + table header + 7 rows, hand-counted at 13/16 lines) with a
 * heading, a summary line, and three toggle buttons -- a fixed hand count
 * here would re-introduce the exact clipping bug `#library-rag-query-controls`
 * already hit once (see the comment above it). */
#library-rag-source-scope {
    height: auto;
    min-height: 0;
}

#library-rag-results {
    height: auto;
    min-height: 8;
}

/* PR-3 Task 3: the Answer region mounts as its own sibling BETWEEN
 * `#library-rag-source-scope` and `#library-rag-results` (never inside the
 * latter -- see the mount-point comment in `LibrarySearchRagPanel.compose()`
 * and `library_rag_answer_children`'s docstring). Auto-height like its
 * sibling regions above: absent entirely on the idle/keyword-mode canvas,
 * one quiet line while generating, a full card once an answer lands. */
#library-rag-answer {
    height: auto;
    min-height: 0;
}

/* The answer IS the headline of rag mode (PR-3 Task 3) -- a raised card,
 * not a muted status line, so a grounded answer reads as this panel's
 * primary content rather than one more line among many. Reuses the same
 * surface/text tokens `.library-rag-result-row` already uses for its own
 * content-card treatment. */
#library-rag-answer-text {
    width: 100%;
    height: auto;
    padding: 1 1;
    margin: 0 0 1 0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

/* PR-3 Task 3: the provenance footer -- "provider · model · $cost (tokens)"
 * or the honest "pricing unknown"/no-usage shapes -- renders below
 * whatever status content the answer region already showed (answer text,
 * caution callout, abstention/no-evidence line, or failure + retry hint).
 * A hairline top divider (not `.library-rag-quiet-line`'s own margin/
 * padding alone) is what marks it as a FOOTER for that content rather than
 * one more quiet line among them. */
#library-rag-answer-provenance {
    margin: 0 0 1 0;
    padding: 1 1 0 1;
    border-top: solid $ds-grid-line;
}

#library-rag-query-input {
    width: 100%;
    min-width: 0;
    margin: 0 0 1 0;
    border: solid $ds-grid-line;
    border-bottom: solid $ds-grid-line;
    background: $ds-surface-raised;
}

#library-rag-query-input:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
}

#library-rag-scope-summary {
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.library-rag-scope-toggle {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.library-rag-scope-toggle:hover {
    background: $ds-action-focus 20%;
}

.library-rag-scope-toggle:disabled {
    color: $ds-text-disabled;
    background: $ds-surface-raised;
}

.library-rag-callout {
    width: 100%;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

/* Reserved for real failures only (unsafe query, missing dependencies/
 * index, no provider) -- the ready state has no callout at all (A2), and
 * the empty-query / no-scope gates render `.library-rag-quiet-line`
 * instead (A1), so there is no "is-ready" callout variant to style. */
.library-rag-callout.is-blocked {
    border: solid $ds-status-warning;
    background: $ds-status-warning 10%;
}

/* PR-3 Task 3 (carried Task 1 review ruling): an uncited/unverified
 * `ready` answer must show its citation-recovery copy at LEAST as
 * prominently as the answer text itself. Reuses the same bordered box and
 * warning token as `.is-blocked` above, under its own modifier name -- this
 * state is not a run-gate block (the query ran, and produced an answer);
 * keeping the two meanings distinct in the stylesheet matches the render
 * code, which never conflates "blocked" and "needs scrutiny" either. */
.library-rag-callout.is-caution {
    border: solid $ds-status-warning;
    background: $ds-status-warning 10%;
}

.library-rag-quiet-line {
    padding: 0 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

.library-rag-empty-guidance {
    margin: 1 0 0 0;
    padding: 0 1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

#library-rag-run-query {
    width: 18;
    min-width: 16;
    margin: 0 0 1 0;
    background: $ds-action-focus 35%;
    color: $ds-text-primary;
    text-style: bold;
}

#library-rag-run-query:disabled {
    background: $ds-surface-raised;
    color: $ds-text-disabled;
    text-style: none;
}

/* Task 12/RAG-36: each evidence row's content+actions is wrapped in one
 * focusable card so Tab gives keyboard users a per-row cursor (previously
 * only the row's buttons were focusable, with no indication of "where"
 * keyboard focus sat among results). Idiom mirrors
 * `#console-native-transcript`/`#library-rag-query-input`: the base rule
 * already reserves a `border: solid` + `border-bottom: solid` box, so the
 * `:focus` rule only swaps the border COLOR to `$ds-focus-accent` -- never
 * adding a border edge the base didn't already have reserved, which is
 * what causes layout jitter on focus/blur (see the stable-border-geometry
 * contract in `Tests/UI/test_non_obscuring_focus_contract.py`). Left
 * without background/color changes on purpose: `.library-rag-result-row.
 * is-selected` below already owns the $ds-focus-bg/$ds-focus-fg "this
 * evidence is selected" treatment, so a plain border-color change keeps
 * "keyboard is here" and "this is the selected evidence" visually
 * distinct even though both reuse the same focus token family. */
.library-rag-result-card {
    width: 100%;
    height: auto;
    border: solid $ds-grid-line;
    border-bottom: solid $ds-grid-line;
}

.library-rag-result-card:focus {
    border: solid $ds-focus-accent;
    border-bottom: solid $ds-focus-accent;
}

/* task-7 PR-2 leftover: this title Static used to draw its own
 * `border: solid $ds-grid-line` base border, immediately nested inside
 * `.library-rag-result-card`'s own `border: solid $ds-grid-line` a few
 * cells out -- two thin boxes of the identical color/style, one drawn
 * right inside the other, reading as a rendering glitch rather than
 * intentional structure. The card is now the row's only box in the
 * unselected state. `.is-selected` below is untouched and still reads
 * as selected on its own: it fully overrides `border` with its own
 * `heavy $ds-focus-accent` value (plus the focus-bg/focus-fg/bold
 * treatment), so it never depended on this rule's now-removed border for
 * legibility -- it draws a heavy highlighted box around just the
 * selected row's title line, nested inside the card's thin border,
 * exactly as before. */
.library-rag-result-row {
    padding: 0 1;
    margin: 1 0 0 0;
    background: $ds-surface-panel;
}

.library-rag-result-row.is-selected {
    border: heavy $ds-focus-accent;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

.library-rag-result-badges {
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: bold;
}

/* task-2859 item 10: the snippet had no rule of its own at all, so it sat
 * flush against the card's left border -- unlike its siblings above/below
 * (`.library-rag-result-row`, `.library-rag-result-badges`), both of which
 * already carry `padding: 0 1`. Matches that same padding for visual
 * consistency down the card. */
.library-rag-result-snippet {
    padding: 0 1;
}

/* C1: content-first result rows -- Open (primary emphasis, reuses the live
 * `.console-action-primary` colors directly since that class is not
 * Console-screen-scoped) then Select evidence, as a Horizontal of
 * auto-width buttons. */
.library-rag-result-actions {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
}

.library-rag-result-open {
    width: auto;
    min-width: 10;
    margin: 0 1 0 0;
}

.library-rag-result-action {
    width: auto;
    min-width: 16;
    height: 1;
    min-height: 1;
    padding: 0 1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.library-rag-recovery-action {
    width: 28;
    min-width: 18;
    background: $ds-status-warning 30%;
    color: $ds-text-primary;
    text-style: bold;
}

/* task-14 / spec AC 47 (chunking-template parity): the recovery-action
 * class gained a second consumer -- the re-chunk control
 * (#library-rag-rechunk-legacy), which is DISABLED mid-run by the panel
 * -- and its state set is completed here so both buttons define
 * rest/hover/focus/disabled from $ds-* tokens. Hover deepens the warning
 * tint rather than letting the generic `Button:hover` swap in
 * `$surface-lighten-1` (which would erase the "this is a recovery
 * action" colour); (0,2,0) beats `Button:hover`'s (0,1,1) per property. */
.library-rag-recovery-action:hover {
    background: $ds-status-warning 45%;
}

/* Structural focus cue, the task-3302 side-rail recipe
 * (`Button.library-canvas-action:focus` above): typed selector so
 * (0,2,1) plus later-in-bundle position beats both `Button:focus`
 * (0,1,1) and `Button:hover:focus` (0,2,1, earlier module), keeping the
 * rails visible while hovered too. Rails land on the button's own edge
 * cells, so dimensions never change on focus/blur (the non-obscuring
 * focus contract). */
Button.library-rag-recovery-action:focus {
    outline-left: heavy $ds-focus-accent;
    outline-right: heavy $ds-focus-accent;
}

/* Legible Disabled (TASK-1801/DESIGN.md), the task-4023 RC-07 Library
 * recipe: three dimmers compound on a disabled Button (the theme's
 * `text-disabled: auto 38%`, Textual's own `bold dim` + `color:
 * auto 50%`, and _buttons.tcss's `Button:disabled { opacity: 50% }`).
 * The re-chunk run disables this button for its whole batch, so the
 * label must stay readable next to the live "Re-chunking…" summary
 * line. Neutralise every layer, state a colour, let the darkened
 * surface carry "inert" -- same selectors/specificity as the
 * `Button.library-canvas-action:disabled` escape. */
Button.library-rag-recovery-action:disabled,
Button.library-rag-recovery-action:disabled:hover {
    opacity: 100%;
    text-opacity: 100%;
    text-style: none;
    color: $ds-text-muted;
    background: $surface-darken-1;
}

.library-rag-console-action {
    width: 18;
    min-width: 16;
    background: $ds-action-focus 35%;
    color: $ds-text-primary;
    text-style: bold;
}

.library-rag-center-console-action {
    width: 24;
    min-width: 18;
    margin: 1 0 0 0;
}

.library-rag-console-action:disabled {
    background: $ds-surface-raised;
    color: $ds-text-disabled;
    text-style: none;
}

#library-rag-mode-toggle {
    width: auto;
    min-width: 20;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

#library-rag-mode-toggle:hover {
    background: $ds-action-focus 20%;
}

#library-rag-searching-line {
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: italic;
}

#library-rag-history {
    margin: 1 0 0 0;
}

.library-rag-history-row {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.library-rag-history-row:hover {
    background: $ds-action-focus 20%;
}

.library-rag-history-empty {
    color: $ds-text-muted;
    padding: 0 1;
}

.library-rag-history-hint {
    color: $ds-text-muted;
    padding: 0 1;
    margin: 0 0 1 0;
}

.library-rag-history-clear {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 1 0 0 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.library-rag-history-clear:hover {
    background: $ds-action-focus 20%;
}

.is-disabled {
    opacity: 0.55;
}

.is-blocked {
    border: round $ds-status-error;
    background: $ds-status-error 10%;
}

.is-running {
    border: round $ds-status-running;
}

.is-paused {
    border: round $ds-status-paused;
}

.is-unsaved {
    border: round $ds-status-unsaved;
}

.is-stale {
    color: $ds-text-muted;
}

.is-conflict {
    border: thick $ds-status-error;
}

.needs-approval {
    border: thick $ds-status-approval-required;
    background: $ds-status-approval-required 12%;
}

.source-local {
    border: round $ds-authority-local;
}

.source-server {
    border: round $ds-authority-server;
}

.source-workspace {
    border: round $ds-authority-workspace;
}

.source-remote-only {
    border: round $ds-authority-remote-only;
}

.source-dry-run {
    border: dashed $ds-grid-line;
    color: $ds-text-muted;
}

/* --- MCP Hub (Phase 1 workbench) ------------------------------------- */

#mcp-mode-strip Button.mcp-mode-chip {
    width: auto;
    min-width: 10;
    height: 1;
    padding: 0 1;
    border: none;
}

#mcp-mode-strip .mcp-mode-chip.is-active {
    text-style: bold underline;
}

/* A1: focus must not impersonate .is-active above (bold underline). Kept in
   lockstep with the lower-specificity baseline copy in MCPScreen.DEFAULT_CSS
   (mcp_screen.py) -- see that copy's comment for why it uses raw
   $surface/$text/$text-muted tokens instead of these $ds- aliases. */
#mcp-mode-strip .mcp-mode-chip:focus,
#mcp-mode-strip .mcp-mode-chip:hover:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
    outline: none;
}

#mcp-mode-strip .mcp-mode-chip.is-active:focus,
#mcp-mode-strip .mcp-mode-chip.is-active:hover:focus {
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: bold underline;
    outline: none;
}

/* --- Lab mode strip (Models | Speech | Evals) ---------------------------
   Mirrors the MCP chip rules above: the generic `.is-active { border: round
   $ds-action-focus }` rule (line ~3869) otherwise draws a border around the
   1-row chip, clipping its label out of the 1-high strip entirely. */
#lab-mode-strip Button.lab-mode-chip {
    width: auto;
    min-width: 0;
    height: 1;
    padding: 0 1;
    border: none;
}

#lab-mode-strip .lab-mode-chip.is-active {
    border: none;
    text-style: bold underline;
}

#lab-mode-strip .lab-mode-chip:focus,
#lab-mode-strip .lab-mode-chip:hover:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
    outline: none;
}

#lab-mode-strip .lab-mode-chip.is-active:focus,
#lab-mode-strip .lab-mode-chip.is-active:hover:focus {
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: bold underline;
    outline: none;
}

#mcp-hub-rail {
    width: 3fr;
    min-width: 24;
}

#mcp-hub-rail .mcp-rail-heading {
    height: 1;
    min-height: 1;
    margin-top: 1;
}

/* Override border away from the generic `.is-active` rule (`border: round
   $ds-action-focus`, earlier in this sheet). Button.mcp-rail-row rows are
   fixed at height 1 (see MCPRail.DEFAULT_CSS); a round border needs at
   least 2 lines to render, so on a height-1 button it consumes the row's
   only line and the content area collapses to height 0 -- the label never
   renders, leaving a blank bordered box for the selected row. Mirrors the
   sibling `.mcp-mode-chip.is-active` rule below (and MCPScreen.DEFAULT_CSS's
   copy of it), which already carries this same `border: none` override. */
#mcp-hub-rail Button.mcp-rail-row.is-active {
    border: none;
    text-style: bold;
}

#mcp-hub-canvas {
    width: 5fr;
    min-width: 38;
}

#mcp-hub-inspector {
    width: 3fr;
    min-width: 28;
    height: 100%;
    min-height: 0;
}

/* F-057: below ~120 cols (`.mcp-compact` on #mcp-hub-grid, toggled by
   MCPWorkbench.on_resize) the triad rebalances toward the canvas so the
   servers table keeps its primary columns in-viewport; the rail/inspector
   take narrower shares + min-widths (their content wraps/truncates
   honestly -- see `#mcp-inspector-state` above and MCPRail's width-aware
   row truncation budget). More specific AND later than the pane rules
   above, so it wins both contests. Kept in lockstep with the bare-harness
   copy in MCPWorkbench.DEFAULT_CSS. */
#mcp-hub-grid.mcp-compact #mcp-hub-rail {
    width: 2fr;
    min-width: 16;
}

#mcp-hub-grid.mcp-compact #mcp-hub-canvas {
    width: 7fr;
    min-width: 30;
}

#mcp-hub-grid.mcp-compact #mcp-hub-inspector {
    width: 2fr;
    min-width: 20;
}

/* A5: the row wrapping the aggregate summary's colored glyph + neutral
   sentence (kept in lockstep with the width rules in
   MCPServersMode.DEFAULT_CSS, mcp_servers_mode.py -- required in EVERY
   harness, not just the bundled one: without an explicit width split, both
   Static children of the Horizontal default to 1fr/full-width and the
   second one renders entirely off-screen).
   F-057: `height: auto` (was 1) so the wrapped summary sentence's second
   line actually gets rows to render on at ~100-col widths -- the child
   `#mcp-overview-summary` override above can only wrap into space the row
   itself provides. `#mcp-detail-title` stays at exactly 1 (single-line
   badge + label). */
#mcp-overview-summary-row {
    height: auto;
    min-height: 1;
}

#mcp-detail-title {
    height: 1;
    min-height: 1;
}

#mcp-overview-callouts .ds-recovery-callout {
    margin-top: 1;
}

/* A2: disabled inspector action buttons must stay legible. The generic
   `Button:disabled` rule above (from _buttons.tcss, same "user CSS" tier as
   this file -- see MCPInspector.DEFAULT_CSS's matching rule and comment for
   why a widget-level DEFAULT_CSS override alone can never win this fight)
   stacks `opacity: 50%` on `$text-disabled` on a dark surface, which reads
   as functionally invisible on top of `.console-action-secondary`. Restore
   full opacity and use a dim-but-still-readable color instead. */
#mcp-hub-inspector Button.mcp-inspector-action:disabled {
    opacity: 100%;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: none;
}

#mcp-hub-inspector Button.mcp-inspector-action:disabled:hover {
    opacity: 100%;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: none;
}

/* A3: same Button center-default lesson as Button.mcp-rail-row
   (MCPRail.DEFAULT_CSS) and Button.mcp-callout below -- left-align the
   inspector's action stack. Kept in lockstep with the baseline copy in
   MCPInspector.DEFAULT_CSS (mcp_inspector.py). */
Button.mcp-inspector-action {
    text-align: left;
    content-align: left middle;
}

/* --- MCP Hub Phase 2 ------------------------------------------------- */
.mcp-status-ready { color: $ds-status-ready; }
.mcp-status-warning { color: $ds-status-warning; }
.mcp-status-error { color: $ds-status-error; }
.mcp-status-info { color: $ds-status-info; }
/* task-2239: the off/opt-in display state (the disabled built-in server) --
quiet, not alarming; same muted tier as the legend/hint lines. */
.mcp-status-muted { color: $ds-text-muted; }

.ds-info-callout {
    border: round $ds-status-info;
    background: $ds-status-info 10%;
    padding: 0 1;
    height: auto;
}

Button.mcp-callout {
    width: 100%;
    height: 1;
    min-height: 1;
    padding: 0 1;
    border: none;
    /* Button defaults BOTH text-align AND content-align to center (see
       Textual's own Button.DEFAULT_CSS, and the same lesson documented on
       Button.mcp-rail-row in MCPRail.DEFAULT_CSS) -- text-align alone does
       not left-align a one-line Button label; without content-align the
       whole callout line still rendered centered under the table. */
    text-align: left;
    content-align: left middle;
}

#mcp-servers-form {
    height: auto;
    min-height: 0;
}

/* Kept in lockstep with the baseline copy in MCPServersMode.DEFAULT_CSS
   (mcp_servers_mode.py) -- T7 (P3 UX batch) gave the overview table
   `height: auto; max-height: 70%;` so it hugs its own row count instead of
   a `1fr` table ballooning to fill the pane and stranding
   #mcp-overview-callouts dozens of rows below its last row (same bug class
   as #mcp-detail-builtin-toggles below). Without this bundle-layer copy,
   app-loaded CSS cascading on top of DEFAULT_CSS could silently
   reintroduce that regression. */
#mcp-servers-table {
    height: auto;
    max-height: 70%;
}

/* Kept in lockstep with the baseline copy in MCPToolsMode.DEFAULT_CSS
   (mcp_tools_mode.py) -- same fix, same rationale, as #mcp-servers-table
   immediately above. */
#mcp-tools-table {
    height: auto;
    max-height: 70%;
}

/* T9 (P4): kept in lockstep with the baseline copy in
   MCPPermissionsMode.DEFAULT_CSS (mcp_permissions_mode.py) -- same fix,
   same rationale, as #mcp-servers-table/#mcp-tools-table above: the matrix
   hugs its own row count instead of ballooning to fill the canvas, leaving
   room for the policy-preview strip below it. */
#mcp-perm-table {
    height: auto;
    max-height: 70%;
}

/* T9 (P4): kept in lockstep with the baseline copy in
   MCPPermissionsMode.DEFAULT_CSS -- the policy-preview strip below the
   matrix is a single Static (a sentence or two at most); without this,
   Vertical's own default sizing could let it compete with the matrix table
   above for the canvas's remaining space instead of hugging its own
   content, same bug class as #mcp-detail-builtin-toggles/#mcp-import-list
   below. */
#mcp-perm-preview {
    height: auto;
    min-height: 0;
}

/* Defect 1 fix (QA round mcp-hub-phase3-2026-07): kept in lockstep with the
   baseline copy in MCPToolsMode.DEFAULT_CSS (mcp_tools_mode.py), but here
   it's load-bearing, not just defensive. Textual's cascade always treats
   every CSS_PATH-sourced rule (this bundle) as higher priority than any
   widget's own DEFAULT_CSS, regardless of selector specificity -- so
   _conversations.tcss's global, unscoped `Select { width: 100%; }` rule
   (intended for a completely different screen's sidebar forms) was
   silently winning over MCPToolsMode's own, far more specific override,
   collapsing the filter-server Select to a 0x0 region against its
   `width: auto` slot parent (the sibling filter Input already claims the
   full bar at `width: 1fr`). This copy must live in the bundle itself,
   with equal-or-higher specificity than that bare rule, to actually win. */
#mcp-tools-filter-server-slot Select {
    width: 28;
}

/* TASK-14807: the bundle carries an app-wide Checkbox width/height rule
   for legacy conversation forms. Widget DEFAULT_CSS cannot outrank a
   CSS_PATH rule, so keep this Tools-mode escape in the source bundle: a
   compact, readable toggle with one content row instead of a full-width
   border-only box. The adjacent Enabled/Disabled word remains the primary
   state label. */
MCPToolsMode #mcp-tools-local-enabled {
    width: 8;
    height: auto;
    min-height: 1;
}

/* Kept in lockstep with the baseline copy in MCPServersMode.DEFAULT_CSS
   (mcp_servers_mode.py) -- without an explicit height override here too,
   Textual's Vertical default (height: 1fr) expands this container to fill
   the rest of #mcp-detail-scroll, pushing its sibling "Copy client config"
   Button roughly 800px below the built-in enable/expose checkboxes it
   should sit directly under. QA defect 1, mcp-hub-phase2-2026-07 round. */
#mcp-detail-builtin-toggles {
    height: auto;
    min-height: 0;
}

/* task-3240 fix round 1 (Minor 2): kept in lockstep with the baseline copy
   in MCPServersMode.DEFAULT_CSS (mcp_servers_mode.py) -- same bug class
   and same fix as #mcp-detail-builtin-toggles immediately above: without
   an explicit height override here too, Textual's Vertical default
   (height: 1fr) would expand this new sibling container (the "Tool
   gates" checkbox group) to fill the rest of #mcp-detail-scroll, pushing
   the "Copy client config" Button far below it. The widget-test harness
   (Tests/UI/test_mcp_servers_mode.py) never loads this bundle, so a
   regression here would be invisible to those tests -- only a bundled-CSS
   harness or the live app would catch it. */
#mcp-detail-tool-gates {
    height: auto;
    min-height: 0;
}

#mcp-detail-toolbar Button {
    height: 1;
    min-height: 1;
    border: none;
}

/* A1: kept in lockstep with the baseline copy in MCPImportPanel.DEFAULT_CSS
   (mcp_profile_form.py) -- without an explicit height override here too,
   Textual's Vertical default (height: 1fr) expands this container to
   consume whatever vertical space the panel has left, stranding the
   sibling "Import N servers"/Cancel action row far below the preview list
   on a real terminal window (same bug class as #mcp-detail-builtin-toggles,
   QA defect 1, mcp-hub-phase2-2026-07 round). */
#mcp-import-list {
    height: auto;
    min-height: 0;
}

/* T7 (P3 UX batch): quiet focus treatment for the hub's scrollable content
   panes. Both are VerticalScroll (can_focus=True by default, via
   ScrollableContainer) and, without a rule here, fall back to the generic
   `*:focus { outline: solid $ds-focus-accent; }` fallback (core/_reset.tcss)
   -- a heavy boxed cue for panes that just scroll read-only detail text /
   the legacy Advanced form. Mirrors the idiom already established for
   Console content panes elsewhere in this file (#console-left-rail-body:
   focus, #console-workspace-context:focus, #console-workspace-
   conversations:focus): drop the outline/border and shift the background
   instead, so keyboard focus stays visible without boxing the pane. Uses
   $ds-surface-panel (this codebase's quiet-surface token) rather than
   Textual's built-in $boost, which nothing else in this design system
   references. */
#mcp-detail-scroll:focus,
#mcp-adv-scroll:focus {
    outline: none;
    border: none;
    background: $ds-surface-panel;
}

/* task-2272 item 1 (PR-T3 Task 6): the Test Tool's typed form rendered every
   boolean field as an empty ~2-row box -- no toggle glyph, no label, state
   impossible to read (`search_rag`'s `use_semantic`, found in the PR-5 live
   check).

   Cause, measured in a test app with this bundle loaded: `css/features/
   _conversations.tcss` ships an unscoped `Checkbox { width: 100%; height:
   2; }` type selector that reaches every checkbox app-wide (the SAME rule
   `.settings-imagegen-backend-row Checkbox`, `LibraryIngestCanvas .type-
   group-contents Checkbox` and `#evals-bench-capture-continuations` each
   already carry their own escape from). Checkbox's own border takes both of
   those rows, leaving the widget's CONTENT height at literally 0 -- so the
   glyph and label had nowhere to paint and the box was all the user saw.
   `height: auto` gives the border its two rows AND the content its one back.

   The glyph paints "X" in BOTH states, distinguished by colour alone
   (task-1624's finding for `ImageGenSettingsPanel`) -- reuse that fix's
   idiom so OFF hides the glyph against the panel and ON shows it: with no
   On/Off word beside it here, the glyph IS the state carrier, and a boolean
   the user cannot read is a lie about what was sent to the tool. */
MCPSchemaForm Checkbox {
    width: auto;
    height: auto;
    min-height: 1;
}
MCPSchemaForm Checkbox > .toggle--button {
    color: $ds-surface-panel;
}
MCPSchemaForm Checkbox.-on > .toggle--button {
    color: $success;
}

/* --- MCP Hub Phase 5 (T9: Audit mode + Console batch approvals) ------ */

/* Kept in lockstep with the baseline copy in MCPAuditMode.DEFAULT_CSS
   (mcp_audit_mode.py) -- same fix, same rationale, as #mcp-servers-table/
   #mcp-tools-table/#mcp-perm-table above: the execution-log table hugs its
   own row count instead of ballooning to fill the canvas. */
#mcp-audit-table {
    height: auto;
    max-height: 70%;
}

/* Kept in lockstep with the baseline copy in MCPAuditMode.DEFAULT_CSS --
   same fix, same rationale, for the T8 Findings sub-view table. */
#mcp-audit-findings-table {
    height: auto;
    max-height: 70%;
}

/* Kept in lockstep with the baseline copy in MCPAuditMode.DEFAULT_CSS.
   The T8 Executions/Findings sub-view toggle strip is a Horizontal, which
   defaults to `height: 1fr` -- without this override it would expand to
   compete with the table below it for the canvas's remaining space
   instead of hugging its own two-button content, same bug class as
   #mcp-perm-preview/#mcp-detail-builtin-toggles/#mcp-import-list above. */
#mcp-audit-subview-strip {
    height: auto;
    min-height: 0;
}

/* Same Defect-1 Select-width lesson as #mcp-tools-filter-server-slot
   Select above (QA round mcp-hub-phase3-2026-07): `_conversations.tcss`'s
   bare `Select { width: 100%; }` rule always beats DEFAULT_CSS regardless
   of source order, so an id-scoped bundle rule is required for it to
   actually win. MCPAuditMode.DEFAULT_CSS already avoids the 0x0 collapse a
   different way for these two Selects (each lives in its own definite-
   width slot Vertical, not a bare auto-sized one -- see that file's own
   comment) -- these two rules are additional, defensive, EXPLICIT-width
   pins directly on the Selects' own ids (mirroring their slots' widths,
   24/20), kept in lockstep with the matching pair T9 added to
   MCPAuditMode.DEFAULT_CSS itself, so the Selects stay correctly sized
   even if the slot wrapper's own CSS were ever removed or the Select were
   ever mounted outside it. */
#mcp-audit-filter-decision {
    width: 24;
}
#mcp-audit-filter-initiator {
    width: 20;
}

/* The Console MCP batch-approval card's per-row layout
   (`ChatApprovalCard.set_batch()`, chat_approval_card.py -- T5 deferred
   this CSS to T9's phase gate). This card carries no `DEFAULT_CSS` of its
   own at all (unlike the MCP mode widgets above) -- these rules are the
   ONLY styling `.approval-row*` has anywhere, bundle or otherwise.

   `.approval-row` is a Horizontal, which defaults to `height: 1fr` --
   live-repro'd ballooning to the full card height (and its decision
   Select claiming the full ROW width in turn) before this fix, the same
   fr-inside-flex bug class as the MCP lockstep rules above. `height:
   auto` makes each row hug its own single line of content instead.

   `#approval-batch-rows` (the Vertical wrapping all rows) gets the same
   `height: auto` treatment as #mcp-perm-preview/#mcp-detail-builtin-
   toggles/#mcp-import-list above -- without it, its own `height: 1fr`
   default would balloon it to fill the card and push the sibling
   Approve-all/Submit/Deny-all action bar (#approval-batch-actions) far
   below the visible rows.

   `.approval-row-header`/`.approval-row-args` (Statics, natively `width:
   auto`) get an explicit `1fr` share each so unbounded text (a long
   tool/server header, or an args summary up to 80 chars) can't hog the
   row and squeeze the decision Select out of view. `.approval-row-
   decision` (the class selector on the row's Select) gets an explicit
   fixed width -- a CLASS selector already outranks the bare `Select {
   width: 100%; }` type selector on specificity alone, so (unlike the two
   MCP Select fixes above) no id-scoped selector is needed here for it to
   win; without this rule the Select would otherwise claim the row's FULL
   width instead of its own bounded share, overlapping/clipping behind the
   header and args text laid out before it. */
#approval-batch-rows {
    height: auto;
    min-height: 0;
    /* TASK-1846: bound the rows so the action bar below them is reachable
       at ANY row count. The card is `height: auto` inside a plain Container
       (`ChatTaskCards`), so before this a long batch simply grew past the
       viewport and took Submit/Approve-all/Deny-all with it -- measured on
       an 80x24 terminal, five rows already pushed Submit to y=24. Splitting
       arguments onto their own line costs a line per row and would have
       moved that cliff from five rows to four, so the cap fixes the older
       bug rather than inheriting it. 15 leaves room for the header, the
       deadline and the action bar at 24 rows; taller batches scroll. */
    max-height: 15;
    overflow-y: auto;
}
.approval-row {
    height: auto;
    min-height: 1;
    width: 1fr;
}
/* TASK-1846 AC#2: `.approval-row` is now a Vertical of two lines --
   header, arguments, and `.approval-row-controls` each on their own FULL
   width line. Before the split all four shared one Horizontal, and the
   controls' 26 + 14 + 14 = 54 fixed cells left the arguments 10 cells at 80
   columns: `{"path":"~/` of `{"path":"~/notes/secrets.md"}`. Since
   TASK-1861 the card offers one decision per TARGET, so that clipped text
   was the decision.

   Keeping the header BESIDE the controls was tried and is wrong: in the
   Console's ~52-cell chat pane those 54 fixed cells starve the header to
   one cell, which wraps to nine lines and pushes the arguments out of the
   card -- caught only by looking at a real terminal.

   The controls row is a Horizontal and needs the SAME `height: auto` as
   `.approval-row` above -- a Horizontal defaults to `height: 1fr`, the
   fr-inside-flex bug this block already documents, and left at the default
   it balloons to the card height and takes the args line off screen. */
.approval-row-controls {
    height: auto;
    min-height: 1;
    width: 1fr;
}
.approval-row-header {
    width: 1fr;
}
.approval-row-args {
    width: 1fr;
}
.approval-row-decision {
    width: 26;
}
/* Fleet-UX expert review F5 (task-1234): single-row cards additionally
   mount two compact fast-path buttons after the decision Select --
   "Approve once"/"Deny" submit immediately, bypassing Select+Submit for
   the two most common decisions (`ChatApprovalCard.set_batch`'s
   `single_row` gate; never rendered for a multi-row batch). `compact`
   already keeps these borderless/1-row tall; fixed widths keep them from
   claiming `Button`'s `width: auto` share and squeezing the row. */
.approval-row-fast-approve,
.approval-row-fast-deny {
    width: 14;
    min-width: 14;
}
/* task-5 (Phase-5 follow-up): a bulk "Approve all"/"Deny all" press can't
   legally reach every narrowed row (`ChatApprovalCard._set_all_batch_
   decisions` -- a row whose `options` exclude every bulk candidate is left
   on its current value instead of crashing). Left unstyled, that row looks
   identical to one nobody has decided on yet. `.needs-decision` (added by
   that same skip path, cleared by the row's own `Select.Changed`) gives it
   the same warning treatment as `.library-rag-callout.is-blocked` above:
   border + a light background tint, using the semantic
   `$ds-status-approval-required` token rather than the generic `$ds-
   status-warning` one, since this state literally IS "still needs an
   approval decision." */
.approval-row.needs-decision {
    border: solid $ds-status-approval-required;
    background: $ds-status-approval-required 10%;
}

/* ConsoleScopePickerModal (rag-scope-narrowing spec §4, Task 8): RAG
   retrieval scope picker -- type tabs, text+tag filters, sort select,
   paginated checkbox list, All/Selected view toggle, bulk select-all/clear
   confirmation, and footer count/Save/Clear/Cancel. Mirrors
   ConsolePromptPickerModal's modal shell (round border, $ds-surface-panel,
   1 2 padding) sized wider/taller for the extra filter/list chrome. */
ConsoleScopePickerModal {
    align: center middle;
}

#console-scope-picker-modal {
    width: 90;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: 1 2;
}

.console-scope-picker-tabs {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.console-scope-picker-tab {
    margin: 0 1 0 0;
}

.console-scope-picker-tab-active {
    background: $ds-action-focus;
    text-style: bold;
}

#console-scope-picker-text-filter {
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-scope-picker-text-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

.console-scope-picker-tag-row {
    height: auto;
    margin: 0 0 1 0;
}

.console-scope-picker-chip-row {
    height: auto;
    min-height: 1;
}

#console-scope-picker-tag-search {
    height: 3;
    min-height: 3;
    margin: 0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-scope-picker-tag-search:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

.console-scope-picker-tag-chip {
    margin: 0 1 0 0;
}

.console-scope-picker-tag-chip-active {
    background: $ds-action-focus;
    text-style: bold;
}

.console-scope-picker-sort-row {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.console-scope-picker-sort-label {
    width: 6;
    min-width: 6;
    content-align: left middle;
}

.console-scope-picker-view-row {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.console-scope-picker-view-btn {
    margin: 0 1 0 0;
}

.console-scope-picker-view-active {
    background: $ds-action-focus;
    text-style: bold;
}

#console-scope-picker-list {
    height: 1fr;
    min-height: 8;
    max-height: 20;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
}

.console-scope-picker-row {
    width: 100%;
    height: auto;
    min-height: 1;
    color: $ds-text-primary;
}

.console-scope-picker-row-greyed {
    color: $ds-text-muted;
}

#console-scope-picker-empty {
    height: auto;
    margin: 1 0;
    color: $ds-text-muted;
}

.console-scope-picker-page-row {
    height: auto;
    min-height: 1;
    margin: 1 0;
    align-horizontal: center;
}

#console-scope-picker-page-label {
    width: auto;
    min-width: 12;
    content-align: center middle;
    margin: 0 1;
}

.console-scope-picker-bulk-row {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

#console-scope-picker-confirm-text {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $ds-status-warning 10%;
    color: $ds-text-primary;
}

.console-scope-picker-confirm-actions {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.console-scope-picker-footer {
    height: auto;
    min-height: 1;
    margin: 1 0 0 0;
    align-horizontal: right;
}

#console-scope-picker-count {
    width: 1fr;
    min-width: 0;
    content-align: left middle;
    color: $ds-text-muted;
}

/* TASK-1775: one Console Prompt Workbench shell, opened only from the
   composer's existing overflow menu. It extends the Chat Context modal's
   dense terminal grammar: a flat header, bounded work region, and stable
   footer. Source, artifact kind, unavailable state, and recovery remain
   text labels; accent color is reserved for focus and the primary Improve
   action. */
ConsolePromptsModal {
    align: center middle;
}

#console-prompts-modal {
    width: 90%;
    max-width: 104;
    height: 90%;
    max-height: 44;
    min-width: 40;
    min-height: 18;
    border: tall $ds-grid-line;
    background: $ds-surface-panel;
    padding: 1 2;
}

#console-prompts-header {
    width: 100%;
    height: auto;
    min-height: 2;
    border-bottom: solid $ds-grid-line;
    margin: 0 0 1 0;
}

#console-prompts-title {
    height: 1;
    color: $ds-text-primary;
    text-style: bold;
}

#console-prompts-location,
#console-prompts-model-status,
#console-prompts-browse-status {
    width: 100%;
    height: auto;
    min-height: 1;
    color: $ds-text-muted;
}

#console-prompts-body,
#console-prompts-browse {
    width: 100%;
    height: 1fr;
    min-height: 0;
}

/* The editor follows a host status row inside a bounded Vertical. Use the
   remaining fraction instead of its standalone 100% height so its actions
   stay above the modal footer. */
#console-prompts-editor {
    height: 1fr;
    min-height: 0;
}

/* The legacy app-wide Checkbox rule fixes every checkbox at width: 100% and
   height: 2, leaving no content row inside Textual's tall border. Keep the
   shared Prompt editor's lane choices intrinsic and paintable. */
PromptBlockEditor #prompt-editor-lane-options Checkbox {
    width: auto;
    height: 3;
    margin-bottom: 0;
}

.console-prompts-primary-action {
    width: 100%;
    height: 3;
    min-height: 3;
    border: none;
    background: $ds-action-focus;
    color: $ds-text-primary;
    text-style: bold;
}

.console-prompts-primary-action:focus,
#console-prompts-modal Button:focus {
    outline: heavy $ds-action-focus;
}

.console-prompts-primary-action:disabled,
#console-prompts-modal Button:disabled {
    background: $surface-darken-1;
    color: $ds-text-disabled;
}

#console-prompts-browse-controls {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 1 0 0 0;
}

#console-prompts-source {
    width: 18;
    min-width: 14;
    height: 3;
    border: none;
    border-left: solid $ds-grid-line;
    background: $surface-darken-1;
}

#console-prompts-search {
    width: 1fr;
    min-width: 12;
    height: 3;
    border: none;
    border-left: solid $ds-grid-line;
    background: $surface-darken-1;
}

#console-prompts-source:focus,
#console-prompts-search:focus {
    border-left: thick $ds-action-focus;
    background: $ds-focus-bg;
    text-style: bold;
}

#console-prompts-retry {
    width: auto;
    min-width: 8;
    height: 3;
    border: none;
    background: $ds-surface-raised;
}

#console-prompts-results {
    width: 100%;
    height: 1fr;
    min-height: 4;
    margin: 1 0 0 0;
    border-top: solid $ds-grid-line;
    border-bottom: solid $ds-grid-line;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

#console-prompts-result-list {
    width: 100%;
    height: auto;
}

.console-prompts-result {
    width: 100%;
    height: auto;
    min-height: 3;
    border: none;
    border-bottom: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-align: left;
    content-align: left middle;
}

.console-prompts-result:hover,
.console-prompts-result:focus {
    background: $ds-focus-bg;
}

#console-prompts-pagination,
#console-prompts-footer {
    width: 100%;
    height: 3;
    min-height: 3;
    align: right middle;
}

#console-prompts-page {
    width: 1fr;
    min-width: 12;
    height: 3;
    content-align: center middle;
    color: $ds-text-muted;
}

#console-prompts-pagination Button,
#console-prompts-footer Button,
#console-prompts-improve-mode Button,
#console-prompts-convert {
    width: auto;
    min-width: 8;
    height: 3;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-prompts-footer {
    border-top: solid $ds-grid-line;
}

#console-prompts-dirty-guard {
    display: none;
    width: 100%;
    height: auto;
    padding: 1;
    border: round $ds-status-warning;
    background: $ds-status-warning 10%;
    color: $ds-text-primary;
}

#console-prompts-dirty-guard.visible {
    display: block;
}

#console-prompts-compatibility {
    width: 100%;
    height: auto;
    min-height: 2;
    color: $ds-status-warning;
}

#console-prompts-compat-system,
#console-prompts-compat-user {
    width: 100%;
    height: 1fr;
    min-height: 3;
    border: round $ds-grid-line;
    background: $surface-darken-1;
}

#console-prompts-improve-mode,
#console-prompts-recipe-mode {
    width: 100%;
    height: 1fr;
    min-height: 0;
}

#console-prompts-improve-mode Button,
#console-prompts-recipe-mode Button {
    width: 100%;
    margin: 1 0 0 0;
}

#console-prompts-recipe-outcome-description,
#console-prompts-recipe-saved-description,
#console-prompts-recipe-blank-description {
    width: 100%;
    height: auto;
    padding: 0 1;
    color: $ds-text-muted;
}

#console-prompts-recipe-save-confirmation-panel {
    display: none;
    width: 100%;
    height: auto;
    padding: 0 1 1 1;
    border: round $ds-status-ready;
    background: $ds-status-ready 8%;
}

#console-prompts-recipe-save-confirmation {
    width: 100%;
    height: auto;
    color: $ds-text-primary;
}

#console-prompts-open-saved-recipe {
    width: 100%;
    height: 3;
}

ConsolePromptsModal.-narrow #console-prompts-modal {
    width: 96%;
    height: 96%;
    padding: 0 1;
}

ConsolePromptsModal.-narrow #console-prompts-browse-controls {
    layout: vertical;
    height: 6;
    min-height: 6;
}

ConsolePromptsModal.-narrow #console-prompts-source,
ConsolePromptsModal.-narrow #console-prompts-search {
    width: 100%;
}

/* Internal Prompts settings page */
#internal-prompts-search { width: 1fr; margin: 0 0 1 0; }
#internal-prompts-list { height: 1fr; }
.internal-prompts-group-header { text-style: bold; padding: 1 0 0 0; color: $text-muted; }
.internal-prompt-row { width: 1fr; height: auto; text-align: left; content-align: left middle; }
.internal-prompt-row.row-customized { border-left: thick $accent; }
.internal-prompt-row.row-default-changed { border-left: thick $warning; }
#internal-prompt-editor-modal { width: 90%; max-width: 120; height: auto; max-height: 90%; padding: 1 2; background: $panel; border: thick $primary; }
.internal-prompt-editor-contract { color: $warning; padding: 1 0; }
.internal-prompt-editor-chips { color: $text-muted; }
.internal-prompt-editor-applies { color: $text-muted; text-style: italic; }
.internal-prompt-editor-preview { background: $boost; padding: 1; height: auto; max-height: 12; }
.internal-prompt-editor-error { color: $error; }
.internal-prompt-editor-actions { align-horizontal: right; height: auto; padding: 1 0 0 0; }


/* task-1624: the Checkbox glyph paints "X" in BOTH states, distinguishing
   them by color alone -- it read as checked either way in the critique.
   Hide the glyph while off so its presence carries the state; the On/Off
   word beside it (switch_word) stays the text carrier. */
/* task-1713 counterweight: the widened shared label column (24) does not
   fit the Image Gen backend rows' five controls at 120 cols -- the
   geometry guard test pins that width. Backend-row labels are short
   backend names; 12 never truncated them. */
.settings-imagegen-backend-row .settings-input-label {
    width: 12;
    min-width: 12;
}

ImageGenSettingsPanel Checkbox > .toggle--button {
    color: $ds-surface-panel;
}
ImageGenSettingsPanel Checkbox.-on > .toggle--button {
    color: $success;
}

/* TASK-1801: disabled composer-menu rows were unreadable -- measured 1.05:1
   and 1.25:1 in the running app, against enabled rows at 12.63:1.

   Two dimmers compound. The theme sets `text-disabled: auto 38%` (alpha over
   the panel, ~3.4:1 alone), and Textual's Button adds `text-style: bold dim`
   plus `color: auto 50%` on its disabled variant
   (`textual/widgets/_button.py`), halving intensity again. Across every
   shipped theme that puts ALL 58 below 3:1 -- including
   `high_contrast_yellow_black`.

   This MUST live in the app stylesheet, not the modal's DEFAULT_CSS: both
   Button's rules and a screen's DEFAULT_CSS sit in the same DEFAULT_CSS
   tier, where Button wins for a Button. App CSS outranks all of it. That is
   why the sibling `.console-action-disabled` rules below work and an
   identical rule inside the modal did not -- verified by measuring the
   running app both ways, not by reading specificity.

   The Console states every temporary-chat restriction on a disabled row, so
   an illegible disabled label voids that whole convention. Disabled stays
   plainly dimmer than enabled (12.63:1) so the state is still obvious. */
.console-composer-menu-item:disabled {
    text-style: none;
    text-opacity: 1;
    color: rgb(245,245,245);
}

/* task-2012: css/features/_conversations.tcss ships an UNSCOPED
   `Checkbox { width: 100%; height: 2; }` that clips the ingest option
   panel's checkbox content row to a border-only husk (same escape family
   as the per-ID escapes other screens carry against that rule). The
   container rule kills the panel's trailing phantom height; the label
   rule styles the value-field labels added beside it. */
LibraryIngestCanvas .type-group-contents {
    height: auto;
}
LibraryIngestCanvas .type-group-contents Checkbox {
    width: auto;
    height: auto;
}
LibraryIngestCanvas .type-group-field-label {
    color: $text-muted;
    margin-top: 1;
}

/* task-14824 (3): the canvas-level path field's persistent label -- same
   dense-form convention as the option-panel field labels above, without
   their in-panel top margin (the field follows the header block). */
LibraryIngestCanvas .library-ingest-field-label {
    width: 100%;
    height: 1;
    color: $text-muted;
}

/* task-14824 (3): Textual's stock `$text-disabled` placeholder measured
   3.52:1 enabled / 3.49:1 disabled on this canvas. Component-class
   selector because the placeholder is painted by `Input`'s own
   `input--placeholder` component style, which a `color` on the Input
   itself never reaches. Both states are covered: `:disabled` darkens the
   field's background, so the placeholder is re-measured against it. */
LibraryIngestCanvas Input > .input--placeholder,
LibraryIngestCanvas Input:disabled > .input--placeholder {
    color: $ds-text-placeholder;
}

/* task-2014: focus on this canvas was a background-color change only --
   invisible in monochrome and to low-vision users, and it hides the
   job-tick focus-theft (task-2010). DESIGN.md's focus contract is
   `outline: heavy $accent`; outlines draw over the widget's own edge
   cells, so dimensions stay stable. */
LibraryIngestCanvas Input:focus {
    outline: heavy $accent;
}
/* (task-2041) NOT an outline: `outline: heavy` on a 1-row compact button
   draws over the label row, so every focused action button rendered as a
   label-less box -- and the armed "Press again to clear N finished"
   confirm was invisible exactly when it must be read. Reverse video is
   monochrome-visible AND keeps the label. */
LibraryIngestCanvas Button:focus {
    text-style: bold reverse;
}
LibraryIngestCanvas Checkbox:focus {
    outline: heavy $accent;
}
/* task-14824 (1): this rule was DEAD on screen and had been since task-2014.
   `Select` composes an opaque `SelectCurrent` that fills its parent's ENTIRE
   region (its own `border: tall` + `padding: 0 2` make it exactly the
   parent's size), and the compositor paints a child over its parent -- so
   the parent's outline never reached a cell. The "set but painted over by a
   child" family, same as the `Select:disabled SelectCurrent` pair below.
   Note the rule still cannot be verified from `Select.render_lines()`: that
   renders the widget alone, WITHOUT the covering child, and shows the
   outline happily. The test reads the compositor.
   The colour half is kept (it is what a partially-covered Select shows);
   the STRUCTURAL cue moves to the child that is actually on screen. */
LibraryIngestCanvas Select:focus {
    outline: heavy $accent;
}
/* Heavy replaces SelectCurrent's own `tall` border, so the cue is a glyph
   swap (▊▔▎▁ -> ┏━┓┃┗━┛) at identical thickness: no row is consumed (the
   task-3302 trap where a full `outline: heavy` ate a 1-row compact
   control's only row) and the value stays readable inside it. */
LibraryIngestCanvas Select:focus > SelectCurrent {
    border: heavy $ds-input-focus-accent;
}

LibraryIngestCanvas CollapsibleTitle:focus {
    text-style: bold reverse;
}

/* task-2015: at narrow widths the options-panel summary title clipped
   mid-word with no ellipsis, hiding the chunking config entirely. The
   stock CollapsibleTitle is width:auto, so the PARENT clips it before its
   own text-overflow can engage -- constrain the width and pin one line so
   the ellipsis actually renders. */
/* Child combinator for specificity: css/features/_conversations.tcss ships
   an unscoped `Collapsible > CollapsibleTitle { height: 3; }` LATER in the
   bundle -- at equal specificity it won, re-adding two filler rows inside
   every panel title (task-2043). */
LibraryIngestCanvas Collapsible > CollapsibleTitle {
    width: 1fr;
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* task-2043: Textual's Collapsible defaults supply the panel filler rows
   (Collapsible padding-bottom: 1 + Contents padding: 1 0 0 3) -- a
   collapsed panel carried ~3 blank rows below its title and an expanded
   one trailed blank rows. Scoped removal; row separation comes from the
   panels' own stacking. */
LibraryIngestCanvas Collapsible {
    padding-bottom: 0;
}
LibraryIngestCanvas Collapsible Contents {
    padding: 0 0 0 3;
}

/* task-2100: the app-wide `Collapsible > CollapsibleTitle:focus` rule adds
   a border-bottom that, combined with this canvas's height:1 titles,
   consumed the ONLY row -- a focused panel title rendered as a blank line.
   Reverse video carries focus without costing the row.
   task-3312 (#4): reverse video alone is color-only -- byte-identical
   glyphs, the one focusable the task-3302 structural-focus sweep missed.
   Heavy SIDE rails add the glyph-level cue, same treatment as
   `.library-canvas-action:focus` above: the edge cells land on
   CollapsibleTitle's own `padding: 0 1`, so the ▶/▼ symbol and the title
   text survive, and outline never changes dimensions on focus/blur.
   Declared HERE (child combinator, (0,1,3)) rather than as a descendant
   selector: components/_widgets.tcss ships an app-wide `Collapsible >
   CollapsibleTitle:focus { outline: none; }` LATER in the bundle, which
   at equal (0,1,2) specificity silently discarded the rails (measured --
   `outline_left` stayed the ('', green) default). */
LibraryIngestCanvas Collapsible > CollapsibleTitle:focus {
    border-bottom: none;
    text-style: bold reverse;
    outline-left: heavy $ds-focus-accent;
    outline-right: heavy $ds-focus-accent;
}
/* The collapsed variant needs its own rule: the app-wide
   `Collapsible.-collapsed > CollapsibleTitle:focus` border re-appears at
   (0,2,2) specificity, which outranks the (0,1,3) rule above -- and every
   type-group panel STARTS collapsed. */
LibraryIngestCanvas Collapsible.-collapsed > CollapsibleTitle:focus {
    border-bottom: none;
}

/* task-2130: inline option-validation message -- a TEXT line (never
   color-only; the color is decoration on top of words). Display-managed
   by the screen's option-change handler. */
LibraryIngestCanvas .type-group-field-error {
    /* task-2230 (a11y): $error measured 3.06:1 on this canvas -- an AA
       fail, and LESS readable than ordinary help text at 7.21:1, which
       inverted the importance hierarchy. The readable token measures
       7.71:1 and still reads as an error colour. */
    color: $ds-status-error-readable;
    height: auto;
    padding: 0 0 0 2;
}

/* task-2230 (a11y): the invalid-field border rendered ONLY while focused
   (1.05:1 unfocused = invisible) while the gate line instructed the user
   to "Fix the highlighted options" -- pointing at a highlight that had
   already vanished. Mark the field whenever its value is invalid. */
LibraryIngestCanvas Input.-ingest-option-invalid {
    border: tall $ds-status-error-readable;
}

/* task-2230 (a11y): failed/skipped rows carried no colour distinction
   from done rows. Colour is ADDED to the existing glyph+word, never
   replacing them (the round-4 lesson: severity must survive monochrome). */
LibraryIngestCanvas .library-ingest-row-failed {
    color: $ds-status-error-readable;
}
LibraryIngestCanvas .library-ingest-row-skipped {
    color: $text-muted;
}

/* task-2130: the disabled Start-ingest label measured ~1.5:1 against its
   background (round-4 Sam persona) -- readable muted text instead, so a
   keyboard user can find the primary action to learn why it is gated. */
LibraryIngestCanvas Button:disabled {
    /* The TASK-1801 lesson applies verbatim: the visible colour is a STACK
       (_buttons.tcss `opacity: 50%` + `color: $text-disabled` + Textual's
       own disabled dim), so no colour-only override survives it. Neutralise
       the opacity layer and state the colour; the flat background is what
       still says "not ready". */
    opacity: 100%;
    text-opacity: 100%;
    color: $text-muted;  /* 115-gray: 3.15:1 measured live on the canvas bg */
    background: $surface-darken-1;
}

/* task-3304 (MI-07): schema-disabled option FIELDS (Parakeet model folder /
   transcription model under provider "default", web page/depth limits under
   "individual", chunk size/overlap with chunking off) rendered near-
   identically to enabled ones -- their only treatment was Textual's
   app-default `*:disabled:can-focus { opacity: 0.7 }` whole-widget fade,
   the same compounding-dimmer family the Legible Disabled rule
   (TASK-1801/DESIGN.md) exists for. Same recipe as the Button rule above:
   neutralise the fade, state a colour that stays >= 3:1 on its own
   background, and let the darkened surface carry "inert" -- the WHY is a
   text annotation on the field's label (the canvas derives it from the
   schema's gate metadata). App tier on purpose: widget DEFAULT_CSS cannot
   override Textual's own disabled styling (same-tier, widget wins). */
LibraryIngestCanvas Input:disabled,
LibraryIngestCanvas Select:disabled,
LibraryIngestCanvas Checkbox:disabled {
    opacity: 100%;
    text-opacity: 100%;
    color: $text-muted;
    background: $surface-darken-1;
}
/* SelectCurrent paints its own opaque $surface and colours the value via
   its inner `Static#label` -- without these two the Select override above
   never reaches the screen (the "set but painted over by a child" defect
   family from the Watchlists focus round). */
LibraryIngestCanvas Select:disabled SelectCurrent {
    background: $surface-darken-1;
    color: $text-muted;
}
LibraryIngestCanvas Select:disabled SelectCurrent Static#label {
    color: $text-muted;
}

/* task-3304 (MI-08): fold indicator, task-1623 convention. Docked chrome
   inside the VerticalScroll canvas -- a docked child never scrolls with
   the content -- shown by the canvas's own sync only while content
   overflows. Opaque background so the row reads as chrome, not as a
   content line. */
#library-ingest-fold-hint {
    dock: bottom;
    width: 100%;
    height: 1;
    color: $text-muted;
    background: $ds-surface-raised;
    padding: 0 1;
}

/* task-2130: completion toasts overdrew both canvas bottom-border rows
   (round-4, exact rows pinned by the evidence agent). Same lever as
   task-1562's inspector clearance: the rack's built-in align resists
   app-tier margins, but a margin on the Toast itself reliably offsets it
   from the bottom-right anchor. App-wide by necessity (screen-level
   mount); two rows clears both frame borders. */
Toast {
    margin-bottom: 2;
}

/* Slash-command completion popup: floats above the composer. Position,
 * offset, width, and height are set imperatively in
 * ConsoleCommandPopup.show_suggestions/reposition. */
#console-command-popup {
    position: absolute;
    display: none;
    background: $ds-surface-panel;
    padding: 0 1;
}

/* Textual's default OptionList chrome (tall border + padding) costs two
 * rows and pushed every option row out of small popups (a 1-row popup had a
 * 0-row content region and painted an empty band). The popup itself carries
 * the background, so strip the inner chrome. */
#console-command-popup OptionList {
    border: none;
    padding: 0;
}

/* task-2160: clicking dead text focuses the scroll container itself, and
   its inherited focus decoration painted fragmented blue dashes down the
   pane edges (round-5's "stray blue tick-marks", root-caused in round 6).
   The container keeps keyboard scrollability; its focus stops painting. */
LibraryIngestCanvas:focus {
    border: none;
    outline: none;
}
LibraryIngestCanvas:focus-within {
    border: none;
    outline: none;
}

/* task-2223: Recent ingests two-line entries -- the muted full-path line
   under each basename row. */
LibraryIngestCanvas .library-ingest-recent-path {
    color: $text-muted;
    height: auto;
    padding: 0 0 0 2;
}

/* task-2221: per-submission batch group headers + the latest-batch tally
   line that leads the queue section. */
LibraryIngestCanvas .library-ingest-batch-header {
    height: auto;
    text-style: bold;
    margin: 1 0 0 0;
}
LibraryIngestCanvas #library-ingest-latest-batch {
    height: auto;
    text-style: bold;
}

/* Presentation-only row wrappers keep the established wide stacked
   workbench. Compact rules below switch only these wrappers to rows. */
#library-notes-filter-row,
#library-notes-status-row,
#library-note-heading,
#library-note-title-row,
#library-note-context-keywords-row,
#library-notes-create-heading {
    layout: vertical;
    height: auto;
    min-height: 0;
}

#library-notes-create-viewport {
    height: 1fr;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
}

/* Database Notes compact geometry: at the measured compact breakpoint,
   the shell becomes a single 15-row workbench and every Notes state
   assigns surplus height to exactly one scroll owner. */
#library-shell-grid.library-notes-compact {
    padding: 0;
    margin: 0;
    border: none;
}

#library-shell-grid.library-notes-compact #library-canvas {
    padding: 0;
    margin: 0;
    border: none;
    overflow-x: hidden;
    overflow-y: hidden;
}

#library-shell-grid.library-notes-compact #library-notes-canvas,
#library-shell-grid.library-notes-compact #library-note-work-pane {
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 0;
    margin: 0;
    overflow-x: hidden;
    overflow-y: hidden;
}

#library-shell-grid.library-notes-compact #library-notes-authority,
#library-shell-grid.library-notes-compact #library-note-work-authority {
    height: 2;
    min-height: 2;
    max-height: 2;
    margin: 0;
    padding: 0 1;
    text-wrap: wrap;
    overflow: hidden hidden;
}

#library-shell-grid.library-notes-compact #library-notes-header {
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#library-shell-grid.library-notes-compact #library-notes-filter-row {
    layout: horizontal;
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
}

#library-shell-grid.library-notes-compact #library-notes-filter-label {
    width: 8;
    height: 1;
    padding: 0 1;
}

#library-shell-grid.library-notes-compact #library-notes-filter {
    width: 1fr;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
}

#library-shell-grid.library-notes-compact #library-notes-browse-actions,
#library-shell-grid.library-notes-compact #library-notes-sort-choices,
#library-shell-grid.library-notes-compact #library-notes-transfer-actions,
#library-shell-grid.library-notes-compact #library-notes-selection-actions,
#library-shell-grid.library-notes-compact #library-note-primary-actions,
#library-shell-grid.library-notes-compact #library-note-conflict-actions,
#library-shell-grid.library-notes-compact #library-note-delete-actions {
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    overflow-x: hidden;
}

#library-shell-grid.library-notes-compact .library-canvas-action {
    width: auto;
    min-width: 0;
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0 1 0 0;
    padding: 0 1;
    border: none;
}

#library-shell-grid.library-notes-compact #library-notes-status-row {
    layout: horizontal;
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    overflow-x: hidden;
}

#library-shell-grid.library-notes-compact #library-notes-status {
    width: 1fr;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#library-shell-grid.library-notes-compact #library-notes-filter-clear {
    width: auto;
}

#library-shell-grid.library-notes-compact #library-notes-selection-status {
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    padding: 0 1;
}

#library-shell-grid.library-notes-compact #library-notes-list {
    height: 1fr;
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    overflow-x: hidden;
}

#library-shell-grid.library-notes-compact #library-notes-empty {
    height: 1fr;
    min-height: 0;
    margin: 0;
    padding: 0 1;
    overflow-y: auto;
    overflow-x: hidden;
}

#library-shell-grid.library-notes-compact #library-note-heading {
    layout: horizontal;
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    overflow-x: hidden;
}

#library-shell-grid.library-notes-compact #library-note-editor-title,
#library-shell-grid.library-notes-compact #library-note-preview-title,
#library-shell-grid.library-notes-compact #library-note-context-title,
#library-shell-grid.library-notes-compact #library-note-loading-title,
#library-shell-grid.library-notes-compact #library-notes-create-header {
    width: 1fr;
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#library-shell-grid.library-notes-compact #library-note-editor-region {
    height: 1fr;
    min-height: 0;
    margin: 0;
    overflow-x: hidden;
    overflow-y: hidden;
}

#library-shell-grid.library-notes-compact #library-note-title-row {
    layout: horizontal;
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
}

#library-shell-grid.library-notes-compact #library-note-title-label,
#library-shell-grid.library-notes-compact #library-note-context-keywords-label {
    width: 10;
    height: 1;
    padding: 0 1;
}

#library-shell-grid.library-notes-compact #library-note-title,
#library-shell-grid.library-notes-compact #library-note-context-keywords {
    width: 1fr;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
}

#library-shell-grid.library-notes-compact #library-note-body-label {
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    padding: 0 1;
}

#library-shell-grid.library-notes-compact #library-note-body {
    height: 1fr;
    min-height: 0;
    max-height: 100%;
    margin: 0;
    overflow-x: hidden;
}

#library-shell-grid.library-notes-compact #library-note-preview-region {
    height: 1fr;
    min-height: 0;
    max-height: 100%;
    margin: 0;
    overflow-y: auto;
    overflow-x: hidden;
}

#library-shell-grid.library-notes-compact #library-note-preview-body {
    height: auto;
    min-height: 0;
    margin: 0;
    padding: 0 1;
    border: none;
    overflow-y: hidden;
    overflow-x: hidden;
}

#library-shell-grid.library-notes-compact #library-note-context-status {
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#library-shell-grid.library-notes-compact #library-note-context-region {
    height: 1fr;
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    overflow-x: hidden;
}

#library-shell-grid.library-notes-compact #library-note-context-region .destination-section,
#library-shell-grid.library-notes-compact #library-note-context-meta,
#library-shell-grid.library-notes-compact #library-note-context-region > .library-canvas-action {
    height: 1;
    min-height: 1;
    margin: 0;
}

#library-shell-grid.library-notes-compact #library-note-context-keywords-row {
    layout: horizontal;
    height: 1;
    min-height: 1;
    margin: 0;
}

#library-shell-grid.library-notes-compact #library-note-status {
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#library-shell-grid.library-notes-compact .library-note-validation #library-note-status {
    height: 2;
    min-height: 2;
    max-height: 2;
    text-wrap: wrap;
    text-overflow: clip;
}

#library-shell-grid.library-notes-compact #library-note-transfer-status,
#library-shell-grid.library-notes-compact #library-note-context-transfer-status {
    display: none;
    height: 0;
    min-height: 0;
