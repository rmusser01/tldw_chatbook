/* Settings splash-screen viewer + theme editor styles.
 *
 * TASK-394: this module previously also carried the OLD (pre-Settings) splash
 * viewer's generic component styles -- bare `VerticalScroll` plus app-wide class
 * names (.setting-label, .section-header, .help-text, .action-buttons,
 * .settings-section, .card-list, .preview-*). Those either leaked app-wide or
 * were dead. The genuinely shared ones moved verbatim to
 * `components/_shared_components.tcss` (same bundle position -> unchanged
 * cascade); the app-wide scrollbar default moved to `core/_base.tcss`; the
 * zero-importer orphans were removed. What remains below is the LIVE, feature-
 * scoped styling for the in-Settings theme editor and splash-screen viewer
 * (`settings_theme_editor.py`, `settings_splash_screen_viewer.py`). */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


/* TASK-32948: picker layout. The pane sits inside the VerticalScroll detail
   body, so every container here must be height:auto with bounded children;
   a 1fr child inside that scroll is the 07-19..09-17 clipping regression
   (Vertical/Horizontal default to height:1fr -- see Textual's DEFAULT_CSS --
   which collapses to zero height/width under an auto-height ancestor chain).
   `#settings-theme-editor-view` already gets `height: auto` from
   features/_settings.tcss (Task 5); not repeated here. */
#settings-theme-pane,
#settings-theme-picker,
#settings-theme-picker-columns,
#settings-theme-list-column,
#settings-theme-card-column {
    height: auto;
}
#settings-theme-list-column,
#settings-theme-card-column {
    width: 1fr;
}
#settings-theme-list {
    height: auto;
    min-height: $ds-size-8;
    max-height: $ds-size-24;
}
#settings-workbench.settings-workbench-compact #settings-theme-picker-columns {
    layout: vertical;
}
/* The highlighted row must not be carried by colour alone (PRODUCT.md
   accessibility): bold as well as the highlight fill. Textual's OptionList
   has no per-row cursor glyph slot; bold is the non-colour cue instead.
   Component-class rules here need an ID (or the bare `OptionList` base
   type, see _lists.tcss precedent) -- `ThemeOptionList > .option-list--
   option-highlighted` (the subclass name) measured un-bolded: component
   styles resolve against the declaring base type, not every subclass name
   used as a CSS type-selector. */
#settings-theme-list > .option-list--option-highlighted {
    text-style: bold;
}
#settings-workbench.settings-workbench-compact #settings-theme-list {
    max-height: $ds-size-9;
}
/* Same stacking the editor's action row already gets under
   `#settings-theme-card .settings-action-row` below -- the picker's chip row
   lives under `#settings-theme-card-column` instead, so it needs its own
   pair. Unconditional (not compact-scoped): `#settings-theme-card-column`
   is only ever 1fr of the picker's width (half, once list-column takes the
   other 1fr), so a horizontal 4-chip row overflows it even at 190x55 --
   measured 66 cols of chips (Use 18 + Try/Clone/New 16 each) packed into a
   54-col column, clipping New to a single visible column
   (Region(x=145,w=16) against a Region(x=92,w=54) clip). Compact width
   (<100 cols) just makes the same overflow worse, not a different bug. */
#settings-theme-card-column .settings-action-row {
    layout: vertical;
    height: auto;
}
#settings-theme-card-column .theme-editor-action {
    width: $ds-width-full;
}
/* At compact width the preview shrinks to its two anchor rows (rail +
   accent); a CSS-only alternative to a compose-time `compact` parameter on
   ThemePreview (removed -- YAGNI, see theme_preview.py). */
#settings-workbench.settings-workbench-compact #settings-theme-picker-preview-user,
#settings-workbench.settings-workbench-compact #settings-theme-picker-preview-assistant,
#settings-workbench.settings-workbench-compact #settings-theme-picker-preview-success,
#settings-workbench.settings-workbench-compact #settings-theme-picker-preview-warning,
#settings-workbench.settings-workbench-compact #settings-theme-picker-preview-error {
    display: none;
}
/* Measured at 80x24 (private_profile debug run): the detail-pane-body
   viewport there is only 15 rows; with the border+margin still on, the
   content after the list (card title/gap + preview + action chips) totals
   12 rows, leaving only 3 rows of the list visible once the bottom-most
   chip (New) is scrolled into view (viewport_height - after_list_total).
   Dropping the compact preview's border and margin trims that block to 8,
   giving the list 7 rows of headroom above the >=5 floor. */
#settings-workbench.settings-workbench-compact #settings-theme-picker-preview {
    border: none;
    margin: $ds-space-0;
}

/* ===== Settings theme editor ===== */
#settings-theme-tree {
    width: $ds-width-full;
    height: $ds-size-12;
    min-height: $ds-size-8;
    border: solid $ds-grid-line;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

/* TASK-31259: the preview is a Console-shaped stub whose rows are painted from
   the palette being edited (see SettingsThemeEditor._refresh_preview), so it
   follows every keystroke instead of the applied app theme. */
.settings-theme-preview {
    width: $ds-width-full;
    height: auto;
    margin: $ds-space-1 $ds-space-0;
    border: solid $ds-grid-line;
}

.settings-theme-preview-row {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
}

/* TASK-31254: a 1-row Static with `border: solid` paints only its top border
   glyphs -- the hex text (and the "invalid" label) never had a content row.
   No border; the colour IS the swatch and the text sits on it. */
.color-swatch {
    width: $ds-size-9;
    min-width: $ds-size-9;
    height: $ds-size-1;
    min-height: $ds-size-1;
    border: none;
    content-align: center middle;
    text-style: bold;
}

/* TASK-32947: 22/40 presets measured <3:1 against the dark card (17/40 on
   light), so near-card colours read as gaps. Thin side rules in the theme's
   foreground frame every cell; border cells keep the swatch's own fill, so
   all three columns still show the colour. */
.color-preset-swatch {
    width: $ds-size-3;
    min-width: $ds-size-3;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    border: none;
    border-left: vkey $foreground;
    border-right: vkey $foreground;
}

/* task-1369: preset swatches are keyboard-activatable (focusable + Enter/
   Space), so they need a visible focus indicator. TASK-32947: the old
   `outline: solid $ds-focus-accent` drew box glyphs in $primary ON the
   swatch (1.51:1 on the blue preset) and hid the colour. Focus now thickens
   the side rules into half-block brackets at the cell's outer edges -- a
   shape change judged against the card beside it, not the swatch. */
.color-preset-swatch:focus {
    outline: none;
    border-left: outer $foreground;
    border-right: outer $foreground;
    text-style: bold;
}

/* TASK-31254: escape the app-wide `Checkbox { height: 2 }` + tall border that
   leaves zero content rows (the TASK-18960 family; same idiom as
   `.settings-imagegen-backend-row Checkbox`). One row: glyph + On/Off label. */
#settings-theme-dark-mode {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-bottom: $ds-space-0;
    border: none;
    padding: $ds-space-0;
}
/* TASK-32947: the off glyph was painted in the card's own fill (1.0:1), so
   an unchecked box showed nothing. Off now shows Textual's own convention --
   a dimmed X in the muted text tone -- and on keeps the success X; the
   On/Off label still carries the state in words. */
#settings-theme-dark-mode > .toggle--button {
    color: $ds-text-muted;
}
#settings-theme-dark-mode.-on > .toggle--button {
    color: $success;
}

/* TASK-32947: theme-card action buttons. Textual's variant fills paint an
   `auto 87%` label whose black/white pick uses perceived brightness, not
   WCAG luminance (Apply 3.78:1 on textual-dark, Delete 4.47:1, 2.93:1 on
   gruvbox_dark); default buttons filled with the card colour and read as
   bold prose; and `.settings-action-row Button:focus` swapped every fill
   for neutral, erasing Apply/Delete's meaning. Here each button is a
   bracketed chip on the card: label and brackets in a readable hue (the
   AA-pinned `text-*` tints, ensure_readable_text_hues), focus inverts the
   chip into that hue. Low specificity on purpose: app-wide
   `Button:hover`/`Button:disabled` still win for the neutral chips, and the
   variant rules are `:enabled` so a disabled Delete never paints as live. */
.theme-editor-action {
    background: $ds-surface-panel;
    color: $ds-text-primary;
    border-left: outer $foreground;
    border-right: outer $foreground;
}
.theme-editor-action.-primary:enabled {
    background: $ds-surface-panel;
    color: $text-primary;
    border-left: outer $text-primary;
    border-right: outer $text-primary;
}
.theme-editor-action.-success:enabled {
    background: $ds-surface-panel;
    color: $text-success;
    border-left: outer $text-success;
    border-right: outer $text-success;
}
.theme-editor-action.-warning:enabled {
    background: $ds-surface-panel;
    color: $text-warning;
    border-left: outer $text-warning;
    border-right: outer $text-warning;
}
.theme-editor-action.-error:enabled {
    background: $ds-surface-panel;
    color: $ds-status-error-readable;
    border-left: outer $ds-status-error-readable;
    border-right: outer $ds-status-error-readable;
}
/* Must beat the Settings screen sheet's `#settings-shell Button:hover:focus`
   (1,2,1) and `.settings-action-row Button:focus` (0,2,1), hence (1,3,0). */
#settings-theme-card .settings-action-row .theme-editor-action:focus {
    background: $text-primary;
    color: $ds-surface-panel;
    border-left: outer $text-primary;
    border-right: outer $text-primary;
}
#settings-theme-card .settings-action-row .theme-editor-action.-success:focus {
    background: $text-success;
    border-left: outer $text-success;
    border-right: outer $text-success;
}
#settings-theme-card .settings-action-row .theme-editor-action.-warning:focus {
    background: $text-warning;
    border-left: outer $text-warning;
    border-right: outer $text-warning;
}
#settings-theme-card .settings-action-row .theme-editor-action.-error:focus {
    background: $ds-status-error-readable;
    border-left: outer $ds-status-error-readable;
    border-right: outer $ds-status-error-readable;
}


/* TASK-31279: below SETTINGS_COMPACT_WORKBENCH_MAX_WIDTH (100 cols) the
   detail pane is ~45 cells; four 16-cell-minimum buttons cannot share a row,
   so the library and action rows stack and each button takes the width. */
#settings-workbench.settings-workbench-compact #settings-theme-card .settings-action-row {
    layout: vertical;
    height: auto;
}
#settings-workbench.settings-workbench-compact #settings-theme-card .theme-editor-action {
    width: $ds-width-full;
}

/* ===== Settings splash screen viewer ===== */
.settings-splash-gallery {
    height: $ds-size-24;
    min-height: $ds-size-16;
    width: $ds-width-full;
}

#settings-splash-card-list {
    width: $ds-percent-45;
    height: $ds-height-full;
    border: solid $primary-lighten-2;
}

#settings-splash-preview-scroll {
    width: $ds-width-fill;
    height: $ds-height-full;
    border: solid $primary-lighten-2;
    background: $surface;
}

.settings-splash-preview {
    width: $ds-width-full;
    height: $ds-height-full;
}

.settings-splash-preview #splash-display {
    width: $ds-width-full;
    height: $ds-height-full;
}

/* Theme editor selectable swatches and preview contrast (ADR-161). */

    SettingsThemeEditor .theme-preset-blues-0 { background: $ds-theme-preset-blues-0; }
    SettingsThemeEditor .theme-preset-blues-1 { background: $ds-theme-preset-blues-1; }
    SettingsThemeEditor .theme-preset-blues-2 { background: $ds-theme-preset-blues-2; }
    SettingsThemeEditor .theme-preset-blues-3 { background: $ds-theme-preset-blues-3; }
    SettingsThemeEditor .theme-preset-blues-4 { background: $ds-theme-preset-blues-4; }
    SettingsThemeEditor .theme-preset-greens-0 { background: $ds-theme-preset-greens-0; }
    SettingsThemeEditor .theme-preset-greens-1 { background: $ds-theme-preset-greens-1; }
    SettingsThemeEditor .theme-preset-greens-2 { background: $ds-theme-preset-greens-2; }
    SettingsThemeEditor .theme-preset-greens-3 { background: $ds-theme-preset-greens-3; }
    SettingsThemeEditor .theme-preset-greens-4 { background: $ds-theme-preset-greens-4; }
    SettingsThemeEditor .theme-preset-reds-0 { background: $ds-theme-preset-reds-0; }
    SettingsThemeEditor .theme-preset-reds-1 { background: $ds-theme-preset-reds-1; }
    SettingsThemeEditor .theme-preset-reds-2 { background: $ds-theme-preset-reds-2; }
    SettingsThemeEditor .theme-preset-reds-3 { background: $ds-theme-preset-reds-3; }
    SettingsThemeEditor .theme-preset-reds-4 { background: $ds-theme-preset-reds-4; }
    SettingsThemeEditor .theme-preset-purples-0 { background: $ds-theme-preset-purples-0; }
    SettingsThemeEditor .theme-preset-purples-1 { background: $ds-theme-preset-purples-1; }
    SettingsThemeEditor .theme-preset-purples-2 { background: $ds-theme-preset-purples-2; }
    SettingsThemeEditor .theme-preset-purples-3 { background: $ds-theme-preset-purples-3; }
    SettingsThemeEditor .theme-preset-purples-4 { background: $ds-theme-preset-purples-4; }
    SettingsThemeEditor .theme-preset-grays-0 { background: $ds-theme-preset-grays-0; }
    SettingsThemeEditor .theme-preset-grays-1 { background: $ds-theme-preset-grays-1; }
    SettingsThemeEditor .theme-preset-grays-2 { background: $ds-theme-preset-grays-2; }
    SettingsThemeEditor .theme-preset-grays-3 { background: $ds-theme-preset-grays-3; }
    SettingsThemeEditor .theme-preset-grays-4 { background: $ds-theme-preset-grays-4; }
    SettingsThemeEditor .theme-preset-material-0 { background: $ds-theme-preset-material-0; }
    SettingsThemeEditor .theme-preset-material-1 { background: $ds-theme-preset-material-1; }
    SettingsThemeEditor .theme-preset-material-2 { background: $ds-theme-preset-material-2; }
    SettingsThemeEditor .theme-preset-material-3 { background: $ds-theme-preset-material-3; }
    SettingsThemeEditor .theme-preset-material-4 { background: $ds-theme-preset-material-4; }
    SettingsThemeEditor .theme-preset-pastels-0 { background: $ds-theme-preset-pastels-0; }
    SettingsThemeEditor .theme-preset-pastels-1 { background: $ds-theme-preset-pastels-1; }
    SettingsThemeEditor .theme-preset-pastels-2 { background: $ds-theme-preset-pastels-2; }
    SettingsThemeEditor .theme-preset-pastels-3 { background: $ds-theme-preset-pastels-3; }
    SettingsThemeEditor .theme-preset-pastels-4 { background: $ds-theme-preset-pastels-4; }
    SettingsThemeEditor .theme-preset-dark-0 { background: $ds-theme-preset-dark-0; }
    SettingsThemeEditor .theme-preset-dark-1 { background: $ds-theme-preset-dark-1; }
    SettingsThemeEditor .theme-preset-dark-2 { background: $ds-theme-preset-dark-2; }
    SettingsThemeEditor .theme-preset-dark-3 { background: $ds-theme-preset-dark-3; }
    SettingsThemeEditor .theme-preset-dark-4 { background: $ds-theme-preset-dark-4; }
    SettingsThemeEditor .theme-preview-dark-ink { color: $ds-theme-preview-dark-ink !important; }
    SettingsThemeEditor .theme-preview-light-ink { color: $ds-theme-preview-light-ink !important; }
    SettingsThemeEditor .theme-preview-invalid { background: $ds-theme-preview-invalid !important; color: $ds-theme-preview-light-ink !important; }
