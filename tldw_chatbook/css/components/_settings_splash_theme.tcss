/* Settings splash-screen viewer + theme editor styles.
 *
 * TASK-394: this module previously also carried the OLD (pre-Settings) splash
 * viewer's generic component styles -- bare `VerticalScroll` plus app-wide class
 * names (.setting-label, .section-header, .help-text, .action-buttons,
 * .settings-section, .card-list, .preview-*). Those either leaked app-wide or
 * were dead. The genuinely shared ones moved verbatim to
 * `components/_shared_components.tcss` (same bundle position -> unchanged
 * cascade); the app-wide scrollbar default moved to `core/_base.tcss`; the
 * zero-importer orphans were removed. What remains below is the LIVE, feature-
 * scoped styling for the in-Settings theme editor and splash-screen viewer
 * (`settings_theme_editor.py`, `settings_splash_screen_viewer.py`). */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


/* ===== Settings theme editor ===== */
#settings-theme-tree {
    width: $ds-width-full;
    height: $ds-size-12;
    min-height: $ds-size-8;
    border: solid $ds-grid-line;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

/* TASK-31259: the preview is a Console-shaped stub whose rows are painted from
   the palette being edited (see SettingsThemeEditor._refresh_preview), so it
   follows every keystroke instead of the applied app theme. */
.settings-theme-preview {
    width: $ds-width-full;
    height: auto;
    margin: $ds-space-1 $ds-space-0;
    border: solid $ds-grid-line;
}

.settings-theme-preview-row {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
}

/* TASK-31254: a 1-row Static with `border: solid` paints only its top border
   glyphs -- the hex text (and the "invalid" label) never had a content row.
   No border; the colour IS the swatch and the text sits on it. */
.color-swatch {
    width: $ds-size-9;
    min-width: $ds-size-9;
    height: $ds-size-1;
    min-height: $ds-size-1;
    border: none;
    content-align: center middle;
    text-style: bold;
}

.color-preset-swatch {
    width: $ds-size-3;
    min-width: $ds-size-3;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    border: none;
}

/* task-1369: preset swatches are keyboard-activatable (focusable + Enter/
   Space), so they need a visible focus indicator. An outline paints over the
   swatch's own cells without needing a border row, so the colour stays
   visible (TASK-31254). */
.color-preset-swatch:focus {
    outline: solid $ds-focus-accent;
    text-style: bold;
}

/* TASK-31254: escape the app-wide `Checkbox { height: 2 }` + tall border that
   leaves zero content rows (the TASK-18960 family; same idiom as
   `.settings-imagegen-backend-row Checkbox`). One row: glyph + On/Off label. */
#settings-theme-dark-mode {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-bottom: $ds-space-0;
    border: none;
    padding: $ds-space-0;
}
#settings-theme-dark-mode > .toggle--button {
    color: $ds-surface-panel;
}
#settings-theme-dark-mode.-on > .toggle--button {
    color: $success;
}


/* TASK-31279: below SETTINGS_COMPACT_WORKBENCH_MAX_WIDTH (100 cols) the
   detail pane is ~45 cells; four 16-cell-minimum buttons cannot share a row,
   so the library and action rows stack and each button takes the width. */
#settings-workbench.settings-workbench-compact #settings-theme-card .settings-action-row {
    layout: vertical;
    height: auto;
}
#settings-workbench.settings-workbench-compact #settings-theme-card .theme-editor-action {
    width: $ds-width-full;
}

/* ===== Settings splash screen viewer ===== */
.settings-splash-gallery {
    height: $ds-size-24;
    min-height: $ds-size-16;
    width: $ds-width-full;
}

#settings-splash-card-list {
    width: $ds-percent-45;
    height: $ds-height-full;
    border: solid $primary-lighten-2;
}

#settings-splash-preview-scroll {
    width: $ds-width-fill;
    height: $ds-height-full;
    border: solid $primary-lighten-2;
    background: $surface;
}

.settings-splash-preview {
    width: $ds-width-full;
    height: $ds-height-full;
}

.settings-splash-preview #splash-display {
    width: $ds-width-full;
    height: $ds-height-full;
}
