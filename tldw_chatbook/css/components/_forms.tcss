/* ========================================
 * COMPONENTS: Forms
 * ======================================== 
 * Form elements: inputs, textareas, selects
 * ======================================== */

.form-label {
    margin-bottom: 1;
    text-style: bold;
}

.form-section-title {
    text-style: bold;
    color: $secondary;
    margin: 2 0 1 0;
    border-bottom: solid $primary-background;
    padding-bottom: 1;
}

.form-description {
    color: $text-muted;
    margin-bottom: 2;
    text-style: italic;
}

.form-actions {
    margin-top: 2;
    layout: horizontal;
    height: auto;
    align: center middle;
}

.form-actions Button {
    margin: 0 1 0 0;
}

.provider-models-textarea {
    height: 5;
    margin-bottom: 1;
}

/* Standardized form components */
.form-input {
    width: 100%;
    margin-bottom: 1;
}

.form-textarea {
    width: 100%;
    height: auto;
    min-height: 5;
    margin-bottom: 1;
}


.form-checkbox {
    margin: 1 0;
}

/* Form layout helpers */
.form-row {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.form-col {
    width: 1fr;
    padding: 0 1;
}

.form-col:first-child {
    padding-left: 0;
}

.form-col:last-child {
    padding-right: 0;
}

/* Form sections */
.form-section-collapsible {
    margin: 1 0;
}

/* Button groups */
.button-group {
    width: 100%;
    height: auto;
    margin: 2 0;
}

.button-group-left {
    align: left top;
}

.button-group-center {
    align: center top;
}

.button-group-right {
    align: right top;
}

.form-button {
    margin: 0 1;
}

/* Status areas */
.status-label {
    margin-top: 2;
    margin-bottom: 0;
    color: $text-muted;
}

.status-area {
    width: 100%;
    background: $surface;
    border: round $border;
    padding: 1;
    margin-top: 1;
}

/* Title/Author input fields fix */
.title-author-row Input {
    height: 3;
    width: 100%;
    margin-bottom: 1;
}

Input:focus,
TextArea:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

/* TASK-14879: File Notes fields already use the stable border treatment
 * above. Remove the global perimeter outline so it cannot repaint the first
 * or last editor/search cells over meaningful content. */
LibraryFileNotesWorkspace Input:focus,
LibraryFileNotesWorkspace TextArea:focus {
    outline: none;
}

/* TASK-2300. `Select:focus` used to be in the rule above, and it is the one
 * member of that list that does not draw its own border.
 *
 * `Input` and `TextArea` each carry `border: tall $border-blurred` on
 * themselves, so the declaration above REPLACES a border that already exists
 * and costs nothing. A `Select` draws its border on its child
 * `SelectCurrent` (`Select` DEFAULT_CSS: `&:focus > SelectCurrent { border:
 * tall $border; }`) and has none of its own -- so the same declaration ADDED
 * a second one, two rows of chrome, around a widget whose three rows were
 * already spoken for. Measured live at 235x52, the New Rule form's condition
 * Select with focus on it:
 *
 *     ┌──────────────────────┐
 *     │▊▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▎│     <- SelectCurrent's own top border
 *     └──────────────────────┘
 *
 * Three rows of frame and no value. Clicking the control to open it is what
 * focuses it, so this is the state of every Select the moment a user reaches
 * for one -- the same "a bare border where a control should be" the 2026-08-04
 * UAT reported for the Items filter, on a different Select for a different
 * reason.
 *
 * Only the recolouring half is kept, on the `Select` itself where it always
 * was. The border half is not re-homed onto `SelectCurrent` -- Textual's own
 * `&:focus > SelectCurrent { border: tall $border; }` already recolours
 * exactly that border on focus, at exactly the geometry it is already sized
 * for, so re-stating it here in app colours would buy a shade and cost a
 * fight: the re-homed rule (`Select:focus > SelectCurrent`, specificity
 * (0,1,2)) also outranked `.settings-compact-select > SelectCurrent`'s
 * deliberate `border: none` (0,1,1), putting the frame back INSIDE a control
 * that draws its own frame outside. Review wave, Critical 1: this family of
 * rules keeps losing to the fact that "a Select" is three different shapes,
 * so the app now styles only what every shape has -- its colours.
 *
 * ROUND 2, O1 -- and how far even that reaches is worth stating, because the
 * previous wording claimed more than it delivered ("the recolouring half is
 * what marks focus now"). It is NOT, on its own. `SelectCurrent` is a child
 * with an opaque `background: $surface` covering the whole parent, so on a
 * borderless compact `Select` this declaration is painted over completely and
 * only Textual's 5% `background-tint` survives (~1.10:1, measured). What
 * actually marks focus is per shape:
 *
 *   three-row `Select`    Textual's own `&:focus > SelectCurrent { border:
 *                         tall $border; }` -- a real, visible border swap
 *   `.settings-compact-*` its own `:focus` rules, border AND background
 *   borderless compact    `Select.-textual-compact:focus > SelectCurrent`
 *                         in components/_lists.tcss, added by O1
 *
 * This rule is kept because it is the one that reaches a `Select` whose child
 * does NOT cover it (padding, a themed variant), and because removing a
 * pre-existing app-wide declaration on the strength of one shape's geometry
 * is how this family of bugs started.
 */
Select:focus {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

ToggleButton:focus {
    border: solid $ds-focus-accent;
    background: $surface;
}

ToggleButton:focus > .toggle--label,
ToggleButton.-textual-compact:focus > .toggle--label,
ToggleButton:blur:hover > .toggle--label {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

Switch:focus {
    border: solid $ds-focus-accent;
    background: $ds-focus-bg;
}

/* New base media ingestion form styling */
.form-input {
    height: 3;
    width: 100%;
    margin-bottom: 1;
    border: solid $primary;
    padding: 0 1;
}

.form-input:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

.form-input.error {
    border: solid $error;
    background: $error 10%;
}

.form-select {
    height: 3;
    width: 100%;
    margin-bottom: 1;
}

.form-checkbox {
    margin: 1 0;
}

/* Responsive metadata columns */
.metadata-row {
    layout: horizontal;
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.metadata-col {
    width: 1fr;
    height: auto;
}

/* Mode toggle section - CRITICAL for visibility */
.mode-toggle-container {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    padding: 1;
}

.mode-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.mode-toggle {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

/* Essential container sections - CRITICAL for Input widget visibility */
.essential-section {
    width: 100%;
    height: auto;        /* Allow container to size to content */
    margin-bottom: 2;
    padding: 1;
}

.media-options-section {
    width: 100%;
    height: auto;
    margin-bottom: 2;
}

.options-section {
    width: 100%;
    height: auto;
    margin-bottom: 2;
    padding: 1;
}

.process-button-section {
    width: 100%;
    height: auto;
    margin-top: 2;
    padding: 1;
    align: center middle;
}

/* Time range inputs layout */
.time-range-row {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.time-col {
    width: 1fr;
    height: auto;
    padding: 0 1;
}

.time-col:first-child {
    padding-left: 0;
}

.time-col:last-child {
    padding-right: 0;
}

/* Advanced mode visibility controls */
.advanced-only {
    display: block;
}

.simple-mode .advanced-only {
    display: none;
}

.advanced-mode .advanced-only {
    display: block;
}

/* Form textarea styling */
.form-textarea {
    width: 100%;
    min-height: 5;
    max-height: 10;
    margin-bottom: 1;
    border: solid $primary;
    padding: 1;
}

.form-textarea:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

/* Note: Textual doesn't support @media queries
   Responsive behavior must be handled programmatically
   in the Python code using terminal size detection */
