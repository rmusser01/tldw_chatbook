/* Agent Change Review screen (TASK-1973). A pushed overlay: header with the
   turn selector, honesty banner, changed-file tree beside a windowed diff
   pane. Heights are explicit everywhere a Horizontal/Vertical appears --
   the fr-inside-flex default has bitten this codebase repeatedly (approval
   card TASK-1846, MCP lockstep rules). */
#change-review-screen {
    height: 1fr;
    width: 1fr;
}
#change-review-header {
    height: auto;
    min-height: 1;
    padding: 0 1;
}
#change-review-title {
    width: auto;
    padding-right: 2;
    text-style: bold;
}
#change-review-turn-select {
    width: 44;
}
#change-review-totals {
    width: 1fr;
    content-align: right middle;
}
.change-review-banner {
    height: auto;
    padding: 0 1;
    color: $ds-status-warning;
}
#change-review-body {
    height: 1fr;
}
#change-review-tree {
    width: 46;
    height: 1fr;
}
#change-review-diff {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}
.change-review-diff-body {
    width: 1fr;
    height: auto;
}
#change-review-footer {
    height: 1;
    color: $ds-text-muted;
    padding: 0 1;
}
