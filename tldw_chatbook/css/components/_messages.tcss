/* ========================================
 * COMPONENTS: Messages
 * ========================================
 * Message display components. ADR-161 task 8c: the shared transcript
 * grammar (the classes composed identically by ChatMessage -- Console
 * transcripts and tool widgets -- and ChatMessageEnhanced -- the Chat
 * window) is defined ONLY here: .message-header/.message-text/
 * .message-actions plus the strip's Button states and the delete-button
 * hover. The widgets' DEFAULT_CSS copies (identical or bundle-wins
 * subsets) were deleted; ChatMessage now has no DEFAULT_CSS at all.
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales + named
   \$ds-messages-* viewport scroll caps), transcribed value-identically
   from the raw literals; comments stay load-bearing. */


ChatMessage {
    width: $ds-width-full;
    height: auto;
    max-height: $ds-messages-scroll-cap;  /* Limit message height to 50% of viewport */
    margin-bottom: $ds-space-1;
    overflow-y: auto;  /* Allow scrolling within long messages */
}
ChatMessage > Vertical {
    border: round $surface;
    background: $panel;
    padding: $ds-space-0 $ds-space-1;
    width: $ds-width-full;
    height: auto;
}
ChatMessage.-user > Vertical {
    background: $boost; /* Different background for user */
    border: round $accent;
}
ChatMessage.-tool-call > Vertical {
    background: $surface-lighten-1;
    border: round $warning;
}
ChatMessage.-tool-result > Vertical {
    background: $surface-lighten-1;
    border: round $success;
}
.message-header {
    width: $ds-width-full;
    padding: $ds-space-0 $ds-space-1;
    background: $surface-darken-1;
    text-style: bold;
    height: $ds-size-1; /* Ensure header is minimal height */
}
.message-text {
    padding: $ds-space-1; /* Padding around the text itself */
    width: $ds-width-full;
    height: auto;
    max-height: $ds-messages-text-scroll-cap;  /* Limit text area to 40% of viewport */
    overflow-y: auto;  /* Allow scrolling within long text */
}

.message-text.tts-generating {
    opacity: 0.8;
    border-left: thick $accent;
}
.message-actions {
    height: auto;
    width: $ds-width-full;
    padding: $ds-space-1; /* Add padding around buttons */
    /* Use a VALID border type */
    border-top: solid $surface-lighten-1; /* CHANGED thin to solid */
    align: right middle; /* Align buttons to the right */
    display: block; /* Default display state */
}
.message-actions Button {
    min-width: $ds-size-8;
    height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1; /* Space between buttons */
    border: none;
    background: $surface-lighten-2;
    color: $text-muted;
}
.message-actions Button:hover {
    background: $surface;
    color: $text;
}
.message-actions Button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}
.message-actions Button:focus:hover {
    background: $ds-surface-raised;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}
/* The destructive member of the action strip (both message widgets
   compose the trash button with `action-button delete-button`). Promoted
   from the two identical DEFAULT_CSS copies (ADR-161 task 8c). */
.message-actions .delete-button:hover {
    background: $error;
    color: white;
}
/* Initially hide AI actions until generation is complete */
ChatMessage.-ai .message-actions.-generating {
    display: none;
}
