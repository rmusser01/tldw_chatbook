/* Approved editor geometry: 28/27-column rails, 6-row fields and bounded dialogs.
 * Shared visual values use ADR-150 tokens; feature geometry uses shared dimension tokens. */
WorkflowsScreen #workflow-authoring { height: $ds-height-fill; min-height: $ds-size-0; }
    WorkflowsScreen #workflows-title { height: $ds-control-height-compact; color: $ds-action-focus; text-style: $ds-text-strong; padding: $ds-space-0 $ds-space-inset; }
    WorkflowsScreen #workflow-draft-status { height: auto; max-height: $ds-size-2; padding: $ds-space-0 $ds-space-inset; background: $ds-surface-panel; }
    WorkflowsScreen #workflow-action-bar, WorkflowsScreen #workflow-selectors { height: $ds-control-height-compact; padding: $ds-space-0 $ds-space-inset; margin-bottom: $ds-space-stack; }
    WorkflowsScreen #workflow-panes { height: $ds-height-fill; min-height: $ds-size-0; }
    WorkflowsScreen #workflow-readiness { height: auto; max-height: $ds-size-2; padding: $ds-space-0 $ds-space-inset; }
    WorkflowsScreen #workflows-unavailable { height: auto; padding: $ds-space-inset; }


    WorkflowEditor#workflows-editor { width: $ds-width-fill; height: $ds-height-fill; min-width: $ds-size-12; padding: $ds-space-0 $ds-space-inset; }
    WorkflowEditor #workflow-form { height: $ds-height-fill; min-height: $ds-control-height-compact; }
    WorkflowEditor #workflow-general, WorkflowEditor #workflow-step-form { height: auto; }
    WorkflowEditor .workflow-neighbors, WorkflowEditor .workflow-step-actions { height: $ds-control-height-compact; margin: $ds-space-0 $ds-space-0 $ds-space-stack $ds-space-0; }
    WorkflowEditor .workflow-field { height: auto; margin-bottom: $ds-space-stack; }
    WorkflowEditor .workflow-field Label { height: auto; margin: $ds-space-0; }
    WorkflowEditor TextArea { height: $ds-size-6; min-height: $ds-control-height; }
    WorkflowEditor Collapsible { padding: $ds-space-0; margin: $ds-space-0 $ds-space-0 $ds-space-stack $ds-space-0; border: none; }
    WorkflowEditor Collapsible > Contents { padding: $ds-space-0 $ds-space-inset; }
    WorkflowEditor .workflow-help { height: auto; color: $ds-text-muted; }
    WorkflowEditor .workflow-linear-step { width: $ds-width-full; height: $ds-control-height; margin: $ds-space-0 $ds-space-0 $ds-space-stack $ds-space-0; }
    WorkflowEditor #workflow-editor-heading { color: $ds-action-focus; text-style: $ds-text-strong; height: $ds-control-height-compact; }
    WorkflowEditor #workflow-scroll-hint { height: $ds-control-height-compact; color: $ds-text-muted; }


    ChoiceModal { align: center middle; background: $background $ds-opacity-dim; }
    ChoiceModal > Vertical.workflow-choice-body { width: $ds-percent-90; max-width: $ds-size-90; height: $ds-percent-80; border: solid $ds-action-focus; background: $ds-surface-panel; padding: $ds-space-inset; }
    ChoiceModal OptionList { height: $ds-height-fill; min-height: $ds-control-height-compact; }
    ChoiceModal .workflow-dialog-actions { height: $ds-control-height-compact; }
    ChoiceModal .choice-copy { height: auto; max-height: $ds-size-8; }
    ChoiceModal #workflow-dialog-detail { height: $ds-height-fill; min-height: $ds-size-2; max-height: $ds-size-8; }
    ChoiceModal #workflow-dialog-detail Static { height: auto; }
    ChoiceModal.has-scroll-detail #workflow-dialog-choices { height: $ds-control-height; min-height: $ds-control-height; }
    StepChooser > Vertical.workflow-choice-body { padding: $ds-space-0 $ds-space-inset; }
    StepChooser .choice-copy { max-height: $ds-control-height; }


    WorkflowLibrary#workflows-library { width: $ds-size-28; min-width: $ds-size-0; height: $ds-height-fill; border-right: solid $ds-column-line; padding: $ds-space-0 $ds-space-inset; }
    WorkflowLibrary#workflows-library OptionList { height: $ds-height-fill; min-height: $ds-control-height-compact; }
    WorkflowLibrary#workflows-library Input { margin: $ds-space-0; }
    WorkflowLibrary #workflow-library-pages { height: $ds-control-height-compact; }


    WorkflowNavigator#workflows-navigator { width: $ds-workflow-navigator-width; min-width: $ds-size-0; height: $ds-height-fill; border-right: solid $ds-column-line; padding: $ds-space-0 $ds-space-inset; }
    WorkflowNavigator#workflows-navigator OptionList { height: $ds-height-fill; min-height: $ds-control-height-compact; }

WorkflowsScreen #workflow-run:disabled {
    background: $ds-disabled-bg;
    color: $ds-text-disabled-readable;
    opacity: 1;
    text-style: $ds-text-strong;
}
WorkflowsScreen #workflow-library-search > .input--placeholder {
    color: $ds-text-muted;
    text-style: none;
}
WorkflowConsoleContext { height: $ds-control-height-compact; padding: $ds-space-0 $ds-space-inset; }
WorkflowConsoleContext #workflows-run-status,
WorkflowConsoleContext #workflows-console-unavailable { height: $ds-control-height-compact; width: $ds-width-fill; }
WorkflowConsoleContext .workflow-console-actions { height: $ds-control-height-compact; }
WorkflowEditor TextArea.workflow-expanded { height: $ds-size-18; }
WorkflowsScreen WorkflowEditor TextArea.form-textarea { height: $ds-size-6; min-height: $ds-control-height; }
WorkflowsScreen.workflow-short WorkflowEditor TextArea.form-textarea {
    height: $ds-control-height;
    padding: $ds-space-0 $ds-space-inset;
}
WorkflowsScreen WorkflowEditor TextArea.form-textarea.workflow-expanded { height: $ds-size-18; max-height: $ds-size-18; }
WorkflowsScreen.workflow-short #workflow-action-bar,
WorkflowsScreen.workflow-short #workflow-selectors { margin-bottom: $ds-space-0; }

.workflow-compact {
    height: $ds-control-height-compact;
    min-width: $ds-size-0;
    width: auto;
    margin: $ds-space-0;
    border: none;
    outline: none;
}
.workflow-compact:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}
.workflow-compact:hover {
    background: $ds-hover-bg;
    color: $ds-hover-fg;
}
.workflow-compact:disabled, .workflow-compact:disabled:hover {
    background: $ds-disabled-bg;
    color: $ds-text-disabled-readable;
    opacity: 1;
    text-style: $ds-text-strong;
}
WorkflowEditor .workflow-collapse {
    padding: $ds-space-0;
    border: none;
    margin: $ds-space-0 $ds-space-0 $ds-space-stack $ds-space-0;
}
WorkflowEditor .workflow-collapse-title {
    height: $ds-control-height-compact;
    padding: $ds-space-0;
    border: none;
}
.workflow-step-chooser > Vertical { padding: $ds-space-0 $ds-space-inset; }
.workflow-step-chooser #workflow-type-detail { max-height: $ds-control-height; }

/* One disposable session panel; the continuous authoring panes retain their flex. */
WorkflowRunPanel { height: auto; padding: $ds-space-0 $ds-space-inset; }
WorkflowRunPanel.workflow-session-expanded { height: 45%; min-height: 8; }
WorkflowRunPanel Collapsible { height: 1fr; padding: $ds-space-0; margin: $ds-space-0; border: none; }
WorkflowRunPanel Collapsible > Contents { padding: $ds-space-0; height: 1fr; }
WorkflowRunPanel #workflow-session-content { height: 1fr; min-height: $ds-control-height; }
WorkflowRunPanel Static.workflow-run-copy { height: auto; }
/* CollapsibleTitle inherits Static; preserve its compact height explicitly. */
#workflow-session-collapse > CollapsibleTitle { height: auto; }
WorkflowRunPanel #workflow-session-status { height: $ds-control-height-compact; color: $ds-status-info; }
WorkflowRunPanel TextArea { height: 6; min-height: $ds-textarea-min-height; padding: $ds-space-0 $ds-space-inset; }
.workflow-run-actions { height: $ds-control-height-compact; margin: $ds-space-0; }
WorkflowRunSetup, WorkflowRunConfirmation { align: center middle; background: $background $ds-opacity-dim; }
.workflow-run-dialog { width: 90%; max-width: 100; height: 90%; border: solid $ds-action-focus; background: $ds-surface-panel; padding: $ds-space-inset; }
.workflow-run-dialog VerticalScroll.workflow-run-scroll { height: 1fr; min-height: $ds-control-height; }
.workflow-run-dialog Static.workflow-run-copy { height: auto; }
.workflow-run-heading { color: $ds-action-focus; text-style: $ds-text-strong; }
.workflow-run-dialog Input.workflow-run-field, .workflow-run-dialog Select.workflow-run-field { height: $ds-control-height; margin: $ds-space-0; }
.workflow-run-dialog TextArea { height: 6; padding: $ds-space-0 $ds-space-inset; }
#workflow-setup-error { color: $ds-status-error-readable; }
