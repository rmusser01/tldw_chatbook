/* Plugins: the existing dense terminal list / details grammar. */
#plugins-shell {
    height: $ds-height-fill;
    padding: $ds-space-0 $ds-space-inset;
}
#plugins-shell .section-title { height: $ds-control-height-compact; text-style: $ds-text-strong; color: $ds-text-primary; }
#plugins-scope { height: auto; color: $ds-authority-workspace; }
#plugins-status { height: auto; max-height: $ds-control-height; color: $ds-text-muted; }
#plugins-modes, #plugins-entry-actions, #plugins-management-actions, #plugins-pager, #plugins-detail-actions, .plugins-form-actions {
    height: $ds-control-height;
}
#plugins-shell Button { min-width: $ds-size-0; width: $ds-width-fill; }
#plugins-modes Button { height: $ds-control-height; }
#plugins-search > .input--placeholder { color: $ds-text-primary; }
#plugins-search { height: $ds-control-height; }
#plugins-panes { height: $ds-height-fill; min-height: $ds-size-0; }
#plugins-list-pane { width: $ds-sidebar-width; min-width: $ds-sidebar-min-width; height: $ds-height-fill; }
#plugins-list { height: $ds-height-fill; border: solid $ds-grid-line; }
#plugins-list:focus {
    border: solid $ds-active-fg;
    outline: solid $ds-active-fg;
}
#plugins-detail-pane { width: $ds-width-fill; height: $ds-height-fill; padding-left: $ds-space-inset; }
#plugins-detail-scroll { height: $ds-height-fill; border: solid $ds-grid-line; padding: $ds-space-0 $ds-space-inset; }
#plugins-detail, #plugins-readme { height: auto; }
#plugins-page { width: auto; padding: $ds-space-1; }
#plugins-entry-form { height: $ds-height-fill; }
#plugins-entry-form Input, #plugins-entry-form Select { margin-bottom: $ds-space-stack; }
#plugins-form-result { height: auto; }
.plugins-narrow #plugins-list-pane { width: $ds-width-full; min-width: $ds-size-0; }
.plugins-narrow #plugins-detail-pane { width: $ds-width-full; padding-left: $ds-space-0; }
#plugins-back { height: $ds-control-height; }

/* Keep the 24-row terminal usable with the incumbent compact controls. */
#plugins-shell .section-title, #plugins-scope, #plugins-search { margin: $ds-space-0; }
.plugins-narrow #plugins-modes, .plugins-narrow #plugins-entry-actions,
.plugins-narrow #plugins-management-actions,
.plugins-narrow #plugins-pager, .plugins-narrow #plugins-detail-actions,
.plugins-narrow #plugins-back {
    height: $ds-control-height-compact;
}
.plugins-narrow #plugins-modes Button, .plugins-narrow #plugins-entry-actions Button,
.plugins-narrow #plugins-management-actions Button,
.plugins-narrow #plugins-pager Button, .plugins-narrow #plugins-detail-actions Button,
.plugins-narrow #plugins-back {
    height: $ds-control-height-compact;
    min-height: $ds-control-height-compact;
    border: none;
    padding: $ds-space-0 $ds-space-inline;
}
.plugins-narrow #plugins-page { padding: $ds-space-0 $ds-space-inline; }

PluginReviewModal, PluginStatusModal, PluginAuthorityResetModal { align: center middle; }
#plugin-review-shell {
    width: $ds-percent-90; height: $ds-percent-90; background: $ds-surface-raised;
    border: solid $ds-grid-line; padding: $ds-space-inset;
    color: $ds-text-primary;
}
#plugin-review-shell .dialog-title, #plugin-review-status, #plugin-review-body { height: auto; color: $ds-text-primary; }
#plugin-review-selection { height: $ds-textarea-min-height; }
#plugin-review-shell .dialog-buttons { height: $ds-control-height; }
#plugin-review-shell Button { width: $ds-width-fill; min-width: $ds-size-0; }

#plugin-review-test-data { height: $ds-textarea-min-height; }

/* The credential owner keeps its masked fields and scrolling behavior. */
PluginAuthorityDialog .dialog-title,
PluginAuthorityDialog .password-input > .input--placeholder { color: $ds-text-primary; }
PluginAuthorityDialog .password-dialog-error,
PluginAuthorityDialog .strength-weak { color: $ds-status-error-readable; }

#plugin-review-shell Input > .input--placeholder { color: $ds-text-primary; }
