/* Console prompt controls: style picker, Prompt Workbench and per-chat mix-ins. */

#console-style-picker-modal {
    width: $ds-size-76;
    max-width: $ds-percent-95;
    height: auto;
    max-height: $ds-percent-85;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: $ds-space-1 $ds-space-2;
}

#console-style-picker-filter {
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-style-picker-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

#console-style-picker-results {
    height: auto;
    max-height: $ds-size-20;
    min-height: $ds-size-0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

.console-style-picker-row {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-style-picker-row-highlighted {
    border: tall $ds-action-focus;
    background: $ds-input-focus-bg;
    text-style: bold;
}

#console-style-picker-empty {
    height: auto;
    margin: $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

#console-style-picker-detail {
    height: auto;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-muted;
}

#console-prompts-modal {
    width: $ds-percent-90;
    max-width: $ds-size-104;
    height: $ds-percent-90;
    max-height: $ds-size-44;
    min-width: $ds-size-40;
    min-height: $ds-size-18;
    border: tall $ds-grid-line;
    background: $ds-surface-panel;
    padding: $ds-space-1 $ds-space-2;
}

#console-prompts-header {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-2;
    border-bottom: solid $ds-grid-line;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#console-prompts-title {
    height: $ds-size-1;
    color: $ds-text-primary;
    text-style: bold;
}

#console-prompts-location,
#console-prompts-model-status,
#console-prompts-browse-status {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
}

#console-prompts-body,
#console-prompts-browse {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

/* The editor follows a host status row inside a bounded Vertical. Use the
   remaining fraction instead of its standalone 100% height so its actions
   stay above the modal footer. */
#console-prompts-editor {
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

.console-prompts-primary-action {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    border: none;
    background: $ds-action-focus;
    color: $ds-text-primary;
    text-style: bold;
}

.console-prompts-primary-action:focus,
#console-prompts-modal Button:focus {
    outline: heavy $ds-active-fg;
}

.console-prompts-primary-action:disabled,
#console-prompts-modal Button:disabled {
    background: $surface-darken-1;
    color: $ds-text-disabled;
}

#console-prompts-browse-controls {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

#console-prompts-source {
    width: $ds-size-22;
    min-width: $ds-size-18;
    height: $ds-size-3;
    border: none;
    border-left: solid $ds-grid-line;
    background: $surface-darken-1;
}

#console-prompts-search {
    width: $ds-width-fill;
    min-width: $ds-size-12;
    height: $ds-size-3;
    border: none;
    border-left: solid $ds-grid-line;
    background: $surface-darken-1;
}

#console-prompts-source:focus,
#console-prompts-search:focus {
    border-left: thick $ds-active-fg;
    background: $ds-focus-bg;
    text-style: bold;
}

#console-prompts-retry {
    width: auto;
    min-width: $ds-size-8;
    height: $ds-size-3;
    border: none;
    background: $ds-surface-raised;
}

#console-prompts-results {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-4;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    border-top: solid $ds-grid-line;
    border-bottom: solid $ds-grid-line;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

#console-prompts-result-list {
    width: $ds-width-full;
    height: auto;
}

.console-prompts-result {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-3;
    border: none;
    border-bottom: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-align: left;
    content-align: left middle;
}

.console-prompts-result:hover,
.console-prompts-result:focus {
    background: $ds-focus-bg;
}

#console-prompts-pagination,
#console-prompts-footer {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    align: right middle;
}

#console-prompts-page {
    width: $ds-width-fill;
    min-width: $ds-size-12;
    height: $ds-size-3;
    content-align: center middle;
    color: $ds-text-muted;
}

#console-prompts-pagination Button,
#console-prompts-footer Button,
#console-prompts-improve-mode Button,
#console-prompts-convert {
    width: auto;
    min-width: $ds-size-8;
    height: $ds-size-3;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-prompts-footer {
    border-top: solid $ds-grid-line;
}

#console-prompts-dirty-guard {
    display: none;
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-1;
    border: round $ds-status-warning;
    background: $ds-status-warning 10%;
    color: $ds-text-primary;
}

#console-prompts-dirty-guard.visible {
    display: block;
}

#console-prompts-compatibility {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-2;
    color: $ds-status-warning;
}

#console-prompts-compat-system,
#console-prompts-compat-user {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-3;
    border: round $ds-grid-line;
    background: $surface-darken-1;
}

#console-prompts-improve-mode,
#console-prompts-recipe-mode {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

#console-prompts-improve-mode Button,
#console-prompts-recipe-mode Button {
    width: $ds-width-full;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

#console-prompts-recipe-outcome-description,
#console-prompts-recipe-saved-description,
#console-prompts-recipe-blank-description {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
}

#console-prompts-recipe-save-confirmation-panel {
    display: none;
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-0 $ds-space-1 $ds-space-1 $ds-space-1;
    border: round $ds-status-ready;
    background: $ds-status-ready 8%;
}

#console-prompts-recipe-save-confirmation {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-primary;
}

#console-prompts-open-saved-recipe {
    width: $ds-width-full;
    height: $ds-size-3;
}

ConsolePromptsModal.-narrow #console-prompts-modal {
    width: $ds-percent-96;
    height: $ds-percent-96;
    padding: $ds-space-0 $ds-space-1;
}

ConsolePromptsModal.-narrow #console-prompts-browse-controls {
    layout: vertical;
    height: $ds-size-6;
    min-height: $ds-size-6;
}

ConsolePromptsModal.-narrow #console-prompts-source,
ConsolePromptsModal.-narrow #console-prompts-search {
    width: $ds-width-full;
}

/* Chat choices reuse the Workbench shell and dense, keyboard-reachable rows. */
ConsolePromptMixinsView {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}
ConsolePromptMixinsView Static { height: auto; }
#console-mixins-scroll { height: $ds-height-fill; min-height: $ds-size-0; }
.console-mixin-row { height: auto; margin-bottom: $ds-space-stack; }
.console-mixins-actions { height: auto; min-height: $ds-control-height-compact; }
.console-mixins-actions Button { min-width: $ds-size-0; width: auto; height: $ds-control-height-compact; min-height: $ds-control-height-compact; }
ConsolePromptMixinsView .section-title { text-align: left; margin: $ds-space-stack $ds-space-0 $ds-space-0 $ds-space-0; }
.console-mixin-row Checkbox { height: $ds-control-height-compact; min-height: $ds-control-height-compact; border: none; padding: $ds-space-0; }
#console-mixins-library { width: $ds-height-fill; }
#console-mixins-status { color: $ds-status-warning; }
ConsolePromptsModal.-narrow .console-mixins-actions { layout: grid; grid-size: 2; grid-columns: 1fr 1fr; grid-rows: auto; }
ConsolePromptsModal.-narrow .console-mixins-actions Button { width: $ds-width-full; }
