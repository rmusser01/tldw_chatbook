/* ========================================
 * FEATURES: Writing
 * ========================================
 * The legacy `.window` class forces `layout: horizontal` (see
 * layout/_windows.tcss); WritingWindow has no DEFAULT_CSS of its own, so
 * its status line and three-panel layout ended up side-by-side, jammed
 * onto one row. Outrank it by id (same pattern as #logs-window, UX-046).
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


#writing-window {
    layout: vertical;
}

#writing-status {
    height: auto;
    width: $ds-width-full;
}

#writing-layout {
    height: $ds-height-fill;
    width: $ds-width-full;
}
