/* Inspector requires 28 cells for section selection and 60 for readable detail.
   Below 90 cells the same widgets become list/detail with a Back control.
   ADR-161: fills/zeros/caps are tokens ($ds-*-fill/-size-0/-size-2). */
ConsoleInspectorDetailPane { height: $ds-height-fill; min-height: $ds-size-0; }
.inspector-detail-body { height: $ds-height-fill; min-height: $ds-size-0; }
.inspector-section-list { width: $ds-inspector-section-width; min-width: $ds-size-0; height: $ds-height-fill; border: none; }
/* TASK-33621.9: the global `*:focus` outline overpainted these lists' first
   and last rows, so Turn 1 looked scrolled away. Focus is the content-safe
   tint plus focus-coloured highlight (TASK-28226's cue). */
.inspector-section-list:focus { outline: none; background: $ds-action-focus $ds-focus-list-tint; }
.inspector-section-list:focus > .option-list--option-highlighted { background: $ds-focus-bg; color: $ds-focus-fg; text-style: bold underline; }
.inspector-detail-reader { width: $ds-width-fill; min-width: $ds-size-0; height: $ds-height-fill; }
.inspector-detail-title { height: $ds-control-height-compact; text-style: $ds-text-strong; text-wrap: nowrap; text-overflow: ellipsis; }
.inspector-detail-text { height: $ds-height-fill; min-height: $ds-size-0; border: solid $ds-grid-line; }
.inspector-detail-back { height: $ds-control-height-compact; min-height: $ds-control-height-compact; border: none; padding: $ds-space-0 $ds-space-inline; }
.inspector-detail-narrow .inspector-section-list { width: $ds-width-fill; }

/* The modal owns chrome; only the list, reader, and recovery panel scroll. */
ConsoleConversationInspector #console-inspector-modal {
    width: $ds-inspector-modal-width;
    height: $ds-inspector-modal-height;
    max-width: $ds-width-full;
    max-height: $ds-height-full;
    border: solid $ds-grid-line;
    padding: $ds-space-0 $ds-space-inline;
}
ConsoleConversationInspector #console-inspector-header { height: $ds-control-height-compact; text-style: $ds-text-strong; text-wrap: nowrap; text-overflow: ellipsis; }
ConsoleConversationInspector #console-inspector-tabs { margin-top: $ds-space-0; min-height: $ds-size-0; }
ConsoleConversationInspector TabPane { padding: $ds-space-0; }
ConsoleConversationInspector #console-inspector-next-send-pane { min-height: $ds-size-0; }
ConsoleConversationInspector #console-inspector-next-send-header { color: $ds-text-muted; }
ConsoleConversationInspector #console-inspector-next-send-warning { color: $ds-status-warning; }
ConsoleConversationInspector #console-inspector-project-recovery { height: auto; max-height: $ds-inspector-recovery-max-height; }
ConsoleConversationInspector #console-inspector-actions,
ConsoleConversationInspector #console-inspector-next-send-actions { height: $ds-control-height-compact; margin: $ds-space-0; }
.inspector-modal-control { height: $ds-control-height-compact; min-height: $ds-control-height-compact; border: none; padding: $ds-space-0 $ds-space-inline; min-width: $ds-size-0; }
ConsoleConversationInspector #console-inspector-costs-totals { margin: $ds-space-0; }
ConsoleConversationInspector #console-inspector-exchange-caveat { margin: $ds-space-0; max-height: $ds-size-2; color: $ds-text-muted; }
ConsoleConversationInspector .inspector-view-note { height: auto; color: $ds-text-muted; }
ConsoleConversationInspector #console-inspector-tabs,
ConsoleConversationInspector #console-inspector-tabs > ContentSwitcher,
ConsoleConversationInspector #console-inspector-tabs > ContentSwitcher > TabPane {
    height: $ds-height-fill;
    min-height: $ds-size-0;
}
/* TASK-33621.9: a wrapped usage row left its basis label alone above the
   next turn, so usage rows stay on one line (basis and cost lead). Only
   here: Context and Exchange labels wrap, or their counts and call details
   would be cut off. */
.inspector-usage-detail .inspector-section-list {
    width: $ds-inspector-usage-list-width;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
ConsoleConversationInspector #console-inspector-tabs > ContentTabs {
    height: $ds-control-height-compact;
}

.inspector-usage-detail.inspector-detail-narrow .inspector-section-list { width: $ds-width-fill; }
