/* ========================================
 * FEATURES: Notes
 * ======================================== 
 * Notes tab specific styles
 * ======================================== */

/* --- Notes Tab Window ---
 * T169: #notes-main-content, .notes-editor, and #notes-controls-area
 * pruned -- pre-workbench legacy Notes tab CSS (Notes_Window.py, since
 * removed; the standalone Notes tab was replaced by the Library
 * workbench's Notes canvas) with zero live references anywhere in
 * tldw_chatbook/*.py.
 */

/* T169: .auto-save-label pruned -- zero live references (same
 * pre-workbench legacy Notes tab as above). */

/* --- End of Notes Tab Window --- */

/* Structured source controls retain editor focus and independent save status. */
DocumentDiagnostics {
    height: auto;
    color: $ds-text-primary;
}
DocumentDiagnostics .document-actions {
    height: $ds-control-height-compact;
    width: $ds-width-fill;
}
DocumentDiagnostics .document-language {
    width: $ds-document-language-width;
    height: $ds-control-height-compact;
}
DocumentDiagnostics Button {
    width: auto;
    min-width: $ds-document-button-min-width;
    height: $ds-control-height-compact;
    margin: $ds-space-0 $ds-space-inline;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    border: none;
}
DocumentDiagnostics Button:hover { background: $ds-hover-bg; color: $ds-hover-fg; }
DocumentDiagnostics Button:focus { background: $ds-focus-bg; color: $ds-focus-fg; text-style: bold underline; }
DocumentDiagnostics Button:disabled { background: $ds-disabled-bg; color: $ds-text-disabled-readable; opacity: $ds-opacity-full; }
DocumentDiagnostics .document-language-scope { height: $ds-control-height-compact; color: $ds-text-muted; }
DocumentDiagnostics .document-check-status { height: auto; color: $ds-status-info; }
DocumentDiagnostics .document-problems { height: auto; padding: $ds-space-0; margin: $ds-space-0; margin-bottom: $ds-space-0; border: none; }
DocumentDiagnostics CollapsibleTitle { padding: $ds-space-0; }
DocumentDiagnostics Contents { padding: $ds-space-0; }
DocumentDiagnostics .document-problem-list { height: auto; max-height: $ds-document-problems-height; }
DocumentDiagnostics .document-truncation { height: auto; color: $ds-status-warning; }
#library-note-source-preview { height: auto; }

DocumentDiagnostics .document-problems.-collapsed { height: $ds-control-height-compact; min-height: $ds-control-height-compact; margin-bottom: $ds-space-0; }

#library-note-exact-source-region { height: $ds-height-fill; border: solid $ds-grid-line; padding: $ds-space-1; }

/* The compact pane can leave two rows: borders must not consume its text. */
#library-shell-grid.library-notes-compact #library-note-body {
    border: none;
    padding: $ds-space-0 $ds-space-inline;
}
#library-shell-grid.library-notes-compact #library-note-body:focus {
    outline: none;
    background: $ds-input-focus-bg;
}
