/* ========================================
 * FEATURES: Unified Evaluation Dashboard
 * ======================================== 
 * Single-page responsive design with collapsibles
 * Based on original UX design specifications
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */



.dashboard-title {
    text-style: bold;
    color: $primary;
    margin-bottom: $ds-space-1;
}

.quick-actions {
    layout: horizontal;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

/* Drop zone styling */
.drop-zone {
    layout: horizontal;
    height: $ds-size-3;
    background: $panel;
    border: dashed $primary;
    padding: $ds-space-0 $ds-space-2;
    align: center middle;
    margin: $ds-space-1 $ds-space-0;
}

.drop-zone:hover {
    background: $boost;
    border: solid $primary;
}


/* --- Main Content Area --- */
.main-content {
    padding: $ds-space-1;
}

/* Ensure VerticalScroll works properly inside the evals dashboard.
   This selector MUST stay scoped: a bare `VerticalScroll` rule applies
   app-wide and (because stylesheet rules always outrank widget DEFAULT_CSS
   in Textual, regardless of specificity) silently overrides every widget's
   own `height: 1fr` sizing, pushing follow-on siblings off-screen. */

/* Make sure the entire window uses available height */
EvalsWindow {
    height: $ds-height-full;
}

/* --- Collapsible Sections --- */
Collapsible {
    margin-bottom: $ds-space-1;
    border: tall $surface;
    background: $panel;
}

Collapsible > Container {
    padding: $ds-space-1;
}

Collapsible.-collapsed {
    margin-bottom: $ds-space-1;
}

/* Note: Textual doesn't support @media queries
   Use reactive attributes or resize events for responsive design */

/* Template Grid */
.template-grid {
    layout: grid;
    grid-columns: 1fr 1fr;
    grid-gutter: 1;
    margin-top: $ds-space-1;
}

.template-card {
    height: $ds-size-5;
    padding: $ds-space-1;
    background: $surface;
    border: tall $primary;
    text-align: center;
}

.template-card:hover {
    background: $boost;
    border: thick $primary;
}

/* Action Bar */
.action-bar {
    layout: horizontal;
    background: $surface;
    padding: $ds-space-1;
    margin: $ds-space-2 $ds-space-0;
    border: tall $primary;
    align: center middle;
}

/* Results Dashboard */
.results-header {
    layout: horizontal;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
    align: left middle;
}

.results-header Static {
    width: $ds-width-fill;
}

.results-header Select {
    width: $ds-size-20;
}

.results-list {
    height: $ds-size-15;
    background: $surface;
    border: tall $secondary;
    margin-bottom: $ds-space-2;
}

.stat-card {
    background: $surface;
    padding: $ds-space-1;
    border: tall $secondary;
    text-align: center;
}

.stat-value {
    text-style: bold;
    color: $primary;
}

.button-row {
    layout: horizontal;
    margin-bottom: $ds-space-1;
}

.button-row Button {
    margin-right: $ds-space-1;
}

/* Status Bar */
.status-bar {
    height: $ds-size-3;
    background: $surface;
    border-top: solid $primary;
    padding: $ds-space-0 $ds-space-2;
    layout: horizontal;
    align: left middle;
}

.status-text {
    width: $ds-width-fill;
}

/* Responsive Adjustments - handled in Python code via resize events */
/* For narrow screens, switch grids to single column */

/* Utility Classes */
.hidden {
    display: none;
}

.help-text {
    color: $text-muted;
    text-style: italic;
}

/* Disabled States */
Button:disabled {
    opacity: 0.5;
}

/* Loading States */
.loading {
    opacity: 0.6;
}

/* Error States */
.error {
    border: tall $error;
    background: $error 10%;
}
