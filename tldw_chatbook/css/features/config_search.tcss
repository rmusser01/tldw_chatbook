/* config_search.tcss */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */

/* Styling for configuration file search functionality */

/* Search container */
.config-search-container {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    padding: $ds-space-1;
    background: $panel;
    border: solid $primary;
}

/* Search input */
.config-search-input {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

/* Search results collapsible */
.config-search-results {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

.config-search-results Collapsible > Contents {
    max-height: $ds-size-20;
    overflow-y: auto;
}

/* Results list */
.config-results-list {
    width: $ds-width-full;
    height: auto;
    max-height: $ds-size-20;
    background: $surface;
}

/* Individual search result item */
.config-search-result-item {
    width: $ds-width-full;
    padding: $ds-space-1;
    margin-bottom: $ds-space-0;
}

.config-search-result-item:hover {
    background: $boost;
}

/* Result info section */
.result-info {
    width: $ds-width-fill;
    padding-right: $ds-space-1;
}

.result-path {
    text-style: bold;
    color: $primary;
}

.result-value {
    color: $text;
    margin-top: $ds-space-0;
}

.result-context {
    color: $text-muted;
    text-style: italic;
    margin-top: $ds-space-0;
}

/* Result action buttons */
.result-actions {
    dock: right;
    width: auto;
    height: $ds-size-3;
    align: center middle;
}

.result-goto-btn {
    margin-right: $ds-space-1;
    min-width: $ds-size-8;
}

.result-edit-btn {
    min-width: $ds-size-8;
}

/* Highlight matches in search results */
ConfigSearchResult.-highlight {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

/* Ensure the config editor has proper spacing when search is shown */
#config-text-area {
    height: $ds-height-fill;
    min-height: $ds-size-20;
}

/* Highlight effect for found UI elements */
.search-highlight {
    background: $warning 30%;
    border: solid $warning;
    border-bottom: solid $warning;
}

Input.search-highlight:focus,
TextArea.search-highlight:focus {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    outline: none;
}

Select.search-highlight {
    background: $warning 30%;
}

Checkbox.search-highlight {
    color: $warning;
}

TextArea.search-highlight {
    border: solid $warning;
    border-bottom: solid $warning;
}
