/* _chatbooks.tcss */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */

/* Styles for the Chatbooks window */

/* Main window */
ChatbooksWindow {
    background: $background;
}

/* Main horizontal layout */
#main-layout {
    layout: horizontal;
    height: $ds-height-full;
}

/* Left sidebar */
#chatbooks-sidebar {
    width: $ds-size-30;
    background: $panel;
    border-right: solid $background-darken-1;
    padding: $ds-space-1;
    layout: vertical;
}

.sidebar-title {
    text-style: bold;
    color: $primary;
    margin-bottom: $ds-space-1;
    text-align: center;
}

#chatbooks-list {
    height: $ds-height-fill;
    background: $boost;
    border: round $background-darken-1;
}

#chatbooks-list ListItem {
    padding: $ds-space-0 $ds-space-1;
    height: $ds-size-3;
}

#chatbooks-list ListItem:hover {
    background: $surface-lighten-1;
    color: $text;
}

#chatbooks-list ListItem.-highlight {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

/* Right content area */
#content-area {
    width: $ds-width-fill;
    layout: vertical;
    padding: $ds-space-1;
}

/* Header section */
#chatbooks-header {
    background: $boost;
    border: round $background-darken-1;
    padding: $ds-space-2;
    margin-bottom: $ds-space-1;
}

.header-title {
    text-style: bold;
    text-align: center;
    color: $primary;
    margin-bottom: $ds-space-1;
}

.header-subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: $ds-space-2;
}

#action-buttons {
    layout: horizontal;
    align: center middle;
    height: $ds-size-3;
}

#action-buttons Button {
    margin: $ds-space-0 $ds-space-1;
    min-width: $ds-size-20;
}

/* Dynamic content area */
#dynamic-content {
    height: $ds-height-fill;
    background: $boost;
    border: round $background-darken-1;
    padding: $ds-space-2;
    overflow-y: auto;
}

/* Welcome text */
.welcome-text {
    color: $text;
    padding: $ds-space-2;
}

/* Status text */
.status-text {
    color: $text-muted;
    text-align: center;
    padding: $ds-space-2;
}

/* Info text */
.info-text {
    color: $text-muted;
    text-align: center;
    padding: $ds-space-2;
}

/* Chatbook details */
.chatbook-details {
    layout: vertical;
    padding: $ds-space-1;
}

.chatbook-title {
    text-style: bold;
    color: $primary;
    margin-bottom: $ds-space-1;
}

.chatbook-desc {
    color: $text;
    margin-bottom: $ds-space-1;
}

.chatbook-size {
    color: $text-muted;
    margin-bottom: $ds-space-1;
}

.chatbook-date {
    color: $text-muted;
    margin-bottom: $ds-space-2;
}

/* Management buttons */
.management-buttons {
    layout: horizontal;
    height: $ds-size-3;
    margin-top: $ds-space-2;
}

.management-buttons Button {
    margin-right: $ds-space-1;
    min-width: $ds-size-12;
}

/* Error button variant */
Button.error {
    background: $error;
    color: $text;
}

Button.error:hover {
    background: $error-darken-1;
}

/* Template management styles */
.templates-list {
    layout: vertical;
    height: auto;
    max-height: $ds-size-20;
    overflow-y: auto;
    margin: $ds-space-1 $ds-space-0 $ds-space-2 $ds-space-0;
    background: $panel;
    border: round $background-darken-1;
    padding: $ds-space-1;
}

.template-item {
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
    background: $boost;
    border: round $background-darken-1;
}

.template-item:hover {
    background: $primary 10%;
    border: round $primary;
}

.template-name {
    text-style: bold;
    color: $primary;
    margin-bottom: $ds-space-0;
}

.template-description {
    color: $text-muted;
    text-style: italic;
}
