/* ========================================
 * FEATURES: Ingest
 * ======================================== 
 * Media ingestion tab styles
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


/* --- Ingest Content Tab --- */
#ingest-window { /* Matches TAB_INGEST */
    layout: vertical !important; /* Override .window class */
    height: $ds-height-full;
    width: $ds-width-full;
}

/* Override the horizontal layout from .window class */
#ingest-window.window {
    layout: vertical !important;
}
.tldw-api-media-specific-options { /* Common class for specific option blocks */
    padding: $ds-space-1;
    border: round $surface;
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
}

/* Added to ensure initially hidden specific options are indeed hidden */
.tldw-api-media-specific-options.hidden {
     display: none;
}

.ingest-nav-pane { /* Style for the left navigation pane */
    dock: left;
    width: $ds-percent-25;
    min-width: $ds-size-20;
    max-width: $ds-size-40;
    height: $ds-height-full;
    background: $boost; /* Or a slightly different shade */
    padding: $ds-space-1;
    border-right: thick $background-darken-1;
    /* Removed overflow properties - let VerticalScroll handle scrolling */
}

.ingest-nav-pane .ingest-nav-button { /* Style for navigation buttons */
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    border: none;
    height: $ds-size-3;
}
.ingest-nav-pane .ingest-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}
/* Active state for selected ingest nav button */
.ingest-nav-pane .ingest-nav-button.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Collapsible sidebar styles */
.ingest-nav-pane.collapsed {
    width: $ds-size-4;
    min-width: $ds-size-4;
    padding: $ds-space-1 $ds-space-0;
}

.nav-header {
    width: $ds-width-full;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

.nav-toggle-button {
    width: $ds-size-3;
    height: $ds-size-3;
    min-width: $ds-size-3;
    padding: $ds-space-0;
    text-align: center;
}

/* Adjust button appearance when collapsed */
.ingest-nav-pane.collapsed .ingest-nav-button {
    width: $ds-size-3;
    padding: $ds-space-0;
    /* Show only first letter or icon */
    overflow: hidden;
}

/* Style for sidebar section titles */
.ingest-nav-pane .sidebar-title {
    text-style: bold;
    color: $primary;
    margin-top: $ds-space-2;
    margin-bottom: $ds-space-1;
    padding-left: $ds-space-1;
    border-left: thick $accent;
}
/* Active state for selected ingest nav button (optional) */
/* .ingest-nav-pane .ingest-nav-button.-active-view {
    background: $accent-darken-1;
    color: $text;
} */

.ingest-content-pane { /* Style for the right content display area */
    width: $ds-width-fill;
    height: $ds-height-full;
    padding: $ds-space-1 $ds-space-2;
    /* Removed overflow - let child VerticalScroll widgets handle scrolling */
}

.ingest-view-area { /* Common class for individual content areas */
    width: $ds-width-full;
    height: $ds-height-full;
}
.ingest-label {
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-0;
}
.ingest-selected-files-list {
    min-height: $ds-size-5;
    max-height: $ds-size-10;
    height: auto;
    border: round $ds-focus-accent;
    margin-bottom: $ds-space-1;
    background: $surface;
}
.LocalIngestionPanel .file-selection-container {
    height: $ds-height-fill;
    min-height: $ds-size-15;
    border: solid $primary;
    margin-bottom: $ds-space-1;
    padding: $ds-space-1;
}
.ingest-preview-area {
    height: $ds-height-fill;
    min-height: $ds-size-10;
    border: round $primary-lighten-2;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
    background: $surface;
}
.ingest-preview-area > Static#ingest-prompts-preview-placeholder {
    color: $text-muted;
    width: $ds-width-full;
    text-align: center;
    padding: $ds-space-2 $ds-space-0;
}
.ingest-status-area {
    min-height: $ds-size-5;
    max-height: $ds-size-15;
    height: auto;
    margin-top: $ds-space-1;
}

.prompt-preview-item {
    border: panel $background-lighten-2;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
}
.prompt-preview-item .prompt-title {
    text-style: bold;
}
.prompt-preview-item .prompt-field-label {
    text-style: italic;
    color: $text-muted;
}
.prompt-preview-item Markdown {
    background: $surface-darken-1;
    padding: $ds-space-0 $ds-space-1;
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
    border: solid $primary-darken-1; /* Use 'solid' instead of 'narrow' */
    max-height: $ds-size-10;
    overflow-y: auto;
}
.prompt-preview-item .prompt-details-text {
    max-height: $ds-size-5;
    overflow-y: auto;
    background: $surface;
    padding: $ds-space-0 $ds-space-1;
    border: dashed $primary-darken-2; /* Use 'dashed' instead of 'dotted' */
    margin-bottom: $ds-space-1;
}

/* Ensure VerticalScroll containers fill their parent */
.ingest-view-area VerticalScroll {
    height: $ds-height-fill;
    width: $ds-width-full;
}

/* Ensure VerticalScroll containers fill available space */
VerticalScroll.ingest-view-area {
    height: $ds-height-fill;
    width: $ds-width-full;
}

VerticalScroll.ingest-form-scrollable {
    height: $ds-height-fill;
    width: $ds-width-full;
}

/* Scrollable form container needs padding to prevent content cutoff */
.ingest-form-scrollable {
    height: $ds-height-full;
    overflow-y: auto;
    padding: $ds-space-1;
}

/* Removed .ingest-media-tab-content - no longer needed since parent is VerticalScroll */




.ingest-form-row {
    margin-top: $ds-space-1;
}

.ingest-form-col {
    width: $ds-percent-50;
    padding-right: $ds-space-1;
}

.title-author-row {
    margin-bottom: $ds-space-1;
}

/* Ensure title/author input boxes are visible */
.title-author-row Input {
    height: $ds-size-3;
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

.ingest-textarea-small {
    min-height: $ds-size-3;
    max-height: $ds-size-8;
    height: auto;
    margin-bottom: $ds-space-1;
}

.ingest-textarea-medium {
    min-height: $ds-size-10;
    max-height: $ds-size-20;
    height: auto;
    margin-bottom: $ds-space-1;
}


/* All ingest views are controlled programmatically */
.ingest-view-area {
    /* display controlled by app.py watcher */
    height: $ds-height-full;
    width: $ds-width-full;
}

/* --- Visibility styles for ingest views --- */
/* Views are controlled programmatically via styles.display */


/* Ensure the IngestWindowTabbed container fills available space */
IngestWindowTabbed {
    height: $ds-height-fill;
    width: $ds-width-full;
    layout: vertical;
}

/* Ensure TabbedContent in ingest window displays properly */
#ingest-window TabbedContent {
    height: $ds-height-fill;  /* Use fr unit for flexible sizing */
    width: $ds-width-full;
}

.media-tab-container {
    height: $ds-height-fill;  /* Use fr unit instead of 100% */
    padding: $ds-space-1;
}

.source-toggle-container {
    dock: top;
    height: auto;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
    border-bottom: solid $primary;
}

.tab-title {
    text-style: bold;

    margin-bottom: $ds-space-1;
}

.source-toggle {
    layout: horizontal;
    height: auto;
    margin-top: $ds-space-1;
}

.source-toggle RadioButton {
    margin-right: $ds-space-2;
}

.source-content {
    height: $ds-height-fill;
    width: $ds-width-full;
    overflow-y: auto;
}

/* Ensure content areas within tabs fill space */
.ingest-form-scrollable {
    height: $ds-height-fill;
    width: $ds-width-full;
}




.source-content.hidden {
    display: none;
}

/* Compact file lists for better space usage */
.ingest-selected-files-list {
    min-height: $ds-size-3;
    max-height: $ds-size-8;
    height: auto;
    border: round $ds-focus-accent;
    margin-bottom: $ds-space-1;
    background: $surface;
}

/* Status section at top of forms */
.status-dashboard {
    width: $ds-width-full;
    height: auto;
    max-height: $ds-size-8;      /* Prevent status from taking too much space */
    min-height: $ds-size-3;
    background: $surface;
    border: round $primary;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
}

/* Mode-specific visibility controls */
.simple-mode .advanced-only {
    display: none !important;
}

.advanced-mode .advanced-only {
    display: block !important;
}

/* URL input always visible */
.url-input-section {
    display: block;
    margin-top: $ds-space-1;
    padding: $ds-space-1;
    border: round $primary;
    background: $surface;
}

/* Simplified form sections */
.essential-fields {
    border: round $accent;
    padding: $ds-space-1;
    margin-bottom: $ds-space-2;
    background: $surface-lighten-1;
}

/* Placeholder text */
.placeholder-text {
    color: $text-muted;
    text-align: center;
    padding: $ds-size-4;
}

/* Mode toggle styles */
.mode-toggle-container {
    dock: top;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
}

.mode-toggle {
    layout: horizontal;
    height: auto;
}

.mode-toggle RadioButton {
    margin-right: $ds-space-2;
}

/* File selection row */
.file-selection-row {
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

.file-selection-row Button {
    margin-right: $ds-space-1;
}

/* Enhanced file list with metadata */
.file-list-with-metadata {
    min-height: $ds-size-5;
    max-height: $ds-size-10;
    border: round $primary;
    background: $surface;
}

/* Metadata row */
.metadata-row {
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
}

.metadata-col {
    width: $ds-percent-50;
    padding-right: $ds-space-1;
}

/* Process button */
.process-button {
    width: $ds-width-full;
    height: $ds-size-4;
    margin-top: $ds-space-2;
    text-style: bold;
}

/* Advanced options container */
.advanced-options-container {
    margin-top: $ds-space-1;
}

.advanced-options-container.hidden {
    display: none;
}

/* Time range row */
.time-range-row {
    margin-top: $ds-space-1;
}

.time-col {
    width: $ds-percent-50;
    padding-right: $ds-space-1;
}

/* Chunk settings row */
.chunk-settings-row {
    margin-top: $ds-space-1;
}

.chunk-col {
    width: $ds-percent-50;
    padding-right: $ds-space-1;
}

/* Status Dashboard Styles */
.status-dashboard-container {
    border: round $primary;
    background: $surface;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
}

.status-main-row {
    height: $ds-size-3;
    align: left middle;
}

.status-message {
    width: $ds-width-fill;
    text-style: bold;
}

.file-counter {
    width: auto;
    margin-left: $ds-space-2;
    color: $text-muted;
}

.time-display {
    width: auto;
    margin-left: $ds-space-2;
    color: $text-muted;
}

.action-buttons {
    width: auto;
    dock: right;
    layout: horizontal;
}

.action-buttons.hidden {
    display: none;
}

.small-button {
    height: $ds-size-3;
    min-width: $ds-size-8;
    margin-left: $ds-space-1;
}

.small-button.hidden {
    display: none;
}

/* Progress bar in dashboard */
.status-dashboard-container ProgressBar {
    margin-top: $ds-space-1;
    height: $ds-size-1;
}

.status-dashboard-container ProgressBar.hidden {
    display: none;
}

/* Alert container */
.alert-container {
    margin-top: $ds-space-1;
    padding: $ds-space-1;
    border: round $error;
    background: $error 10%;
}

.alert-container.hidden {
    display: none;
}

.alert-messages {
    color: $text;
    max-height: $ds-size-6;
    overflow-y: auto;
}

/* Enhanced File List Styles */
.file-list-enhanced {
    border: round $primary;
    background: $surface;
    padding: $ds-space-0;
}

.file-items-container {
    max-height: $ds-size-10;
    overflow-y: auto;
    padding: $ds-space-1;
}



.file-info-main {
    width: $ds-width-fill;
}

.file-name-row {
    height: auto;
    margin-bottom: $ds-space-0;
}

.file-icon {
    width: $ds-size-3;
    text-align: center;
}

.file-name {
    width: $ds-width-fill;
    text-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
}

.file-metadata {
    color: $text-muted;

    margin-left: $ds-space-3;
}

.file-remove-button {
    width: $ds-size-3;
    height: $ds-size-3;
    min-width: $ds-size-3;
    margin: $ds-space-0;
    padding: $ds-space-0;
    text-align: center;
}

.no-files-message {
    text-align: center;
    color: $text-muted;
    padding: $ds-space-3;
}

.file-list-summary {
    dock: bottom;
    height: $ds-size-3;
    padding: $ds-space-1;
    border-top: solid $primary;
    background: $surface-darken-1;
    text-align: center;
    color: $text-muted;
}

/* --- END OF INTEGRATED NEW CSS --- */
