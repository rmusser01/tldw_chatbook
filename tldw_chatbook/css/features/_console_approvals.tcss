/* task-32287: the card's body and its action bar hug their content too.
   Both were unstyled -- `#approval-batch-body` is a Container and
   `#approval-batch-actions` a Horizontal, so both defaulted to `height:
   1fr` and expanded to fill the card, which (despite `.ds-approval-card`'s
   own `height: auto`) therefore took whatever its parent offered: a
   ONE-row batch measured 46 lines in a 50-row harness, with the ten-plus
   blank rows between the action bar and the bottom border the 2026-09-10
   live pass reported. */
#approval-batch-body,
#approval-batch-actions {
  height: auto;
}

/* The Console MCP batch-approval card's per-row layout
   (`ChatApprovalCard.set_batch()`, chat_approval_card.py -- T5 deferred
   this CSS to T9's phase gate). This card carries no `DEFAULT_CSS` of its
   own at all (unlike the MCP mode widgets above) -- these rules are the
   ONLY styling `.approval-row*` has anywhere, bundle or otherwise.

   `.approval-row` is a Horizontal, which defaults to `height: 1fr` --
   live-repro'd ballooning to the full card height (and its decision
   Select claiming the full ROW width in turn) before this fix, the same
   fr-inside-flex bug class as the MCP lockstep rules above. `height:
   auto` makes each row hug its own single line of content instead.

   `#approval-batch-rows` (the Vertical wrapping all rows) gets the same
   `height: auto` treatment as #mcp-perm-preview/#mcp-detail-builtin-
   toggles/#mcp-import-list above -- without it, its own `height: 1fr`
   default would balloon it to fill the card and push the sibling
   Approve-all/Submit/Deny-all action bar (#approval-batch-actions) far
   below the visible rows.

   `.approval-row-header`/`.approval-row-args` (Statics, natively `width:
   auto`) get an explicit `1fr` share each so unbounded text (a long
   tool/server header, or an args summary up to 80 chars) can't hog the
   row and squeeze the decision Select out of view. `.approval-row-
   decision` (the class selector on the row's Select) gets an explicit
   fixed width -- it was written to beat the bare `Select { width: 100%; }`
   type selector (retired in TASK-33003.1) that made the Select claim the
   row's FULL width, overlapping/clipping behind the header and args text
   laid out before it; it now pins the bounded share outright. */
#approval-batch-rows {
  height: auto;
  min-height: $ds-size-0;
    /* TASK-1846: bound the rows so the action bar below them is reachable
       at ANY row count. The card is `height: auto` inside a plain Container
       (`ChatTaskCards`), so before this a long batch simply grew past the
       viewport and took Submit/Approve-all/Deny-all with it -- measured on
       an 80x24 terminal, five rows already pushed Submit to y=24. Splitting
       arguments onto their own line costs a line per row and would have
       moved that cliff from five rows to four, so the cap fixes the older
       bug rather than inheriting it. 15 leaves room for the header, the
       deadline and the action bar at 24 rows; taller batches scroll. */
  max-height: $ds-size-15;
  overflow-y: auto;
}
/* TASK-1846 AC#2: `.approval-row` is now a Vertical -- header, arguments,
   and `.approval-row-controls` each on their own FULL width line (plus, since
   task-32278, the reason and scope lines below).
   Before the split all four shared one Horizontal, and the
   controls' 27 + 14 + 14 = 55 fixed cells left the arguments 10 cells at 80
   columns: `{"path":"~/` of `{"path":"~/notes/secrets.md"}`. Since
   TASK-1861 the card offers one decision per TARGET, so that clipped text
   was the decision.

   Keeping the header BESIDE the controls was tried and is wrong: in the
   Console's ~52-cell chat pane those 54 fixed cells starve the header to
   one cell, which wraps to nine lines and pushes the arguments out of the
   card -- caught only by looking at a real terminal.

   The controls row is a Horizontal and needs the SAME `height: auto` as
   the row itself -- a Horizontal defaults to `height: 1fr`, the
   fr-inside-flex bug this block already documents, and left at the default
   it balloons to the card height and takes the args line off screen. */
.approval-row, .approval-row-controls {height:auto;min-height:$ds-size-1;width:$ds-width-fill;}
.approval-row-header,.approval-row-args{width:$ds-width-fill;}
.approval-row-full-command{width:$ds-width-fill;height:$ds-size-6;min-height:$ds-size-3;}
/* task-32278: the row's reason line (why this is asking -- the visible
   replacement for the old header tooltip) and its scope line (what the
   selected decision commits to, and where to undo it). Both carry full
   sentences, so they get the same explicit `1fr` share as the header and
   args lines above rather than a `width: auto` that overflows the row. */
.approval-row-reason,.approval-row-scope,.approval-row-raw-label,.approval-row-raw-metadata,.approval-row-raw-warning,.approval-row-raw-scope{width:$ds-width-fill;height:auto;}
/* task-32278: the label area is this width MINUS 8 cells of Textual chrome
   (`SelectCurrent`: `border: tall` 1+1, `padding: 0 2` 2+2, `.arrow`
   `width: 1` with `padding: 0 0 0 1`). The closed Select does not
   ellipsize -- `SelectCurrent` is `height: auto` and its `Static#label`
   wraps -- so a label one cell over grows the control instead of clipping:
   "Always allow this exact input" measured FOUR lines tall at width 26.
   The labels are short now (longest: "Always · these args", 19); 27 is
   19 + 8, and `Tests/UI/test_chat_approval_card.py` reads this number back
   out of this file so the two cannot drift apart again. */
.approval-row-decision{width:$ds-approval-decision-width;}
/* Fleet-UX expert review F5 (task-1234): single-row cards additionally
   mount two compact fast-path buttons after the decision Select --
   "Approve once"/"Deny" submit immediately, bypassing Select+Submit for
   the two most common decisions (`ChatApprovalCard.set_batch`'s
   `single_row` gate; never rendered for a multi-row batch). `compact`
   already keeps these borderless/1-row tall; fixed widths keep them from
   claiming `Button`'s `width: auto` share and squeezing the row. */
.approval-row-fast-approve,.approval-row-fast-deny{width:$ds-size-14;min-width:$ds-size-14;}
/* TASK-33625.2: compact grids keep every decision reachable with Inspect open. */
.approval-compact {
  padding: $ds-space-0 $ds-space-2;
}
.approval-compact #approval-batch-rows {
  max-height: $ds-approval-compact-body-height;
}
.approval-compact .approval-row-controls {
  layout: grid;
  grid-size: $ds-size-2;
  grid-columns: $ds-width-fill $ds-width-fill;
}
.approval-compact #approval-batch-actions {
  layout: grid;
  grid-size: $ds-size-3;
  grid-columns: $ds-width-fill $ds-width-fill $ds-width-fill;
}
.approval-compact .approval-row-decision {
  column-span: $ds-size-2;
  width: $ds-width-fill;
}
/* ID subjects preserve specificity without indexing this rule under every Button. */
.approval-compact Button#approval-more-options-batch,
.approval-compact Button#approval-approve-all,
.approval-compact Button#approval-submit,
.approval-compact Button#approval-deny-all {
  width: $ds-width-fill;
  min-width: $ds-size-0;
  padding: $ds-space-0;
}

/* task-5 (Phase-5 follow-up): a bulk "Approve all"/"Deny all" press can't
   legally reach every narrowed row (`ChatApprovalCard._set_all_batch_
   decisions` -- a row whose `options` exclude every bulk candidate is left
   on its current value instead of crashing). Left unstyled, that row looks
   identical to one nobody has decided on yet. `.needs-decision` (added by
   that same skip path, cleared by the row's own `Select.Changed`) gives it
   the same warning treatment as `.library-rag-callout.is-blocked` above:
   border + a light background tint, using the semantic
   `$ds-status-approval-required` token rather than the generic `$ds-
   status-warning` one, since this state literally IS "still needs an
   approval decision." */
.approval-row.needs-decision {
  border: solid $ds-status-approval-required;
  background: $ds-status-approval-required 10%;
}


.approval-single #approval-approve-all, .approval-single #approval-deny-all,
.approval-single #approval-submit, .approval-single #approval-choices-hint {
  display: none;
}
.approval-single.approval-options-open #approval-submit {
  display: block;
}
#approval-request-summary, #approval-choices-hint {
  height: auto;
  width: $ds-width-fill;
}
#approval-request-summary:focus {
  background: $ds-focus-bg;
}
.approval-more-options {
  width: $ds-size-14;
  min-width: $ds-size-14;
}
.approval-compact .approval-row-controls, .approval-compact #approval-batch-actions {
  layout: vertical;
}
.approval-compact .approval-row-controls Button {
  width: $ds-width-fill;
  min-width: $ds-size-0;
}

#approval-single-actions {
  height: auto;
  width: $ds-width-fill;
}
#approval-single-actions Button {
  width: auto;
  min-width: $ds-size-0;
  padding: $ds-space-0;
}
.approval-stacked #approval-single-actions {
  layout: vertical;
}
.approval-stacked #approval-single-actions Button {
  width: $ds-width-fill;
}

#approval-count-scope-summary {
  height: auto;
  width: $ds-width-fill;
}

.approval-single .approval-row-controls {
  display: none;
}
.approval-single.approval-options-open .approval-row-controls {
  display: block;
}

/* Lazy Details stays inside the bounded review body; actions remain outside. */
#approval-details-panel, #approval-details-status, #approval-details-navigation {
  height: auto;
  width: $ds-width-fill;
}
#approval-details-page {
  height: $ds-size-3;
  width: $ds-width-fill;
}
#approval-details-navigation Button, .approval-details-open {
  width: auto;
  min-width: $ds-size-0;
  padding: $ds-space-0;
}

/* Reserve compact batch space for complete consent and pinned actions. */
.approval-compact.approval-batch #approval-batch-rows {
  max-height: $ds-size-4;
}
.approval-compact.approval-batch.approval-options-open #approval-batch-rows {
  max-height: $ds-size-2;
}
