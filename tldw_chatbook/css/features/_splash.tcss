/* Splash Screen Styles */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales + named
   \$ds-splash-progress-cap), transcribed value-identically from the raw
   literals; comments stay load-bearing. */


/* Main splash screen container */
SplashScreen, .splash-screen {
    layer: overlay;
    background: $background;
    width: $ds-width-full;
    height: $ds-height-full;
    align: center middle;
    dock: top;
}

/* Center container for splash content */
#splash-center {
    width: $ds-width-full;
    height: $ds-height-full;
    align: center middle;
}

/* Content container */
#splash-content {
    width: $ds-width-full;
    height: $ds-height-full;
    align: center middle;
    padding: $ds-space-0;
}

/* Main splash display area */
#splash-main, .splash-main {
    width: $ds-width-full;
    height: $ds-height-full;
    content-align: center middle;
    text-align: center;
    margin: $ds-space-0;
}

/* Splash display widget - the actual content display area */
#splash-display, .splash-display {
    width: $ds-width-full;
    height: $ds-height-full;
    content-align: center middle;
    text-align: center;
    align: center middle;
    padding: $ds-space-0;
    margin: $ds-space-0;
}

/* Progress text */
#splash-progress-text, .splash-progress-text {
    width: $ds-width-full;
    text-align: center;
    color: $text-muted;
    margin-bottom: $ds-space-1;
}

/* Progress bar styling */
#splash-progress-bar, .splash-progress-bar {
    width: $ds-percent-80;
    max-width: $ds-splash-progress-cap;
    height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-0;
    align: center middle;
}

#splash-progress-bar Bar {
    color: $success;
}

#splash-progress-bar PercentageStatus {
    text-style: dim;
}

/* Animation-specific styles */

/* Matrix rain effect */
.matrix-rain {
    color: $success;
    text-style: bold;
}

/* Glitch effect */
.glitch-effect {
    color: $text;
    text-style: bold;
}

.glitch-effect-error {
    color: $error;
    text-style: bold;
}

.glitch-effect-warning {
    color: $warning;
    text-style: bold;
}

.glitch-effect-success {
    color: $success;
    text-style: bold;
}

/* Retro terminal effect */
.retro-terminal {
    color: $success;
    background: rgba(0, 0, 0, 0.9);
    text-style: bold;
}

.retro-scanline {
    background: rgba(0, 255, 0, 0.1);
}

/* Fade effect styles */
.fade-in {
    opacity: 0.0;
}


/* Loading placeholder for lazy-loaded content */
.loading-placeholder {
    color: $text-muted;
    text-align: center;
    padding: $ds-size-4;
}

/* Hide splash screen when not active */
SplashScreen.hidden {
    display: none;
}