/* ========================================
 * FEATURES: Roleplay (Ctrl+4) on the Library frame
 * ========================================
 * Spec: Docs/superpowers/specs/2026-10-02-roleplay-library-frame-design.md.
 * Every rule here is lazy: build_css.py moves it to
 * screen_feature_roleplay.tcss, which TldwCli._SCREEN_OWNED_ROUTE_CSS parses
 * on the first visit to Roleplay (never PersonasScreen.CSS_PATH: Textual
 * loads a screen's CSS_PATH under every app, including the unstyled test
 * harnesses). Every selector carries a Roleplay token (#personas-header...,
 * .roleplay-...). The split also claims the shared tokens
 * workbench-header-title/-subtitle/-status and -active so these rules can
 * leave the boot bundle; Tests/UI/test_roleplay_stylesheet.py refuses a
 * selector anchored only by one of them. $ds-* tokens only, no numbers.
 */

/* One-row inline DestinationHeader (spec 1.3; DESIGN.md "Destination header
   variants"), after #console-workbench-header.console-header-inline. The
   id+class rules (1,2,0) beat the compact-height and density rules that hide
   a subtitle at 24 rows or fewer (.shell-header-compact
   .workbench-header-subtitle is 0,2,0), so the kind stays visible. The cells
   these rules spend on padding and margins are mirrored by the HEADER_*_CELLS
   constants in UI/Persona_Modules/roleplay_frame_state.py. */
#personas-header.personas-header-inline {
    layout: horizontal;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    border: none;
}

#personas-header.personas-header-inline .workbench-header-title {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
}

/* The kind: auto width and no wrap, so it is never cut; the item label
   beside it is the part that gives way. */
#personas-header.personas-header-inline .workbench-header-subtitle {
    display: block;
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-2;
    text-wrap: nowrap;
}

/* The authority chip (Local / Server: <label> · read-only) is a word, not a
   badge: neutral by id, since WorkbenchStatus has no neutral value. */
#personas-header.personas-header-inline .workbench-header-status {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
    background: $ds-surface-panel;
    color: $ds-text-muted;
    text-style: none;
}

#personas-header-tail {
    layout: horizontal;
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
}

/* Interim (spec 5.3): "› <item>" until the work-pane title row (B5b-2). */
#personas-header-item {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
}

#personas-header-unsaved,
#personas-header-blocked {
    width: auto;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
    text-style: bold;
}

/* Words that must be READ: the readable status foregrounds, not the
   decorative $ds-status-unsaved/$ds-status-blocked hues, which fall below
   AA on the panel in many themes. */
#personas-header-unsaved {
    color: $ds-status-warning-readable;
}

#personas-header-blocked {
    color: $ds-status-error-readable;
}

#personas-header-blocked:hover {
    text-style: bold underline;
}

/* Adaptive pane shell (spec 2.12 item 2): the Library's shell and grip rules
   (features/_library.tcss) keyed to Roleplay's destination classes
   (ROLEPLAY_PANE_CLASS_NAMES in UI/Persona_Modules/roleplay_frame_state.py).
   Tests/UI/test_roleplay_stylesheet.py pins the two sets equal once the class
   names are normalised: change both or neither. No width rule: grip widths
   are inline styles from the resolver. Inert until frame slice B7 mounts the
   shell. */
.roleplay-shell {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-height-full;
    min-height: $ds-size-0;
}

.roleplay-shell > .roleplay-shell-work {
    width: $ds-width-fill;
    min-width: $ds-size-0;
}

.roleplay-shell > .roleplay-shell-grip {
    height: $ds-height-full;
    min-height: $ds-size-0;
    margin: $ds-space-0;
    padding: $ds-space-0;
    border: none !important;
    content-align: center middle;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: none;
    tint: transparent;
    outline: none;
}

.roleplay-shell > .roleplay-shell-grip:hover,
.roleplay-shell > .roleplay-shell-grip.-active {
    background: $ds-surface-raised;
    tint: transparent;
}

.roleplay-shell > .roleplay-shell-grip:hover {
    color: $ds-text-primary;
}

/* task-32053: focus inverts the whole grip (reverse), never an outline. */
.roleplay-shell > .roleplay-shell-grip:focus {
    background: $ds-surface-raised;
    color: $ds-action-focus;
    text-style: bold reverse;
    tint: transparent;
    outline: none;
}
/* Frame slice B2a: the items list (spec 1.5.3). Rows are OptionList lines,
   not widgets. The list keeps one edge column in BOTH focus states, so focus
   never moves a row or a column (I10; D14 census F1: an edge that appears
   only on focus shifted every row on mouse-down and the click landed on the
   neighbour). The focus edge is $ds-active-fg, the token that clears 3:1 on
   every shipped theme (Tests/UI/test_theme_contrast.py). The cursor row
   paints only while the list has focus; the global OptionList rule
   (components/_lists.tcss) paints it regardless. The list keeps OptionList's
   own $surface background, on which the cursor colours clear AA. */
.roleplay-items-list {
    border: none;
    border-left: blank;
    padding: $ds-space-0;
    scrollbar-gutter: stable;
}

/* OptionList tints its whole background 5% toward the foreground on focus;
   on that tint the cursor text measured below AA on two themes (4.33:1 on
   monokai_pro, 4.44:1 on high_contrast_yellow_black; 4.73:1 and 4.85:1
   without it), so the Roleplay list clears it: the edge and the cursor row
   mark focus. */
.roleplay-items-list:focus {
    border-left: thick $ds-active-fg;
    background-tint: transparent;
}

.roleplay-items-list > .option-list--option-highlighted {
    background: transparent;
    color: $ds-text-primary;
    text-style: none;
}

.roleplay-items-list:focus > .option-list--option-highlighted {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* The empty or recovery line beside the list (one Static, mounted only when
   the state changes); its container is only as tall as that line. */
#personas-library-status {
    height: auto;
}

.personas-library-status-copy {
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
}

/* Frame slice B2a: the marks bar (spec 1.5.5), the items pane's bottom row
   while marks exist. Its words and actions size to their labels; the bar
   degrades its text by width (roleplay_frame_state.marks_bar_view), never by
   clipping. */
#personas-library-marks {
    width: $ds-width-fill;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}

#personas-library-marks-count,
.personas-library-marks-sep,
.personas-library-marks-action {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    padding: $ds-space-0;
    margin: $ds-space-0;
}

/* Frame slice B2b: the one-row items toolbar (spec 1.5.1). The search box is
   the boot dense-form input (.settings-compact-input): one row at rest and
   focused, so focus never moves the list (RP-009). PersonasLibraryPane fits
   the controls (roleplay_frame_state.fit_items_toolbar) and toggles the two
   layout classes; the cells these rules spend are mirrored by its
   CONTROL_GAP_CELLS and SEARCH_CHROME_CELLS. Each control is exactly its
   label wide (an inline width), so the margin is the gap between them. */
.roleplay-items-toolbar {
    layout: horizontal;
    width: $ds-width-fill;
    height: auto;
}

/* Too narrow for the search beside the controls: the controls take the row
   under it. */
.roleplay-items-toolbar.roleplay-items-toolbar-wrapped {
    layout: vertical;
}

.roleplay-items-controls {
    layout: horizontal;
    width: auto;
    height: auto;
}

/* Too narrow for one row of controls (80x24): one control per row. */
.roleplay-items-controls.roleplay-items-controls-stacked {
    layout: vertical;
}

.roleplay-items-control {
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0;
    margin: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
    border: none;
}

/* Frame slice B2b (RP-062): the search placeholder and typed text at AA,
   painted on every measurable theme by Tests/UI/test_theme_contrast.py.
   Textual paints the placeholder $text-disabled, under 4.5:1 on all 89
   themes (2.12:1 on paradise_virtua): at rest it takes the placeholder
   token. Focused, the dense form's translucent $ds-input-focus-bg over the
   pane's $panel took the focus ink under 4.5:1 on five themes (4.12:1 on
   catppuccin-frappe), so the box takes the house focus fill themes.py
   guards for $panel, as the Workflows search does; Textual's own 5% tint
   is dropped (with it, three themes stay under, 4.27:1 on
   catppuccin-mocha). The left edge stays the dense form's. */
.roleplay-items-search > .input--placeholder {
    color: $ds-text-placeholder;
}

.roleplay-items-search:focus {
    background: $tldw-focus-fill;
    background-tint: transparent;
}

.roleplay-items-search:focus > .input--placeholder {
    color: $ds-focus-fg;
}

/* Frame slice B2b: the one choice modal (the New chooser, "Import as:"),
   Widgets/Persona_Widgets/roleplay_choice_modal.py. It is pushed only from
   Roleplay, so this lazy sheet is always loaded while it shows. */
.roleplay-items-chooser {
    align: center middle;
}

#roleplay-items-chooser-box {
    width: $ds-size-50;
    max-width: $ds-width-full;
    height: auto;
    padding: $ds-space-1 $ds-space-2;
    border: round $ds-surface-panel;
    background: $ds-surface-raised;
}

#roleplay-items-chooser-options {
    height: auto;
}

.roleplay-items-chooser-keys {
    color: $ds-text-muted;
}
