/* ========================================
 * FEATURES: Tools and Settings
 * ======================================== 
 * Tools and Settings tab
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


/* --- Tools & Settings Tab --- */
#tools_settings-window { /* Matches TAB_TOOLS_SETTINGS */
    layout: horizontal; /* Main layout for this tab */
}

.tools-nav-pane {
    dock: left;
    width: auto; /* Changed from 25% */
    min-width: $ds-size-25; /* Example min-width */
    max-width: $ds-size-60; /* Example max-width */
    height: $ds-height-full;
    background: $boost; /* Or $surface-lighten-1 */
    padding: $ds-space-1;
    border-right: thick $background-darken-1;
    overflow-y: auto;
    overflow-x: hidden;
}

.tools-nav-pane .ts-nav-button { /* Style for navigation buttons */
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    border: none; /* Cleaner look for nav buttons */
    height: $ds-size-3;
}
.tools-nav-pane .ts-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}

.tools-nav-pane .ts-nav-button.active-nav {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.tools-content-pane {
    width: $ds-width-fill; /* Takes remaining horizontal space */
    height: $ds-height-full;
    padding: $ds-space-1 $ds-space-2; /* Padding for the content area */
    overflow-y: auto; /* If content within sub-views might scroll */
}

/* Ensure ContentSwitcher fills the pane */
.tools-content-pane ContentSwitcher {
    height: $ds-height-full;
    width: $ds-width-full;
}

.ts-view-area { /* Class for individual content areas */
    width: $ds-width-full;
    height: $ds-height-full;
    overflow-y: auto;
    overflow-x: hidden;
    /* Let ContentSwitcher handle visibility */
}

.config-file-settings-container {
    height: $ds-height-full;
    width: $ds-width-full;
    overflow-y: auto;
    overflow-x: hidden;
}

/* Ensure TabbedContent fills container */
.config-file-settings-container TabbedContent {
    height: $ds-height-full;
    width: $ds-width-full;
}

.config-file-settings-container TabPane {
    height: $ds-height-full;
    width: $ds-width-full;
}

/* Specific config tabs styling */
#config-tabs {
    height: $ds-height-full;
    width: $ds-width-full;
    min-height: $ds-size-30;
}

/* Inner container for config file settings */
.config-file-settings-inner {
    height: $ds-height-full;
    width: $ds-width-full;
    layout: vertical;
}

/* Settings form styling */
.section-description {
    color: $text-muted;
    margin-bottom: $ds-space-2;
    text-align: center;
    text-style: italic;
    height: auto;
}

.settings-group {
    margin-bottom: $ds-space-2;
    padding: $ds-space-1;
    background: $surface;
    border: round $primary-background;
    height: auto;
}

.settings-select, .settings-input {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    min-height: $ds-size-3;
    height: auto;
}

.checkbox-group {
    margin-bottom: $ds-space-1;
}

.warning-text {
    color: $warning;
    margin-bottom: $ds-space-1;
    text-style: italic;
}

.settings-actions {
    margin-top: $ds-space-2;
    layout: horizontal;
    height: auto;
    align: center middle;
}

.settings-actions Button {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

/* Configuration file settings specific */
.config-file-settings-container {
    height: $ds-height-full;
    width: $ds-width-full;
}

.config-editor {
    height: $ds-size-20;
    min-height: $ds-size-20;
    border: round $primary;
    background: $panel;
    margin-bottom: $ds-space-1;
}

.config-button-container {
    layout: horizontal;
    height: auto;
    margin-top: $ds-space-1;
    align: center middle;
}

.config-button-container Button {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

.tab-description {
    color: $text-muted;
    margin-bottom: $ds-space-1;
    text-style: italic;
}

/* --- Core Settings Styles --- */
.core-settings-container {
    padding: $ds-space-1 $ds-space-2;
    width: $ds-width-full;
    height: $ds-height-full;
}

.settings-group {
    background: $surface;
    padding: $ds-space-1;
    margin-bottom: $ds-space-2;
    border: round $primary-background;
}

.settings-input {
    width: $ds-width-full;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.settings-select {
    width: $ds-width-full;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.settings-subsection-title {
    color: $text;
    text-style: bold;
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
}

.settings-note {
    color: $text-muted;
    text-style: italic;
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
}

.checkbox-group {
    layout: horizontal;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.checkbox-group Checkbox {
    margin-right: $ds-space-2;
}

.settings-actions {
    layout: horizontal;
    margin-top: $ds-space-2;
    align: center middle;
}

.settings-actions Button {
    margin: $ds-space-0 $ds-space-1;
    min-width: $ds-size-15;
}

/* --- End Core Settings Styles ---*/

/* --- Config Form Styles --- */
.config-form {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-1 $ds-space-2;
    overflow-y: auto;
}

/* ADR-161 task 6: the bare .form-label/.form-section-title/.form-actions
 * duplicates that used to live here were folded into their owning sheet
 * components/_forms.tcss (same computed values, tokenized); only
 * feature-specific compounds remain in this sheet. */

.form-description {
    color: $text-muted;
    margin-bottom: $ds-space-2;
    text-style: italic;
}

.form-subsection-title {
    text-style: bold;
    color: $secondary;
    margin: $ds-space-1 $ds-space-0 $ds-space-1 $ds-space-0;
}

.form-actions Button {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    min-width: $ds-size-15;
}

/* TextArea styling for config forms */
.config-form TextArea {
    width: $ds-width-full;
    height: $ds-size-10;
    margin-bottom: $ds-space-1;
    border: round $primary;
    background: $panel;
}

.system-prompt-textarea {
    height: $ds-size-15;
}

.provider-models-textarea {
    height: $ds-size-5;
}

/* Collapsible styling in config forms */
.config-form Collapsible {
    margin-bottom: $ds-space-1;
    border: round $primary-background;
    background: $surface;
}

.config-form Collapsible > CollapsibleTitle {
    background: $boost;
    padding: $ds-space-0 $ds-space-1;
}

/* Help text */
.help-text {
    color: $text-muted;
    margin-bottom: $ds-space-1;
    text-style: italic;
}

/* Database status */
.db-status {
    color: $text-muted;
    margin-bottom: $ds-space-1;
}
