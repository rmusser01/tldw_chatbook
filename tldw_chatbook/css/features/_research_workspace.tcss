/* Research Workspace: established Neon Workbench extension.
 * All regions mount once; responsive classes only change display and sizing.
 */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent/fr scales + the named
   $ds-research-chat-pane-floor), transcribed value-identically from the
   raw literals; comments stay load-bearing. */


#research-workspace-shell {
    width: $ds-width-full;
    height: $ds-height-full;
    min-height: $ds-size-0;
    background: $background;
}

/* Runs adds the shared one-row mode strip above the legacy 100%-high window.
 * Claim only the remaining screen-content height so its footer stays contained.
 * layout: vertical -- ResearchWindow subclasses Vertical, but the global
 * `.window` rule (layout/_windows.tcss) forces layout: horizontal, which
 * crushed the whole Runs view into one squashed row (release P1).
 */
ResearchScreen #research-window.window {
    layout: vertical;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

#research-workspace-header {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-0;
    background: $panel;
}

#research-workspace-header .workbench-header {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    padding: $ds-space-0 $ds-space-1;
    border: none;
}

#research-mode-strip {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    overflow: hidden;
    background: $panel;
}

#research-mode-strip .research-mode-label {
    width: $ds-size-10;
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $accent;
    text-style: bold;
}

#research-mode-strip Button.research-mode-chip {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $surface-darken-1;
    color: $text-muted;
}

#research-mode-strip .research-mode-chip.is-active,
#research-mode-strip .research-mode-chip.is-active:focus {
    border: none;
    background: $primary;
    color: $text;
    text-style: bold underline;
    outline: none;
}

#research-mode-strip .research-mode-chip:focus {
    border: none;
    background: $surface;
    color: $text;
    text-style: bold underline;
    outline: none;
}

#research-authority-summary {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $surface-darken-1;
}

#research-processing-summary {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $surface-darken-1;
}

#research-authority-summary Static,
#research-processing-summary Static {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-right: $ds-space-2;
    color: $text-muted;
}

#research-data-source-label {
    color: $accent;
    text-style: bold;
    margin-right: $ds-space-1;
}

#research-authority-summary #research-data-source-separator {
    margin: $ds-space-0;
}

#research-authority-summary .research-data-source-button {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $surface-darken-1;
    color: $text-muted;
}

#research-authority-summary .research-data-source-button:focus {
    border: none;
    outline: none;
    background: $ds-focus-bg;
    color: $text;
    text-style: bold underline;
}

#research-authority-summary .research-data-source-button.is-active,
#research-authority-summary .research-data-source-button.is-active:focus {
    border: none;
    outline: none;
    background: $primary;
    color: $text;
    text-style: bold underline;
}

#research-authority-recovery {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $warning 15%;
    color: $text;
}

#research-workspace-menu {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $panel;
}

#research-workspace-selection {
    width: $ds-width-fill;
    height: $ds-size-1;
    color: $text-muted;
}

#research-manage-workspaces {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $surface;
    color: $text;
}

#research-manage-workspaces:focus {
    border: none;
    outline: none;
    background: $primary;
    color: $text;
    text-style: bold underline;
}

#research-pane-mode-strip {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $surface-darken-1;
    align-horizontal: center;
}

#research-pane-mode-strip .research-pane-mode-button {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $surface-darken-1;
    color: $text-muted;
}

#research-pane-mode-strip .research-pane-mode-button.is-active {
    border: none;
    background: $primary-darken-1;
    color: $text;
    text-style: bold;
}

#research-pane-mode-strip .research-pane-mode-button:focus {
    border: none;
    outline: none;
    background: $primary;
    color: $text;
    text-style: bold underline;
}

#research-workspace-grid {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
    background: $background;
    overflow: hidden;
}

.research-workspace-pane {
    height: $ds-height-full;
    min-height: $ds-size-0;
    padding: $ds-space-1;
    border: round $surface-lighten-1;
    background: $panel;
    color: $text;
}

.research-workspace-pane:focus {
    border: round $accent;
    outline: none;
}

.research-pane-title {
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $accent;
    text-style: bold;
}

.research-pane-summary {
    height: auto;
    margin-top: $ds-space-1;
    color: $text-muted;
}

.research-pane-empty {
    height: auto;
    margin-top: $ds-space-1;
    color: $text;
}

#research-sources-pane {
    width: $ds-width-fill;
    min-width: $ds-size-32;
    max-width: $ds-size-38;
}

#research-chat-pane {
    width: $ds-fr-4;
    min-width: $ds-research-chat-pane-floor;
}

#research-studio-pane {
    width: $ds-fr-2;
    min-width: $ds-size-42;
    max-width: $ds-size-50;
}

ResearchPaneHandle {
    width: $ds-size-4;
    min-width: $ds-size-4;
    max-width: $ds-size-4;
    height: $ds-height-full;
    min-height: $ds-size-0;
    background: $surface-darken-1;
    align: center middle;
}

ResearchPaneHandle .research-pane-handle-button {
    width: $ds-size-4;
    min-width: $ds-size-4;
    max-width: $ds-size-4;
    height: $ds-size-3;
    min-height: $ds-size-3;
    padding: $ds-space-0;
    border: none;
    background: $surface;
    color: $text-muted;
}

ResearchPaneHandle .research-pane-handle-button:focus {
    border: none;
    outline: heavy $accent;
    background: $primary;
    color: $text;
    text-style: bold;
}

#research-workspace-grid.layout-medium #research-sources-pane,
#research-workspace-grid.layout-medium #research-studio-pane {
    width: $ds-fr-2;
    min-width: $ds-size-32;
    max-width: $ds-size-42;
}

#research-workspace-grid.layout-medium #research-chat-pane {
    width: $ds-fr-4;
    min-width: $ds-research-chat-pane-floor;
}

#research-workspace-grid.layout-narrow .research-workspace-pane {
    width: $ds-width-full;
    min-width: $ds-size-0;
    max-width: $ds-width-full;
}

#research-workspace-status {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $panel;
    color: $text-muted;
}

#research-workspace-shell.height-compact #research-destination-header {
    height: $ds-size-2;
    min-height: $ds-size-2;
}

#research-workspace-shell.height-compact #workbench-header-subtitle {
    display: none;
}

#research-workspace-shell.height-compact #research-source-filter-summary {
    display: none;
}

#research-workspace-shell.height-compact .research-workspace-pane {
    padding: $ds-space-0;
    border: none;
}

#research-workspace-shell.height-compact .research-workspace-pane:focus {
    border: none;
    outline: heavy $accent;
}

/* Task 4 Sources workbench: compact, keyboard-first controls. */
ResearchSourcesRegion {
    width: $ds-width-full;
    height: $ds-height-full;
    min-height: $ds-size-0;
    padding: $ds-space-0;
    scrollbar-size: 1 1;
}

ResearchSourcesRegion Horizontal,
ResearchSourcesRegion Vertical {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-0;
}

ResearchSourcesRegion Button {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $surface;
    color: $text;
}

ResearchSourcesRegion Button:focus {
    border: none;
    outline: none;
    background: $primary;
    color: $text;
    text-style: bold underline;
}

#research-workspace-shell ResearchSourcesRegion Button:disabled {
    opacity: 100%;
    text-opacity: 100%;
    background: $surface-darken-1;
    color: $text-muted;
    text-style: none;
}

ResearchSourcesRegion Input,
ResearchSourcesRegion Select {
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $surface-darken-1;
}

#research-source-header,
#research-source-quick-row,
#research-source-view-row,
#research-source-selection-row,
#research-source-selection-summary,
#research-source-page-actions {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

#research-sources-heading,
#research-source-quick-url,
#research-source-search,
#research-source-selected-count,
#research-source-page-summary {
    width: $ds-width-fill;
}

#research-source-add,
#research-source-quick-submit,
#research-source-advanced,
#research-source-page-prev,
#research-source-page-next {
    width: auto;
}

#research-source-recovery {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $warning 15%;
    color: $text;
}

#research-source-filter-summary,
#research-source-move-copy-reason,
#research-source-remove-scope,
#research-source-filter-owner-limits {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    color: $text-muted;
}

#research-source-advanced-controls {
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    background: $surface-darken-1;
}

.research-source-filter-row {
    height: $ds-size-1;
}

.research-source-filter-row Select {
    width: $ds-width-fill;
}

#research-source-selection-row Button {
    width: $ds-width-fill;
    padding: $ds-space-0;
}

#research-source-batch-actions,
#research-source-folders,
.research-source-folder-actions,
.research-source-row-actions {
    layout: vertical;
    height: auto;
}

#research-source-batch-actions Button,
.research-source-folder-actions Button,
.research-source-row-actions Button {
    width: $ds-width-full;
}

#research-source-folders {
    margin-top: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    border-left: solid $surface-lighten-1;
}

#research-source-folders-label,
#research-source-receipts-heading {
    width: $ds-width-full;
    height: $ds-size-1;
    color: $accent;
    text-style: bold;
}

#research-source-folder-name,
#research-source-folder-tree {
    width: $ds-width-full;
}

ResearchSourceList,
ResearchSourceReceiptList {
    width: $ds-width-full;
    height: auto;
}

_ResearchSourceRowSlot,
_ResearchSourceReceiptSlot {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    margin-top: $ds-space-1;
    background: $surface-darken-1;
    border-left: solid $surface-lighten-1;
}

.research-source-row-heading,
.research-source-receipt-actions {
    height: $ds-size-1;
}

.research-source-row-heading Static {
    width: $ds-width-fill;
    height: $ds-size-1;
    color: $text;
    text-style: bold;
}

_ResearchSourceRowSlot Static,
_ResearchSourceReceiptSlot Static {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
}

#research-source-receipts-bound {
    width: $ds-width-full;
    height: auto;
    color: $text-muted;
}

/* Task 5 Quick Notes: compact canonical owner editor inside Studio. */
ResearchQuickNotesSection {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-0;
    margin-top: $ds-space-1;
    padding: $ds-space-0 $ds-space-1 $ds-space-1 $ds-space-1;
    background: $surface-darken-1;
    border-left: solid $accent;
}

ResearchQuickNotesSection Horizontal {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
}

ResearchQuickNotesSection Button {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $surface;
    color: $text;
}

ResearchQuickNotesSection Button:focus {
    border: none;
    outline: none;
    background: $primary;
    color: $text;
    text-style: bold underline;
}

#research-workspace-shell ResearchQuickNotesSection Button:disabled {
    opacity: 100%;
    text-opacity: 100%;
    background: $surface-darken-1;
    color: $text-muted;
    text-style: none;
}

#research-quick-notes-heading {
    width: $ds-width-fill;
    color: $accent;
    text-style: bold;
}

#research-quick-note-count {
    width: auto;
    margin-right: $ds-space-1;
    color: $text-muted;
}

#research-quick-note-search,
#research-quick-note-page {
    width: $ds-width-fill;
}

#research-quick-note-list,
#research-quick-note-title,
#research-quick-note-tags {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $surface;
}

#research-quick-note-provenance-row,
#research-quick-note-mode-row,
#research-quick-note-actions,
#research-quick-note-file-actions {
    margin-top: $ds-space-1;
}

#research-quick-note-provenance,
#research-quick-note-status,
#research-quick-note-owner-limits {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    color: $text-muted;
}

#research-quick-note-status {
    color: $text;
}

#research-quick-note-owner-limits {
    background: $warning 15%;
}

#research-quick-note-body,
#research-quick-note-preview {
    width: $ds-width-full;
    height: $ds-size-10;
    min-height: $ds-size-5;
    margin-top: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    border: solid $surface-lighten-1;
    background: $panel;
}

#research-quick-note-mode-row Button.is-active {
    background: $primary-darken-1;
    color: $text;
    text-style: bold;
}

#research-workspace-shell.height-compact #research-quick-note-body,
#research-workspace-shell.height-compact #research-quick-note-preview {
    height: $ds-size-6;
}

/* Add Sources and source inspector modals share the workbench visual world. */
ResearchAddSourceModal,
ResearchSourceInspectorModal,
ResearchOverlayConflictModal,
ResearchNoteConflictModal,
ResearchNoteSwitchRecoveryModal {
    align: center middle;
    background: $background 70%;
}

#research-add-source-dialog,
#research-source-inspector-dialog,
#research-overlay-conflict-dialog,
#research-note-conflict-dialog,
#research-note-switch-dialog {
    width: $ds-percent-90;
    max-width: $ds-size-110;
    height: $ds-percent-90;
    min-height: $ds-size-18;
    padding: $ds-space-1;
    border: round $accent;
    background: $panel;
}

#research-overlay-conflict-dialog,
#research-note-conflict-dialog,
#research-note-switch-dialog {
    height: auto;
    max-width: $ds-size-76;
}

#research-overlay-conflict-dialog Button,
#research-overlay-conflict-dialog Static,
#research-note-conflict-dialog Button,
#research-note-conflict-dialog Static,
#research-note-switch-dialog Button,
#research-note-switch-dialog Static {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
}

#research-add-source-heading-row,
#research-source-inspector-heading {
    width: $ds-width-full;
    height: $ds-size-1;
}

#research-add-source-title,
#research-source-inspector-title {
    width: $ds-width-fill;
    color: $accent;
    text-style: bold;
}

#research-add-authority {
    width: auto;
    color: $text-muted;
    margin-right: $ds-space-2;
}

#research-add-source-dialog Button,
#research-source-inspector-dialog Button {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
}

/* Unavailable actions remain readable: the surface and adjacent reason text
   convey the state without stacking app and Textual opacity dimmers. */
#research-add-source-dialog Button:disabled,
#research-add-source-dialog Input:disabled,
#research-add-source-dialog Select:disabled,
#research-source-inspector-dialog Button:disabled {
    opacity: 100%;
    text-opacity: 100%;
    color: $text-muted;
    background: $surface-darken-1;
    text-style: none;
}

#research-add-error {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    background: $error 15%;
    color: $text;
}

#research-add-source-tabs {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

.research-add-tab-body,
#research-source-inspector-body {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

.research-add-tab-body Input,
.research-add-tab-body Select,
.research-add-tab-body TextArea,
#research-source-inspector-body Input,
#research-source-inspector-body TextArea {
    width: $ds-width-full;
    min-height: $ds-size-1;
}

.research-add-actions,
.research-add-filters {
    width: $ds-width-full;
    height: auto;
}

.research-add-filters Select {
    width: $ds-width-fill;
}

#research-source-preview-text {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-1;
    background: $surface-darken-1;
}

#research-source-annotation-label {
    margin-top: $ds-space-1;
    color: $accent;
    text-style: bold;
}

/* --- Runs window internal layout ------------------------------------------
 * ResearchWindow's containers had no styles at all: the toolbar/create/body
 * rows fell back to Horizontal's 1fr height and Input/Select's 100% width,
 * so nothing usable rendered. Rows hug their content; the run list + detail
 * body claims the rest.
 */
#research-toolbar,
#research-create-row {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-0;
}

#research-source-select {
    width: $ds-size-16;
}

/* ID subjects, not `<row> Input`: the ancestor-scoped bare-type ratchet
 * (test_textual_css_fastpath, ADR-097) taxes bare-type-subject rules.
 */
#research-query-input,
#research-limits-input,
#research-providers-input {
    width: $ds-width-fill;
}

#research-policy-select {
    width: $ds-size-20;
}

#research-rounds-select {
    width: $ds-size-14;
}

#research-status {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    color: $text-muted;
}

#research-body {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

#research-run-list {
    width: $ds-percent-30;
    min-width: $ds-size-24;
    height: $ds-height-full;
    border-right: solid $surface-lighten-1;
}

#research-detail-panel {
    width: $ds-width-fill;
    height: $ds-height-full;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
    overflow-y: auto;
}

#research-run-actions,
#research-observe-actions,
#research-checkpoint-actions,
#research-followup-row {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-0;
}

#research-artifact-name,
#research-followup-input {
    width: $ds-width-fill;
}

#research-checkpoint-patch {
    height: $ds-size-6;
}
