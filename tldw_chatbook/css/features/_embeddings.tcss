/* ========================================
 * Embeddings Feature Styles
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


/* Sidebar title styling */
.sidebar-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    color: $text-muted;
}

/* ========================================
 * Confirmation Dialog Styles
 * ======================================== */

/* Dialog container for modal screens */
#dialog-container {
    align: center middle;
    background: $surface;
    border: thick $primary;
    padding: $ds-space-2;
    width: $ds-size-50;
    height: auto;
}

#dialog-title {
    text-style: bold;
    text-align: center;
    margin-bottom: $ds-space-1;
    width: $ds-width-full;
}

#dialog-message {
    text-align: center;
    margin-bottom: $ds-space-2;
    color: $text-muted;
    width: $ds-width-full;
}

#dialog-buttons {
    layout: horizontal;
    align: center middle;
    width: $ds-width-full;
    margin-top: $ds-space-1;
}

#dialog-buttons Button {
    margin: $ds-space-0 $ds-space-1;
    min-width: $ds-size-10;
}

/* Modal screen background */
ModalScreen {
    align: center middle;
    background: $background 80%;
}

/* ========================================
 * Form Validation Error Styles
 * ======================================== */

/* Error message displays */
.error-message {
    color: $error;

    margin-top: $ds-space-0;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    text-style: italic;
}

.error-message.hidden {
    display: none;
}

/* ========================================
 * Enhanced List Item Styles
 * ======================================== */

.model-header {
    layout: horizontal;
    margin-bottom: $ds-space-0;
}

.model-name {
    text-style: bold;
    margin-right: $ds-space-1;
}

.model-provider {
    color: $text-muted;

}

.model-download-status,
.model-memory-status,
.model-size {

    margin-right: $ds-space-2;
}

.model-size {
    color: $text-muted;
}

/* ========================================
 * Empty State Styles
 * ======================================== */

.empty-state-container {
    width: $ds-width-full;
    height: $ds-height-full;
    align: center middle;
    padding: $ds-space-3;
}

.empty-state-content {
    align: center middle;
    width: auto;
}

.empty-state-icon {

    margin-bottom: $ds-space-1;
    text-align: center;
}

.empty-state-title {
    text-style: bold;

    margin-bottom: $ds-space-1;
    text-align: center;
}

.empty-state-description {
    color: $text-muted;
    margin-bottom: $ds-space-2;
    text-align: center;
    max-width: $ds-size-40;
}

.empty-state-action {
    margin-top: $ds-space-1;
}

/* ========================================
 * Enhanced Visual Design
 * ======================================== */

/* Enhanced hover states */
/* Button:hover handled in components/_buttons.tcss to fix persistent hover issue */

/* TASK-2300 + review wave I1. This was `Select:hover { border: solid ... }`,
 * which added two rows of chrome to a widget that has no border of its own
 * (a `Select` draws one on its child) -- so on a one-row compact Select the
 * value vanished behind it, on the way TO clicking, before anything had been
 * chosen.
 *
 * The first fix moved it to `Select:hover > SelectCurrent`, which is DEAD:
 * Textual assigns `:hover` to the innermost widget under the pointer that has
 * a hover style, and `_has_hover_style` is derived from the selector NAMES a
 * rule mentions (`css/stylesheet.py:506`). Naming `SelectCurrent` in the rule
 * is what makes `SelectCurrent` the hover target -- so the `Select` never gets
 * `:hover` and `Select:hover > ...` can never match. Measured on the
 * production bundle: `select.mouse_hover=False`, `current.mouse_hover=True`,
 * painted rows identical at rest and hovered.
 *
 * Written to match the mechanism instead of fighting it: the pseudo-class goes
 * on `SelectCurrent`, which is both the widget Textual actually hovers AND the
 * one painting the surface a user sees. `background` rather than `border`, so
 * it recolours cells the widget already draws and moves nothing -- geometry
 * changes on hover are what made C1's frame strobe, because they move the
 * pointer's own target out from under it. `$surface-lighten-1` is this app's
 * established hover background (`ListView ListItem:hover`,
 * `OptionList > .option-list--option-hover`, `DataTable > .datatable--hover`),
 * so the cue now reads the same as every other hoverable row.
 */
Select > SelectCurrent:hover {
    background: $surface-lighten-1;
}


/* Visual separators */
.section-separator {
    height: $ds-size-1;
    background: $primary-darken-2;
    margin: $ds-space-2 $ds-space-0;
}

/* ========================================
 * Tooltip and Help Icon Styles
 * ======================================== */

/* Tooltip container */
.tooltip {

    background: $panel;
    border: solid $primary;
    padding: $ds-space-1;
    max-width: $ds-size-40;

    display: none;
}

/* ========================================
 * Batch Selection Styles
 * ======================================== */

.batch-controls {
    layout: horizontal;
    margin: $ds-space-1 $ds-space-0;
    padding: $ds-space-1;
    background: $surface;
    border: round $primary;
}

.batch-controls.hidden {
    display: none;
}

.batch-button {
    margin: $ds-space-0 $ds-space-1;
    min-width: $ds-size-12;
    height: $ds-size-3;
}

/* ========================================
 * Toast Notification Styles
 * ======================================== */

.toast-manager {
    dock: top;
    align: right top;
    width: auto;
    height: auto;
    margin: $ds-space-2 $ds-space-2 $ds-space-0 $ds-space-0;
    layer: above;

}

.toast-stack {
    width: auto;
    height: auto;
}

.toast-notification {
    width: $ds-size-35;
    margin-bottom: $ds-space-1;
}

.toast-container {
    layout: horizontal;
    padding: $ds-space-1;
    border: round;
    align: left middle;
}

.toast-icon {
    margin-right: $ds-space-1;
    min-width: $ds-size-3;
    text-align: center;
}

.toast-message {
    width: $ds-width-fill;
    text-wrap: wrap;
}

.toast-close {
    min-width: $ds-size-3;
    height: $ds-size-3;
    margin-left: $ds-space-1;
    background: transparent;
    border: none;
}

.toast-close:hover {
    background: $background 50%;
}

/* Toast severity styles */
.toast-success {
    background: $success 90%;
    border: solid $success;
    color: $text;
}

.toast-info {
    background: $primary 90%;
    border: solid $primary;
    color: $text;
}

.toast-warning {
    background: $warning 90%;
    border: solid $warning;
    color: $text;
}

.toast-error {
    background: $error 90%;
    border: solid $error;
    color: $text;
}

/* Toast animations */
.toast-slide-in {
    /* Animation properties would go here if needed */
}

/* ========================================
 * Detailed Progress Bar Styles
 * ======================================== */

.detailed-progress-container {
    width: $ds-width-full;
    padding: $ds-space-1;
    background: $panel;
    border: round $primary;
}

.progress-stage-row,
.progress-item-row,
.progress-metrics-row {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    align: left middle;
}

.progress-action-row {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    align: right middle;
}

.progress-label {
    width: $ds-size-12;
    text-align: right;
    margin-right: $ds-space-1;
    color: $text-muted;
}

.stage-indicator {
    width: $ds-width-fill;
    text-style: bold;
    color: $primary;
}

.current-item {
    width: $ds-width-fill;
    color: $text;
    text-style: italic;
}

.pause-button {
    min-width: $ds-size-10;
}

#main-progress {
    margin-bottom: $ds-space-1;
    height: $ds-size-3;
}

.stage-progress {
    height: $ds-size-2;
    background: $surface;
}

.progress-metrics-row {
    margin-top: $ds-space-1;
    border-top: dashed $primary-darken-2;
    padding-top: $ds-space-1;
}

.metric-group {
    margin-right: $ds-space-3;
}

.metric-label {

    color: $text-muted;
    margin-bottom: $ds-space-0;
}

.metric-value {

    text-style: bold;
    color: $primary;
}

/* ========================================
 * Embedding Template Selector Styles
 * ======================================== */

/* Template selector dialog */
#embedding-template-selector-container {
    width: $ds-size-80;
    height: $ds-size-50;
    background: $panel;
    border: thick $primary;
    padding: $ds-space-2;
}

#embedding-template-selector-title {
    text-style: bold;
    text-align: center;
    margin-bottom: $ds-space-2;
}

#embedding-template-selector-content {
    height: $ds-height-fill;
    margin-bottom: $ds-space-2;
}

#embedding-template-category-pane {
    width: $ds-percent-25;
    min-width: $ds-size-20;
    background: $surface;
    padding: $ds-space-1;
    border-right: solid $primary-darken-1;
}

#embedding-template-grid-container {
    width: $ds-width-fill;
    padding: $ds-space-1;
    overflow-y: auto;
}

.embedding-template-grid {
    grid-columns: 2;
    grid-gutter: 1;
    padding: $ds-space-1;
}

/* Template card styles */
.embedding-template-card-container {
    background: $surface;
    border: round $primary-darken-2;
    padding: $ds-space-1;
    height: auto;
}

.embedding-template-card:hover .embedding-template-card-container {
    background: $surface-lighten-1;
    border: solid $accent;
}

.embedding-template-card-header {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    align: left middle;
}

.embedding-template-card-title {
    text-style: bold;
    color: $primary;
    width: $ds-width-fill;
}

.embedding-template-card-category {

    color: $text-muted;
    background: $primary 20%;
    padding: $ds-space-0 $ds-space-1;
    border: round $primary;
}

.embedding-template-card-description {
    margin-bottom: $ds-space-1;
    color: $text-muted;

}

.embedding-template-card-label {

    text-style: bold;
    margin-bottom: $ds-space-0;
}

.embedding-template-card-list {
    margin-left: $ds-space-1;
    margin-bottom: $ds-space-1;
}

.embedding-template-card-item {

    color: $text-muted;
}

.embedding-template-card-button {
    width: $ds-width-full;
    margin-top: $ds-space-1;
}

/* Quick select widget */
.embedding-template-quick-select-container {
    layout: horizontal;
    align: left middle;
    padding: $ds-space-1;
    background: $surface;
    border: round $primary-darken-2;
    margin-bottom: $ds-space-1;
}

.embedding-template-select-label {
    margin-right: $ds-space-2;
    min-width: $ds-size-10;
}

.embedding-template-quick-button {
    margin-right: $ds-space-1;
    min-width: $ds-size-15;
}

.embedding-template-browse-button {
    margin-left: $ds-space-1;
}

.current-template-name {
    margin-left: $ds-space-2;
    color: $success;
    text-style: italic;
}

/* ========================================
 * Activity Log Widget Styles
 * ======================================== */

.activity-log-widget {
    width: $ds-width-full;
    height: $ds-height-full;
}

.activity-log-container {
    width: $ds-width-full;
    height: $ds-height-full;
    background: $panel;
    border: round $primary-darken-2;
    padding: $ds-space-1;
}

.activity-log-header {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    align: left middle;
}

.activity-log-title {
    text-style: bold;

    width: $ds-width-fill;
}

.activity-log-actions {
    layout: horizontal;
}

.activity-log-actions Button {
    margin-left: $ds-space-1;
    min-width: $ds-size-10;
    height: $ds-size-3;
}

.activity-log-controls {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    align: left middle;
}

.filter-button {
    margin-right: $ds-space-1;
    min-width: $ds-size-8;
    height: $ds-size-3;
    background: $surface;
}

.filter-button:hover {
    background: $primary 30%;
}

.filter-button.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.log-search-input {
    width: $ds-size-20;
}

.activity-log-scroll {
    height: $ds-height-fill;
    background: $surface;
    border: round $primary-darken-3;
    padding: $ds-space-1;
}

.log-entries-container {
    width: $ds-width-full;
}

/* Log entry styles */
.log-entry {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0;
    align: left top;
}

.log-timestamp {
    min-width: $ds-size-10;

    color: $text-muted;
    text-align: right;
    padding-right: $ds-space-1;
}

.log-icon {
    min-width: $ds-size-3;
    text-align: center;
}

.log-category {
    min-width: $ds-size-12;
    color: $primary;

    padding: $ds-space-0 $ds-space-1;
}

.log-message {
    width: $ds-width-fill;
    padding-left: $ds-space-1;
}

/* Level-specific colors */
.log-info {
    color: $text;
}

.log-info .log-icon {
    color: $primary;
}

.log-success {
    color: $success;
}

.log-success .log-message {
    color: $success;
}

.log-warning {
    color: $warning;
}

.log-warning .log-message {
    color: $warning;
}

.log-error {
    color: $error;
}

.log-error .log-message {
    color: $error;
}

.log-debug {
    color: $text-muted;
    text-style: italic;
}

.log-debug .log-message {
    color: $text-muted;
}

/* Small button styles */
.small-button {
    height: $ds-size-3;
    min-width: $ds-size-8;

}

/* ========================================
 * Performance Metrics Widget Styles
 * ======================================== */


.metrics-title {
    text-style: bold;
    text-align: center;
    margin-bottom: $ds-space-1;

}

.metrics-grid {
    grid-size: 2;
    grid-gutter: 1;
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

/* Metric box styling */
.metric-box {
    background: $surface;
    border: round $primary-darken-2;
    padding: $ds-space-1;
    height: auto;
}


.metric-label {

    color: $text-muted;
}

.metric-value {

    text-style: bold;
    color: $primary;
    text-align: center;
    margin-bottom: $ds-space-0;
}


.io-rate {
    width: $ds-percent-50;
    text-align: center;

}

.io-rate:first-child {
    color: $success;
}

.io-rate:last-child {
    color: $warning;
}
