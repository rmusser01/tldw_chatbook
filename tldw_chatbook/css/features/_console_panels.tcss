/* ========================================
 * FEATURES: Console panels
 * ========================================
 * ADR-161 task 10: the console-* side-panel vocabulary (inspector,
 * staged sources, prompts, activity, scope, the Console's settings pane,
 * character context) extracted from components/_agentic_terminal.tcss
 * and tokenized on arrival. Splits from features/_console.tcss only to
 * meet the 2,000-active-line sheet ceiling (spec 3.5); the pair is one
 * vocabulary, console-surface scoped. ======================================== */


#console-settings-modal {
    width: $ds-size-120;
    max-width: $ds-percent-95;
    height: $ds-percent-94;
    max-height: $ds-percent-95;
    overflow: hidden;
    scrollbar-size: 1 1;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: $ds-space-1 $ds-space-2;
}

/* TASK-31665 AC#15: visible scrollbar thumb. `$ds-grid-line` on a
   `$ds-surface-panel` track measured 1.01:1 -- a scroller advertising a fold
   it cannot show a position for. `$ds-text-muted` is the app's established
   thumb token, generated per theme polarity; `scrollbar-color-active` keeps
   the accent so a drag still reads as a drag. Applied to five more scrollers
   below (same rationale). */
#console-settings-body {
    height: $ds-height-fill;
    min-height: $ds-size-0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-text-muted;
    scrollbar-color-hover: $ds-text-muted;
    scrollbar-color-active: $ds-action-focus;
}

.console-settings-modal-section {
    height: auto;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

#console-settings-provider-model-section,
#console-settings-connection {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
}

.console-settings-primary-section {
    padding: $ds-space-0 $ds-space-1;
    border: round $ds-action-focus;
    background: $ds-surface-raised;
}

.console-settings-modal-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-1;
}

.console-settings-modal-label {
    width: $ds-size-23;
    min-width: $ds-size-10;
    max-width: $ds-size-23;
    height: auto;
    min-height: $ds-size-3;
    content-align: left middle;
    text-wrap: wrap;
}

.console-settings-control {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    max-width: $ds-percent-75;
}

.console-settings-modal-actions {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-3;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    align-horizontal: right;
}

#console-settings-connection-actions {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
}

#console-settings-model-custom {
    width: $ds-size-18;
    min-width: $ds-size-18;
    max-width: $ds-size-18;
}

#console-settings-model-discover {
    width: $ds-size-31;
    min-width: $ds-size-31;
    max-width: $ds-size-31;
}

#console-settings-readiness-panel,
#console-settings-model-discover-scope,
#console-settings-model-discover-status,
#console-settings-readiness,
#console-settings-generation-confirmation,
#console-settings-generation-consent-copy,
#console-settings-generation-test-status {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    text-wrap: wrap;
}

.console-settings-view-tab {
    background: $ds-surface-raised;
    color: $ds-text-muted;
}

.console-settings-view-tab.console-settings-view-active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

.console-settings-action-scope,
.console-settings-disabled-reason {
    height: auto;
    min-height: $ds-size-1;
    content-align: right middle;
}

.console-settings-action-scope {
    color: $ds-text-muted;
}

.console-settings-scope {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
    text-wrap: wrap;
}

.console-settings-disabled-reason {
    color: $ds-status-warning;
    text-style: bold;
}

#console-settings-cancel,
#console-settings-save,
#console-settings-save-default {
    width: auto;
    min-width: $ds-size-12;
    height: $ds-size-1;
    min-height: $ds-size-1;
}

#console-settings-save-default {
    min-width: $ds-size-29;
}

ConsoleSettingsModal.-conversation-settings-compact #console-settings-connection-actions,
ConsoleSettingsModal.-conversation-settings-compact #console-settings-actions {
    layout: vertical;
    height: auto;
    align-horizontal: left;
}

ConsoleSettingsModal.-conversation-settings-compact #console-settings-connection-actions > .console-settings-modal-label {
    display: none;
}

ConsoleSettingsModal.-conversation-settings-compact Button.console-settings-connection-action {
    width: $ds-width-full;
    min-width: $ds-size-0;
    max-width: $ds-width-full;
}

ConsoleSettingsModal.-conversation-settings-compact Button.console-settings-connection-action {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

.console-settings-error {
    height: auto;
    min-height: $ds-size-1;
    max-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-status-error 10%;
    color: $ds-text-primary;
}

#console-prompt-picker-modal {
    width: $ds-size-76;
    max-width: $ds-percent-95;
    height: auto;
    max-height: $ds-percent-85;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: $ds-space-1 $ds-space-2;
}

#console-prompt-picker-filter {
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-prompt-picker-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

#console-prompt-picker-results {
    height: auto;
    max-height: $ds-size-20;
    min-height: $ds-size-0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

.console-prompt-picker-row {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-prompt-picker-row-highlighted {
    border: tall $ds-action-focus;
    background: $ds-input-focus-bg;
    text-style: bold;
}

.console-prompt-picker-row-blocked {
    color: $ds-text-muted;
}

#console-prompt-picker-reason {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-status-error 10%;
    color: $ds-text-primary;
}

#console-prompt-picker-empty {
    height: auto;
    margin: $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

#console-system-prompt-modal {
    width: $ds-size-84;
    max-width: $ds-percent-95;
    height: $ds-size-32;
    max-height: $ds-percent-90;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: $ds-space-1 $ds-space-2;
}

.console-system-prompt-row {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.console-system-prompt-label {
    width: $ds-size-8;
    min-width: $ds-size-8;
    max-width: $ds-size-8;
    height: $ds-size-1;
    min-height: $ds-size-1;
    content-align: left middle;
}

#console-system-prompt-scope {
    color: $ds-text-muted;
}

#console-system-prompt-text {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-10;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-system-prompt-text:focus {
    border: tall $ds-input-focus-accent;
    background: $ds-input-focus-bg;
}

#console-system-prompt-name {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-3;
    min-height: $ds-size-3;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-system-prompt-save-status {
    color: $ds-text-muted;
}

.console-system-prompt-actions {
    height: $ds-size-3;
    min-height: $ds-size-3;
    align-horizontal: right;
}

#console-run-log-modal {
    width: $ds-size-96;
    max-width: $ds-percent-95;
    height: $ds-size-36;
    max-height: $ds-percent-90;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: $ds-space-1 $ds-space-2;
}

#console-run-log-text {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-10;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-run-log-actions {
    height: $ds-size-3;
    min-height: $ds-size-3;
    align-horizontal: right;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

#console-system-prompt-clear,
#console-system-prompt-cancel,
#console-system-prompt-apply {
    width: $ds-size-12;
    min-width: $ds-size-12;
    height: $ds-size-3;
    min-height: $ds-size-3;
}

#console-workbench-header {
    /* The destination identity header is the visible Console header (ADR-015);
       layout comes from .workbench-header in _workbench.tcss. */
    height: auto;
    min-height: $ds-size-2;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
}

#console-workbench-header.console-header-inline {
    layout: horizontal;
    height: $ds-size-1;
    min-height: $ds-size-1;
    border: none;
}

#console-workbench-header.console-header-inline .workbench-header-title {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
}

#console-workbench-header.console-header-inline .workbench-header-subtitle {
    /* Keep the subtitle visible in compact density too: the shared
       `.density-compact .workbench-header-subtitle { display: none }` hid it to
       save a row in the old stacked header, but the inline header is one row at
       any density, so hiding it only wastes the horizontal space. This id+class
       rule (1,2,0) beats that density rule (0,2,0). */
    display: block;
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    margin: $ds-space-0 $ds-space-1;
}

#console-workbench-header.console-header-inline .workbench-header-status {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
}

#console-workbench-mode-strip,
#console-workbench-command-strip {
    display: none;
    height: $ds-size-0;
    min-height: $ds-size-0;
    max-height: $ds-size-0;
    padding: $ds-space-0;
    margin: $ds-space-0;
    border: none;
}

/* The policy label has two independent axes (or an explicit unavailable
   state), so it needs more room than ordinary metadata chips. */
#console-library-chip {
    max-width: $ds-size-48;
}

#console-staged-context-tray,
#console-session-context,
#console-workspaces-context,
#console-workspace-context,
#console-run-inspector {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-height-full;
    min-height: $ds-size-0;
}

#console-staged-context-tray,
#console-session-context,
#console-workspaces-context,
#console-workspace-context {
    width: $ds-width-full;
    min-width: $ds-size-0;
}

#console-staged-context-tray {
    height: auto;
    min-height: $ds-size-0;
}

#console-session-context,
#console-workspaces-context,
#console-workspace-context {
    height: auto;
    min-height: $ds-size-0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-conversation-browser-section-header {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    layout: horizontal;
    align: left middle;
}

.console-conversation-browser-section-title {
    width: $ds-width-fill;
    min-width: $ds-size-0;
}

.console-conversation-browser-group-header {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    layout: horizontal;
    align: left middle;
}

.console-conversation-browser-group-title {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    color: $ds-text-muted;
}

.console-conversation-browser-row-line {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    layout: horizontal;
}

.console-conversation-star {
    width: $ds-size-3;
    min-width: $ds-size-3;
    max-width: $ds-size-3;
    height: $ds-size-2;
    min-height: $ds-size-2;
    margin: $ds-space-0 $ds-space-1 $ds-space-1 $ds-space-0;
}

/* TASK-31663 AC#4: the thumb measured 1.01:1 against its own track. It must
   clear the 3:1 non-text floor and nothing in the surface family does on
   this theme ($ds-column-line 1.28:1, $panel-lighten-3 2.16:1), so it takes
   $ds-text-muted -- the app's other established thumb token, generated per
   theme polarity. See TASK-31663 notes. */
#console-inspector-rail-body {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-height-fill;
    min-height: $ds-size-0;
    padding: $ds-space-0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-text-muted;
    scrollbar-color-hover: $ds-text-muted;
    scrollbar-color-active: $ds-action-focus;
}

#console-inspector-more,
#console-inspector-more-body {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-0;
}

#console-inspector-more-toggle {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    text-align: left;
}

#console-staged-context-tray,
#console-session-context,
#console-workspaces-context,
#console-workspace-context,
#console-run-inspector {
    border: solid $ds-column-line;
    background: $ds-surface-panel;
}

#console-staged-context-tray.console-frame-quiet,
#console-session-context.console-frame-quiet,
#console-workspaces-context.console-frame-quiet,
#console-workspace-context.console-frame-quiet {
    border: none;
    background: $ds-surface-panel;
}

#console-run-inspector {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-0;
    border: none;
}

#console-run-inspector-state {
    height: auto;
    min-height: $ds-size-0;
}

/* TASK-24700: TASK-24605 lowered the OPEN rail's floor from 20 to 12 because
   a 24-row terminal allots it 13 and a 20-row minimum made it lay out
   against 20 and clip -- but it left this, the COLLAPSED form, at 20. The
   collapsed handle is the rail's shipping default state, so the half that
   users meet first kept the defect the fix was written for. Same floor as
   the rail it stands in for. */
.console-inspector-rail-handle {
    height: $ds-height-full;
    min-height: $ds-size-12;
    max-height: $ds-height-full;
    background: $ds-surface-panel;
}

.console-switcher-result:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Keep focused search one row. */
#console-switcher-query,
#console-switcher-query:focus {
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    border: none;
    outline: none;
    padding: $ds-space-0;
}

#console-switcher-query:focus,
.console-switcher-mode-current,
.console-switcher-result-candidate {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}

#console-switcher-query:focus {
    border-left: thick $ds-action-focus;
    text-style: bold;
}

#console-switcher-modal {
    border: tall $ds-grid-line;
    border-title-color: $ds-text-primary;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

#console-switcher-scope,
#console-switcher-selected-detail,
#console-switcher-page-status,
#console-switcher-hints {
    color: $ds-text-muted;
}

.console-switcher-result-error {
    border-left: solid $ds-status-error;
}

#console-character-avatar-frame {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-0;
    align: center middle;
}

/* TASK-31244: Character rows are compact, cell-clipped peers inside the
   section's existing bounded viewport. The widget itself introduces no
   additional scroll owner. */
#console-character-context {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-0;
}

#console-character-search {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-3;
    min-height: $ds-size-3;
    max-height: $ds-size-3;
}

.console-character-group,
.console-character-row,
.console-character-action,
#console-character-query-handoff,
#console-character-retry,
#console-character-open-roleplay {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    padding: $ds-space-0;
    text-align: left;
    content-align: left middle;
    text-overflow: ellipsis;
}

.console-character-group:focus,
.console-character-row:focus,
.console-character-action:focus,
#console-character-retry:focus,
#console-character-open-roleplay:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

#console-character-context .console-character-search-row {
    height: $ds-size-3;
    min-height: $ds-size-3;
    max-height: $ds-size-3;
}

.console-character-empty,
#console-character-loading,
#console-character-error,
#console-character-unavailable-reason {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-overflow: ellipsis;
}

#console-character-context .console-character-row.-opening {
    text-style: italic;
}

/* TASK-24612: the Inspect rail's Tab cycle contains two CONTAINERS as well
   as its controls -- the outer scroller and the rail root. Both are focus
   targets on purpose (the scroller so the keyboard can scroll it, the root
   because it is the pane F6 lands on, `right_rail.can_focus = True` at
   compose), but neither had a `:focus` rule of its own. A measured focus
   walk found their entire visible indication was a single frame glyph and,
   for a nested viewport, a lit scrollbar column. The bounded-section
   viewport above already models the right treatment; these now share it, so
   a keyboard user can see which region holds focus rather than inferring it
   from one recoloured border cell. `:focus` only -- NOT `:focus-within`:
   these two contain every other stop in the rail, so tinting them whenever
   a descendant has focus would leave the whole rail permanently tinted and
   destroy the signal it is meant to carry. */
/* TASK-24702: a LEFT EDGE, not a background tint and not a full outline.
   Three measurements decided this.

   1. A tint cannot carry the cue here. `$ds-action-focus 12%` measured
      1.35:1 against the rail ground and 1.11:1 against the pinned card;
      45% reaches ~1.74:1; even a fully opaque accent is only 3.77:1 on this
      near-black theme. To clear WCAG's 3:1 non-text floor a tint has to be
      ~85-90% opaque -- a solid block behind the text, not a tint.
   2. A full outline DOES clear it (3.77:1 / 3.01:1) and is what DESIGN.md
      prescribes -- the pinned authority summary already proves it works,
      one widget away. But `outline` paints over the widget's own edge
      cells, and at 80x24 this scroller's body is THREE rows; a top and
      bottom border would claim two of them.
   3. A one-column left edge costs one column instead of two rows, clears
      the same 3.77:1 because it is the same colour, and is already the
      house pattern -- DESIGN.md's dense-form convention flips exactly this
      edge to `thick $ds-action-focus` on focus. The rail is 33 columns at
      120 and narrower; a column is affordable where two of three rows is
      not. */
#console-inspector-rail-body:focus,
#console-right-rail:focus {
    outline-left: thick $ds-action-focus;
}

/* The COLLAPSED rail's handle -- the shipping default state, and before this
   rule focusing it changed nothing at all. RIGHT edge, measured not
   stylistic: the shell clips this button's leading pad, so col 0 carries the
   "◂" of "◂ Inspect" while the last column is always blank. A left edge would
   paint "█ Inspect". See TASK-31663 notes. */
#console-inspector-rail-open:focus {
    outline-right: thick $ds-action-focus;
}

.console-model-section-line {
    height: auto;
    min-height: $ds-size-1;
}

.console-model-section-label {
    width: $ds-size-12;
    min-width: $ds-size-12;
    color: $ds-text-muted;
}

.console-model-section-value {
    width: $ds-width-fill;
    min-width: $ds-size-10;
    color: $ds-value-fg;
}

#console-model-section-provider .console-model-section-value,
#console-model-section-model .console-model-section-value {
    text-wrap: wrap;
    max-height: $ds-size-3;
    overflow: hidden;
}

#console-model-section-temperature .console-model-section-value,
#console-model-section-max-tokens .console-model-section-value {
    text-wrap: nowrap;
}

#console-model-section-recovery {
    /* TASK-31429: this line is READ, not glanced -- readable error variant
       (design-language rule: readable beats decorative). */
    color: $ds-status-error-readable;
}

.console-agent-section-line {
    height: $ds-size-1;
    color: $ds-text-primary;
}

/* TASK-31429 (rail colour grammar): the Agent status line's run status
   (`apply_console_agent_status_state`) maps to the same status tokens the
   Inspector's fleet rows already use; idle/unavailable carry no class. */
.console-agent-section-status-running {
    color: $ds-status-running;
}

.console-agent-section-status-done {
    color: $ds-status-ready;
}

.console-agent-section-status-stuck {
    color: $ds-status-warning;
}

.console-agent-section-status-error,
.console-agent-section-status-cancelled {
    color: $ds-status-error-readable;
}

.console-agent-section-steps {
    height: auto;
    color: $ds-text-muted;
    text-style: dim;
}

/* PR2b Task 4: `.console-agent-section-subagents` retired -- the plain
   Static this class styled at `#console-agent-section-subagents` was
   replaced by a `ConsoleInspectorSection` (styled entirely by its own
   `.console-inspector-section*` rules above); nothing composes this class
   anymore. */

.console-agent-section-fleet-summary {
    height: auto;
    color: $ds-status-running;
    text-style: dim;
}

.console-agent-drilldown-back {
    margin-top: $ds-space-1;
}

.console-inspector-group-heading {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-inspector-status-summary {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-inspector-action {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
}

/* TASK-24606: this used to be `height: 0` -- the authored reason for a
   disabled action was mounted and then collapsed to nothing. It is now a
   real row. Muted because it is secondary to the action it explains, but
   NOT dimmed: DESIGN.md's Legible Disabled Rule documents `dim` compounding
   with an alpha token to below 3:1, and this line is the only place several
   restrictions are explained at all. */
.console-inspector-disabled-reason {
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
}

/* TASK-24606 + the Legible Disabled Rule. Textual's `Button:disabled` adds
   `text-style: bold dim` AND `color: auto 50%`, and a widget's own
   DEFAULT_CSS cannot beat it -- both sit in the same tier, where `Button`
   wins for a `Button`. The override therefore lives here, in the app
   stylesheet, and states a colour bright enough to survive that halving.
   `text-style: none` does NOT clear Textual's `dim` (measured), so the
   colour has to carry it. Disabled must still read as clearly quieter than
   enabled, which it does: enabled inspector actions render at full
   `$ds-text-primary` on the action background. */
Button.console-inspector-action:disabled {
    color: $ds-text-primary;
    text-opacity: 100%;
}

/* PR2b Task 3: the reusable Inspector-style section component (header +
   optional chevron + optional right-aligned summary, row body, optional
   "View all" tail). Ships the grammar once -- Agents (Task 4) is the first
   consumer; Changes/Sources/Workspace sections follow later against these
   same classes (spec section 7). */
.console-inspector-section {
    height: auto;
    min-height: $ds-size-0;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.console-inspector-section-header {
    height: $ds-size-1;
    min-height: $ds-size-1;
    layout: horizontal;
    align: left middle;
}

.console-inspector-section-title {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    text-style: bold;
    color: $ds-text-primary;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.console-inspector-section-summary {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    color: $ds-text-muted;
    text-align: right;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.console-inspector-section-toggle {
    width: $ds-size-3;
    min-width: $ds-size-3;
    height: $ds-size-1;
    text-style: bold;
}

.console-inspector-section-toggle:focus {
    background: $ds-action-focus 30%;
    text-style: underline bold;
}

.console-inspector-section-body {
    height: auto;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
}

/* TASK-31662: one line per row unless its pair needs two (see
   `ConsoleInspectorSectionRow`). A floor of `2` left 25% of the Environment
   section's row-lines blank. */
.console-inspector-section-row {
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}

/* The one-line form's inner row: primary (1fr) + secondary (auto), the
   same split the section header uses for title + summary. */
.console-inspector-section-row-line {
    width: $ds-width-full;
    height: $ds-size-1;
}

.console-inspector-section-row:focus {
    background: $ds-action-focus 20%;
}

.console-inspector-section-row-primary {
    height: $ds-size-1;
    color: $ds-text-primary;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* TASK-31665 AC#9: no `text-style: dim` -- it DOUBLE-dimmed an already-muted
   token to 3.42:1 (AA fail) where sibling muted strings paint 5.91:1. `dim`
   is a real second step (~65% fg retained), not a no-op. */
.console-inspector-section-row-secondary {
    height: $ds-size-1;
    color: $ds-text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* Status-colored variants of the row's PRIMARY line only -- the secondary
   (dimmed detail) line stays muted regardless of status. Class names are
   built via f-string interpolation in console_inspector_section.py, which
   is out of scope for test_css_class_coverage_contract.py by design (its
   docstring: "f-strings ... are out of scope"); these rules are shipped
   for real styling, not to satisfy that contract.

   DESCENDANT, not child (`>`), since TASK-31662: the one-line form nests
   the primary in `.console-inspector-section-row-line`, so `>` silently
   dropped the status colour for every row sharing a line. */
.console-inspector-section-row-running .console-inspector-section-row-primary {
    color: $ds-status-running;
}

.console-inspector-section-row-done .console-inspector-section-row-primary {
    color: $ds-status-ready;
}

/* TASK-31664 (a11y): this text must be READ (a failing-check name), so it
   takes the READABLE token. $ds-status-error is $error at 3.06:1 (AA fail);
   $ds-status-error-readable is the per-theme $text-error. */
.console-inspector-section-row-error .console-inspector-section-row-primary {
    color: $ds-status-error-readable;
}

/* The row the critique measured at 2.53:1 carries status="blocked", NOT
   "error", so the rule above never reached it. Both are must-be-READ states
   and deliberately share one readable token. See TASK-31664 notes. */
.console-inspector-section-row-blocked .console-inspector-section-row-primary {
    color: $ds-status-error-readable;
}

/* TASK-31665 AC#5: no top margin. With the section's own bottom margin the
   tail button floated between two blank lines, "orphaned ~28 lines from its
   data"; flush under the last row makes its owner unambiguous. */
.console-inspector-section-row-stuck > .console-inspector-section-row-primary {
    color: $ds-status-warning;
}

.console-inspector-section-row-cancelled > .console-inspector-section-row-primary {
    color: $ds-text-muted;
}

.console-inspector-section-view-all {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
}

/* Context (staged sources) section pinned at the top of the Inspector rail
   body (task-400): bottom margin separates it from the run inspector below. */
.console-inspector-context-section {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
}

.console-settings-summary {
    height: auto;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
}

.console-inspector-session-settings {
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $ds-surface-panel;
}

.console-settings-header {
    height: $ds-size-1;
    min-height: $ds-size-1;
    layout: horizontal;
    align: left middle;
}

/* TASK-24609: this declared neither weight nor colour, and the
   `destination-section` class it also carries has no rule in scope inside
   the rail, so "Session Settings" rendered identically to the eight
   `.console-settings-row` lines it heads and the section boundary was
   invisible. Same treatment as `.console-rail-section-title`, which is the
   one heading style every section title in this rail should share. */
.console-settings-title {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    text-style: bold;
    color: $ds-text-primary;
}

.console-settings-row {
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    overflow: hidden hidden;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#console-settings-open {
    width: auto;
    min-width: $ds-size-9;
    max-width: $ds-size-14;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
}

#console-prompt-improvement-recovery {
    display: none;
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    layout: horizontal;
    align: right middle;
}

#console-prompt-improvement-status {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    color: $ds-status-ready;
    content-align: left middle;
    padding: $ds-space-0 $ds-space-1;
}

#console-prompt-improvement-undo {
    width: $ds-size-8;
    min-width: $ds-size-8;
}

#console-prompt-improvement-review {
    width: $ds-size-16;
    min-width: $ds-size-16;
}

#console-command-visible-text {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-1;
    /* TASK-17654: moves with ConsoleComposerBar.MAX_DRAFT_ROWS. */
    max-height: $ds-size-8;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    overflow: hidden;
}

#console-command-input {
    display: none;
    width: $ds-size-0;
    min-width: $ds-size-0;
    height: $ds-size-0;
    min-height: $ds-size-0;
}

/* TASK-19426: one causal Assistant turn owns its activity disclosures,
   final answer, and adjuncts. The left-edge ownership accent is singular;
   nested activity rows stay quiet so they read as evidence inside the turn
   rather than as neighboring transcript cards. */
.console-assistant-turn {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1 $ds-space-1 $ds-space-1;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.-dark-mode .console-assistant-turn {
    border-left: tall $ds-chat-assistant-accent-dark;
}

.-light-mode .console-assistant-turn {
    border-left: tall $ds-chat-assistant-accent-light;
}

.console-assistant-turn > .console-message-header,
.console-assistant-activity-stack,
.console-assistant-adjunct-stack {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-0;
}

.console-assistant-turn > .console-message-header {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

.console-assistant-activity-stack {
    padding: $ds-space-0 $ds-space-1;
}

.console-assistant-turn > .console-transcript-message {
    width: $ds-width-full;
    height: auto;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

/* Selection belongs to the answer, not its entire ownership surface. */
.console-assistant-turn > .console-transcript-message-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}

.console-activity-disclosure {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-activity-header {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    overflow: hidden;
}

.console-activity-label {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    overflow: hidden;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.console-activity-status {
    width: $ds-size-9;
    min-width: $ds-size-9;
    max-width: $ds-size-9;
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-align: right;
    text-style: bold;
}

.console-activity-status-success {
    background: $ds-status-ready 10%;
    color: $ds-text-primary;
}

.console-activity-status-blocked {
    background: $ds-status-blocked 16%;
    color: $ds-text-primary;
}

/* task-32279: the three narrowed refusal states. They share the blocked
   tint on purpose -- which authority refused is carried by the WORD, never
   by colour -- and each widens the standard nine-cell column to fit that
   word, the same way the proprietary-thinking state below already does. */
.console-activity-status-denied,
.console-activity-status-blocked_off {
    background: $ds-status-blocked 16%;
    color: $ds-text-primary;
    width: $ds-size-15;
    min-width: $ds-size-15;
    max-width: $ds-size-15;
}

.console-activity-status-blocked_kill_switch {
    background: $ds-status-blocked 16%;
    color: $ds-text-primary;
    width: $ds-size-23;
    min-width: $ds-size-23;
    max-width: $ds-size-23;
}

.console-activity-status-failed {
    background: $ds-status-error 16%;
    color: $ds-text-primary;
}

.console-activity-status-done {
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-activity-status-live {
    background: $ds-status-running 12%;
    color: $ds-text-primary;
}

.console-activity-status-stopped,
.console-activity-status-unavailable {
    background: $ds-status-warning 12%;
    color: $ds-text-primary;
}

/* The proprietary-thinking state is the only status longer than the
   standard nine-cell column. Preserve its literal non-color cue instead of
   clipping the header to a warning tint and midpoint. */
.console-activity-status-unavailable {
    width: $ds-size-13;
    min-width: $ds-size-13;
    max-width: $ds-size-13;
}

/* These height-one headers opt out of the global outline because it would
   paint over their only content row. Text + background + underline provide
   the non-color focus cue without changing geometry in either theme. */
.console-activity-header:focus {
    outline: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-activity-header-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

.console-activity-header:focus > .console-activity-status,
.console-activity-header-selected > .console-activity-status {
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-style: bold underline;
}

.console-activity-disclosure-selected > .console-activity-action-stack {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}

.console-activity-action-stack {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
}

.console-activity-detail-stack {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-0;
    margin: $ds-space-0 $ds-space-1 $ds-space-1 $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-activity-disclosure-expanded > .console-activity-detail-stack {
    background: $ds-surface-panel;
}

.console-activity-detail-stack .console-transcript-message {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-0;
    background: transparent;
}

.console-activity-detail-stack .console-transcript-tool-diff {
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-2;
}

ChatScreen.-focus #console-workbench-header {
    display: none;
}

.console-action-primary {
    border: none;
    height: $ds-size-1;
    min-height: $ds-size-1;
    background: $ds-action-focus 35%;
    color: $ds-text-primary;
    text-style: bold;
}

.console-action-secondary {
    border: none;
    height: $ds-size-1;
    min-height: $ds-size-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-action-subdued {
    border: none;
    height: $ds-size-1;
    min-height: $ds-size-1;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: none;
}

.console-action-disabled {
    border: none;
    height: $ds-size-1;
    min-height: $ds-size-1;
    background: $ds-surface-panel;
    color: $ds-text-disabled;
    text-style: none;
}

.console-action-disabled:hover,
.console-action-disabled:focus,
.console-action-disabled:hover:focus {
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-disabled;
    text-style: none;
    outline: none;
}

.console-staged-context-header {
    height: auto;
    min-height: $ds-size-1;
}

#console-staged-context-title {
    width: $ds-width-fill;
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-style: bold;
}

#console-staged-context-count {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-align: right;
    color: $ds-text-muted;
}

.console-staged-source-row {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0;
}

.console-staged-source-primary {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    border: none;
    padding: $ds-space-0;
    text-align: left;
    background: transparent;
    color: $ds-text-primary;
}

.console-staged-source-primary:hover,
.console-staged-source-primary:focus {
    border: none;
    background: $ds-action-focus 18%;
    text-style: bold;
}

.console-staged-source-primary-ready { color: $ds-status-ready; }
.console-staged-source-primary-warning { color: $ds-status-warning; }
.console-staged-source-primary-listed { color: $ds-status-paused; }  /* TASK-32330: muted tone for listed-not-sent rows */
.console-staged-source-primary-blocked { color: $ds-status-blocked; }

.console-staged-source-detail {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
}

.console-staged-source-detail Static {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
}

.console-staged-source-snippet {
    color: $ds-text-primary;
}

.console-staged-source-authority,
.console-staged-source-freshness,
.console-staged-source-action-copy {
    color: $ds-text-muted;
}

.console-staged-source-action {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    border: none;
    padding: $ds-space-0;
    background: transparent;
    color: $ds-action-focus;
}

.console-staged-source-name {
    text-wrap: wrap;
    max-height: $ds-size-2;
    overflow: hidden;
}

.console-staged-source-status {
    height: $ds-size-1;
    color: $ds-text-muted;
}

.console-staged-source-status.ready { color: $ds-status-ready; }
.console-staged-source-status.running { color: $ds-status-running; }
.console-staged-source-status.blocked { color: $ds-status-blocked; }

/* TASK-24608: run-inspector rows carry the same status vocabulary the tray
   above uses, and until now NOTHING in the repo defined any of these -- the
   class was built by f-string, swapped on every in-place update, and covered
   by passing tests while painting exactly nothing. The visible cost was on
   the rows whose TEXT does not repeat the status: "Approvals: 3 pending"
   carries status "blocked" and was pixel-identical to "Approvals: 0 pending".
   Colour is reinforcement only here -- every row still reads as blocked from
   its own words -- so this follows The Label Before Color Rule rather than
   becoming the sole carrier. `muted` is the normalizer's fallback and stays
   at the default row colour deliberately: an unrecognised status must not
   borrow the authority of a measured one. */
.console-inspector-row-ready { color: $ds-status-ready; }
.console-inspector-row-running { color: $ds-status-running; }
.console-inspector-row-blocked { color: $ds-status-blocked; }
.console-inspector-row-muted { color: $ds-text-muted; }

/* TASK-24700: the OUTER fold hint ("more sections below") had no rule at all
   while the LOCAL one (.console-bounded-section-hint) is muted + italic, so
   the more important of the two indicators painted as plain body text and
   read louder than the less important one. Same treatment, minus the
   `display: none` -- this hint's visibility is owned by the rail's fold
   reconcile, not by CSS. */
.console-inspector-outer-scroll-hint {
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $ds-text-muted;
    text-style: italic;
}

/* TASK-24701: second wave of the TASK-24608 defect -- classes attached in
   Python with no rule behind them. This one is the worst of the set: it
   carries a Library operation's `error_summary`, so a FAILED retained write
   rendered in the same colour as a successful one. */
.console-library-activity-error {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-status-error;
}

.console-library-activity-action,
.console-library-activity-source-ref {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
}

/* TASK-24609: rows start in the same column as the heading that labels
   them. The first attempt gave ROWS `padding: 0 0 0 1` to meet the heading.
   That was wrong in a way only the geometry tests caught: it costs every
   inspector row one column of content width, and at the rail's 46-column
   measured width two live-work rows wrapped that had previously fit, moving
   the bounded section's row demand from 20 to 22. The heading gives up its
   indent instead -- alignment for free, and the raised background still
   spans the full row. */
.console-inspector-group-heading {
    padding: $ds-space-0;
}

#console-staged-context-empty {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
}

/* RAG UX v2 PR-4 (task-1): the staged-evidence strip -- the MAIN-surface
   reader of the pending live-work launch, mounted directly above the
   composer (the status chips sit below the composer). Hidden entirely
   (`display` toggled from the widget)
   when nothing is staged, so it costs zero rows on the common path.
   M3 (final review): `min-height: 1` overrides the shared `.ds-panel`
   `min-height: 3` -- with 1-2 rows of real content (a header row plus N
   evidence rows) that left blank filler rows beneath the last row.
   Sibling to the `#console-status-chips` `min-height: 1` override above
   for the same reason on that other small fixed-content Console panel. */
#console-staged-evidence-strip {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-1;
    max-height: $ds-size-6;
    border: none;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
}

.console-staged-evidence-header {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    layout: horizontal;
}

.console-staged-evidence-heading {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    color: $ds-text-muted;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

.console-staged-evidence-unstage {
    width: auto;
    min-width: $ds-size-9;
    height: $ds-size-1;
    min-height: $ds-size-1;
    border: none;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-staged-evidence-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $ds-text-primary;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

.console-staged-evidence-row.blocked {
    color: $ds-status-blocked;
}

.console-staged-evidence-row.running {
    color: $ds-status-running;
}

.console-staged-evidence-row.muted {
    color: $ds-text-muted;
}

.console-staged-evidence-overflow,
.console-staged-evidence-notice {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $ds-text-muted;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

#console-scope-picker-modal {
    width: $ds-size-90;
    max-width: $ds-percent-95;
    height: auto;
    max-height: $ds-percent-90;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: $ds-space-1 $ds-space-2;
}

.console-scope-picker-tabs {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.console-scope-picker-tab {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

.console-scope-picker-tab-active {
    background: $ds-action-focus;
    text-style: bold;
}

#console-scope-picker-text-filter {
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-scope-picker-text-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

.console-scope-picker-tag-row {
    height: auto;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.console-scope-picker-chip-row {
    height: auto;
    min-height: $ds-size-1;
}

#console-scope-picker-tag-search {
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-scope-picker-tag-search:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

.console-scope-picker-tag-chip {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

.console-scope-picker-tag-chip-active {
    background: $ds-action-focus;
    text-style: bold;
}

.console-scope-picker-sort-row {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.console-scope-picker-sort-label {
    width: $ds-size-6;
    min-width: $ds-size-6;
    content-align: left middle;
}

.console-scope-picker-view-row {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.console-scope-picker-view-btn {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

.console-scope-picker-view-active {
    background: $ds-action-focus;
    text-style: bold;
}

#console-scope-picker-list {
    height: $ds-height-fill;
    min-height: $ds-size-8;
    max-height: $ds-size-20;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
}

.console-scope-picker-row {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-primary;
}

.console-scope-picker-row-greyed {
    color: $ds-text-muted;
}

#console-scope-picker-empty {
    height: auto;
    margin: $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

.console-scope-picker-page-row {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0;
    align-horizontal: center;
}

#console-scope-picker-page-label {
    width: auto;
    min-width: $ds-size-12;
    content-align: center middle;
    margin: $ds-space-0 $ds-space-1;
}

.console-scope-picker-bulk-row {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#console-scope-picker-confirm-text {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-status-warning 10%;
    color: $ds-text-primary;
}

.console-scope-picker-confirm-actions {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.console-scope-picker-footer {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    align-horizontal: right;
}

#console-scope-picker-count {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    content-align: left middle;
    color: $ds-text-muted;
}

#console-prompts-modal {
    width: $ds-percent-90;
    max-width: $ds-size-104;
    height: $ds-percent-90;
    max-height: $ds-size-44;
    min-width: $ds-size-40;
    min-height: $ds-size-18;
    border: tall $ds-grid-line;
    background: $ds-surface-panel;
    padding: $ds-space-1 $ds-space-2;
}

#console-prompts-header {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-2;
    border-bottom: solid $ds-grid-line;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#console-prompts-title {
    height: $ds-size-1;
    color: $ds-text-primary;
    text-style: bold;
}

#console-prompts-location,
#console-prompts-model-status,
#console-prompts-browse-status {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
}

#console-prompts-body,
#console-prompts-browse {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

/* The editor follows a host status row inside a bounded Vertical. Use the
   remaining fraction instead of its standalone 100% height so its actions
   stay above the modal footer. */
#console-prompts-editor {
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

.console-prompts-primary-action {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    border: none;
    background: $ds-action-focus;
    color: $ds-text-primary;
    text-style: bold;
}

.console-prompts-primary-action:focus,
#console-prompts-modal Button:focus {
    outline: heavy $ds-action-focus;
}

.console-prompts-primary-action:disabled,
#console-prompts-modal Button:disabled {
    background: $surface-darken-1;
    color: $ds-text-disabled;
}

#console-prompts-browse-controls {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

#console-prompts-source {
    width: $ds-size-18;
    min-width: $ds-size-14;
    height: $ds-size-3;
    border: none;
    border-left: solid $ds-grid-line;
    background: $surface-darken-1;
}

#console-prompts-search {
    width: $ds-width-fill;
    min-width: $ds-size-12;
    height: $ds-size-3;
    border: none;
    border-left: solid $ds-grid-line;
    background: $surface-darken-1;
}

#console-prompts-source:focus,
#console-prompts-search:focus {
    border-left: thick $ds-action-focus;
    background: $ds-focus-bg;
    text-style: bold;
}

#console-prompts-retry {
    width: auto;
    min-width: $ds-size-8;
    height: $ds-size-3;
    border: none;
    background: $ds-surface-raised;
}

#console-prompts-results {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-4;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    border-top: solid $ds-grid-line;
    border-bottom: solid $ds-grid-line;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

#console-prompts-result-list {
    width: $ds-width-full;
    height: auto;
}

.console-prompts-result {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-3;
    border: none;
    border-bottom: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-align: left;
    content-align: left middle;
}

.console-prompts-result:hover,
.console-prompts-result:focus {
    background: $ds-focus-bg;
}

#console-prompts-pagination,
#console-prompts-footer {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    align: right middle;
}

#console-prompts-page {
    width: $ds-width-fill;
    min-width: $ds-size-12;
    height: $ds-size-3;
    content-align: center middle;
    color: $ds-text-muted;
}

#console-prompts-pagination Button,
#console-prompts-footer Button,
#console-prompts-improve-mode Button,
#console-prompts-convert {
    width: auto;
    min-width: $ds-size-8;
    height: $ds-size-3;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-prompts-footer {
    border-top: solid $ds-grid-line;
}

#console-prompts-dirty-guard {
    display: none;
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-1;
    border: round $ds-status-warning;
    background: $ds-status-warning 10%;
    color: $ds-text-primary;
}

#console-prompts-dirty-guard.visible {
    display: block;
}

#console-prompts-compatibility {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-2;
    color: $ds-status-warning;
}

#console-prompts-compat-system,
#console-prompts-compat-user {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-3;
    border: round $ds-grid-line;
    background: $surface-darken-1;
}

#console-prompts-improve-mode,
#console-prompts-recipe-mode {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

#console-prompts-improve-mode Button,
#console-prompts-recipe-mode Button {
    width: $ds-width-full;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

#console-prompts-recipe-outcome-description,
#console-prompts-recipe-saved-description,
#console-prompts-recipe-blank-description {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
}

#console-prompts-recipe-save-confirmation-panel {
    display: none;
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-0 $ds-space-1 $ds-space-1 $ds-space-1;
    border: round $ds-status-ready;
    background: $ds-status-ready 8%;
}

#console-prompts-recipe-save-confirmation {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-primary;
}

#console-prompts-open-saved-recipe {
    width: $ds-width-full;
    height: $ds-size-3;
}

ConsolePromptsModal.-narrow #console-prompts-modal {
    width: $ds-percent-96;
    height: $ds-percent-96;
    padding: $ds-space-0 $ds-space-1;
}

ConsolePromptsModal.-narrow #console-prompts-browse-controls {
    layout: vertical;
    height: $ds-size-6;
    min-height: $ds-size-6;
}

ConsolePromptsModal.-narrow #console-prompts-source,
ConsolePromptsModal.-narrow #console-prompts-search {
    width: $ds-width-full;
}

/* Slash-command completion popup: floats above the composer. Position,
 * offset, width, and height are set imperatively in
 * ConsoleCommandPopup.show_suggestions/reposition. */
#console-command-popup {
    position: absolute;
    display: none;
    background: $ds-surface-panel;
    padding: $ds-space-0 $ds-space-1;
}

/* Textual's default OptionList chrome (tall border + padding) costs two
 * rows and pushed every option row out of small popups (a 1-row popup had a
 * 0-row content region and painted an empty band). The popup itself carries
 * the background, so strip the inner chrome. */
#console-command-popup OptionList {
    border: none;
    padding: $ds-space-0;
}

/* Governed Console exchange capture surfaces (ADR-089). */
#console-library-access {
    width: $ds-size-76;
    max-width: $ds-percent-96;
    height: $ds-size-34;
    max-height: $ds-percent-96;
    min-width: $ds-size-0;
}

#console-library-access-body {
    height: $ds-height-fill;
    min-height: $ds-size-0;
    max-height: $ds-size-24;
    scrollbar-gutter: stable;
}

.console-library-access-actions {
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
}

#console-library-access .console-library-access-actions Button {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    border: none;
    padding: $ds-space-0;
    margin-right: $ds-space-1;
}

#console-rag-settings {
    width: $ds-size-64;
    max-width: $ds-percent-96;
    height: $ds-size-20;
    max-height: $ds-percent-96;
    min-width: $ds-size-0;
}

#console-rag-settings-body {
    height: $ds-height-fill;
    min-height: $ds-size-0;
    scrollbar-gutter: stable;
}

.console-rag-settings-item-scope {
    height: auto;
    color: $text-muted;
    margin-bottom: $ds-space-1;
}

.console-rag-settings-sources {
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: 1 1;
    height: $ds-size-2;
}

.console-rag-settings-actions {
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
}

#console-rag-settings .console-rag-settings-actions Button {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    border: none;
    padding: $ds-space-0;
    margin-right: $ds-space-1;
}

#console-inspector-policy-status {
    height: auto;
    color: $text-muted;
}
#console-agent-progress { width: $ds-width-fill; height: $ds-size-1; min-height: $ds-size-1; margin: $ds-space-1 $ds-space-0; }
