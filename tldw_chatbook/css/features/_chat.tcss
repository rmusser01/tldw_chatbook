/* ========================================
 * FEATURES: Chat
 * ======================================== 
 * Chat tab specific styles
 *
 * Fully tokenized per ADR-150 / backlog/docs/design-language.md — the
 * migration reference pattern: spacing from the $ds-space-* scale, control
 * heights from $ds-control-*, motion from $ds-duration-*, state surfaces
 * from $ds-hover/-disabled/-focus tokens. Feature-specific geometry (fixed
 * gutter widths, textarea expansion heights) stays literal by design.
 * ======================================== */

/* --- Chat sidebar toggle buttons --- */
.chat-sidebar-toggle-button {
    width: 3;
    height: 100%;
    min-width: 3;
    max-width: 3;
    border: none;
    background: $background;
    color: $ds-text-muted;
    padding: $ds-space-1 0 0 0;
    margin: 0;
    content-align: center top;
}

.chat-sidebar-toggle-button:hover {
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.chat-sidebar-toggle-button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border: none;
    outline: none;
}

/* --- Chat Window specific layouts --- */
#chat-main-content {
    layout: vertical;
    height: 100%;
    width: 1fr; /* Takes remaining space */
    min-width: 40; /* Prevent squashing */
}

/* --- Compact Model Bar --- */
#compact-model-bar {
    height: $ds-control-height;
    width: 100%;
    padding: 0 $ds-space-inline;
    background: $ds-surface-raised;
    border-bottom: solid $ds-grid-line;
    align: left middle;
}

#compact-model-bar Select {
    width: 1fr;
    margin: 0 $ds-space-inline 0 0;
    height: $ds-control-height;
}

.compact-bar-label {
    width: auto;
    padding: 0 $ds-space-inline;
    color: $ds-text-muted;
}

.compact-bar-temp {
    width: 12;
    margin: 0 $ds-space-inline 0 0;
    height: $ds-control-height;
}

.compact-bar-toggle {
    width: auto;
    min-width: 5;
    height: $ds-control-height;
    border: none;
    /* Enabled but recessed chrome: sunken resting surface, NOT the
       disabled token (Qodo review, PR #2632). */
    background: $ds-surface-sunken;
    color: $ds-text-muted;
}

.compact-bar-toggle:hover {
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

/* Send button states */
.send-button {
    width: 2fr;
    margin-left: $ds-space-inline;
    text-style: $ds-text-strong;
}

.send-button.stop-state {
    background: $error;
}

/* Attachment button */
.attach-button {
    width: auto;
    margin-left: $ds-space-inline;
}

/* Voice input widget styles */
.voice-input-widget {
    padding: $ds-space-inset;
    background: $ds-surface-raised;
    border: solid $primary;
}

/* Notes area expansion states */
.notes-textarea-normal {
    height: 10;
}

.notes-textarea-expanded {
    height: 25;
}

/* Chat message type-specific styles */
.chat-message.user {
    background: $primary-lighten-2;
    text-align: right;
}

.chat-message.assistant {
    background: $surface-lighten-1;
    text-align: left;
}

/* Loading and error states */
.loading-indicator {
    text-align: center;
    padding: $ds-space-2;
    color: $ds-text-muted;
}

.error-message {
    color: $error;
    padding: $ds-space-inset;
    margin: $ds-space-stack;
    border: solid $error;
}
/* Send button styling (shared) */
.send-button { /* Targets Button */
    width: 1fr;      /* Equal flexible width */
    height: $ds-control-height;
    /* align-self: stretch; REMOVED */
    margin-top: 0;
    padding: 0;      /* No padding for button */
    transition: background $ds-duration-fast, color $ds-duration-fast;
}

/* Stop button state: the shared Button:disabled contract applies.
 * This sheet previously stacked `opacity: 0.7` on the global disabled
 * colors -- the exact TASK-25822 contrast failure (disabled read as
 * absent). The class+pseudo selector outranks `Button:disabled`, so the
 * override is removed rather than re-stated; the global rule supplies full
 * opacity, $ds-disabled-bg, and $ds-text-disabled-readable.
 * Intentional a11y fix, the one deliberate visual change in this
 * migration (Qodo review, PR #2632). */

/* Visual feedback for stop state */
.send-button.stop-state {
    background: $error;
    color: white;
}

.stop-button {
    width: 1fr;      /* Equal flexible width */
    height: $ds-control-height;
    margin-top: 0;
}

/* Clone Chat Button in chat-right-sidebar */
.clone-chat-button {
    margin-top: $ds-space-stack;   /* Add space above the button */
    width: 100%;     /* Full width like other sidebar buttons */
}

/* Chat Sidebar - Prompts Section */
#chat-prompts-collapsible Input,
#chat-prompts-collapsible ListView,
#chat-prompts-collapsible Button {
    margin-bottom: $ds-space-stack; /* Consistent spacing */
}
#chat-prompt-list-view { /* ID for the prompt list in chat sidebar */
    height: 8; /* Adjust as needed */
    border: round $ds-surface-raised;
    margin-bottom: $ds-space-stack;
}
.loaded-prompt-area { /* Container for loaded prompt details in chat sidebar */
    margin-top: $ds-space-stack;
    padding: 0 $ds-space-inline;   /* Padding for content inside */
    background: $ds-surface-raised; /* Slightly different background to group elements */
    /* To get rounded corners for the area itself, apply a border style */
    border: round $primary-background-lighten-1; /* Example: round border with a light color */
                                               /* Or use 'round $surface' if you want it less distinct */
                                               /* Or 'none' if you only want background and no explicit border */
}
/* End of Character Sidebar Specific Styles */

/* --- Chat Settings Mode Styles --- */

/* Settings mode toggle container */
.settings-mode-container {
    layout: horizontal;
    height: $ds-control-height;
    width: 100%;
    align: center middle;
    margin-bottom: $ds-space-stack;
    padding: 0 $ds-space-inline;
}

/* Mode labels */
.mode-label {
    margin: 0 $ds-space-inline;
    color: $ds-text-muted;
}

/* Settings mode toggle switch */
.settings-mode-toggle {
    margin: 0 $ds-space-inline;
}

/* Settings search input */
.settings-search-input {
    width: 100%;
    margin-bottom: $ds-space-section;
    border: round $primary;
}



/* RAG preset select */
.rag-preset-select {
    width: 50%;
}

/* Section headers */
.section-header {
    text-style: bold underline;
    color: $primary;
    margin-bottom: $ds-space-stack;
    margin-top: $ds-space-stack;
}

.subsection-header {
    text-style: $ds-text-strong;
    color: $secondary;
    margin-bottom: $ds-space-stack;
    margin-top: $ds-space-stack;
}

/* Info text */
.info-text {
    color: $ds-text-muted;
    text-style: $ds-text-emphasis;
    margin-bottom: $ds-space-stack;
}

/* Hidden class for mode switching */
.hidden {
    display: none;
}

/* Search highlighting */
.search-hidden {
    display: none;
}

.search-highlighted {
    background: $warning 20%;
    border: round $warning;
}

/* Settings containers for mode switching */
#chat-basic-settings-container {
    width: 100%;
}

#chat-advanced-settings-container {
    width: 100%;
}

/* --- End Chat Settings Mode Styles ---*/

/* --- Enhanced Chat Settings Styles --- */

/* Mode toggle container */
.mode-toggle-container {
    layout: horizontal;
    height: 4;  /* Increased height to prevent cutoff */
    width: 100%;
    align: center middle;
    margin-bottom: $ds-space-stack;
    padding: 0 0 $ds-space-inset 0;  /* Add bottom padding */
}

/* Mode labels */
.mode-label {
    margin: 0 $ds-space-inline;
    color: $ds-text-muted;
}

/* Settings mode toggle switch */
.settings-mode-toggle {
    margin: 0 $ds-space-inline;
    /* Custom styling for better visibility */
    background: $ds-surface-panel;
    border: solid $primary;
}

/* Switch widget styling for better visibility */
.settings-mode-toggle > .switch--slider {
    background: $primary;  /* Neutral blue when off (Basic mode) */
}

.settings-mode-toggle.-on > .switch--slider {
    background: $accent;  /* Accent color when on (Advanced mode) */
}

/* Switch thumb/handle styling */
.settings-mode-toggle .switch--slider {
    border: solid $primary;
}

/* Advanced Settings checkbox styling */
.advanced-settings-checkbox {
    margin-top: $ds-space-stack;
    margin-bottom: $ds-space-stack;
}

.advanced-settings-checkbox > Checkbox {
    color: $ds-text-primary;
}

.advanced-settings-checkbox:hover {
    color: $accent;
}

/* Settings search input */
.settings-search-input {
    width: 100%;
    margin-bottom: $ds-space-section;
    border: round $primary;
}

/* RAG Settings Panel - Prominent styling */
.rag-settings-panel {
    padding: $ds-space-inset;
    border: round $ds-surface-raised;  /* Changed to match other panels */
    background: $ds-surface-panel;     /* Changed to standard panel background */
    margin-bottom: $ds-space-stack;
}

/* Remove extra padding from RAG panel content */
.rag-settings-panel Container {
    padding: 0;
    height: auto;
}

/* Highlight RAG panel when focused */
.rag-settings-panel:focus-within {
    border: round $ds-focus-accent;
    background: $ds-surface-panel;
}

/* Remove highlight when collapsed */
.rag-settings-panel.collapsed {
    border: round $ds-surface-raised !important;
    background: $ds-surface-panel !important;
}

/* RAG enable toggle */
.rag-enable-toggle {
    margin-bottom: $ds-space-stack;
}

/* RAG preset select */
.rag-preset-select {
    width: 100%;
    margin-bottom: $ds-space-stack;
}

/* RAG scope options */
.rag-scope-options {
    margin-bottom: $ds-space-stack;
}

.rag-scope-options Checkbox {
    margin-bottom: 0;
}

/* Ensure proper spacing for sidebar labels in RAG panel */
.rag-settings-panel .sidebar-label {
    margin-top: 0;
    margin-bottom: 0;
}

/* Advanced only sections - hidden by default in basic mode */
.advanced-only {
    display: none;
}

/* Show advanced sections when in advanced mode */
.sidebar.advanced-mode .advanced-only {
    display: block;
}

/* Hide advanced-only when in basic mode */
.sidebar.basic-mode .advanced-only {
    display: none;
}

/* Search highlighting */
.search-highlight {
    background: $warning 20%;
    border: round $warning;
}

/* --- End Enhanced Chat Settings Styles ---*/

/* --- Visual Polish: Standardized Button Classes --- */

/* Primary action buttons (Send, Submit) */
.btn-primary {
    background: $primary;
    color: $ds-text-primary;
    text-style: $ds-text-strong;
    border: none;
}

.btn-primary:hover {
    background: $primary-lighten-1;
}


/* Ghost buttons (text-only, minimal) */
.btn-ghost {
    background: transparent;
    color: $ds-text-muted;
    border: none;
}

.btn-ghost:hover {
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

/* --- End Visual Polish ---*/

/* Durable Watchlists operation receipts: compact enough for the Console's
   narrow transcript column, but visibly distinct from assistant prose. */
#console-watchlists-operation-cards {
    height: auto;
    min-height: 0;
    width: 1fr;
}

WatchlistsOperationCard {
    height: auto;
    min-height: 7;
    width: 1fr;
    margin: 0 0 $ds-space-stack 0;
    padding: 0 $ds-space-inline;
    border: round $ds-grid-line;
    background: $ds-surface-raised;
}

.watchlists-operation-status {
    height: $ds-control-height-compact;
    color: $ds-status-running;
    text-style: $ds-text-strong;
}

.watchlists-operation-title {
    height: $ds-control-height-compact;
    color: $ds-text-primary;
    text-style: $ds-text-strong;
}

.watchlists-operation-id {
    height: $ds-control-height-compact;
    color: $ds-text-muted;
}

.watchlists-operation-error {
    height: auto;
    max-height: 2;
    color: $ds-status-error-readable;
}

.watchlists-operation-actions {
    height: auto;
    min-height: $ds-control-height-compact;
    width: 1fr;
    margin: $ds-space-stack 0 0 0;
}

.watchlists-operation-actions Button {
    margin: 0 $ds-space-inline 0 0;
}
