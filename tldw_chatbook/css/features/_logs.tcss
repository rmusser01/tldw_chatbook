/* ========================================
 * FEATURES: Logs
 * ========================================
 * Logs destination: filter bar, log view, status line, action bar.
 * The user loop: reproduce a problem -> come here -> copy the relevant
 * lines -> share them for investigation. Nothing may occlude log content.
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


LogsWindow {
    layout: vertical;
}

/* The legacy `.window` class forces `layout: horizontal` (see
 * layout/_windows.tcss); outrank it by id so the Logs destination stays
 * vertical. */
#logs-window {
    layout: vertical;
}

/* Filter bar: level chips + text filter + pause toggle, single row. */
#logs-filter-bar {
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}

#logs-filter-bar Button {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    border: none;
    padding: $ds-space-0 $ds-space-1;
    background: $surface;
    color: $text-muted;
}

#logs-filter-bar Button.is-active {
    color: $text;
    text-style: bold underline;
}

#logs-filter-bar Button:hover {
    background: $surface;
    color: $text;
}

#logs-filter-text {
    width: $ds-width-fill;
    height: $ds-size-1;
    border: none;
    padding: $ds-space-0 $ds-space-1;
    background: $surface-darken-1;
}

#logs-pause {
    content-align: right middle;
}

/* The log itself takes all remaining space; one entry per row, long
 * lines scroll horizontally instead of wrapping mid-word. */
#app-log-display {
    height: $ds-height-fill;
    border: none;
    padding: $ds-space-0 $ds-space-1;
}

#logs-empty-state {
    color: $text-muted;
    padding: $ds-space-2;
    height: auto;
}

#logs-status-line {
    height: $ds-size-1;
    color: $text-muted;
    padding: $ds-space-0 $ds-space-1;
}

/* Action bar pinned at the bottom: the share actions, always visible,
 * never overlapping log content. */
#logs-action-bar {
    height: auto;
    padding: $ds-space-0 $ds-space-1;
}

#logs-action-bar Button {
    margin-right: $ds-space-1;
}
