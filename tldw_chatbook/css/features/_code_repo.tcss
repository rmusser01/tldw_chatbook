/* ========================================
 * Code Repository Copy/Paste Feature Styles
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


/* Repository browser container - now embedded in tab */
.repo-window-container {
    width: $ds-width-full;
    height: $ds-height-full;
    background: $surface;
    padding: $ds-space-0;
}

/* ========================================
 * Header Section
 * ======================================== */

.repo-header {
    dock: top;
    height: $ds-size-7;
    background: $boost;
    padding: $ds-space-1;
    border-bottom: solid $primary;
}

.repo-header-content {
    layout: grid;
    grid-size: 4 2;
    grid-columns: 3fr 1fr 1fr 1fr;
    grid-rows: 3 2;
    grid-gutter: 1 1;
    width: $ds-width-full;
}

.repo-url-input {
    width: $ds-width-full;
}

#repo-url-input {
    width: $ds-width-full;
}

#load-repo-btn {
    min-width: $ds-size-10;
}

#token-config-btn {
    min-width: $ds-size-8;
}

#token-config-btn.token-configured {
    background: $success 20%;
    border: solid $success;
}

#branch-selector {
    min-width: $ds-size-15;
}

#repo-settings-btn {
    width: $ds-size-3;
    min-width: $ds-size-3;
}

/* Selection summary */
.selection-summary {
    column-span: 4;
    layout: grid;
    grid-size: 3 1;
    grid-columns: 1fr 1fr 1fr;
    align: left middle;
    width: $ds-width-full;
}

.summary-stat {
    text-align: left;
    color: $text-muted;
}

/* ========================================
 * Filter Bar
 * ======================================== */

.filter-bar {
    dock: top;
    height: $ds-size-3;
    background: $panel;
    layout: grid;
    grid-size: 6 1;
    grid-columns: 2fr 1fr 3 3 3 1fr;
    grid-gutter: 0 1;
    padding: $ds-space-0 $ds-space-1;
    border-bottom: solid $primary-darken-1;
}

#file-search {
    width: $ds-width-full;
}

#file-type-filter {
    width: $ds-width-full;
}

.filter-quick-btn {
    width: $ds-size-3;
    height: $ds-size-3;
    min-width: $ds-size-3;
    padding: $ds-space-0;
    background: $surface;
    border: solid $primary-darken-2;
}

.filter-quick-btn:hover {
    background: $primary 30%;
    border: solid $primary;
}

/* ========================================
 * Main Content Area
 * ======================================== */

.main-content {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 2fr 3fr;
    height: $ds-height-fill;
    background: $background;
}

/* Tree container */
.tree-container {
    border-right: solid $primary;
    overflow: hidden;
    padding: $ds-space-1;
    background: $surface;
}

#repo-tree {
    height: $ds-height-full;
    width: $ds-width-full;
    border: none;
}

/* Preview container - now split into two sections */
.preview-panel {
    padding: $ds-space-1;
    overflow: hidden;
    background: $surface;
    layout: vertical;
    height: $ds-height-full;
}

/* Aggregated text container (top half) */
.aggregated-text-container {
    height: $ds-percent-50;
    margin-bottom: $ds-space-1;
    layout: vertical;
}

/* File preview container (bottom half) */
.file-preview-container {
    height: $ds-percent-50;
    layout: vertical;
}

.preview-header {
    height: $ds-size-3;
    border-bottom: dashed $primary-darken-2;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    align: left middle;
}

#preview-title {
    text-style: bold;
    color: $primary;
}

#compilation-title {
    text-style: bold;
    color: $primary;
}

.preview-content {
    height: $ds-height-fill;
    border: round $primary-darken-2;
    padding: $ds-space-1;
    background: $surface-darken-1;
    overflow-y: auto;
}

#file-preview {
    width: $ds-width-full;
    height: $ds-height-full;
    background: $surface-darken-1;
    padding: $ds-space-1;
}

#aggregated-text {
    width: $ds-width-full;
    height: $ds-height-full;
    background: $surface-darken-1;
    padding: $ds-space-1;
}

/* ========================================
 * Tree View Styles
 * ======================================== */

TreeView {
    height: $ds-height-full;
    width: $ds-width-full;
    overflow-y: auto;
    overflow-x: hidden;
    border: solid $primary-darken-2;
    padding: $ds-space-1;
    background: $surface;
}

.tree-container {
    width: $ds-width-full;
    height: auto;
}

.tree-loading {
    width: $ds-width-full;
    text-align: center;
    padding: $ds-space-2;
    color: $text-muted;
}

.tree-empty {
    width: $ds-width-full;
    text-align: center;
    padding: $ds-size-4;
    color: $text-muted;
}

/* Tree node styles */
TreeNode {
    height: $ds-size-3;
    width: $ds-width-full;
}

.tree-node-row {
    layout: grid;
    grid-size: 4 1;
    grid-columns: auto 3 3 1fr;
    height: $ds-size-3;
    align: left middle;
    width: $ds-width-full;
}

.tree-node-row:hover {
    background: $panel-lighten-1;
}

.tree-node-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.tree-indent {
    width: auto;
    content-align: left middle;
}

.tree-expand-btn {
    width: $ds-size-3;
    height: $ds-size-3;
    min-width: $ds-size-3;
    background: transparent;
    border: none;
    padding: $ds-space-0;
}

.tree-expand-btn:hover {
    background: $surface-lighten-1;
    color: $text;
}

.tree-expand-spacer {
    width: $ds-size-3;
    height: $ds-size-3;
}

.tree-checkbox {
    width: $ds-size-3;
    height: $ds-size-3;
}

.tree-content {
    padding-left: $ds-space-1;
    width: $ds-width-full;
    content-align: left middle;
}

/* ========================================
 * Action Bar
 * ======================================== */

.action-bar {
    dock: bottom;
    height: $ds-size-3;
    background: $panel;
    layout: grid;
    grid-size: 6 1;
    grid-columns: 1fr auto auto auto auto 1fr;
    grid-gutter: 0 1;
    align: center middle;
    padding: $ds-space-0 $ds-space-2;
    border-top: solid $primary;
}

.action-bar Button {
    min-width: $ds-size-15;
}

#reset-btn {
    min-width: $ds-size-10;
}

#generate-compilation-btn {
    min-width: $ds-size-20;
}

/* ========================================
 * Loading Overlay
 * ======================================== */

.loading-overlay {
    dock: top;
    width: $ds-width-full;
    height: $ds-height-full;
    background: $background 90%;
    align: center middle;
    layer: above;
}

.loading-overlay.hidden {
    display: none;
}

.loading-overlay LoadingIndicator {
    margin-bottom: $ds-space-2;
}

.loading-label {
    text-align: center;
    margin-top: $ds-space-2;
    text-style: bold;
    color: $text;
}

/* ========================================
 * Error Messages
 * ======================================== */

.error-message {
    color: $error;
    text-align: center;
    padding: $ds-space-2;
    text-style: bold;
}

/* ========================================
 * Responsive Adjustments
 * ======================================== */

/* Note: Textual doesn't support @media queries
   These styles would need to be applied dynamically
   based on terminal size detection in Python code */


/* ========================================
 * Syntax Highlighting Support
 * ======================================== */

#file-preview {
    /* monospace font style */
}
