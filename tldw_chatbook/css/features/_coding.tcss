/* ========================================
 * FEATURES: Coding Window
 * ======================================== 
 * Styles for the coding tab and its components
 * Includes sidebar navigation and content areas
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


/* Main container */
CodingWindow {
    layout: horizontal;
    height: $ds-height-full;
    width: $ds-width-full;
}

/* Navigation pane (left sidebar) */
.coding-nav-pane {
    dock: left;
    width: $ds-percent-25;
    min-width: $ds-size-20;
    max-width: $ds-size-40;
    background: $boost;
    padding: $ds-space-1 $ds-space-2;
    border-right: thick $background-darken-1;
    height: $ds-height-full;
    overflow-y: auto;
    overflow-x: hidden;
}

.coding-nav-pane.collapsed {
    width: $ds-size-0 !important;
    min-width: $ds-size-0 !important;
    border-right: none !important;
    padding: $ds-space-0 !important;
    overflow: hidden !important;
    display: none;
}

/* Navigation buttons */
.coding-nav-button {
    width: $ds-width-full;
    height: $ds-size-3;
    margin: $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-2;
    text-align: left;
    background: $surface;
}

.coding-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}

/* Content pane */
.coding-content-pane {
    height: $ds-height-full;
    width: $ds-width-full;
    padding: $ds-space-2;
    background: $background;
}

/* Sidebar toggle button */
#coding-sidebar-toggle-button {
    dock: left;
    width: $ds-size-3;
    height: $ds-size-3;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    padding: $ds-space-0;
    text-align: center;
    background: $surface;
}

#coding-sidebar-toggle-button.collapsed {
    dock: left;
    margin-left: $ds-space-0;
}

/* View areas */
.coding-view-area {
    height: $ds-height-full;
    width: $ds-width-full;
    padding: $ds-space-1;
}

/* Pane titles */
.coding-view-area .pane-title {
    text-style: bold underline;
    margin-bottom: $ds-space-1;
    width: $ds-width-full;
    text-align: center;
}

/* Code repository specific */
#coding-view-repo-copy-paste Vertical {
    height: auto;
    align: center middle;
    padding: $ds-space-2;
}

#coding-view-repo-copy-paste Label {
    margin-bottom: $ds-space-2;
    text-align: center;
}

#open-repo-selector {
    width: auto;
    min-width: $ds-size-30;
    height: $ds-size-3;
    margin-top: $ds-space-2;
}
