    layout: horizontal;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    margin: $ds-space-0;
    overflow-x: hidden;
}

#library-shell-grid.library-notes-compact #library-notes-status {
    width: $ds-width-fill;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#library-shell-grid.library-notes-compact #library-notes-filter-clear {
    width: auto;
}

#library-shell-grid.library-notes-compact #library-notes-selection-status {
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
}

#library-shell-grid.library-notes-compact #library-notes-list {
    width: $ds-width-fill;
    max-width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
    margin: $ds-space-0;
    padding: $ds-space-0;
    overflow-y: auto;
    overflow-x: hidden;
}

#library-shell-grid.library-notes-compact #library-notes-empty {
