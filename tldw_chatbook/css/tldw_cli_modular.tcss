/* ===== MODULE: core/_variables.tcss ===== */
/* ========================================
 * CORE: Variables and Constants
 * ======================================== 
 * CSS variables, color definitions, and sizing constants
 * Used throughout the application
 * ======================================== */

$ds-surface-panel: $panel;
$ds-surface-raised: $surface;
$ds-surface-inspector: $surface;
$ds-grid-line: $surface-lighten-1;
$ds-column-line: $surface-lighten-2;
$ds-text-primary: $text;
$ds-text-muted: $text-muted;
$ds-text-disabled: $text-disabled;
$ds-action-focus: $primary;
$ds-focus-fg: $ds-text-primary;
/* TASK-345: the focus background must be visibly distinct from resting
   surfaces — it previously aliased $ds-surface-raised (= $surface), which
   nullified the non-obscuring focus contract's own mechanism (~1.1:1 focus
   shifts measured live; an invisible-focus Tab+Enter activated 'Save as…').
   A raised steel-blue, ~3:1 against the dark control/panel surfaces, still
   muted enough to keep the contract's no-accent character. */
$ds-focus-bg: #51677e;
$ds-focus-accent: $primary;
$ds-input-focus-border: $primary;
$ds-input-focus-bg: $ds-surface-raised;
$ds-input-focus-accent: $primary;
$ds-status-ready: $success;
$ds-status-running: $primary;
$ds-status-info: $accent;
$ds-status-warning: $warning;
$ds-status-approval-required: $warning;
$ds-status-blocked: $error;
$ds-status-error: $error;
$ds-status-paused: $warning;
$ds-status-unsaved: $warning;
$ds-status-recovered: $success;
$ds-authority-local: $success;
$ds-authority-server: $primary;
$ds-authority-workspace: $accent;
$ds-authority-remote-only: $warning;
$ds-source-role-context: $accent;
$ds-source-role-evidence: $accent;
$ds-source-role-editable-target: $warning;
$ds-source-role-output-seed: $secondary;
$ds-destination-header-height: 1;
$ds-destination-compact-strip-height: 1;
$ds-home-dashboard-grid-height: 18;
$ds-home-control-button-height: 1;
$ds-home-compact-row-height: 1;
$ds-home-followup-row-height: 6;
$ds-console-workspace-grid-height: 1fr;
$ds-console-control-bar-height: 1;
$ds-console-composer-height: 5;
$ds-library-mode-chip-height: 1;
$ds-library-mode-chip-min-width: 10;
$ds-library-source-action-width: auto;
$ds-library-source-action-min-width: 0;
$ds-library-source-action-height: 1;
$ds-library-source-browser-width: 31;

/* ===== MODULE: core/_reset.tcss ===== */
/* ========================================
 * CORE: Reset/Normalize
 * ======================================== 
 * Base resets and default styles
 * ======================================== */

/* Visible non-obscuring keyboard focus fallback. */
*:focus {
    outline: solid $ds-focus-accent;
}

/* REMOVED: These rules were causing layout shifts and visual issues */
/* *:hover { border: none; } */
/* *:focus-within { border: none; } */

/* Widgets should maintain consistent dimensions across all states */
/* Focus and hover states should only change colors, not layout */

/* ===== MODULE: core/_base.tcss ===== */
/* ========================================
 * CORE: Base Styles
 * ======================================== 
 * Root elements: Screen, Header, Footer
 * Foundation for the entire application
 * ======================================== */

Screen { layout: vertical; }
Header { dock: top; height: 1; background: $panel; }
Footer { dock: bottom; height: 1; background: $panel; }
#content { height: 1fr; width: 100%; }

/* App-wide scrollbar defaults (TASK-394). Consolidated here -- a deliberate
 * foundation rule -- from the two bare `VerticalScroll` selectors that had
 * leaked out of feature modules (the splash/theme module and _conversations);
 * this is the union of what both set, so the effective app-wide scrollbar is
 * unchanged. */
VerticalScroll {
    scrollbar-background: $surface-darken-1;
    scrollbar-color: $primary;
    scrollbar-color-hover: $primary-lighten-1;
    scrollbar-color-active: $primary-lighten-2;
    scrollbar-size: 1 1;
}

/* ===== MODULE: core/_typography.tcss ===== */
/* ========================================
 * CORE: Typography
 * ======================================== 
 * Text styles, fonts, and text decorations
 * ======================================== */

/* ===== MODULE: layout/_windows.tcss ===== */
/* ========================================
 * LAYOUT: Windows
 * ======================================== 
 * Base window styles and window management
 * ======================================== */

/* Base style for ALL windows. The watcher will set display: True/False */
.window {
    height: 100%;
    width: 100%;
    layout: horizontal; /* Or vertical if needed by default */
    overflow: hidden;
}

.placeholder-window { 
    align: center middle; 
    background: $panel; 
    display: none;  /* Placeholders should always be hidden */
}

/* ===== MODULE: layout/_tabs.tcss ===== */
/* ========================================
 * LAYOUT: Tab System
 * ======================================== 
 * Tab navigation and tab button styles
 * ======================================== */

#tabs { dock: top; height: 4; background: $background; padding: 0 1; }
#tabs Button { 
    width: 1fr; 
    height: 100%; 
    min-height: 4;
    border: none;  /* No border for tab buttons */
    background: $panel; 
    color: $text-muted; 
    padding: 0 1;
}
#tabs Button:hover { 
    background: $panel-lighten-1; 
    color: $text;
}
#tabs Button.-active { 
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Single-line tab links navigation */
#tab-links-container {
    dock: top;
    height: 4;
    background: $panel;
    padding: 0 1;
    border: solid $accent;
}

#tab-links-inner {
    layout: horizontal;
    height: auto;
    width: auto;
    background: transparent;
    margin: 0;
    padding: 0;
}

#tab-links-inner > Static {
    width: auto;
    height: 1;
    margin: 0;
}

.tab-link {
    color: $text-muted;
    padding: 0 1;
    text-style: none;
    width: auto;
    height: auto;
}

.tab-link:hover {
    color: $text;
    text-style: underline;
    background: $panel-lighten-1;
}

.tab-link.-active {
    color: $ds-focus-fg;
    text-style: bold underline;
    background: transparent;
}

.tab-link.-active:hover {
    text-style: bold underline;
}

Tab.-active,
Tabs:focus .-active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.tab-separator {
    color: $text-muted;
    padding: 0;
    width: auto;
    height: 1;
}

/* Group separators - visually heavier than within-group separators */
.tab-group-separator {
    color: $accent;
    padding: 0 2;
    width: auto;
    height: 1;
    text-style: bold;
}

/* Group separator in button-based tab bar */
#tabs .tab-group-separator {
    width: auto;
    min-width: 3;
    height: 100%;
    min-height: 4;
    background: transparent;
    color: $accent;
    border: none;
    padding: 0 1;
}

/* ===== MODULE: layout/_sidebars.tcss ===== */
/* ========================================
 * LAYOUT: Sidebars
 * ======================================== 
 * Generic sidebar patterns and collapsible behavior
 * Used across multiple features
 * ======================================== */

/* ----------------------------------------
 * Enhanced Sidebar Styles
 * ---------------------------------------- */

/* Enhanced sidebar container */
.enhanced-sidebar {
    height: 100%;
    background: $boost;
}

/* Sidebar header with improved visibility */
.sidebar-header {
    height: 3;
    padding: 0 1;
    background: $surface;
    border-bottom: solid $surface-lighten-1;
    align: center middle;
}

.sidebar-title {
    text-style: bold;
    color: $text;
    text-align: left;
}

/* Search container with better visibility */
.search-container {
    height: 3;
    padding: 0 1;
    background: transparent;
    border-bottom: none;
}

.search-input {
    width: 100%;
    border: round $surface-lighten-1;
    background: $background;
}

/* ----------------------------------------
 * Visual Grouping & Organization
 * ---------------------------------------- */

/* Quick Actions Bar */
.quick-actions-bar {
    height: 3;
    padding: 0 1;
    margin-bottom: 1;
    background: $primary 10%;
    border-bottom: solid $primary;
}

.quick-action-btn {
    width: auto;
    margin: 0 1;
    padding: 0 1;
}

/* Search Input */
.sidebar-search-input {
    width: 100%;
    margin: 1 0;
    border: round $accent;
}

/* Group Headers */
.group-header {
    text-style: bold;
    color: $text-muted;
    margin: 1 0;
    padding: 0 1;
}

/* Section Dividers */
.sidebar-section-divider {
    height: 1;
    margin: 2 0;
    border-top: solid $primary 30%;
    opacity: 50%;
}

/* Settings Groups with Enhanced Visibility */
.settings-group {
    padding-left: 1;
    margin: 1 0;
}

/* Improved contrast - from 5% to 15-20% */
.primary-group {
    background: $success 15%;
}

.secondary-group {
    background: $primary 15%;
}

.advanced-group {
    background: $warning 15%;
}

/* Enhanced setting groups with clear visual hierarchy */
.setting-group {
    margin: 2 0;
    padding: 1;
}

.setting-group-essential {
    border-left: solid $success;
    background: transparent;
}

.setting-group-common {
    border-left: solid $primary;
    background: transparent;
}

.setting-group-advanced {
    border-left: solid $warning;
    background: transparent;
}

/* Priority Indicators */
.priority-high > CollapsibleTitle {
    text-style: bold;
    border-left: thick $success;
    padding-left: 1;
}

/* Nested indentation */
.settings-group .settings-collapsible {
    margin-left: 1;
}

/* Fix for Collapsible widgets in sidebars */
.settings-collapsible {
    height: auto;
    min-height: 3;  /* Ensure title is visible */
}

.settings-collapsible CollapsibleTitle {
    height: auto;
    min-height: 1;
    padding: 0 1;
}

.settings-collapsible Contents {
    height: auto;
    padding: 1;
}

/* Ensure checkboxes and other controls are visible */
.settings-collapsible Checkbox {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.settings-collapsible Input {
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
}

.settings-collapsible Select {
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
}

/* Sidebar Styling */
/* Generic .sidebar (used by #chat-left-sidebar and potentially others) */
.sidebar {
    dock: left;
    width: 25%; /* Reduced from 35% for better chat area space */
    min-width: 35; /* Reduced from 45 */
    max-width: 80; /* Maximum width (optional) */
    background: $boost;
    padding: 0 1;
    border-right: solid $surface;
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
}
/* Collapsed state for the existing left sidebar */
.sidebar.collapsed {
    width: 0 !important;
    min-width: 0 !important; /* Ensure min-width is also 0 */
    border-right: none !important;
    padding: 0 !important;
    overflow: hidden !important;
    display: none; /* ensures it doesn't grab focus */
}

/* Common sidebar elements */
.sidebar-title { text-style: bold; margin-bottom: 1; width: 100%; text-align: left; }

/* Sidebar header with resize controls */
.sidebar-header-with-resize {
    height: 2;
    align: left middle;
    margin-bottom: 1;
}

.sidebar-header-with-resize .flex-grow {
    width: 1fr;
}

.sidebar-label { margin-top: 1; text-style: bold; }
.sidebar-input {
    width: 100%;
    margin-bottom: 1;
    border: solid $primary-lighten-2;
    border-bottom: solid $primary-lighten-2;
}
.sidebar-textarea { 
    width: 100%; 
    height: 5;  /* Default height for text areas */
    border: round $surface; 
    margin-bottom: 1; 
}

/* Notes expand button */
/* T169: the two legacy "notes content header"/"notes content label"
 * classes previously declared here were pruned -- pre-workbench Notes tab
 * CSS (Notes_Window.py, since removed) with zero live references anywhere
 * in tldw_chatbook/*.py. .notes-expand-button below is still live (Chat
 * sidebar's "Notes" expand control). */
.notes-expand-button {
    width: auto;
    min-width: 12;
    height: 3;
    margin-left: 1;
    padding: 0 2;
    color: $text;
    background: $surface;
    text-style: bold;
    text-align: center;
}

/* Ensure button text is visible */
#chat-notes-expand-button {
    color: $text !important;
}

/* General sidebar button styling */
.sidebar-button {
    width: 100%;
    height: 3;
    margin: 1 0;
    padding: 0 2;
    text-align: center;
}

/* Notes textarea states */
.notes-textarea-normal {
    height: 10;
}

.notes-textarea-expanded {
    height: 25;
    border: round $accent;
}
.sidebar Select { 
    width: 100%; 
    margin-bottom: 1; 
    border: solid $primary-lighten-2;
    border-bottom: solid $primary-lighten-2;
}

.prompt-display-textarea {
    height: 7; /* Example height */
    border: round $primary-lighten-2;
    background: $primary-background;
}

.sidebar-listview {
    height: 10; /* Example height for listviews in sidebars */
    border: round $primary-lighten-2;
    background: $primary-background;
}

/* Enhanced sidebar sections with UX improvements */
.sidebar-section-collapsible {
    margin-bottom: 1;
    border: round $surface-lighten-1;
    background: $surface;
}

.sidebar-section-collapsible:focus-within {
    border: round $ds-focus-accent;
    background: $ds-focus-bg;
}

/* Section loading state */
.section-loading {
    align: center middle;
    height: 3;
}

.loading-fade {
    opacity: 50%;
}

/* Search mode indicator */
.sidebar.search-active {
    border: solid $warning;
}

/* ----------------------------------------
 * Enhanced Sidebar Components
 * ---------------------------------------- */

/* Tab content styling */
.tab-content {
    padding: 1;
    height: 100%;
}

/* Setting labels and inputs with better spacing */
.setting-label {
    margin-top: 1;
    margin-bottom: 0;
    text-style: bold;
    color: $text-muted;
    text-align: left;
}

.setting-input {
    width: 100%;
    margin-bottom: 1;
    border: solid $primary-lighten-1;
    border-bottom: solid $primary-lighten-1;
}

/* Modified settings indicator */
.setting-modified {
    border: solid $accent !important;
    background: $accent 10% !important;
}

/* Temperature visual indicator */
.temperature-container {
    height: 3;
    align: left middle;
}

.temperature-input {
    width: 70%;
}

.temp-indicator {
    width: 30%;
    text-align: center;
    padding-left: 1;
}

/* System prompt styling */
.system-prompt-input {
    width: 100%;
    height: 8;
    border: round $surface;
    margin-bottom: 1;
    background: $background 5%;
}

/* New chat buttons */
.new-chat-buttons {
    height: 3;
    margin: 1 0;
    align: center middle;
}

.primary-button {
    width: 45%;
    margin: 0 1;
}

.secondary-button {
    width: 45%;
    margin: 0 1;
}

/* Info display fields */
.info-display {
    width: 100%;
    margin-bottom: 1;
    background: $surface 20%;
    color: $text-muted;
}

/* Checkbox styling */
.streaming-toggle, .advanced-toggle {
    margin: 1 0;
    padding: 0 1;
}

/* TabbedContent customization */
TabbedContent {
    height: auto;
}

TabbedContent > TabPane {
    padding: 0;
    height: auto;
}

TabbedContent Tabs {
    background: $surface 10%;
    height: 3;
}

TabbedContent Tab {
    padding: 0 1;
}

TabbedContent Tab.-active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Hide the tab underline indicator */
TabbedContent Underline {
    height: 0;
    display: none;
}

/* Search results styling */
.search-results {
    padding: 1;
}

.search-result-item {
    margin: 1 0;
    padding: 1;
    background: $surface 10%;
    border: round $surface-lighten-1;
}

.search-result-item:hover {
    background: $surface-lighten-1;
    color: $text;
    border: round $surface-lighten-2;
}

/* Highlight matched text in search */
.search-highlight {
    background: $warning 30%;
    text-style: bold;
}

/* Loading indicator for lazy tabs */
.tab-loading {
    align: center middle;
    height: 10;
}

/* Reset button styling */
.reset-button {
    width: auto;
    min-width: 3;
    height: 2;
    padding: 0 1;
    background: $warning 20%;
    border: tall $warning;
}

.reset-button:hover {
    background: $surface-lighten-1;
    color: $text;
}

/* Note: Textual doesn't support @media queries for responsive design
   These rules would need to be applied programmatically based on screen size */

/* --- End of Sidebar Styling --- */

/* ===== MODULE: layout/_panes.tcss ===== */
/* ========================================
 * LAYOUT: Panes
 * ======================================== 
 * Multi-pane layouts (2-pane, 3-pane, etc)
 * ======================================== */

.destination-workbench {
    height: 1fr;
    min-height: 0;
    width: 100%;
}

.destination-workbench-pane {
    width: 1fr;
    min-width: 0;
    height: 100%;
    min-height: 0;
    padding: 0 1;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
}

.destination-pane-title {
    height: 1;
    min-height: 1;
    text-style: bold;
    color: $ds-text-primary;
}

.destination-mode-strip,
.destination-filter-strip,
.destination-footer-row {
    height: 1;
    min-height: 1;
    padding: 0 1;
}

/* ===== MODULE: layout/_containers.tcss ===== */
/* ========================================
 * LAYOUT: Containers
 * ======================================== 
 * Section containers, subsections, and content areas
 * ======================================== */

/* TabbedContent height fixes */
#config-tabs {
    height: 100%;
    width: 100%;
}

#config-tabs TabPane {
    height: 100%;
    width: 100%;
    padding: 1;
}

/* Container for the HorizontalScroll, this takes the original #tabs styling for docking */
#tabs-outer-container {
    dock: top;
    height: 3; /* Or your desired tab bar height */
    background: $background; /* Or your tab bar background */
    padding: 0 1; /* Padding for the overall bar */
    width: 100%;
    margin-top: 1; /* Add buffer space above the tab bar */
}

/* The HorizontalScroll itself, which will contain the buttons */
#tabs {
    width: 100%;
    height: 100%; /* Fill the outer container's height */
    overflow-x: auto !important; /* Ensure horizontal scrolling is enabled */
    /* overflow-y: hidden; /* Usually not needed for a single row of tabs */
}

#tabs Button {
    width: auto;         /* Let button width be determined by content + padding */
    min-width: 10;       /* Minimum width to prevent squishing too much */
    height: 100%;        /* Fill the height of the scrollable area */
    border: none; /* Your existing style */
    background: $panel;  /* Your existing style */
    color: $text-muted;  /* Your existing style */
    padding: 0 2;        /* Add horizontal padding to buttons */
    margin: 0 1 0 0;     /* Small right margin between buttons */
}

#tabs Button:last-of-type { /* No margin for the last button */
    margin-right: 0;
}

#tabs Button:hover {
    background: $panel-lighten-1; /* Your existing style */
    color: $text;                 /* Your existing style */
}

/* ===== MODULE: components/_buttons.tcss ===== */
/* ========================================
 * COMPONENTS: Buttons
 * ======================================== 
 * All button variants and states
 * ======================================== */

/* Base button style with enhanced UX */
Button {
    /* No border by default - rely on background color for visual appearance */
    border: none;
}

/* Shared hover state with readable, non-obscuring cues */
Button:hover {
    background: $surface-lighten-1;
    color: $text;
    text-style: bold;
}

/* Enhanced focus state with visible, non-obscuring cues */
Button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

/* When both hovering AND focused */
Button:hover:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

/* Disabled state */
Button:disabled {
    opacity: 50%;
    background: $surface-darken-1;
    color: $text-disabled;
}

Button:disabled:hover {
    background: $surface-darken-1;
    text-style: none;
}

.sidebar-toggle {
    width: 1fr;              /* Equal flexible width */
    height: 3;
    /* margin-right: 1; Removed default margin, apply specific below */
    border: none;
    background: $surface-darken-1;
    color: $text;
}
.sidebar-toggle:hover { background: $surface; }

/* ===== MODULE: components/_forms.tcss ===== */
/* ========================================
 * COMPONENTS: Forms
 * ======================================== 
 * Form elements: inputs, textareas, selects
 * ======================================== */

.form-label {
    margin-bottom: 1;
    text-style: bold;
}

.form-section-title {
    text-style: bold;
    color: $secondary;
    margin: 2 0 1 0;
    border-bottom: solid $primary-background;
    padding-bottom: 1;
}

.form-description {
    color: $text-muted;
    margin-bottom: 2;
    text-style: italic;
}

.form-actions {
    margin-top: 2;
    layout: horizontal;
    height: auto;
    align: center middle;
}

.form-actions Button {
    margin: 0 1 0 0;
}

.provider-models-textarea {
    height: 5;
    margin-bottom: 1;
}

/* Standardized form components */
.form-input {
    width: 100%;
    margin-bottom: 1;
}

.form-textarea {
    width: 100%;
    height: auto;
    min-height: 5;
    margin-bottom: 1;
}


.form-checkbox {
    margin: 1 0;
}

/* Form layout helpers */
.form-row {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.form-col {
    width: 1fr;
    padding: 0 1;
}

.form-col:first-child {
    padding-left: 0;
}

.form-col:last-child {
    padding-right: 0;
}

/* Form sections */
.form-section-collapsible {
    margin: 1 0;
}

/* Button groups */
.button-group {
    width: 100%;
    height: auto;
    margin: 2 0;
}

.button-group-left {
    align: left top;
}

.button-group-center {
    align: center top;
}

.button-group-right {
    align: right top;
}

.form-button {
    margin: 0 1;
}

/* Status areas */
.status-label {
    margin-top: 2;
    margin-bottom: 0;
    color: $text-muted;
}

.status-area {
    width: 100%;
    background: $surface;
    border: round $border;
    padding: 1;
    margin-top: 1;
}

/* Title/Author input fields fix */
.title-author-row Input {
    height: 3;
    width: 100%;
    margin-bottom: 1;
}

Input:focus,
TextArea:focus,
Select:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

ToggleButton:focus {
    border: solid $ds-focus-accent;
    background: $surface;
}

ToggleButton:focus > .toggle--label,
ToggleButton.-textual-compact:focus > .toggle--label,
ToggleButton:blur:hover > .toggle--label {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

Switch:focus {
    border: solid $ds-focus-accent;
    background: $ds-focus-bg;
}

/* New base media ingestion form styling */
.form-input {
    height: 3;
    width: 100%;
    margin-bottom: 1;
    border: solid $primary;
    padding: 0 1;
}

.form-input:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

.form-input.error {
    border: solid $error;
    background: $error 10%;
}

.form-select {
    height: 3;
    width: 100%;
    margin-bottom: 1;
}

.form-checkbox {
    margin: 1 0;
}

/* Responsive metadata columns */
.metadata-row {
    layout: horizontal;
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.metadata-col {
    width: 1fr;
    height: auto;
}

/* Mode toggle section - CRITICAL for visibility */
.mode-toggle-container {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    padding: 1;
}

.mode-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.mode-toggle {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

/* Essential container sections - CRITICAL for Input widget visibility */
.essential-section {
    width: 100%;
    height: auto;        /* Allow container to size to content */
    margin-bottom: 2;
    padding: 1;
}

.media-options-section {
    width: 100%;
    height: auto;
    margin-bottom: 2;
}

.options-section {
    width: 100%;
    height: auto;
    margin-bottom: 2;
    padding: 1;
}

.process-button-section {
    width: 100%;
    height: auto;
    margin-top: 2;
    padding: 1;
    align: center middle;
}

/* Time range inputs layout */
.time-range-row {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.time-col {
    width: 1fr;
    height: auto;
    padding: 0 1;
}

.time-col:first-child {
    padding-left: 0;
}

.time-col:last-child {
    padding-right: 0;
}

/* Advanced mode visibility controls */
.advanced-only {
    display: block;
}

.simple-mode .advanced-only {
    display: none;
}

.advanced-mode .advanced-only {
    display: block;
}

/* Form textarea styling */
.form-textarea {
    width: 100%;
    min-height: 5;
    max-height: 10;
    margin-bottom: 1;
    border: solid $primary;
    padding: 1;
}

.form-textarea:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

/* Note: Textual doesn't support @media queries
   Responsive behavior must be handled programmatically
   in the Python code using terminal size detection */

/* ===== MODULE: components/_lists.tcss ===== */
/* ========================================
 * COMPONENTS: Lists
 * ======================================== 
 * ListViews, list items, and list patterns
 * ======================================== */

ListView ListItem {
    padding: 0 1;
    height: auto;
}

ListView ListItem:hover {
    background: $surface-lighten-1;
    color: $text;
}

ListView ListItem.-highlight {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

DataTable > .datatable--cursor {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

DataTable > .datatable--hover {
    background: $surface-lighten-1;
    color: $text;
}

DataTable > .datatable--selected {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

OptionList > .option-list--option-highlighted,
OptionList:focus > .option-list--option-highlighted,
SelectionList > .selection-list--button-highlighted,
SelectionList > .selection-list--button-selected,
SelectionList > .selection-list--button-selected-highlighted,
Tree > .tree--cursor,
Tree:focus > .tree--cursor {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

/* TASK-368: the discovered-model SelectionList checkbox glyph (▐X▌) must clearly
   distinguish selected from unselected. The shared native-choice contract above
   paints the toggle classes the same ($surface/$text), erasing the
   checked/unchecked distinction and rendering the ▐▌ caps fg==bg (invisible).
   Scope a distinct toggle to THIS list only (id specificity). The CHECKED states
   are a sanctioned high-contrast override (the $ds-focus contract); the base
   unchecked glyph renders as an empty box (no inner X). `-button-highlighted`
   (an unchecked row under the cursor) is left to the shared contract above. */
#settings-discovered-models-list .selection-list--button {
    color: $ds-grid-line;
    background: $ds-grid-line;
}
#settings-discovered-models-list .selection-list--button-selected,
#settings-discovered-models-list .selection-list--button-selected-highlighted {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* TASK-430 AC#1: the file picker's list must show a clearly-visible selected
   row. The generic OptionList rule above paints $surface (≈ dialog
   background), which is near-invisible; scope a higher-contrast focus token
   to the picker list only, using the sanctioned non-obscuring focus color
   (TASK-345). */
#file-list-pane .option-list--option-highlighted {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

OptionList > .option-list--option-hover,
Tree > .tree--highlight-line {
    background: $surface-lighten-1;
    color: $text;
}

/* ===== MODULE: components/_navigation.tcss ===== */
/* ========================================
 * COMPONENTS: Navigation
 * ======================================== 
 * Navigation patterns and menus
 * ======================================== */

/* ===== MODULE: components/_messages.tcss ===== */
/* ========================================
 * COMPONENTS: Messages
 * ======================================== 
 * Message display components
 * ======================================== */

ChatMessage {
    width: 100%;
    height: auto;
    max-height: 50vh;  /* Limit message height to 50% of viewport */
    margin-bottom: 1;
    overflow-y: auto;  /* Allow scrolling within long messages */
}
ChatMessage > Vertical {
    border: round $surface;
    background: $panel;
    padding: 0 1;
    width: 100%;
    height: auto;
}
ChatMessage.-user > Vertical {
    background: $boost; /* Different background for user */
    border: round $accent;
}
ChatMessage.-tool-call > Vertical {
    background: $surface-lighten-1;
    border: round $warning;
}
ChatMessage.-tool-result > Vertical {
    background: $surface-lighten-1;
    border: round $success;
}
.message-header {
    width: 100%;
    padding: 0 1;
    background: $surface-darken-1;
    text-style: bold;
    height: 1; /* Ensure header is minimal height */
}
.message-text {
    padding: 1; /* Padding around the text itself */
    width: 100%;
    height: auto;
    max-height: 40vh;  /* Limit text area to 40% of viewport */
    overflow-y: auto;  /* Allow scrolling within long text */
}

.message-text.tts-generating {
    opacity: 0.8;
    border-left: thick $accent;
}
.message-actions {
    height: auto;
    width: 100%;
    padding: 1; /* Add padding around buttons */
    /* Use a VALID border type */
    border-top: solid $surface-lighten-1; /* CHANGED thin to solid */
    align: right middle; /* Align buttons to the right */
    display: block; /* Default display state */
}
.message-actions Button {
    min-width: 8;
    height: 1;
    margin: 0 0 0 1; /* Space between buttons */
    border: none;
    background: $surface-lighten-2;
    color: $text-muted;
}
.message-actions Button:hover {
    background: $surface;
    color: $text;
}
.message-actions Button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}
.message-actions Button:focus:hover {
    background: $ds-surface-raised;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}
/* Initially hide AI actions until generation is complete */
ChatMessage.-ai .message-actions.-generating {
    display: none;
}

/* ===== MODULE: components/_dialogs.tcss ===== */
/* ========================================
 * COMPONENTS: Dialogs
 * ======================================== 
 * Modal dialogs and popup styles
 * ======================================== */

/* ===== MODULE: components/_status.tcss ===== */
/* ========================================
 * COMPONENTS: Status
 * ======================================== 
 * Status indicators and displays
 * ======================================== */

/* ===== MODULE: components/_agentic_terminal.tcss ===== */
/* ========================================
 * COMPONENTS: Agentic Terminal Design System
 * ========================================
 * Shared shell primitives for Home, Console, destination wrappers, status,
 * recovery, source authority, approvals, events, forms, toolbars, and shortcuts.
 *
 * Semantic token contract:
 * ds-surface-panel, ds-text-primary, ds-action-focus,
 * ds-status-ready, ds-status-running, ds-status-warning, ds-status-error,
 * ds-status-paused, ds-status-blocked, ds-status-approval-required,
 * ds-authority-local, ds-authority-server, ds-authority-workspace,
 * ds-source-role-context, ds-source-role-evidence,
 * ds-source-role-editable-target, ds-source-role-output-seed.
 *
 * Required readable status labels:
 * Ready, Running, Paused, Blocked, Unavailable, Approval required, Unsaved, Recovered.
 * ======================================== */

.ds-destination-header {
    height: auto;
    min-height: 3;
    padding: 1 2;
    margin: 0 0 1 0;
    border: tall $ds-action-focus;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-style: bold;
}

.ds-panel {
    height: auto;
    min-height: 3;
    padding: 1 2;
    margin: 0 0 1 0;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.ds-inspector {
    height: auto;
    min-width: 24;
    padding: 1;
    border: round $ds-grid-line;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
}

.ds-status-badge {
    width: auto;
    height: 1;
    padding: 0 1;
    text-style: bold;
    color: $ds-text-primary;
    background: $ds-surface-raised;
}

.ds-recovery-callout {
    height: auto;
    padding: 1 2;
    border: round $ds-status-warning;
    background: $ds-status-warning 10%;
    color: $ds-text-primary;
}

.ds-source-role {
    width: auto;
    height: 1;
    padding: 0 1;
    border: round $ds-source-role-context;
    color: $ds-text-primary;
    background: $ds-surface-raised;
}

.ds-approval-card {
    height: auto;
    padding: 1 2;
    border: thick $ds-status-approval-required;
    background: $ds-status-approval-required 12%;
    color: $ds-text-primary;
}

.ds-event-row {
    height: auto;
    min-height: 1;
    padding: 0 1;
    border-bottom: solid $ds-grid-line;
    color: $ds-text-primary;
}

/* Field rows are label-above-value: every current user (Personas card and
   editors) composes them as Vertical containers, so the row must not force a
   horizontal layout (it jammed "Name"+value side by side and squeezed Inputs
   into the leftover width). */
.ds-field-row {
    height: auto;
    min-height: 2;
    padding: 0 1;
}

.ds-toolbar {
    height: auto;
    min-height: 1;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

ConsoleSettingsModal {
    align: center middle;
}

#console-settings-modal {
    width: 92;
    max-width: 95%;
    height: 90%;
    max-height: 95%;
    overflow: hidden;
    scrollbar-size: 1 1;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: 1 2;
}

#console-settings-body {
    height: 1fr;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

.console-settings-modal-section {
    height: auto;
    margin: 1 0 0 0;
}

.console-settings-primary-section {
    padding: 0 1;
    border: round $ds-action-focus;
    background: $ds-surface-raised;
}

.console-settings-modal-row {
    height: auto;
    min-height: 1;
}

.console-settings-modal-label {
    width: 16;
    min-width: 16;
    max-width: 16;
    height: 1;
    min-height: 1;
    content-align: left middle;
}

.console-settings-control {
    width: 1fr;
    min-width: 0;
}

ConsoleSettingsModal Input {
    width: 1fr;
    min-width: 0;
    height: 3;
    min-height: 3;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

ConsoleSettingsModal Select {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

ConsoleSettingsModal Checkbox {
    height: 1;
    min-height: 1;
}

ConsoleSettingsModal Select > SelectCurrent {
    width: 1fr;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    content-align: left middle;
}

ConsoleSettingsModal Select > SelectCurrent Static#label {
    width: 1fr;
    height: 1;
    background: transparent;
    color: $ds-text-primary;
}

ConsoleSettingsModal Select > SelectCurrent .arrow {
    background: transparent;
    color: $ds-text-muted;
}

ConsoleSettingsModal Input:focus {
    height: 3;
    min-height: 3;
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

ConsoleSettingsModal Input > .input--cursor {
    background: $ds-input-focus-accent;
    color: $ds-surface-panel;
}

ConsoleSettingsModal Input > .input--selection {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}

ConsoleSettingsModal Select:focus {
    border: none;
    border-bottom: none;
    outline: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

ConsoleSettingsModal Select:focus > SelectCurrent {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

ConsoleSettingsModal Select > SelectOverlay {
    padding: 0 1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    min-width: 30;
}

ConsoleSettingsModal Select > SelectOverlay Option {
    padding: 0 2;
    min-height: 3;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
}

ConsoleSettingsModal Select > SelectOverlay Option:hover {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

ConsoleSettingsModal Select > SelectOverlay Option.-selected {
    padding: 0 2;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-settings-modal-actions {
    height: 1;
    min-height: 1;
    margin: 1 0 0 0;
    align-horizontal: right;
}

#console-settings-cancel,
#console-settings-save {
    width: 12;
    min-width: 12;
    height: 1;
    min-height: 1;
}

.console-settings-error {
    height: auto;
    min-height: 1;
    max-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $ds-status-error 10%;
    color: $ds-text-primary;
}

ConsolePromptPickerModal {
    align: center middle;
}

#console-prompt-picker-modal {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 85%;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: 1 2;
}

#console-prompt-picker-filter {
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-prompt-picker-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

#console-prompt-picker-results {
    height: auto;
    max-height: 20;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

.console-prompt-picker-row {
    width: 100%;
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-prompt-picker-row-highlighted {
    border: tall $ds-action-focus;
    background: $ds-input-focus-bg;
    text-style: bold;
}

.console-prompt-picker-row-blocked {
    color: $ds-text-muted;
}

#console-prompt-picker-reason {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $ds-status-error 10%;
    color: $ds-text-primary;
}

#console-prompt-picker-empty {
    height: auto;
    margin: 1 0;
    color: $ds-text-muted;
}

ConsoleSkillPickerModal {
    align: center middle;
}

#console-skill-picker-modal {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 85%;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: 1 2;
}

#console-skill-picker-filter {
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-skill-picker-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

#console-skill-picker-results {
    height: auto;
    max-height: 20;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

.console-skill-picker-row {
    width: 100%;
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-skill-picker-row-highlighted {
    border: tall $ds-action-focus;
    background: $ds-input-focus-bg;
    text-style: bold;
}

#console-skill-picker-empty {
    height: auto;
    margin: 1 0;
    color: $ds-text-muted;
}

ConsoleStylePickerModal {
    align: center middle;
}

#console-style-picker-modal {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 85%;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: 1 2;
}

#console-style-picker-filter {
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-style-picker-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

#console-style-picker-results {
    height: auto;
    max-height: 20;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

.console-style-picker-row {
    width: 100%;
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-style-picker-row-highlighted {
    border: tall $ds-action-focus;
    background: $ds-input-focus-bg;
    text-style: bold;
}

#console-style-picker-empty {
    height: auto;
    margin: 1 0;
    color: $ds-text-muted;
}

#console-style-picker-detail {
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-muted;
}

ConsoleSystemPromptModal {
    align: center middle;
}

#console-system-prompt-modal {
    width: 84;
    max-width: 95%;
    height: 32;
    max-height: 90%;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: 1 2;
}

.console-system-prompt-row {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.console-system-prompt-label {
    width: 8;
    min-width: 8;
    max-width: 8;
    height: 1;
    min-height: 1;
    content-align: left middle;
}

#console-system-prompt-scope {
    color: $ds-text-muted;
}

#console-system-prompt-text {
    width: 100%;
    height: 1fr;
    min-height: 10;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-system-prompt-text:focus {
    border: tall $ds-input-focus-accent;
    background: $ds-input-focus-bg;
}

#console-system-prompt-name {
    width: 1fr;
    min-width: 0;
    height: 3;
    min-height: 3;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-system-prompt-save-status {
    color: $ds-text-muted;
}

.console-system-prompt-actions {
    height: 3;
    min-height: 3;
    align-horizontal: right;
}

#console-system-prompt-clear,
#console-system-prompt-cancel,
#console-system-prompt-apply {
    width: 12;
    min-width: 12;
    height: 3;
    min-height: 3;
}

#home-dashboard,
#console-shell,
#library-shell,
#artifacts-shell,
#personas-shell,
#watchlists-collections-shell,
#schedules-shell,
#mcp-shell,
#acp-shell,
#skills-shell,
#settings-shell {
    height: 100%;
    min-height: 0;
}

#home-title,
#console-title,
#library-title,
#artifacts-title,
#personas-title,
#watchlists-collections-title,
#schedules-title,
#workflows-title,
#mcp-title,
#acp-title,
#skills-title,
#settings-title {
    height: $ds-destination-header-height;
    min-height: $ds-destination-header-height;
    padding: 0 1;
    margin: 0;
    border: none;
}

#home-purpose,
#console-purpose,
#library-purpose,
#artifacts-purpose,
#mcp-purpose,
#console-status-row,
#library-status-row,
#console-mode-bar,
#artifacts-mode-strip,
#personas-mode-strip,
#watchlists-header-bar,
#schedules-filter-strip,
#workflows-mode-strip,
#mcp-mode-strip,
#acp-purpose,
#acp-mode-strip,
#skills-mode-strip,
#settings-category-strip {
    height: $ds-destination-compact-strip-height;
    min-height: $ds-destination-compact-strip-height;
    padding: 0 1;
    margin: 0;
    border: none;
}

#watchlists-header-bar {
    /* The backend Select needs three rows; auto height consumes the shell. */
    height: 3;
    min-height: 3;
}

.destination-action-button {
    height: 1;
    min-height: 1;
    padding: 0 1;
}

.home-dashboard-region,
.library-region,
#artifacts-list-pane,
#artifacts-detail-pane,
#artifacts-inspector-pane,
#personas-list-pane,
#personas-detail-pane,
#personas-inspector-pane,
#watchlists-list-pane,
#watchlists-detail-pane,
#watchlists-inspector-pane,
#workflows-list-pane,
#workflows-detail-pane,
#workflows-inspector-pane,
#mcp-server-tree-pane,
#mcp-detail-pane,
#mcp-readiness-pane,
#acp-list-pane,
#acp-detail-pane,
#acp-inspector-pane,
#skills-list-pane,
#skills-detail-pane,
#skills-inspector-pane,
#settings-category-pane,
#settings-detail-pane,
#settings-impact-pane,
#ccp-character-library-pane,
#ccp-behavior-detail-pane,
#ccp-attachment-inspector-pane {
    width: 1fr;
    min-width: 0;
    height: 100%;
    min-height: 0;
    padding: 1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

/* Console's runtime frame (_frame_console_region) is the single border
   source for .console-region; no CSS border here to avoid a doubled frame. */
.console-region {
    width: 1fr;
    min-width: 0;
    height: 100%;
    min-height: 0;
    padding: 1;
    background: $ds-surface-panel;
}

#settings-category-pane {
    width: 3fr;
    overflow-y: hidden;
    overflow-x: hidden;
}

#settings-category-list {
    width: 100%;
    height: 1fr;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

#settings-detail-pane {
    width: 6fr;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

#settings-impact-pane {
    width: 2fr;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

#home-triage-grid {
    padding: 0 1;
    margin: 0;
    border: solid $ds-column-line;
    background: $ds-surface-panel;
}

#home-header-line {
    height: $ds-home-compact-row-height;
    min-height: $ds-home-compact-row-height;
    padding: 0 1;
    margin: 0;
    border: none;
}

#home-rail,
#home-canvas {
    border: solid $ds-column-line;
    background: $ds-surface-panel;
}

.home-rail-row {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.home-rail-row-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.home-rail-section-body {
    height: auto;
    min-height: 0;
}

.home-rail-empty-copy {
    color: $ds-text-muted;
    padding: 0 1;
}

#home-next-action-callout {
    color: $ds-text-muted;
    padding: 0 1;
}

.destination-pane-divider {
    width: 1;
    min-width: 1;
    height: 100%;
    min-height: 0;
    background: $ds-grid-line;
}

#home-canvas-actions .ds-toolbar {
    height: auto;
    min-height: $ds-home-control-button-height;
    padding: 0 1;
    margin: 0;
    border: none;
    background: $ds-surface-panel;
}

.home-canvas-action {
    height: $ds-home-control-button-height;
    min-height: $ds-home-control-button-height;
    margin: 0 1 0 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    border: none;
}

/* Canvas actions gain .console-action-primary (mirrors the project's live
   "primary action button" convention) when they are the primary control
   for the currently selected row -- see HomeScreen._home_action_button /
   HomeCanvasState.primary_control_id. No id-scoped rule here anymore: the
   primary control follows selection (Retry when failed, Approve when
   approval-pending, Review flashcards when the due-flashcards row is
   selected, Open details otherwise), not one permanently-accented button. */

#library-shell-grid {
    padding: 0 1;
    margin: 0;
    border: solid $ds-column-line;
    background: $ds-surface-panel;
}

#library-header-line {
    height: $ds-home-compact-row-height;
    min-height: $ds-home-compact-row-height;
    padding: 0 1;
    margin: 0;
    border: none;
}

#library-rail {
    border: solid $ds-column-line;
    background: $ds-surface-panel;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

#library-canvas {
    border: solid $ds-column-line;
    background: $ds-surface-panel;
}

.library-rail-empty-copy {
    color: $ds-text-muted;
    padding: 0 1;
}

.library-details-group {
    text-style: bold;
    color: $ds-text-primary;
    margin: 1 0 0 0;
    padding: 0 1;
}

.library-details-group-first {
    margin: 0;
}

.library-details-row {
    padding: 0 1;
}

.library-rail-row {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.library-rail-row-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Flashcards-due emphasis on the create-flashcards rail row. Bright uses an
   accent text color (not a background fill) so the row stands out without
   reading as selected -- real selection is `.library-rail-row-selected`'s
   background treatment below, and this row must stay visually distinct from
   that state. Dim uses the muted text color already used for rail hints
   elsewhere in this file (e.g. #library-notes-sync-status) so a zero-due
   state reads as quiet. */
.library-rail-row-due-bright {
    color: $ds-action-focus;
    text-style: bold;
}

.library-rail-row-due-dim {
    color: $ds-text-muted;
    text-style: none;
}

.library-conversation-row {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.library-conversation-row-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.library-media-row {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.library-media-row-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.library-notes-row {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

/* Same look as .library-notes-row, on a separate class: the notes Create
   view's Blank note / template rows must not also match the list view's
   ".library-notes-row" press handler (opening the editor for the pressed
   row's note_id), which would double-dispatch alongside the Create view's
   own handlers on every press. */
.library-notes-create-row {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

/* Same look as .library-notes-row: prompts list rows (library_prompts_canvas.py). */
.library-prompt-row {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

/* "From a template" group label: separates the primary Blank note action
   from the template rows (same top-rule section grammar as the media
   viewer's Content/Analysis/Highlights headers). */
#library-notes-template-section {
    width: 100%;
    text-style: bold;
    color: $ds-text-primary;
    border-top: solid $ds-grid-line;
    padding: 1 0 0 0;
    margin: 1 0 1 0;
}

.library-canvas-action {
    height: $ds-home-control-button-height;
    min-height: $ds-home-control-button-height;
    margin: 0 1 0 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    border: none;
}

#library-search-input {
    margin: 0 0 1 0;
}

#library-conversations-filter {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-notes-header {
    width: 100%;
    min-width: 0;
    height: auto;
    content-align: left middle;
}

#library-notes-filter {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-notes-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-notes-status {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

#library-notes-empty {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

/* Prompts list canvas (library_prompts_canvas.py): same look as the notes
   list's header/filter/empty siblings above -- visual parity, not a
   separate design. */
#library-prompts-header {
    width: 100%;
    min-width: 0;
    height: auto;
    content-align: left middle;
}

#library-prompts-filter {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-prompts-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-prompts-empty {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

/* Toolbar Import… row (library_prompts_canvas.py, Task 5): the path Input
   matches the filter box's field look; the outcome line is muted like the
   editor's save-status Static. */
#library-prompts-import-path {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-prompts-import-path:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-prompts-import-status {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

/* Toolbar Import… row (library_skills_canvas.py, Task 5): the path Input
   matches the filter box's field look; the outcome line is muted like the
   editor's save-status Static. */
#library-skills-import-path {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-skills-import-path:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-skills-import-status {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

/* Skills list canvas (library_skills_canvas.py, Task 3): same look as the
   prompts list's header/filter/empty/row siblings above -- visual parity,
   not a separate design. */
.library-skill-row {
    width: 100%;
    min-width: 0;
    /* task-424: 1 high + no margin -- the secondary Static below it is
       part of the same row block (prompts pack both lines into one 2-high
       Button label instead; the separation margin lives on the secondary
       line here). */
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

/* Needs-review (trust-blocked) skills stay selectable -- the trust panel
   needs them visible -- but render dim, same modifier-class pattern as
   ``.console-prompt-picker-row-blocked``. */
.library-skill-row-blocked {
    color: $ds-text-muted;
}

/* Row secondary line: the flags/description Static rendered right below
   each skill row's Button. Same muted tier as every other secondary/empty
   line in this canvas family. */
.library-skill-row-secondary {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

#library-skills-header {
    width: 100%;
    min-width: 0;
    height: auto;
    content-align: left middle;
}

#library-skills-filter {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-skills-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-skills-empty {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

/* Skill detail/trust editor (library_skills_canvas.py, Task 4): Name/
   Description/Argument hint/Allowed tools/Model share the SAME field look
   as the prompt editor's own Inputs (visual parity, not a separate
   design) -- dual-pinned against #library-prompt-name in
   test_library_skills_canvas.py. */
#library-skill-name,
#library-skill-description,
#library-skill-argument-hint,
#library-skill-allowed-tools,
#library-skill-model {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-skill-name:focus,
#library-skill-description:focus,
#library-skill-argument-hint:focus,
#library-skill-allowed-tools:focus,
#library-skill-model:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

/* Bounded editor: same floor/ceiling as #library-prompt-system/-user so the
   Body TextArea stays compact instead of ballooning to fill the canvas. */
#library-skill-body {
    height: auto;
    min-height: 6;
    max-height: 14;
    margin: 0 0 1 0;
}

#library-skill-supporting,
#library-skill-save-status,
#library-skill-conflict-copy {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

/* Warnings line (shadow-name / save-marks-needs-review): a warning tier
   color, not muted -- unlike the read-only supporting-files/status lines
   above, these are actionable, attention-worthy copy. */
#library-skill-warnings {
    width: 100%;
    height: auto;
    color: $ds-status-warning;
    margin: 0 0 1 0;
}

/* Trust panel: state line dims while blocked/needs-review, same modifier-
   class pattern as .library-skill-row-blocked above. The changed-files
   line under it is muted like every other secondary line in this canvas
   family. */
#library-skill-trust-state {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
}

#library-skill-trust-state.library-skill-trust-state-blocked {
    color: $ds-text-muted;
}

#library-skill-trust-review-files {
    width: 100%;
    height: auto;
    min-height: 1;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

/* First-run trust setup state (Fix wave, Skills Phase-1 gate FIX 2): the
   explanation line replacing the normal changed-files line while
   ``trust_status == "trust_uninitialized"``. Same muted secondary-line
   look as #library-skill-trust-review-files above -- informational, not a
   warning tier (unlike #library-skill-warnings). */
#library-skill-trust-setup-explanation {
    width: 100%;
    height: auto;
    min-height: 1;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

#library-notes-create-header {
    width: 100%;
    min-width: 0;
    height: auto;
    content-align: left middle;
}

/* Note editor: title/keywords Inputs match the filter box's field look
   (tall border, focus accent) rather than defaulting to Textual's bare
   Input styling. */
#library-note-title,
#library-note-keywords {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-note-title:focus,
#library-note-keywords:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

/* Bounded editor: a bare TextArea in this scrolling canvas defaults to
   height:1fr, which would balloon to fill available space and crowd out
   the keywords/meta/action row beneath it. height:auto with a floor and a
   generous ceiling keeps short notes compact while long notes scroll
   inside the field itself instead of pushing the rest of the editor off
   screen. */
#library-note-body {
    height: auto;
    min-height: 12;
    max-height: 20;
    margin: 0 0 1 0;
}

/* The read-only Markdown preview takes the TextArea's place one-for-one
   when Preview is toggled on, so it gets the same bounded footprint (plus
   its own scroll region, since Markdown has no implicit one here). */
#library-note-preview-body {
    height: auto;
    min-height: 12;
    max-height: 20;
    margin: 0 0 1 0;
    padding: 0 1;
    border: solid $ds-grid-line;
    overflow-y: auto;
}

/* Muted meta line: same tier as the media viewer's metadata block
   (#library-media-viewer-meta) so both editors read consistently. */
#library-note-meta {
    width: 100%;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

#library-note-conflict-copy,
#library-note-delete-confirm-copy {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

/* Prompt editor (library_prompts_canvas.py): same field/meta/conflict look
   as the note editor's siblings above -- visual parity, not a separate
   design. Name/Author/Details/Keywords are single-line Inputs; System
   prompt/User prompt are the bounded TextAreas below. */
#library-prompt-name,
#library-prompt-author,
#library-prompt-details,
#library-prompt-keywords {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-prompt-name:focus,
#library-prompt-author:focus,
#library-prompt-details:focus,
#library-prompt-keywords:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

/* Dim one-line field labels above each Input/TextArea -- the prompt editor
   has several ambiguous text fields (unlike the note editor's single body),
   so each needs its own caption; muted like the note editor's meta line. */
.library-prompt-field-label {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
}

/* One-line dim hint under the System prompt/User prompt labels (Task 8c
   U7): explains the two-part prompt model to a new user. Same muted tier
   as .library-prompt-field-label above; the trailing margin separates it
   from the TextArea beneath it. */
.library-prompt-field-hint {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

/* Bounded editors: same floor/ceiling as #library-note-body so System/User
   prompt stay compact instead of ballooning to fill the canvas. */
#library-prompt-system,
#library-prompt-user {
    height: auto;
    min-height: 6;
    max-height: 14;
    margin: 0 0 1 0;
}

#library-prompt-meta {
    width: 100%;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

#library-prompt-conflict-copy,
#library-prompt-save-status {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

/* Notes sync panel: section header matches the create view's group-label
   grammar; the folder Input matches the filter box's field look; status/
   activity are muted like the note editor's meta line. */
#library-notes-sync-header {
    width: 100%;
    text-style: bold;
    color: $ds-text-primary;
    margin: 0 0 1 0;
}

/* Purpose line: one-line explainer directly under the header, dim like the
   note editor's meta line. */
#library-notes-sync-purpose {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

/* Dim lowercase label above the folder Input, same muted tier as the
   activity log directly below it. */
#library-notes-sync-folder-label {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
}

#library-notes-sync-folder {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-notes-sync-folder:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

/* Starts the direction/conflict/auto-sync settings group right after
   Browse…, visually separating "where" (folder) from "how" (options). */
#library-notes-sync-direction {
    margin-top: 1;
}

/* Separates the primary action from the settings group above it. Accent
   treatment mirrors .console-action-primary (the project's live "primary
   action button" convention) so Sync now reads as the one button that
   matters on this panel. */
#library-notes-sync-run {
    margin-top: 1;
    background: $ds-action-focus 35%;
    color: $ds-text-primary;
    text-style: bold;
}

#library-notes-sync-status {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 1 0 0 0;
    color: $ds-text-muted;
}

/* Failed status gets the standard $ds-status-error color -- status is the
   headline, so a failure must read as unambiguously bad. */
#library-notes-sync-status.library-notes-sync-status-failed {
    color: $ds-status-error;
}

/* Activity is the log, status is the headline -- one muted tier dimmer
   than #library-notes-sync-status so the hierarchy is visible even though
   both are "muted" text. */
#library-notes-sync-activity {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-disabled;
}

/* Ingest canvas: local-file ingest form + job queue. Mirrors the notes
   sync panel's render-safe stacked shape (VerticalScroll root -- L3a
   clipping lesson -- no Select, no Horizontal mixing 1fr + fixed-width
   children). */
#library-ingest-header {
    width: 100%;
    text-style: bold;
    color: $ds-text-primary;
    margin: 0 0 1 0;
}

.library-ingest-quiet-line {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

.library-ingest-field {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.library-ingest-field:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

/* Accent treatment mirrors #library-notes-sync-run / .console-action-primary
   (the project's live "primary action button" convention) so Start ingest
   reads as the one button that matters on this canvas. */
#library-ingest-start {
    margin-top: 1;
    background: $ds-action-focus 35%;
    color: $ds-text-primary;
    text-style: bold;
}

#library-ingest-start:disabled {
    background: $ds-surface-raised;
    color: $ds-text-disabled;
    text-style: none;
}

#library-ingest-queue-heading {
    width: 100%;
    text-style: bold;
    color: $ds-text-primary;
    border-top: solid $ds-grid-line;
    padding: 1 0 0 0;
    margin: 1 0 1 0;
}

#library-ingest-queue-counts {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

#library-ingest-queue-empty {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
}

.library-ingest-row {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    color: $ds-text-primary;
}

/* (L3b AB wave, A3) A row followed by action button(s) (Open in Library /
   Retry / Dismiss) trims its own bottom margin to 0 -- the actions
   wrapper's own `.library-ingest-row-actions` margin below supplies the
   spacing instead (tight gap above, blank line below), so the button(s)
   read as belonging to THIS row rather than the row underneath it. Plain
   rows (queued/running, or a defensively action-less done row) keep the
   base `.library-ingest-row` bottom margin for normal row-to-row
   spacing. */
.library-ingest-row-with-actions {
    margin: 0 0 0 0;
}

/* (L5, fix batch F1b) The wrapper around a row's action button(s) --
   Retry+Dismiss on a failed row, or Open in Library alone on a done row
   (the two never coexist on the same row). Carries the spacing the
   individual `.library-ingest-row-action` buttons used to carry alone
   (A3, above) now applied once to the whole group: indented 2 cells so it
   visually nests under its row, no gap above (tight to the row it
   belongs to, whose own margin is trimmed via
   `.library-ingest-row-with-actions` above), one blank line below before
   whatever comes next (another row, or "Clear finished"). `height: auto`
   keeps it from inheriting `Horizontal`'s `1fr` default, which would
   otherwise fight every other row for the VerticalScroll's height. */
.library-ingest-row-actions {
    height: auto;
    margin: 0 0 1 2;
}

/* Shared by every per-row action button (Open in Library / Retry /
   Dismiss) inside `.library-ingest-row-actions` above -- now just a small
   right gap between same-row siblings (Retry from Dismiss) so the pair
   reads as two distinct buttons rather than running together; the
   wrapper itself supplies the row's own indent/top/bottom spacing. */
.library-ingest-row-action {
    margin: 0 1 0 0;
}

/* (L3b AB wave, B2) "Clear finished" sits below every queue row -- a top
   margin separates it from the last row's own action button instead of
   reading as one more per-row action. */
#library-ingest-clear-finished {
    margin-top: 1;
}

/* Export canvas (F4 Task 2): in-canvas chatbook export form. Own classes
   rather than reusing `.library-ingest-*` -- the two canvases' CSS stays
   independently discoverable even though the rules mirror the ingest
   canvas's field/quiet-line styling exactly. */
.library-export-quiet-line {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

.library-export-field {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.library-export-field:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

/* Accent treatment mirrors #library-ingest-start / .console-action-primary
   (the project's live "primary action button" convention) so Export
   chatbook reads as the one button that matters on this canvas. */
#library-export-submit {
    margin-top: 1;
    background: $ds-action-focus 35%;
    color: $ds-text-primary;
    text-style: bold;
}

#library-export-submit:disabled {
    background: $ds-surface-raised;
    color: $ds-text-disabled;
    text-style: none;
}

#library-media-title {
    width: 100%;
    min-width: 0;
    height: auto;
    content-align: left middle;
}

#library-media-type-filter {
    width: auto;
    min-width: 0;
    margin: 0 0 1 0;
}

/* Title: brightest + bold so it anchors the viewer; metadata recedes (muted)
   so the two read as distinct tiers instead of one wall of text. */
#library-media-viewer-title {
    width: 100%;
    text-style: bold;
    color: $ds-text-primary;
    margin: 0 0 1 0;
}

#library-media-viewer-meta {
    width: 100%;
    color: $ds-text-muted;
    margin: 0 0 1 0;
}

/* Section headers: bold + a thin top rule so Content / Analysis / Highlights
   read as real section boundaries the eye can find without reading. */
#library-media-viewer-content-title,
#library-media-viewer-analysis-title,
#library-media-viewer-highlights-title {
    width: 100%;
    text-style: bold;
    color: $ds-text-primary;
    border-top: solid $ds-grid-line;
    padding: 1 0 0 0;
    margin: 1 0 1 0;
}

#library-media-content-search {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-media-content-search:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-media-content-search-status {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

#library-media-viewer {
    height: 100%;
    overflow-y: auto;
    /* Never scroll horizontally: without this the vertical scroll container
       sizes its content to the widest child's natural width, so a long
       unbroken line (analysis summary, URL) sets a wide virtual width and
       width:100% children match it instead of wrapping. Constrain to the
       visible width so long lines wrap. */
    overflow-x: hidden;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

/* Text bodies default to width:auto (shrink-to-content); fill the width so
   long lines wrap within the (now horizontally-constrained) viewer. */
#library-media-viewer Static {
    width: 100%;
}

#library-media-viewer-content {
    /* Bounded so short content stays compact and long content scrolls inside
       this region; height:1fr here ballooned the pane and split the sections.
       max-height is generous so typical content shows in full (only long
       transcripts engage the inner scroll), reducing nested-scroll friction. */
    height: auto;
    max-height: 18;
    min-height: 3;
    margin: 0 0 1 0;
    border: solid $ds-grid-line;
    padding: 0 1;
}

#library-media-edit-form {
    height: auto;
    margin: 0 0 1 0;
}

/* Persistent per-field label: muted, bold, hugging its input above the row. */
.library-media-edit-label {
    width: 100%;
    height: 1;
    color: $ds-text-muted;
    text-style: bold;
    margin: 0;
}

/* Destructive Delete: pushed off the primary actions (a gap) and de-emphasized
   so it is neither adjacent to Edit nor visually competing with it. */
.library-media-action-danger {
    margin: 0 0 0 4;
    color: $ds-text-muted;
}

/* Each highlight is an indented card so its quote, meta, and delete read as
   one unit -- a per-row delete then clearly belongs to a single highlight. */
.library-media-highlight-row {
    width: 100%;
    height: auto;
    border-left: solid $ds-grid-line;
    padding: 0 0 0 1;
    margin: 0 0 1 0;
}

.library-media-highlight-meta {
    width: 100%;
    color: $ds-text-muted;
}

.library-media-highlight-delete {
    color: $ds-text-muted;
}

#library-media-edit-form Input {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-media-edit-form Input:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-media-highlight-add-collapsible {
    height: auto;
    margin: 0 0 1 0;
}

#library-media-highlight-add-collapsible Input {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-media-highlight-add-collapsible Input:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#console-workspace-grid {
    height: $ds-console-workspace-grid-height;
    min-height: 20;
    padding: 0 1;
    margin: 0;
    overflow: hidden;
    border-top: solid $ds-grid-line;
    border-bottom: solid $ds-grid-line;
    background: $ds-surface-panel;
}

#console-workbench-header {
    /* The destination identity header is the visible Console header (ADR-015);
       layout comes from .workbench-header in _workbench.tcss. */
    height: auto;
    min-height: 2;
    padding: 0 1;
    margin: 0;
}

#console-workbench-header.console-header-inline {
    layout: horizontal;
    height: 1;
    min-height: 1;
    border: none;
}

#console-workbench-header.console-header-inline .workbench-header-title {
    width: auto;
    height: 1;
    min-height: 1;
}

#console-workbench-header.console-header-inline .workbench-header-subtitle {
    /* Keep the subtitle visible in compact density too: the shared
       `.density-compact .workbench-header-subtitle { display: none }` hid it to
       save a row in the old stacked header, but the inline header is one row at
       any density, so hiding it only wastes the horizontal space. This id+class
       rule (1,2,0) beats that density rule (0,2,0). */
    display: block;
    width: 1fr;
    height: 1;
    min-height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    margin: 0 1;
}

#console-workbench-header.console-header-inline .workbench-header-status {
    width: auto;
    height: 1;
    min-height: 1;
}

#console-workbench-mode-strip,
#console-workbench-command-strip {
    display: none;
    height: 0;
    min-height: 0;
    max-height: 0;
    padding: 0;
    margin: 0;
    border: none;
}

#console-control-bar {
    height: $ds-console-control-bar-height;
    min-height: $ds-console-control-bar-height;
    max-height: $ds-console-control-bar-height;
    padding: 0 1;
    margin: 0;
    border: none;
    background: $ds-surface-panel;
    overflow: hidden;
}

.console-control-chip-row,
.console-control-action-row {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    max-height: 1;
    layout: horizontal;
    align: left middle;
}

#console-status-chips {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    layout: horizontal;
    border: none;
    padding: 0 1;
}

.console-control-chip {
    width: auto;
    min-width: 7;
    max-width: 22;
    height: 1;
    min-height: 1;
    margin: 0 1 0 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

.console-chip-dim {
    color: $ds-text-muted;
}

.console-chip-alert {
    color: $ds-text-primary;
    text-style: bold;
}

/* Keyboard reachability: chips ellipsize at 22 cells, so focusing a chip
   lifts the width cap to reveal the full label (the tooltip carries the
   same text on hover). Later chips clip under the bar's hidden overflow. */
.console-control-chip:focus {
    max-width: 100%;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    /* TASK-383: the global `*:focus { outline: solid }` fallback OVERLAYS a box
       onto this height-1 chip, replacing the label with border glyphs (the
       "empty outlined box" defect). The high-contrast bg/fg + bold underline
       above already give a non-obscuring focus cue, so suppress the outline
       that would otherwise hide the label. */
    outline: none;
}

.console-control-action {
    width: auto;
    min-width: 7;
    height: 1;
    min-height: 1;
    margin: 0 1 0 0;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $ds-text-primary;
    content-align: left middle;
}

.console-control-action:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-control-summary-line {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
}

.console-hidden-control {
    display: none;
}

#console-staged-context-tray,
#console-workspace-context,
#console-run-inspector {
    width: 1fr;
    min-width: 0;
    height: 100%;
    min-height: 0;
}

#console-main-column,
#console-right-rail {
    width: 1fr;
    min-width: 0;
    height: 100%;
    min-height: 20;
}

#console-staged-context-tray,
#console-workspace-context {
    width: 100%;
    min-width: 0;
}

#console-staged-context-tray {
    height: auto;
    min-height: 3;
    max-height: 6;
}

#console-workspace-context {
    height: auto;
    min-height: 0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

#console-workspace-handoff-rows {
    height: auto;
    min-height: 0;
}

#console-workspace-conversations-header {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    margin: 1 0 0 0;
    layout: horizontal;
    align: left middle;
}

.console-workspace-action.console-workspace-conversations-toggle {
    width: 3;
    min-width: 3;
    max-width: 3;
    margin: 0;
}

#console-workspace-selected-conversation {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    color: $ds-text-muted;
    background: $ds-surface-panel;
}

/* The row is 3 rows tall so the bordered Input inside it can show its value:
   a `tall` border spends one row above and one below the text, so a 1-row
   input paints its top edge and nothing else. */
#console-workspace-conversation-search-row {
    width: 100%;
    min-width: 0;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    layout: horizontal;
    align: left middle;
}

#console-workspace-conversation-search {
    width: 1fr;
    min-width: 0;
    height: 3;
    min-height: 3;
    margin: 0 1 0 0;
}

#console-workspace-conversation-search-clear {
    width: auto;
    min-width: 7;
    height: 1;
    min-height: 1;
    margin: 0;
}

#console-workspace-conversations {
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 0;
    overflow-y: hidden;
    overflow-x: hidden;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-workspace-conversation-row {
    height: auto;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-workspace-conversation-row-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-conversation-browser-section-header {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    layout: horizontal;
    align: left middle;
}

.console-conversation-browser-section-title {
    width: 1fr;
    min-width: 0;
}

.console-conversation-browser-group-header {
    width: 100%;
    min-width: 0;
    height: 1;
    min-height: 1;
    layout: horizontal;
    align: left middle;
}

.console-conversation-browser-group-title {
    width: 1fr;
    min-width: 0;
    color: $ds-text-muted;
}

.console-conversation-browser-row-line {
    width: 100%;
    min-width: 0;
    height: auto;
    layout: horizontal;
}

.console-conversation-star {
    width: 3;
    min-width: 3;
    max-width: 3;
    height: 2;
    min-height: 2;
    margin: 0 1 1 0;
}

#console-left-rail {
    height: 100%;
    min-height: 0;
    overflow: hidden;
}

#console-left-rail:focus {
    outline: none;
    border: solid $ds-column-line;
    background: $ds-surface-panel;
}

#console-left-rail-body {
    width: 100%;
    min-width: 0;
    height: 1fr;
    min-height: 0;
    padding: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-gutter: stable;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

#console-left-rail-body:focus {
    outline: none;
    border: none;
    background: $ds-surface-panel;
}

#console-workspace-context:focus {
    outline: none;
    border: none;
    background: $ds-surface-panel;
}

#console-workspace-conversations:focus {
    outline: none;
    border: none;
    background: $ds-surface-panel;
}

.console-left-rail-section {
    margin: 0 0 1 0;
    padding: 0 1;
}

#console-inspector-rail-body {
    width: 100%;
    min-width: 0;
    height: 1fr;
    min-height: 0;
    padding: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

#console-main-column {
    width: 13fr;
    min-width: 60;
    padding: 0;
}

#console-right-rail {
    width: 4fr;
    min-width: 34;
    overflow: hidden;
}

#console-staged-context-tray,
#console-workspace-context,
#console-right-rail,
#console-run-inspector,
#console-transcript-region {
    border: solid $ds-column-line;
    background: $ds-surface-panel;
}

#console-staged-context-tray.console-frame-quiet,
#console-workspace-context.console-frame-quiet {
    border: none;
    background: $ds-surface-panel;
}

#console-run-inspector {
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 0;
    border: none;
}

#console-run-inspector-state {
    height: auto;
    min-height: 0;
}

.console-rail-handle {
    width: 13;
    min-width: 13;
    max-width: 13;
    height: 100%;
    min-height: 20;
    padding: 0;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

.console-rail-handle-right {
    width: 11;
    min-width: 11;
    max-width: 11;
    height: auto;
    min-height: 3;
    max-height: 6;
    border: none;
    background: transparent;
}

.console-rail-handle-button {
    width: 11;
    min-width: 0;
    max-width: 11;
    height: 100%;
    min-height: 100%;
    max-height: 100%;
    text-align: center;
    content-align: center middle;
}

.console-rail-handle-button-right {
    width: 11;
    max-width: 11;
    height: 3;
    min-height: 3;
    max-height: 3;
}

/* TASK-345: controls that previously had NO :focus rule fell back to
   Textual's imperceptible default shift. Non-obscuring contract vocabulary
   only (ds tokens + bold underline; no accent, no reverse). */
.console-rail-collapse-button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-switcher-result:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-workspace-conversation-row Button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-workspace-action-row Button:focus,
.console-rail-header Button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-rail-collapse-button {
    width: 3;
    min-width: 3;
    max-width: 3;
    height: 1;
    min-height: 1;
    text-align: left;
    content-align: left middle;
}

.console-rail-handle-badge {
    height: auto;
    min-height: 1;
    width: 100%;
    text-align: center;
    color: $ds-text-primary;
    background: $ds-surface-raised;
}

.console-rail-header {
    height: 1;
    min-height: 1;
    layout: horizontal;
}

.console-rail-title {
    width: 1fr;
    min-width: 0;
    text-align: left;
    content-align: left middle;
}

.console-rail-section-header {
    height: auto;
    min-height: 2;
    border-top: solid $ds-column-line;
    content-align: center middle;
}

.console-rail-section-title {
    width: 1fr;
    text-style: bold;
    color: $ds-text-primary;
}

.console-rail-section-toggle {
    width: 3;
    min-width: 3;
    text-style: bold;
}

.console-rail-section-toggle:focus {
    background: $ds-action-focus 30%;
    text-style: underline bold;
}

.console-workspace-conversations-header {
    height: auto;
    min-height: 2;
    border-top: solid $ds-column-line;
    content-align: center middle;
}

.console-rail-section-body {
    height: auto;
    min-height: 0;
    padding: 0 1 1 1;
}

.console-model-section-line {
    height: auto;
    min-height: 1;
}

.console-model-section-label {
    width: 12;
    min-width: 12;
    color: $ds-text-muted;
}

.console-model-section-value {
    width: 1fr;
    min-width: 10;
    color: $ds-text-primary;
}

#console-model-section-provider .console-model-section-value,
#console-model-section-model .console-model-section-value {
    text-wrap: wrap;
    max-height: 3;
    overflow: hidden;
}

#console-model-section-temperature .console-model-section-value,
#console-model-section-max-tokens .console-model-section-value {
    text-wrap: nowrap;
}

#console-model-section-recovery {
    color: $ds-status-blocked;
}

.console-agent-section-line {
    height: 1;
    color: $ds-text-primary;
}

.console-agent-section-steps,
.console-agent-section-subagents {
    height: auto;
    color: $ds-text-muted;
    text-style: dim;
}

.console-agent-section-fleet-summary {
    height: auto;
    color: $ds-status-running;
    text-style: dim;
}

.console-agent-drilldown-back {
    margin-top: 1;
}

#console-rail-system-line {
    height: 1;
    color: $ds-text-primary;
}

#console-rail-system-line.console-rail-system-line-dim {
    color: $ds-text-muted;
}

.console-inspector-group-heading {
    height: 1;
    min-height: 1;
    margin: 1 0 0 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-inspector-status-summary {
    height: 1;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-inspector-action {
    height: 1;
    min-height: 1;
    margin: 0;
}

.console-inspector-disabled-reason {
    height: 0;
    min-height: 0;
}

.console-live-work-source-readiness {
    height: auto;
    min-height: 0;
    margin: 1 0 0 0;
}

/* Context (staged sources) section pinned at the top of the Inspector rail
   body (task-400): bottom margin separates it from the run inspector below. */
.console-inspector-context-section {
    margin: 0 0 1 0;
    padding: 0 1;
}

.console-live-work-source-row {
    height: auto;
    min-height: 1;
}

.console-settings-summary {
    height: auto;
    min-height: 9;
    padding: 0 1;
}

.console-left-rail-section.console-settings-summary {
    margin: 0 0 1 0;
    padding: 0 1;
    border: none;
    background: $ds-surface-panel;
}

.console-inspector-session-settings {
    margin: 1 0 0 0;
    padding: 0 1;
    border: none;
    background: $ds-surface-panel;
}

.console-settings-header {
    height: 1;
    min-height: 1;
    layout: horizontal;
    align: left middle;
}

.console-settings-title {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    max-height: 1;
}

.console-settings-row {
    height: 1;
    min-height: 1;
    max-height: 1;
    overflow: hidden hidden;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#console-settings-open {
    width: auto;
    min-width: 9;
    max-width: 14;
    height: 1;
    min-height: 1;
    margin: 0;
}

#console-transcript-region,
#console-session-surface {
    height: 1fr;
    min-height: 0;
}

#console-session-surface {
    padding: 0;
    margin: 0;
    border: none;
}

#console-transcript-region {
    padding: 0 1;
    border: round $ds-column-line;
    background: $ds-surface-panel;
}

#console-native-composer {
    height: auto;
    min-height: $ds-console-composer-height;
    max-height: 8;
    padding: 1;
    margin: 0;
    layout: horizontal;
    align: left middle;
    border: round $ds-column-line;
    background: $ds-surface-panel;
}

#console-native-composer.console-composer-has-draft {
    border: round $ds-status-ready;
}

#console-native-composer.console-composer-focused {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
}

#console-native-composer.console-composer-setup-blocked #console-command-visible-text {
    color: $ds-status-warning;
}

#console-composer-expanded,
#console-composer-collapsed {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    layout: horizontal;
    align: left middle;
}

#console-native-composer.console-composer-collapsed {
    height: 1;
    min-height: 1;
    max-height: 1;
    padding: 0;
    border: none;
    background: $ds-surface-raised;
}

#console-composer-status,
.console-composer-recovery,
.console-send-disabled-reason,
.console-control-label {
    height: 1;
    min-height: 1;
}

#console-composer-collapse {
    width: 14;
    min-width: 14;
}

#console-composer-collapsed-status {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    text-overflow: ellipsis;
    text-wrap: nowrap;
    color: $ds-text-muted;
}

#console-collapsed-stop-generation {
    width: 8;
    min-width: 8;
}

#console-composer-expand {
    width: 12;
    min-width: 12;
}

#console-command-visible-text {
    width: 1fr;
    min-width: 0;
    height: auto;
    min-height: 1;
    max-height: 4;
    margin: 0 1 0 0;
    padding: 0 1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    overflow: hidden;
}

#console-native-composer.console-composer-has-draft #console-command-visible-text,
#console-native-composer:focus-within #console-command-visible-text,
#console-command-visible-text:focus {
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-composer-actions {
    width: 45;
    min-width: 45;
    max-width: 45;
    height: 1;
    min-height: 1;
    layout: horizontal;
    align: right middle;
}

.console-composer-recovery {
    width: 0;
    min-width: 0;
    max-width: 0;
    margin: 0 1 0 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-status-warning;
    text-style: bold;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

.console-send-disabled-reason {
    width: 0;
    min-width: 0;
    max-width: 0;
    margin: 0 1 0 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-status-warning;
    text-style: bold;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

#console-command-input {
    display: none;
    width: 0;
    min-width: 0;
    height: 0;
    min-height: 0;
}

#console-composer-status {
    width: auto;
    min-width: 0;
}

#console-session-surface .chat-input-area {
    display: none;
}

.console-transcript-system-event {
    height: auto;
    min-height: 1;
    margin: 1 0 0 0;
    padding: 0 1;
    border-left: solid $ds-status-warning;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-chat-tabs,
#console-chat-tabs #chat-sessions-container,
#console-chat-tabs .chat-session {
    height: 100%;
    min-height: 0;
}

#console-transcript-surface {
    height: 1fr;
    min-height: 0;
    layers: console-background console-content;
}

#console-transcript-background-effect {
    layer: console-background;
    width: 100%;
    height: 100%;
    color: $ds-text-muted;
    background: transparent;
}

#console-native-transcript {
    height: 1fr;
    min-height: 0;
    padding: 0 1;
    border: solid $ds-grid-line;
    border-bottom: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
    scrollbar-size: 1 1;
}

#console-transcript-surface #console-native-transcript {
    layer: console-content;
    height: 1fr;
    min-height: 0;
    background: transparent;
}

#console-transcript-title,
.console-transcript-title {
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    background: $ds-surface-panel;
    color: $ds-text-muted;
    text-style: none;
}

#console-native-tab-strip,
.console-session-tab-strip {
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    margin-bottom: 1;
    background: $ds-surface-panel;
}

/* Scrollable tab strip: overflow scrolls horizontally (wheel, keyboard, or
   scroll-to-active) instead of silently clipping tabs. The scrollbar itself
   is hidden because the strip is a single row tall. */
#console-native-tab-strip {
    scrollbar-size-horizontal: 0;
}

.console-session-tab,
#console-new-chat-tab {
    width: auto;
    min-width: 8;
    height: 1;
    min-height: 1;
    padding: 0 1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-session-close-button {
    padding: 0;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-style: bold;
}

.console-session-tab-active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-session-tab-active:hover,
.console-session-tab-active:hover:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

#console-native-transcript:focus {
    border: solid $ds-focus-accent;
    border-bottom: solid $ds-focus-accent;
}

.console-transcript-rule {
    height: 1;
    min-height: 1;
    color: $ds-column-line;
}

.console-transcript-message {
    height: auto;
    min-height: 1;
    padding: 0 1;
    margin: 0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-transcript-message-selected {
    min-height: 2;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-transcript-message-tool {
    color: $ds-text-muted;
    text-style: dim italic;
}

.console-transcript-message-system {
    color: $ds-text-muted;
}

.console-transcript-citation-sources {
    width: auto;
    min-width: 13;
    height: 3;
    min-height: 3;
    margin: 0 0 1 1;
    padding: 0 1;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-muted;
}

.console-transcript-citation-sources:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

/* TASK-385: a selected Tool/System row must read the same as a selected
   user/assistant row. The muted `-tool`/`-system` rules above share the
   single-class specificity of `-selected` and follow it in source order, so
   they would otherwise strip the selection treatment off the text. These
   two-class selectors out-specify them and re-assert the focus colours + bold
   underline for the selected state. */
.console-transcript-message-tool.console-transcript-message-selected,
.console-transcript-message-system.console-transcript-message-selected {
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* TASK-371: docked "jump to latest" pill shown while the reader is scrolled up
   during (or just after) a streaming reply. Pinned to the transcript's bottom
   edge, high-contrast so it reads as an actionable status, click to re-attach. */
.console-transcript-jump-pill {
    dock: bottom;
    width: 100%;
    height: 1;
    content-align: center middle;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

/* task-558: the image-generation card row (border/border_title are set in
   Python -- ConsoleGenerationCard.__init__ -- since Textual widget borders
   aren't otherwise reachable from a class rule here; this adds the
   surrounding spacing/background the plain .console-transcript-message row
   gets, which the card previously had none of). */
.console-generation-card {
    height: auto;
    margin: 0 0 1 0;
    padding: 1;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-generation-card-details {
    height: auto;
    min-height: 1;
    padding: 1 0 0 0;
}

.console-generation-card-image-placeholder {
    color: $ds-text-muted;
    text-style: dim italic;
}

.console-transcript-action-row {
    height: 3;
    min-height: 3;
    margin: 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-transcript-action-guide {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    color: $ds-text-muted;
}

.console-modal-header {
    height: 1;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

ConsoleCitationSourcesModal {
    align: center middle;
}

#console-citation-sources-modal {
    width: 94;
    max-width: 96%;
    height: 34;
    max-height: 90%;
    padding: 1 2;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

#console-citation-sources-state {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

#console-citation-sources-body {
    width: 100%;
    height: 1fr;
    min-height: 8;
}

#console-citation-source-list {
    width: 34%;
    min-width: 18;
    height: 100%;
    margin: 0 1 0 0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

#console-citation-source-list ListItem {
    width: 100%;
    height: auto;
    min-height: 2;
    padding: 0 1;
    color: $ds-text-primary;
}

#console-citation-source-detail {
    width: 1fr;
    height: 100%;
    min-width: 0;
    padding: 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

#console-citation-source-marker {
    height: auto;
    min-height: 1;
    color: $ds-text-muted;
    text-style: bold;
}

#console-citation-source-title {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    color: $ds-text-primary;
    text-style: bold;
}

#console-citation-source-chunk {
    width: 100%;
    height: auto;
    min-height: 1;
    color: $ds-text-primary;
}

#console-citation-sources-close {
    width: 12;
    min-width: 12;
    height: 3;
    min-height: 3;
    margin: 1 0 0 0;
}

.console-transcript-action-button {
    width: auto;
    min-width: 5;
    height: 3;
    min-height: 3;
    padding: 0 1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-transcript-action-button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

.console-workspace-selector-row {
    margin: 0 0 1 0;
    padding: 0 1;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-style: bold;
}

.console-workspace-status-pair {
    height: auto;
    min-height: 1;
    margin: 0;
}

.console-workspace-status-label {
    color: $ds-text-muted;
    text-style: bold;
}

.console-workspace-status-value {
    color: $ds-text-primary;
}

.console-workspace-empty-copy {
    color: $ds-text-muted;
}

/* TASK-716: pressable-but-blocked Library source actions render dim; the
   press handler explains the block instead of a dead disabled button. */
.library-source-action-blocked {
    color: $ds-text-muted;
}

/* TASK-717: conversation rows whose record is proven missing render dim and
   inert instead of impersonating openable chats. */
.console-workspace-conversation-row-broken {
    color: $ds-text-muted;
    text-style: italic;
}

.console-workspace-action-row {
    height: auto;
    min-height: 1;
    margin: 0 0 0 12;
}

.console-workspace-action {
    height: 1;
    min-height: 1;
    margin: 0 1 0 0;
    /* TASK-712: Textual's default Button min-width (16) made Switch consume
       the whole action row after the row's 12-col indent, pushing New's
       label past the rail clip - invisible but still clickable. Size the
       compact actions to their labels so both fit the ~20-col row. */
    min-width: 5;
    width: auto;
}

#console-transcript-empty-state,
.console-transcript-empty-panel {
    height: 100%;
    min-height: 100%;
    width: 100%;
    layout: vertical;
    padding: 1 2;
    background: transparent;
    color: $ds-text-primary;
}

#console-shell .workbench-recovery-callout,
#console-control-bar,
#console-workspace-grid,
#console-transcript-region,
#console-native-composer {
    opacity: 100%;
}

.console-transcript-empty-body {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0;
    color: $ds-text-muted;
}

.console-setup-step {
    height: auto;
    min-height: 1;
    color: $ds-text-primary;
    /* TASK-389 made a height-1 line ellipsize on unavoidable overflow instead
       of silently clipping. TASK-441: ellipsizing still drops the tail of the
       sentence, so wrap onto a second row instead -- height:auto (Static's
       default text-wrap is already "wrap") lets the widget grow to fit
       however many rows a narrow terminal's capped card width needs, and
       .console-setup-modal-card's own height:auto absorbs the extra row. */
}

.console-setup-step-done {
    color: $ds-text-muted;
}

.console-setup-step-active {
    text-style: bold;
}

.console-setup-step-pending {
    color: $ds-text-muted;
}

/* First-run blocking setup modal: a Console-scoped overlay layer painted over
 * the whole Console shell (rail + transcript + composer) while setup is
 * incomplete. The app tab bar lives outside the shell and stays reachable. */
#console-shell {
    layers: console-workbench console-setup-overlay;
}

/* TASK-346: at small terminal heights (<35 rows) the header banner is
   dropped so the transcript+composer core loop stays on screen instead of
   the composer being silently clipped off the bottom. */
#console-shell.-console-compact #console-workbench-header {
    display: none;
}

#console-setup-modal {
    layer: console-setup-overlay;
    display: none;
    width: 100%;
    height: 100%;
    align: center middle;
    /* $background is a distinctly darker token than the Console shell's own
     * $ds-surface-panel background, so this alpha fill actually blends to a
     * dimmed shade (verified: ~#191d21 vs the shell's flat #242f38) instead
     * of a same-color no-op like the previous $ds-surface-panel 80% fill. */
    background: $background 60%;
    layers: console-setup-snow console-setup-card;
}

.console-setup-modal-backdrop-snow {
    layer: console-setup-snow;
    width: 100%;
    height: 100%;
    color: $ds-text-muted;
}

/* Console's rendered frame color (#6f7782) — see chat_screen.CONSOLE_FRAME_COLOR. */
.console-setup-modal-card {
    layer: console-setup-card;
    /* TASK-389: 62 gave 56 content cells (−2 border −4 padding); the honest
       step-3 line "…Composer unlocks after setup" is 59 cells, so its last word
       wrapped off. 66 gives 60 content cells so the full sentence fits. */
    width: 66;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    layout: vertical;
    border: solid #6f7782;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-setup-modal-title {
    height: 1;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0;
    color: $ds-text-primary;
    text-style: bold;
}

.console-setup-modal-action {
    width: auto;
    min-width: 12;
    height: 1;
    min-height: 1;
    margin: 1 0 0 0;
    padding: 0 1;
    border: none;
    background: $ds-focus-bg;
    color: $ds-text-primary;
    content-align: left middle;
}

.console-setup-modal-action:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

#console-chat-tabs {
    display: none;
}

#console-session-surface .chat-empty-state {
    min-height: 5;
    padding: 0 1;
    text-align: left;
    content-align: left top;
    border-bottom: solid $ds-grid-line;
    background: $ds-surface-panel;
}

#console-session-surface .chat-log {
    padding: 0 1;
    background: $ds-surface-panel;
    border: tall $ds-grid-line;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
    scrollbar-size: 1 1;
}

#console-send-message,
#console-stop-generation {
    width: 8;
    min-width: 8;
}

#console-send-message,
#console-stop-generation,
#console-attach-context,
#console-save-chatbook {
    height: 1;
    min-height: 1;
}

#console-attach-context {
    width: 10;
    min-width: 10;
}

#console-save-chatbook {
    width: 8;
    min-width: 8;
}

.console-action-primary {
    border: none;
    height: 1;
    min-height: 1;
    background: $ds-action-focus 35%;
    color: $ds-text-primary;
    text-style: bold;
}

.console-action-secondary {
    border: none;
    height: 1;
    min-height: 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-action-subdued {
    border: none;
    height: 1;
    min-height: 1;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: none;
}

.console-action-disabled {
    border: none;
    height: 1;
    min-height: 1;
    background: $ds-surface-panel;
    color: $ds-text-disabled;
    text-style: none;
}

.console-action-disabled:hover,
.console-action-disabled:focus,
.console-action-disabled:hover:focus {
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-disabled;
    text-style: none;
    outline: none;
}

#console-stop-generation.console-stop-active {
    border: none;
    background: $ds-status-warning 20%;
    color: $ds-text-primary;
    text-style: bold;
}

#console-save-chatbook.console-save-chatbook-ready {
    color: $ds-text-primary;
}

.console-control-label,
.console-staged-context-row,
.console-staged-context-summary,
.console-staged-context-recovery {
    width: auto;
    min-width: 0;
    height: auto;
}

.console-staged-context-header {
    height: auto;
    min-height: 1;
}

#console-staged-context-title {
    width: 1fr;
    text-style: bold;
}

#console-staged-context-count {
    width: auto;
    text-align: right;
    color: $ds-text-muted;
}

.console-staged-source-row {
    height: auto;
    min-height: 2;
    margin: 1 0 0 0;
}

.console-staged-source-name {
    text-wrap: wrap;
    max-height: 2;
    overflow: hidden;
}

.console-staged-source-status {
    height: 1;
    color: $ds-text-muted;
}

.console-staged-source-status.ready { color: $ds-status-ready; }
.console-staged-source-status.running { color: $ds-status-running; }
.console-staged-source-status.blocked { color: $ds-status-blocked; }

#console-staged-context-empty {
    color: $ds-text-muted;
}

/* task-9: Inspector retrieval-scope row -- sibling of the Sources tray,
   never a row inside it. */
#console-retrieval-scope-row {
    width: 100%;
    min-width: 0;
    height: auto;
    min-height: 1;
    max-height: 1;
    margin: 1 0 0 0;
}

.console-retrieval-scope-label {
    width: 1fr;
    min-width: 0;
    color: $ds-text-muted;
}

.console-retrieval-scope-action {
    width: auto;
    margin-left: 1;
}

.console-compact-model-bar {
    width: auto;
    min-width: 0;
}


#artifacts-workbench,
#personas-workbench,
#watchlists-workbench,
#workflows-workbench,
#mcp-workbench,
#acp-workbench,
#skills-workbench,
#settings-workbench,
#evals-workbench {
    height: 1fr;
    /* Must stay below the worst-case available height at small terminal
       sizes, otherwise content overflows and the footer status bar
       intercepts clicks on the covered rows. Pane content scrolls
       internally. */
    min-height: 10;
    padding: 1;
    margin: 0;
    overflow: hidden;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

#artifacts-list-pane,
#artifacts-detail-pane,
#artifacts-inspector-pane,
#personas-list-pane,
#personas-detail-pane,
#personas-inspector-pane,
#watchlists-list-pane,
#watchlists-detail-pane,
#watchlists-inspector-pane,
#workflows-list-pane,
#workflows-detail-pane,
#workflows-inspector-pane,
#mcp-server-tree-pane,
#mcp-detail-pane,
#mcp-readiness-pane,
#acp-list-pane,
#acp-detail-pane {
    margin: 0 1 0 0;
}

#artifacts-inspector-pane,
#personas-inspector-pane,
#watchlists-inspector-pane,
#workflows-inspector-pane,
#mcp-readiness-pane,
#acp-inspector-pane {
    margin: 0;
}

#personas-list-pane,
#personas-detail-pane,
#personas-inspector-pane,
#watchlists-list-pane,
#watchlists-detail-pane,
#watchlists-inspector-pane,
#workflows-list-pane,
#workflows-detail-pane,
#workflows-inspector-pane,
#acp-list-pane,
#acp-detail-pane,
#acp-inspector-pane,
#evals-library-pane,
#evals-detail-pane,
#evals-inspector-pane {
    height: 100%;
    min-height: 0;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

#personas-inspector-pane {
    width: 2fr;
    min-width: 30;
    border: solid $ds-grid-line;
    padding: 1;
}

#personas-readiness-console {
    width: 100%;
    min-width: 0;
    height: auto;
    text-wrap: wrap;
}

/* Workbench column split (2:4:2). Required here because the generic
   .destination-workbench-pane width (1fr) outranks the screen's DEFAULT_CSS,
   which would squeeze the work area to a third of its intended width. */
#personas-library-pane {
    width: 2fr;
    min-width: 24;
}

#personas-work-area {
    width: 4fr;
    min-width: 40;
}

#personas-workbench.personas-workbench-compact {
    padding: 0;
}

#personas-library-pane.personas-workbench-compact-pane {
    width: 1fr;
    min-width: 16;
    padding: 0 1;
}

#personas-work-area.personas-workbench-compact-pane {
    width: 3fr;
    min-width: 34;
    padding: 0 1;
}

#personas-inspector-pane.personas-workbench-compact-pane {
    width: 1fr;
    min-width: 22;
    padding: 0 1;
}

#workflows-list-pane,
#acp-list-pane {
    width: 2fr;
    min-width: 30;
    border: solid $ds-grid-line;
    padding: 1;
}

#workflows-detail-pane,
#acp-detail-pane {
    width: 4fr;
    min-width: 52;
    border: solid $ds-grid-line;
    padding: 1;
}

#workflows-inspector-pane,
#acp-inspector-pane {
    width: 2fr;
    min-width: 34;
    border: solid $ds-grid-line;
    padding: 1;
}

.acp-selected-session-row {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.acp-inspector-group-title {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 1 0 0 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

#personas-list-detail-divider,
#personas-detail-inspector-divider,
#watchlists-list-detail-divider,
#watchlists-detail-inspector-divider,
#schedules-list-detail-divider,
#schedules-detail-inspector-divider,
#workflows-list-detail-divider,
#workflows-detail-inspector-divider,
#acp-list-detail-divider,
#acp-detail-inspector-divider {
    background: $ds-grid-line;
}

.artifacts-column-title,
.personas-column-title,
.watchlists-column-title,
.schedules-column-title,
.workflows-column-title,
.acp-column-title,
.skills-column-title,
.ccp-column-title,
.settings-column-title {
    width: 100%;
    height: 1;
    min-height: 1;
    padding: 0 1;
    margin: 0 0 1 0;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.settings-active-section {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

Button.settings-category-button {
    width: 100%;
    height: 1;
    min-height: 1;
    max-height: 1;
    margin: 0;
    padding: 0 1;
    content-align: left middle;
    text-align: left;
    background: $ds-surface-panel;
}

Button.settings-category-button.settings-active-section {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

Button.settings-category-button:focus {
    outline: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

Button.settings-category-button.settings-active-section:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

Button.settings-category-button.settings-active-section:hover,
Button.settings-category-button.settings-active-section:hover:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

Button.settings-category-button.settings-primary-search-match {
    color: $ds-text-primary;
    text-style: bold;
}

Button.settings-category-button.settings-secondary-search-match {
    color: $ds-text-muted;
}

#settings-category-search {
    width: 100%;
    height: 3;
    min-height: 3;
    max-height: 3;
    margin: 0 0 1 0;
    padding: 0 1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

#settings-category-search:focus {
    border: solid $ds-action-focus;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
    outline: none;
}

#settings-category-search.settings-category-search-active {
    border: solid $ds-action-focus;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.settings-category-search-help {
    width: 100%;
    min-height: 1;
    padding: 0 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

.settings-category-search-status {
    width: 100%;
    min-height: 2;
    padding: 0 1;
    margin: 0 0 1 0;
    color: $ds-text-primary;
    background: $ds-surface-panel;
}

.settings-search-empty {
    width: 100%;
    min-height: 3;
    padding: 1;
    margin: 1 0 0 0;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-muted;
}

#settings-shell Button:focus,
#settings-shell Button:hover:focus {
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold underline;
    outline: none;
}

.settings-category-group-title {
    width: 100%;
    height: 1;
    min-height: 1;
    padding: 0 1;
    margin: 0;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
    text-style: bold;
}

.settings-state-banner {
    width: 100%;
    min-height: 1;
    padding: 0 1;
    margin: 0 0 1 0;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
    text-style: bold;
}

.settings-detail-row {
    width: 100%;
    min-height: 1;
    padding: 0 1;
    margin: 0 0 1 0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.settings-input-row {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0 0 1 0;
}

.settings-select-row {
    width: 100%;
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
}

.settings-input-label {
    width: 12;
    min-width: 12;
    height: 1;
    min-height: 1;
    padding: 0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-style: bold;
}

.settings-select-row .settings-input-label {
    height: 3;
    min-height: 3;
    content-align: left middle;
}

/* The Library/RAG detail card (Search/Embedding/Chunking/Vector store/
 * Reranking groups) has the longest field labels in Settings ("Default
 * results", "Embedding model ⚠", "Distance metric ⚠", "Rerank results", ...).
 * The generic 12-column label width clips them to their first wrapped word
 * (Static wraps at the column width but the row stays height:1, so only
 * that first line paints) -- e.g. "Default results" rendered as just
 * "Default", and "Reranker model"/"Reranker top-k" (pre UX-review-2026-07
 * naming) both rendered as the identical "Reranker". Widen the column for
 * this card only so every RAG label fits on one line unambiguously; other
 * Settings categories keep the base 12-column rhythm.
 */
#settings-library-rag-card .settings-input-label {
    width: 20;
    min-width: 20;
}

.settings-compact-input {
    width: 1fr;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
}

.settings-compact-input:focus {
    border: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    /* No underline: it made placeholder copy read as a link (task-185). */
    text-style: bold;
    outline: none;
}

.settings-compact-input.settings-invalid-input,
.settings-compact-select.settings-invalid-input {
    background: $ds-status-error 18%;
    color: $ds-text-primary;
    text-style: bold;
    outline: none;
}

.settings-compact-input.settings-invalid-input:focus,
.settings-compact-select.settings-invalid-input:focus {
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-opacity: 1;
    text-style: bold;
    outline: none;
}

.settings-compact-select {
    width: 1fr;
    height: 3;
    min-height: 3;
    margin: 0;
    padding: 0;
    border: solid $ds-grid-line;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
}

.settings-compact-select > SelectCurrent {
    width: 1fr;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
    content-align: left middle;
}

.settings-compact-select:focus {
    border: solid $ds-action-focus;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
    outline: none;
}

.settings-compact-select:focus > SelectCurrent {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

.settings-compact-select > SelectOverlay {
    padding: 0 1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    min-width: 30;
}

.settings-compact-select > SelectOverlay Option {
    padding: 0 2;
    min-height: 3;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
}

.settings-compact-select > SelectOverlay Option:hover {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

.settings-compact-select > SelectOverlay Option.-selected {
    padding: 0 2;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.settings-provider-manual-hidden {
    display: none;
}

/* task-189: generation-profile rows a provider does not support are hidden
   entirely; the Generation defaults disclosure shows one summary line instead
   of per-row "Unavailable for <provider>" placeholders. */
.settings-gated-profile-hidden {
    display: none;
}

.settings-status-row {
    width: 100%;
    min-height: 1;
    padding: 0 1;
    margin: 0 0 1 0;
    background: $ds-surface-inspector;
    color: $ds-text-muted;
}

.settings-storage-check-result {
    min-height: 7;
}

.settings-category-status-hidden {
    display: none;
}

.settings-dirty-category {
    color: $ds-status-unsaved;
    text-style: bold;
}

/* RAG profile-manager region (task-2): read-only note for a built-in active
   profile -- attention-worthy like #library-skill-warnings above, not muted
   like the surrounding .settings-status-row lines. */
.settings-library-rag-readonly-banner {
    color: $ds-status-warning;
    text-style: bold;
}

/* RAG profile editor (task-3 review): reranker top-k vs default-results
   advisory -- same attention-worthy treatment as the readonly banner above.
   Purely informational (never gates Save; see soft_config_warnings). */
.settings-library-rag-soft-warning {
    color: $ds-status-warning;
    text-style: bold;
}

/* Task 4 (541 v2 UX AC1): profile-picker PREVIEW banner -- shown only while
   the editor is displaying a browsed, non-active profile read-only. Same
   attention-worthy treatment as the readonly banner above (hidden by
   default via Static.display, toggled by _set_library_rag_preview_banner). */
.settings-library-rag-preview-banner {
    color: $ds-status-warning;
    text-style: bold;
}

RagProfileNameModal,
RagProfileSwitchConfirmModal {
    align: center middle;
}

.settings-rag-profile-modal {
    width: 60;
    height: auto;
    padding: 1 2;
    border: thick $ds-action-focus;
    background: $ds-surface-panel;
}

.settings-focus-card {
    width: 100%;
    height: auto;
    min-height: 10;
    padding: 1;
    margin: 0 0 1 0;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

#settings-advanced-config-card {
    height: 1fr;
    min-height: 0;
}

.settings-secondary-card {
    width: 100%;
    height: auto;
    min-height: 6;
    padding: 1;
    margin: 0 0 1 0;
    border: solid $ds-column-line;
    background: $ds-surface-panel;
}

/* Task 5 (541 v2 UX AC5): first-run starter panel -- replaces the "wall of
   disabled fields" a brand-new install used to show with a direct next
   step (Clone/Backfill). Accent border (same treatment as
   .settings-rag-profile-modal above) so it reads as the primary call to
   action, not just another secondary card. Hidden by default via
   Static.display, toggled by `_refresh_rag_first_run_panel_state`/composed
   directly by `_render_library_rag_detail`. */
.settings-library-rag-starter-panel {
    border: thick $ds-action-focus;
}

#settings-console-behavior-card {
    min-height: 12;
}

.settings-action-row {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 1 0;
}

.settings-action-row Button {
    height: 1;
    min-height: 1;
    margin: 0 1 0 0;
}

.settings-action-row Button:focus,
#settings-impact-pane Button:focus {
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold underline;
    outline: none;
}

/* UX review item 7 (delete danger styling): visually separate the RAG
   profile-manager's destructive Delete button from the other three
   (Set active/Clone/Rename) in the same row -- variant="error" alone
   (settings_screen.py) gives it distinct color, but it still read as just
   another button in the row without the extra gap. */
.settings-library-rag-profile-delete-button {
    margin-left: 2;
}

.settings-sync-safety-row {
    width: 100%;
    padding: 0 1;
    background: $ds-surface-raised;
}

.settings-advanced-safety-status {
    background: $ds-status-unsaved 10%;
    color: $ds-status-unsaved;
    text-style: bold;
}

#settings-advanced-config-editor {
    height: 1fr;
    min-height: 10;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

/* Settings > Image Gen: the whole panel and its nested backend-editor
   scroll region default to Textual's framework-level width/height
   fallback (1fr) since neither `Vertical`/`VerticalScroll` declares one
   in DEFAULT_CSS for a widget shaped like this -- fine for a SINGLE
   dominant 1fr child (see InternalPromptsPanel's #internal-prompts-list),
   but this panel has MANY siblings (Backends block, the backend-editor
   region, Generation defaults, Style templates, Save/Revert) all
   competing for the SAME bounded 1fr height, which starved the backend-
   editor region down to ~1 row (verified live: region height 1 vs
   virtual_size height 46) and clipped everything below it (Generation
   defaults, Save/Revert) off the bottom entirely -- `settings-detail-
   pane` (the ancestor Settings already scrolls the WHOLE category
   through) is the one and only scroll owner here. */
#settings-imagegen-panel {
    height: auto;
}

#settings-imagegen-editor {
    height: auto;
}

/* One row per backend inside the Backends block -- label, status badge,
   Enabled checkbox, default marker, Test button. height:auto (not the
   base .settings-input-row's fixed height:1) so the row never clips a
   wrapped Checkbox/Button. */
.settings-imagegen-backend-row {
    width: 100%;
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
    align: left middle;
}

/* min-width 6 (not Button's own default 16) + no left margin: at a
   120-column launch the "Preference Detail" pane is only ~53 columns
   wide, and this row packs 5 pieces (label, badge, checkbox, default
   marker, Test) -- every column here is contested (verified live:
   without this, the DEFAULT backend's row -- the one carrying "★
   Default" -- clipped Test entirely off the visible/clickable area). */
.settings-imagegen-backend-row Button {
    height: 1;
    min-height: 1;
    min-width: 6;
    margin: 0;
}

/* _conversations.tcss's bare `Checkbox { width: 100%; height: 2; }` is an
   unscoped TYPE selector that reaches every Checkbox app-wide (verified
   live: region.width computed to the ROW's full width, overlapping/
   clipping the marker and Test button that come after it in the SAME
   row) -- override both Enabled checkboxes (one per backend row) and the
   standalone "Context LLM enabled" checkbox back to a natural, single-
   line size within this panel specifically; never touching that shared
   global rule, which other screens may rely on. The backend-row Checkbox
   also drops its horizontal padding (unlike the roomier standalone
   context_llm_enabled one) -- same narrow-terminal column budget as the
   Button rule above. */
.settings-imagegen-backend-row Checkbox {
    width: auto;
    height: 1;
    min-height: 1;
    margin-bottom: 0;
    border: none;
    padding: 0;
}



#settings-imagegen-context_llm_enabled {
    width: auto;
    height: 1;
    min-height: 1;
    margin-bottom: 0;
    border: none;
    padding: 0 1;
}

/* No horizontal padding (final review): "Not configured" (14 chars) is
   the longest value this ever holds -- padding just wasted 2 more
   contested columns in the narrow-terminal row budget above. */
.settings-imagegen-badge {
    width: auto;
    min-width: 14;
    color: $ds-text-muted;
}

/* No min-width (final review): reserving 10 columns even when this row
   isn't the default (the common case -- 5 of 6 rows) was pure waste on a
   narrow terminal, where every column in a backend row is contested; let
   it shrink to 0 for an empty marker and grow only for "★ Default". */
.settings-imagegen-default-marker {
    width: auto;
    color: $ds-status-info;
    text-style: bold;
}

.settings-imagegen-hint {
    width: 100%;
    min-height: 1;
    padding: 0 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

.settings-imagegen-key-source {
    color: $ds-status-warning;
}

/* Task 5: the secret field's row grows an inline Clear button next to the
   masked Input -- Button's own default min-width (16) plus the fixed-
   width label would overflow the base .settings-input-row's width:100%/
   height:1 (no wrap headroom), so this row gets its own auto-height class
   and the Clear button gets a narrower min-width. */
.settings-imagegen-secret-row {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.settings-imagegen-secret-row Button.settings-imagegen-clear-button {
    width: auto;
    min-width: 8;
    height: 1;
    min-height: 1;
    margin: 0 0 0 1;
}

/* SwarmUI's swarm_token is optional for local installs -- its "missing"
   source line must not read as an error like the four remote API keys. */
.settings-imagegen-key-source-neutral {
    color: $ds-text-muted;
}

#library-source-browser {
    width: $ds-library-source-browser-width;
    min-width: $ds-library-source-browser-width;
    max-width: $ds-library-source-browser-width;
    height: 100%;
    min-height: 20;
    padding: 1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    overflow-y: auto;
}

.library-hub-spacer {
    height: 1;
    min-height: 1;
}

#library-source-inspector {
    width: 2fr;
    min-width: 0;
    height: 100%;
    min-height: 20;
    padding: 1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    overflow-y: auto;
}

#library-source-detail {
    width: 5fr;
    min-width: 0;
    height: 100%;
    min-height: 20;
    padding: 1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    overflow-y: auto;
}

.ds-shortcut-bar {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: $ds-surface-inspector;
    color: $ds-text-muted;
}

.density-compact .ds-panel,
.density-compact .ds-inspector,
.density-compact .ds-approval-card,
.density-compact .ds-recovery-callout {
    padding: 0 1;
    margin: 0 0 1 0;
}

.density-compact .ds-destination-header {
    min-height: 2;
    padding: 0 1;
}

.density-comfortable .ds-panel,
.density-comfortable .ds-inspector,
.density-comfortable .ds-approval-card,
.density-comfortable .ds-recovery-callout {
    padding: 1 2;
    margin: 1 1;
}

.density-comfortable .ds-destination-header {
    min-height: 4;
    padding: 1 2;
}

.is-active {
    border: round $ds-action-focus;
    text-style: bold;
}

.personas-mode-chip.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.personas-mode-chip.is-active:focus {
    outline: none;
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Keyboard-browse cursor: visually distinct from the flat subdued bg.
   $ds-grid-line (#26364D) is lighter than $ds-surface-raised/#ds-focus-bg
   (#142033) so browsed rows are visible without special-casing focus state.
   Place BEFORE the .is-active rules so equal-specificity cascade gives
   .is-active the final word. */
ListItem.personas-library-row.-highlight,
ListItem.personas-conversation-row.-highlight {
    background: $ds-grid-line;
    color: $ds-text-primary;
    text-style: bold;
}

/* Selected/active row: wins because it appears later in the sheet. */
ListItem.personas-library-row.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

/* Active row that is also the browse cursor: .is-active styling wins
   (later in sheet, same specificity as the -highlight rule above). */
ListItem.personas-library-row.is-active.-highlight {
    outline: none;
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

/* task-445: the global `*:focus { outline: solid $ds-focus-accent; }`
   fallback (core/_reset.tcss) draws its outline around the ListView's own
   box once it takes keyboard focus after a row is selected -- and that box
   is taller than the 1-2 rows it holds (it fills the rail's remaining
   height), so the outline rendered as a tall empty bordered rectangle
   hanging below the selected row (RP UX review). Rows already show
   selection via .is-active/.-highlight backgrounds above, so the fallback
   outline is both redundant and visually broken here. */
#personas-library-rows:focus {
    outline: none;
}

.library-source-action {
    width: $ds-library-source-action-width;
    min-width: $ds-library-source-action-min-width;
    height: $ds-library-source-action-height;
    min-height: $ds-library-source-action-height;
    margin: 0;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $ds-text-primary;
    content-align: left middle;
    text-style: none;
}

.library-source-action-spacer {
    height: 0;
    min-height: 0;
}

.library-source-active-marker {
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

.library-source-group-rule {
    height: 1;
    min-height: 1;
    margin: 0;
    color: $ds-text-muted;
}

.library-source-action:focus {
    border: none;
    background: transparent;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

.library-source-action.is-active,
.library-source-action.is-active:focus {
    border: none;
    background: transparent;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

#library-collection-form Input {
    height: 3;
    min-height: 3;
    padding: 0 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-collection-form Input:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-collection-actions {
    height: 1;
    min-height: 1;
    margin-top: 1;
    align: left middle;
}

#library-collection-actions Button {
    height: 1;
    min-height: 1;
    margin-right: 1;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $ds-text-primary;
    content-align: left middle;
    text-style: none;
}

#library-collection-actions Button:focus {
    border: none;
    background: transparent;
    color: $ds-focus-fg;
    outline: none;
    text-style: bold underline;
}

/* Regression fix: #library-canvas (this panel's parent) and this panel's
 * own body never scrolled, so once the Query/Scope/Results/History regions'
 * combined natural height exceeded the fixed canvas box, whatever fell
 * past the bottom edge was silently clipped and permanently unreachable --
 * not just visually cut off, but gone, with no way to scroll to it. That
 * is what made multi-result searches render only the first row: rows past
 * whatever vertical room the Query and Scope regions left behind vanished.
 * Making the panel scrollable keeps every mounted row reachable regardless
 * of how many results (or how much recovery/callout copy) the current
 * state renders. */
#library-search-rag-panel {
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

.library-rag-region {
    width: 100%;
    min-width: 0;
    margin: 0 0 1 0;
}

/* Auto-height: the query row used to be a Horizontal (Input + Button side
 * by side) inside this container, sized with a hand-counted fixed height
 * (14, 17 with the recovery line). Stacking the query Input and Run button
 * as their own full-width rows (house canvas grammar) made that hand count
 * fragile -- content growth (e.g. the mode-toggle button) silently overflowed
 * the fixed height, clipping/overlapping the callout and Run button. Sizing
 * to content avoids re-counting rows by hand every time this region changes. */
#library-rag-query-controls {
    height: auto;
    min-height: 0;
}

/* Auto-height: B2 replaced the fixed pipe-drawn scope table (heading +
 * summary + table header + 7 rows, hand-counted at 13/16 lines) with a
 * heading, a summary line, and three toggle buttons -- a fixed hand count
 * here would re-introduce the exact clipping bug `#library-rag-query-controls`
 * already hit once (see the comment above it). */
#library-rag-source-scope {
    height: auto;
    min-height: 0;
}

#library-rag-results {
    height: auto;
    min-height: 8;
}

#library-rag-query-input {
    width: 100%;
    min-width: 0;
    margin: 0 0 1 0;
    border: solid $ds-grid-line;
    background: $ds-surface-raised;
}

#library-rag-query-input:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
}

#library-rag-scope-summary {
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.library-rag-scope-toggle {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.library-rag-scope-toggle:hover {
    background: $ds-action-focus 20%;
}

.library-rag-scope-toggle:disabled {
    color: $ds-text-disabled;
    background: $ds-surface-raised;
}

.library-rag-callout {
    width: 100%;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

/* Reserved for real failures only (unsafe query, missing dependencies/
 * index, no provider) -- the ready state has no callout at all (A2), and
 * the empty-query / no-scope gates render `.library-rag-quiet-line`
 * instead (A1), so there is no "is-ready" callout variant to style. */
.library-rag-callout.is-blocked {
    border: solid $ds-status-warning;
    background: $ds-status-warning 10%;
}

.library-rag-quiet-line {
    padding: 0 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

.library-rag-empty-guidance {
    margin: 1 0 0 0;
    padding: 0 1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

#library-rag-run-query {
    width: 18;
    min-width: 16;
    margin: 0 0 1 0;
    background: $ds-action-focus 35%;
    color: $ds-text-primary;
    text-style: bold;
}

#library-rag-run-query:disabled {
    background: $ds-surface-raised;
    color: $ds-text-disabled;
    text-style: none;
}

.library-rag-result-row {
    padding: 0 1;
    margin: 1 0 0 0;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

.library-rag-result-row.is-selected {
    border: heavy $ds-focus-accent;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

.library-rag-result-badges {
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: bold;
}

/* C1: content-first result rows -- Open (primary emphasis, reuses the live
 * `.console-action-primary` colors directly since that class is not
 * Console-screen-scoped) then Select evidence, as a Horizontal of
 * auto-width buttons. */
.library-rag-result-actions {
    width: 100%;
    height: auto;
    margin: 1 0 0 0;
}

.library-rag-result-open {
    width: auto;
    min-width: 10;
    margin: 0 1 0 0;
}

.library-rag-result-action {
    width: auto;
    min-width: 16;
    height: 1;
    min-height: 1;
    padding: 0 1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.library-rag-recovery-action {
    width: 28;
    min-width: 18;
    background: $ds-status-warning 30%;
    color: $ds-text-primary;
    text-style: bold;
}

.library-rag-console-action {
    width: 18;
    min-width: 16;
    background: $ds-action-focus 35%;
    color: $ds-text-primary;
    text-style: bold;
}

.library-rag-center-console-action {
    width: 24;
    min-width: 18;
    margin: 1 0 0 0;
}

.library-rag-console-action:disabled {
    background: $ds-surface-raised;
    color: $ds-text-disabled;
    text-style: none;
}

#library-rag-mode-toggle {
    width: auto;
    min-width: 20;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

#library-rag-mode-toggle:hover {
    background: $ds-action-focus 20%;
}

#library-rag-searching-line {
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: italic;
}

#library-rag-history {
    margin: 1 0 0 0;
}

.library-rag-history-row {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 0 0 1 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.library-rag-history-row:hover {
    background: $ds-action-focus 20%;
}

.library-rag-history-empty {
    color: $ds-text-muted;
    padding: 0 1;
}

.library-rag-history-hint {
    color: $ds-text-muted;
    padding: 0 1;
    margin: 0 0 1 0;
}

.library-rag-history-clear {
    width: 100%;
    min-width: 0;
    height: 2;
    min-height: 2;
    margin: 1 0 0 0;
    padding: 0 1;
    text-align: left;
    content-align: left middle;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.library-rag-history-clear:hover {
    background: $ds-action-focus 20%;
}

.is-disabled {
    opacity: 0.55;
}

.is-blocked {
    border: round $ds-status-error;
    background: $ds-status-error 10%;
}

.is-running {
    border: round $ds-status-running;
}

.is-paused {
    border: round $ds-status-paused;
}

.is-unsaved {
    border: round $ds-status-unsaved;
}

.is-stale {
    color: $ds-text-muted;
}

.is-conflict {
    border: thick $ds-status-error;
}

.needs-approval {
    border: thick $ds-status-approval-required;
    background: $ds-status-approval-required 12%;
}

.source-local {
    border: round $ds-authority-local;
}

.source-server {
    border: round $ds-authority-server;
}

.source-workspace {
    border: round $ds-authority-workspace;
}

.source-remote-only {
    border: round $ds-authority-remote-only;
}

.source-dry-run {
    border: dashed $ds-grid-line;
    color: $ds-text-muted;
}

/* --- MCP Hub (Phase 1 workbench) ------------------------------------- */

#mcp-mode-strip Button.mcp-mode-chip {
    width: auto;
    min-width: 10;
    height: 1;
    padding: 0 1;
    border: none;
}

#mcp-mode-strip .mcp-mode-chip.is-active {
    text-style: bold underline;
}

/* A1: focus must not impersonate .is-active above (bold underline). Kept in
   lockstep with the lower-specificity baseline copy in MCPScreen.DEFAULT_CSS
   (mcp_screen.py) -- see that copy's comment for why it uses raw
   $surface/$text/$text-muted tokens instead of these $ds- aliases. */
#mcp-mode-strip .mcp-mode-chip:focus,
#mcp-mode-strip .mcp-mode-chip:hover:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
    outline: none;
}

#mcp-mode-strip .mcp-mode-chip.is-active:focus,
#mcp-mode-strip .mcp-mode-chip.is-active:hover:focus {
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: bold underline;
    outline: none;
}

#mcp-hub-rail {
    width: 3fr;
    min-width: 24;
}

#mcp-hub-rail .mcp-rail-heading {
    height: 1;
    min-height: 1;
    margin-top: 1;
}

/* Override border away from the generic `.is-active` rule (`border: round
   $ds-action-focus`, earlier in this sheet). Button.mcp-rail-row rows are
   fixed at height 1 (see MCPRail.DEFAULT_CSS); a round border needs at
   least 2 lines to render, so on a height-1 button it consumes the row's
   only line and the content area collapses to height 0 -- the label never
   renders, leaving a blank bordered box for the selected row. Mirrors the
   sibling `.mcp-mode-chip.is-active` rule below (and MCPScreen.DEFAULT_CSS's
   copy of it), which already carries this same `border: none` override. */
#mcp-hub-rail Button.mcp-rail-row.is-active {
    border: none;
    text-style: bold;
}

#mcp-hub-canvas {
    width: 5fr;
    min-width: 38;
}

#mcp-hub-inspector {
    width: 3fr;
    min-width: 28;
}

/* A5: the row wrapping the aggregate summary's colored glyph + neutral
   sentence (kept in lockstep with the width rules in
   MCPServersMode.DEFAULT_CSS, mcp_servers_mode.py -- required in EVERY
   harness, not just the bundled one: without an explicit width split, both
   Static children of the Horizontal default to 1fr/full-width and the
   second one renders entirely off-screen). */
#mcp-overview-summary-row,
#mcp-detail-title {
    height: 1;
    min-height: 1;
}

#mcp-overview-callouts .ds-recovery-callout {
    margin-top: 1;
}

/* A2: disabled inspector action buttons must stay legible. The generic
   `Button:disabled` rule above (from _buttons.tcss, same "user CSS" tier as
   this file -- see MCPInspector.DEFAULT_CSS's matching rule and comment for
   why a widget-level DEFAULT_CSS override alone can never win this fight)
   stacks `opacity: 50%` on `$text-disabled` on a dark surface, which reads
   as functionally invisible on top of `.console-action-secondary`. Restore
   full opacity and use a dim-but-still-readable color instead. */
#mcp-hub-inspector Button.mcp-inspector-action:disabled {
    opacity: 100%;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: none;
}

#mcp-hub-inspector Button.mcp-inspector-action:disabled:hover {
    opacity: 100%;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: none;
}

/* A3: same Button center-default lesson as Button.mcp-rail-row
   (MCPRail.DEFAULT_CSS) and Button.mcp-callout below -- left-align the
   inspector's action stack. Kept in lockstep with the baseline copy in
   MCPInspector.DEFAULT_CSS (mcp_inspector.py). */
Button.mcp-inspector-action {
    text-align: left;
    content-align: left middle;
}

/* --- MCP Hub Phase 2 ------------------------------------------------- */
.mcp-status-ready { color: $ds-status-ready; }
.mcp-status-warning { color: $ds-status-warning; }
.mcp-status-error { color: $ds-status-error; }
.mcp-status-info { color: $ds-status-info; }

.ds-info-callout {
    border: round $ds-status-info;
    background: $ds-status-info 10%;
    padding: 0 1;
    height: auto;
}

Button.mcp-callout {
    width: 100%;
    height: 1;
    min-height: 1;
    padding: 0 1;
    border: none;
    /* Button defaults BOTH text-align AND content-align to center (see
       Textual's own Button.DEFAULT_CSS, and the same lesson documented on
       Button.mcp-rail-row in MCPRail.DEFAULT_CSS) -- text-align alone does
       not left-align a one-line Button label; without content-align the
       whole callout line still rendered centered under the table. */
    text-align: left;
    content-align: left middle;
}

#mcp-servers-form {
    height: auto;
    min-height: 0;
}

/* Kept in lockstep with the baseline copy in MCPServersMode.DEFAULT_CSS
   (mcp_servers_mode.py) -- T7 (P3 UX batch) gave the overview table
   `height: auto; max-height: 70%;` so it hugs its own row count instead of
   a `1fr` table ballooning to fill the pane and stranding
   #mcp-overview-callouts dozens of rows below its last row (same bug class
   as #mcp-detail-builtin-toggles below). Without this bundle-layer copy,
   app-loaded CSS cascading on top of DEFAULT_CSS could silently
   reintroduce that regression. */
#mcp-servers-table {
    height: auto;
    max-height: 70%;
}

/* Kept in lockstep with the baseline copy in MCPToolsMode.DEFAULT_CSS
   (mcp_tools_mode.py) -- same fix, same rationale, as #mcp-servers-table
   immediately above. */
#mcp-tools-table {
    height: auto;
    max-height: 70%;
}

/* T9 (P4): kept in lockstep with the baseline copy in
   MCPPermissionsMode.DEFAULT_CSS (mcp_permissions_mode.py) -- same fix,
   same rationale, as #mcp-servers-table/#mcp-tools-table above: the matrix
   hugs its own row count instead of ballooning to fill the canvas, leaving
   room for the policy-preview strip below it. */
#mcp-perm-table {
    height: auto;
    max-height: 70%;
}

/* T9 (P4): kept in lockstep with the baseline copy in
   MCPPermissionsMode.DEFAULT_CSS -- the policy-preview strip below the
   matrix is a single Static (a sentence or two at most); without this,
   Vertical's own default sizing could let it compete with the matrix table
   above for the canvas's remaining space instead of hugging its own
   content, same bug class as #mcp-detail-builtin-toggles/#mcp-import-list
   below. */
#mcp-perm-preview {
    height: auto;
    min-height: 0;
}

/* Defect 1 fix (QA round mcp-hub-phase3-2026-07): kept in lockstep with the
   baseline copy in MCPToolsMode.DEFAULT_CSS (mcp_tools_mode.py), but here
   it's load-bearing, not just defensive. Textual's cascade always treats
   every CSS_PATH-sourced rule (this bundle) as higher priority than any
   widget's own DEFAULT_CSS, regardless of selector specificity -- so
   _conversations.tcss's global, unscoped `Select { width: 100%; }` rule
   (intended for a completely different screen's sidebar forms) was
   silently winning over MCPToolsMode's own, far more specific override,
   collapsing the filter-server Select to a 0x0 region against its
   `width: auto` slot parent (the sibling filter Input already claims the
   full bar at `width: 1fr`). This copy must live in the bundle itself,
   with equal-or-higher specificity than that bare rule, to actually win. */
#mcp-tools-filter-server-slot Select {
    width: 28;
}

/* Kept in lockstep with the baseline copy in MCPServersMode.DEFAULT_CSS
   (mcp_servers_mode.py) -- without an explicit height override here too,
   Textual's Vertical default (height: 1fr) expands this container to fill
   the rest of #mcp-detail-scroll, pushing its sibling "Copy client config"
   Button roughly 800px below the built-in enable/expose checkboxes it
   should sit directly under. QA defect 1, mcp-hub-phase2-2026-07 round. */
#mcp-detail-builtin-toggles {
    height: auto;
    min-height: 0;
}

#mcp-detail-toolbar Button {
    height: 1;
    min-height: 1;
    border: none;
}

/* A1: kept in lockstep with the baseline copy in MCPImportPanel.DEFAULT_CSS
   (mcp_profile_form.py) -- without an explicit height override here too,
   Textual's Vertical default (height: 1fr) expands this container to
   consume whatever vertical space the panel has left, stranding the
   sibling "Import N servers"/Cancel action row far below the preview list
   on a real terminal window (same bug class as #mcp-detail-builtin-toggles,
   QA defect 1, mcp-hub-phase2-2026-07 round). */
#mcp-import-list {
    height: auto;
    min-height: 0;
}

/* T7 (P3 UX batch): quiet focus treatment for the hub's scrollable content
   panes. Both are VerticalScroll (can_focus=True by default, via
   ScrollableContainer) and, without a rule here, fall back to the generic
   `*:focus { outline: solid $ds-focus-accent; }` fallback (core/_reset.tcss)
   -- a heavy boxed cue for panes that just scroll read-only detail text /
   the legacy Advanced form. Mirrors the idiom already established for
   Console content panes elsewhere in this file (#console-left-rail-body:
   focus, #console-workspace-context:focus, #console-workspace-
   conversations:focus): drop the outline/border and shift the background
   instead, so keyboard focus stays visible without boxing the pane. Uses
   $ds-surface-panel (this codebase's quiet-surface token) rather than
   Textual's built-in $boost, which nothing else in this design system
   references. */
#mcp-detail-scroll:focus,
#mcp-adv-scroll:focus {
    outline: none;
    border: none;
    background: $ds-surface-panel;
}

/* --- MCP Hub Phase 5 (T9: Audit mode + Console batch approvals) ------ */

/* Kept in lockstep with the baseline copy in MCPAuditMode.DEFAULT_CSS
   (mcp_audit_mode.py) -- same fix, same rationale, as #mcp-servers-table/
   #mcp-tools-table/#mcp-perm-table above: the execution-log table hugs its
   own row count instead of ballooning to fill the canvas. */
#mcp-audit-table {
    height: auto;
    max-height: 70%;
}

/* Kept in lockstep with the baseline copy in MCPAuditMode.DEFAULT_CSS --
   same fix, same rationale, for the T8 Findings sub-view table. */
#mcp-audit-findings-table {
    height: auto;
    max-height: 70%;
}

/* Kept in lockstep with the baseline copy in MCPAuditMode.DEFAULT_CSS.
   The T8 Executions/Findings sub-view toggle strip is a Horizontal, which
   defaults to `height: 1fr` -- without this override it would expand to
   compete with the table below it for the canvas's remaining space
   instead of hugging its own two-button content, same bug class as
   #mcp-perm-preview/#mcp-detail-builtin-toggles/#mcp-import-list above. */
#mcp-audit-subview-strip {
    height: auto;
    min-height: 0;
}

/* Same Defect-1 Select-width lesson as #mcp-tools-filter-server-slot
   Select above (QA round mcp-hub-phase3-2026-07): `_conversations.tcss`'s
   bare `Select { width: 100%; }` rule always beats DEFAULT_CSS regardless
   of source order, so an id-scoped bundle rule is required for it to
   actually win. MCPAuditMode.DEFAULT_CSS already avoids the 0x0 collapse a
   different way for these two Selects (each lives in its own definite-
   width slot Vertical, not a bare auto-sized one -- see that file's own
   comment) -- these two rules are additional, defensive, EXPLICIT-width
   pins directly on the Selects' own ids (mirroring their slots' widths,
   24/20), kept in lockstep with the matching pair T9 added to
   MCPAuditMode.DEFAULT_CSS itself, so the Selects stay correctly sized
   even if the slot wrapper's own CSS were ever removed or the Select were
   ever mounted outside it. */
#mcp-audit-filter-decision {
    width: 24;
}
#mcp-audit-filter-initiator {
    width: 20;
}

/* The Console MCP batch-approval card's per-row layout
   (`ChatApprovalCard.set_batch()`, chat_approval_card.py -- T5 deferred
   this CSS to T9's phase gate). This card carries no `DEFAULT_CSS` of its
   own at all (unlike the MCP mode widgets above) -- these rules are the
   ONLY styling `.approval-row*` has anywhere, bundle or otherwise.

   `.approval-row` is a Horizontal, which defaults to `height: 1fr` --
   live-repro'd ballooning to the full card height (and its decision
   Select claiming the full ROW width in turn) before this fix, the same
   fr-inside-flex bug class as the MCP lockstep rules above. `height:
   auto` makes each row hug its own single line of content instead.

   `#approval-batch-rows` (the Vertical wrapping all rows) gets the same
   `height: auto` treatment as #mcp-perm-preview/#mcp-detail-builtin-
   toggles/#mcp-import-list above -- without it, its own `height: 1fr`
   default would balloon it to fill the card and push the sibling
   Approve-all/Submit/Deny-all action bar (#approval-batch-actions) far
   below the visible rows.

   `.approval-row-header`/`.approval-row-args` (Statics, natively `width:
   auto`) get an explicit `1fr` share each so unbounded text (a long
   tool/server header, or an args summary up to 80 chars) can't hog the
   row and squeeze the decision Select out of view. `.approval-row-
   decision` (the class selector on the row's Select) gets an explicit
   fixed width -- a CLASS selector already outranks the bare `Select {
   width: 100%; }` type selector on specificity alone, so (unlike the two
   MCP Select fixes above) no id-scoped selector is needed here for it to
   win; without this rule the Select would otherwise claim the row's FULL
   width instead of its own bounded share, overlapping/clipping behind the
   header and args text laid out before it. */
#approval-batch-rows {
    height: auto;
    min-height: 0;
}
.approval-row {
    height: auto;
    min-height: 1;
    width: 1fr;
}
.approval-row-header {
    width: 1fr;
}
.approval-row-args {
    width: 1fr;
}
.approval-row-decision {
    width: 26;
}
/* task-5 (Phase-5 follow-up): a bulk "Approve all"/"Deny all" press can't
   legally reach every narrowed row (`ChatApprovalCard._set_all_batch_
   decisions` -- a row whose `options` exclude every bulk candidate is left
   on its current value instead of crashing). Left unstyled, that row looks
   identical to one nobody has decided on yet. `.needs-decision` (added by
   that same skip path, cleared by the row's own `Select.Changed`) gives it
   the same warning treatment as `.library-rag-callout.is-blocked` above:
   border + a light background tint, using the semantic
   `$ds-status-approval-required` token rather than the generic `$ds-
   status-warning` one, since this state literally IS "still needs an
   approval decision." */
.approval-row.needs-decision {
    border: solid $ds-status-approval-required;
    background: $ds-status-approval-required 10%;
}

/* ConsoleScopePickerModal (rag-scope-narrowing spec §4, Task 8): RAG
   retrieval scope picker -- type tabs, text+tag filters, sort select,
   paginated checkbox list, All/Selected view toggle, bulk select-all/clear
   confirmation, and footer count/Save/Clear/Cancel. Mirrors
   ConsolePromptPickerModal's modal shell (round border, $ds-surface-panel,
   1 2 padding) sized wider/taller for the extra filter/list chrome. */
ConsoleScopePickerModal {
    align: center middle;
}

#console-scope-picker-modal {
    width: 90;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: 1 2;
}

.console-scope-picker-tabs {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.console-scope-picker-tab {
    margin: 0 1 0 0;
}

.console-scope-picker-tab-active {
    background: $ds-action-focus;
    text-style: bold;
}

#console-scope-picker-text-filter {
    height: 3;
    min-height: 3;
    margin: 0 0 1 0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-scope-picker-text-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

.console-scope-picker-tag-row {
    height: auto;
    margin: 0 0 1 0;
}

.console-scope-picker-chip-row {
    height: auto;
    min-height: 1;
}

#console-scope-picker-tag-search {
    height: 3;
    min-height: 3;
    margin: 0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-scope-picker-tag-search:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

.console-scope-picker-tag-chip {
    margin: 0 1 0 0;
}

.console-scope-picker-tag-chip-active {
    background: $ds-action-focus;
    text-style: bold;
}

.console-scope-picker-sort-row {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.console-scope-picker-sort-label {
    width: 6;
    min-width: 6;
    content-align: left middle;
}

.console-scope-picker-view-row {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.console-scope-picker-view-btn {
    margin: 0 1 0 0;
}

.console-scope-picker-view-active {
    background: $ds-action-focus;
    text-style: bold;
}

#console-scope-picker-list {
    height: 1fr;
    min-height: 8;
    max-height: 20;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
}

.console-scope-picker-row {
    width: 100%;
    height: auto;
    min-height: 1;
    color: $ds-text-primary;
}

.console-scope-picker-row-greyed {
    color: $ds-text-muted;
}

#console-scope-picker-empty {
    height: auto;
    margin: 1 0;
    color: $ds-text-muted;
}

.console-scope-picker-page-row {
    height: auto;
    min-height: 1;
    margin: 1 0;
    align-horizontal: center;
}

#console-scope-picker-page-label {
    width: auto;
    min-width: 12;
    content-align: center middle;
    margin: 0 1;
}

.console-scope-picker-bulk-row {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

#console-scope-picker-confirm-text {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    background: $ds-status-warning 10%;
    color: $ds-text-primary;
}

.console-scope-picker-confirm-actions {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.console-scope-picker-footer {
    height: auto;
    min-height: 1;
    margin: 1 0 0 0;
    align-horizontal: right;
}

#console-scope-picker-count {
    width: 1fr;
    min-width: 0;
    content-align: left middle;
    color: $ds-text-muted;
}

/* Internal Prompts settings page */
#internal-prompts-search { width: 1fr; margin: 0 0 1 0; }
#internal-prompts-list { height: 1fr; }
.internal-prompts-group-header { text-style: bold; padding: 1 0 0 0; color: $text-muted; }
.internal-prompt-row { width: 1fr; height: auto; }
.internal-prompt-row.row-customized { border-left: thick $accent; }
.internal-prompt-row.row-default-changed { border-left: thick $warning; }
#internal-prompt-editor-modal { width: 90%; max-width: 120; height: auto; max-height: 90%; padding: 1 2; background: $panel; border: thick $primary; }
.internal-prompt-editor-contract { color: $warning; padding: 1 0; }
.internal-prompt-editor-chips { color: $text-muted; }
.internal-prompt-editor-applies { color: $text-muted; text-style: italic; }
.internal-prompt-editor-preview { background: $boost; padding: 1; height: auto; max-height: 12; }
.internal-prompt-editor-error { color: $error; }
.internal-prompt-editor-actions { align-horizontal: right; height: auto; padding: 1 0 0 0; }

/* ===== MODULE: components/_workbench.tcss ===== */
/* ========================================
 * COMPONENTS: Workbench
 * ========================================
 * Shared destination workbench frame, command, mode, recovery, pane,
 * state, and density contracts.
 * ======================================== */

.workbench-frame {
    width: 100%;
    height: 100%;
    min-height: 0;
    layout: vertical;
    overflow: hidden;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.workbench-header {
    height: auto;
    min-height: 2;
    padding: 0 1;
    margin: 0;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.workbench-header-title {
    height: 1;
    min-height: 1;
    text-style: bold;
}

.workbench-header-subtitle {
    height: 1;
    min-height: 1;
    color: $ds-text-muted;
}

.workbench-header.has-empty-subtitle .workbench-header-subtitle {
    display: none;
}

.workbench-header-status {
    width: auto;
    height: 1;
    min-height: 1;
}

/* task-523: red cue when the Roleplay Console handoff provider is unready.
   `status-blocked` lands on the DestinationHeader (#personas-header); the
   badge word is the child #workbench-header-status (also .ds-status-badge,
   whose app-tier `color: $ds-text-primary` this id+class+descendant selector
   outranks so the "Blocked" word actually turns red). */
#personas-header.status-blocked .workbench-header-status {
    color: $ds-status-blocked;
}

.workbench-command-strip,
.workbench-mode-strip {
    height: 1;
    min-height: 1;
    padding: 0 1;
    margin: 0;
    layout: horizontal;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.workbench-action,
.workbench-mode {
    width: auto;
    height: 1;
    min-height: 1;
    margin: 0 1 0 0;
}

.workbench-action {
    padding: 0 1;
}

.workbench-action.is-primary {
    text-style: bold;
}

.workbench-action.is-disabled {
    color: $ds-text-disabled;
}

.workbench-mode {
    padding: 0 1;
    color: $ds-text-muted;
}

.workbench-mode.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

.workbench-recovery-callout {
    height: auto;
    min-height: 0;
    padding: 0 1;
    margin: 0;
    border: solid $ds-status-warning;
    background: $ds-status-warning 10%;
    color: $ds-text-primary;
}

.workbench-recovery-callout.is-hidden {
    display: none;
}

.workbench-recovery-title {
    height: 1;
    min-height: 1;
    text-style: bold;
}

.workbench-recovery-body {
    height: auto;
    min-height: 1;
    color: $ds-text-primary;
}

.workbench-recovery-action {
    width: auto;
    height: 1;
    min-height: 1;
    margin: 1 0 0 0;
}

.workbench-pane-region {
    height: 1fr;
    min-height: 0;
    layout: horizontal;
    overflow: hidden;
}

.workbench-pane {
    width: 1fr;
    height: 1fr;
    min-width: 0;
    min-height: 0;
    padding: 0 1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

.workbench-pane.is-collapsed {
    width: 3;
    min-width: 3;
}

.workbench-pane-title,
.workbench-pane-status {
    height: 1;
    min-height: 1;
}

.workbench-pane-title {
    text-style: bold;
}

.workbench-state-block {
    height: 1;
    min-height: 1;
    padding: 0 1;
    layout: horizontal;
    background: $ds-surface-raised;
    color: $ds-text-muted;
}

.workbench-state-route,
.workbench-state-density {
    width: auto;
    height: 1;
    min-height: 1;
    margin: 0 1 0 0;
}

.workbench-frame .status-ready {
    border-title-color: $ds-status-ready;
}

.workbench-frame .status-running,
.workbench-frame .status-loading {
    border-title-color: $ds-status-running;
}

.workbench-frame .status-blocked,
.workbench-frame .status-error {
    border-title-color: $ds-status-error;
}

.workbench-frame .status-paused,
.workbench-frame .status-empty {
    border-title-color: $ds-status-warning;
}

.density-normal .workbench-header {
    min-height: 2;
    padding: 0 1;
}

.density-normal .workbench-pane {
    padding: 1;
}

.density-compact .workbench-header {
    min-height: 1;
    padding: 0 1;
}

.density-compact .workbench-header-subtitle {
    display: none;
}

.density-compact .workbench-pane {
    padding: 0 1;
}

/* ===== MODULE: components/_widgets.tcss ===== */
/* ========================================
 * COMPONENTS: Widgets
 * ======================================== 
 * Miscellaneous reusable widgets
 * ======================================== */

/* Collapsible widget styling with enhanced UX */
Collapsible {
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
    border: round $surface-lighten-1;
    background: $surface;
}

/* NOTE: Textual's Collapsible title is the CollapsibleTitle widget type --
 * there is no ".collapsible--header" component class on this Textual
 * version (8.2.7). Rules keyed on that dead class never matched anything,
 * so a focused title fell through to Textual's own CollapsibleTitle:focus
 * default (a background/foreground pairing derived from the theme that can
 * render as an unreadable solid block against this app's palette). Target
 * the real widget type so the app's own focus treatment applies.
 *
 * I2 (SP3 final review): that selector rename alone made this file's
 * decorative Collapsible styling (height/background/padding/hover/
 * border-bottom below) apply to EVERY Collapsible app-wide (~35 screens) for
 * the first time -- pre-fix, the dead ".collapsible--header" selector meant
 * NONE of it (not even :focus) ever actually applied anywhere. Only the
 * Library/RAG settings screen was visually QA'd against the new appearance
 * (Docs/superpowers/qa/rag-settings-sp3-2026-07/). So only the genuinely
 * app-wide bug -- an invisible focused title -- stays global here; the
 * decorative restyle is scoped to the Library/RAG card further down, so
 * every other screen's Collapsibles keep their pre-fix appearance. */
Collapsible > CollapsibleTitle:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border-bottom: solid $ds-focus-accent;
    outline: none;
}

Collapsible.-collapsed > CollapsibleTitle:focus {
    border-bottom: solid $ds-focus-accent;
}

/* Settings-scoped decorative restyle: only the Library/RAG card's
 * Collapsible groups (Search/Embedding/Chunking/Vector store/Reranking)
 * were captured and reviewed against this height/background/padding/hover/
 * border treatment -- see the QA captures referenced above. */
#settings-library-rag-card Collapsible > CollapsibleTitle {
    height: 2;
    min-height: 2;
    padding: 0 1;
    background: $surface-lighten-1;
    color: $text;
    border-bottom: solid $border;
}

#settings-library-rag-card Collapsible > CollapsibleTitle:hover {
    background: $surface;
    color: $text;
}

#settings-library-rag-card Collapsible.-collapsed > CollapsibleTitle {
    border-bottom: none;
}

/* An ID-qualified selector outranks a plain-type :focus selector in
 * Textual's (id, class, type) specificity model (textual/css/model.py's
 * SelectorSet._total_specificity sums each tier separately and compares
 * id first) -- so the two scoped rules above would otherwise beat the
 * GLOBAL :focus rules near the top of this block for a title that is both
 * inside this card AND focused, reintroducing the invisible-focused-title
 * bug scoped to just Library/RAG. Restate the focus treatment at matching
 * (ID-qualified) specificity so it still wins here, exactly as it did
 * before this rule was scoped. */
#settings-library-rag-card Collapsible > CollapsibleTitle:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border-bottom: solid $ds-focus-accent;
    outline: none;
}

#settings-library-rag-card Collapsible.-collapsed > CollapsibleTitle:focus {
    border-bottom: solid $ds-focus-accent;
}

Collapsible > Contents {
    height: auto;
    padding: 1;
    background: $surface;
}

/* Half height for RAG Settings collapsible header */
#chat-rag-panel > .collapsible--header,
#character-rag-panel > .collapsible--header {
    height: 1;
    min-height: 1;
}

/* Fix for settings collapsibles in sidebars */
.settings-collapsible {
    height: auto !important;
    min-height: 3 !important;
}

.settings-collapsible > Contents {
    height: auto !important;
    padding: 1;
}

/* Ensure controls inside collapsibles are visible */
.settings-collapsible Checkbox {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.settings-collapsible Toggle {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.chat-system-prompt-styling {
    width: 100%;
    height: auto;
    min-height: 3;
    max-height: 10; /* Limit height */
    border: round $surface;
    margin-bottom: 1;
}

/* --- Window Footer Widget --- */

/* KEEP IN SYNC with AppFooterStatus.DEFAULT_CSS (task-264): the widget
   bakes the core layout rules (dock/height/background, #footer-key-quit,
   #footer-spacer, #internal-db-size-indicator) in for stylesheet-less
   harnesses; edits HERE (the live bundle source -- built into
   tldw_cli_modular.tcss) must be mirrored there or harness geometry
   silently diverges from production. */
AppFooterStatus {
    dock: bottom;
    height: 1;  /* Single row height */
    background: $primary-background-darken-1;
    width: 100%;
    layout: horizontal;
    padding: 0 1;
    /* Removed align: right middle; from parent, will control children individually */
}

#footer-key-palette {
    width: auto;
    padding: 0 1; /* Padding around each key binding */
    color: $text-muted;
    dock: left; /* Dock key bindings to the left */
    visibility: visible;
    display: initial;
}

#footer-key-quit {
    width: auto;
    height: 1;
    padding: 0 1; /* Padding around each key binding */
    color: $text-muted;
    dock: left; /* Dock key bindings to the left */
}

#footer-spacer {
    width: 1fr; /* Takes up remaining space in the middle */
    height: 1;
}

#footer-word-count {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $text-muted;
    display: block;
}

#footer-token-count {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $text-muted;
    display: block;
}

#internal-db-size-indicator { /* This is for the DB sizes */
    width: auto;
    height: 1;
    /* content-align: right; Textual doesn't have content-align for Static directly */
    /* dock: right; Docking within Horizontal might be tricky, align on parent is better */
    color: $text-muted;
    dock: right; /* Dock DB sizes to the right */
    padding: 0 1; /* Add padding to the right of DB sizes as well */
    margin-left: 2; /* Add buffer before DB status */
}
/* --- End of Window Footer Widget --- */

/* --- Loading States --- */
.loading-state-container {
    width: 100%;
    height: auto;
    min-height: 10;
}

.loading-view {
    align: center middle;
    padding: 2;
}

.loading-text {
    margin-top: 1;
    color: $text-muted;
}

.error-view {
    align: center middle;
    padding: 2;
    background: $error 10%;
    border: round $error;
}

.error-icon {
    color: $error;
    text-style: bold;
}

.error-message {
    margin: 1 0;
    color: $error;
    text-align: center;
}

.error-actions {
    margin-top: 1;
    align: center middle;
}

.error-actions Button {
    margin: 0 1;
}

/* Skeleton loader styles */
.skeleton-container {
    width: 100%;
    padding: 1;
}

.skeleton-avatar {
    width: 8;
    height: 4;
    background: $surface-lighten-2;
    border: round $surface-lighten-2;
}

.skeleton-title {
    width: 60%;
    height: 1;
    background: $surface-lighten-2;
    margin-bottom: 1;
}

.skeleton-subtitle {
    width: 40%;
    height: 1;
    background: $surface-lighten-1;
}

.skeleton-line {
    height: 1;
    background: $surface-lighten-1;
    margin-bottom: 1;
}

.skeleton-line-full {
    width: 100%;
}

.skeleton-line-90 {
    width: 90%;
}

.skeleton-line-80 {
    width: 80%;
}

.skeleton-line-70 {
    width: 70%;
}

/* Skeleton loader visual indication */
.skeleton-line,
.skeleton-avatar,
.skeleton-title,
.skeleton-subtitle {
    opacity: 70%;
}

/* Inline loader states */
InlineLoader.loading {
    color: $primary;
}

InlineLoader.success {
    color: $success;
}

InlineLoader.error {
    color: $error;
}

/* --- End of Loading States --- */

/* ===== MODULE: components/stats_screen.css ===== */
/* Statistics Screen Styling */

/* Main container */
#stats-container {
    background: $surface;
    height: 100%;
    width: 100%;
    padding: 1;
}

/* Header */
.stats-header {
    text-align: center;
    text-style: bold;
    background: $primary-background-lighten-2;
    color: $text;
    padding: 1 2;
    margin-bottom: 1;
    border: solid $primary;
}

/* Scrollable content */
#stats-scroll {
    height: 100%;
    background: $surface;
}

#stats-content {
    padding: 0 2;
    height: auto;
}

/* Section headers */
.section-header {
    text-style: bold;
    color: $primary;
    margin-top: 2;
    margin-bottom: 1;
    padding-left: 1;
    border-left: thick $primary;
}

.subsection-header {
    color: $text-muted;
    margin: 1 0;
    padding-left: 2;
}

/* Grid layouts */
.stats-grid {
    layout: grid;
    grid-size: 2 2;
    grid-gutter: 1 1;
    margin-bottom: 1;
    height: auto;
    grid-rows: auto;
}

.stats-grid.overview-grid {
    grid-size: 2 2;
}

.stats-grid.activity-grid {
    grid-size: 2 2;
}

.stats-grid.prefs-grid {
    grid-size: 2 2;
}

.stats-grid.ranges-grid {
    grid-size: 2 2;
}

.stats-grid.fun-grid {
    grid-size: 2 2;
}

/* Stat Card Component */
StatCard {
    background: $panel;
    border: solid $border;
    height: auto;
    min-height: 6;
    padding: 1;
}

StatCard:hover {
    background: $primary-background-lighten-1;
    border: solid $primary;
}

.stat-card-inner {
    layout: vertical;
    align: center middle;
    width: 100%;
    height: auto;
}

.stat-card-icon {
    text-align: center;
    text-style: none;
    margin-bottom: 0;
}

.stat-card-title {
    text-align: center;
    color: $text-muted;
    text-style: none;
    margin-bottom: 0;
}

.stat-card-value {
    text-align: center;
    text-style: bold;
    color: $primary;
    margin: 0;
}

.stat-card-subtitle {
    text-align: center;
    color: $text-disabled;
    text-style: italic;
    margin-top: 0;
}

/* Topic Bar Component */
.topic-bar-container {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    align: left middle;
}

.topic-label {
    min-width: 20;
    text-align: left;
    color: $text;
}

.topic-bar-bg {
    width: 1fr;
    height: 1;
    background: $surface-lighten-1;
    margin-left: 1;
}

.topic-bar-fill {
    height: 1;
    background: $primary;
    transition: width 500ms;
}

/* Topics container */
.topics-container {
    background: $panel;
    border: solid $border;
    padding: 1;
    margin-bottom: 1;
    height: auto;
}

/* Topic range cards */
.topic-range-card {
    height: auto;
    min-height: 4;
}

.topic-range-card .stat-card-value {
    text-style: none;
}

/* Character stats */
.character-stats-container {
    background: $panel;
    border: solid $border;
    padding: 1;
    margin-bottom: 1;
    height: auto;
}

.character-total {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.character-item {
    padding: 0 1;
    margin-bottom: 1;
}

.character-name {
    text-style: bold;
    color: $text;
}

.character-stats {
    color: $text-muted;
    text-style: italic;
    padding-left: 2;
}

/* Loading states */
.loading-container {
    align: center middle;
    height: 20;
}

.loading-text {
    margin-top: 2;
    color: $text-muted;
}

/* Error states */
.error-container {
    align: center middle;
    padding: 4;
}

.error-message {
    color: $error;
    text-style: bold;
    margin-bottom: 2;
}

.retry-button {
    margin-top: 1;
}

/* No data message */
.no-data-message {
    text-align: center;
    color: $text-muted;
    padding: 4;
}

/* Note: Textual doesn't support media queries
   Grid will automatically adjust based on available space */

/* ===== MODULE: components/_settings_splash_theme.tcss ===== */
/* Settings splash-screen viewer + theme editor styles.
 *
 * TASK-394: this module previously also carried the OLD (pre-Settings) splash
 * viewer's generic component styles -- bare `VerticalScroll` plus app-wide class
 * names (.setting-label, .section-header, .help-text, .action-buttons,
 * .settings-section, .card-list, .preview-*). Those either leaked app-wide or
 * were dead. The genuinely shared ones moved verbatim to
 * `components/_shared_components.tcss` (same bundle position -> unchanged
 * cascade); the app-wide scrollbar default moved to `core/_base.tcss`; the
 * zero-importer orphans were removed. What remains below is the LIVE, feature-
 * scoped styling for the in-Settings theme editor and splash-screen viewer
 * (`settings_theme_editor.py`, `settings_splash_screen_viewer.py`). */

/* ===== Settings theme editor ===== */
#settings-theme-tree {
    width: 100%;
    height: 12;
    min-height: 8;
    border: solid $ds-grid-line;
    margin: 1 0 0 0;
}

.settings-preview-grid {
    width: 100%;
    height: auto;
    min-height: 8;
    margin: 1 0;
}

.preview-column {
    width: 1fr;
    height: auto;
    padding: 0 1;
}

.color-swatch {
    width: 7;
    min-width: 7;
    height: 1;
    min-height: 1;
    border: solid $ds-grid-line;
    content-align: center middle;
    text-style: bold;
}

.color-preset-swatch {
    width: 2;
    min-width: 2;
    height: 1;
    min-height: 1;
    margin: 0 1 0 0;
    border: solid $ds-grid-line;
}

.preview-button {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0 0 1 0;
}

.preview-surface-demo,
.preview-panel-demo,
.preview-boost-demo {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0 0 1 0;
    border: solid $ds-grid-line;
    content-align: center middle;
}

/* ===== Settings splash screen viewer ===== */
.settings-splash-gallery {
    height: 24;
    min-height: 16;
    width: 100%;
}

#settings-splash-card-list {
    width: 45%;
    height: 100%;
    border: solid $primary-lighten-2;
}

#settings-splash-preview-scroll {
    width: 1fr;
    height: 100%;
    border: solid $primary-lighten-2;
    background: $surface;
}

.settings-splash-preview {
    width: 100%;
    height: 100%;
}

.settings-splash-preview #splash-display {
    width: 100%;
    height: 100%;
}

/* ===== MODULE: components/_shared_components.tcss ===== */
/* Shared UI component styles.
 *
 * TASK-394: these generic, app-wide component classes (used across settings
 * forms, previews, eval/dataset/coderepo panels, etc.) previously lived in
 * `components/_settings_splash_theme.tcss` -- a feature module whose bare
 * definitions leaked and, worse, disguised their app-wide reach. They are moved
 * here verbatim, at the SAME bundle position (right after the splash/theme
 * module), so the effective cascade is unchanged while the splash module stops
 * owning generic component styles. (Consolidating these with the other bare
 * duplicate definitions scattered across feature modules is a larger,
 * out-of-scope cleanup; this move only relocates the splash module's copies.)
 */

/* Scrollable card / preview lists */
.card-list {
    height: 1fr;
    scrollbar-size: 1 1;
}

/* Preview panels shared by settings, coderepo, dataset, eval, chunk previews */
.preview-panel {
    width: 1fr;
    height: 100%;
    border: solid $primary;
    padding: 1;
}

.preview-container {
    width: 1fr;
    layout: vertical;
    border: solid $primary;
    padding: 1;
}

.preview-content {
    padding: 1;
    text-align: center;
}

/* Settings form components */
.settings-section {
    height: auto;
    padding: 1;
    margin-top: 1;
    border-top: solid $primary;
}

.setting-label {
    width: 20;
    text-align: right;
    margin-right: 1;
}

.section-header {
    text-style: bold;
    color: $primary;
    padding: 1 0;
}

.help-text {
    text-style: italic;
    color: $text-muted;
    padding: 0 0 1 0;
    text-align: center;
}

/* Action button rows */
.action-buttons {
    height: 3;
    layout: horizontal;
    align: center middle;
    padding: 1;
    margin-top: 1;
}

.action-buttons Button {
    margin: 0 1;
}

/* Generic window heading. Relocated from features/_ingest_tldw_api_tabs.tcss
   when that sheet was retired with the standalone ingest window (task-745):
   the rule is unscoped and was the ONLY bundled definition of .window-title,
   while ChatbookExportManagementWindow, ChatbookTemplatesWindow and
   Voice_Cloning_Window all mount it. Deleting the sheet without moving this
   would have silently unstyled three live windows. */
.window-title {
    text-style: bold;
    text-align: center;
    padding: 1 0;
    background: $primary;
    color: $text;
}

/* ===== MODULE: features/_chat.tcss ===== */
/* ========================================
 * FEATURES: Chat
 * ======================================== 
 * Chat tab specific styles
 * ======================================== */

/* --- Chat sidebar toggle buttons --- */
.chat-sidebar-toggle-button {
    width: 3;
    height: 100%;
    min-width: 3;
    max-width: 3;
    border: none;
    background: $background;
    color: $text-muted;
    padding: 1 0 0 0;
    margin: 0;
    content-align: center top;
}

.chat-sidebar-toggle-button:hover {
    background: $surface;
    color: $text;
}

.chat-sidebar-toggle-button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border: none;
    outline: none;
}

/* --- Chat Window specific layouts --- */
#chat-main-content {
    layout: vertical;
    height: 100%;
    width: 1fr; /* Takes remaining space */
    min-width: 40; /* Prevent squashing */
}

/* --- Compact Model Bar --- */
#compact-model-bar {
    height: 3;
    width: 100%;
    padding: 0 1;
    background: $surface;
    border-bottom: solid $surface-lighten-1;
    align: left middle;
}

#compact-model-bar Select {
    width: 1fr;
    margin: 0 1 0 0;
    height: 3;
}

.compact-bar-label {
    width: auto;
    padding: 0 1;
    color: $text-muted;
}

.compact-bar-temp {
    width: 12;
    margin: 0 1 0 0;
    height: 3;
}

.compact-bar-toggle {
    width: auto;
    min-width: 5;
    height: 3;
    border: none;
    background: $surface-darken-1;
    color: $text-muted;
}

.compact-bar-toggle:hover {
    background: $surface;
    color: $text;
}

/* Send button states */
.send-button {
    width: 2fr;
    margin-left: 1;
    text-style: bold;
}

.send-button.stop-state {
    background: $error;
}

/* Attachment button */
.attach-button {
    width: auto;
    margin-left: 1;
}

/* Voice input widget styles */
.voice-input-widget {
    padding: 1;
    background: $surface;
    border: solid $primary;
}

/* Notes area expansion states */
.notes-textarea-normal {
    height: 10;
}

.notes-textarea-expanded {
    height: 25;
}

/* Chat message type-specific styles */
.chat-message.user {
    background: $primary-lighten-2;
    text-align: right;
}

.chat-message.assistant {
    background: $surface-lighten-1;
    text-align: left;
}

/* Loading and error states */
.loading-indicator {
    text-align: center;
    padding: 2;
    color: $text-muted;
}

.error-message {
    color: $error;
    padding: 1;
    margin: 1;
    border: solid $error;
}
/* Send button styling (shared) */
.send-button { /* Targets Button */
    width: 1fr;      /* Equal flexible width */
    height: 3;       /* Fixed height for consistency */
    /* align-self: stretch; REMOVED */
    margin-top: 0;
    padding: 0;      /* No padding for button */
    transition: background 0.2s, color 0.2s;
}

/* Stop button state - when button is in stop mode */
.send-button:disabled {
    opacity: 0.7;
}

/* Visual feedback for stop state */
.send-button.stop-state {
    background: $error;
    color: white;
}

.stop-button {
    width: 1fr;      /* Equal flexible width */
    height: 3;
    margin-top: 0;
}

/* Clone Chat Button in chat-right-sidebar */
.clone-chat-button {
    margin-top: 1;   /* Add space above the button */
    width: 100%;     /* Full width like other sidebar buttons */
}

/* Chat Sidebar - Prompts Section */
#chat-prompts-collapsible Input,
#chat-prompts-collapsible ListView,
#chat-prompts-collapsible Button {
    margin-bottom: 1; /* Consistent spacing */
}
#chat-prompt-list-view { /* ID for the prompt list in chat sidebar */
    height: 8; /* Adjust as needed */
    border: round $surface;
    margin-bottom: 1;
}
.loaded-prompt-area { /* Container for loaded prompt details in chat sidebar */
    margin-top: 1;
    padding: 0 1;        /* Padding for content inside */
    background: $surface; /* Slightly different background to group elements */
    /* To get rounded corners for the area itself, apply a border style */
    border: round $primary-background-lighten-1; /* Example: round border with a light color */
                                               /* Or use 'round $surface' if you want it less distinct */
                                               /* Or 'none' if you only want background and no explicit border */
}
/* End of Character Sidebar Specific Styles */

/* --- Chat Settings Mode Styles --- */

/* Settings mode toggle container */
.settings-mode-container {
    layout: horizontal;
    height: 3;
    width: 100%;
    align: center middle;
    margin-bottom: 1;
    padding: 0 1;
}

/* Mode labels */
.mode-label {
    margin: 0 1;
    color: $text-muted;
}

/* Settings mode toggle switch */
.settings-mode-toggle {
    margin: 0 1;
}

/* Settings search input */
.settings-search-input {
    width: 100%;
    margin-bottom: 2;
    border: round $primary;
}



/* RAG preset select */
.rag-preset-select {
    width: 50%;
}

/* Section headers */
.section-header {
    text-style: bold underline;
    color: $primary;
    margin-bottom: 1;
    margin-top: 1;
}

.subsection-header {
    text-style: bold;
    color: $secondary;
    margin-bottom: 1;
    margin-top: 1;
}

/* Info text */
.info-text {
    color: $text-muted;
    text-style: italic;
    margin-bottom: 1;
}

/* Hidden class for mode switching */
.hidden {
    display: none;
}

/* Search highlighting */
.search-hidden {
    display: none;
}

.search-highlighted {
    background: $warning 20%;
    border: round $warning;
}

/* Settings containers for mode switching */
#chat-basic-settings-container {
    width: 100%;
}

#chat-advanced-settings-container {
    width: 100%;
}

/* --- End Chat Settings Mode Styles ---*/

/* --- Enhanced Chat Settings Styles --- */

/* Mode toggle container */
.mode-toggle-container {
    layout: horizontal;
    height: 4;  /* Increased height to prevent cutoff */
    width: 100%;
    align: center middle;
    margin-bottom: 1;
    padding: 0 0 1 0;  /* Add bottom padding */
}

/* Mode labels */
.mode-label {
    margin: 0 1;
    color: $text-muted;
}

/* Settings mode toggle switch */
.settings-mode-toggle {
    margin: 0 1;
    /* Custom styling for better visibility */
    background: $panel;
    border: solid $primary;
}

/* Switch widget styling for better visibility */
.settings-mode-toggle > .switch--slider {
    background: $primary;  /* Neutral blue when off (Basic mode) */
}

.settings-mode-toggle.-on > .switch--slider {
    background: $accent;  /* Accent color when on (Advanced mode) */
}

/* Switch thumb/handle styling */
.settings-mode-toggle .switch--slider {
    border: solid $primary;
}

/* Advanced Settings checkbox styling */
.advanced-settings-checkbox {
    margin-top: 1;
    margin-bottom: 1;
}

.advanced-settings-checkbox > Checkbox {
    color: $text;
}

.advanced-settings-checkbox:hover {
    color: $accent;
}

/* Settings search input */
.settings-search-input {
    width: 100%;
    margin-bottom: 2;
    border: round $primary;
}

/* RAG Settings Panel - Prominent styling */
.rag-settings-panel {
    padding: 1;
    border: round $surface;  /* Changed to match other panels */
    background: $panel;      /* Changed to standard panel background */
    margin-bottom: 1;
}

/* Remove extra padding from RAG panel content */
.rag-settings-panel Container {
    padding: 0;
    height: auto;
}

/* Highlight RAG panel when focused */
.rag-settings-panel:focus-within {
    border: round $ds-focus-accent;
    background: $panel;
}

/* Remove highlight when collapsed */
.rag-settings-panel.collapsed {
    border: round $surface !important;
    background: $panel !important;
}

/* RAG enable toggle */
.rag-enable-toggle {
    margin-bottom: 1;
}

/* RAG preset select */
.rag-preset-select {
    width: 100%;
    margin-bottom: 1;
}

/* RAG scope options */
.rag-scope-options {
    margin-bottom: 1;
}

.rag-scope-options Checkbox {
    margin-bottom: 0;
}

/* Ensure proper spacing for sidebar labels in RAG panel */
.rag-settings-panel .sidebar-label {
    margin-top: 0;
    margin-bottom: 0;
}

/* Advanced only sections - hidden by default in basic mode */
.advanced-only {
    display: none;
}

/* Show advanced sections when in advanced mode */
.sidebar.advanced-mode .advanced-only {
    display: block;
}

/* Hide advanced-only when in basic mode */
.sidebar.basic-mode .advanced-only {
    display: none;
}

/* Search highlighting */
.search-highlight {
    background: $warning 20%;
    border: round $warning;
}

/* --- End Enhanced Chat Settings Styles ---*/

/* --- Visual Polish: Standardized Button Classes --- */

/* Primary action buttons (Send, Submit) */
.btn-primary {
    background: $primary;
    color: $text;
    text-style: bold;
    border: none;
}

.btn-primary:hover {
    background: $primary-lighten-1;
}


/* Ghost buttons (text-only, minimal) */
.btn-ghost {
    background: transparent;
    color: $text-muted;
    border: none;
}

.btn-ghost:hover {
    background: $surface;
    color: $text;
}

/* --- End Visual Polish ---*/

/* ===== MODULE: features/_conversations.tcss ===== */
/* ========================================
 * FEATURES: Conversations (Refactored)
 * ======================================== 
 * Conversations, Characters, and Prompts tab
 * Single sidebar design following best practices
 * ======================================== */

/* --- Main container layout --- */
#conversations_characters_prompts-window {
    layout: horizontal;
    height: 100%;
}

/* --- Sidebar Styling (Single, unified sidebar) --- */
.ccp-sidebar {
    width: 30%;
    min-width: 25;
    max-width: 40%;
    height: 100%;
    background: $boost;
    padding: 1;
    border-right: thick $background-darken-1;
    overflow-y: auto;
    overflow-x: hidden;
}

/* Collapsed state for sidebar */
.ccp-sidebar.collapsed {
    width: 0 !important;
    min-width: 0 !important;
    border-right: none !important;
    padding: 0 !important;
    overflow: hidden !important;
    display: none !important;
}


/* --- View Areas within Content --- */
.ccp-view-area {
    width: 100%;
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 1;
}

/* Hidden class for view switching */
.ccp-view-area.hidden {
    display: none !important;
}

.hidden {
    display: none !important;
}

/* --- Title Styling --- */
.pane-title {
    text-style: bold;
    margin-bottom: 1;
    text-align: center;
    width: 100%;
    background: $primary-background-darken-1;
    padding: 0 1;
    height: 3;
}

.sidebar-title {
    text-style: bold;
    margin-bottom: 1;
    text-align: center;
    color: $primary;
}

/* --- Sidebar Components --- */
.sidebar-label {
    margin-top: 1;
    margin-bottom: 0;
    color: $text-muted;
}

.sidebar-input {
    width: 100%;
    margin-bottom: 1;
    border: solid $primary-lighten-2;
    border-bottom: solid $primary-lighten-2;
}

.sidebar-textarea {
    width: 100%;
    height: 5;
    margin-bottom: 1;
    border: round $surface;
}

.sidebar-textarea.small {
    height: 3;
}

.sidebar-button {
    width: 100%;
    margin-bottom: 1;
    height: 3;
}

.sidebar-button.small {
    width: 45%;
    margin-right: 1;
}

.sidebar-button.danger {
    background: $error-darken-1;
}

.sidebar-button.danger:hover {
    background: $error;
}

.sidebar-listview {
    height: 10;
    margin-bottom: 1;
    border: round $surface;
}

/* Export buttons container */
.export-buttons {
    layout: horizontal;
    height: 3;
    width: 100%;
    margin-bottom: 1;
}

.export-buttons Button {
    width: 1fr;
    margin-right: 1;
}

.export-buttons Button:last-child {
    margin-right: 0;
}

/* --- Editor Styling --- */
.editor-scroll {
    width: 100%;
    height: 1fr;
    overflow-y: auto;
    padding: 1;
}

.field-label {
    margin-top: 1;
    margin-bottom: 0;
    color: $text-muted;
    text-style: bold;
}

.field-value {
    margin-bottom: 1;
    padding: 0 1;
}

.field-textarea {
    width: 100%;
    height: 8;
    margin-bottom: 1;
    border: round $surface;
}

.editor-input {
    width: 100%;
    margin-bottom: 1;
}

.editor-textarea {
    width: 100%;
    height: 10;
    margin-bottom: 1;
    border: round $surface;
}

.editor-textarea.small {
    height: 5;
}

/* AI Generation buttons */
.field-with-ai {
    layout: horizontal;
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

.field-with-ai TextArea {
    width: 85%;
    margin-right: 1;
}

.ai-generate-button {
    width: 12%;
    height: 3;
    margin-top: 0;
    background: $primary;
}

.ai-generate-button:hover {
    background: $primary-lighten-1;
}

.ai-generate-button.full-width {
    width: 100%;
    margin-bottom: 1;
}

/* Image controls */
.image-controls {
    layout: horizontal;
    height: 3;
    width: 100%;
    margin-bottom: 1;
}

.image-controls Button {
    width: 1fr;
    margin-right: 1;
}

.image-controls Button:last-child {
    margin-right: 0;
}

.image-status {
    margin-bottom: 1;
    padding: 0 1;
    color: $text-muted;
}

.character-image {
    width: 100%;
    height: 15;
    border: round $surface;
    margin-bottom: 1;
    align: center middle;
    background: $surface-darken-1;
}

/* Editor action buttons */
.editor-actions {
    layout: horizontal;
    height: 3;
    width: 100%;
    margin-top: 2;
    margin-bottom: 1;
}

.editor-actions Button {
    width: 1fr;
    margin-right: 1;
}

.editor-actions Button:last-child {
    margin-right: 0;
}

.primary-button {
    background: $success;
}

.primary-button:hover {
    background: $success-lighten-1;
}

.secondary-button {
    background: $surface;
}

.secondary-button:hover {
    background: $surface-lighten-1;
}

/* Dictionary specific styles */
.dict-entries-list {
    height: 12;
    margin-bottom: 1;
    border: round $surface;
}

.dict-entry-controls {
    layout: horizontal;
    height: 3;
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
}

.dict-entry-controls Button {
    width: 1fr;
    margin-right: 1;
}

.dict-entry-controls Button:last-child {
    margin-right: 0;
}

/* Collapsible styling enhancements */
Collapsible {
    margin-bottom: 1;
}

Collapsible > .collapsible--header {
    background: $primary-background-darken-1;
    color: $text;
    padding: 0 1;
    height: 3;
}

Collapsible.-active > .collapsible--header {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border-bottom: solid $ds-focus-accent;
}

/* Select widget styling */
Select {
    width: 100%;
    margin-bottom: 1;
}

/* Checkbox styling */
Checkbox {
    width: 100%;
    margin-bottom: 0;
    height: 2;
}

/* Message display area */
#ccp-conversation-messages-view {
    padding: 1;
}

/* Scrollbar styling is now an app-wide default in core/_base.tcss (TASK-394):
 * a bare `VerticalScroll` type selector here applied to every scroll view in
 * the app, not just conversations. */

/* Note: Textual doesn't support @media queries for responsive design */
/* Width adjustments would need to be handled programmatically */

/* --- End of refactored Conversations, Characters & Prompts styles --- */

/* ===== MODULE: features/_notes.tcss ===== */
/* ========================================
 * FEATURES: Notes
 * ======================================== 
 * Notes tab specific styles
 * ======================================== */

/* --- Notes Tab Window ---
 * T169: #notes-main-content, .notes-editor, and #notes-controls-area
 * pruned -- pre-workbench legacy Notes tab CSS (Notes_Window.py, since
 * removed; the standalone Notes tab was replaced by the Library
 * workbench's Notes canvas) with zero live references anywhere in
 * tldw_chatbook/*.py.
 */

/* T169: .auto-save-label pruned -- zero live references (same
 * pre-workbench legacy Notes tab as above). */

/* --- End of Notes Tab Window --- */

/* ===== MODULE: features/_media.tcss ===== */
/* ========================================
 * FEATURES: Media
 * ========================================
 * Media tab specific styles
 * ======================================== */

/* --- Media Tab --- */
/* MediaWindow v2 - Component-based architecture */
/* Individual component styles are defined in their respective DEFAULT_CSS */

/* Legacy styles for compatibility - will be removed once MediaWindow_v2 is fully integrated */

/* --- Legacy Media Tab Styles --- */
/* DEPRECATED: MediaWindow_v2 has its own layout
#media-window {
    layout: horizontal;
    width: 100%;
}
*/

.media-nav-pane {
    dock: left;
    width: auto;
    min-width: 20;
    max-width: 40;
    background: $boost;
    padding: 1;
    border-right: thick $background-darken-1;
    overflow-y: auto;
    overflow-x: hidden;
}

.media-nav-pane.collapsed {
    width: 0 !important;
    min-width: 0 !important;
    border-right: none !important;
    padding: 0 !important;
    overflow: hidden !important;
    display: none !important;
}

.media-nav-pane .media-nav-button {
    width: 100%;
    margin-bottom: 1;
    border: none;
    height: 3;
    text-align: left;
    padding: 0 1;
}
.media-nav-pane .media-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}

.media-content-pane {
    padding: 0;
    layout: vertical;
    width: 1fr;
}

/* Ensure media views fill vertical space when shown */
.media-content-pane > .media-view-area {
    height: 1fr;
}

#media-sidebar-toggle-button {
    dock: top;
    height: 3;
    width: 5;
    margin: 0 0 1 1;
}

.media-view-area {
    width: 100%;
    height: 1fr;
}

/* Grid layout for content area within each media view */
/* DEPRECATED: MediaWindow_v2 uses Horizontal layout, not Grid
.media-view-area > Grid {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 35% 65%;
    grid-gutter: 1;
    height: 1fr;
    width: 100%;
}
*/

/* Target ListItems inside the media list to control their height */
.media-items-list > ListItem {
    width: 100%;
    height: auto; /* This prevents a single item from stretching to fill the whole ListView */
    padding: 0;
    margin: 0 0 1 0;
}

/* Styles for media item components */
.media-item-title {
    height: auto;
    text-style: bold;
}

.media-item-snippet {
    height: auto;
    color: $text-muted;
    max-height: 2;
    overflow-y: hidden;
}

.media-item-meta {
    height: auto;
    text-style: italic;
    color: $text-disabled;
}

/* Style for the Vertical container inside ListItems */
.media-items-list > ListItem > Vertical {
    height: auto;
    width: 100%;
}

/* Ensure all child elements inside media items take full width */
.media-items-list > ListItem > Vertical > * {
    width: 100%;
}

/* DEPRECATED: MediaWindow_v2 uses different class names
.media-content-left-pane {
    width: 35%
}
*/

/* Children of .media-content-left-pane */
.media-content-left-pane > Label.pane-title {
    height: auto;
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}
.media-content-left-pane > Input.media-search-input {
    height: 3;
    width: 100%;
    margin-bottom: 1;
}

/* Keyword filter styles */
.keyword-filter-label {
    height: auto;
    margin-bottom: 1;
}

.keyword-filter-input {
    height: 3;
    width: 100%;
    margin-bottom: 1;
}

/* ListView for media items */
/* DEPRECATED: MediaWindow_v2 components have their own styling
.media-items-list {
    width: 100%;
    height: 1fr;
    border: round $primary-lighten-2;
    background: $primary-background;
    margin-bottom: 1;
    overflow-y: auto;
    overflow-x: hidden;
    min-height: 10;
}
*/

.media-pagination-bar {
    height: 3;
    width: 100%;
    align-horizontal: center;
}
.media-pagination-bar Button {
    width: auto;
    min-width: 10;
    margin: 0 1;
}
.media-pagination-bar .media-page-label {
    width: 1fr;
    text-align: center;
    padding: 0 1;
}

/* DEPRECATED: MediaWindow_v2 uses MediaViewerPanel with its own styling
.media-content-right-pane {
    width: 1fr;
    height: 1fr;
    padding: 1;
    overflow-y: auto;
    layout: vertical;
}
*/

.media-details-theme {
    height: 1fr;
    width: 100%;
    overflow-y: auto !important;
    min-height: 0;
}

/* Force Markdown content in Media tab to expand fully */
.media-content-right-pane Markdown {
    height: 1fr !important;
    overflow-y: auto !important;
}

/* Additional override for any potential Textual default constraints */
VerticalScroll.media-content-right-pane {
    height: 1fr !important;
}

VerticalScroll.media-content-right-pane > Markdown {
    height: 1fr !important;
}

/* --- Media Details Widget --- */
MediaDetailsWidget {
    height: 1fr;
    width: 100%;
    layout: vertical;
}

.metadata-section {
    width: 100%;
    height: auto;
    padding: 1;
    background: $boost;
    border-bottom: thick $background-darken-1;
}

.metadata-view {
    layout: vertical;
    height: auto;
}

.metadata-section {
    height: auto;
    width: 100%;
    layout: vertical;
    margin-bottom: 1;
}

.metadata-view {
    layout: vertical;
    height: auto;
    width: 100%;
}

.metadata-display {
    padding: 0 1;
    margin-bottom: 0;
    height: auto;
}

.metadata-edit {
    layout: vertical;
    padding: 1;
    height: auto;
    min-height: 30;
}

.edit-fields {
    layout: vertical;
    margin-bottom: 1;
}

.edit-fields Label {
    margin-top: 0;
    margin-bottom: 0;
    text-style: bold;
    height: 1;
}

.edit-fields Input {
    width: 100%;
    margin-bottom: 0;
    height: 3;
}

.edit-fields Input:disabled {
    opacity: 0.6;
    background: $boost-darken-1;
}

/* --- Formatting Options --- */
.formatting-options {
    width: 100%;
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    layout: horizontal;
    align: center middle;
}

.format-reading-checkbox {
    width: auto;
    height: 3;
    padding: 0 1;
}

.format-reading-checkbox:hover {
    background: $boost;
}

.edit-actions {
    layout: horizontal;
    height: auto;
    align: left top;
    margin-top: 1;
}

.edit-actions Button {
    margin-right: 1;
    min-width: 10;
}

.media-content-display {
    height: 1fr;
    width: 100%;
    padding: 1;
}

/* Content search section */
.content-search-section {
    width: 100%;
    padding: 1;
    background: $boost;
    border-bottom: solid $primary-background;
}

.search-controls {
    layout: horizontal;
    align: center middle;
    height: 3;
}

.content-search-input {
    width: 1fr;
    margin-right: 1;
}

.content-search-button {
    width: 4;
    min-width: 4;
    margin-right: 1;
}

.content-search-nav {
    width: 3;
    min-width: 3;
    margin-right: 1;
}

.content-search-status {
    width: auto;
    color: $text-muted;
    text-style: italic;
}

/* --- Deleted Items Styling --- */
.deleted-media-item {
    opacity: 0.6;
}

.deleted-media-item:hover {
    opacity: 0.8;
}

.media-item-deleted {
    color: $text-disabled;
    text-style: strike;
}

.media-item-title.media-item-deleted {
    color: $error;
    text-style: strike;
}

/* Show deleted checkbox styling */
.show-deleted-checkbox {
    width: 100%;
    margin-bottom: 1;
    padding: 0 1;
    height: auto;
}

/* Metadata buttons container */
.metadata-buttons {
    layout: horizontal;
    height: 3;
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
}

.metadata-edit-button {
    width: auto;
    min-width: 10;
    dock: left;
}

.metadata-delete-button {
    width: auto;
    min-width: 10;
    dock: right;
}

/* Hidden state */
.hidden {
    display: none;
}

/* --- Collections/Tags Window --- */
.collections-main-container {
    layout: horizontal;
    width: 100%;
}

.collections-left-pane {
    width: 40%;
    min-width: 30;
    layout: vertical;
    padding: 1;
    border-right: thick $background-darken-1;
}

.collections-right-pane {
    width: 1fr;
    padding: 1;
    overflow-y: auto;
}

.keyword-list {
    height: 1fr;
    border: round $primary-lighten-2;
    background: $primary-background;
    overflow-y: auto;
}

.keyword-list .keyword-item {
    padding: 1;
    margin-bottom: 0;
}

.keyword-list .keyword-item.selected,
.keyword-list .keyword-item.selected:hover {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.keyword-list .keyword-item:hover {
    background: $surface-lighten-1;
    color: $text;
}

.keyword-action-buttons {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

.keyword-action-buttons Button {
    width: 1fr;
    margin-right: 1;
}

.action-buttons-container {
    layout: vertical;
    margin-bottom: 2;
}

.action-buttons-container Button {
    width: 100%;
    margin-bottom: 1;
}

.selection-info {
    padding: 1;
    background: $boost;
    margin-bottom: 1;
    text-align: center;
}

.keyword-details, .usage-stats {
    padding: 1;
    background: $boost;
    margin-top: 1;
    min-height: 10;
}

/* Rename/Merge Dialog Styles */
#rename-dialog-container, #merge-dialog-container {
    align: center middle;
    width: 50;
    min-height: 10;
    padding: 2;
    background: $surface;
    border: thick $primary;
}

#rename-title, #merge-title {
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
}

#merge-instruction {
    text-align: center;
    margin-bottom: 1;
    color: $text-muted;
}

#new-keyword-input, #new-target-input {
    width: 100%;
    margin-bottom: 1;
}

#target-keyword-list {
    height: 15;
    margin-bottom: 1;
    border: round $primary-lighten-2;
    background: $primary-background;
}

#rename-buttons, #merge-buttons {
    layout: horizontal;
    height: 3;
    align: center middle;
}

#rename-buttons Button, #merge-buttons Button {
    margin: 0 1;
    min-width: 12;
}

/* --- Multi-Item Review Window --- */
.multi-review-container {
    width: 100%;
    padding: 1;
}

.selection-section, .items-section, .analysis-section {
    width: 100%;
    margin-bottom: 1;
    padding: 1;
    background: $boost;
}

.selection-section {
    height: auto;
    min-height: 15;
}

.items-section {
    height: auto;
    min-height: 20;
    max-height: 40;
}

.analysis-section {
    height: auto;
    min-height: 30;
}

.search-controls, .tag-filter-section, .selection-controls {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

.search-controls Input {
    width: 1fr;
    margin-right: 1;
}

.tag-filter-section Label {
    width: auto;
    margin-right: 1;
}

.tag-input {
    width: 1fr;
}

.selection-controls Button {
    margin-right: 1;
}

.selection-info {
    width: auto;
    padding: 0 1;
}

.review-items-list {
    height: 1fr;
    border: round $primary-lighten-2;
    background: $primary-background;
    overflow-y: auto;
}

.review-items-list .review-item {
    padding: 1;
    margin-bottom: 0;
}

.review-items-list .review-item.selected,
.review-items-list .review-item.selected:hover {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.review-items-list .review-item:hover {
    background: $surface-lighten-1;
    color: $text;
}

.item-title {
    text-style: bold;
    color: $text;
}

.item-meta {
    color: $text-muted;
    text-style: italic;
}

.analysis-prompt {
    width: 100%;
    height: 10;
    margin-bottom: 1;
}

.analysis-controls {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

.analysis-controls Checkbox {
    width: auto;
    margin-right: 2;
}

.analysis-controls Button {
    margin-right: 1;
    min-width: 15;
}

.analysis-progress {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

.progress-label {
    text-align: center;
    margin-bottom: 1;
    color: $text-muted;
}

.results-container {
    height: 1fr;
    background: $primary-background;
    padding: 1;
}

.analysis-results {
    layout: vertical;
    width: 100%;
}

.analysis-result-card {
    width: 100%;
    padding: 1;
    margin-bottom: 1;
    background: $boost;
    border: round $primary-lighten-2;
}

.result-header {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

.result-title {
    width: 1fr;
    text-style: bold;
}

.result-meta {
    color: $text-muted;
    margin-bottom: 1;
}

.result-content {
    padding: 1;
    max-height: 20;
    overflow-y: auto;
}

.result-separator {
    text-align: center;
    color: $text-disabled;
    margin-top: 1;
}

/* Delete confirmation dialog for keywords */
#delete-dialog {
    layout: vertical;
    padding: 2;
}

.dialog-title {
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
}

.dialog-subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
}

.dialog-message {
    text-align: center;
    margin-bottom: 2;
}

.dialog-buttons {
    layout: horizontal;
    height: 3;
    align: center middle;
}

.dialog-buttons Button {
    margin: 0 1;
    min-width: 12;
}

/* --- End of Media Tab --- */

/* ===== MODULE: features/_search-rag.tcss ===== */
/* ========================================
 * FEATURES: Search and RAG
 * ======================================== 
 * Search and RAG tab interface
 * ======================================== */


/* Header Section */
.search-header-section {
    background: $primary-darken-2;
    padding: 2 3 1 3;
    margin-bottom: 2;
    border-bottom: solid $primary-background;
}


/* Search Section */
.search-section {
    background: $surface;
    padding: 2;
    margin: 0 2 2 2;
    border: round $primary-background;
}

.search-input-wrapper {
    /* position: relative; - not supported in TCSS */
}

.search-bar-enhanced {
    layout: horizontal;
    height: 4;
    background: $background;
    border: thick $primary;
    /* border-radius: 2; - not supported in TCSS */
    padding: 0 1;
    align: center middle;
}

.search-query-input-enhanced {
    width: 1fr;
    background: transparent;
    border: solid transparent;
    border-bottom: solid transparent;
    padding: 0 1;
    /* font-size: 14; - not supported in TCSS */
}

.search-query-input-enhanced:focus {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    outline: none;
}

.clear-button {
    width: 3;
    min-width: 3;
    height: 3;
    background: transparent;
    border: none;
    color: $text-muted;
    margin: 0;
}

.clear-button:hover {
    color: $error;
    background: $error 20%;
}

.search-button-enhanced {
    min-width: 10;
    height: 3;
    margin-left: 1;
    background: $primary;
    color: $text;
    border: none;
}

.search-button-enhanced:hover {
    background: $primary-lighten-1;
}

.search-loading-indicator {
    /* position: absolute; - not supported in TCSS */
    /* top: 1; - not supported in TCSS */
    /* right: 12; - not supported in TCSS */
    width: 2;
    height: 2;
}

/* Settings Section */
.settings-section {
    margin: 0 2;
}

.settings-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 2;
    text-align: center;
}

.settings-grid {
    layout: horizontal;
    /* gap: 3; - not supported in TCSS */
}

.setting-group {
    width: 1fr;
}

.setting-label {
    color: $text-muted;
    margin-bottom: 1;
    /* font-size: 12; - not supported in TCSS */
}

.mode-select {
    width: 100%;
    background: $background;
    border: solid $primary-background;
}

.source-checkboxes-enhanced {
    layout: horizontal;
    /* gap: 2; - not supported in TCSS */
    background: $background;
    padding: 1;
    border: round $primary-background;
}

.source-checkbox {
    margin: 0;
}

/* Saved Searches Panel */
.saved-searches-panel-enhanced {
    background: $boost;
    padding: 2;
    margin-bottom: 2;
    border: round $primary-background;
}

.saved-searches-wrapper {
    width: 100%;
}

.saved-searches-header {
    layout: horizontal;
    margin-bottom: 1;
    align: center middle;
}

.saved-searches-title {
    width: 1fr;
    text-style: bold;
    color: $secondary;
}

.new-search-button {
    width: 3;
    height: 3;
    min-width: 3;
    background: $primary;
    color: $text;
    border: round $primary;
}

.saved-searches-list-enhanced {
    height: 5;
    border: round $background;
    background: $background;
    margin-bottom: 1;
}

.empty-saved-searches {
    text-align: center;
    color: $text-muted;
    padding: 2;
    text-style: italic;
}

.saved-search-actions-enhanced {
    layout: horizontal;
    /* gap: 1; - not supported in TCSS */
}

.saved-action-button {
    width: 1fr;
    min-width: 8;
}

.saved-action-button.danger {
    background: $error-darken-1;
    color: $text;
}

.saved-action-button.danger:hover {
    background: $error;
}

/* Advanced Settings */
.advanced-collapsible {
    margin-bottom: 2;
}

.advanced-collapsible > .collapsible--header {
    background: $surface;
    padding: 1 2;
    border: round $primary-background;
}

.advanced-settings-wrapper {
    background: $surface;
    padding: 2;
    border: round $primary-background;
    border-top: none;
}

.advanced-section {
    margin-bottom: 2;
    padding-bottom: 2;
    border-bottom: dashed $primary-background;
}

.advanced-section:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
}

.advanced-section-title {
    text-style: bold;
    color: $secondary;
    margin-bottom: 1;
}

.param-group {
    width: 1fr;
}


.chunking-section {
    margin-top: 1;
}

/* Status Container */
.status-container-enhanced {
    background: $boost;
    padding: 1 2;
    margin: 0 2 2 2;
    border: round $primary-background;
}

.status-bar {
    layout: horizontal;
    align: center middle;
}

.search-status-enhanced {
    width: 1fr;
    color: $text;
    text-style: bold;
}

.search-stats {
    color: $text-muted;
    /* font-size: 12; - not supported in TCSS */
}

.search-progress-bar {
    margin-top: 1;
    height: 1;
    background: $background;
    border: solid $primary-background;
}

/* Results Section */
.results-section {
    margin: 0 2 2 2;
    height: 1fr;
}


.results-header {
    background: $boost;
    padding: 1;
    margin-bottom: 1;
    border: round $primary-background;
}


.page-button {
    width: 3;
    min-width: 3;
    height: 3;
    background: $panel;
    border: solid $primary-background;
}

.page-button:hover {
    background: $primary;
    color: $text;
}

.page-button:disabled {
    opacity: 0.6;
    background: $panel-darken-2;
    color: $text-muted;
}

.results-container-enhanced {
    height: 1fr;
    background: $background;
    padding: 1;
}

/* Search Result Cards */
.search-result-card-enhanced {
    margin-bottom: 1;
    background: $panel;
    border: solid $primary-background;
    transition: all 0.2s;
}

.search-result-card-enhanced:hover {
    background: $panel-lighten-1;
    border: solid $primary;
    /* box-shadow: 0 2 4 $primary 30%; - not supported */
}

.search-result-card-enhanced.expanded {
    background: $boost;
    border: thick $primary;
}

.result-card-wrapper {
    layout: horizontal;
    padding: 1;
    /* gap: 1; - not supported in TCSS */
}

.result-source-column {
    width: 5;
    align: center middle;
    padding: 1;
    background: $background-darken-1;
    /* border-radius: 1; - not supported in TCSS */
}

.source-icon {
    /* font-size: 20; - not supported in TCSS */
    margin-bottom: 0;
}

.source-label {
    /* font-size: 10; - not supported in TCSS */
    text-style: bold;
    margin-top: 0;
}

.source-media { color: $primary; }
.source-conversation { color: $success; }
.source-note { color: $warning; }

.result-content-column {
    width: 1fr;
    padding: 0 1;
}

.result-header-enhanced {
    layout: horizontal;
    margin-bottom: 1;
    align: center middle;
}

.result-title-enhanced {
    width: 1fr;
    color: $text;
    /* font-size: 14; - not supported in TCSS */
}

.score-indicator {
    min-width: 5;
    height: 2;
    padding: 0 1;
    /* border-radius: 1; - not supported in TCSS */
    align: center middle;
}

.score-text {
    /* font-size: 11; - not supported in TCSS */
    text-align: center;
}

.score-high {
    background: $success;
    color: $text;
}

.score-medium {
    background: $warning;
    color: $text;
}

.score-low {
    background: $error-darken-1;
    color: $text;
}

.result-preview-enhanced {
    color: $text-muted;
    margin-bottom: 1;
    /* line-height: 1.4; - not supported in TCSS */
}

.metadata-pills {
    layout: horizontal;
    /* gap: 1; - not supported in TCSS */
    margin-bottom: 1;
    /* flex-wrap: wrap; - not supported in TCSS */
}

.metadata-pill {
    background: $background;
    padding: 0 1;
    border: solid $primary-background;
    /* border-radius: 1; - not supported in TCSS */
    /* font-size: 11; - not supported in TCSS */
    color: $text-muted;
}

.metadata-pill.more {
    background: $primary-darken-2;
    color: $primary;
}

.result-expanded-content {
    margin-top: 1;
    padding: 1;
    background: $background;
    border: round $primary-background;
}

.expanded-section-title {
    color: $secondary;
    margin: 1 0;
}

.citation-doc-title {
    color: $primary;
    margin: 1 0 0 1;
    text-style: bold;
}

.citation-item {
    color: $text-muted;
    margin: 0 0 0 2;
    padding: 0;
}

.citation-exact {
    color: $success;
}

.citation-semantic {
    color: $primary;
}

.citation-fuzzy {
    color: $warning;
}

.citation-keyword {
    color: $secondary;
}

.result-full-content {
    color: $text;
    margin-bottom: 1;
    max-height: 20;
    overflow-y: auto;
}

.metadata-full-item {
    color: $text-muted;
    margin-left: 1;
}

.result-actions-enhanced {
    layout: horizontal;
    /* gap: 1; - not supported in TCSS */
    margin-top: 1;
}

.result-button {
    min-width: 8;
    height: 3;
    background: $background;
    border: solid $primary-background;
    /* font-size: 12; - not supported in TCSS */
}

.result-button:hover {
    background: $primary;
    color: $text;
}

.view-button {
    background: $primary-darken-1;
    color: $text;
}

/* Context and Analytics */
.context-preview-enhanced {
    padding: 2;
    background: $background;
    border: round $primary-background;
    max-height: 30;
    overflow-y: auto;
}

.history-table-enhanced {
    width: 100%;
    height: 100%;
}

/* Action Buttons */
.actions-section {
    margin: 0 2 2 2;
}

.action-buttons-bar-enhanced {
    layout: horizontal;
    background: $surface;
    padding: 2;
    border: round $primary-background;
    align: center middle;
}

.action-spacer {
    width: 1fr;
}

.action-button {
    min-width: 12;
    height: 3;
    border: solid $primary-background;
}

.save-button {
    background: $success-darken-1;
    color: $text;
}

.save-button:hover {
    background: $success;
}

.export-button {
    background: $primary-darken-1;
    color: $text;
}

.export-button:hover {
    background: $primary;
}

.export-button:disabled {
    opacity: 0.6;
    background: $panel-darken-2;
}

.maintenance-button {
    background: $panel;
    color: $text-muted;
}

.maintenance-button:hover {
    background: $panel-lighten-1;
    color: $text;
}



/* Empty States */
.empty-results-message {
    text-align: center;
    color: $text-muted;
    padding: 4;
    text-style: italic;
    background: $surface;
    border: dashed $primary-background;
    margin: 2;
}

/* --- Enhanced RAG Search UI Styles --- */

/* Search History Dropdown */
.search-history-dropdown {
    /* position: absolute; - not supported in TCSS */
    width: 100%;
    max-height: 15;
    background: $surface;
    border: solid $primary;
    border-top: none;
    margin-top: -1;
    /* z-index: 100; - not supported in TCSS */
}

.search-history-dropdown.hidden {
    display: none;
}

.search-history-list {
    max-height: 15;
    overflow-y: auto;
    background: $background;
}

.history-item-text {
    padding: 1;
    border-bottom: dashed $primary-background;
}

.history-item-text:hover {
    background: $boost;
    color: $primary;
}

/* --- End Enhanced RAG Search UI Styles ---*/

/* ===== MODULE: features/_llm-management.tcss ===== */
/* ========================================
 * FEATURES: LLM Management
 * ======================================== 
 * LLM Management tab styles
 * ======================================== */

/* --- LLM Management Tab --- */
#llm_management-window { /* Matches TAB_LLM ("llm_management") */
    layout: horizontal;
}

.llm-nav-pane { /* Style for the left navigation pane */
    dock: left;
    width: auto;
    min-width: 25;
    max-width: 60;
    height: 100%;
    background: $boost; /* Or $surface-darken-1 or $surface-lighten-1 */
    padding: 1;
    border-right: thick $background-darken-1;
    overflow-y: auto;
    overflow-x: hidden;
}

.llm-nav-pane .llm-nav-button { /* Style for navigation buttons */
    width: 100%;
    margin-bottom: 1;
    border: none;
    height: 3;
    text-align: left;
    padding: 0 1;
}
.llm-nav-pane .llm-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}
/* Active state for selected llm nav button */
.llm-nav-pane .llm-nav-button.-active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.llm-content-pane { /* Style for the right content display area */
    width: 1fr;
    height: 100%;
    padding: 1 2;
    overflow-y: auto;
}

.llm-view-area { /* Common class for individual content areas */
    width: 100%;
    height: 100%; /* Or auto */
    display: none; /* Initially hidden until activated */
}

/* LLM Management Tab Specific Styles */
#llm_management-window .llm-view-area > VerticalScroll { /* Target the new VS inside each view */
    height: 100%; /* Ensure the VerticalScroll takes full height of its parent view area */
}

#llamacpp-args-help-collapsible,
#llamafile-args-help-collapsible,
#vllm-args-help-collapsible { /* Style for the collapsible itself */
    margin-top: 1;
    margin-bottom: 1;
    border: round $primary-lighten-1; /* Optional border for the collapsible */
}

#llamacpp-args-help-collapsible > .collapsible--header,
#llamafile-args-help-collapsible > .collapsible--header,
#vllm-args-help-collapsible > .collapsible--header { /* Style for the collapsible title */
    background: $surface-darken-1; /* Slightly different background for the header */
}

.help-text-display {
    height: 25; /* Or your desired fixed height for the scrollable help text */
    width: 100%;
    border: round $surface;
    padding: 1;
    margin-top: 1; /* Space between collapsible title and the content */
    background: $panel; /* Background for the help text area */
    overflow-y: scroll !important; /* Ensure vertical scrolling */
}

/* Ensure input fields for additional args are appropriately sized if they were TextAreas */
/* If you changed #llamacpp-additional-args to Input, this might not be needed for it */
#llamacpp-additional-args, /* This is now an Input, so this rule might be less relevant for it */
#llamafile-additional-args,
#vllm-additional-args {
    height: 3; /* For single-line Input or small TextArea */
    /* If it's a TextArea and you want more lines: */
    /* min-height: 3; */
    /* max-height: 7; */
    /* height: auto; */
}

/* Log output styles for Llama.cpp and Llamafile views */
#llm-view-llama-cpp .log_output,
#llm-view-llamafile .log_output {
    width: 100%;
    height: 15; /* Fixed height to ensure scrolling works */
    min-height: 10;
    max-height: 20;
    border: panel $primary-darken-2;
    background: $background-darken-1;
    margin-top: 1;
    overflow-y: auto;
}

/* Optional: Style for the input_container if needed */
.input_container {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}
.input_container Input {
    width: 1fr; /* Input takes available space */
    margin-right: 1; /* Space before browse button */
}
.input_container .browse_button {
    width: auto; /* Let button size itself */
    height: 100%;
}

.button_container {
    layout: horizontal;
    height: auto;
    margin-top: 1;
}
.button_container Button {
    margin-left: 1; /* Space between buttons */
}
/* Ollama Specific Styles within #llm-view-ollama */
#llm-view-ollama {
    layout: vertical; /* Ensures children stack vertically by default */
    /* overflow-y: auto; /* Add if direct children of llm-view-ollama might overflow before VerticalScroll */
}
#llm-view-ollama VerticalScroll { /* Ensure the VerticalScroll takes up space */
    height: 100%;
}

#llm-view-ollama .label { /* General label styling if not already covered */
    margin-top: 1;
    margin-bottom: 0; /* Tighten space below label if input is right after */
    text-style: bold;
}
#llm-view-ollama .section_label { /* For labels that act as section headers */
    margin-top: 2; /* More space above section labels */
    padding: 1 0;
    border: ascii $primary-background-lighten-1; /* Optional: add a border or background */
    text-align: center;
    width: 100%;
}

#llm-view-ollama .input_field,
#llm-view-ollama .input_field_short,
#llm-view-ollama .input_field_long {
    margin-bottom: 1; /* Space after input fields */
}
#llm-view-ollama .input_field_long { /* For paths or longer inputs */
    width: 100%;
}

#llm-view-ollama .input_action_container { /* For Input + Button on same line */
    layout: horizontal;
    height: auto; /* Fit content */
    margin-bottom: 0; /* Status/Output will provide margin */
}
#llm-view-ollama .input_action_container .input_field_short {
    width: 1fr; /* Input takes most space */
    margin-right: 1;
    margin-bottom: 0; /* No bottom margin if button is next to it */
}
#llm-view-ollama .input_action_container .action_button_short {
    width: auto; /* Let button size itself */
    min-width: 10; /* Ensure it's not too small */
    height: 100%; /* Match input height */
}
#llm-view-ollama .input_action_container .browse_button_short {
    width: auto;
    min-width: 15;
    height: 100%;
}

#llm-view-ollama .action_container { /* For standalone buttons */
    width: 100%;
    height: auto;
    margin-bottom: 0;
}
#llm-view-ollama .action_button { /* For buttons that take full width or are main actions */
    width: 100%;
    margin-top: 1; /* If it's after a section label or input */
}
#llm-view-ollama .full_width_button {
    width: 100%;
    margin-top: 1;
}

#llm-view-ollama .delete_button Button { /* Specific styling for delete button if needed */
    background: $error-darken-1;
    color: $text;
}
#llm-view-ollama .delete_button Button:hover {
    background: $error;
}

/* New Status TextArea */
.ollama-status-textarea {
    width: 100%;
    height: 3; /* Small, 1-2 lines of text */
    border: round $primary-darken-1;
    background: $surface;
    margin-top: 1; /* Space above status */
    margin-bottom: 1; /* Space below status, before main output or next section */
    padding: 0 1;
    color: $text-muted; /* Subdued text color for status */
}

/* Output TextAreas */
#llm-view-ollama .output_textarea_medium { /* For JSON lists, model info */
    width: 100%;
    height: 25; /* Or adjust as needed */
    border: round $primary;
    background: $panel;
    margin-bottom: 1; /* Space before next element/spacer */
}
#llm-view-ollama .output_textarea_small { /* For embeddings */
    width: 100%;
    height: 6;
    border: round $primary;
    background: $panel;
    margin-bottom: 1;
}

/* Main RichLog for streaming */
#llm-view-ollama .log_output_large { /* Renamed from .log_output for specificity */
    width: 100%;
    height: 10; /* Make it taller */
    border: panel $primary-darken-2;
    background: $background-darken-1; /* Darker background for log */
}

/* Spacer element */
.ollama-spacer {
    height: 1; /* Creates 1 cell of vertical space */
    width: 100%;
}

/* OLLAMA compact layout grid */
.ollama-button-bar {
    layout: horizontal;
    height: auto;
    width: 100%;
    margin: 1 0;
    align-horizontal: center;
}
.ollama-button-bar Button {
    width: 1fr;
    margin: 0 1;
}

.ollama-actions-grid {
    layout: horizontal;
    height: auto;
    align-vertical: top; /* Align columns to the top */
    margin-bottom: 1;
}

.ollama-actions-column {
    layout: vertical;
    width: 1fr;
    height: 100%; /* Make columns fill parent height */
    padding: 1;
    border: round $panel-lighten-1;
    margin: 0 1;
}
.ollama-actions-column:first-of-type {
    margin-left: 0;
}
.ollama-actions-column:last-of-type {
    margin-right: 0;
}

.column-title {
    text-style: bold underline;
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

/* Override input container margin inside a column */
.ollama-actions-column .input_action_container {
    margin-bottom: 1;
}
.ollama-actions-column .full_width_button {
    margin-top: 0; /* Tighten up space for buttons below inputs */
}

/* --- End of LLM Management Tab --- */

/* ===== MODULE: features/_tools-settings.tcss ===== */
/* ========================================
 * FEATURES: Tools and Settings
 * ======================================== 
 * Tools and Settings tab
 * ======================================== */

/* --- Tools & Settings Tab --- */
#tools_settings-window { /* Matches TAB_TOOLS_SETTINGS */
    layout: horizontal; /* Main layout for this tab */
}

.tools-nav-pane {
    dock: left;
    width: auto; /* Changed from 25% */
    min-width: 25; /* Example min-width */
    max-width: 60; /* Example max-width */
    height: 100%;
    background: $boost; /* Or $surface-lighten-1 */
    padding: 1;
    border-right: thick $background-darken-1;
    overflow-y: auto;
    overflow-x: hidden;
}

.tools-nav-pane .ts-nav-button { /* Style for navigation buttons */
    width: 100%;
    margin-bottom: 1;
    border: none; /* Cleaner look for nav buttons */
    height: 3;
}
.tools-nav-pane .ts-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}

.tools-nav-pane .ts-nav-button.active-nav {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.tools-content-pane {
    width: 1fr; /* Takes remaining horizontal space */
    height: 100%;
    padding: 1 2; /* Padding for the content area */
    overflow-y: auto; /* If content within sub-views might scroll */
}

/* Ensure ContentSwitcher fills the pane */
.tools-content-pane ContentSwitcher {
    height: 100%;
    width: 100%;
}

.ts-view-area { /* Class for individual content areas */
    width: 100%;
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    /* Let ContentSwitcher handle visibility */
}

.config-file-settings-container {
    height: 100%;
    width: 100%;
    overflow-y: auto;
    overflow-x: hidden;
}

/* Ensure TabbedContent fills container */
.config-file-settings-container TabbedContent {
    height: 100%;
    width: 100%;
}

.config-file-settings-container TabPane {
    height: 100%;
    width: 100%;
}

/* Specific config tabs styling */
#config-tabs {
    height: 100%;
    width: 100%;
    min-height: 30;
}

/* Inner container for config file settings */
.config-file-settings-inner {
    height: 100%;
    width: 100%;
    layout: vertical;
}

/* Settings form styling */
.section-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
    text-align: center;
    height: auto;
}

.section-description {
    color: $text-muted;
    margin-bottom: 2;
    text-align: center;
    text-style: italic;
    height: auto;
}

.subsection-title {
    text-style: bold;
    color: $secondary;
    margin: 2 0 1 0;
}

.settings-group {
    margin-bottom: 2;
    padding: 1;
    background: $surface;
    border: round $primary-background;
    height: auto;
}

.settings-label {
    margin-bottom: 1;
    text-style: bold;
}

.settings-select, .settings-input {
    width: 100%;
    margin-bottom: 1;
    min-height: 3;
    height: auto;
}

.checkbox-group {
    margin-bottom: 1;
}

.warning-text {
    color: $warning;
    margin-bottom: 1;
    text-style: italic;
}

.settings-actions {
    margin-top: 2;
    layout: horizontal;
    height: auto;
    align: center middle;
}

.settings-actions Button {
    margin: 0 1 0 0;
}

/* Configuration file settings specific */
.config-file-settings-container {
    height: 100%;
    width: 100%;
}

.config-editor {
    height: 20;
    min-height: 20;
    border: round $primary;
    background: $panel;
    margin-bottom: 1;
}

.config-button-container {
    layout: horizontal;
    height: auto;
    margin-top: 1;
    align: center middle;
}

.config-button-container Button {
    margin: 0 1 0 0;
}

.tab-description {
    color: $text-muted;
    margin-bottom: 1;
    text-style: italic;
}

/* --- Core Settings Styles --- */
.core-settings-container {
    padding: 1 2;
    width: 100%;
    height: 100%;
}

.section-title {
    text-style: bold;
    text-align: center;
    margin-bottom: 2;
    color: $primary;
}

.subsection-title {
    text-style: bold;
    margin: 2 0 1 0;
    color: $secondary;
}

.settings-group {
    background: $surface;
    padding: 1;
    margin-bottom: 2;
    border: round $primary-background;
}

.settings-label {
    margin: 1 0 0 0;
    color: $text-muted;
}

.settings-input {
    width: 100%;
    margin: 0 0 1 0;
}

.settings-select {
    width: 100%;
    margin: 0 0 1 0;
}

.settings-subsection-title {
    color: $text;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

.settings-note {
    color: $text-muted;
    text-style: italic;
    margin-top: 1;
    margin-bottom: 1;
    padding: 0 1;
}

.checkbox-group {
    layout: horizontal;
    margin: 0 0 1 0;
}

.checkbox-group Checkbox {
    margin-right: 2;
}

.settings-actions {
    layout: horizontal;
    margin-top: 2;
    align: center middle;
}

.settings-actions Button {
    margin: 0 1;
    min-width: 15;
}

/* --- End Core Settings Styles ---*/

/* --- Config Form Styles --- */
.config-form {
    width: 100%;
    height: auto;
    padding: 1 2;
    overflow-y: auto;
}

.form-label {
    margin-top: 1;
    margin-bottom: 0;
    text-style: bold;
    color: $text-muted;
}

.form-description {
    color: $text-muted;
    margin-bottom: 2;
    text-style: italic;
}

.form-section-title {
    text-style: bold;
    color: $primary;
    margin: 2 0 1 0;
    border-bottom: solid $primary;
    padding-bottom: 0;
}

.form-subsection-title {
    text-style: bold;
    color: $secondary;
    margin: 1 0 1 0;
}

.form-actions {
    layout: horizontal;
    margin-top: 2;
    height: 3;
    width: 100%;
    align: center middle;
}

.form-actions Button {
    margin: 0 1 0 0;
    min-width: 15;
}

/* TextArea styling for config forms */
.config-form TextArea {
    width: 100%;
    height: 10;
    margin-bottom: 1;
    border: round $primary;
    background: $panel;
}

.system-prompt-textarea {
    height: 15;
}

.provider-models-textarea {
    height: 5;
}

/* Collapsible styling in config forms */
.config-form Collapsible {
    margin-bottom: 1;
    border: round $primary-background;
    background: $surface;
}

.config-form Collapsible > CollapsibleTitle {
    background: $boost;
    padding: 0 1;
}

/* Help text */
.help-text {
    color: $text-muted;
    margin-bottom: 1;
    text-style: italic;
}

/* Database status */
.db-status {
    color: $text-muted;
    margin-bottom: 1;
}

/* ===== MODULE: features/_ingest.tcss ===== */
/* ========================================
 * FEATURES: Ingest
 * ======================================== 
 * Media ingestion tab styles
 * ======================================== */

/* --- Ingest Content Tab --- */
#ingest-window { /* Matches TAB_INGEST */
    layout: vertical !important; /* Override .window class */
    height: 100%;
    width: 100%;
}

/* Override the horizontal layout from .window class */
#ingest-window.window {
    layout: vertical !important;
}
.tldw-api-media-specific-options { /* Common class for specific option blocks */
    padding: 1;
    border: round $surface;
    margin-top: 1;
    margin-bottom: 1;
}

/* Added to ensure initially hidden specific options are indeed hidden */
.tldw-api-media-specific-options.hidden {
     display: none;
}

.ingest-nav-pane { /* Style for the left navigation pane */
    dock: left;
    width: 25%;
    min-width: 20;
    max-width: 40;
    height: 100%;
    background: $boost; /* Or a slightly different shade */
    padding: 1;
    border-right: thick $background-darken-1;
    /* Removed overflow properties - let VerticalScroll handle scrolling */
}

.ingest-nav-pane .ingest-nav-button { /* Style for navigation buttons */
    width: 100%;
    margin-bottom: 1;
    border: none;
    height: 3;
}
.ingest-nav-pane .ingest-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}
/* Active state for selected ingest nav button */
.ingest-nav-pane .ingest-nav-button.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Collapsible sidebar styles */
.ingest-nav-pane.collapsed {
    width: 4;
    min-width: 4;
    padding: 1 0;
}

.nav-header {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

.nav-toggle-button {
    width: 3;
    height: 3;
    min-width: 3;
    padding: 0;
    text-align: center;
}

/* Adjust button appearance when collapsed */
.ingest-nav-pane.collapsed .ingest-nav-button {
    width: 3;
    padding: 0;
    /* Show only first letter or icon */
    overflow: hidden;
}

/* Style for sidebar section titles */
.ingest-nav-pane .sidebar-title {
    text-style: bold;
    color: $primary;
    margin-top: 2;
    margin-bottom: 1;
    padding-left: 1;
    border-left: thick $accent;
}
/* Active state for selected ingest nav button (optional) */
/* .ingest-nav-pane .ingest-nav-button.-active-view {
    background: $accent-darken-1;
    color: $text;
} */

.ingest-content-pane { /* Style for the right content display area */
    width: 1fr;
    height: 100%;
    padding: 1 2;
    /* Removed overflow - let child VerticalScroll widgets handle scrolling */
}

.ingest-view-area { /* Common class for individual content areas */
    width: 100%;
    height: 100%;
}
.ingest-label {
    margin-top: 1;
    margin-bottom: 0;
}
.ingest-selected-files-list {
    min-height: 5;
    max-height: 10;
    height: auto;
    border: round $ds-focus-accent;
    margin-bottom: 1;
    background: $surface;
}
.LocalIngestionPanel .file-selection-container {
    height: 1fr;
    min-height: 15;
    border: solid $primary;
    margin-bottom: 1;
    padding: 1;
}
.ingest-preview-area {
    height: 1fr;
    min-height: 10;
    border: round $primary-lighten-2;
    padding: 1;
    margin-bottom: 1;
    background: $surface;
}
.ingest-preview-area > Static#ingest-prompts-preview-placeholder {
    color: $text-muted;
    width: 100%;
    text-align: center;
    padding: 2 0;
}
.ingest-status-area {
    min-height: 5;
    max-height: 15;
    height: auto;
    margin-top: 1;
}

.prompt-preview-item {
    border: panel $background-lighten-2;
    padding: 1;
    margin-bottom: 1;
}
.prompt-preview-item .prompt-title {
    text-style: bold;
}
.prompt-preview-item .prompt-field-label {
    text-style: italic;
    color: $text-muted;
}
.prompt-preview-item Markdown {
    background: $surface-darken-1;
    padding: 0 1;
    margin-top: 1;
    margin-bottom: 1;
    border: solid $primary-darken-1; /* Use 'solid' instead of 'narrow' */
    max-height: 10;
    overflow-y: auto;
}
.prompt-preview-item .prompt-details-text {
    max-height: 5;
    overflow-y: auto;
    background: $surface;
    padding: 0 1;
    border: dashed $primary-darken-2; /* Use 'dashed' instead of 'dotted' */
    margin-bottom: 1;
}

/* Ensure VerticalScroll containers fill their parent */
.ingest-view-area VerticalScroll {
    height: 1fr;
    width: 100%;
}

/* Ensure VerticalScroll containers fill available space */
VerticalScroll.ingest-view-area {
    height: 1fr;
    width: 100%;
}

VerticalScroll.ingest-form-scrollable {
    height: 1fr;
    width: 100%;
}

/* Scrollable form container needs padding to prevent content cutoff */
.ingest-form-scrollable {
    height: 100%;
    overflow-y: auto;
    padding: 1;
}

/* Removed .ingest-media-tab-content - no longer needed since parent is VerticalScroll */




.ingest-form-row {
    margin-top: 1;
}

.ingest-form-col {
    width: 50%;
    padding-right: 1;
}

.title-author-row {
    margin-bottom: 1;
}

/* Ensure title/author input boxes are visible */
.title-author-row Input {
    height: 3;
    width: 100%;
    margin-bottom: 1;
}

.ingest-textarea-small {
    min-height: 3;
    max-height: 8;
    height: auto;
    margin-bottom: 1;
}

.ingest-textarea-medium {
    min-height: 10;
    max-height: 20;
    height: auto;
    margin-bottom: 1;
}


/* All ingest views are controlled programmatically */
.ingest-view-area {
    /* display controlled by app.py watcher */
    height: 100%;
    width: 100%;
}

/* --- Visibility styles for ingest views --- */
/* Views are controlled programmatically via styles.display */


/* Ensure the IngestWindowTabbed container fills available space */
IngestWindowTabbed {
    height: 1fr;
    width: 100%;
    layout: vertical;
}

/* Ensure TabbedContent in ingest window displays properly */
#ingest-window TabbedContent {
    height: 1fr;  /* Use fr unit for flexible sizing */
    width: 100%;
}

.media-tab-container {
    height: 1fr;  /* Use fr unit instead of 100% */
    padding: 1;
}

.source-toggle-container {
    dock: top;
    height: auto;
    padding: 1;
    margin-bottom: 1;
    border-bottom: solid $primary;
}

.tab-title {
    text-style: bold;

    margin-bottom: 1;
}

.source-toggle {
    layout: horizontal;
    height: auto;
    margin-top: 1;
}

.source-toggle RadioButton {
    margin-right: 2;
}

.source-content {
    height: 1fr;
    width: 100%;
    overflow-y: auto;
}

/* Ensure content areas within tabs fill space */
.ingest-form-scrollable {
    height: 1fr;
    width: 100%;
}




.source-content.hidden {
    display: none;
}

/* Compact file lists for better space usage */
.ingest-selected-files-list {
    min-height: 3;
    max-height: 8;
    height: auto;
    border: round $ds-focus-accent;
    margin-bottom: 1;
    background: $surface;
}

/* Status section at top of forms */
.status-dashboard {
    width: 100%;
    height: auto;
    max-height: 8;      /* Prevent status from taking too much space */
    min-height: 3;
    background: $surface;
    border: round $primary;
    padding: 1;
    margin-bottom: 1;
}

/* Mode-specific visibility controls */
.simple-mode .advanced-only {
    display: none !important;
}

.advanced-mode .advanced-only {
    display: block !important;
}

/* URL input always visible */
.url-input-section {
    display: block;
    margin-top: 1;
    padding: 1;
    border: round $primary;
    background: $surface;
}

/* Simplified form sections */
.essential-fields {
    border: round $accent;
    padding: 1;
    margin-bottom: 2;
    background: $surface-lighten-1;
}

/* Placeholder text */
.placeholder-text {
    color: $text-muted;
    text-align: center;
    padding: 4;
}

/* Mode toggle styles */
.mode-toggle-container {
    dock: top;
    padding: 1;
    margin-bottom: 1;
}

.mode-toggle {
    layout: horizontal;
    height: auto;
}

.mode-toggle RadioButton {
    margin-right: 2;
}

/* File selection row */
.file-selection-row {
    height: 3;
    margin-bottom: 1;
}

.file-selection-row Button {
    margin-right: 1;
}

/* Enhanced file list with metadata */
.file-list-with-metadata {
    min-height: 5;
    max-height: 10;
    border: round $primary;
    background: $surface;
}

/* Metadata row */
.metadata-row {
    margin-top: 1;
    margin-bottom: 1;
}

.metadata-col {
    width: 50%;
    padding-right: 1;
}

/* Process button */
.process-button {
    width: 100%;
    height: 4;
    margin-top: 2;
    text-style: bold;
}

/* Advanced options container */
.advanced-options-container {
    margin-top: 1;
}

.advanced-options-container.hidden {
    display: none;
}

/* Time range row */
.time-range-row {
    margin-top: 1;
}

.time-col {
    width: 50%;
    padding-right: 1;
}

/* Chunk settings row */
.chunk-settings-row {
    margin-top: 1;
}

.chunk-col {
    width: 50%;
    padding-right: 1;
}

/* Status Dashboard Styles */
.status-dashboard-container {
    border: round $primary;
    background: $surface;
    padding: 1;
    margin-bottom: 1;
}

.status-main-row {
    height: 3;
    align: left middle;
}

.status-message {
    width: 1fr;
    text-style: bold;
}

.file-counter {
    width: auto;
    margin-left: 2;
    color: $text-muted;
}

.time-display {
    width: auto;
    margin-left: 2;
    color: $text-muted;
}

.action-buttons {
    width: auto;
    dock: right;
    layout: horizontal;
}

.action-buttons.hidden {
    display: none;
}

.small-button {
    height: 3;
    min-width: 8;
    margin-left: 1;
}

.small-button.hidden {
    display: none;
}

/* Progress bar in dashboard */
.status-dashboard-container ProgressBar {
    margin-top: 1;
    height: 1;
}

.status-dashboard-container ProgressBar.hidden {
    display: none;
}

/* Alert container */
.alert-container {
    margin-top: 1;
    padding: 1;
    border: round $error;
    background: $error 10%;
}

.alert-container.hidden {
    display: none;
}

.alert-messages {
    color: $text;
    max-height: 6;
    overflow-y: auto;
}

/* Enhanced File List Styles */
.file-list-enhanced {
    border: round $primary;
    background: $surface;
    padding: 0;
}

.file-items-container {
    max-height: 10;
    overflow-y: auto;
    padding: 1;
}

.file-list-item-container {
    padding: 1;
    margin-bottom: 1;
    border: round $surface-lighten-2;
    background: $surface-lighten-1;
    height: auto;
}

.file-list-item-container:hover {
    background: $surface-lighten-2;
    border: round $primary;
}

.file-info-main {
    width: 1fr;
}

.file-name-row {
    height: auto;
    margin-bottom: 0;
}

.file-icon {
    width: 3;
    text-align: center;
}

.file-name {
    width: 1fr;
    text-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
}

.file-metadata {
    color: $text-muted;

    margin-left: 3;
}

.file-remove-button {
    width: 3;
    height: 3;
    min-width: 3;
    margin: 0;
    padding: 0;
    text-align: center;
}

.no-files-message {
    text-align: center;
    color: $text-muted;
    padding: 3;
}

.file-list-summary {
    dock: bottom;
    height: 3;
    padding: 1;
    border-top: solid $primary;
    background: $surface-darken-1;
    text-align: center;
    color: $text-muted;
}

/* --- END OF INTEGRATED NEW CSS --- */

/* ===== MODULE: features/_evaluation_unified.tcss ===== */
/* ========================================
 * FEATURES: Unified Evaluation Dashboard
 * ======================================== 
 * Single-page responsive design with collapsibles
 * Based on original UX design specifications
 * ======================================== */


.dashboard-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.quick-actions {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

/* Drop zone styling */
.drop-zone {
    layout: horizontal;
    height: 3;
    background: $panel;
    border: dashed $primary;
    padding: 0 2;
    align: center middle;
    margin: 1 0;
}

.drop-zone:hover {
    background: $boost;
    border: solid $primary;
}


/* --- Main Content Area --- */
.main-content {
    padding: 1;
}

/* Ensure VerticalScroll works properly inside the evals dashboard.
   This selector MUST stay scoped: a bare `VerticalScroll` rule applies
   app-wide and (because stylesheet rules always outrank widget DEFAULT_CSS
   in Textual, regardless of specificity) silently overrides every widget's
   own `height: 1fr` sizing, pushing follow-on siblings off-screen. */

/* Make sure the entire window uses available height */
EvalsWindow {
    height: 100%;
}

/* --- Collapsible Sections --- */
Collapsible {
    margin-bottom: 1;
    border: tall $surface;
    background: $panel;
}

Collapsible > Container {
    padding: 1;
}

Collapsible.-collapsed {
    margin-bottom: 1;
}

/* Note: Textual doesn't support @media queries
   Use reactive attributes or resize events for responsive design */

/* Template Grid */
.template-grid {
    layout: grid;
    grid-columns: 1fr 1fr;
    grid-gutter: 1;
    margin-top: 1;
}

.template-card {
    height: 5;
    padding: 1;
    background: $surface;
    border: tall $primary;
    text-align: center;
}

.template-card:hover {
    background: $boost;
    border: thick $primary;
}

/* Action Bar */
.action-bar {
    layout: horizontal;
    background: $surface;
    padding: 1;
    margin: 2 0;
    border: tall $primary;
    align: center middle;
}

.action-button {
    margin-right: 1;
    min-width: 12;
}

.action-button.primary {
    background: $primary;
    color: $text;
}

.action-button.primary.large {
    min-width: 20;
    height: 3;
    text-style: bold;
}

/* Results Dashboard */
.section-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.results-header {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
    align: left middle;
}

.results-header Static {
    width: 1fr;
}

.results-header Select {
    width: 20;
}

.results-list {
    height: 15;
    background: $surface;
    border: tall $secondary;
    margin-bottom: 2;
}

.stat-card {
    background: $surface;
    padding: 1;
    border: tall $secondary;
    text-align: center;
}

.stat-value {
    text-style: bold;
    color: $primary;
}

.button-row {
    layout: horizontal;
    margin-bottom: 1;
}

.button-row Button {
    margin-right: 1;
}

/* Status Bar */
.status-bar {
    height: 3;
    background: $surface;
    border-top: solid $primary;
    padding: 0 2;
    layout: horizontal;
    align: left middle;
}

.status-text {
    width: 1fr;
}

/* Responsive Adjustments - handled in Python code via resize events */
/* For narrow screens, switch grids to single column */

/* Utility Classes */
.hidden {
    display: none;
}

.subsection-title {
    text-style: bold;
    color: $secondary;
    margin: 1 0;
}

.help-text {
    color: $text-muted;
    text-style: italic;
}

/* Disabled States */
Button:disabled {
    opacity: 0.5;
}

/* Loading States */
.loading {
    opacity: 0.6;
}

/* Error States */
.error {
    border: tall $error;
    background: $error 10%;
}

/* ===== MODULE: features/_evals.tcss ===== */
/* ========================================
 * FEATURE: Evals
 * ========================================
 * Three-pane workbench: library rail, detail pane, readiness inspector.
 * Shared design-system classes -- .ds-panel, .destination-workbench,
 * .destination-workbench-pane, .ds-inspector, .density-compact/comfortable
 * -- are already defined in components/_agentic_terminal.tcss and
 * layout/_panes.tcss; this file only adds Evals-specific rail/pane rules.
 * ======================================== */

#evals-shell {
    height: 100%;
    min-height: 0;
}

/* I4: panes never scrolled. Vertical's own DEFAULT_CSS is
   `overflow: hidden hidden`, so content taller than a pane's bounded
   height (post-C1, a real bounded height rather than a fixed 11-row
   collapse) was simply clipped with no way to reach the hidden rows --
   in an editor whose entire job is reviewing a list (snippets, targets,
   run history). Scrolled at the narrowest level that isolates a LIST BODY
   from a sibling control that must stay reachable without scrolling past
   it (`#evals-import-snippets`, `#evals-primary-action`); the two
   detail-content widgets with no separate list body to isolate
   (`ClassicTaskDetail`, `EvalsInspector` -- the latter's readiness list
   and estimate share one flow) scroll as a whole instead. */
#evals-library-pane {
    overflow-y: auto;
}

#evals-snippet-table,
#evals-bench-target-table {
    overflow-y: auto;
}

#evals-inspector-bench,
#evals-classic-detail {
    overflow-y: auto;
}

.evals-rail-section-header {
    height: 1;
    min-height: 1;
    padding: 0 1;
}

.evals-rail-section-label {
    width: 1fr;
    height: 1;
    min-height: 1;
    text-style: bold;
    color: $ds-text-primary;
}

.evals-rail-section-toggle {
    width: 3;
    min-width: 3;
    max-width: 3;
    height: 1;
    min-height: 1;
    padding: 0;
    border: none;
}

.evals-rail-section-body {
    height: auto;
}

.evals-rail-row {
    width: 100%;
    height: 1;
    min-height: 1;
    padding: 0 1;
    border: none;
    text-align: left;
    content-align: left middle;
}

/* Explicit, not relying on the generic `.evals-rail-row { border: none }`
   above to win by cascade order against `.is-active { border: round
   $ds-action-focus }` (components/_agentic_terminal.tcss). Both rules are
   equal specificity (one class each); today `.evals-rail-row` happens to
   be declared later in the manifest, so it wins, but a manifest reorder
   could silently flip that and reintroduce the row's only content line
   being consumed by a round border (a real height-1 button needs at
   least 2 lines for a round border to render at all) -- mirrors
   `#mcp-hub-rail Button.mcp-rail-row.is-active`'s own override for the
   identical reason. */
.evals-rail-row.is-active {
    border: none;
    text-style: bold;
}

.evals-rail-empty-copy {
    color: $ds-text-muted;
    padding: 0 1;
}

/* Task 6 (empty states, sample bench, export). "No providers configured"
   replaces the BENCHES SECTION BODY only (see library_rail.py's
   _no_providers_message) -- deliberately not the whole rail: Datasets and
   Runs never needed a provider, and classic tasks stay reachable without
   one. These two ids only ever render together, in place of that one
   section's bench list. */
#evals-rail-no-providers {
    padding: 1 1 0 1;
}

#evals-rail-no-providers-detail {
    padding: 0 1 1 1;
}

#evals-rail-open-settings,
#evals-create-sample-bench {
    margin: 0 1 1 1;
    width: auto;
}

/* "No datasets" offers authoring and import side by side -- two compact
   buttons in one row, under the section's existing empty-copy line. */
.evals-rail-empty-actions {
    height: auto;
    padding: 0 1;
}

.evals-rail-empty-actions > Button {
    margin: 0 1 0 0;
}

/* I3: the labelled subgroup separating classic (non-word-bench) tasks from
   word benches under the Benches section -- see library_rail.py's
   CLASSIC_SUBGROUP_LABEL. Inert (a Static, never a Button); styled like
   the empty-copy line above it, never like a selectable row. */
.evals-rail-classic-separator {
    color: $ds-text-muted;
    height: 1;
    min-height: 1;
    padding: 0 1;
}

.evals-pane-title {
    height: 1;
    min-height: 1;
    text-style: bold;
    color: $ds-text-primary;
}

.evals-pane-heading {
    text-style: bold;
    color: $ds-text-primary;
}

#evals-primary-action {
    margin: 1 0 0 0;
    width: 100%;
}

/* Task 4 (bench editor + readiness inspector). Status colour lives here,
   in app-tier CSS, never in bench_editor.py/inspector.py's own widget
   CSS -- `.ds-status-badge { color: $ds-text-primary }`
   (components/_agentic_terminal.tcss) outranks any widget DEFAULT_CSS
   regardless of specificity, so a per-status colour has to win the same
   way: an app-tier rule combining `.ds-status-badge` with one of these
   modifier classes. Tests assert the label text, never these colours --
   see Tests/UI/test_evals_bench_editor.py. */
.evals-status-ready {
    color: $ds-status-ready;
}

.evals-status-unavailable {
    color: $ds-status-warning;
}

.evals-status-blocked {
    color: $ds-status-blocked;
}

.evals-status-unchecked {
    color: $ds-text-muted;
}

.evals-bench-target-row {
    height: auto;
    padding: 0 1;
}

.evals-classic-run-row {
    height: 1;
    min-height: 1;
    padding: 0 1;
}

#evals-inspector-bench .ds-recovery-callout {
    margin: 0 0 1 0;
}

/* Task 5 (snippet editor + import). The whitespace marker itself is a
   Rich inline style embedded directly in each row's Text content (see
   snippet_editor.py's WHITESPACE_MARKER_GLYPH/_WHITESPACE_MARKER_STYLE) --
   not a CSS class -- because a Rich Text object passed as a Static's
   content cannot reference Textual's $ds-* design tokens. This block only
   lays the table out; it never colours the marker or the status text
   (never colour, per the design contract -- tests assert the rendered
   text, in Tests/UI/test_evals_snippet_editor.py). */
.evals-snippet-table-header {
    text-style: bold;
    color: $ds-text-primary;
    padding: 0 1;
}

.evals-snippet-row {
    height: auto;
    padding: 0 1;
}

.evals-snippet-index {
    width: 4;
    color: $ds-text-muted;
}

.evals-snippet-text {
    width: 1fr;
}

.evals-snippet-meta {
    width: auto;
    color: $ds-text-muted;
}

#evals-snippet-editor-summary {
    color: $ds-text-muted;
}

#evals-snippet-warnings-summary {
    margin: 1 0 0 0;
}

#evals-import-snippets {
    margin: 1 0 0 0;
}

/* Task 1 (results grid + lenses). The grid fills its detail pane; the
   DataTable does its own row virtualization/scrolling once given a real
   height via `1fr`, so -- unlike #evals-snippet-table/#evals-bench-target-
   table above, which are plain Static lists with no scrolling of their
   own -- the wrapping #evals-results-grid does not need `overflow-y: auto`
   itself. */
#evals-results-grid {
    /* `1fr`, not `100%` -- which is what the comment above always claimed.
       `100%` is the full parent height regardless of siblings, so with the
       meta row above it the grid ran exactly one line past the bottom of
       the detail pane. The pane's old `border: solid` happened to absorb
       that overflow; removing the border when Evals moved onto the Lab
       frame exposed it. `1fr` takes what is left after siblings, which is
       what "fills its detail pane" means. */
    height: 1fr;
    min-height: 0;
}

#evals-grid-meta,
#evals-grid-state {
    height: 1;
    min-height: 1;
    color: $ds-text-muted;
}

#evals-grid-controls {
    height: auto;
    margin: 0 0 1 0;
}

#evals-grid-controls > Select {
    width: 1fr;
}

#evals-grid-table {
    height: 1fr;
    min-height: 0;
}

/* Focused-cell detail can run to many lines (a full top-K plus a probe
   table) -- scrolled at this level per the I4 convention above, mirroring
   #evals-inspector-bench/#evals-classic-detail (no separate list-body vs.
   sibling-control split needed here). */
#evals-cell-inspector {
    overflow-y: auto;
}

/* ===== MODULE: features/_metrics.tcss ===== */
/* ========================================
 * FEATURES: Metrics
 * ======================================== 
 * Metrics display styles
 * ======================================== */

/* --- Metrics Screen Styling --- */
MetricsScreen {
    padding: 1 2; /* Add some padding around the screen content */
    /* layout: vertical; /* MetricsScreen is a Static, VerticalScroll handles layout */
    /* align: center top; /* If needed, but VerticalScroll might handle this */
}

#metrics-container {
    padding: 1;
    /* border: round $primary-lighten-2; /* Optional: a subtle border */
    /* background: $surface; /* Optional: a slightly different background */
}

/* Styling for individual metric labels within MetricsScreen */
MetricsScreen Label {
    width: 100%;
    margin-bottom: 1; /* Space between metric items */
    padding: 1;       /* Padding inside each label's box */
    background: $panel-lighten-1; /* A slightly lighter background for each item */
    border: round $primary-darken-1; /* Border for each item */
    /* Textual CSS doesn't allow direct styling of parts of a Label's text (like key vs value) */
    /* The Python code uses [b] for keys, which Rich Text handles. */
}

/* Style for the title label: "Application Metrics" */
/* This targets the first Label directly inside the VerticalScroll with ID metrics-container */
#metrics-container > Label:first-of-type {
    text-style: bold underline;
    align: center middle;
    padding: 1 0 2 0; /* More padding below the title */
    background: transparent; /* No specific background for the title itself */
    border: none; /* No border for the title itself */
    margin-bottom: 2; /* Extra space after the title */
}

/* Style for error messages within MetricsScreen */
/* These require the Python code to add the respective class to the Label widget */
MetricsScreen Label.-error-message {
    color: $error; /* Text color for errors */
    background: $error 20%; /* Background for error messages, e.g., light red. USES $error WITH 20% ALPHA */
    /* border: round $error; /* Optional: border for error messages */
    text-style: bold;
}

/* Style for info messages (e.g. "file empty") within MetricsScreen */
MetricsScreen Label.-info-message {
    color: $text-muted; /* Or another color that indicates information */
    background: $panel; /* A more subdued background, or $transparent */
    /* border: round $primary-lighten-1; /* Optional: border for info messages */
    text-style: italic;
}
/* --- End of Metrics Screen Styling --- */

/* ===== MODULE: features/_embeddings.tcss ===== */
/* ========================================
 * Embeddings Feature Styles
 * ======================================== */

/* Sidebar title styling */
.sidebar-title {
    text-style: bold;
    margin-bottom: 1;
    padding: 0 1;
    color: $text-muted;
}

/* ========================================
 * Confirmation Dialog Styles
 * ======================================== */

/* Dialog container for modal screens */
#dialog-container {
    align: center middle;
    background: $surface;
    border: thick $primary;
    padding: 2;
    width: 50;
    height: auto;
}

#dialog-title {
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
    width: 100%;
}

#dialog-message {
    text-align: center;
    margin-bottom: 2;
    color: $text-muted;
    width: 100%;
}

#dialog-buttons {
    layout: horizontal;
    align: center middle;
    width: 100%;
    margin-top: 1;
}

#dialog-buttons Button {
    margin: 0 1;
    min-width: 10;
}

/* Modal screen background */
ModalScreen {
    align: center middle;
    background: $background 80%;
}

/* ========================================
 * Form Validation Error Styles
 * ======================================== */

/* Error message displays */
.error-message {
    color: $error;

    margin-top: 0;
    margin-bottom: 1;
    padding: 0 1;
    text-style: italic;
}

.error-message.hidden {
    display: none;
}

/* ========================================
 * Enhanced List Item Styles
 * ======================================== */

.model-header {
    layout: horizontal;
    margin-bottom: 0;
}

.model-name {
    text-style: bold;
    margin-right: 1;
}

.model-provider {
    color: $text-muted;

}

.model-download-status,
.model-memory-status,
.model-size {

    margin-right: 2;
}

.model-size {
    color: $text-muted;
}

/* ========================================
 * Empty State Styles
 * ======================================== */

.empty-state-container {
    width: 100%;
    height: 100%;
    align: center middle;
    padding: 3;
}

.empty-state-content {
    align: center middle;
    width: auto;
}

.empty-state-icon {

    margin-bottom: 1;
    text-align: center;
}

.empty-state-title {
    text-style: bold;

    margin-bottom: 1;
    text-align: center;
}

.empty-state-description {
    color: $text-muted;
    margin-bottom: 2;
    text-align: center;
    max-width: 40;
}

.empty-state-action {
    margin-top: 1;
}

/* ========================================
 * Enhanced Visual Design
 * ======================================== */

/* Enhanced hover states */
/* Button:hover handled in components/_buttons.tcss to fix persistent hover issue */

Select:hover {
    border: solid $primary-lighten-1;
}


/* Visual separators */
.section-separator {
    height: 1;
    background: $primary-darken-2;
    margin: 2 0;
}

/* ========================================
 * Tooltip and Help Icon Styles
 * ======================================== */

/* Tooltip container */
.tooltip {

    background: $panel;
    border: solid $primary;
    padding: 1;
    max-width: 40;

    display: none;
}

.tooltip-content {
    color: $text;

}

/* Help icon */
.help-icon {

    margin-left: 1;
    color: $primary;
}

.help-icon:hover {
    color: $primary-lighten-1;
}

/* ========================================
 * Chunk Preview Widget Styles
 * ======================================== */

.chunk-preview-widget {
    width: 100%;
    height: auto;
}

.chunk-preview-container {
    width: 100%;
    max-height: 30;
    background: $surface;
    border: round $primary-darken-1;
    padding: 1;
}

.chunk-preview-title {
    text-style: bold;
    margin-bottom: 1;
    color: $primary;
}

.chunk-preview-empty {
    color: $text-muted;
    text-align: center;
    padding: 2;
}

.chunk-item {
    margin-bottom: 2;
    padding: 1;
    background: $panel;
    border: round $primary-darken-2;
}

.chunk-header {
    layout: horizontal;
    margin-bottom: 1;
    padding-bottom: 1;
    border-bottom: dashed $primary-darken-2;
}

.chunk-number {
    text-style: bold;
    color: $accent;
    margin-right: 2;
}

.chunk-range {
    color: $text-muted;

    margin-right: 2;
}

.chunk-size {
    color: $text-muted;

}

.chunk-overlap {
    background: $warning 20%;
    padding: 0 1;
    margin-bottom: 1;
    border-left: thick $warning;
    text-style: italic;
    color: $text-muted;
}

.chunk-content {
    padding: 0 1;

}

.chunk-truncated {
    color: $text-muted;
    text-style: italic;
    text-align: right;
    margin-top: 0;
}

.chunk-more {
    text-align: center;
    color: $text-muted;
    text-style: italic;
    margin-top: 1;
}

.chunk-boundary {
    text-align: center;
    color: $primary-darken-1;
    margin: 1 0;
}

/* ========================================
 * Batch Selection Styles
 * ======================================== */

.batch-controls {
    layout: horizontal;
    margin: 1 0;
    padding: 1;
    background: $surface;
    border: round $primary;
}

.batch-controls.hidden {
    display: none;
}

.batch-button {
    margin: 0 1;
    min-width: 12;
    height: 3;
}

/* ========================================
 * Toast Notification Styles
 * ======================================== */

.toast-manager {
    dock: top;
    align: right top;
    width: auto;
    height: auto;
    margin: 2 2 0 0;
    layer: above;

}

.toast-stack {
    width: auto;
    height: auto;
}

.toast-notification {
    width: 35;
    margin-bottom: 1;
}

.toast-container {
    layout: horizontal;
    padding: 1;
    border: round;
    align: left middle;
}

.toast-icon {
    margin-right: 1;
    min-width: 3;
    text-align: center;
}

.toast-message {
    width: 1fr;
    text-wrap: wrap;
}

.toast-close {
    min-width: 3;
    height: 3;
    margin-left: 1;
    background: transparent;
    border: none;
}

.toast-close:hover {
    background: $background 50%;
}

/* Toast severity styles */
.toast-success {
    background: $success 90%;
    border: solid $success;
    color: $text;
}

.toast-info {
    background: $primary 90%;
    border: solid $primary;
    color: $text;
}

.toast-warning {
    background: $warning 90%;
    border: solid $warning;
    color: $text;
}

.toast-error {
    background: $error 90%;
    border: solid $error;
    color: $text;
}

/* Toast animations */
.toast-slide-in {
    /* Animation properties would go here if needed */
}

/* ========================================
 * Detailed Progress Bar Styles
 * ======================================== */

.detailed-progress-container {
    width: 100%;
    padding: 1;
    background: $panel;
    border: round $primary;
}

.progress-stage-row,
.progress-item-row,
.progress-metrics-row {
    layout: horizontal;
    margin-bottom: 1;
    align: left middle;
}

.progress-action-row {
    layout: horizontal;
    margin-bottom: 1;
    align: right middle;
}

.progress-label {
    width: 12;
    text-align: right;
    margin-right: 1;
    color: $text-muted;
}

.stage-indicator {
    width: 1fr;
    text-style: bold;
    color: $primary;
}

.current-item {
    width: 1fr;
    color: $text;
    text-style: italic;
}

.pause-button {
    min-width: 10;
}

#main-progress {
    margin-bottom: 1;
    height: 3;
}

.stage-progress {
    height: 2;
    background: $surface;
}

.progress-metrics-row {
    margin-top: 1;
    border-top: dashed $primary-darken-2;
    padding-top: 1;
}

.metric-group {
    margin-right: 3;
}

.metric-label {

    color: $text-muted;
    margin-bottom: 0;
}

.metric-value {

    text-style: bold;
    color: $primary;
}

/* ========================================
 * Embedding Template Selector Styles
 * ======================================== */

/* Template selector dialog */
#embedding-template-selector-container {
    width: 80;
    height: 50;
    background: $panel;
    border: thick $primary;
    padding: 2;
}

#embedding-template-selector-title {
    text-style: bold;
    text-align: center;
    margin-bottom: 2;
}

#embedding-template-selector-content {
    height: 1fr;
    margin-bottom: 2;
}

#embedding-template-category-pane {
    width: 25%;
    min-width: 20;
    background: $surface;
    padding: 1;
    border-right: solid $primary-darken-1;
}

#embedding-template-grid-container {
    width: 1fr;
    padding: 1;
    overflow-y: auto;
}

.embedding-template-grid {
    grid-columns: 2;
    grid-gutter: 1;
    padding: 1;
}

/* Template card styles */
.embedding-template-card-container {
    background: $surface;
    border: round $primary-darken-2;
    padding: 1;
    height: auto;
}

.embedding-template-card:hover .embedding-template-card-container {
    background: $surface-lighten-1;
    border: solid $accent;
}

.embedding-template-card-header {
    layout: horizontal;
    margin-bottom: 1;
    align: left middle;
}

.embedding-template-card-title {
    text-style: bold;
    color: $primary;
    width: 1fr;
}

.embedding-template-card-category {

    color: $text-muted;
    background: $primary 20%;
    padding: 0 1;
    border: round $primary;
}

.embedding-template-card-description {
    margin-bottom: 1;
    color: $text-muted;

}

.embedding-template-card-label {

    text-style: bold;
    margin-bottom: 0;
}

.embedding-template-card-list {
    margin-left: 1;
    margin-bottom: 1;
}

.embedding-template-card-item {

    color: $text-muted;
}

.embedding-template-card-button {
    width: 100%;
    margin-top: 1;
}

/* Quick select widget */
.embedding-template-quick-select-container {
    layout: horizontal;
    align: left middle;
    padding: 1;
    background: $surface;
    border: round $primary-darken-2;
    margin-bottom: 1;
}

.embedding-template-select-label {
    margin-right: 2;
    min-width: 10;
}

.embedding-template-quick-button {
    margin-right: 1;
    min-width: 15;
}

.embedding-template-browse-button {
    margin-left: 1;
}

.current-template-name {
    margin-left: 2;
    color: $success;
    text-style: italic;
}

/* ========================================
 * Activity Log Widget Styles
 * ======================================== */

.activity-log-widget {
    width: 100%;
    height: 100%;
}

.activity-log-container {
    width: 100%;
    height: 100%;
    background: $panel;
    border: round $primary-darken-2;
    padding: 1;
}

.activity-log-header {
    layout: horizontal;
    margin-bottom: 1;
    align: left middle;
}

.activity-log-title {
    text-style: bold;

    width: 1fr;
}

.activity-log-actions {
    layout: horizontal;
}

.activity-log-actions Button {
    margin-left: 1;
    min-width: 10;
    height: 3;
}

.activity-log-controls {
    layout: horizontal;
    margin-bottom: 1;
    align: left middle;
}

.filter-button {
    margin-right: 1;
    min-width: 8;
    height: 3;
    background: $surface;
}

.filter-button:hover {
    background: $primary 30%;
}

.filter-button.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.log-search-input {
    width: 20;
}

.activity-log-scroll {
    height: 1fr;
    background: $surface;
    border: round $primary-darken-3;
    padding: 1;
}

.log-entries-container {
    width: 100%;
}

/* Log entry styles */
.log-entry {
    layout: horizontal;
    margin-bottom: 1;
    padding: 0;
    align: left top;
}

.log-timestamp {
    min-width: 10;

    color: $text-muted;
    text-align: right;
    padding-right: 1;
}

.log-icon {
    min-width: 3;
    text-align: center;
}

.log-category {
    min-width: 12;
    color: $primary;

    padding: 0 1;
}

.log-message {
    width: 1fr;
    padding-left: 1;
}

/* Level-specific colors */
.log-info {
    color: $text;
}

.log-info .log-icon {
    color: $primary;
}

.log-success {
    color: $success;
}

.log-success .log-message {
    color: $success;
}

.log-warning {
    color: $warning;
}

.log-warning .log-message {
    color: $warning;
}

.log-error {
    color: $error;
}

.log-error .log-message {
    color: $error;
}

.log-debug {
    color: $text-muted;
    text-style: italic;
}

.log-debug .log-message {
    color: $text-muted;
}

/* Small button styles */
.small-button {
    height: 3;
    min-width: 8;

}

/* ========================================
 * Performance Metrics Widget Styles
 * ======================================== */


.metrics-title {
    text-style: bold;
    text-align: center;
    margin-bottom: 1;

}

.metrics-grid {
    grid-size: 2;
    grid-gutter: 1;
    width: 100%;
    margin-bottom: 1;
}

/* Metric box styling */
.metric-box {
    background: $surface;
    border: round $primary-darken-2;
    padding: 1;
    height: auto;
}


.metric-label {

    color: $text-muted;
}

.metric-value {

    text-style: bold;
    color: $primary;
    text-align: center;
    margin-bottom: 0;
}


.io-rate {
    width: 50%;
    text-align: center;

}

.io-rate:first-child {
    color: $success;
}

.io-rate:last-child {
    color: $warning;
}

/* ===== MODULE: features/_splash.tcss ===== */
/* Splash Screen Styles */

/* Main splash screen container */
SplashScreen, .splash-screen {
    layer: overlay;
    background: $background;
    width: 100%;
    height: 100%;
    align: center middle;
    dock: top;
}

/* Center container for splash content */
#splash-center {
    width: 100%;
    height: 100%;
    align: center middle;
}

/* Content container */
#splash-content {
    width: 100%;
    height: 100%;
    align: center middle;
    padding: 0;
}

/* Main splash display area */
#splash-main, .splash-main {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    margin: 0;
}

/* Splash display widget - the actual content display area */
#splash-display, .splash-display {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    align: center middle;
    padding: 0;
    margin: 0;
}

/* Progress text */
#splash-progress-text, .splash-progress-text {
    width: 100%;
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
}

/* Progress bar styling */
#splash-progress-bar, .splash-progress-bar {
    width: 80%;
    max-width: 100;
    height: 1;
    margin: 0 0 0 0;
    align: center middle;
}

#splash-progress-bar Bar {
    color: $success;
}

#splash-progress-bar PercentageStatus {
    text-style: dim;
}

/* Animation-specific styles */

/* Matrix rain effect */
.matrix-rain {
    color: $success;
    text-style: bold;
}

/* Glitch effect */
.glitch-effect {
    color: $text;
    text-style: bold;
}

.glitch-effect-error {
    color: $error;
    text-style: bold;
}

.glitch-effect-warning {
    color: $warning;
    text-style: bold;
}

.glitch-effect-success {
    color: $success;
    text-style: bold;
}

/* Retro terminal effect */
.retro-terminal {
    color: $success;
    background: rgba(0, 0, 0, 0.9);
    text-style: bold;
}

.retro-scanline {
    background: rgba(0, 255, 0, 0.1);
}

/* Fade effect styles */
.fade-in {
    opacity: 0.0;
}


/* Loading placeholder for lazy-loaded content */
.loading-placeholder {
    color: $text-muted;
    text-align: center;
    padding: 4;
}

/* Hide splash screen when not active */
SplashScreen.hidden {
    display: none;
}

/* ===== MODULE: features/_wizards.tcss ===== */
/* ========================================
 * Wizard Framework Styles
 * ======================================== */

/* ========================================
 * Base Wizard Container
 * ======================================== */

.wizard-container {
    layout: vertical;
    height: 100%;
    width: 100%;
    background: $surface;
    padding: 0;
}

.wizard-title {
    text-style: bold;
    text-align: center;
    background: $primary-darken-2;
    color: $text;
    padding: 1 2;
    margin-bottom: 0;
    border-bottom: thick $primary-darken-1;
    width: 100%;
    height: 3;
}

/* ========================================
 * Progress Indicator
 * ======================================== */

.wizard-progress {
    layout: horizontal;
    align: center middle;
    padding: 2;
    background: $panel;
    border-bottom: solid $primary-darken-2;
    height: auto;
}

.step-indicator-container {
    layout: horizontal;
    align: center middle;
    width: 1fr;
}

.step-number {
    width: 3;
    height: 3;
    border: round $primary;
    background: $panel;
    align: center middle;
    margin-right: 1;
    text-align: center;
}

.step-number.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    border: round $ds-focus-accent;
    text-style: bold underline;
}

.step-number.complete {
    background: $success;
    color: $text;
    border: solid $success;
}

.step-title {
    margin-right: 1;
    color: $text-muted;
}

.step-title.active {
    color: $ds-focus-fg;
    text-style: bold underline;
}

.step-title.complete {
    color: $success;
}

.step-connector {
    height: 1;
    width: 1fr;
    background: $primary-darken-2;
    margin: 0 1;
}

.step-connector.complete {
    background: $success;
}

/* ========================================
 * Step Container
 * ======================================== */

.wizard-steps-container {
    height: 1fr;
    width: 100%;
    overflow-y: auto;
    padding: 0;
    background: $surface;
}

.wizard-step {
    width: 100%;
    height: 100%;
    padding: 2;
    display: block;
    visibility: hidden;
}

.wizard-step.active {
    visibility: visible;
}

.wizard-step.hidden {
    display: none;
}

/* Step animations removed - not supported in Textual */

/* ========================================
 * Navigation Bar
 * ======================================== */

.wizard-navigation {
    layout: horizontal;
    align: center middle;
    padding: 1 2;
    background: $panel;
    border-top: thick $primary-darken-2;
    height: 5;
}

.wizard-progress-text {
    width: 1fr;
    text-align: center;
    color: $text-muted;
}

#wizard-back, #wizard-next {
    min-width: 15;
    height: 3;
}

#wizard-back:disabled {
    opacity: 0.5;
}

#wizard-next:disabled {
    opacity: 0.5;
}

/* ========================================
 * Content Type Selection
 * ======================================== */


.content-type-card {
    background: $panel;
    border: round $primary-darken-2;
    padding: 2;
    align: center middle;
    height: 15;
}

.content-type-card:hover {
    background: $panel-lighten-1;
    border: solid $accent;
}

.content-type-card.selected {
    background: $ds-focus-bg;
    border: round $ds-focus-accent;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.content-type-title {
    text-style: bold;
    margin-bottom: 0;
    text-align: center;
}

.content-type-description {
    color: $text-muted;
    text-align: center;
}

.content-type-card.selected .content-type-title,
.content-type-card.selected .content-type-description {
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* ========================================
 * Content Selection
 * ======================================== */


.content-search-input {
    width: 100%;
    margin-bottom: 2;
}

.content-search-input.hidden {
    display: none;
}


.preview-label {
    text-style: bold;
    margin-bottom: 1;
    color: $primary;
}

.content-list {
    width: 100%;
}

.content-item {
    width: 100%;
    padding: 1;
    margin-bottom: 0;
    border-bottom: dashed $primary-darken-3;
}

.content-item:hover {
    background: $panel 50%;
}




.placeholder-text {
    text-align: center;
    color: $text-muted;
    padding: 2;
}

/* ========================================
 * Quick Settings
 * ======================================== */

.settings-section {
    margin-bottom: 2;
    padding: 1;
    background: $panel;
    border: round $primary-darken-3;
}

.settings-label {
    text-style: bold;
    margin-bottom: 1;
    color: $primary;
}

.settings-input {
    width: 100%;
    margin-bottom: 0;
}

.settings-help {
    color: $text-muted;
    margin-top: 0;
}

.preset-cards-container {
    layout: horizontal;
    margin-bottom: 2;
    padding: 1;
}

.preset-card {
    background: $panel;
    border: round $primary-darken-2;
    padding: 2;
    margin-right: 1;
    width: 1fr;
    height: auto;
}

.preset-card:hover {
    background: $panel-lighten-1;
    border: solid $accent;
}

.preset-card.selected {
    background: $ds-focus-bg;
    border: round $ds-focus-accent;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.preset-icon {
    text-align: center;
    margin-bottom: 1;
}

.preset-name {
    text-style: bold;
    text-align: center;
    margin-bottom: 0;
}

.preset-description {
    color: $text-muted;
    text-align: center;
    margin-bottom: 1;
}

.preset-details {
    border-top: dashed $primary-darken-3;
    padding-top: 1;
}

.preset-detail {
    color: $text-muted;
    margin-bottom: 0;
}

.preset-card.selected .preset-name,
.preset-card.selected .preset-description,
.preset-card.selected .preset-detail {
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Advanced settings */
.advanced-settings-container {
    margin-top: 2;
}

.advanced-toggle {
    width: 100%;
    background: $surface;
    border: round $primary-darken-3;
    color: $text-muted;
    text-align: left;
}

.advanced-toggle:hover {
    background: $panel;
    color: $text;
}

.advanced-settings {
    margin-top: 1;
    padding: 2;
    background: $surface;
    border: round $primary-darken-3;
}

.advanced-settings.hidden {
    display: none;
}

.advanced-settings Label {
    margin-top: 1;
}

.advanced-settings Select,
.advanced-settings Input {
    width: 100%;
    margin-bottom: 1;
}

/* ========================================
 * Processing Step
 * ======================================== */


.progress-text {
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
    color: $primary;
}

.current-item {
    text-align: center;
    color: $text-muted;
    margin-bottom: 2;
    text-style: italic;
}

.progress-stats {
    layout: horizontal;
    align: center middle;
    padding-top: 1;
    border-top: dashed $primary-darken-2;
}

.progress-stats Label {
    width: 1fr;
    text-align: center;
    color: $text-muted;
}


/* ========================================
 * Validation and Errors
 * ======================================== */

.error-message {
    color: $error;
    background: $error 10%;
    border: round $error;
    padding: 1;
    margin: 1;
    text-align: center;
}

/* ========================================
 * Animations and Transitions
 * ======================================== */

/* Staggered entrance animations removed - not supported in Textual */

/* Progress bar animation removed - not supported in Textual */


/* ========================================
 * Responsive adjustments
 * ======================================== */

/* Media queries not supported in Textual - using fixed layouts */

/* ========================================
 * Chatbook Creation Wizard Specific Styles
 * ======================================== */

/* Basic Info Step */
BasicInfoStep {
    layout: vertical;
    padding: 2;
}

BasicInfoStep .form-group {
    margin-bottom: 2;
}

BasicInfoStep .form-label {
    color: $text-muted;
    margin-bottom: 0;
}

BasicInfoStep .form-input {
    width: 100%;
    margin-top: 0;
}

BasicInfoStep #chatbook-description {
    height: 6;
}

BasicInfoStep .info-box {
    padding: 1;
    background: $boost;
    border: round $primary;
    margin-top: 2;
}

/* Content Selection Step */
ContentSelectionStep {
    layout: vertical;
    height: 100%;
}

ContentSelectionStep .selection-header {
    height: 3;
    padding: 1;
    background: $boost;
    border: round $background-darken-1;
    margin-bottom: 1;
}

ContentSelectionStep .content-tree-container {
    height: 1fr;
}

/* Export Options Step */
ExportOptionsStep {
    layout: vertical;
    padding: 2;
}

ExportOptionsStep .option-group {
    margin-bottom: 2;
    padding: 1;
    background: $boost;
    border: round $background-darken-1;
}

ExportOptionsStep .option-title {
    text-style: bold;
    margin-bottom: 1;
}

ExportOptionsStep .radio-option {
    margin: 0 0 1 1;
}

ExportOptionsStep .checkbox-option {
    margin: 0 0 1 1;
}

/* Preview Confirm Step */
PreviewConfirmStep {
    layout: vertical;
    padding: 2;
}

PreviewConfirmStep .preview-header {
    margin-bottom: 2;
}

PreviewConfirmStep .chatbook-title {
    text-style: bold;
    margin-bottom: 1;
}

PreviewConfirmStep .preview-section {
    margin-bottom: 2;
    padding: 1;
    background: $boost;
    border: round $background-darken-1;
}

PreviewConfirmStep .section-title {
    text-style: bold;
    margin-bottom: 1;
}

PreviewConfirmStep .content-list {
    margin-left: 2;
    color: $text-muted;
}

PreviewConfirmStep .file-tree {
    height: 12;
    border: round $background-darken-1;
    background: $background;
    padding: 1;
    margin: 1 0;
}

PreviewConfirmStep .location-section {
    margin-top: 2;
    padding: 1;
    background: $panel;
    border: round $primary;
}

PreviewConfirmStep .location-path {
    color: $primary;
    margin: 1 0;
}

/* Progress Step */
ProgressStep {
    layout: vertical;
    padding: 2;
    align: center middle;
}

ProgressStep .progress-container {
    width: 100%;
    max-width: 60;
    padding: 2;
    background: $boost;
    border: round $background-darken-1;
}

ProgressStep .progress-title {
    text-align: center;
    text-style: bold;
    margin-bottom: 2;
}

ProgressStep #export-progress, ProgressStep #import-progress {
    margin: 2 0;
}

ProgressStep .progress-status {
    margin: 2 0;
}

ProgressStep .status-item {
    margin: 0 0 1 2;
    color: $text-muted;
}

ProgressStep .status-item.completed {
    color: $success;
}

ProgressStep .status-item.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

ProgressStep .status-item.error {
    color: $error;
}

ProgressStep .completion-message {
    text-align: center;
    padding: 2;
    margin-top: 2;
    background: $success 20%;
    border: round $success;
}

ProgressStep .completion-actions {
    layout: horizontal;
    height: auto;
    align: center middle;
    margin-top: 2;
}

ProgressStep .completion-actions Button {
    margin: 0 1;
}

ProgressStep .hidden {
    display: none;
}

/* ========================================
 * Chatbook Import Wizard Specific Styles
 * ======================================== */

/* File Selection Step */
FileSelectionStep {
    layout: vertical;
    padding: 2;
}

FileSelectionStep .file-selection-container {
    layout: vertical;
    height: 100%;
    align: center middle;
}

FileSelectionStep .drop-zone {
    width: 80%;
    height: 20;
    border: dashed $background-darken-2;
    background: $boost;
    align: center middle;
    margin: 2 0;
}

FileSelectionStep .drop-zone.hover {
    border: solid $primary;
    background: $primary 10%;
}

FileSelectionStep .drop-zone-content {
    text-align: center;
    padding: 2;
}

FileSelectionStep .drop-zone-icon {
    margin-bottom: 1;
    color: $text-muted;
}

FileSelectionStep .drop-zone-text {
    color: $text-muted;
    margin-bottom: 1;
}

FileSelectionStep .file-path-display {
    width: 80%;
    margin: 2 0;
    padding: 1;
    background: $boost;
    border: round $background-darken-1;
}

FileSelectionStep .path-label {
    color: $text-muted;
    margin-bottom: 0;
}

FileSelectionStep .path-value {
    color: $primary;
    margin-top: 0;
}

FileSelectionStep .browse-button {
    margin-top: 2;
}

/* Preview Validation Step */
PreviewValidationStep {
    layout: vertical;
    padding: 2;
}

PreviewValidationStep .preview-header {
    margin-bottom: 2;
}

PreviewValidationStep .chatbook-info {
    padding: 1 2;
    background: $boost;
    border: round $background-darken-1;
    margin-bottom: 2;
}

PreviewValidationStep .info-title {
    text-style: bold;
    margin-bottom: 1;
}

PreviewValidationStep .info-row {
    layout: horizontal;
    height: auto;
    margin: 0 0 1 1;
}

PreviewValidationStep .info-label {
    width: 15;
    color: $text-muted;
}

PreviewValidationStep .info-value {
    width: 1fr;
}

PreviewValidationStep .content-preview {
    padding: 1 2;
    background: $boost;
    border: round $background-darken-1;
    margin-bottom: 2;
}

PreviewValidationStep .preview-title {
    text-style: bold;
    margin-bottom: 1;
    color: $primary;
}

PreviewValidationStep .content-tree {
    height: 15;
    background: $background;
    border: round $background-darken-1;
    padding: 1;
}

PreviewValidationStep .validation-results {
    padding: 1 2;
    background: $boost;
    border: round $background-darken-1;
}

PreviewValidationStep .validation-title {
    text-style: bold;
    margin-bottom: 1;
}

PreviewValidationStep .validation-item {
    margin: 0 0 1 1;
}

PreviewValidationStep .validation-success {
    color: $success;
}

PreviewValidationStep .validation-warning {
    color: $warning;
}

PreviewValidationStep .validation-error {
    color: $error;
}

/* Conflict Resolution Step */
ConflictResolutionStep {
    layout: vertical;
    padding: 2;
}

ConflictResolutionStep .resolution-header {
    margin-bottom: 2;
    padding: 1;
    background: $boost;
    border: round $background-darken-1;
}

ConflictResolutionStep .strategy-section {
    margin-bottom: 2;
    padding: 1 2;
    background: $boost;
    border: round $background-darken-1;
}

ConflictResolutionStep .strategy-title {
    text-style: bold;
    margin-bottom: 1;
    color: $primary;
}

ConflictResolutionStep .radio-option {
    margin: 0 0 1 1;
}

ConflictResolutionStep .strategy-description {
    margin: 0 0 1 3;
    color: $text-muted;
}

ConflictResolutionStep .conflict-preview {
    padding: 1 2;
    background: $boost;
    border: round $warning;
}

ConflictResolutionStep .conflict-title {
    text-style: bold;
    color: $warning;
    margin-bottom: 1;
}

ConflictResolutionStep .conflict-list {
    margin-left: 2;
    color: $text-muted;
}

ConflictResolutionStep .no-conflicts {
    text-align: center;
    padding: 3;
    color: $success;
}

/* Import Options Step */
ImportOptionsStep {
    layout: vertical;
    padding: 2;
}

ImportOptionsStep .options-section {
    margin-bottom: 2;
    padding: 1 2;
    background: $boost;
    border: round $background-darken-1;
}

ImportOptionsStep .section-title {
    text-style: bold;
    margin-bottom: 1;
    color: $primary;
}

ImportOptionsStep .checkbox-option {
    margin: 0 0 1 1;
}

ImportOptionsStep .option-description {
    margin: 0 0 1 3;
    color: $text-muted;
}

/* Import Progress Step */
ImportProgressStep {
    layout: vertical;
    padding: 2;
    align: center middle;
}

ImportProgressStep .progress-container {
    width: 100%;
    max-width: 60;
    padding: 2;
    background: $boost;
    border: round $background-darken-1;
}

ImportProgressStep .progress-title {
    text-align: center;
    text-style: bold;
    margin-bottom: 2;
}

ImportProgressStep #import-progress {
    margin: 2 0;
}

ImportProgressStep .progress-status {
    margin: 2 0;
}

ImportProgressStep .status-item {
    margin: 0 0 1 2;
    color: $text-muted;
}

ImportProgressStep .status-item.completed {
    color: $success;
}

ImportProgressStep .status-item.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

ImportProgressStep .status-item.error {
    color: $error;
}

ImportProgressStep .completion-message {
    text-align: center;
    padding: 2;
    margin-top: 2;
    background: $success 20%;
    border: round $success;
}

ImportProgressStep .completion-stats {
    margin-top: 2;
    padding: 1 2;
    background: $boost;
    border: round $background-darken-1;
}

ImportProgressStep .stat-row {
    layout: horizontal;
    height: auto;
    margin: 0 0 1 0;
}

ImportProgressStep .stat-label {
    width: 20;
    color: $text-muted;
}

ImportProgressStep .stat-value {
    width: 1fr;
    text-align: right;
}

/* ========================================
 * SmartContentTree Styles (used by wizards)
 * ======================================== */

SmartContentTree {
    layout: vertical;
    height: 100%;
}

SmartContentTree .tree-controls {
    height: auto;
    padding: 1;
    background: $boost;
    border: round $background-darken-1;
    margin-bottom: 1;
}

SmartContentTree .search-row {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

SmartContentTree .search-input {
    width: 1fr;
    margin-right: 1;
}

SmartContentTree .filter-button {
    min-width: 12;
}

SmartContentTree .category-filters {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

SmartContentTree .category-checkbox {
    margin-right: 2;
}

SmartContentTree .selection-controls {
    layout: horizontal;
    height: auto;
}

SmartContentTree .selection-button {
    margin-right: 1;
    min-width: 10;
}

SmartContentTree .tree-container {
    height: 1fr;
    border: round $background-darken-1;
    background: $boost;
    padding: 1;
}

SmartContentTree .tree-stats {
    height: 2;
    padding: 0 1;
    text-align: right;
    color: $text-muted;
}

/* Tree node styling */
SmartContentTree Tree > .tree--cursor {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

SmartContentTree Tree > .selected-node {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* ===== MODULE: features/_chatbooks.tcss ===== */
/* _chatbooks.tcss */
/* Styles for the Chatbooks window */

/* Main window */
ChatbooksWindow {
    background: $background;
}

/* Main horizontal layout */
#main-layout {
    layout: horizontal;
    height: 100%;
}

/* Left sidebar */
#chatbooks-sidebar {
    width: 30;
    background: $panel;
    border-right: solid $background-darken-1;
    padding: 1;
    layout: vertical;
}

.sidebar-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
    text-align: center;
}

#chatbooks-list {
    height: 1fr;
    background: $boost;
    border: round $background-darken-1;
}

#chatbooks-list ListItem {
    padding: 0 1;
    height: 3;
}

#chatbooks-list ListItem:hover {
    background: $surface-lighten-1;
    color: $text;
}

#chatbooks-list ListItem.-highlight {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

/* Right content area */
#content-area {
    width: 1fr;
    layout: vertical;
    padding: 1;
}

/* Header section */
#chatbooks-header {
    background: $boost;
    border: round $background-darken-1;
    padding: 2;
    margin-bottom: 1;
}

.header-title {
    text-style: bold;
    text-align: center;
    color: $primary;
    margin-bottom: 1;
}

.header-subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: 2;
}

#action-buttons {
    layout: horizontal;
    align: center middle;
    height: 3;
}

#action-buttons Button {
    margin: 0 1;
    min-width: 20;
}

/* Dynamic content area */
#dynamic-content {
    height: 1fr;
    background: $boost;
    border: round $background-darken-1;
    padding: 2;
    overflow-y: auto;
}

/* Welcome text */
.welcome-text {
    color: $text;
    padding: 2;
}

/* Status text */
.status-text {
    color: $text-muted;
    text-align: center;
    padding: 2;
}

/* Info text */
.info-text {
    color: $text-muted;
    text-align: center;
    padding: 2;
}

/* Chatbook details */
.chatbook-details {
    layout: vertical;
    padding: 1;
}

.chatbook-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.chatbook-desc {
    color: $text;
    margin-bottom: 1;
}

.chatbook-size {
    color: $text-muted;
    margin-bottom: 1;
}

.chatbook-date {
    color: $text-muted;
    margin-bottom: 2;
}

/* Management buttons */
.management-buttons {
    layout: horizontal;
    height: 3;
    margin-top: 2;
}

.management-buttons Button {
    margin-right: 1;
    min-width: 12;
}

/* Error button variant */
Button.error {
    background: $error;
    color: $text;
}

Button.error:hover {
    background: $error-darken-1;
}

/* Template management styles */
.templates-list {
    layout: vertical;
    height: auto;
    max-height: 20;
    overflow-y: auto;
    margin: 1 0 2 0;
    background: $panel;
    border: round $background-darken-1;
    padding: 1;
}

.template-item {
    padding: 1;
    margin-bottom: 1;
    background: $boost;
    border: round $background-darken-1;
}

.template-item:hover {
    background: $primary 10%;
    border: round $primary;
}

.template-name {
    text-style: bold;
    color: $primary;
    margin-bottom: 0;
}

.template-description {
    color: $text-muted;
    text-style: italic;
}

/* ===== MODULE: features/_scheduling.tcss ===== */
/* ========================================
 * FEATURES: Scheduling
 * ========================================
 * Scheduling workbench specific styles
 * ======================================== */

SchedulesWorkbench TabbedContent,
SchedulesWorkbench TabbedContent ContentSwitcher,
SchedulesWorkbench TabbedContent TabPane {
    height: 1fr;
    min-height: 0;
}

#scheduling-workbench {
    layout: horizontal;
    height: 100%;
    min-height: 10;
    padding: 1;
    margin: 0;
    overflow: hidden;
    border: solid $ds-grid-line;
}

/* Intentional ~30/45/25 width split for the scheduling workbench design plan,
 * expressed with fr units so the three panes share leftover space with the
 * fixed-width vertical dividers. This avoids percentage-based overflow/wrapping
 * and differs from workflows/acp which use a 25/50/25 fr ratio. */
#scheduling-list-pane { width: 3fr; min-width: 30; border: solid $ds-grid-line; padding: 1; }
#scheduling-detail-pane { width: 4fr; min-width: 52; border: solid $ds-grid-line; padding: 1; }
#scheduling-inspector-pane { width: 2fr; min-width: 34; border: solid $ds-grid-line; padding: 1; }

SchedulesWorkbench.schedules-workbench-compact #scheduling-workbench {
    padding: 0;
}

SchedulesWorkbench.schedules-workbench-compact #scheduling-list-pane {
    width: 24;
    min-width: 20;
}

SchedulesWorkbench.schedules-workbench-compact #scheduling-detail-pane {
    width: 1fr;
    min-width: 32;
}

SchedulesWorkbench.schedules-workbench-compact #scheduling-inspector-pane {
    width: 20;
    min-width: 16;
}

/* Pane headers */
#scheduling-list-title,
#scheduling-task-detail-header,
#scheduling-task-inspector-header {
    text-style: bold;
    color: $text;
    padding: 0 0 0 0;
    border-bottom: solid $ds-grid-line;
    margin-bottom: 1;
}

/* Empty state */
#scheduling-task-detail-empty-state {
    color: $text-muted;
    text-align: center;
    padding: 3 1;
}

/* Lifecycle action row */
#scheduling-task-detail-lifecycle {
    height: auto;
    padding: 1 0;
    margin-top: 1;
}

#scheduling-task-detail-lifecycle Button {
    margin: 0 1 0 0;
}

/* Follow-in-Console prominence */
#schedules-follow-in-console {
    margin-top: 1;
    width: 100%;
    text-style: bold;
}

/* Status badge base (detail pane) */
#scheduling-task-status-badge {
    width: auto;
    height: 1;
    padding: 0 1;
    text-style: bold;
    color: $text;
    border: none;
    text-align: center;
}

#scheduling-task-status-badge.waiting {
    background: $primary;
}

#scheduling-task-status-badge.running,
#scheduling-task-status-badge.completed,
#scheduling-task-status-badge.found-results {
    background: $success;
}

#scheduling-task-status-badge.paused,
#scheduling-task-status-badge.needs-attention,
#scheduling-task-status-badge.missed {
    background: $warning;
    color: $text;
}

#scheduling-task-status-badge.blocked,
#scheduling-task-status-badge.conflict {
    background: $error;
}

#scheduling-task-status-badge.disabled,
#scheduling-task-status-badge.archived {
    background: $surface-darken-1;
    color: $text-muted;
}

/* Inspector metadata */
#scheduling-inspector-metadata {
    height: auto;
    padding-bottom: 1;
}

#scheduling-inspector-metadata Horizontal {
    height: auto;
    width: 100%;
    padding: 0;
    margin: 0;
}

.scheduling-inspector-label {
    color: $text-muted;
    padding: 0 1 0 0;
    width: 10;
}

.scheduling-inspector-value {
    color: $text;
    width: 1fr;
    height: auto;
}

#scheduling-conflict-card {
    height: auto;
    margin-top: 1;
}

#scheduling-conflict-card.conflict {
    border: solid $error;
    padding: 1;
    color: $error;
    background: $error 10%;
}

/* ===== MODULE: features/_code_repo.tcss ===== */
/* ========================================
 * Code Repository Copy/Paste Feature Styles
 * ======================================== */

/* Repository browser container - now embedded in tab */
.repo-window-container {
    width: 100%;
    height: 100%;
    background: $surface;
    padding: 0;
}

/* ========================================
 * Header Section
 * ======================================== */

.repo-header {
    dock: top;
    height: 7;
    background: $boost;
    padding: 1;
    border-bottom: solid $primary;
}

.repo-header-content {
    layout: grid;
    grid-size: 4 2;
    grid-columns: 3fr 1fr 1fr 1fr;
    grid-rows: 3 2;
    grid-gutter: 1 1;
    width: 100%;
}

.repo-url-input {
    width: 100%;
}

#repo-url-input {
    width: 100%;
}

#load-repo-btn {
    min-width: 10;
}

#token-config-btn {
    min-width: 8;
}

#token-config-btn.token-configured {
    background: $success 20%;
    border: solid $success;
}

#branch-selector {
    min-width: 15;
}

#repo-settings-btn {
    width: 3;
    min-width: 3;
}

/* Selection summary */
.selection-summary {
    column-span: 4;
    layout: grid;
    grid-size: 3 1;
    grid-columns: 1fr 1fr 1fr;
    align: left middle;
    width: 100%;
}

.summary-stat {
    text-align: left;
    color: $text-muted;
}

/* ========================================
 * Filter Bar
 * ======================================== */

.filter-bar {
    dock: top;
    height: 3;
    background: $panel;
    layout: grid;
    grid-size: 6 1;
    grid-columns: 2fr 1fr 3 3 3 1fr;
    grid-gutter: 0 1;
    padding: 0 1;
    border-bottom: solid $primary-darken-1;
}

#file-search {
    width: 100%;
}

#file-type-filter {
    width: 100%;
}

.filter-quick-btn {
    width: 3;
    height: 3;
    min-width: 3;
    padding: 0;
    background: $surface;
    border: solid $primary-darken-2;
}

.filter-quick-btn:hover {
    background: $primary 30%;
    border: solid $primary;
}

/* ========================================
 * Main Content Area
 * ======================================== */

.main-content {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 2fr 3fr;
    height: 1fr;
    background: $background;
}

/* Tree container */
.tree-container {
    border-right: solid $primary;
    overflow: hidden;
    padding: 1;
    background: $surface;
}

#repo-tree {
    height: 100%;
    width: 100%;
    border: none;
}

/* Preview container - now split into two sections */
.preview-panel {
    padding: 1;
    overflow: hidden;
    background: $surface;
    layout: vertical;
    height: 100%;
}

/* Aggregated text container (top half) */
.aggregated-text-container {
    height: 50%;
    margin-bottom: 1;
    layout: vertical;
}

/* File preview container (bottom half) */
.file-preview-container {
    height: 50%;
    layout: vertical;
}

.preview-header {
    height: 3;
    border-bottom: dashed $primary-darken-2;
    margin-bottom: 1;
    padding: 0 1;
    align: left middle;
}

#preview-title {
    text-style: bold;
    color: $primary;
}

#compilation-title {
    text-style: bold;
    color: $primary;
}

.preview-content {
    height: 1fr;
    border: round $primary-darken-2;
    padding: 1;
    background: $surface-darken-1;
    overflow-y: auto;
}

#file-preview {
    width: 100%;
    height: 100%;
    background: $surface-darken-1;
    padding: 1;
}

#aggregated-text {
    width: 100%;
    height: 100%;
    background: $surface-darken-1;
    padding: 1;
}

/* ========================================
 * Tree View Styles
 * ======================================== */

TreeView {
    height: 100%;
    width: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    border: solid $primary-darken-2;
    padding: 1;
    background: $surface;
}

.tree-container {
    width: 100%;
    height: auto;
}

.tree-loading {
    width: 100%;
    text-align: center;
    padding: 2;
    color: $text-muted;
}

.tree-empty {
    width: 100%;
    text-align: center;
    padding: 4;
    color: $text-muted;
}

/* Tree node styles */
TreeNode {
    height: 3;
    width: 100%;
}

.tree-node-row {
    layout: grid;
    grid-size: 4 1;
    grid-columns: auto 3 3 1fr;
    height: 3;
    align: left middle;
    width: 100%;
}

.tree-node-row:hover {
    background: $panel-lighten-1;
}

.tree-node-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.tree-indent {
    width: auto;
    content-align: left middle;
}

.tree-expand-btn {
    width: 3;
    height: 3;
    min-width: 3;
    background: transparent;
    border: none;
    padding: 0;
}

.tree-expand-btn:hover {
    background: $surface-lighten-1;
    color: $text;
}

.tree-expand-spacer {
    width: 3;
    height: 3;
}

.tree-checkbox {
    width: 3;
    height: 3;
}

.tree-content {
    padding-left: 1;
    width: 100%;
    content-align: left middle;
}

/* ========================================
 * Action Bar
 * ======================================== */

.action-bar {
    dock: bottom;
    height: 3;
    background: $panel;
    layout: grid;
    grid-size: 6 1;
    grid-columns: 1fr auto auto auto auto 1fr;
    grid-gutter: 0 1;
    align: center middle;
    padding: 0 2;
    border-top: solid $primary;
}

.action-bar Button {
    min-width: 15;
}

#reset-btn {
    min-width: 10;
}

#generate-compilation-btn {
    min-width: 20;
}

/* ========================================
 * Loading Overlay
 * ======================================== */

.loading-overlay {
    dock: top;
    width: 100%;
    height: 100%;
    background: $background 90%;
    align: center middle;
    layer: above;
}

.loading-overlay.hidden {
    display: none;
}

.loading-overlay LoadingIndicator {
    margin-bottom: 2;
}

.loading-label {
    text-align: center;
    margin-top: 2;
    text-style: bold;
    color: $text;
}

/* ========================================
 * Error Messages
 * ======================================== */

.error-message {
    color: $error;
    text-align: center;
    padding: 2;
    text-style: bold;
}

/* ========================================
 * Responsive Adjustments
 * ======================================== */

/* Note: Textual doesn't support @media queries
   These styles would need to be applied dynamically
   based on terminal size detection in Python code */


/* ========================================
 * Syntax Highlighting Support
 * ======================================== */

#file-preview {
    /* monospace font style */
}

/* ===== MODULE: features/_coding.tcss ===== */
/* ========================================
 * FEATURES: Coding Window
 * ======================================== 
 * Styles for the coding tab and its components
 * Includes sidebar navigation and content areas
 * ======================================== */

/* Main container */
CodingWindow {
    layout: horizontal;
    height: 100%;
    width: 100%;
}

/* Navigation pane (left sidebar) */
.coding-nav-pane {
    dock: left;
    width: 25%;
    min-width: 20;
    max-width: 40;
    background: $boost;
    padding: 1 2;
    border-right: thick $background-darken-1;
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
}

.coding-nav-pane.collapsed {
    width: 0 !important;
    min-width: 0 !important;
    border-right: none !important;
    padding: 0 !important;
    overflow: hidden !important;
    display: none;
}

/* Navigation buttons */
.coding-nav-button {
    width: 100%;
    height: 3;
    margin: 1 0;
    padding: 0 2;
    text-align: left;
    background: $surface;
}

.coding-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}

/* Content pane */
.coding-content-pane {
    height: 100%;
    width: 100%;
    padding: 2;
    background: $background;
}

/* Sidebar toggle button */
#coding-sidebar-toggle-button {
    dock: left;
    width: 3;
    height: 3;
    margin: 0 1 0 0;
    padding: 0;
    text-align: center;
    background: $surface;
}

#coding-sidebar-toggle-button.collapsed {
    dock: left;
    margin-left: 0;
}

/* View areas */
.coding-view-area {
    height: 100%;
    width: 100%;
    padding: 1;
}

/* Pane titles */
.coding-view-area .pane-title {
    text-style: bold underline;
    margin-bottom: 1;
    width: 100%;
    text-align: center;
}

/* Code repository specific */
#coding-view-repo-copy-paste Vertical {
    height: auto;
    align: center middle;
    padding: 2;
}

#coding-view-repo-copy-paste Label {
    margin-bottom: 2;
    text-align: center;
}

#open-repo-selector {
    width: auto;
    min-width: 30;
    height: 3;
    margin-top: 2;
}

/* ===== MODULE: features/_tab_dropdown.tcss ===== */
/* ========================================
 * FEATURES: Tab Dropdown Navigation
 * ======================================== 
 * Dropdown-based tab navigation system
 * Replaces horizontal tab bar with compact dropdown
 * ======================================== */

/* Container for the dropdown - positioned at top of window */
#tab-dropdown-container {
    dock: top;
    width: 100%;      /* Full width of window */
    height: 3;        /* Match the original tab bar height */
    padding: 0 1;
    background: $panel;
    border-bottom: solid $border;
    margin: 0;
    align: center middle;  /* Center the dropdown in the container */
}

/* The Select widget itself */
#tab-dropdown-select {
    width: 30;        /* Fixed width for the dropdown selector */
    height: 100%;
    background: $panel;
    color: $text;
    border: solid $border;
    border-bottom: solid $border;
    padding: 0 1;
    margin: 0;        /* No margin needed - centering handled by container */
}

/* Select widget hover state */
#tab-dropdown-select:hover {
    background: $panel-lighten-1;
    color: $text;
}

/* Select widget focus state */
#tab-dropdown-select:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

/* Dropdown overlay container */
#tab-dropdown-select SelectOverlay {
    background: $background;
    border: solid $border;
    max-height: 20;      /* Limit dropdown height to prevent full-screen coverage */
    margin-top: 0;       /* No gap - directly below the select */
    width: auto;         /* Auto width to fit content */
    min-width: 30;       /* Match the select widget width */
    /* layer: above; */  /* Ensure dropdown appears above other content if supported */
}

/* Individual options in the dropdown */
#tab-dropdown-select SelectOverlay Option {
    padding: 0 2;
    background: $panel;
    color: $text-muted;
    min-height: 3;       /* Comfortable click target */
}

/* Option hover state */
#tab-dropdown-select SelectOverlay Option:hover {
    background: $surface-lighten-1;
    color: $text;
}

/* Currently selected option (when dropdown is open) */
#tab-dropdown-select SelectOverlay Option.-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Disabled state (if needed in future) */
#tab-dropdown-select:disabled {
    opacity: 0.6;
    background: $panel-darken-1;
    color: $text-muted;  /* Using existing variable instead of $text-disabled */
}

/* Loading state (if needed for async operations) */
#tab-dropdown-select.-loading {
    color: $text-muted;
}

/* Textual CSS doesn't support transition animations */

/* Ensure dropdown doesn't interfere with main content */
#content {
    margin-top: 0;   /* No top margin needed - content flows after dropdown */
}

/* ===== MODULE: features/_watchlists.tcss ===== */
/* ========================================
 * FEATURES: Watchlists
 * ========================================
 * Styles for the WatchlistsCollectionsScreen dashboard and panes.
 * ======================================== */

/* Overview dashboard grid and cards.
 *
 * TASK-998, second finding. The UAT called these "seven empty bordered
 * cards" and read it as a first-run problem. It is not: they were empty in
 * EVERY state, populated or not, and had been since the dashboard shipped.
 * Measured at 160x42 with a source present:
 *
 *     #overview-total-sources  region=Region(height=1)  content=Size(height=0)
 *
 * Two compounding causes, one per rule below.
 *
 * The grid had no `height`, so it took `Grid`'s `1fr` default and was handed
 * six rows for three rows of cards plus two gutters -- about one row each.
 * `height: auto` sizes it to the cards instead, which is the only way a fixed
 * card height means anything.
 *
 * And `padding: 1` inside `height: 4` with a `round` border left ZERO content
 * rows: 4 - 2 (border) - 2 (padding) = 0. Even given its four rows the card
 * could not have painted the label or the number. The padding is now
 * horizontal only, so the two lines the card actually renders
 * ("Total sources" / the value) have exactly the two rows they need.
 *
 * This is the same family as TASK-995 and task-875 elsewhere on this screen:
 * a container too short for its children, where the border is the only thing
 * that survives.
 */
#watchlists-overview-grid {
    layout: grid;
    grid-size: 3;
    grid-gutter: 1;
    height: auto;
    margin: 1 0;
}

.overview-card {
    height: 4;
    padding: 0 1;
    background: $surface;
    border: round $surface-lighten-1;
    text-align: center;
    text-style: bold;
}

/* Failed runs table in overview */
#overview-failed-runs {
    height: 1fr;
    border: round $surface-lighten-1;
}

/* Empty state actions */
#wc-empty-actions {
    height: auto;
    margin: 1 0;
}

/* Section detail title */
#watchlists-detail-title {
    text-style: bold;
    color: $text;
}

/* Workbench: rails around a vertically stacked centre */
.watchlists-workbench {
    width: 100%;
    height: 1fr;
    min-height: 0;
}

.watchlists-region-left_rail {
    width: 28;
    min-width: 0;
    height: 100%;
    border: round $ds-grid-line;
}

/* Widened from 28 (Task 5): at 26 usable columns every Inspector action
 * label truncated -- "Stage Watchlists Cont", "Open current Watchlis",
 * "Console follow unavai" -- measured live at 235x52. 34 fits the longest
 * label ("Stage Watchlists Context in Console") close to on one line; the
 * `Button` rule below wraps as a fallback for whatever still does not fit,
 * rather than clipping it.
 *
 * Keeps its region border (Task 6, fix round 3): the ONE box per region is
 * drawn by the region wrapper, and the pane inside is stripped by ID below
 * (`#watchlists-inspector-pane`). See that rule for why the region, not the
 * pane, is the survivor.
 */
.watchlists-region-right_rail {
    width: 34;
    min-width: 0;
    height: 100%;
    border: round $ds-grid-line;
}

.watchlists-region-right_rail Button {
    width: 100%;
    text-wrap: wrap;
}

/* Collapsed breadcrumb levels (Task 5 fix round 2): muted and left-aligned
 * so they read as ancestry, not as an action -- distinct from the deepest
 * level's action buttons directly below them, which keep the default
 * centered/emphasized Button look.
 */
.inspector-breadcrumb {
    color: $ds-text-muted;
    text-align: left;
}

.watchlists-centre {
    width: 1fr;
    min-width: 0;
    height: 100%;
    min-height: 0;
}

/* FEEDS shared an equal `1fr` with ITEMS -- which hosts all six section
 * panes and their DataTables -- and CONTENT (Finding 5). At 160x42 that
 * handed FEEDS 11 rows for a handful of Static lines while ITEMS, doing all
 * the work, got the same 11. `height: auto` lets FEEDS take only what its
 * content needs so ITEMS/CONTENT split what is left.
 *
 * Task 5's premise that FEEDS "only ever hosts a short (<=5-line)
 * source-count summary" died in Task 3 when the section tab strip moved
 * into `_build_list_pane`: Task 7 gives FEEDS the real, scope-driven feeds
 * list, which can run to dozens of sources. Unbounded `height: auto` would
 * let that list grow without limit and push ITEMS/CONTENT clean out of the
 * viewport -- the opposite failure from the one this rebalance fixed.
 *
 * `max-height: 12` + `overflow-y: auto` caps it instead: FEEDS grows to fit
 * small lists, stops at the cap, and scrolls internally past it -- verified
 * scrollable, not clipped, with 40 synthetic rows
 * (Tests/Watchlists/test_watchlists_workbench.py).
 *
 * Fix round 1 shipped `max-height: 10`, one row BELOW the measured true
 * empty-state need of 11 (the tab strip, the "Sources" title, "No sources
 * yet.", and the Create/Import button row, inside the pane's own border) --
 * so even zero sources scrolled. That was wrong: a ceiling below the
 * content's own minimum is a clip with a scrollbar, not the intended
 * "grows to fit, caps, then scrolls" behaviour. Fix round 2 corrects it by
 * also giving ITEMS a bigger share than CONTENT (below: `2fr` vs `1fr`,
 * CONTENT is still the Phase-D placeholder stub and does not need equal
 * billing with the real list pane yet) rather than shrinking FEEDS further.
 *
 * With ITEMS/CONTENT at `2fr`/`1fr`, the invariant
 * (`test_watchlists_items_region_is_taller_than_feeds_region_when_expanded`,
 * unedited) needs `items > feeds` where, once FEEDS is forced to its cap by
 * overflowing content, `items ~= (budget - cap) * 2/3` for a fixed
 * `budget = feeds + items + content` (constant per viewport: measured 34
 * rows at the guard suite's 160x42, 44 at the app's real 235x52 -- both
 * confirmed by direct region-height measurement in a temporary pytest
 * addition, not assumed). Solving at 160x42: `items > cap` holds through
 * `cap = 13` (`items = 14`, margin 1) and breaks at `cap = 14`
 * (`items = 13 < feeds = 14`) -- confirmed empirically by forcing FEEDS's
 * real content to overflow 40 synthetic rows inside the full chrome-wrapped
 * screen (not just the standalone-workbench harness, which has a different,
 * more generous budget and would have understated how tight 160x42 actually
 * is).
 *
 * The cap is `12`, not that maximum of 13, deliberately. 13 holds only at
 * terminal height >= 42: at 160x41 the budget drops to 33 and 13 ties
 * (`items = 13`). 12 still gives `items = 14` at both budgets, so the
 * invariant survives a 41-row terminal -- a real size on a laptop with a
 * menu bar -- and survives any future change that consumes one more row
 * above the workbench. It clears the 11-row empty-state need with a row to
 * spare, so zero sources still does not scroll
 * (`Tests/UI/test_destination_visual_parity_correction.py::
 * test_watchlists_feeds_empty_state_fits_without_scrolling`). Taking the
 * maximum here would have bought one row of feed visibility for a boundary
 * that inverts on the next viewport down.
 *
 * Fix round 3 re-measured all of the above after moving the border from the
 * pane to the region (below): the numbers are unchanged, because the region
 * gains exactly the two rows the pane gives up. Re-swept at 160x42 with 40
 * sources: cap=12 -> items=14, cap=13 -> items=14, cap=14 -> items=13
 * (inverts). That constraint had no executable form until round 3 -- the
 * empty state never reaches the cap, so the older guard could not exercise
 * it. It is now pinned by
 * `test_watchlists_feeds_cap_keeps_items_taller_when_it_actually_binds`,
 * which forces the overflow inside the real screen; anything that consumes
 * another row above the workbench fails it rather than silently inverting.
 *
 * Keeps its region border (Task 6, fix round 3). Round 1 dropped it and let
 * the pane's own border stand instead, which was wrong three ways, all
 * measured: (a) region borders are `round` and pane borders are `solid`, so
 * the screen drew round corners on LEFT_RAIL/CONTENT and square corners on
 * FEEDS/ITEMS/RIGHT_RAIL; (b) `overflow-y: auto` scrolls this wrapper, and
 * the pane's border rows were *inside* the scrolled content -- at scroll top
 * the box's bottom edge was off-screen and at scroll end its top edge was,
 * so the one surviving border was an open-ended box; (c) the wrapper's
 * scrollbar painted in its own gutter, outside the box the pane drew. The
 * border belongs on the widget that scrolls.
 */
.watchlists-region-feeds {
    width: 100%;
    height: auto;
    min-height: 0;
    max-height: 12;
    overflow-y: auto;
    border: round $ds-grid-line;
}

/* Companion fix for the region title's removal above: `#watchlists-list-pane`
 * (FEEDS's supplied pane) is one of a shared group of destination panes
 * given `height: 100%` by ID in `components/_agentic_terminal.tcss` -- an ID
 * selector, so `.destination-workbench-pane`'s own `height: 100%` was never
 * actually the rule in effect here, and no class-based override here could
 * outrank it (verified empirically: a descendant selector combining
 * `.watchlists-region-feeds` with `.destination-workbench-pane`, strictly
 * higher specificity than the plain class rule, still lost to the ID rule
 * above). `100%` of a region sized `height: auto` (FEEDS is
 * the only region styled that way) is circular -- the parent's size is
 * supposed to come FROM this child -- and before this task that circularity
 * was masked by the region title `Static` acting as a plain `height: 1`
 * sibling. With the title gone (a real content pane no longer needs a
 * second, wrong heading), the sole remaining child inherited the ambiguity
 * outright and Textual collapsed it to unreadable. This ID selector, same
 * specificity as the shared rule but declared later in the bundle (features/
 * loads after components/ in build_css.py), wins on source order and lets
 * the pane size to its own content instead.
 */
#watchlists-list-pane {
    height: auto;
}

/* Exactly one box per region (Task 6, fix round 3): the *region wrapper*
 * draws it and the pane inside draws none, rather than the other way round.
 *
 * These three ids are declared in `components/_agentic_terminal.tcss` (the
 * shared destination-pane block, ~line 3544) with `border: solid
 * $ds-grid-line`. An ID selector here matches that block's specificity
 * exactly and wins on source order -- `features/` loads after `components/`
 * in `build_css.py` -- so this narrows to Watchlists' three panes and
 * touches none of the other destinations that share that block. (The same
 * lever the `#watchlists-list-pane` height rule above already uses; an
 * earlier round wrongly believed stripping the border required editing the
 * shared `.destination-workbench-pane` class and thus 13 other screens.)
 *
 * Suppressing the PANE rather than the REGION is what makes the five region
 * boxes uniformly `round`, keeps FEEDS's border fixed while its content
 * scrolls beneath it, and puts FEEDS's scrollbar inside the box that owns
 * it -- see the note on `.watchlists-region-feeds` above for the three
 * defects the other direction produced.
 */
#watchlists-list-pane,
#watchlists-detail-pane,
#watchlists-inspector-pane {
    border: none;
}

/* ITEMS keeps its region border (Task 6, fix round 3) -- the pane inside is
 * stripped by the rule above.
 *
 * `2fr` (fix round 2, human-authorised lever change): previously an equal
 * `1fr` with CONTENT, which is what forced FEEDS's cap down to a value
 * below its own empty-state need in round 1 -- with an equal split, ITEMS
 * only ever gets half of whatever FEEDS leaves, so at 160x42 (34-row
 * budget) FEEDS=11 left 23, split 11/12, tying ITEMS instead of exceeding
 * it. Giving ITEMS a bigger share fixes this at its root: CONTENT is still
 * an inert placeholder stub (Phase D replaces it with the real article
 * reader), so handing it equal billing with the real, working list pane
 * wastes rows today regardless of FEEDS's cap. See the derivation on
 * `.watchlists-region-feeds` above for the resulting cap value this split
 * makes possible.
 */
.watchlists-region-items {
    width: 100%;
    height: 2fr;
    min-height: 0;
    border: round $ds-grid-line;
}

.watchlists-region-content {
    width: 100%;
    height: 1fr;
    min-height: 0;
    border: round $ds-grid-line;
}

/* Solo must actually fill the centre (Task 6, fix round 3, Finding 3).
 *
 * `Z` (`action_solo_region` -> `RegionLayout.solo`) collapses the other two
 * centre regions to one-line headers. FEEDS is the only capped region, so a
 * soloed FEEDS stayed pinned at its `max-height` while the two collapsed
 * headers took one row each -- measured at 100x40 with 40 sources:
 * `feeds=13@y0, items=1@y13, content=1@y14`, leaving 25 of 40 centre rows
 * blank under a 13-row window scrolling 44 rows of content. Solo-ITEMS and
 * solo-CONTENT already filled correctly; only the capped region was
 * degenerate.
 *
 * The cap exists so a long feeds list cannot crowd ITEMS/CONTENT. When they
 * are collapsed there is nothing to crowd, so the cap is lifted (to the full
 * centre height) and the region takes the remaining space. `_region_widget`
 * adds `.watchlists-region-sole-centre` for exactly that state -- see its
 * comment for why it keys on "only expanded centre region" rather than on
 * `RegionLayout.solo_region`.
 *
 * Must stay AFTER `.watchlists-region-feeds` above: both are single-class
 * selectors, so this only wins the `height`/`max-height` tie on source
 * order.
 */
.watchlists-region-sole-centre {
    height: 1fr;
    max-height: 100%;
}

.watchlists-region-title {
    height: 1;
    text-style: bold;
    color: $ds-text-primary;
}

.watchlists-region-placeholder {
    color: $ds-text-muted;
}

/* Collapsed regions keep a one-line, focusable header so nothing vanishes.
 *
 * `width: 100%` is only correct when the header is a direct child of the
 * centre `Vertical` (`#wl-centre` / `.watchlists-centre`) -- there "100%"
 * means the centre column's own width. A rail header (LEFT_RAIL/RIGHT_RAIL)
 * is a direct child of the workbench `Horizontal` itself, so the same rule
 * there means the ENTIRE workbench width, pushing every region after it off
 * the right edge of the screen (Finding 1, fix round 2). Rails get a fixed
 * narrow width instead -- the same fixed-width-handle pattern
 * `console_rail_handle.py` uses for its collapsed rail buttons -- with
 * `min-width`/`max-width` pinned so Button's own `min-width: 16` default
 * (textual/widgets/_button.py) can't win the cascade and re-widen it.
 */
.watchlists-region-header {
    height: 1;
    min-height: 1;
    color: $ds-text-muted;
}

.watchlists-centre > .watchlists-region-header {
    width: 100%;
}

.watchlists-workbench > .watchlists-region-header {
    width: 16;
    min-width: 0;
    max-width: 16;
}

/* Section tab strip (Task 3, styled in Task 6 fix round 3 -- folded in by
 * the reviewer because the active section was invisible).
 *
 * `WatchlistsTabStrip.__init__` pins the strip to `height: 1`, and
 * `.watchlists-tab` carried no styling of its own, so the active tab picked
 * up the global `.is-active { border: round $ds-action-focus }`
 * (`components/_agentic_terminal.tcss`). A `round` border needs 2 lines
 * before it has a content line at all, so inside a 1-row strip the button
 * rendered as its own top border and nothing else: the active section's
 * LABEL never painted, which is the one thing the strip exists to show.
 *
 * Fixed here rather than in the shared sheet: that global rule is used by
 * many screens, and it is overridden the same way wherever a height-1
 * control meets it -- `#mcp-hub-rail Button.mcp-rail-row.is-active` and
 * `#mcp-mode-strip .mcp-mode-chip.is-active` in `_agentic_terminal.tcss`
 * both carry exactly this `border: none` + `text-style: bold underline`
 * pair. This mirrors the MCP mode strip, which is the same widget shape (a
 * one-row strip of mode chips), rather than inventing a new active look.
 */
.watchlists-tab-strip Button.watchlists-tab {
    width: auto;
    min-width: 10;
    height: 1;
    padding: 0 1;
    border: none;
}

.watchlists-tab-strip .watchlists-tab.is-active {
    border: none;
    text-style: bold underline;
}

/* Focus must not impersonate the active tab (bold underline above), and the
 * active tab must stay legible while focused -- same split the MCP mode
 * strip uses.
 */
.watchlists-tab-strip .watchlists-tab:focus,
.watchlists-tab-strip .watchlists-tab:hover:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
    outline: none;
    border: none;
}

.watchlists-tab-strip .watchlists-tab.is-active:focus,
.watchlists-tab-strip .watchlists-tab.is-active:hover:focus {
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: bold underline;
    outline: none;
    border: none;
}

/* Left-rail tree selection highlight (task-876).
 *
 * `WatchlistTree` rendered every node as a `compact=True` Button and never
 * read `tree_scope`, so nothing in the rail showed which node the centre
 * was scoped to -- the Feeds heading ("Feeds in Morning AI Brief (1)") was
 * the only feedback at all. This does not have the LabModeStrip/tab-strip
 * border-clipping defect -- `compact=True` already forces `border: none
 * !important` (Textual's own Button CSS), so the bundle's global
 * `.is-active { border: round $ds-action-focus; }` never gets a chance to
 * clip anything here. What it DOES need, same as every other `.is-active`
 * consumer in this file, is a legible look: the bare global rule only adds
 * `text-style: bold`, which is too subtle against three different node
 * classes sitting one row apart with no other affordance.
 *
 * Scoped with the `.watchlist-tree` ancestor class (matching the
 * `.watchlists-tab-strip .watchlists-tab.is-active` idiom just above)
 * purely for extra specificity headroom, not because it is required here.
 */
.watchlist-tree .watchlist-tree-root.is-active,
.watchlist-tree .watchlist-tree-watchlist.is-active,
.watchlist-tree .watchlist-tree-source.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

/* Focus must not impersonate the active node (bold, no underline above):
 * the app's global `Button:focus` rule (components/_buttons.tcss) grants
 * `bold underline` to ANY focused button, active or not -- exactly the
 * ambiguity the Watchlists tab strip and Lab/MCP mode strips already guard
 * against. Kept a flat "bold, no underline" for the active node whether or
 * not it also holds focus (rather than the tab-strip's flip to a second
 * palette) since a tree node has no separate "resting active" appearance to
 * preserve.
 */
.watchlist-tree .watchlist-tree-root.is-active:focus,
.watchlist-tree .watchlist-tree-watchlist.is-active:focus,
.watchlist-tree .watchlist-tree-source.is-active:focus,
.watchlist-tree .watchlist-tree-root.is-active:hover:focus,
.watchlist-tree .watchlist-tree-watchlist.is-active:hover:focus,
.watchlist-tree .watchlist-tree-source.is-active:hover:focus {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
    outline: none;
}

/* The tree's write verbs (TASK-895): two one-row strips above the roots.
 *
 * `min-width: 0` is the load-bearing declaration. Textual's own Button CSS
 * pins `min-width: 16` (textual/widgets/_button.py) and `compact=True` only
 * removes the border, not that floor -- so three action buttons in a
 * `Horizontal` would claim 48 columns inside a rail whose interior is 26,
 * and the labels would render clipped with an ellipsis. That is not merely
 * ugly: `Tests/UI/test_destination_visual_parity_correction.py::
 * test_watchlists_left_rail_is_labelled_when_expanded` fails on any `…` in
 * the composited rail, which is how this was caught.
 *
 * At `width: auto` + `padding: 0 1` the two rows measure 21 and 20 columns
 * against 26 available, so both fit whole with the rail at its current
 * width of 28.
 *
 * `height: 1` on the strip matches every other one-row control group on
 * this screen (`.destination-filter-strip`, the tab strip): the rail is a
 * plain `Vertical`, so a strip left at `auto` would size to the tallest
 * child rather than to a row.
 */
.watchlist-tree-actions {
    width: 100%;
    height: 1;
}

.watchlist-tree-actions Button.watchlist-tree-action {
    width: auto;
    min-width: 0;
    height: 1;
    padding: 0 1;
    border: none;
}

/* Why the verbs above are off, when they are. Muted like
 * `.watchlists-region-placeholder`, and `height: auto` so the reason wraps
 * to as many rows as the 26-column rail needs rather than being clipped to
 * one -- a stated reason that does not fit is not a stated reason.
 */
.watchlist-tree-actions-note {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
}

/* The two prompts the write verbs need (TASK-895).
 *
 * Centred and sized, unlike the older OPML dialogs in the same module,
 * which are unstyled `ModalScreen`s and therefore fill the terminal from
 * the top-left corner. Type selectors so this reaches the modal screen
 * itself (`align` has to be set on the parent of the box being centred),
 * and the id rules below size the box.
 */
WatchlistNameDialog,
WatchlistSourcePickerDialog {
    align: center middle;
}

#watchlist-name-dialog,
#watchlist-add-source-dialog {
    width: 60;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $surface;
    border: round $ds-grid-line;
}

/* The rejection reason for an empty or duplicate name. `height: auto` so a
 * long name's message wraps instead of being clipped -- the whole point of
 * this line is that the user can read why nothing happened.
 */
#watchlist-name-error {
    width: 100%;
    height: auto;
    color: $error;
}

#watchlist-add-source-options {
    width: 100%;
    height: auto;
    max-height: 16;
}

#watchlist-add-source-options Button {
    width: 100%;
    min-width: 0;
    height: 1;
    border: none;
    text-align: left;
}

/* One scoped source per row in FEEDS (Task 7, fix round 1, Finding 1).
 *
 * `height: 1` is the load-bearing part: `.watchlists-region-feeds` is capped
 * at `max-height: 12` and scrolls, and that cap was derived (see its own
 * comment above) against one-row children. A `Static` sizes to `auto` by
 * default, so a long feed name -- these come from remote titles and OPML
 * imports, not from us -- would wrap to two or three rows and silently eat
 * the region's budget. Pinning the row height keeps the list scanning as a
 * list and keeps the cap arithmetic true.
 *
 * `color` separates the rows from the scope heading above them
 * (`.watchlists-column-title`, bold primary) without a second border or an
 * indent, matching how `.watchlists-region-placeholder` sits under a title.
 */
.watchlist-feed-source-row {
    height: 1;
    width: 100%;
    color: $ds-text-muted;
}

/* TASK-998. The first-run panel that replaces the seven empty Overview cards.
 *
 * `height: auto` on both the wrapper and the body is the load-bearing pair.
 * `Vertical` defaults to `height: 1fr`, so the wrapper would claim the whole
 * region and re-create the "large box containing nothing" this task exists to
 * remove; and a `Static` left at its default single row would clip multi-
 * paragraph copy to its first line, which is the same class of defect as
 * TASK-995 one region over. `text-wrap: wrap` because this copy has to
 * survive the centre pane at 160 columns as well as at 235.
 *
 * No border. The region wrapper (`.watchlists-region-items`) already draws
 * one box, and Task 6's rule for this screen is one border and one heading
 * per region -- an inner box here would be the doubled-chrome defect that
 * task removed.
 */
#overview-first-run {
    width: 100%;
    height: auto;
    padding: 1 0;
}

.watchlists-first-run-title {
    width: 100%;
    height: auto;
    text-style: bold;
    color: $ds-text-primary;
}

.watchlists-first-run-body {
    width: 100%;
    height: auto;
    padding: 1 0 0 0;
    text-wrap: wrap;
    color: $ds-text-muted;
}

/* The Inspector's own first-run line, muted the same way, so the rail reads
 * as one voice with `.watchlists-region-placeholder` rather than as an
 * alert.
 */
#inspector-first-run-hint {
    width: 100%;
    height: auto;
    text-wrap: wrap;
    color: $ds-text-muted;
}

/* TASK-997. The expand chevron drew on its own indented line ABOVE the
 * watchlist name:
 *
 *     │ Unassigned  0            │
 *     │       ▸                  │
 *     │ Morning AI Brief  0      │
 *
 * `_watchlist_node` now wraps the two buttons in this row so they share a
 * line. `height: 1` is what makes the row a row: `Horizontal` defaults to
 * `height: 1fr`, which inside the rail's `Vertical` would let one watchlist
 * claim whatever vertical space the tree had left.
 *
 * `min-width: 0` on the chevron is the other half of the original defect and
 * is load-bearing, exactly as it is for `.watchlist-tree-action` above:
 * Textual's Button CSS pins `min-width: 16` and `compact=True` removes only
 * the border, not that floor. A one-glyph chevron was therefore SIXTEEN
 * columns wide with the glyph centred in them -- which is why it painted
 * seven columns in from the left edge of a 26-column rail, reading as a
 * stray mark rather than as this watchlist's control.
 *
 * The name button is left at its natural `width: auto` rather than given
 * `1fr`: at `1fr` a name longer than the remaining rail would be ellipsized
 * (`test_watchlists_left_rail_is_labelled_when_expanded` fails on any `…`),
 * and the `is-active` highlight would stretch the full rail width instead of
 * hugging the label the way the sibling root nodes do.
 *
 * `width: 3` and not `2`, which is the tighter look this was first written
 * for: Textual's `Button` reserves a column each side via `line-pad: 1`, so
 * a 2-column button has ZERO content columns and Rich raises
 * `ValueError: range() arg 3 must not be zero` while wrapping the glyph. The
 * obvious `line-pad: 0` is not available -- Textual's integer property parser
 * rejects a literal 0 for it (`_process_integer` errors on `value == 0`), so
 * the stylesheet fails to parse and every rule after it is lost. 3 is the
 * narrowest width that renders.
 *
 * The source rows deliberately get NO rule: their two-space label indent
 * plus Textual's `min-width: 16` centring already places them past the
 * watchlist name (name at column 5, source at column 7 in a 26-column rail),
 * so the nesting reads without adding a margin that would only move with the
 * chevron's width.
 */
.watchlist-tree .watchlist-tree-row {
    width: 100%;
    height: 1;
}

.watchlist-tree Button.watchlist-tree-expander {
    width: 3;
    min-width: 0;
    height: 1;
    padding: 0;
    border: none;
}

/* TASK-897. `#sources-toolbar` is a bare `Vertical` wrapping several
 * `.destination-filter-strip` rows, and had no height rule anywhere -- so it
 * inherited Textual's `height: 1fr` default and its size came from whatever
 * its sibling `#sources-table` was not using, rather than from its own
 * controls.
 *
 * With rows in the table that looked fine (measured 160x42: toolbar 3, table
 * 13). With an EMPTY table -- the first thing a new user sees -- the table
 * collapsed to 1 row and the toolbar swallowed the rest: toolbar 15 of a
 * 16-row pane, and 25 of 26 at 235x52. Growing the terminal did not help,
 * because `1fr` grows with it.
 *
 * The four sibling toolbars (runs/items/rules/notifications) are `Horizontal`
 * with `.destination-filter-strip`, which pins `height: 1` in
 * layout/_panes.tcss, so they were never affected. This one is the only
 * wrapper, and so the only one that needed its own rule.
 */
#sources-toolbar {
    height: auto;
}

/* TASK-995. The Sources toolbar rendered as one bare `▊▔▔▔` bar with no
 * controls at all, which blocked the entire new-user path: create a
 * watchlist, press "Create source", and there is no visible way to add one.
 *
 * Two independent causes compounded, and both are fixed here.
 *
 * 1. HEIGHT. `.destination-filter-strip` is `height: 1`
 *    (layout/_panes.tcss) but a bordered `Input`/`Select` is three rows, so
 *    only the top border row survived. The widgets now pass `compact=True`
 *    (sources_pane.py / items_pane.py / watchlists_collections_screen.py),
 *    Textual's own supported one-row form -- the same idiom this codebase
 *    already uses ~300 times, including for `Input`/`Select` in
 *    mcp_server_mutations.py. That is done in Python rather than by
 *    un-pinning the strip: `.destination-filter-strip` is shared chrome
 *    (schedules, workflows and four sibling Watchlists toolbars), and the
 *    one-row strip is this screen's design language -- the tab strip, the
 *    tree action row and the header bar are all one row. Growing the strip
 *    to three rows instead would have cost the Sources table a quarter of
 *    its rows at 160x42, re-opening TASK-897.
 *
 * 2. WIDTH, which the strip's height alone would not have fixed. Nothing
 *    sized these controls, so `Input`'s Textual default (`width: 100%`) and
 *    `_conversations.tcss`'s bare global `Select { width: 100%; }` each
 *    claimed the FULL strip: measured at 160x42 the four of them stacked to
 *    x=31,122,213,304 in a pane 93 columns wide, putting `New Source` at
 *    x=395 -- 300 columns off the right edge of a 160-column terminal. The
 *    explicit widths below are what keeps every control on screen.
 *
 *    These must live in the bundle, not in a widget's `DEFAULT_CSS`:
 *    Textual always ranks a CSS_PATH rule above any `DEFAULT_CSS` rule
 *    regardless of specificity, so that bare `Select { width: 100% }` beats
 *    DEFAULT_CSS every time. Same lesson as `#mcp-tools-filter-server-slot
 *    Select` and `#mcp-audit-filter-*` in components/_agentic_terminal.tcss.
 *    `margin: 0` is part of that override too -- the same global rule adds
 *    `margin-bottom: 1`, which would push a one-row Select to two rows.
 *
 * Widths are sized to their longest option label plus the dropdown arrow
 * ("All statuses" 12, "Playlist"/"Inactive" 8), leaving the search box the
 * remainder: 19 columns at 160x42 and 94 at 235x52.
 */
#sources-toolbar Input,
#sources-toolbar Select,
#items-toolbar Input,
#items-toolbar Select,
#watchlists-header-bar Select {
    height: 1;
    min-height: 1;
    margin: 0;
}

#sources-search-input {
    width: 1fr;
    min-width: 12;
}

#sources-type-select {
    width: 12;
}

#sources-status-filter {
    width: 16;
}

#sources-active-filter {
    width: 12;
}

#sources-tags-filter {
    width: 1fr;
    min-width: 12;
}

/* TASK-1035. The create-source form had no rule anywhere, so it took
 * Textual's defaults for its container and painted like an unfinished
 * sketch: `Create` on row 40 and `Cancel` on row 43 with blank rows between
 * them, and `#sources-table` squeezed to a single row underneath.
 *
 * The container is now a `Vertical` rather than a bare `Grid` (see
 * `sources_pane.py`), which fixes the row spread; `height: auto` is what
 * stops it then claiming `1fr` of the pane and starving the table a second
 * way -- the same defect and the same one-line fix as `#sources-toolbar`
 * immediately above (TASK-897).
 */
#sources-create-form {
    height: auto;
    width: 100%;
}

/* Type + Active share one row. Two things are pinned here.
 *
 * The `Active` label was `width: 1fr` at Textual's default and claimed the
 * whole 168-column row, pushing the `Switch` to x=198 -- one column past
 * the pane's right edge at 235x52, so the only control for "is this source
 * active" was neither visible nor clickable.
 *
 * `margin: 0` on the Select undoes the bare global `Select { width: 100%;
 * margin-bottom: 1; }` in features/_conversations.tcss, which added a blank
 * row under the row and pushed the fields below it further down a pane that
 * has no rows to spare. Same override, same reason, as the toolbar block
 * above.
 */
#sources-create-form .sources-create-type-row {
    width: 100%;
    height: 3;
}

#sources-create-form #sources-create-type {
    width: 1fr;
    margin: 0;
}

#sources-create-form .sources-create-active-label {
    width: auto;
    height: 3;
    content-align: left middle;
    padding: 0 1;
}

/* `.dialog-buttons` (features/_media.tcss) supplies the side-by-side pair
 * itself -- `layout: horizontal`, and `margin: 0 1; min-width: 12` on each
 * Button -- so this form and `WatchlistNameDialog` pair their Create/Cancel
 * the same way rather than stacking them.
 *
 * Two properties are deliberately not inherited. The dialog centres its
 * pair inside a narrow modal; this form is inline and 168 columns wide,
 * where a centred pair would float away from the fields it belongs to. And
 * the dialog's `height: 3` would put the pair a row past the bottom of a
 * 16-row Sources pane at 160x42; one row is also what every other button on
 * this screen uses (`New Source`, `Preview`, `Import OPML`, the tree's
 * `New`), so the pair reads as part of the screen rather than a modal
 * dropped into it.
 */
#sources-create-form .sources-create-buttons {
    align: left middle;
    width: 100%;
    height: 1;
}

#items-search-input {
    width: 1fr;
    min-width: 12;
}

#items-status-select {
    width: 16;
}

#watchlists-backend-select {
    width: 12;
}

/* ===== MODULE: features/_lab.tcss ===== */
/* Lab destination (Models | Speech | Evals).
 *
 * These rules MUST live app-tier, not in LabModeStrip.DEFAULT_CSS: the
 * bundle's global `.is-active` rule (border: round) outranks DEFAULT_CSS
 * regardless of specificity, so a widget-tier override silently loses and
 * the active chip's label is clipped by the one-row strip. Mirrors
 * `.personas-mode-chip.is-active` and `#mcp-mode-strip Button.mcp-mode-chip`.
 *
 * This copy is authoritative at runtime. `LabModeStrip.DEFAULT_CSS`
 * (tldw_chatbook/UI/Screens/lab_mode_strip.py) keeps a second, lower-
 * specificity copy of `.lab-mode-chip` rules purely as a fallback for
 * harness apps that mount the strip without loading this bundle. The two
 * have already diverged (that copy adds min-height; this one adds
 * background/color) -- keep them in lockstep when either changes.
 */

#lab-mode-strip Button.lab-mode-chip {
    width: auto;
    min-width: 0;
    height: 1;
    padding: 0 1;
    border: none;
}

#lab-mode-strip .lab-mode-chip.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

#lab-mode-strip .lab-mode-chip.is-active:focus,
#lab-mode-strip .lab-mode-chip.is-active:hover:focus {
    outline: none;
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* A focused non-active chip must not impersonate the active one. The app's
 * global Button:focus grants bold underline, which is exactly the active
 * chip's signature -- so a keyboard user tabbing the strip would see two
 * chips read as active. Underline stays exclusive to .is-active. Mirrors
 * the same guard MCP applies to its mode chips. */
#lab-mode-strip .lab-mode-chip:focus,
#lab-mode-strip .lab-mode-chip:hover:focus {
    text-style: bold;
    outline: none;
}

/* --- Lab workbench ------------------------------------------------------
 *
 * Region widths are declared here rather than inline so the layout contract
 * is inspectable in one place.
 *
 * The rail is fractional, not fixed. It was `width/min-width/max-width: 26`,
 * which measured 26 cells at 80, 120 and 200 columns alike -- 32.5% of an
 * 80-column terminal for a list whose longest label is 14 characters, while
 * every sibling rail in the app is fractional (`#mcp-hub-rail` is
 * `3fr` with `min-width: 24`). The bounds keep the labels intact at 80
 * columns without letting the rail sprawl at 200.
 *
 * The 24 floor is measured, not guessed: at 20 the longest Models label
 * ("Download Models") rendered as "Download" -- Textual drops the whole
 * overflowing word rather than clipping mid-word, so the truncation is
 * silent and total. `Tests/UI/test_lab_workbench.py` pins it.
 */

.lab-workbench {
    width: 100%;
    height: 1fr;
    min-height: 0;
}

#lab-rail {
    width: 1fr;
    min-width: 24;
    max-width: 32;
    height: 100%;
    min-height: 0;
    padding: 0;
    background: $ds-surface-panel;
    border-right: solid $ds-column-line;
}

#lab-body {
    width: 4fr;
    min-width: 0;
    height: 100%;
    min-height: 0;
    padding: 0 1;
}

#lab-inspector {
    width: 30;
    min-width: 30;
    max-width: 30;
    height: 100%;
    min-height: 0;
}

/* Rail rows.
 *
 * The `border: none` is REQUIRED, not cosmetic. The bundle declares an
 * unscoped `.is-active { border: round $ds-action-focus; }` earlier in this
 * sheet, and app-tier CSS beats widget DEFAULT_CSS regardless of
 * specificity. A height-1 row that picks up that border renders two rows
 * tall -- a half-bordered artifact that displaces every row below it.
 * `#mcp-hub-rail Button.mcp-rail-row.is-active` carries the same override
 * for the same reason.
 */
.lab-rail Button.lab-rail-row {
    width: 100%;
    height: 1;
    min-height: 1;
    padding: 0 1 0 2;
    border: none;
    /* `text-align` alone does NOT left-align a one-line Button label --
       `content-align` positions the label box itself and defaults to
       centered, so without this the nine provider rows each sat at a
       different indent and the list had no shared left edge to scan down.
       Same pairing as `Button.mcp-rail-row`, `Button.mcp-inspector-action`
       and `Button.mcp-callout`, which each hit this and fixed it the same
       way. */
    text-align: left;
    content-align: left middle;
}

/* The active row is a solid fill plus an accent bar; a merely focused row
 * gets underline only (below). They must not converge: the app's global
 * `Button:focus` grants bold, and the old active style was `$ds-focus-bg` --
 * measured identical to the focus background, so a focused row and the
 * active row rendered the same colour and two rows read as selected at
 * once. The mode strip 60 lines above already guards against exactly this.
 *
 * `border: none` first is REQUIRED, not cosmetic: the bundle declares an
 * unscoped `.is-active { border: round $ds-action-focus; }` earlier in this
 * sheet, and app-tier CSS beats widget DEFAULT_CSS regardless of
 * specificity. A height-1 row that picks up that round border renders two
 * rows tall. `border-left` alone consumes a column, never a row, so the
 * accent bar is safe on a one-line button.
 */
.lab-rail .lab-rail-row.is-active {
    border: none;
    border-left: thick $accent;
    background: $primary;
    color: $ds-text-primary;
    text-style: bold;
}

.lab-rail .lab-rail-row.is-active:focus,
.lab-rail .lab-rail-row.is-active:hover:focus {
    outline: none;
    border: none;
    border-left: thick $accent;
    background: $primary;
    color: $ds-text-primary;
    text-style: bold;
}

.lab-rail .lab-rail-row:focus,
.lab-rail .lab-rail-row:hover:focus {
    outline: none;
    background: $ds-surface-raised;
    text-style: underline;
}

/* Section headings carry the accent so the rail has a scannable hierarchy;
 * unstyled they forced the list to be read line by line to find where
 * "Local servers" ended and "Models" began. `margin-top` opens the gap
 * between groups -- the second heading otherwise butts against the last row
 * of the first group. */
.lab-rail-section {
    height: 1;
    min-height: 1;
    padding: 0 1;
    margin-top: 1;
    color: $accent;
    text-style: bold;
}

/* --- Header row ---------------------------------------------------------
 *
 * One row carrying title, subtitle, this mode's status chips, and the
 * readiness badge -- the same shape Console collapses its own
 * DestinationHeader into (`#console-workbench-header.console-header-inline`,
 * height 1, border none).
 *
 * Lab previously rendered the stacked `.workbench-header` block instead: a
 * bordered 5 rows, plus a conditional chip row beneath it. That is the only
 * 5-row destination header in the app -- the other eleven destinations size
 * their title with `$ds-destination-header-height` (= 1). The eight rows it
 * cost were the eight that pushed Models' `Start Server` button past the
 * bottom of a 40-row terminal.
 *
 * `.lab-header-inline` is a class, not an id, so all three Lab modes can
 * carry it -- Speech and Evals compose their own DestinationHeader rather
 * than going through this frame, and if only Models were collapsed the mode
 * strip would sit at y=4 on Models and y=8 on the other two, jumping four
 * rows on every switch (measured). It ties `.workbench-header` on
 * specificity (0,1,0) and wins on source order: features/_lab.tcss is
 * emitted after components/ in CSS_MODULES. The descendant rules below are
 * (0,2,0), which beats the density rule that hides the subtitle in compact
 * mode -- the row is one line at any density, so hiding the subtitle would
 * only waste horizontal space.
 */
#lab-header-row {
    height: 1;
    min-height: 1;
    padding: 0 1;
    background: $ds-surface-panel;
}

.lab-header-inline {
    layout: horizontal;
    width: 1fr;
    height: 1;
    min-height: 1;
    padding: 0 1;
    margin: 0;
    border: none;
    background: $ds-surface-panel;
}

/* Inside the frame's header row the padding is already supplied by
   `#lab-header-row`; doubling it would indent Models' title two cells
   further than Speech's. */
#lab-header-row .lab-header-inline {
    padding: 0;
}

.lab-header-inline .workbench-header-title {
    width: auto;
    height: 1;
    min-height: 1;
}

.lab-header-inline .workbench-header-subtitle {
    display: block;
    width: 1fr;
    height: 1;
    min-height: 1;
    margin-left: 2;
}

.lab-header-inline .workbench-header-status {
    width: auto;
    height: 1;
    min-height: 1;
    margin-left: 2;
}

/* The chip shares the header's single row with the title, subtitle and
 * readiness badge. `width: auto` means a mode with long chip copy claims
 * whatever it wants and starves the 1fr header beside it -- Speech's
 * capability chip once rendered the full recovery sentence here and
 * collapsed `#lab-destination-header` to ONE cell, truncating the title to
 * "S". Chip copy stays short and the cap makes that structural rather than
 * a convention each mode has to remember. */
.lab-status-chip {
    width: auto;
    max-width: 40%;
    height: 1;
    padding: 0 1;
    color: $ds-text-muted;
    text-overflow: ellipsis;
}

/* The title must survive whatever the chip does. */
.lab-header-inline .workbench-header-title {
    min-width: 6;
}

/* Rail width is per-mode, because label length is per-mode. The shared floor
 * fits Models (longest: "Download Models", 15 cells). Speech's rows carry
 * double-width emoji -- "🔤 Speech Recognition" measures 21 cells, and at the
 * shared floor Textual dropped the overflowing word entirely, rendering
 * "🔤 Speech" and a bare "📚". Measured, not estimated. */
.lab-mode-stts #lab-rail {
    min-width: 28;
    max-width: 34;
}

/* Evals' rail is a library, not a menu: section headings carry counts and
 * their empty states put two buttons side by side ("+ New dataset" /
 * "Import…"). At the shared floor those wrapped instead. */
.lab-mode-evals #lab-rail {
    min-width: 30;
    max-width: 38;
}

/* --- Evals panes inside the frame's regions -----------------------------
 *
 * `#evals-library-pane, #evals-detail-pane, #evals-inspector-pane` carry
 * `border: solid $ds-grid-line` + a panel background from the hand-rolled
 * three-pane workbench they used to live in
 * (components/_agentic_terminal.tcss). Inside the frame those borders are
 * doubled -- `#lab-rail` already draws the column rule -- and each one costs
 * two columns of content width, which truncated the rail's own
 * "Create sample bench" button.
 *
 * Two ids each, so these beat that grouped one-id rule, and features/ is
 * emitted after components/ regardless. The panes keep their ids: those are
 * their stable selectors and several tests query them.
 */
#lab-rail #evals-library-pane,
#lab-body #evals-detail-pane,
#lab-inspector #evals-inspector-pane {
    border: none;
    background: transparent;
    min-height: 0;
    padding: 0;
}

/* `#lab-rail` and `#lab-inspector` are VerticalScroll containers that
 * already hold a collapse header row. A pane at `height: 100%` there makes
 * the scrollable content header + 100% -- measured `virtual_size` 35 against
 * a `container_size` of 34, so both rails were permanently scrollable by one
 * row and the collapse header could be scrolled out of reach, even with
 * short content. `auto` lets the pane size to its content and leaves
 * overflow to the scroll container, which is its job.
 *
 * This is the same mistake as `#evals-results-grid`'s `height: 100%` fixed
 * in this branch: 100% is the full parent height and ignores siblings.
 * Caught by Qodo on PR #1010. */
#lab-rail #evals-library-pane,
#lab-inspector #evals-inspector-pane {
    height: auto;
}

/* `#lab-body` is a plain Vertical with no header sibling, so the detail
 * pane genuinely should fill it. */
#lab-body #evals-detail-pane {
    height: 100%;
}

/* "No datasets" offers authoring and import together. In the old three-pane
 * workbench that pane was ~53 columns and the two buttons sat side by side;
 * in the frame's rail they need 34 and get 28, so "Import…" was clipped off
 * the right edge -- present in the DOM, unreachable on screen. Stacking
 * keeps both offered, which is what the design spec's empty-state table
 * actually asks for; only the axis changes. */
#lab-rail .evals-rail-empty-actions {
    layout: vertical;
    height: auto;
}

#lab-rail .evals-rail-empty-actions Button {
    width: 100%;
}

/* ===== MODULE: features/config_search.tcss ===== */
/* config_search.tcss */
/* Styling for configuration file search functionality */

/* Search container */
.config-search-container {
    width: 100%;
    margin-bottom: 1;
    padding: 1;
    background: $panel;
    border: solid $primary;
}

/* Search input */
.config-search-input {
    width: 100%;
    margin-bottom: 1;
}

/* Search results collapsible */
.config-search-results {
    width: 100%;
    margin-bottom: 1;
}

.config-search-results Collapsible > Contents {
    max-height: 20;
    overflow-y: auto;
}

/* Results list */
.config-results-list {
    width: 100%;
    height: auto;
    max-height: 20;
    background: $surface;
}

/* Individual search result item */
.config-search-result-item {
    width: 100%;
    padding: 1;
    margin-bottom: 0;
}

.config-search-result-item:hover {
    background: $boost;
}

/* Result info section */
.result-info {
    width: 1fr;
    padding-right: 1;
}

.result-path {
    text-style: bold;
    color: $primary;
}

.result-value {
    color: $text;
    margin-top: 0;
}

.result-context {
    color: $text-muted;
    text-style: italic;
    margin-top: 0;
}

/* Result action buttons */
.result-actions {
    dock: right;
    width: auto;
    height: 3;
    align: center middle;
}

.result-goto-btn {
    margin-right: 1;
    min-width: 8;
}

.result-edit-btn {
    min-width: 8;
}

/* Highlight matches in search results */
ConfigSearchResult.-highlight {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

/* Ensure the config editor has proper spacing when search is shown */
#config-text-area {
    height: 1fr;
    min-height: 20;
}

/* Highlight effect for found UI elements */
.search-highlight {
    background: $warning 30%;
    border: solid $warning;
    border-bottom: solid $warning;
}

Input.search-highlight:focus,
TextArea.search-highlight:focus {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    outline: none;
}

Select.search-highlight {
    background: $warning 30%;
}

Checkbox.search-highlight {
    color: $warning;
}

TextArea.search-highlight {
    border: solid $warning;
    border-bottom: solid $warning;
}

/* ===== MODULE: features/feature_alerts.tcss ===== */
/* feature_alerts.tcss */
/* Styling for feature availability alerts */

FeatureNotAvailableDialog {
    width: 70;
    height: auto;
    background: $panel;
    border: thick $warning;
    align: center middle;
    layer: dialog;
    padding: 2 4;
    opacity: 0.98;
}

FeatureNotAvailableDialog > Vertical {
    width: 100%;
    height: auto;
}

FeatureNotAvailableDialog .dialog-title {
    text-align: center;
    color: $warning;
    text-style: bold;
    margin-bottom: 1;
    padding: 1 0;
}

FeatureNotAvailableDialog .dialog-message {
    margin-bottom: 1;
    text-align: center;
    color: $text;
}

FeatureNotAvailableDialog .install-command {
    background: $boost;
    padding: 1 2;
    margin: 1 0;
    border: solid $primary;
    text-align: center;
    color: $text-muted;
}

FeatureNotAvailableDialog .button-container {
    dock: bottom;
    align: center middle;
    height: 3;
    margin-top: 1;
}

FeatureNotAvailableDialog Button {
    margin: 0 1;
    min-width: 12;
}

/* ===== MODULE: utilities/_helpers.tcss ===== */
/* ========================================
 * UTILITIES: Helpers
 * ======================================== 
 * Utility classes for common patterns
 * ======================================== */

/* Visibility utilities */
.hidden {
    display: none !important;
}

/* ===== MODULE: utilities/_states.tcss ===== */
/* ========================================
 * UTILITIES: States
 * ======================================== 
 * State modifiers: disabled, hidden, active, etc.
 * ======================================== */

/* --- Utility/Not-Tab Specific --- */

.disabled {
    /* Make the button semi-transparent. This is the most effective way
       to show it's inactive and works just like web CSS. */
    opacity: 0.6;

    /* To achieve a "grayscale" effect, we manually set the colors
       to be less vibrant, using Textual's design tokens for theming. */
    background: $panel-darken-2;
    color: $text-muted;

    /* You can also ensure the border is muted. */
    border: round $primary-darken-2;
}
/* --- End of Utility/Not-Tab Specific --- */

/* ===== MODULE: utilities/_overrides.tcss ===== */
/* ========================================
 * UTILITIES: Overrides
 * ======================================== 
 * Important overrides and edge case fixes
 * ======================================== */

/* TASK-382 / TASK-386: opaque, bordered tooltip surface.
 *
 * Textual's default Tooltip is borderless and fills with $panel, so over the
 * Console header or a provider-test result line it reads as bare text bleeding
 * into the widget underneath (interleaved fragments like "control actions.").
 * A visible border plus an explicit opaque fill turns it into a distinct
 * surface that fully COVERS what it overlaps instead of garbling it. */
Tooltip {
    background: $panel;
    color: $text;
    border: round $primary;
    padding: 0 1;
    max-width: 60;
}
