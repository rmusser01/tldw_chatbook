/* TASK-19010: lasting Notes sync inherits the retained Neon Workbench canvas.
   Authority/status and the nearest valid action stay fixed; setup, review, and
   recovery effects share one bounded scroll owner at the 60x20 floor. */
.library-notes-lasting-sync-canvas {
    width: 100%;
    height: 1fr;
    min-height: 0;
    padding: 0 1;
    overflow: hidden;
}

#notes-sync-authority,
#notes-sync-roots-authority,
.library-notes-lasting-status {
    width: 100%;
    height: auto;
    min-height: 1;
    max-height: 2;
    text-wrap: wrap;
    text-overflow: clip;
}

#notes-sync-body,
#notes-sync-roots-body {
    width: 100%;
    height: 1fr;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-gutter: stable;
}

#notes-sync-pinned-actions,
#notes-sync-roots-pinned-actions {
    width: 100%;
    height: auto;
    min-height: 1;
    max-height: 3;
    background: $surface-darken-1;
}

#notes-sync-fold-hint,
#notes-sync-disconnect-copy,
.library-disabled-reason {
    width: 100%;
    height: auto;
    min-height: 1;
    max-height: 2;
    color: $text-muted;
    background: $surface-darken-1;
    text-wrap: wrap;
    text-overflow: clip;
}

.library-notes-sync-review-row,
.library-notes-sync-root-row,
.library-notes-sync-root-actions {
    width: 100%;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.library-notes-sync-attention-actions {
    width: 100%;
    height: auto;
    min-height: 1;
}

.library-notes-sync-root-status {
    color: $text-muted;
}

.library-notes-sync-root-actions > Button {
    width: 100%;
}

.library-notes-sync-attention-actions > Button {
    width: 100%;
}

#library-canvas.library-notes-compact .library-notes-lasting-sync-canvas {
    padding: 0;
}

#library-canvas.library-notes-compact #notes-sync-authority,
#library-canvas.library-notes-compact #notes-sync-roots-authority,
#library-canvas.library-notes-compact .library-notes-lasting-status,
#library-canvas.library-notes-compact #notes-sync-fold-hint {
    height: 1;
    min-height: 1;
    max-height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* ===== MODULE: components/_workbench.tcss ===== */
/* ========================================
 * COMPONENTS: Workbench
 * ========================================
 * Shared destination workbench frame, command, mode, recovery, pane,
 * state, and density contracts.
 * ======================================== */

.workbench-frame {
    width: 100%;
    height: 100%;
    min-height: 0;
    layout: vertical;
    overflow: hidden;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.workbench-header {
    height: auto;
    min-height: 2;
    padding: 0 1;
    margin: 0;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.workbench-header-title {
    height: 1;
    min-height: 1;
    text-style: bold;
}

.workbench-header-subtitle {
    height: 1;
    min-height: 1;
    color: $ds-text-muted;
}

.workbench-header.has-empty-subtitle .workbench-header-subtitle {
    display: none;
}

.workbench-header-status {
    width: auto;
    height: 1;
    min-height: 1;
}

/* task-523: red cue when the Roleplay Console handoff provider is unready.
   `status-blocked` lands on the DestinationHeader (#personas-header); the
   badge word is the child #workbench-header-status (also .ds-status-badge,
   whose app-tier `color: $ds-text-primary` this id+class+descendant selector
   outranks so the "Blocked" word actually turns red). */
#personas-header.status-blocked .workbench-header-status {
    color: $ds-status-blocked;
}

.workbench-command-strip,
.workbench-mode-strip {
    height: 1;
    min-height: 1;
    padding: 0 1;
    margin: 0;
    layout: horizontal;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.workbench-action,
.workbench-mode {
    width: auto;
    height: 1;
    min-height: 1;
    margin: 0 1 0 0;
}

.workbench-action {
    padding: 0 1;
}

.workbench-action.is-primary {
    text-style: bold;
}

/* TASK-1801: this bar stacked THREE dimmers and measured 1.45:1 live --
   `$ds-text-disabled` is an alpha token (~38%), `.is-disabled` adds
   `opacity: 0.55`, and Textual's Button:disabled adds `text-style: bold dim`
   plus `color: auto 50%`. None of that is visible from any single rule.

   Note the class: this bar uses `is-disabled`, NOT `console-action-disabled`.
   An earlier edit to the latter measured no change at all and was reverted
   rather than shipped unverified.

   Neutralising the opacity layer and stating the colour bright enough to
   survive Textual's halving (which `text-style: none` does NOT clear --
   verified by measuring the running app) gets this to ~3.6:1. This bar's
   background is lighter than the composer menu's near-black, so 4.5:1 is
   not reachable while `dim` still halves the result; DESIGN.md states 3:1
   as the floor for disabled controls for exactly this reason. */
.workbench-action.is-disabled {
    color: rgb(245,245,245);
    opacity: 1;
    text-style: none;
}

.workbench-mode {
    padding: 0 1;
    color: $ds-text-muted;
}

.workbench-mode.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

.workbench-recovery-callout {
    height: auto;
    min-height: 0;
    padding: 0 1;
    margin: 0;
    border: solid $ds-status-warning;
    background: $ds-status-warning 10%;
    color: $ds-text-primary;
}

.workbench-recovery-callout.is-hidden {
    display: none;
}

.workbench-recovery-title {
    height: 1;
    min-height: 1;
    text-style: bold;
}

.workbench-recovery-body {
    height: auto;
    min-height: 1;
    color: $ds-text-primary;
}

.workbench-recovery-action {
    width: auto;
    height: 1;
    min-height: 1;
    margin: 1 0 0 0;
}

.workbench-pane-region {
    height: 1fr;
    min-height: 0;
    layout: horizontal;
    overflow: hidden;
}

.workbench-pane {
    width: 1fr;
    height: 1fr;
    min-width: 0;
    min-height: 0;
    padding: 0 1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

.workbench-pane.is-collapsed {
    width: 3;
    min-width: 3;
}

.workbench-pane-title,
.workbench-pane-status {
    height: 1;
    min-height: 1;
}

.workbench-pane-title {
    text-style: bold;
}

.workbench-state-block {
    height: 1;
    min-height: 1;
    padding: 0 1;
    layout: horizontal;
    background: $ds-surface-raised;
    color: $ds-text-muted;
}

.workbench-state-route,
.workbench-state-density {
    width: auto;
    height: 1;
    min-height: 1;
    margin: 0 1 0 0;
}

.workbench-frame .status-ready {
    border-title-color: $ds-status-ready;
}

.workbench-frame .status-running,
.workbench-frame .status-loading {
    border-title-color: $ds-status-running;
}

.workbench-frame .status-blocked,
.workbench-frame .status-error {
    border-title-color: $ds-status-error;
}

.workbench-frame .status-paused,
.workbench-frame .status-empty {
    border-title-color: $ds-status-warning;
}

.density-normal .workbench-header {
    min-height: 2;
    padding: 0 1;
}

.density-normal .workbench-pane {
    padding: 1;
}

.density-compact .workbench-header {
    min-height: 1;
    padding: 0 1;
}

.density-compact .workbench-header-subtitle {
    display: none;
}

.density-compact .workbench-pane {
    padding: 0 1;
}

/* task-1232 round 1 (fleet-UX expert review F2, Critical fix): the F1 help
   overlay used to be a bare, unstyled Vertical -- Textual's own defaults
   (height: 1fr, overflow: hidden hidden) silently clipped anything past the
   fold with no scrollbar. Mirrors ConsoleScopePickerModal's bounded-panel +
   scrollable-body + pinned-footer shape (_agentic_terminal.tcss
   #console-scope-picker-modal / #console-scope-picker-list). */
WorkbenchHelpPanel {
    align: center middle;
}

#workbench-help-panel {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    padding: 1 2;
}

#workbench-help-scroll {
    height: 1fr;
    min-height: 3;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

#workbench-help-body {
    width: 100%;
    height: auto;
}

#workbench-help-close {
    width: auto;
    height: auto;
    margin: 1 0 0 0;
}

/* ===== MODULE: components/_widgets.tcss ===== */
/* ========================================
 * COMPONENTS: Widgets
 * ======================================== 
 * Miscellaneous reusable widgets
 * ======================================== */

/* Collapsible widget styling with enhanced UX */
Collapsible {
    height: auto;
    min-height: 3;
    margin: 0 0 1 0;
    border: round $surface-lighten-1;
    background: $surface;
}

/* NOTE: Textual's Collapsible title is the CollapsibleTitle widget type --
 * there is no ".collapsible--header" component class on this Textual
 * version (8.2.7). Rules keyed on that dead class never matched anything,
 * so a focused title fell through to Textual's own CollapsibleTitle:focus
 * default (a background/foreground pairing derived from the theme that can
 * render as an unreadable solid block against this app's palette). Target
 * the real widget type so the app's own focus treatment applies.
 *
 * I2 (SP3 final review): that selector rename alone made this file's
 * decorative Collapsible styling (height/background/padding/hover/
 * border-bottom below) apply to EVERY Collapsible app-wide (~35 screens) for
 * the first time -- pre-fix, the dead ".collapsible--header" selector meant
 * NONE of it (not even :focus) ever actually applied anywhere. Only the
 * Library/RAG settings screen was visually QA'd against the new appearance
 * (Docs/superpowers/qa/rag-settings-sp3-2026-07/). So only the genuinely
 * app-wide bug -- an invisible focused title -- stays global here; the
 * decorative restyle is scoped to the Library/RAG card further down, so
 * every other screen's Collapsibles keep their pre-fix appearance. */
Collapsible > CollapsibleTitle:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border-bottom: solid $ds-focus-accent;
    outline: none;
}

Collapsible.-collapsed > CollapsibleTitle:focus {
    border-bottom: solid $ds-focus-accent;
}

/* Settings-scoped decorative restyle: only the Library/RAG card's
 * Collapsible groups (Search/Embedding/Chunking/Vector store/Reranking)
 * were captured and reviewed against this height/background/padding/hover/
 * border treatment -- see the QA captures referenced above. */
#settings-library-rag-card Collapsible > CollapsibleTitle {
    height: 2;
    min-height: 2;
    padding: 0 1;
    background: $surface-lighten-1;
    color: $text;
    border-bottom: solid $border;
}

#settings-library-rag-card Collapsible > CollapsibleTitle:hover {
    background: $surface;
    color: $text;
}

#settings-library-rag-card Collapsible.-collapsed > CollapsibleTitle {
    border-bottom: none;
}

/* An ID-qualified selector outranks a plain-type :focus selector in
 * Textual's (id, class, type) specificity model (textual/css/model.py's
 * SelectorSet._total_specificity sums each tier separately and compares
 * id first) -- so the two scoped rules above would otherwise beat the
 * GLOBAL :focus rules near the top of this block for a title that is both
 * inside this card AND focused, reintroducing the invisible-focused-title
 * bug scoped to just Library/RAG. Restate the focus treatment at matching
 * (ID-qualified) specificity so it still wins here, exactly as it did
 * before this rule was scoped. */
#settings-library-rag-card Collapsible > CollapsibleTitle:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border-bottom: solid $ds-focus-accent;
    outline: none;
}

#settings-library-rag-card Collapsible.-collapsed > CollapsibleTitle:focus {
    border-bottom: solid $ds-focus-accent;
}

Collapsible > Contents {
    height: auto;
    padding: 1;
    background: $surface;
}

/* Half height for RAG Settings collapsible header */
#chat-rag-panel > .collapsible--header,
#character-rag-panel > .collapsible--header {
    height: 1;
    min-height: 1;
}

/* Fix for settings collapsibles in sidebars */
.settings-collapsible {
    height: auto !important;
    min-height: 3 !important;
}

.settings-collapsible > Contents {
    height: auto !important;
    padding: 1;
}

/* Ensure controls inside collapsibles are visible */
.settings-collapsible Checkbox {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.settings-collapsible Toggle {
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
}

.chat-system-prompt-styling {
    width: 100%;
    height: auto;
    min-height: 3;
    max-height: 10; /* Limit height */
    border: round $surface;
    margin-bottom: 1;
}

/* --- Window Footer Widget --- */

/* KEEP IN SYNC with AppFooterStatus.DEFAULT_CSS (task-264): the widget
   bakes the core layout rules (dock/height/background, #footer-key-quit,
   #footer-spacer, #internal-db-size-indicator) in for stylesheet-less
   harnesses; edits HERE (the live bundle source -- built into
   tldw_cli_modular.tcss) must be mirrored there or harness geometry
   silently diverges from production. */
AppFooterStatus {
    dock: bottom;
    height: 1;  /* Single row height */
    background: $primary-background-darken-1;
    width: 100%;
    layout: horizontal;
    padding: 0 1;
    /* Removed align: right middle; from parent, will control children individually */
}

#footer-key-palette {
    width: auto;
    padding: 0 1; /* Padding around each key binding */
    color: $text-muted;
    dock: left; /* Dock key bindings to the left */
    visibility: visible;
    display: initial;
}

#footer-key-quit {
    width: auto;
    height: 1;
    padding: 0 1; /* Padding around each key binding */
    color: $text-muted;
    dock: left; /* Dock key bindings to the left */
}

#footer-spacer {
    width: 1fr; /* Takes up remaining space in the middle */
    height: 1;
}

#footer-word-count {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $text-muted;
    display: block;
}

#footer-token-count {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $text-muted;
    display: block;
}

#internal-db-size-indicator { /* This is for the DB sizes */
    width: auto;
    height: 1;
    /* content-align: right; Textual doesn't have content-align for Static directly */
    /* dock: right; Docking within Horizontal might be tricky, align on parent is better */
    color: $text-muted;
    dock: right; /* Dock DB sizes to the right */
    padding: 0 1; /* Add padding to the right of DB sizes as well */
    margin-left: 2; /* Add buffer before DB status */
}
/* --- End of Window Footer Widget --- */

/* --- Loading States --- */
.loading-state-container {
    width: 100%;
    height: auto;
    min-height: 10;
}

.loading-view {
    align: center middle;
    padding: 2;
}

.loading-text {
    margin-top: 1;
    color: $text-muted;
}

.error-view {
    align: center middle;
    padding: 2;
    background: $error 10%;
    border: round $error;
}

.error-icon {
    color: $error;
    text-style: bold;
}

.error-message {
    margin: 1 0;
    color: $error;
    text-align: center;
}

.error-actions {
    margin-top: 1;
    align: center middle;
}

.error-actions Button {
    margin: 0 1;
}

/* Skeleton loader styles */
.skeleton-container {
    width: 100%;
    padding: 1;
}

.skeleton-avatar {
    width: 8;
    height: 4;
    background: $surface-lighten-2;
    border: round $surface-lighten-2;
}

.skeleton-title {
    width: 60%;
    height: 1;
    background: $surface-lighten-2;
    margin-bottom: 1;
}

.skeleton-subtitle {
    width: 40%;
    height: 1;
    background: $surface-lighten-1;
}

.skeleton-line {
    height: 1;
    background: $surface-lighten-1;
    margin-bottom: 1;
}

.skeleton-line-full {
    width: 100%;
}

.skeleton-line-90 {
    width: 90%;
}

.skeleton-line-80 {
    width: 80%;
}

.skeleton-line-70 {
    width: 70%;
}

/* Skeleton loader visual indication */
.skeleton-line,
.skeleton-avatar,
.skeleton-title,
.skeleton-subtitle {
    opacity: 70%;
}

/* Inline loader states */
InlineLoader.loading {
    color: $primary;
}

InlineLoader.success {
    color: $success;
}

InlineLoader.error {
    color: $error;
}

/* --- End of Loading States --- */

/* Focus-state rules relocated from widget-local CSS (TASK-16811): each
   needs the bundle's $ds-* focus tokens, and the local `$var:` fallbacks
   that used to accompany them shadowed the real values per CSS source. */
EmojiButton.emoji_button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

PathBreadcrumbs .breadcrumb-button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

BaseTamagotchi:focus {
    border: round $ds-focus-accent;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

ChatbooksWindowImproved .search-input:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

/* ===== MODULE: components/stats_screen.css ===== */
/* Statistics Screen Styling */

/* Main container */
#stats-container {
    background: $surface;
    height: 100%;
    width: 100%;
    padding: 1;
}

/* Header */
.stats-header {
    text-align: center;
    text-style: bold;
    background: $primary-background-lighten-2;
    color: $text;
    padding: 1 2;
    margin-bottom: 1;
    border: solid $primary;
}

/* Scrollable content */
#stats-scroll {
    height: 100%;
    background: $surface;
}

#stats-content {
    padding: 0 2;
    height: auto;
}

/* Section headers */
.section-header {
    text-style: bold;
    color: $primary;
    margin-top: 2;
    margin-bottom: 1;
    padding-left: 1;
    border-left: thick $primary;
}

.subsection-header {
    color: $text-muted;
    margin: 1 0;
    padding-left: 2;
}

/* Grid layouts */
.stats-grid {
    layout: grid;
    grid-size: 2 2;
    grid-gutter: 1 1;
    margin-bottom: 1;
    height: auto;
    grid-rows: auto;
}

.stats-grid.overview-grid {
    grid-size: 2 2;
}

.stats-grid.activity-grid {
    grid-size: 2 2;
}

.stats-grid.prefs-grid {
    grid-size: 2 2;
}

.stats-grid.ranges-grid {
    grid-size: 2 2;
}

.stats-grid.fun-grid {
    grid-size: 2 2;
}

/* Stat Card Component */
StatCard {
    background: $panel;
    border: solid $border;
    height: auto;
    min-height: 6;
    padding: 1;
}

StatCard:hover {
    background: $primary-background-lighten-1;
    border: solid $primary;
}

.stat-card-inner {
    layout: vertical;
    align: center middle;
    width: 100%;
    height: auto;
}

.stat-card-icon {
    text-align: center;
    text-style: none;
    margin-bottom: 0;
}

.stat-card-title {
    text-align: center;
    color: $text-muted;
    text-style: none;
    margin-bottom: 0;
}

.stat-card-value {
    text-align: center;
    text-style: bold;
    color: $primary;
    margin: 0;
}

.stat-card-subtitle {
    text-align: center;
    color: $text-disabled;
    text-style: italic;
    margin-top: 0;
}

/* Topic Bar Component */
.topic-bar-container {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    align: left middle;
}

.topic-label {
    min-width: 20;
    text-align: left;
    color: $text;
}

.topic-bar-bg {
    width: 1fr;
    height: 1;
    background: $surface-lighten-1;
    margin-left: 1;
}

.topic-bar-fill {
    height: 1;
    background: $primary;
    transition: width 500ms;
}

/* Topics container */
.topics-container {
    background: $panel;
    border: solid $border;
    padding: 1;
    margin-bottom: 1;
    height: auto;
}

/* Topic range cards */
.topic-range-card {
    height: auto;
    min-height: 4;
}

.topic-range-card .stat-card-value {
    text-style: none;
}

/* Character stats */
.character-stats-container {
    background: $panel;
    border: solid $border;
    padding: 1;
    margin-bottom: 1;
    height: auto;
}

.character-total {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.character-item {
    padding: 0 1;
    margin-bottom: 1;
}

.character-name {
    text-style: bold;
    color: $text;
}

.character-stats {
    color: $text-muted;
    text-style: italic;
    padding-left: 2;
}

/* Loading states */
.loading-container {
    align: center middle;
    height: 20;
}

.loading-text {
    margin-top: 2;
    color: $text-muted;
}

/* Error states */
.error-container {
    align: center middle;
    padding: 4;
}

.error-message {
    color: $error;
    text-style: bold;
    margin-bottom: 2;
}

.retry-button {
    margin-top: 1;
}

/* No data message */
.no-data-message {
    text-align: center;
    color: $text-muted;
    padding: 4;
}

/* Note: Textual doesn't support media queries
   Grid will automatically adjust based on available space */

/* ===== MODULE: components/_settings_splash_theme.tcss ===== */
/* Settings splash-screen viewer + theme editor styles.
 *
 * TASK-394: this module previously also carried the OLD (pre-Settings) splash
 * viewer's generic component styles -- bare `VerticalScroll` plus app-wide class
 * names (.setting-label, .section-header, .help-text, .action-buttons,
 * .settings-section, .card-list, .preview-*). Those either leaked app-wide or
 * were dead. The genuinely shared ones moved verbatim to
 * `components/_shared_components.tcss` (same bundle position -> unchanged
 * cascade); the app-wide scrollbar default moved to `core/_base.tcss`; the
 * zero-importer orphans were removed. What remains below is the LIVE, feature-
 * scoped styling for the in-Settings theme editor and splash-screen viewer
 * (`settings_theme_editor.py`, `settings_splash_screen_viewer.py`). */

/* ===== Settings theme editor ===== */
#settings-theme-tree {
    width: 100%;
    height: 12;
    min-height: 8;
    border: solid $ds-grid-line;
    margin: 1 0 0 0;
}

.settings-preview-grid {
    width: 100%;
    height: auto;
    min-height: 8;
    margin: 1 0;
}

.preview-column {
    width: 1fr;
    height: auto;
    padding: 0 1;
}

.color-swatch {
    width: 7;
    min-width: 7;
    height: 1;
    min-height: 1;
    border: solid $ds-grid-line;
    content-align: center middle;
    text-style: bold;
}

.color-preset-swatch {
    width: 2;
    min-width: 2;
    height: 1;
    min-height: 1;
    margin: 0 1 0 0;
    border: solid $ds-grid-line;
}

/* task-1369: preset swatches are keyboard-activatable (focusable + Enter/
   Space), so they need a visible focus indicator. */
.color-preset-swatch:focus {
    border: solid $ds-focus-accent;
    text-style: bold;
}

.preview-button {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0 0 1 0;
}

.preview-surface-demo,
.preview-panel-demo,
.preview-boost-demo {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0 0 1 0;
    border: solid $ds-grid-line;
    content-align: center middle;
}

/* ===== Settings splash screen viewer ===== */
.settings-splash-gallery {
    height: 24;
    min-height: 16;
    width: 100%;
}

#settings-splash-card-list {
    width: 45%;
    height: 100%;
    border: solid $primary-lighten-2;
}

#settings-splash-preview-scroll {
    width: 1fr;
    height: 100%;
    border: solid $primary-lighten-2;
    background: $surface;
}

.settings-splash-preview {
    width: 100%;
    height: 100%;
}

.settings-splash-preview #splash-display {
    width: 100%;
    height: 100%;
}

/* ===== MODULE: components/_shared_components.tcss ===== */
/* Shared UI component styles.
 *
 * TASK-394: these generic, app-wide component classes (used across settings
 * forms, previews, eval/dataset/coderepo panels, etc.) previously lived in
 * `components/_settings_splash_theme.tcss` -- a feature module whose bare
 * definitions leaked and, worse, disguised their app-wide reach. They are moved
 * here verbatim, at the SAME bundle position (right after the splash/theme
 * module), so the effective cascade is unchanged while the splash module stops
 * owning generic component styles. (Consolidating these with the other bare
 * duplicate definitions scattered across feature modules is a larger,
 * out-of-scope cleanup; this move only relocates the splash module's copies.)
 */

/* Scrollable card / preview lists */
.card-list {
    height: 1fr;
    scrollbar-size: 1 1;
}

/* Preview panels shared by settings, coderepo, dataset, eval, chunk previews */
.preview-panel {
    width: 1fr;
    height: 100%;
    border: solid $primary;
    padding: 1;
}

.preview-container {
    width: 1fr;
    layout: vertical;
    border: solid $primary;
    padding: 1;
}

.preview-content {
    padding: 1;
    text-align: center;
}

/* Settings form components */
.settings-section {
    height: auto;
    padding: 1;
    margin-top: 1;
    border-top: solid $primary;
}

.setting-label {
    width: 20;
    text-align: right;
    margin-right: 1;
}

.section-header {
    text-style: bold;
    color: $primary;
    padding: 1 0;
}

.help-text {
    text-style: italic;
    color: $text-muted;
    padding: 0 0 1 0;
    text-align: center;
}

/* Action button rows */
.action-buttons {
    height: 3;
    layout: horizontal;
    align: center middle;
    padding: 1;
    margin-top: 1;
}

.action-buttons Button {
    margin: 0 1;
}

/* Generic window heading. Relocated from features/_ingest_tldw_api_tabs.tcss
   when that sheet was retired with the standalone ingest window (task-745):
   the rule is unscoped and was the ONLY bundled definition of .window-title,
   while ChatbookExportManagementWindow, ChatbookTemplatesWindow and
   Voice_Cloning_Window all mount it. Deleting the sheet without moving this
   would have silently unstyled three live windows. */
.window-title {
    text-style: bold;
    text-align: center;
    padding: 1 0;
    background: $primary;
    color: $text;
}

/* Relocated from features/_search-rag.tcss (RAG UX v2 PR-2 Task 2) when that
   sheet was retired: both rules are unscoped and were the ONLY bundled
   definitions of their class, while CodeRepoCopyPasteWindow (.action-spacer)
   and MediaViewerPanel (.param-group) still mount them. Deleting the sheet
   without moving these would have silently unstyled both live widgets. */
.action-spacer {
    width: 1fr;
}

.param-group {
    width: 1fr;
}

/* ===== MODULE: features/_chat.tcss ===== */
/* ========================================
 * FEATURES: Chat
 * ======================================== 
 * Chat tab specific styles
 * ======================================== */

/* --- Chat sidebar toggle buttons --- */
.chat-sidebar-toggle-button {
    width: 3;
    height: 100%;
    min-width: 3;
    max-width: 3;
    border: none;
    background: $background;
    color: $text-muted;
    padding: 1 0 0 0;
    margin: 0;
    content-align: center top;
}

.chat-sidebar-toggle-button:hover {
    background: $surface;
    color: $text;
}

.chat-sidebar-toggle-button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border: none;
    outline: none;
}

/* --- Chat Window specific layouts --- */
#chat-main-content {
    layout: vertical;
    height: 100%;
    width: 1fr; /* Takes remaining space */
    min-width: 40; /* Prevent squashing */
}

/* --- Compact Model Bar --- */
#compact-model-bar {
    height: 3;
    width: 100%;
    padding: 0 1;
    background: $surface;
    border-bottom: solid $surface-lighten-1;
    align: left middle;
}

#compact-model-bar Select {
    width: 1fr;
    margin: 0 1 0 0;
    height: 3;
}

.compact-bar-label {
    width: auto;
    padding: 0 1;
    color: $text-muted;
}

.compact-bar-temp {
    width: 12;
    margin: 0 1 0 0;
    height: 3;
}

.compact-bar-toggle {
    width: auto;
    min-width: 5;
    height: 3;
    border: none;
    background: $surface-darken-1;
    color: $text-muted;
}

.compact-bar-toggle:hover {
    background: $surface;
    color: $text;
}

/* Send button states */
.send-button {
    width: 2fr;
    margin-left: 1;
    text-style: bold;
}

.send-button.stop-state {
    background: $error;
}

/* Attachment button */
.attach-button {
    width: auto;
    margin-left: 1;
}

/* Voice input widget styles */
.voice-input-widget {
    padding: 1;
    background: $surface;
    border: solid $primary;
}

/* Notes area expansion states */
.notes-textarea-normal {
    height: 10;
}

.notes-textarea-expanded {
    height: 25;
}

/* Chat message type-specific styles */
.chat-message.user {
    background: $primary-lighten-2;
    text-align: right;
}

.chat-message.assistant {
    background: $surface-lighten-1;
    text-align: left;
}

/* Loading and error states */
.loading-indicator {
    text-align: center;
    padding: 2;
    color: $text-muted;
}

.error-message {
    color: $error;
    padding: 1;
    margin: 1;
    border: solid $error;
}
/* Send button styling (shared) */
.send-button { /* Targets Button */
    width: 1fr;      /* Equal flexible width */
    height: 3;       /* Fixed height for consistency */
    /* align-self: stretch; REMOVED */
    margin-top: 0;
    padding: 0;      /* No padding for button */
    transition: background 0.2s, color 0.2s;
}

/* Stop button state - when button is in stop mode */
.send-button:disabled {
    opacity: 0.7;
}

/* Visual feedback for stop state */
.send-button.stop-state {
    background: $error;
    color: white;
}

.stop-button {
    width: 1fr;      /* Equal flexible width */
    height: 3;
    margin-top: 0;
}

/* Clone Chat Button in chat-right-sidebar */
.clone-chat-button {
    margin-top: 1;   /* Add space above the button */
    width: 100%;     /* Full width like other sidebar buttons */
}

/* Chat Sidebar - Prompts Section */
#chat-prompts-collapsible Input,
#chat-prompts-collapsible ListView,
#chat-prompts-collapsible Button {
    margin-bottom: 1; /* Consistent spacing */
}
#chat-prompt-list-view { /* ID for the prompt list in chat sidebar */
    height: 8; /* Adjust as needed */
    border: round $surface;
    margin-bottom: 1;
}
.loaded-prompt-area { /* Container for loaded prompt details in chat sidebar */
    margin-top: 1;
    padding: 0 1;        /* Padding for content inside */
    background: $surface; /* Slightly different background to group elements */
    /* To get rounded corners for the area itself, apply a border style */
    border: round $primary-background-lighten-1; /* Example: round border with a light color */
                                               /* Or use 'round $surface' if you want it less distinct */
                                               /* Or 'none' if you only want background and no explicit border */
}
/* End of Character Sidebar Specific Styles */

/* --- Chat Settings Mode Styles --- */

/* Settings mode toggle container */
.settings-mode-container {
    layout: horizontal;
    height: 3;
    width: 100%;
    align: center middle;
    margin-bottom: 1;
    padding: 0 1;
}

/* Mode labels */
.mode-label {
    margin: 0 1;
    color: $text-muted;
}

/* Settings mode toggle switch */
.settings-mode-toggle {
    margin: 0 1;
}

/* Settings search input */
.settings-search-input {
    width: 100%;
    margin-bottom: 2;
    border: round $primary;
}



/* RAG preset select */
.rag-preset-select {
    width: 50%;
}

/* Section headers */
.section-header {
    text-style: bold underline;
    color: $primary;
    margin-bottom: 1;
    margin-top: 1;
}

.subsection-header {
    text-style: bold;
    color: $secondary;
    margin-bottom: 1;
    margin-top: 1;
}

/* Info text */
.info-text {
    color: $text-muted;
    text-style: italic;
    margin-bottom: 1;
}

/* Hidden class for mode switching */
.hidden {
    display: none;
}

/* Search highlighting */
.search-hidden {
    display: none;
}

.search-highlighted {
    background: $warning 20%;
    border: round $warning;
}

/* Settings containers for mode switching */
#chat-basic-settings-container {
    width: 100%;
}

#chat-advanced-settings-container {
    width: 100%;
}

/* --- End Chat Settings Mode Styles ---*/

/* --- Enhanced Chat Settings Styles --- */

/* Mode toggle container */
.mode-toggle-container {
    layout: horizontal;
    height: 4;  /* Increased height to prevent cutoff */
    width: 100%;
    align: center middle;
    margin-bottom: 1;
    padding: 0 0 1 0;  /* Add bottom padding */
}

/* Mode labels */
.mode-label {
    margin: 0 1;
    color: $text-muted;
}

/* Settings mode toggle switch */
.settings-mode-toggle {
    margin: 0 1;
    /* Custom styling for better visibility */
    background: $panel;
    border: solid $primary;
}

/* Switch widget styling for better visibility */
.settings-mode-toggle > .switch--slider {
    background: $primary;  /* Neutral blue when off (Basic mode) */
}

.settings-mode-toggle.-on > .switch--slider {
    background: $accent;  /* Accent color when on (Advanced mode) */
}

/* Switch thumb/handle styling */
.settings-mode-toggle .switch--slider {
    border: solid $primary;
}

/* Advanced Settings checkbox styling */
.advanced-settings-checkbox {
    margin-top: 1;
    margin-bottom: 1;
}

.advanced-settings-checkbox > Checkbox {
    color: $text;
}

.advanced-settings-checkbox:hover {
    color: $accent;
}

/* Settings search input */
.settings-search-input {
    width: 100%;
    margin-bottom: 2;
    border: round $primary;
}

/* RAG Settings Panel - Prominent styling */
.rag-settings-panel {
    padding: 1;
    border: round $surface;  /* Changed to match other panels */
    background: $panel;      /* Changed to standard panel background */
    margin-bottom: 1;
}

/* Remove extra padding from RAG panel content */
.rag-settings-panel Container {
    padding: 0;
    height: auto;
}

/* Highlight RAG panel when focused */
.rag-settings-panel:focus-within {
    border: round $ds-focus-accent;
    background: $panel;
}

/* Remove highlight when collapsed */
.rag-settings-panel.collapsed {
    border: round $surface !important;
    background: $panel !important;
}

/* RAG enable toggle */
.rag-enable-toggle {
    margin-bottom: 1;
}

/* RAG preset select */
.rag-preset-select {
    width: 100%;
    margin-bottom: 1;
}

/* RAG scope options */
.rag-scope-options {
    margin-bottom: 1;
}

.rag-scope-options Checkbox {
    margin-bottom: 0;
}

/* Ensure proper spacing for sidebar labels in RAG panel */
.rag-settings-panel .sidebar-label {
    margin-top: 0;
    margin-bottom: 0;
}

/* Advanced only sections - hidden by default in basic mode */
.advanced-only {
    display: none;
}

/* Show advanced sections when in advanced mode */
.sidebar.advanced-mode .advanced-only {
    display: block;
}

/* Hide advanced-only when in basic mode */
.sidebar.basic-mode .advanced-only {
    display: none;
}

/* Search highlighting */
.search-highlight {
    background: $warning 20%;
    border: round $warning;
}

/* --- End Enhanced Chat Settings Styles ---*/

/* --- Visual Polish: Standardized Button Classes --- */

/* Primary action buttons (Send, Submit) */
.btn-primary {
    background: $primary;
    color: $text;
    text-style: bold;
    border: none;
}

.btn-primary:hover {
    background: $primary-lighten-1;
}


/* Ghost buttons (text-only, minimal) */
.btn-ghost {
    background: transparent;
    color: $text-muted;
    border: none;
}

.btn-ghost:hover {
    background: $surface;
    color: $text;
}

/* --- End Visual Polish ---*/

/* ===== MODULE: features/_conversations.tcss ===== */
/* ========================================
 * FEATURES: Conversations (Refactored)
 * ======================================== 
 * Conversations, Characters, and Prompts tab
 * Single sidebar design following best practices
 * ======================================== */

/* --- Main container layout --- */
#conversations_characters_prompts-window {
    layout: horizontal;
    height: 100%;
}

/* --- Sidebar Styling (Single, unified sidebar) --- */
.ccp-sidebar {
    width: 30%;
    min-width: 25;
    max-width: 40%;
    height: 100%;
    background: $boost;
    padding: 1;
    border-right: thick $background-darken-1;
    overflow-y: auto;
    overflow-x: hidden;
}

/* Collapsed state for sidebar */
.ccp-sidebar.collapsed {
    width: 0 !important;
    min-width: 0 !important;
    border-right: none !important;
    padding: 0 !important;
    overflow: hidden !important;
    display: none !important;
}


/* --- View Areas within Content --- */
.ccp-view-area {
    width: 100%;
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 1;
}

/* Hidden class for view switching */
.ccp-view-area.hidden {
    display: none !important;
}

.hidden {
    display: none !important;
}

/* --- Title Styling --- */
.pane-title {
    text-style: bold;
    margin-bottom: 1;
    text-align: center;
    width: 100%;
    background: $primary-background-darken-1;
    padding: 0 1;
    height: 3;
}

.sidebar-title {
    text-style: bold;
    margin-bottom: 1;
    text-align: center;
    color: $primary;
}

/* --- Sidebar Components --- */
.sidebar-label {
    margin-top: 1;
    margin-bottom: 0;
    color: $text-muted;
}

.sidebar-input {
    width: 100%;
    margin-bottom: 1;
    border: solid $primary-lighten-2;
    border-bottom: solid $primary-lighten-2;
}

.sidebar-textarea {
    width: 100%;
    height: 5;
    margin-bottom: 1;
    border: round $surface;
}

.sidebar-textarea.small {
    height: 3;
}

.sidebar-button {
    width: 100%;
    margin-bottom: 1;
    height: 3;
}

.sidebar-button.small {
    width: 45%;
    margin-right: 1;
}

.sidebar-button.danger {
    background: $error-darken-1;
}

.sidebar-button.danger:hover {
    background: $error;
}

.sidebar-listview {
    height: 10;
    margin-bottom: 1;
    border: round $surface;
}

/* Export buttons container */
.export-buttons {
    layout: horizontal;
    height: 3;
    width: 100%;
    margin-bottom: 1;
}

.export-buttons Button {
    width: 1fr;
    margin-right: 1;
}

.export-buttons Button:last-child {
    margin-right: 0;
}

/* --- Editor Styling --- */
.editor-scroll {
    width: 100%;
    height: 1fr;
    overflow-y: auto;
    padding: 1;
}

.field-label {
    margin-top: 1;
    margin-bottom: 0;
    color: $text-muted;
    text-style: bold;
}

.field-value {
    margin-bottom: 1;
    padding: 0 1;
}

.field-textarea {
    width: 100%;
    height: 8;
    margin-bottom: 1;
    border: round $surface;
}

.editor-input {
    width: 100%;
    margin-bottom: 1;
}

.editor-textarea {
    width: 100%;
    height: 10;
    margin-bottom: 1;
    border: round $surface;
}

.editor-textarea.small {
    height: 5;
}

/* AI Generation buttons */
.field-with-ai {
    layout: horizontal;
    height: auto;
    width: 100%;
    margin-bottom: 1;
}

.field-with-ai TextArea {
    width: 85%;
    margin-right: 1;
}

.ai-generate-button {
    width: 12%;
    height: 3;
    margin-top: 0;
    background: $primary;
}

.ai-generate-button:hover {
    background: $primary-lighten-1;
}

.ai-generate-button.full-width {
    width: 100%;
    margin-bottom: 1;
}

/* Image controls */
.image-controls {
    layout: horizontal;
    height: 3;
    width: 100%;
    margin-bottom: 1;
}

.image-controls Button {
    width: 1fr;
    margin-right: 1;
}

.image-controls Button:last-child {
    margin-right: 0;
}

.image-status {
    margin-bottom: 1;
    padding: 0 1;
    color: $text-muted;
}

.character-image {
    width: 100%;
    height: 15;
    border: round $surface;
    margin-bottom: 1;
    align: center middle;
    background: $surface-darken-1;
}

/* Editor action buttons */
.editor-actions {
    layout: horizontal;
    height: 3;
    width: 100%;
    margin-top: 2;
    margin-bottom: 1;
}

.editor-actions Button {
    width: 1fr;
    margin-right: 1;
}

.editor-actions Button:last-child {
    margin-right: 0;
}

.primary-button {
    background: $success;
}

.primary-button:hover {
    background: $success-lighten-1;
}

.secondary-button {
    background: $surface;
}

.secondary-button:hover {
    background: $surface-lighten-1;
}

/* Dictionary specific styles */
.dict-entries-list {
    height: 12;
    margin-bottom: 1;
    border: round $surface;
}

.dict-entry-controls {
    layout: horizontal;
    height: 3;
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
}

.dict-entry-controls Button {
    width: 1fr;
    margin-right: 1;
}

.dict-entry-controls Button:last-child {
    margin-right: 0;
}

/* Collapsible styling enhancements */
Collapsible {
    margin-bottom: 1;
}

Collapsible > CollapsibleTitle {
    background: $primary-background-darken-1;
    color: $text;
    padding: 0 1;
    height: 3;
}

Collapsible.-active > CollapsibleTitle {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border-bottom: solid $ds-focus-accent;
}

/* Select widget styling */
Select {
    width: 100%;
    margin-bottom: 1;
}

/* Checkbox styling -- RETIRED (TASK-18960).
 *
 * This was a bare, unscoped `Checkbox` TYPE selector, so it reached every
 * Checkbox app-wide, not just this screen's. Combined with `ToggleButton`'s
 * own `border: tall` (2 rows of chrome, present even blurred -- unrelated
 * to focus), `height: 2` left literally 0 rows for the label/glyph: any
 * bordered, non-compact Checkbox anywhere in the app rendered blank.
 * TASK-17961's painted-frame verification caught this on Settings >
 * Workspaces' "Show archived" Checkbox; `Tests/UI/
 * test_checkbox_height_render.py` pins the fix.
 *
 * Traced (not just deleted blind) before retiring:
 * - This file's own screen -- the id it titles itself after,
 *   `#conversations_characters_prompts-window` -- has no live Python
 *   consumer; TAB_CCP's route now aliases entirely to `PersonasScreen`
 *   (`UI/Navigation/screen_registry.py`). The `.ccp-sidebar`/`.ccp-view-
 *   area` classes this file also defines have ZERO Python references
 *   anywhere in the repo (review-verified full grep) -- dead CSS like the
 *   id itself -- so nothing conversations-UI-scoped depends on this rule
 *   to retire it INTO.
 * - `width: 100%`/`margin-bottom: 0` are retired with it rather than kept
 *   bare: `margin-bottom: 0` already matches `ToggleButton`'s own
 *   DEFAULT_CSS default (no margin declared), and every documented
 *   escape hatch already fighting this exact rule elsewhere in the bundle
 *   (`.settings-imagegen-backend-row Checkbox`, `MCPSchemaForm Checkbox`,
 *   `PromptBlockEditor #prompt-editor-lane-options Checkbox`,
 *   `MCPToolsMode #mcp-tools-local-enabled`, `LibraryIngestCanvas
 *   .type-group-contents Checkbox`, `#evals-bench-capture-continuations`
 *   (features/_evals.tcss) -- see their own comments, e.g.
 *   components/_agentic_terminal.tcss and features/_evals.tcss) drops
 *   `width: 100%` too, standardizing on `width: auto` alongside
 *   `height: auto`. That six-deep precedent, plus the sweep below,
 *   is why this is a full retirement and not a narrower height-only fix.
 * - The sweep this retirement was checked against (grepping every
 *   `Checkbox(` call app-wide for one relying on this rule with no escape
 *   hatch of its own) found this bug was NOT limited to the one
 *   Settings > Workspaces checkbox named in the task brief -- at least
 *   three more non-compact, unscoped Checkboxes were equally blank before
 *   this fix: `library_prompts_canvas.py`'s
 *   "Include current text as starter content"
 *   (`#library-prompt-recipe-starter`), and `stts_profile_library.py`'s
 *   `#bundle-warning-ack` and `#stts-bundle-inactive-consent`. Retiring
 *   the rule (rather than rescoping it to a container none of these sit
 *   in) fixes all of them at once via Textual's own `ToggleButton`
 *   DEFAULT_CSS (`width: auto`, implicit `height: auto`), which is a
 *   fully-painted, non-blank border+content box.
 */

/* Message display area */
#ccp-conversation-messages-view {
    padding: 1;
}

/* Scrollbar styling is now an app-wide default in core/_base.tcss (TASK-394):
 * a bare `VerticalScroll` type selector here applied to every scroll view in
 * the app, not just conversations. */

/* Note: Textual doesn't support @media queries for responsive design */
/* Width adjustments would need to be handled programmatically */

/* --- End of refactored Conversations, Characters & Prompts styles --- */

/* ===== MODULE: features/_notes.tcss ===== */
/* ========================================
 * FEATURES: Notes
 * ======================================== 
 * Notes tab specific styles
 * ======================================== */

/* --- Notes Tab Window ---
 * T169: #notes-main-content, .notes-editor, and #notes-controls-area
 * pruned -- pre-workbench legacy Notes tab CSS (Notes_Window.py, since
 * removed; the standalone Notes tab was replaced by the Library
 * workbench's Notes canvas) with zero live references anywhere in
 * tldw_chatbook/*.py.
 */

/* T169: .auto-save-label pruned -- zero live references (same
 * pre-workbench legacy Notes tab as above). */

/* --- End of Notes Tab Window --- */

/* ===== MODULE: features/_media.tcss ===== */
/* ========================================
 * FEATURES: Media
 * ========================================
 * Media tab specific styles
 * ======================================== */

/* --- Media Tab --- */
/* MediaWindow v2 - Component-based architecture */
/* Individual component styles are defined in their respective DEFAULT_CSS */

/* Legacy styles for compatibility - will be removed once MediaWindow_v2 is fully integrated */

/* --- Legacy Media Tab Styles --- */
/* DEPRECATED: MediaWindow_v2 has its own layout
#media-window {
    layout: horizontal;
    width: 100%;
}
*/

.media-nav-pane {
    dock: left;
    width: auto;
    min-width: 20;
    max-width: 40;
    background: $boost;
    padding: 1;
    border-right: thick $background-darken-1;
    overflow-y: auto;
    overflow-x: hidden;
}

.media-nav-pane.collapsed {
    width: 0 !important;
    min-width: 0 !important;
    border-right: none !important;
    padding: 0 !important;
    overflow: hidden !important;
    display: none !important;
}

.media-nav-pane .media-nav-button {
    width: 100%;
    margin-bottom: 1;
    border: none;
    height: 3;
    text-align: left;
    padding: 0 1;
}
.media-nav-pane .media-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}

.media-content-pane {
    padding: 0;
    layout: vertical;
    width: 1fr;
}

/* Ensure media views fill vertical space when shown */
.media-content-pane > .media-view-area {
    height: 1fr;
}

#media-sidebar-toggle-button {
    dock: top;
    height: 3;
    width: 5;
    margin: 0 0 1 1;
}

.media-view-area {
    width: 100%;
    height: 1fr;
}

/* Grid layout for content area within each media view */
/* DEPRECATED: MediaWindow_v2 uses Horizontal layout, not Grid
.media-view-area > Grid {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 35% 65%;
    grid-gutter: 1;
    height: 1fr;
    width: 100%;
}
*/

/* Target ListItems inside the media list to control their height */
.media-items-list > ListItem {
    width: 100%;
    height: auto; /* This prevents a single item from stretching to fill the whole ListView */
    padding: 0;
    margin: 0 0 1 0;
}

/* Styles for media item components */
.media-item-title {
    height: auto;
    text-style: bold;
}

.media-item-snippet {
    height: auto;
    color: $text-muted;
    max-height: 2;
    overflow-y: hidden;
}

.media-item-meta {
    height: auto;
    text-style: italic;
    color: $text-disabled;
}

/* Style for the Vertical container inside ListItems */
.media-items-list > ListItem > Vertical {
    height: auto;
    width: 100%;
}

/* Ensure all child elements inside media items take full width */
.media-items-list > ListItem > Vertical > * {
    width: 100%;
}

/* DEPRECATED: MediaWindow_v2 uses different class names
.media-content-left-pane {
    width: 35%
}
*/

/* Children of .media-content-left-pane */
.media-content-left-pane > Label.pane-title {
    height: auto;
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}
.media-content-left-pane > Input.media-search-input {
    height: 3;
    width: 100%;
    margin-bottom: 1;
}

/* Keyword filter styles */
.keyword-filter-label {
    height: auto;
    margin-bottom: 1;
}

.keyword-filter-input {
    height: 3;
    width: 100%;
    margin-bottom: 1;
}

/* ListView for media items */
/* DEPRECATED: MediaWindow_v2 components have their own styling
.media-items-list {
    width: 100%;
    height: 1fr;
    border: round $primary-lighten-2;
    background: $primary-background;
    margin-bottom: 1;
    overflow-y: auto;
    overflow-x: hidden;
    min-height: 10;
}
*/

.media-pagination-bar {
    height: 3;
    width: 100%;
    align-horizontal: center;
}
.media-pagination-bar Button {
    width: auto;
    min-width: 10;
    margin: 0 1;
}
.media-pagination-bar .media-page-label {
    width: 1fr;
    text-align: center;
    padding: 0 1;
}

/* DEPRECATED: MediaWindow_v2 uses MediaViewerPanel with its own styling
.media-content-right-pane {
    width: 1fr;
    height: 1fr;
    padding: 1;
    overflow-y: auto;
    layout: vertical;
}
*/

.media-details-theme {
    height: 1fr;
    width: 100%;
    overflow-y: auto !important;
    min-height: 0;
}

/* Force Markdown content in Media tab to expand fully */
.media-content-right-pane Markdown {
    height: 1fr !important;
    overflow-y: auto !important;
}

/* Additional override for any potential Textual default constraints */
VerticalScroll.media-content-right-pane {
    height: 1fr !important;
}

VerticalScroll.media-content-right-pane > Markdown {
    height: 1fr !important;
}

/* --- Media Details Widget --- */
MediaDetailsWidget {
    height: 1fr;
    width: 100%;
    layout: vertical;
}

.metadata-section {
    width: 100%;
    height: auto;
    padding: 1;
    background: $boost;
    border-bottom: thick $background-darken-1;
}

.metadata-view {
    layout: vertical;
    height: auto;
}

.metadata-section {
    height: auto;
    width: 100%;
    layout: vertical;
    margin-bottom: 1;
}

.metadata-view {
    layout: vertical;
    height: auto;
    width: 100%;
}

.metadata-display {
    padding: 0 1;
    margin-bottom: 0;
    height: auto;
}

.metadata-edit {
    layout: vertical;
    padding: 1;
    height: auto;
    min-height: 30;
}

.edit-fields {
    layout: vertical;
    margin-bottom: 1;
}

.edit-fields Label {
    margin-top: 0;
    margin-bottom: 0;
    text-style: bold;
    height: 1;
}

.edit-fields Input {
    width: 100%;
    margin-bottom: 0;
    height: 3;
}

.edit-fields Input:disabled {
    opacity: 0.6;
    background: $boost-darken-1;
}

/* --- Formatting Options --- */
.formatting-options {
    width: 100%;
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    layout: horizontal;
    align: center middle;
}

.format-reading-checkbox {
    width: auto;
    height: 3;
    padding: 0 1;
}

.format-reading-checkbox:hover {
    background: $boost;
}

.edit-actions {
    layout: horizontal;
    height: auto;
    align: left top;
    margin-top: 1;
}

.edit-actions Button {
    margin-right: 1;
    min-width: 10;
}

.media-content-display {
    height: 1fr;
    width: 100%;
    padding: 1;
}

/* Content search section */
.content-search-section {
    width: 100%;
    padding: 1;
    background: $boost;
    border-bottom: solid $primary-background;
}

.search-controls {
    layout: horizontal;
    align: center middle;
    height: 3;
}

.content-search-input {
    width: 1fr;
    margin-right: 1;
}

.content-search-button {
    width: 4;
    min-width: 4;
    margin-right: 1;
}

.content-search-nav {
    width: 3;
    min-width: 3;
    margin-right: 1;
}

.content-search-status {
    width: auto;
    color: $text-muted;
    text-style: italic;
}

/* --- Deleted Items Styling --- */
.deleted-media-item {
    opacity: 0.6;
}

.deleted-media-item:hover {
    opacity: 0.8;
}

.media-item-deleted {
    color: $text-disabled;
    text-style: strike;
}

.media-item-title.media-item-deleted {
    color: $error;
    text-style: strike;
}

/* Show deleted checkbox styling */
.show-deleted-checkbox {
    width: 100%;
    margin-bottom: 1;
    padding: 0 1;
    height: auto;
}

/* Metadata buttons container */
.metadata-buttons {
    layout: horizontal;
    height: 3;
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
}

.metadata-edit-button {
    width: auto;
    min-width: 10;
    dock: left;
}

.metadata-delete-button {
    width: auto;
    min-width: 10;
    dock: right;
}

/* Hidden state */
.hidden {
    display: none;
}

/* --- Collections/Tags Window --- */
.collections-main-container {
    layout: horizontal;
    width: 100%;
}

.collections-left-pane {
    width: 40%;
    min-width: 30;
    layout: vertical;
    padding: 1;
    border-right: thick $background-darken-1;
}

.collections-right-pane {
    width: 1fr;
    padding: 1;
    overflow-y: auto;
}

.keyword-list {
    height: 1fr;
    border: round $primary-lighten-2;
    background: $primary-background;
    overflow-y: auto;
}

.keyword-list .keyword-item {
    padding: 1;
    margin-bottom: 0;
}

.keyword-list .keyword-item.selected,
.keyword-list .keyword-item.selected:hover {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.keyword-list .keyword-item:hover {
    background: $surface-lighten-1;
    color: $text;
}

.keyword-action-buttons {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

.keyword-action-buttons Button {
    width: 1fr;
    margin-right: 1;
}

.action-buttons-container {
    layout: vertical;
    margin-bottom: 2;
}

.action-buttons-container Button {
    width: 100%;
    margin-bottom: 1;
}

.selection-info {
    padding: 1;
    background: $boost;
    margin-bottom: 1;
    text-align: center;
}

.keyword-details, .usage-stats {
    padding: 1;
    background: $boost;
    margin-top: 1;
    min-height: 10;
}

/* Rename/Merge Dialog Styles */
#rename-dialog-container, #merge-dialog-container {
    align: center middle;
    width: 50;
    min-height: 10;
    padding: 2;
    background: $surface;
    border: thick $primary;
}

#rename-title, #merge-title {
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
}

#merge-instruction {
    text-align: center;
    margin-bottom: 1;
    color: $text-muted;
}

#new-keyword-input, #new-target-input {
    width: 100%;
    margin-bottom: 1;
}

#target-keyword-list {
    height: 15;
    margin-bottom: 1;
    border: round $primary-lighten-2;
    background: $primary-background;
}

#rename-buttons, #merge-buttons {
    layout: horizontal;
    height: 3;
    align: center middle;
}

#rename-buttons Button, #merge-buttons Button {
    margin: 0 1;
    min-width: 12;
}

/* --- Multi-Item Review Window --- */
.multi-review-container {
    width: 100%;
    padding: 1;
}

.selection-section, .items-section, .analysis-section {
    width: 100%;
    margin-bottom: 1;
    padding: 1;
    background: $boost;
}

.selection-section {
    height: auto;
    min-height: 15;
}

.items-section {
    height: auto;
    min-height: 20;
    max-height: 40;
}

.analysis-section {
    height: auto;
    min-height: 30;
}

.search-controls, .tag-filter-section, .selection-controls {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

.search-controls Input {
    width: 1fr;
    margin-right: 1;
}

.tag-filter-section Label {
    width: auto;
    margin-right: 1;
}

.tag-input {
    width: 1fr;
}

.selection-controls Button {
    margin-right: 1;
}

.selection-info {
    width: auto;
    padding: 0 1;
}

.review-items-list {
    height: 1fr;
    border: round $primary-lighten-2;
    background: $primary-background;
    overflow-y: auto;
}

.review-items-list .review-item {
    padding: 1;
    margin-bottom: 0;
}

.review-items-list .review-item.selected,
.review-items-list .review-item.selected:hover {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.review-items-list .review-item:hover {
    background: $surface-lighten-1;
    color: $text;
}

.item-title {
    text-style: bold;
    color: $text;
}

.item-meta {
    color: $text-muted;
    text-style: italic;
}

.analysis-prompt {
    width: 100%;
    height: 10;
    margin-bottom: 1;
}

.analysis-controls {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

.analysis-controls Checkbox {
    width: auto;
    margin-right: 2;
}

.analysis-controls Button {
    margin-right: 1;
    min-width: 15;
}

.analysis-progress {
    width: 100%;
    height: 1;
    margin-bottom: 1;
}

.progress-label {
    text-align: center;
    margin-bottom: 1;
    color: $text-muted;
}

.results-container {
    height: 1fr;
    background: $primary-background;
    padding: 1;
}

.analysis-results {
    layout: vertical;
    width: 100%;
}

.analysis-result-card {
    width: 100%;
    padding: 1;
    margin-bottom: 1;
    background: $boost;
    border: round $primary-lighten-2;
}

.result-header {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

.result-title {
    width: 1fr;
    text-style: bold;
}

.result-meta {
    color: $text-muted;
    margin-bottom: 1;
}

.result-content {
    padding: 1;
    max-height: 20;
    overflow-y: auto;
}

.result-separator {
    text-align: center;
    color: $text-disabled;
    margin-top: 1;
}

/* Delete confirmation dialog for keywords */
#delete-dialog {
    layout: vertical;
    padding: 2;
}

.dialog-title {
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
}

.dialog-subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
}

.dialog-message {
    text-align: center;
    margin-bottom: 2;
}

.dialog-buttons {
    layout: horizontal;
    height: 3;
    align: center middle;
}

.dialog-buttons Button {
    margin: 0 1;
    min-width: 12;
}

/* --- End of Media Tab --- */

/* ===== MODULE: features/_llm-management.tcss ===== */
/* ========================================
 * FEATURES: LLM Management
 * ======================================== 
 * LLM Management tab styles
 * ======================================== */

/* --- LLM Management Tab --- */
.gguf-source-mode-row {
    layout: horizontal;
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

.gguf-source-label {
    width: 18;
    height: 3;
    content-align: right middle;
    padding-right: 1;
}

.gguf-source-mode {
    width: 1fr;
    min-width: 12;
    height: 3;
}

.gguf-source-region {
    display: none;
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.gguf-source-region.-active {
    display: block;
}

.gguf-source-choice-row {
    layout: horizontal;
    width: 100%;
    height: 3;
}

.gguf-source-choice-row Input,
.gguf-source-managed-select {
    width: 1fr;
    min-width: 8;
    height: 3;
}

.gguf-source-refresh,
.gguf-source-browse {
    width: auto;
    margin-left: 1;
}

.gguf-source-authority,
.gguf-source-copy,
.gguf-source-status {
    width: 100%;
    height: auto;
    text-wrap: wrap;
}

.gguf-source-authority {
    color: $warning;
    text-style: bold;
}

.gguf-source-copy,
.gguf-source-status {
    color: $text-muted;
}

.gguf-source-status {
    margin-bottom: 1;
}

.gguf-source-narrow .gguf-source-choice-row {
    layout: vertical;
    height: 6;
}

.gguf-source-narrow .gguf-source-refresh,
.gguf-source-narrow .gguf-source-browse {
    width: 100%;
    margin-left: 0;
}

/* Textual dims disabled focusable controls (and Button text) below readable
 * contrast. Keep this override local to the two GGUF runtime forms; their
 * status line explains why launch controls are unavailable. */
#llm-view-llama-cpp Button:disabled,
#llm-view-llama-cpp Input:disabled,
#llm-view-llama-cpp Select:disabled,
#llm-view-llamafile Button:disabled,
#llm-view-llamafile Input:disabled,
#llm-view-llamafile Select:disabled {
    opacity: 100%;
    text-opacity: 100%;
    color: $text;
    background: $surface-darken-1;
}

#llm-view-llama-cpp Button:disabled,
#llm-view-llama-cpp Input:disabled,
#llm-view-llamafile Button:disabled,
#llm-view-llamafile Input:disabled {
    border: dashed $foreground;
}

#llm-view-llama-cpp Select:disabled > SelectCurrent,
#llm-view-llama-cpp Select:disabled > SelectCurrent Static#label,
#llm-view-llama-cpp Select:disabled > SelectCurrent .arrow,
#llm-view-llamafile Select:disabled > SelectCurrent,
#llm-view-llamafile Select:disabled > SelectCurrent Static#label,
#llm-view-llamafile Select:disabled > SelectCurrent .arrow {
    opacity: 100%;
    text-opacity: 100%;
    color: $text;
    background: $surface-darken-1;
}

#llm-view-llama-cpp Select:disabled > SelectCurrent,
#llm-view-llamafile Select:disabled > SelectCurrent {
    border: dashed $foreground !important;
}

#llm_management-window { /* Matches TAB_LLM ("llm_management") */
    layout: horizontal;
}

.llm-nav-pane { /* Style for the left navigation pane */
    dock: left;
    width: auto;
    min-width: 25;
    max-width: 60;
    height: 100%;
    background: $boost; /* Or $surface-darken-1 or $surface-lighten-1 */
    padding: 1;
    border-right: thick $background-darken-1;
    overflow-y: auto;
    overflow-x: hidden;
}

.llm-nav-pane .llm-nav-button { /* Style for navigation buttons */
    width: 100%;
    margin-bottom: 1;
    border: none;
    height: 3;
    text-align: left;
    padding: 0 1;
}
.llm-nav-pane .llm-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}
/* Active state for selected llm nav button */
.llm-nav-pane .llm-nav-button.-active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.llm-content-pane { /* Style for the right content display area */
    width: 1fr;
    height: 100%;
    padding: 1 2;
    overflow-y: auto;
}

.llm-view-area { /* Common class for individual content areas */
    width: 100%;
    height: 100%; /* Or auto */
    display: none; /* Initially hidden until activated */
}

/* LLM Management Tab Specific Styles */
#llm_management-window .llm-view-area > VerticalScroll { /* Target the new VS inside each view */
    height: 100%; /* Ensure the VerticalScroll takes full height of its parent view area */
}

#llamacpp-args-help-collapsible,
#llamafile-args-help-collapsible,
#vllm-args-help-collapsible { /* Style for the collapsible itself */
    margin-top: 1;
    margin-bottom: 1;
    border: round $primary-lighten-1; /* Optional border for the collapsible */
}

#llamacpp-args-help-collapsible > .collapsible--header,
#llamafile-args-help-collapsible > .collapsible--header,
#vllm-args-help-collapsible > .collapsible--header { /* Style for the collapsible title */
    background: $surface-darken-1; /* Slightly different background for the header */
}

.help-text-display {
    height: 25; /* Or your desired fixed height for the scrollable help text */
    width: 100%;
    border: round $surface;
    padding: 1;
    margin-top: 1; /* Space between collapsible title and the content */
    background: $panel; /* Background for the help text area */
    overflow-y: scroll !important; /* Ensure vertical scrolling */
}

/* Ensure input fields for additional args are appropriately sized if they were TextAreas */
/* If you changed #llamacpp-additional-args to Input, this might not be needed for it */
#llamacpp-additional-args, /* This is now an Input, so this rule might be less relevant for it */
#llamafile-additional-args,
#vllm-additional-args {
    height: 3; /* For single-line Input or small TextArea */
    /* If it's a TextArea and you want more lines: */
    /* min-height: 3; */
    /* max-height: 7; */
    /* height: auto; */
}

/* Log output styles for Llama.cpp and Llamafile views */
#llm-view-llama-cpp .log_output,
#llm-view-llamafile .log_output {
    width: 100%;
    height: 15; /* Fixed height to ensure scrolling works */
    min-height: 10;
    max-height: 20;
    border: panel $primary-darken-2;
    background: $background-darken-1;
    margin-top: 1;
    overflow-y: auto;
}

/* Optional: Style for the input_container if needed */
.input_container {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}
.input_container Input {
    width: 1fr; /* Input takes available space */
    margin-right: 1; /* Space before browse button */
}
.input_container .browse_button {
    width: auto; /* Let button size itself */
    height: 100%;
}

.button_container {
    layout: horizontal;
    height: auto;
    margin-top: 1;
}
.button_container Button {
    margin-left: 1; /* Space between buttons */
}
/* Ollama Specific Styles within #llm-view-ollama */
#llm-view-ollama {
    layout: vertical; /* Ensures children stack vertically by default */
    /* overflow-y: auto; /* Add if direct children of llm-view-ollama might overflow before VerticalScroll */
}
#llm-view-ollama VerticalScroll { /* Ensure the VerticalScroll takes up space */
    height: 100%;
}

#llm-view-ollama .label { /* General label styling if not already covered */
    margin-top: 1;
    margin-bottom: 0; /* Tighten space below label if input is right after */
    text-style: bold;
}
#llm-view-ollama .section_label { /* For labels that act as section headers */
    margin-top: 2; /* More space above section labels */
    padding: 0;
    /* no decorative border — the design system's "Border Has A Job" rule */
    text-align: left;
    width: 100%;
}

#llm-view-ollama .input_field,
#llm-view-ollama .input_field_short,
#llm-view-ollama .input_field_long {
    margin-bottom: 1; /* Space after input fields */
}
#llm-view-ollama .input_field_long { /* For paths or longer inputs */
    width: 100%;
}

#llm-view-ollama .input_action_container { /* For Input + Button on same line */
    layout: horizontal;
    height: auto; /* Fit content */
    margin-bottom: 0; /* Status/Output will provide margin */
}
#llm-view-ollama .input_action_container .input_field_short {
    width: 1fr; /* Input takes most space */
    margin-right: 1;
    margin-bottom: 0; /* No bottom margin if button is next to it */
}
#llm-view-ollama .input_action_container .action_button_short {
    width: auto; /* Let button size itself */
    min-width: 10; /* Ensure it's not too small */
    height: 3; /* Match the default Input height (100% of an auto parent collapses) */
}
#llm-view-ollama .input_action_container .browse_button_short {
    width: auto;
    min-width: 15;
    height: 3;
}

#llm-view-ollama .action_container { /* For standalone buttons */
    width: 100%;
    height: auto;
    margin-bottom: 0;
}
#llm-view-ollama .action_button { /* For buttons that take full width or are main actions */
    width: 100%;
    margin-top: 1; /* If it's after a section label or input */
}
#llm-view-ollama .full_width_button {
    width: 100%;
    margin-top: 1;
}

#llm-view-ollama .delete_button Button { /* Specific styling for delete button if needed */
    background: $error-darken-1;
    color: $text;
}
#llm-view-ollama .delete_button Button:hover {
    background: $error;
}

/* New Status TextArea */
.ollama-status-textarea {
    width: 100%;
    height: 3; /* Small, 1-2 lines of text */
    border: round $primary-darken-1;
    background: $surface;
    margin-top: 1; /* Space above status */
    margin-bottom: 1; /* Space below status, before main output or next section */
    padding: 0 1;
    color: $text-muted; /* Subdued text color for status */
}

/* Output TextAreas */
#llm-view-ollama .output_textarea_medium { /* For JSON lists, model info */
    width: 100%;
    height: 25; /* Or adjust as needed */
    border: round $primary;
    background: $panel;
    margin-bottom: 1; /* Space before next element/spacer */
}
#llm-view-ollama .output_textarea_small { /* For embeddings */
    width: 100%;
    height: 6;
    border: round $primary;
    background: $panel;
    margin-bottom: 1;
}

/* Main RichLog for streaming */
#llm-view-ollama .log_output_large { /* Renamed from .log_output for specificity */
    width: 100%;
    height: 10; /* Make it taller */
    border: panel $primary-darken-2;
    background: $background-darken-1; /* Darker background for log */
}

/* Spacer element */
.ollama-spacer {
    height: 1; /* Creates 1 cell of vertical space */
    width: 100%;
}

/* OLLAMA compact layout grid */
.ollama-button-bar {
    layout: horizontal;
    height: auto;
    width: 100%;
    margin: 1 0;
    align-horizontal: center;
}
.ollama-button-bar Button {
    width: 1fr;
    margin: 0 1;
}

.ollama-actions-grid {
    layout: horizontal;
    height: auto;
    align-vertical: top; /* Align columns to the top */
    margin-bottom: 1;
}

.ollama-actions-column {
    layout: vertical;
    width: 1fr;
    height: auto; /* 100% of the auto-height grid collapsed columns to empty boxes */
    padding: 1;
    border: round $panel-lighten-1;
    margin: 0 1;
}
.ollama-actions-column:first-of-type {
    margin-left: 0;
}
.ollama-actions-column:last-of-type {
    margin-right: 0;
}

.column-title {
    text-style: bold underline;
    width: 100%;
    text-align: center;
    margin-bottom: 1;
}

/* Override input container margin inside a column */
.ollama-actions-column .input_action_container {
    margin-bottom: 1;
}
.ollama-actions-column .full_width_button {
    margin-top: 0; /* Tighten up space for buttons below inputs */
}

/* --- End of LLM Management Tab --- */

/* ===== MODULE: features/_tools-settings.tcss ===== */
/* ========================================
 * FEATURES: Tools and Settings
 * ======================================== 
 * Tools and Settings tab
 * ======================================== */

/* --- Tools & Settings Tab --- */
#tools_settings-window { /* Matches TAB_TOOLS_SETTINGS */
    layout: horizontal; /* Main layout for this tab */
}

.tools-nav-pane {
    dock: left;
    width: auto; /* Changed from 25% */
    min-width: 25; /* Example min-width */
    max-width: 60; /* Example max-width */
    height: 100%;
    background: $boost; /* Or $surface-lighten-1 */
    padding: 1;
    border-right: thick $background-darken-1;
    overflow-y: auto;
    overflow-x: hidden;
}

.tools-nav-pane .ts-nav-button { /* Style for navigation buttons */
    width: 100%;
    margin-bottom: 1;
    border: none; /* Cleaner look for nav buttons */
    height: 3;
}
.tools-nav-pane .ts-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}

.tools-nav-pane .ts-nav-button.active-nav {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.tools-content-pane {
    width: 1fr; /* Takes remaining horizontal space */
    height: 100%;
    padding: 1 2; /* Padding for the content area */
    overflow-y: auto; /* If content within sub-views might scroll */
}

/* Ensure ContentSwitcher fills the pane */
.tools-content-pane ContentSwitcher {
    height: 100%;
    width: 100%;
}

.ts-view-area { /* Class for individual content areas */
    width: 100%;
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    /* Let ContentSwitcher handle visibility */
}

.config-file-settings-container {
    height: 100%;
    width: 100%;
    overflow-y: auto;
    overflow-x: hidden;
}

/* Ensure TabbedContent fills container */
.config-file-settings-container TabbedContent {
    height: 100%;
    width: 100%;
}

.config-file-settings-container TabPane {
    height: 100%;
    width: 100%;
}

/* Specific config tabs styling */
#config-tabs {
    height: 100%;
    width: 100%;
    min-height: 30;
}

/* Inner container for config file settings */
.config-file-settings-inner {
    height: 100%;
    width: 100%;
    layout: vertical;
}

/* Settings form styling */
.section-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
    text-align: center;
    height: auto;
}

.section-description {
    color: $text-muted;
    margin-bottom: 2;
    text-align: center;
    text-style: italic;
    height: auto;
}

.subsection-title {
    text-style: bold;
    color: $secondary;
    margin: 2 0 1 0;
}

.settings-group {
    margin-bottom: 2;
    padding: 1;
    background: $surface;
    border: round $primary-background;
    height: auto;
}

.settings-label {
    margin-bottom: 1;
    text-style: bold;
}

.settings-select, .settings-input {
    width: 100%;
    margin-bottom: 1;
    min-height: 3;
    height: auto;
}

.checkbox-group {
    margin-bottom: 1;
}

.warning-text {
    color: $warning;
    margin-bottom: 1;
    text-style: italic;
}

.settings-actions {
    margin-top: 2;
    layout: horizontal;
    height: auto;
    align: center middle;
}

.settings-actions Button {
    margin: 0 1 0 0;
}

/* Configuration file settings specific */
.config-file-settings-container {
    height: 100%;
    width: 100%;
}

.config-editor {
    height: 20;
    min-height: 20;
    border: round $primary;
    background: $panel;
    margin-bottom: 1;
}

.config-button-container {
    layout: horizontal;
    height: auto;
    margin-top: 1;
    align: center middle;
}

.config-button-container Button {
    margin: 0 1 0 0;
}

.tab-description {
    color: $text-muted;
    margin-bottom: 1;
    text-style: italic;
}

/* --- Core Settings Styles --- */
.core-settings-container {
    padding: 1 2;
    width: 100%;
    height: 100%;
}

.section-title {
    text-style: bold;
    text-align: center;
    margin-bottom: 2;
    color: $primary;
}

.subsection-title {
    text-style: bold;
    margin: 2 0 1 0;
    color: $secondary;
}

.settings-group {
    background: $surface;
    padding: 1;
    margin-bottom: 2;
    border: round $primary-background;
}

.settings-label {
    margin: 1 0 0 0;
    color: $text-muted;
}

.settings-input {
    width: 100%;
    margin: 0 0 1 0;
}

.settings-select {
    width: 100%;
    margin: 0 0 1 0;
}

.settings-subsection-title {
    color: $text;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

.settings-note {
    color: $text-muted;
    text-style: italic;
    margin-top: 1;
    margin-bottom: 1;
    padding: 0 1;
}

.checkbox-group {
    layout: horizontal;
    margin: 0 0 1 0;
}

.checkbox-group Checkbox {
    margin-right: 2;
}

.settings-actions {
    layout: horizontal;
    margin-top: 2;
    align: center middle;
}

.settings-actions Button {
    margin: 0 1;
    min-width: 15;
}

/* --- End Core Settings Styles ---*/

/* --- Config Form Styles --- */
.config-form {
    width: 100%;
    height: auto;
    padding: 1 2;
    overflow-y: auto;
}

.form-label {
    margin-top: 1;
    margin-bottom: 0;
    text-style: bold;
    color: $text-muted;
}

.form-description {
    color: $text-muted;
    margin-bottom: 2;
    text-style: italic;
}

.form-section-title {
    text-style: bold;
    color: $primary;
    margin: 2 0 1 0;
    border-bottom: solid $primary;
    padding-bottom: 0;
}

.form-subsection-title {
    text-style: bold;
    color: $secondary;
    margin: 1 0 1 0;
}

.form-actions {
    layout: horizontal;
    margin-top: 2;
    height: 3;
    width: 100%;
    align: center middle;
}

.form-actions Button {
    margin: 0 1 0 0;
    min-width: 15;
}

/* TextArea styling for config forms */
.config-form TextArea {
    width: 100%;
    height: 10;
    margin-bottom: 1;
    border: round $primary;
    background: $panel;
}

.system-prompt-textarea {
    height: 15;
}

.provider-models-textarea {
    height: 5;
}

/* Collapsible styling in config forms */
.config-form Collapsible {
    margin-bottom: 1;
    border: round $primary-background;
    background: $surface;
}

.config-form Collapsible > CollapsibleTitle {
    background: $boost;
    padding: 0 1;
}

/* Help text */
.help-text {
    color: $text-muted;
    margin-bottom: 1;
    text-style: italic;
}

/* Database status */
.db-status {
    color: $text-muted;
    margin-bottom: 1;
}

/* ===== MODULE: features/_ingest.tcss ===== */
/* ========================================
 * FEATURES: Ingest
 * ======================================== 
 * Media ingestion tab styles
 * ======================================== */

/* --- Ingest Content Tab --- */
#ingest-window { /* Matches TAB_INGEST */
    layout: vertical !important; /* Override .window class */
    height: 100%;
    width: 100%;
}

/* Override the horizontal layout from .window class */
#ingest-window.window {
    layout: vertical !important;
}
.tldw-api-media-specific-options { /* Common class for specific option blocks */
    padding: 1;
    border: round $surface;
    margin-top: 1;
    margin-bottom: 1;
}

/* Added to ensure initially hidden specific options are indeed hidden */
.tldw-api-media-specific-options.hidden {
     display: none;
}

.ingest-nav-pane { /* Style for the left navigation pane */
    dock: left;
    width: 25%;
    min-width: 20;
    max-width: 40;
    height: 100%;
    background: $boost; /* Or a slightly different shade */
    padding: 1;
    border-right: thick $background-darken-1;
    /* Removed overflow properties - let VerticalScroll handle scrolling */
}

.ingest-nav-pane .ingest-nav-button { /* Style for navigation buttons */
    width: 100%;
    margin-bottom: 1;
    border: none;
    height: 3;
}
.ingest-nav-pane .ingest-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}
/* Active state for selected ingest nav button */
.ingest-nav-pane .ingest-nav-button.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Collapsible sidebar styles */
.ingest-nav-pane.collapsed {
    width: 4;
    min-width: 4;
    padding: 1 0;
}

.nav-header {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

.nav-toggle-button {
    width: 3;
    height: 3;
    min-width: 3;
    padding: 0;
    text-align: center;
}

/* Adjust button appearance when collapsed */
.ingest-nav-pane.collapsed .ingest-nav-button {
    width: 3;
    padding: 0;
    /* Show only first letter or icon */
    overflow: hidden;
}

/* Style for sidebar section titles */
.ingest-nav-pane .sidebar-title {
    text-style: bold;
    color: $primary;
    margin-top: 2;
    margin-bottom: 1;
    padding-left: 1;
    border-left: thick $accent;
}
/* Active state for selected ingest nav button (optional) */
/* .ingest-nav-pane .ingest-nav-button.-active-view {
    background: $accent-darken-1;
    color: $text;
} */

.ingest-content-pane { /* Style for the right content display area */
    width: 1fr;
    height: 100%;
    padding: 1 2;
    /* Removed overflow - let child VerticalScroll widgets handle scrolling */
}

.ingest-view-area { /* Common class for individual content areas */
    width: 100%;
    height: 100%;
}
.ingest-label {
    margin-top: 1;
    margin-bottom: 0;
}
.ingest-selected-files-list {
    min-height: 5;
    max-height: 10;
    height: auto;
    border: round $ds-focus-accent;
    margin-bottom: 1;
    background: $surface;
}
.LocalIngestionPanel .file-selection-container {
    height: 1fr;
    min-height: 15;
    border: solid $primary;
    margin-bottom: 1;
    padding: 1;
}
.ingest-preview-area {
    height: 1fr;
    min-height: 10;
    border: round $primary-lighten-2;
    padding: 1;
    margin-bottom: 1;
    background: $surface;
}
.ingest-preview-area > Static#ingest-prompts-preview-placeholder {
    color: $text-muted;
    width: 100%;
    text-align: center;
    padding: 2 0;
}
.ingest-status-area {
    min-height: 5;
    max-height: 15;
    height: auto;
    margin-top: 1;
}

.prompt-preview-item {
    border: panel $background-lighten-2;
    padding: 1;
    margin-bottom: 1;
}
.prompt-preview-item .prompt-title {
    text-style: bold;
}
.prompt-preview-item .prompt-field-label {
    text-style: italic;
    color: $text-muted;
}
.prompt-preview-item Markdown {
    background: $surface-darken-1;
    padding: 0 1;
    margin-top: 1;
    margin-bottom: 1;
    border: solid $primary-darken-1; /* Use 'solid' instead of 'narrow' */
    max-height: 10;
    overflow-y: auto;
}
.prompt-preview-item .prompt-details-text {
    max-height: 5;
    overflow-y: auto;
    background: $surface;
    padding: 0 1;
    border: dashed $primary-darken-2; /* Use 'dashed' instead of 'dotted' */
    margin-bottom: 1;
}

/* Ensure VerticalScroll containers fill their parent */
.ingest-view-area VerticalScroll {
    height: 1fr;
    width: 100%;
}

/* Ensure VerticalScroll containers fill available space */
VerticalScroll.ingest-view-area {
    height: 1fr;
    width: 100%;
}

VerticalScroll.ingest-form-scrollable {
    height: 1fr;
    width: 100%;
}

/* Scrollable form container needs padding to prevent content cutoff */
.ingest-form-scrollable {
    height: 100%;
    overflow-y: auto;
    padding: 1;
}

/* Removed .ingest-media-tab-content - no longer needed since parent is VerticalScroll */




.ingest-form-row {
    margin-top: 1;
}

.ingest-form-col {
    width: 50%;
    padding-right: 1;
}

.title-author-row {
    margin-bottom: 1;
}

/* Ensure title/author input boxes are visible */
.title-author-row Input {
    height: 3;
    width: 100%;
    margin-bottom: 1;
}

.ingest-textarea-small {
    min-height: 3;
    max-height: 8;
    height: auto;
    margin-bottom: 1;
}

.ingest-textarea-medium {
    min-height: 10;
    max-height: 20;
    height: auto;
    margin-bottom: 1;
}


/* All ingest views are controlled programmatically */
.ingest-view-area {
    /* display controlled by app.py watcher */
    height: 100%;
    width: 100%;
}

/* --- Visibility styles for ingest views --- */
/* Views are controlled programmatically via styles.display */


/* Ensure the IngestWindowTabbed container fills available space */
IngestWindowTabbed {
    height: 1fr;
    width: 100%;
    layout: vertical;
}

/* Ensure TabbedContent in ingest window displays properly */
#ingest-window TabbedContent {
    height: 1fr;  /* Use fr unit for flexible sizing */
    width: 100%;
}

.media-tab-container {
    height: 1fr;  /* Use fr unit instead of 100% */
    padding: 1;
}

.source-toggle-container {
    dock: top;
    height: auto;
    padding: 1;
    margin-bottom: 1;
    border-bottom: solid $primary;
}

.tab-title {
    text-style: bold;

    margin-bottom: 1;
}

.source-toggle {
    layout: horizontal;
    height: auto;
    margin-top: 1;
}

.source-toggle RadioButton {
    margin-right: 2;
}

.source-content {
    height: 1fr;
    width: 100%;
    overflow-y: auto;
}

/* Ensure content areas within tabs fill space */
.ingest-form-scrollable {
    height: 1fr;
    width: 100%;
}




.source-content.hidden {
    display: none;
}

/* Compact file lists for better space usage */
.ingest-selected-files-list {
    min-height: 3;
    max-height: 8;
    height: auto;
    border: round $ds-focus-accent;
    margin-bottom: 1;
    background: $surface;
}

/* Status section at top of forms */
.status-dashboard {
    width: 100%;
    height: auto;
    max-height: 8;      /* Prevent status from taking too much space */
    min-height: 3;
    background: $surface;
    border: round $primary;
    padding: 1;
    margin-bottom: 1;
}

/* Mode-specific visibility controls */
.simple-mode .advanced-only {
    display: none !important;
}

.advanced-mode .advanced-only {
    display: block !important;
}

/* URL input always visible */
.url-input-section {
    display: block;
    margin-top: 1;
    padding: 1;
    border: round $primary;
    background: $surface;
}

/* Simplified form sections */
.essential-fields {
    border: round $accent;
    padding: 1;
    margin-bottom: 2;
    background: $surface-lighten-1;
}

/* Placeholder text */
.placeholder-text {
    color: $text-muted;
    text-align: center;
    padding: 4;
}

/* Mode toggle styles */
.mode-toggle-container {
    dock: top;
    padding: 1;
    margin-bottom: 1;
}

.mode-toggle {
    layout: horizontal;
    height: auto;
}

.mode-toggle RadioButton {
    margin-right: 2;
}

/* File selection row */
.file-selection-row {
    height: 3;
    margin-bottom: 1;
}

.file-selection-row Button {
    margin-right: 1;
}

/* Enhanced file list with metadata */
.file-list-with-metadata {
    min-height: 5;
    max-height: 10;
    border: round $primary;
    background: $surface;
}

/* Metadata row */
.metadata-row {
    margin-top: 1;
    margin-bottom: 1;
}

.metadata-col {
    width: 50%;
    padding-right: 1;
}

/* Process button */
.process-button {
    width: 100%;
    height: 4;
    margin-top: 2;
    text-style: bold;
}

/* Advanced options container */
.advanced-options-container {
    margin-top: 1;
}

.advanced-options-container.hidden {
    display: none;
}

/* Time range row */
.time-range-row {
    margin-top: 1;
}

.time-col {
    width: 50%;
    padding-right: 1;
}

/* Chunk settings row */
.chunk-settings-row {
    margin-top: 1;
}

.chunk-col {
    width: 50%;
    padding-right: 1;
}

/* Status Dashboard Styles */
.status-dashboard-container {
    border: round $primary;
    background: $surface;
    padding: 1;
    margin-bottom: 1;
}

.status-main-row {
    height: 3;
    align: left middle;
}

.status-message {
    width: 1fr;
    text-style: bold;
}

.file-counter {
    width: auto;
    margin-left: 2;
    color: $text-muted;
}

.time-display {
    width: auto;
    margin-left: 2;
    color: $text-muted;
}

.action-buttons {
    width: auto;
    dock: right;
    layout: horizontal;
}

.action-buttons.hidden {
    display: none;
}

.small-button {
    height: 3;
    min-width: 8;
    margin-left: 1;
}

.small-button.hidden {
    display: none;
}

/* Progress bar in dashboard */
.status-dashboard-container ProgressBar {
    margin-top: 1;
    height: 1;
}

.status-dashboard-container ProgressBar.hidden {
    display: none;
}

/* Alert container */
.alert-container {
    margin-top: 1;
    padding: 1;
    border: round $error;
    background: $error 10%;
}

.alert-container.hidden {
    display: none;
}

.alert-messages {
    color: $text;
    max-height: 6;
    overflow-y: auto;
}

/* Enhanced File List Styles */
.file-list-enhanced {
    border: round $primary;
    background: $surface;
    padding: 0;
}

.file-items-container {
    max-height: 10;
    overflow-y: auto;
    padding: 1;
}

.file-list-item-container {
    padding: 1;
    margin-bottom: 1;
    border: round $surface-lighten-2;
    background: $surface-lighten-1;
    height: auto;
}

.file-list-item-container:hover {
    background: $surface-lighten-2;
    border: round $primary;
}

.file-info-main {
    width: 1fr;
}

.file-name-row {
    height: auto;
    margin-bottom: 0;
}

.file-icon {
    width: 3;
    text-align: center;
}

.file-name {
    width: 1fr;
    text-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
}

.file-metadata {
    color: $text-muted;

    margin-left: 3;
}

.file-remove-button {
    width: 3;
    height: 3;
    min-width: 3;
    margin: 0;
    padding: 0;
    text-align: center;
}

.no-files-message {
    text-align: center;
    color: $text-muted;
    padding: 3;
}

.file-list-summary {
    dock: bottom;
    height: 3;
    padding: 1;
    border-top: solid $primary;
    background: $surface-darken-1;
    text-align: center;
    color: $text-muted;
}

/* --- END OF INTEGRATED NEW CSS --- */

/* ===== MODULE: features/_evaluation_unified.tcss ===== */
/* ========================================
 * FEATURES: Unified Evaluation Dashboard
 * ======================================== 
 * Single-page responsive design with collapsibles
 * Based on original UX design specifications
 * ======================================== */


.dashboard-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.quick-actions {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

/* Drop zone styling */
.drop-zone {
    layout: horizontal;
    height: 3;
    background: $panel;
    border: dashed $primary;
    padding: 0 2;
    align: center middle;
    margin: 1 0;
}

.drop-zone:hover {
    background: $boost;
    border: solid $primary;
}


/* --- Main Content Area --- */
.main-content {
    padding: 1;
}

/* Ensure VerticalScroll works properly inside the evals dashboard.
   This selector MUST stay scoped: a bare `VerticalScroll` rule applies
   app-wide and (because stylesheet rules always outrank widget DEFAULT_CSS
   in Textual, regardless of specificity) silently overrides every widget's
   own `height: 1fr` sizing, pushing follow-on siblings off-screen. */

/* Make sure the entire window uses available height */
EvalsWindow {
    height: 100%;
}

/* --- Collapsible Sections --- */
Collapsible {
    margin-bottom: 1;
    border: tall $surface;
    background: $panel;
}

Collapsible > Container {
    padding: 1;
}

Collapsible.-collapsed {
    margin-bottom: 1;
}

/* Note: Textual doesn't support @media queries
   Use reactive attributes or resize events for responsive design */

/* Template Grid */
.template-grid {
    layout: grid;
    grid-columns: 1fr 1fr;
    grid-gutter: 1;
    margin-top: 1;
}

.template-card {
    height: 5;
    padding: 1;
    background: $surface;
    border: tall $primary;
    text-align: center;
}

.template-card:hover {
    background: $boost;
    border: thick $primary;
}

/* Action Bar */
.action-bar {
    layout: horizontal;
    background: $surface;
    padding: 1;
    margin: 2 0;
    border: tall $primary;
    align: center middle;
}

.action-button {
    margin-right: 1;
    min-width: 12;
}

.action-button.primary {
    background: $primary;
    color: $text;
}

.action-button.primary.large {
    min-width: 20;
    height: 3;
    text-style: bold;
}

/* Results Dashboard */
.section-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.results-header {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
    align: left middle;
}

.results-header Static {
    width: 1fr;
}

.results-header Select {
    width: 20;
}

.results-list {
    height: 15;
    background: $surface;
    border: tall $secondary;
    margin-bottom: 2;
}

.stat-card {
    background: $surface;
    padding: 1;
    border: tall $secondary;
    text-align: center;
}

.stat-value {
    text-style: bold;
    color: $primary;
}

.button-row {
    layout: horizontal;
    margin-bottom: 1;
}

.button-row Button {
    margin-right: 1;
}

/* Status Bar */
.status-bar {
    height: 3;
    background: $surface;
    border-top: solid $primary;
    padding: 0 2;
    layout: horizontal;
    align: left middle;
}

.status-text {
    width: 1fr;
}

/* Responsive Adjustments - handled in Python code via resize events */
/* For narrow screens, switch grids to single column */

/* Utility Classes */
.hidden {
    display: none;
}

.subsection-title {
    text-style: bold;
    color: $secondary;
    margin: 1 0;
}

.help-text {
    color: $text-muted;
    text-style: italic;
}

/* Disabled States */
Button:disabled {
    opacity: 0.5;
}

/* Loading States */
.loading {
    opacity: 0.6;
}

/* Error States */
.error {
    border: tall $error;
    background: $error 10%;
}

/* ===== MODULE: features/_evals.tcss ===== */
/* ========================================
 * FEATURE: Evals
 * ========================================
 * Three-pane workbench: library rail, detail pane, readiness inspector.
 * Shared design-system classes -- .ds-panel, .destination-workbench,
 * .destination-workbench-pane, .ds-inspector, .density-compact/comfortable
 * -- are already defined in components/_agentic_terminal.tcss and
 * layout/_panes.tcss; this file only adds Evals-specific rail/pane rules.
 * ======================================== */

#evals-shell {
    height: 100%;
    min-height: 0;
}

/* I4: panes never scrolled. Vertical's own DEFAULT_CSS is
   `overflow: hidden hidden`, so content taller than a pane's bounded
   height (post-C1, a real bounded height rather than a fixed 11-row
   collapse) was simply clipped with no way to reach the hidden rows --
   in an editor whose entire job is reviewing a list (snippets, targets,
   run history). Scrolled at the narrowest level that isolates a LIST BODY
   from a sibling control that must stay reachable without scrolling past
   it (`#evals-import-snippets`, `#evals-primary-action`); the two
   detail-content widgets with no separate list body to isolate
   (`ClassicTaskDetail`, `EvalsInspector` -- the latter's readiness list
   and estimate share one flow) scroll as a whole instead. */
#evals-library-pane {
    overflow-y: auto;
}

#evals-snippet-table {
    overflow-y: auto;
}

#evals-bench-target-table {
    /* `height: auto` (task-1611 T2 fix round 1), overriding Vertical's
       own DEFAULT_CSS `height: 1fr` -- lets the table size to its FULL
       natural row count (every staged target, not a squeezed fraction of
       one). See `#evals-bench-editor`'s own comment (below the "Task 5"
       banner further down this file) for where the resulting overflow
       actually gets absorbed now -- NOT here, and (task-1611 whole-branch
       review fix round) no longer at `#evals-bench-targets-body` either;
       see that selector's own comment for why the one-level-down
       scrollable body this comment used to describe was replaced by ONE
       scroll level higher up. */
    height: auto;
}

/* Task 6 (task-1482): `#evals-bench-targets-section` wraps the heading and
   the row table / Add picker / "+ New target" mini-form together (see
   bench_editor.py's own `_build_targets_section` docstring for why the
   latter three are all children of ONE shared `#evals-bench-targets-body`
   `Vertical`, not siblings of the heading directly).

   `height: auto` (task-1611 whole-branch review fix round) -- this
   section and its body used to be the ONE place in this whole editor
   that scrolled its own overflow locally (`1fr` + `overflow-y: auto`,
   the "shrinking, scrolling `1fr` child" pattern this comment used to
   describe at length, added in task-1611 T2 fix round 1 after `min-
   height` alone made a 4+-target bench WORSE -- see git history / the
   task-1611 report for that full story if it matters again). Whole-
   branch review then found a SEPARATE, worse failure this local scroll
   could not fix at all: a tall `#evals-bench-form-error` callout (this
   task's own reworded mode-revalidation copy, wrapping to 5+ lines at a
   realistic 160x45/120x40 terminal) lives ABOVE this section entirely,
   and no scrolling existed ANYWHERE in `BenchEditor` to reach past it --
   `#evals-bench-editor` itself was still plain `Vertical` `overflow:
   hidden hidden`. The two remedies that same error text NAMES (this
   section's own offending row `Remove` button, and the create-target
   mini-form) got pushed off the bottom of the SCREEN, unreachable by any
   means but flipping the mode back or resizing the terminal.

   Rather than layer a THIRD scroll level on top of the pre-existing one
   here, `#evals-bench-editor` (below) became the SOLE scrollable region
   for the whole form, and this section (and its body) gave up their own
   independent `1fr`/`overflow-y: auto` for plain `auto` -- letting their
   true content height propagate up to the one place that now actually
   absorbs it. Confirmed live this was the right call, not merely the
   simpler one: an EARLIER attempt kept BOTH this section's own scroll
   AND made `#evals-bench-editor` scrollable, and the two DISAGREED --
   `BenchEditor.virtual_size` was computed from this section's own
   COLLAPSED `1fr` box height, not its true (possibly much taller)
   content, so scrolling the outer editor to ITS OWN `max_scroll_y` still
   left the create-target button several rows below the visible screen
   (`Screen.get_widget_at` found nothing there at all -- off the edge of
   the TERMINAL, not merely clipped). See `#evals-bench-editor`'s own
   comment for the single-scroll-level fix that actually holds, verified
   at both 160x45/120x40 (the tall-callout case) and 4/8 targets (the
   fix-round-1 case this replaces). */
#evals-bench-targets-section {
    height: auto;
}

#evals-bench-targets-body {
    height: auto;
}

#evals-inspector-bench,
#evals-classic-detail {
    overflow-y: auto;
}

/* TASK-1476 whole-branch review, clipping blocker: `EvalsInspector`
 * extends `Vertical`, and Textual's `Vertical`/`Container` DEFAULT_CSS is
 * `height: 1fr` -- not `auto`. `#evals-inspector-bench` sits inside
 * `#evals-inspector-pane` (`_lab.tcss`: `height: auto`, itself inside
 * `#lab-inspector`, a `VerticalScroll`), so an UNSTYLED `1fr` child there
 * has no real denominator to resolve against during the parent's `auto`
 * measurement pass -- confirmed live (``run_test(size=(235, 52))``): with
 * a bench selected, `EvalsInspector` claimed a ~43-row region regardless
 * of its own (much shorter) actual content, pushing its sibling
 * `#evals-primary-action` button to a row `#lab-inspector`'s own
 * `virtual_size` never grew to cover -- the button painted nowhere, not
 * even reachable by scrolling to the pane's max_scroll_y. Exactly the
 * off-by-one/starved-sibling family `_lab.tcss` (see its own comment
 * above `#lab-rail #evals-library-pane, #lab-inspector
 * #evals-inspector-pane { height: auto; }`) already fixed one level up,
 * for the PANE itself -- `EvalsInspector`, the pane's own child, needed
 * the identical fix. `overflow-y: auto` above is KEPT (not removed) even
 * though it becomes a no-op once this box always sizes to its own
 * content -- `#evals-library-pane` carries the same now-redundant pairing
 * after its own `_lab.tcss` fix, and this matches that established
 * precedent rather than diverging from it.
 *
 * `#evals-classic-detail` (`ClassicTaskDetail`, also an unstyled
 * `Vertical`) does NOT share this bug -- verified live, not assumed: its
 * parent chain is `#evals-detail-pane` (`_lab.tcss`: `height: 100%`, a
 * REAL bounded size, never `auto`) inside `#lab-body` (a plain `Vertical`,
 * not a `VerticalScroll`), so its own `1fr` resolves against a
 * well-defined remainder with no ambiguous `auto` pass involved -- and it
 * has no trailing sibling below it to displace (`_compose_detail_pane`'s
 * classic branch yields nothing after it), unlike `EvalsInspector`, whose
 * badge/callout/button siblings are exactly what this bug pushed off
 * screen. Left unchanged. */
#evals-inspector-bench {
    height: auto;
}

.evals-rail-section-header {
    height: 1;
    min-height: 1;
    padding: 0 1;
}

.evals-rail-section-label {
    width: 1fr;
    height: 1;
    min-height: 1;
    text-style: bold;
    color: $ds-text-primary;
}

.evals-rail-section-toggle {
    width: 3;
    min-width: 3;
    max-width: 3;
    height: 1;
    min-height: 1;
    padding: 0;
    border: none;
}

.evals-rail-section-body {
    height: auto;
}

.evals-rail-row {
    width: 100%;
    height: 1;
    min-height: 1;
    padding: 0 1;
    border: none;
    text-align: left;
    content-align: left middle;
}

/* Explicit, not relying on the generic `.evals-rail-row { border: none }`
   above to win by cascade order against `.is-active { border: round
   $ds-action-focus }` (components/_agentic_terminal.tcss). Both rules are
   equal specificity (one class each); today `.evals-rail-row` happens to
   be declared later in the manifest, so it wins, but a manifest reorder
   could silently flip that and reintroduce the row's only content line
   being consumed by a round border (a real height-1 button needs at
   least 2 lines for a round border to render at all) -- mirrors
   `#mcp-hub-rail Button.mcp-rail-row.is-active`'s own override for the
   identical reason. */
.evals-rail-row.is-active {
    border: none;
    text-style: bold;
}

.evals-rail-empty-copy {
    color: $ds-text-muted;
    padding: 0 1;
}

/* TASK-1076: the fully-first-run "Start here" callout above the sample
   bench button -- bold and full-text-primary against the muted
   .evals-rail-empty-copy used everywhere else in this rail, so the
   recommended first step reads as visually distinct, not just differently
   worded. Never a colour-only cue (the "Start here" text itself carries
   the meaning). */
.evals-rail-first-run-hint {
    color: $ds-text-primary;
    text-style: bold;
    padding: 0 1;
}

/* Task 6 (empty states, sample bench, export). "No providers configured"
   replaces the BENCHES SECTION BODY only (see library_rail.py's
   _no_providers_message) -- deliberately not the whole rail: Datasets and
   Runs never needed a provider, and classic tasks stay reachable without
   one. These two ids only ever render together, in place of that one
   section's bench list. */
#evals-rail-no-providers {
    padding: 1 1 0 1;
}

#evals-rail-no-providers-detail {
    padding: 0 1 1 1;
}

#evals-rail-open-settings,
#evals-create-sample-bench {
    margin: 0 1 1 1;
    width: auto;
}

/* Dataset authoring and import, side by side -- two compact buttons in one
   row at the top of the Datasets section body (TASK-1478: rendered
   unconditionally, not only above the section's empty-copy line -- see
   library_rail.py's `_dataset_actions`). Class name kept from the earlier
   empty-only version; only the Python call site changed. */
.evals-rail-empty-actions {
    height: auto;
    padding: 0 1;
}

.evals-rail-empty-actions > Button {
    margin: 0 1 0 0;
}

/* Task 4 (task-1482): "+ New bench"'s zero-dataset hint. Same visual
   treatment as `.evals-rail-empty-copy` (muted, one line) but a DEDICATED
   class -- see library_rail.py's `_new_bench_actions` for why it must not
   share that class: `test_first_run_marks_the_sample_bench_as_the_
   recommended_first_step` scopes a query on `.evals-rail-empty-copy`
   within the Benches section specifically to confirm "No benches yet."
   was replaced by the "Start here" hint, not supplemented, and this hint
   (a different message, answering a different question) must not read as
   a second copy of that wording to a class-scoped query. */
.evals-rail-new-bench-hint {
    color: $ds-text-muted;
    padding: 0 1;
}

/* I3: the labelled subgroup separating classic (non-word-bench) tasks from
   word benches under the Benches section -- see library_rail.py's
   CLASSIC_SUBGROUP_LABEL. Inert (a Static, never a Button); styled like
   the empty-copy line above it, never like a selectable row. */
.evals-rail-classic-separator {
    color: $ds-text-muted;
    height: 1;
    min-height: 1;
    padding: 0 1;
}

.evals-pane-title {
    height: 1;
    min-height: 1;
    text-style: bold;
    color: $ds-text-primary;
}

.evals-pane-heading {
    text-style: bold;
    color: $ds-text-primary;
}

#evals-primary-action {
    margin: 1 0 0 0;
    width: 100%;
}

/* task-1482 Task 7 fix round 1: `#evals-duplicate-bench`/`#evals-delete-
   bench` carried no width rule of their own, so Textual's `Button`
   DEFAULT_CSS (`min-width: 16`, otherwise auto-width to its label) was
   the only thing sizing them -- a visibly narrow, off-brand island
   directly beneath the full-width `#evals-primary-action` button above.
   Matches that sibling's own treatment (`width: 100%` plus the same
   top margin, spacing each from the widget above it) rather than
   inventing a second convention for this pane, which has its own
   documented history of geometry defects (see this file's
   `#evals-inspector-bench` comment above). */
#evals-duplicate-bench,
#evals-delete-bench {
    margin: 1 0 0 0;
    width: 100%;
}

/* Task 4 (bench editor + readiness inspector). Status colour lives here,
   in app-tier CSS, never in bench_editor.py/inspector.py's own widget
   CSS -- `.ds-status-badge { color: $ds-text-primary }`
   (components/_agentic_terminal.tcss) outranks any widget DEFAULT_CSS
   regardless of specificity, so a per-status colour has to win the same
   way: an app-tier rule combining `.ds-status-badge` with one of these
   modifier classes. Tests assert the label text, never these colours --
   see Tests/UI/test_evals_bench_editor.py. */
.evals-status-ready {
    color: $ds-status-ready;
}

.evals-status-unavailable {
    color: $ds-status-warning;
}

.evals-status-blocked {
    color: $ds-status-blocked;
}

.evals-status-unchecked {
    color: $ds-text-muted;
}

/* task-1691 Task 2: the captured-continuation sub-line directly under a
   target's readiness badge (inspector.py's `_continuation_static`) -- a
   short, informational sample, never a status of its own, so it is muted
   rather than reusing `.ds-status-badge`'s bold/background treatment
   (which the design contract above reserves for readiness colour only).
   Plain "muted supporting text" is the same treatment `.evals-rail-empty-
   copy`/`.evals-snippet-meta` already use elsewhere in this file, so
   setting `color` directly here (unlike `.ds-status-badge`) does not
   conflict with that contract. The trailing margin separates it from the
   NEXT target's own badge row, mirroring `#evals-inspector-bench .ds-
   recovery-callout`'s identical spacing just below. */
.evals-target-continuation {
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
    color: $ds-text-muted;
}

.evals-bench-target-row {
    height: auto;
    padding: 0 1;
}

/* Task 6 (task-1482): targets become editable. Each row's status Static
   grows to fill the row, with its own per-row Remove button beside it;
   the Add picker (Select + Add button) or the zero-models create-target
   button follows the row table. */
.evals-bench-target-row-wrap {
    height: auto;
    align: left middle;
}

.evals-bench-target-row-wrap > .evals-bench-target-row {
    width: 1fr;
}

.evals-bench-target-remove {
    /* Textual's own `Button` DEFAULT_CSS floors every button at
       `min-width: 16` -- fine for Save/Revert/Add, which have real
       vertical room, but a per-row Remove button sits beside a `1fr`
       label inside a narrow detail pane; at the harness's own DEFAULT
       (80x24, unsized) test width, 16 columns left the label under 3
       columns of its own `1fr` share and its `Static` came back with a
       `region.height` of `0` -- confirmed live, not merely reasoned
       about, via `test_bench_with_duplicate_target_id_composes_without_
       raising`. "Remove" is 6 cells; 10 gives it a little breathing room
       without the stock floor eating most of the row.
    */
    width: 10;
    min-width: 10;
    margin: 0 0 0 1;
}

#evals-bench-add-target-row {
    /* No top margin (unlike most section-trailing controls in this file)
       -- see the `.evals-bench-target-remove` comment above and the
       Task 6 comment further up: this section's total footprint is
       already the tightest margin in the whole form at a realistic
       viewport, and every extra row here is one `#evals-detail-pane`
       might not have left.

       `height: 1`, not `auto` (task-1611 T2 fix): with `auto`, this
       Horizontal measured a full 2 rows even though every child inside
       it (the compact `Select`, the `Add` `Button`) renders at height 1
       -- confirmed live by walking every descendant's own `region` (the
       closed `SelectOverlay`'s own intrinsic height apparently still
       counted toward the parent `Horizontal`'s `auto` measurement pass
       despite rendering at a literal `Region(0, 0, 0, 0)`). That phantom
       row was invisible before task-1611 T2 -- the zero-models "Create
       target" button that used to sit here was small enough to still
       fit below it -- but became the exact one row of slack task-1611
       T2's own "+ New target" mini-form needed and did not have,
       pushing `#evals-bench-create-target` a row too far down: in-bounds
       on paper but painted underneath this app's own screen-wide footer
       bar (confirmed via `Screen.get_widget_at`, not merely inferred
       from the region numbers) once a real target row was ALSO present
       (`test_every_pane_descendant_stays_within_its_pane`, using
       `seeded_bench`, a one-target bench). */
    height: 1;
    align: left middle;
}

#evals-bench-add-target-row > Select {
    width: 1fr;
}

#evals-bench-add-target-row > Button {
    width: auto;
    margin: 0 0 0 1;
}

#evals-bench-create-target {
    width: auto;
}

/* Task-1611 T2: the "+ New target" mini-form -- ALWAYS rendered now
   (unlike the Add picker above, which still disappears with zero
   `llama_cpp` rows), so it sits directly below whichever of those two
   states is showing, as the LAST child of `#evals-bench-targets-body`
   (fix round 1 -- see that selector's own comment for why it, the row
   table, and the Add picker share ONE scrollable body instead of each
   being an independent fixed sibling). `height: auto` (not `1fr`).

   Name, the steering `Input`, and the `Button` ALL share ONE row --
   neither `Input` carries a separate label `Static` (their descriptive
   text is a `placeholder` instead) and both are `compact` (border-less, 1
   row instead of the top-level fields' bordered 3). See `bench_editor.
   py`'s own `_build_create_target_control` docstring for the two SEPARATE
   live failures ("`Widget.region` beyond the screen's own bottom edge" /
   "in-bounds but painted under this app's own footer bar, confirmed via
   `Screen.get_widget_at`") that drove this specific, maximally-compact
   shape -- this targets section has a small, FIXED budget inside
   `#evals-detail-pane` at a realistic viewport, and the Add picker row
   that appears the moment a first target exists shrinks it further
   still. */
#evals-bench-create-target-form {
    height: auto;
    align: left middle;
}

#evals-bench-create-target-form > Input {
    width: 1fr;
    margin-right: 1;
}

#evals-bench-create-target-form > #evals-bench-create-target {
    width: auto;
}

.evals-classic-run-row {
    height: 1;
    min-height: 1;
    padding: 0 1;
}

#evals-inspector-bench .ds-recovery-callout {
    margin: 0 0 1 0;
}

/* Whole-branch review, task-1611 fix round (final): `BenchEditor` itself
   (`#evals-bench-editor`) is now vertically scrollable -- the ONE and
   ONLY scroll level in this whole widget now (see `#evals-bench-targets-
   section`'s own comment for why its ONE-level-down scroll, added just
   one fix round earlier, was removed rather than kept alongside this
   one). Unstyled before this fix, it inherited `Vertical`'s own
   `overflow: hidden hidden` DEFAULT_CSS -- content taller than its
   `1fr`-computed box (see `#evals-detail-pane`'s own `height: 100%` in
   `_lab.tcss`, which is what gives this widget a REAL bounded height to
   overflow at all) was simply clipped, with no way to reach it: confirmed
   live that a `#evals-bench-form-error` callout tall enough to need it
   (this task's own reworded mode-revalidation copy, 5+ wrapped lines at
   a realistic 160x45/120x40 terminal) pushed BOTH remedies the error
   text itself names -- the offending target row's own `Remove` button
   AND the "+ New target" mini-form -- off the bottom of the SCREEN
   entirely, with `editor.scroll_to()` moving nothing (`allow_vertical_
   scroll` was `False`). The user was told to do two things they could
   neither see nor reach; only flipping the mode `Select` back or
   resizing the terminal escaped. Pre-existing (the Top-K error callout
   already did this at 160x45, unrelated to this task -- confirmed live
   that at 120x40 even the plain, no-error form already needed scrolling
   just to reach `#evals-bench-save` at all), but this task's own copy --
   which explicitly instructs "remove it" / "create a new target", both
   now-hidden controls -- walks a user straight into it, so it is fixed
   here rather than left as a known gap.

   Tried FIRST, and rejected on live evidence, not merely reasoned about:
   keeping `#evals-bench-targets-section`'s own local `1fr` +
   `overflow-y: auto` scroll (task-1611 T2 fix round 1's fix for the
   4+-target case) AND adding this outer scroll on top of it. The two
   disagreed: `BenchEditor.virtual_size` is computed from each child's own
   COMPUTED box, and that section's box stayed its old, small `1fr` share
   regardless of how tall its OWN (separately scrolling) content actually
   was -- so scrolling THIS outer container to its own `max_scroll_y`
   still left the create-target button several rows below the visible
   terminal (`Screen.get_widget_at` found NOTHING there, not merely a
   clipped widget -- off the edge of the screen the harness itself was
   sized to). Removing that inner scroll (`#evals-bench-targets-section`/
   `#evals-bench-targets-body` are now plain `height: auto`, letting their
   TRUE content height propagate all the way up) so this ONE outer scroll
   is the sole place anything gets absorbed fixed it -- confirmed live at
   both 160x45 and 120x40 for the tall-callout case this fix targets, AND
   at 4/8 targets (fix round 1's own case) with no separate mechanism
   needed for it anymore: the row table, listed first inside the targets
   body, simply contributes more to THIS container's virtual height, and
   scrolling reaches it exactly the same way it reaches the "+ New
   target" mini-form below it.

   `overflow-y: auto` here is a near-NO-OP in the steady (no tall
   callout, few targets) state -- confirmed live: this widget's virtual
   content height sits at or just under its box height in that case, so
   `max_scroll_y` stays `0` and nothing scrolls that didn't already fit.
   A `min-height`-only alternative was NOT tried here: this pane's own
   history (see `#evals-bench-targets-section`'s comment) already proved
   that lever wrong twice for a materially similar "content taller than
   its `1fr` box" shape, and there is no fixed floor to reserve for an
   error callout whose height is itself variable, unbounded prose. */
#evals-bench-editor {
    overflow-y: auto;
}

/* Task 5 (task-1482): the bench editor's own form fields (name,
   description, prompt mode, top-K, probes). Field WIDTHS follow
   #evals-grid-controls > Select's own precedent just above -- Input
   already defaults to width:100% (textual/widgets/_input.py), but Select
   does not carry an equivalent override in its own DEFAULT_CSS, so left
   unstyled here it would size to its current option's label rather than
   filling the row the way every Input beside it does. Labels reuse the
   app-wide `.form-label` (components/_forms.tcss); this class only trims
   its default bottom margin, which reads as too much air between a
   one-line label and the field directly under it in this narrow pane. */
.evals-bench-field-label {
    text-style: bold;
    color: $ds-text-primary;
    margin-bottom: 0;
}

#evals-bench-prompt-mode {
    width: 1fr;
    margin-bottom: 1;
}

#evals-bench-name,
#evals-bench-description,
#evals-bench-top-k {
    margin-bottom: 1;
}

/* Bounded, not the widget's own default `1fr` (textual/widgets/_text_area.
   py) -- an unbounded probes editor would compete with #evals-bench-
   target-table below for the pane's remaining height every time, on top
   of whatever #evals-bench-probes-preview already claims above it.
   Mirrors mcp_profile_form.py's identical #mcp-form-args/#mcp-form-env
   fix for the same "TextArea defaults to 1fr" trap. */
#evals-bench-probes {
    height: 6;
    min-height: 4;
    margin-bottom: 1;
}

/* The read-only ␣-marker preview of the CURRENTLY SAVED probes (see
   bench_editor.py's compose() -- it renders `config.probes`, never the
   TextArea's live, unsaved content). Bounded and independently scrollable
   so a bench with many probes cannot itself push the Save/Revert buttons
   off screen; #evals-bench-probes right below already answers "what can
   I type", so this list does not also need to grow without limit. */
#evals-bench-probes-preview {
    height: auto;
    max-height: 6;
    overflow-y: auto;
    margin-bottom: 1;
}

.evals-bench-probe-preview-row {
    height: auto;
}

#evals-bench-probes-preview-empty {
    color: $ds-text-muted;
    margin-bottom: 1;
}

/* task-1710 T2: the per-cell continuation opt-in.

   `_conversations.tcss` carries a bare, unscoped `Checkbox { width:
   100%; height: 2; }` type selector that reaches every `Checkbox` app-
   wide (the SAME rule `_agentic_terminal.tcss`'s own `.settings-imagegen-
   backend-row Checkbox` comment already documents overriding, for the
   identical reason) -- confirmed live that it still won over this
   widget's own `compact=True` (`bench_editor.py`'s `Checkbox(...)` call),
   which only drops the `ToggleButton` border/padding, not that global
   `height: 2`. An ID selector beats that bare type selector on
   specificity alone, so this rule reclaims the natural 1-row height
   `compact=True` was meant to buy -- real budget this pane's targets
   section, below, does not have to spare (see `_build_create_target_
   control`'s own "maximally-compact shape" paragraph): a 2-row checkbox
   here, confirmed live, pushed the targets section's Add/Create controls
   off the bottom of a 160x45 terminal. */
#evals-bench-capture-continuations {
    width: auto;
    height: 1;
    min-height: 1;
    margin-bottom: 1;
}

/* CRITICAL, found by live verification against a real llama.cpp: the rule
   above alone made the checkbox unreachable through the UI -- the opt-in
   this whole task exists to add could never actually be turned on.

   Two SEPARATE focus-only decorations, neither controlled by the rule
   above, were fighting this widget's fixed `height: 1`:

   1. `Checkbox`'s OWN `compact=True` DEFAULT_CSS re-adds a border on
      focus (`&.-textual-compact { border: none !important; &:focus {
      border: tall $border; ...} }`) -- confirmed live (`checkbox.region`
      before/after `.focus()`) that this genuinely GREW the widget's
      painted region to 2 rows despite `height: 1` above (a fixed
      `height` does not stop Textual growing the box to fit a border
      added by a LATER-applied `:focus` rule). `border: none` here,
      scoped to `:focus`, reclaims the fixed 1-row box.
   2. Independently, `core/_reset.tcss`'s global `*:focus { outline:
      solid $ds-focus-accent; }` fallback -- ALREADY documented there as
      painting "OVER the widget's outermost rendered lines" for exactly
      this failure mode (see that file's own `DataTable`/TASK-1034
      cross-reference) -- was what erased the label/state glyph entirely
      while focused: confirmed live by reading the compositor's own
      painted strip at the checkbox's row, before and after this fix
      (`▐X▌ Capture a continuation...` vs. blank). `outline: none` here
      restores it; the widget's OWN compact `:focus` rule already
      recolours the label (bold underline, tinted background -- also
      confirmed live in the compositor's per-segment `Style`), so a real,
      content-safe focus cue survives losing the outline, matching this
      reset rule's own documented "prefer content-safe recolouring"
      guidance rather than leaving focus with no cue at all.

   Both were purely VISUAL bugs on their own, but together they broke
   REAL keyboard/mouse interaction, not just appearance: fix #1's height
   growth shifted every sibling below the checkbox down by one row WHILE
   it held focus; clicking `#evals-bench-save` immediately afterward
   computes a single fixed screen offset for its whole Down/Up/Click
   sequence (`Pilot._post_mouse_events`, and identically for a real
   terminal's own mouse driver) -- if the checkbox's OWN blur (triggered
   by that same click moving focus away from it) shrinks it back to 1 row
   BETWEEN that sequence's events, the Save button has already shifted up
   from under the click's fixed offset by the time the terminal `Click`
   event needed to fire `Button.Pressed` arrives, so `_on_save_pressed`
   never runs at all -- confirmed live (a temporary print inside that
   handler) that it was NEVER CALLED after a checkbox click, not merely
   called with a stale value. `capture_continuations` read back through
   `load_bench` was `False` after every attempt for exactly this reason:
   Save itself was silently swallowed, regardless of whether the
   checkbox's own `.value` was already `True`. Fixing the height growth
   (mutation #1 above) removes the reflow that swallows the NEXT click
   entirely, independent of the outline fix. */
#evals-bench-capture-continuations:focus {
    border: none;
    outline: none;
}

#evals-bench-form-error {
    margin-bottom: 1;
}

#evals-bench-form-actions {
    height: auto;
    margin-bottom: 1;
}

#evals-bench-form-actions Button {
    margin: 0 1 0 0;
}

/* Task 5 (snippet editor + import). The whitespace marker itself is a
   Rich inline style embedded directly in each row's Text content (see
   snippet_editor.py's WHITESPACE_MARKER_GLYPH/_WHITESPACE_MARKER_STYLE) --
   not a CSS class -- because a Rich Text object passed as a Static's
   content cannot reference Textual's $ds-* design tokens. This block only
   lays the table out; it never colours the marker or the status text
   (never colour, per the design contract -- tests assert the rendered
   text, in Tests/UI/test_evals_snippet_editor.py). */
.evals-snippet-table-header {
    text-style: bold;
    color: $ds-text-primary;
    padding: 0 1;
}

.evals-snippet-row {
    height: auto;
    padding: 0 1;
}

.evals-snippet-index {
    width: 4;
    color: $ds-text-muted;
}

.evals-snippet-text {
    width: 1fr;
}

.evals-snippet-meta {
    width: auto;
    color: $ds-text-muted;
}

#evals-snippet-editor-summary {
    color: $ds-text-muted;
}

#evals-snippet-warnings-summary {
    margin: 1 0 0 0;
}

#evals-import-snippets {
    margin: 1 0 0 0;
}

/* Task 1 (results grid + lenses). The grid fills its detail pane; the
   DataTable does its own row virtualization/scrolling once given a real
   height via `1fr`, so -- unlike #evals-snippet-table/#evals-bench-target-
   table above, which are plain Static lists with no scrolling of their
   own -- the wrapping #evals-results-grid does not need `overflow-y: auto`
   itself. */
#evals-results-grid {
    /* `1fr`, not `100%` -- which is what the comment above always claimed.
       `100%` is the full parent height regardless of siblings, so with the
       meta row above it the grid ran exactly one line past the bottom of
       the detail pane. The pane's old `border: solid` happened to absorb
       that overflow; removing the border when Evals moved onto the Lab
       frame exposed it. `1fr` takes what is left after siblings, which is
       what "fills its detail pane" means. */
    height: 1fr;
    min-height: 0;
}

#evals-grid-meta,
#evals-grid-state {
    height: 1;
    min-height: 1;
    color: $ds-text-muted;
}

/* TASK-1036: the run view's degenerate-canary callout -- same
   .ds-recovery-callout base styling (border/background/padding, from
   components/_agentic_terminal.tcss) as #evals-inspector-bench's own
   callout above, plus the identical trailing margin so it reads as the
   same design element on both views, per the design contract's "bench
   view and run view agree on how prominently it is presented". */
#evals-grid-canary-callout {
    margin: 0 0 1 0;
}

/* TASK-1477: the run-level failure callout -- same treatment as the
   canary callout directly above (shared .ds-recovery-callout base, same
   trailing margin so the two stack consistently when both are present). */
#evals-grid-failure-callout {
    margin: 0 0 1 0;
}

#evals-grid-controls {
    height: auto;
    margin: 0 0 1 0;
}

#evals-grid-controls > Select {
    width: 1fr;
}

#evals-grid-table {
    height: 1fr;
    min-height: 0;
}

/* TASK-1034 lived here: the global `*:focus { outline: solid
   $ds-focus-accent; }` fallback (core/_reset.tcss) paints its outline OVER
   the widget's outermost rendered lines, and a `DataTable`'s first line is
   its column header -- so a focused results grid lost its header, and the
   "[warned]" canary marker riding inside it, entirely. That was fixed here
   with an id-scoped `outline: none` plus a header recolour.

   TASK-1160 found the same rule silently eating clicks on the bottom row
   of every focused table in the app and moved BOTH halves of that fix --
   the suppressed outline and the header recolour -- to a bare
   `DataTable:focus` type selector in components/_lists.tcss, which this
   table now inherits unchanged. The id-scoped rules were removed rather
   than left in place, so there is one mechanism, not two.
   Tests/UI/test_evals_results_grid.py::
   test_focused_results_grid_keeps_its_header_and_the_warned_marker still
   guards the header against a real compositor render. */

/* Focused-cell detail can run to many lines (a full top-K plus a probe
   table) -- scrolled at this level per the I4 convention above, mirroring
   #evals-inspector-bench/#evals-classic-detail (no separate list-body vs.
   sibling-control split needed here).

   task-1710 T2: `height: auto` added -- `EvalsCellInspector` is an
   unstyled `Vertical` (Textual DEFAULT_CSS: `height: 1fr`), mounted as a
   direct child of `#evals-inspector-pane` alongside a trailing
   `#evals-primary-action` sibling, EXACTLY the shape
   `#evals-inspector-bench`'s own `height: auto` comment (above in this
   file) documents as the clipping bug: an unstyled `1fr` child has no
   real denominator during the parent's `auto` measurement pass, so it
   claims far more height than its own content needs and pushes a
   trailing sibling off `#lab-inspector`'s own scrollable viewport.
   Confirmed live (`run_test(size=(235, 52))`, one target/one snippet
   focused cell): before this fix, `#evals-cell-inspector` claimed a
   36-row region for ~9 rows of actual content, and
   `#evals-primary-action` sat one row outside `#lab-inspector`'s visible
   region (`max_scroll_y == 1`, button unreachable even scrolled to it).
   Pre-existing -- not introduced by this task's own continuation row --
   but in the identical risk class this task's brief flags, and touched
   here rather than left for the row this task adds to inherit silently.
   `overflow-y: auto` above is KEPT for the same reason
   `#evals-inspector-bench`'s own comment keeps it: a no-op once this box
   sizes to its own content, matching that established precedent. */
#evals-cell-inspector {
    overflow-y: auto;
    height: auto;
}

/* Task 3 (task-1691 phase 2): the character card picker (`card_picker.py`).
   `.evals-card-picker` -- not a bare `CardPicker` type selector; no editor
   widget in this whole file uses one -- so this reaches the widget however
   Task 4's bench editor mounts it (its own `id=` is caller-supplied, not
   fixed, per `card_picker.py`'s own module docstring).

   `height: auto`, overriding `Vertical`'s own DEFAULT_CSS `height: 1fr`:
   the picker must size to its OWN content (the search box's one row plus
   the row list's bounded `max-height` below), not claim an arbitrary `1fr`
   share of whatever eventually hosts it -- same convention as
   `#evals-bench-targets-section`'s own `height: auto` above, and for the
   same reason: a sibling control below it (Task 4's Add/Cancel) must get
   whatever room it needs, not be squeezed by this widget silently growing
   to fill unclaimed space it does not actually use. */
.evals-card-picker {
    height: auto;
}

/* The row list itself. Bounded AND independently scrollable -- up to 500
   cards (`evals_state.py`'s own `_LIST_LIMIT`, the read this widget's rows
   are built from) must remain individually reachable by scrolling, never
   silently clipped: `Vertical`'s DEFAULT_CSS is `overflow: hidden hidden`,
   which would otherwise make every row past whatever fits the bounded box
   permanently unreachable by any means (not merely off-screen -- there
   would be no scrollbar and no scroll action to reach it), the same
   "vanished, not merely clipped" failure `#evals-bench-probes-preview`
   above already guards its own list against. `max-height: 10` mirrors that
   rule's own `max-height: 6` (scaled up: a card list is the picker's
   entire reason to exist, so it gets more of the picker's own budget than
   a read-only probe preview gets of the bench editor's). */
#evals-card-picker-rows {
    height: auto;
    max-height: 10;
    overflow-y: auto;
}

.evals-card-row {
    width: 100%;
}

/* Task 4 (task-1691 phase 2): the character bench editor
   (character_bench_editor.py). Mirrors #evals-bench-editor's own
   single-scroll-level contract above: this widget is the SOLE selection-
   kind-specific child of #evals-detail-pane (a real bounded `height: 100%`
   from _lab.tcss, not an ambiguous `auto` ancestor -- see
   #evals-inspector-bench's own long comment above for the parent-chain
   distinction that DOES need `height: auto`, which does not apply here),
   with nothing after it to starve -- so plain `overflow-y: auto` on
   Vertical's own default `1fr` height is enough, the same pairing
   #evals-bench-editor itself uses. Confirmed live via
   test_evals_character_bench_editor.py's own
   test_save_stays_hit_testable_at_realistic_sizes, at both 160x45 and
   235x52, and via test_a_card_past_the_row_cap_is_reachable_inside_the_
   editors_own_scroll for the CardPicker nested-scroll case specifically
   (Task 3's own `#evals-card-picker-rows` bounded `max-height: 10` list,
   mounted one level down inside this widget's own scroll -- proven not to
   strand a row past the fold, not merely assumed to compose cleanly). */
#evals-character-bench-editor {
    overflow-y: auto;
}

.evals-cb-field-label {
    text-style: bold;
    color: $ds-text-primary;
    margin-bottom: 0;
}

#evals-cb-name,
#evals-cb-description,
#evals-cb-samples,
#evals-cb-seed,
#evals-cb-temperature,
#evals-cb-max-tokens {
    margin-bottom: 1;
}

#evals-cb-probe-set {
    margin-bottom: 1;
}

/* The read-only ␣/⏎-marker probe listing -- one line per probe (see
   character_bench_editor.py's `_probe_preview_text`). Bounded and
   independently scrollable, mirroring `#evals-bench-probes-preview`'s own
   precedent for the identical reason: a probe set with many probes must
   not itself push the card picker/targets/sampler fields and Save/Revert
   further than a scroll of `#evals-character-bench-editor` itself can
   reach. */
#evals-cb-probes {
    height: auto;
    max-height: 6;
    overflow-y: auto;
    margin-bottom: 1;
}

.evals-cb-target-row {
    width: 100%;
}

#evals-cb-targets-empty {
    color: $ds-text-muted;
    margin-bottom: 1;
}

#evals-cb-form-error {
    margin-bottom: 1;
}

#evals-cb-form-actions {
    height: auto;
    margin-bottom: 1;
}

#evals-cb-form-actions Button {
    margin: 0 1 0 0;
}

/* Whole-branch review Important 2 (task-1691 phase 2 fix round):
   `ProbeSetDetail` (character_bench_editor.py) -- a bare probe-set
   dataset selected directly from the rail. Same parent-chain shape as
   `#evals-classic-detail` (see that selector's own long comment above):
   the sole selection-kind-specific child of `#evals-detail-pane` (a real
   bounded `height: 100%`, never an ambiguous `auto` ancestor), with
   nothing after it to starve -- so this does not share `EvalsInspector`'s
   bug either, but the rule is kept for the same established precedent
   that comment already documents. */
#evals-probeset-detail {
    overflow-y: auto;
}

#evals-probeset-detail-count {
    margin-bottom: 1;
}

/* Mirrors `#evals-cb-probes` exactly -- the identical bounded,
   independently-scrollable ␣/⏎-marker listing, built by the same shared
   `_probe_listing_widget` helper, just under a different id so both
   widgets can exist in the same screen across a selection change without
   colliding. */
#evals-probeset-detail-probes {
    height: auto;
    max-height: 6;
    overflow-y: auto;
    margin-bottom: 1;
}

/* ===== MODULE: features/_metrics.tcss ===== */
/* ========================================
 * FEATURES: Metrics
 * ======================================== 
 * Metrics display styles
 * ======================================== */

/* --- Metrics Screen Styling --- */
MetricsScreen {
    padding: 1 2; /* Add some padding around the screen content */
    /* layout: vertical; /* MetricsScreen is a Static, VerticalScroll handles layout */
    /* align: center top; /* If needed, but VerticalScroll might handle this */
}

#metrics-container {
    padding: 1;
    /* border: round $primary-lighten-2; /* Optional: a subtle border */
    /* background: $surface; /* Optional: a slightly different background */
}

/* Styling for individual metric labels within MetricsScreen */
MetricsScreen Label {
    width: 100%;
    margin-bottom: 1; /* Space between metric items */
    padding: 1;       /* Padding inside each label's box */
    background: $panel-lighten-1; /* A slightly lighter background for each item */
    border: round $primary-darken-1; /* Border for each item */
    /* Textual CSS doesn't allow direct styling of parts of a Label's text (like key vs value) */
    /* The Python code uses [b] for keys, which Rich Text handles. */
}

/* Style for the title label: "Application Metrics" */
/* This targets the first Label directly inside the VerticalScroll with ID metrics-container */
#metrics-container > Label:first-of-type {
    text-style: bold underline;
    align: center middle;
    padding: 1 0 2 0; /* More padding below the title */
    background: transparent; /* No specific background for the title itself */
    border: none; /* No border for the title itself */
    margin-bottom: 2; /* Extra space after the title */
}

/* Style for error messages within MetricsScreen */
/* These require the Python code to add the respective class to the Label widget */
MetricsScreen Label.-error-message {
    color: $error; /* Text color for errors */
    background: $error 20%; /* Background for error messages, e.g., light red. USES $error WITH 20% ALPHA */
    /* border: round $error; /* Optional: border for error messages */
    text-style: bold;
}

/* Style for info messages (e.g. "file empty") within MetricsScreen */
MetricsScreen Label.-info-message {
    color: $text-muted; /* Or another color that indicates information */
    background: $panel; /* A more subdued background, or $transparent */
    /* border: round $primary-lighten-1; /* Optional: border for info messages */
    text-style: italic;
}
/* --- End of Metrics Screen Styling --- */

/* ===== MODULE: features/_embeddings.tcss ===== */
/* ========================================
 * Embeddings Feature Styles
 * ======================================== */

/* Sidebar title styling */
.sidebar-title {
    text-style: bold;
    margin-bottom: 1;
    padding: 0 1;
    color: $text-muted;
}

/* ========================================
 * Confirmation Dialog Styles
 * ======================================== */

/* Dialog container for modal screens */
#dialog-container {
    align: center middle;
    background: $surface;
    border: thick $primary;
    padding: 2;
    width: 50;
    height: auto;
}

#dialog-title {
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
    width: 100%;
}

#dialog-message {
    text-align: center;
    margin-bottom: 2;
    color: $text-muted;
    width: 100%;
}

#dialog-buttons {
    layout: horizontal;
    align: center middle;
    width: 100%;
    margin-top: 1;
}

#dialog-buttons Button {
    margin: 0 1;
    min-width: 10;
}

/* Modal screen background */
ModalScreen {
    align: center middle;
    background: $background 80%;
}

/* ========================================
 * Form Validation Error Styles
 * ======================================== */

/* Error message displays */
.error-message {
    color: $error;

    margin-top: 0;
    margin-bottom: 1;
    padding: 0 1;
    text-style: italic;
}

.error-message.hidden {
    display: none;
}

/* ========================================
 * Enhanced List Item Styles
 * ======================================== */

.model-header {
    layout: horizontal;
    margin-bottom: 0;
}

.model-name {
    text-style: bold;
    margin-right: 1;
}

.model-provider {
    color: $text-muted;

}

.model-download-status,
.model-memory-status,
.model-size {

    margin-right: 2;
}

.model-size {
    color: $text-muted;
}

/* ========================================
 * Empty State Styles
 * ======================================== */

.empty-state-container {
    width: 100%;
    height: 100%;
    align: center middle;
    padding: 3;
}

.empty-state-content {
    align: center middle;
    width: auto;
}

.empty-state-icon {

    margin-bottom: 1;
    text-align: center;
}

.empty-state-title {
    text-style: bold;

    margin-bottom: 1;
    text-align: center;
}

.empty-state-description {
    color: $text-muted;
    margin-bottom: 2;
    text-align: center;
    max-width: 40;
}

.empty-state-action {
    margin-top: 1;
}

/* ========================================
 * Enhanced Visual Design
 * ======================================== */

/* Enhanced hover states */
/* Button:hover handled in components/_buttons.tcss to fix persistent hover issue */

/* TASK-2300 + review wave I1. This was `Select:hover { border: solid ... }`,
 * which added two rows of chrome to a widget that has no border of its own
 * (a `Select` draws one on its child) -- so on a one-row compact Select the
 * value vanished behind it, on the way TO clicking, before anything had been
 * chosen.
 *
 * The first fix moved it to `Select:hover > SelectCurrent`, which is DEAD:
 * Textual assigns `:hover` to the innermost widget under the pointer that has
 * a hover style, and `_has_hover_style` is derived from the selector NAMES a
 * rule mentions (`css/stylesheet.py:506`). Naming `SelectCurrent` in the rule
 * is what makes `SelectCurrent` the hover target -- so the `Select` never gets
 * `:hover` and `Select:hover > ...` can never match. Measured on the
 * production bundle: `select.mouse_hover=False`, `current.mouse_hover=True`,
 * painted rows identical at rest and hovered.
 *
 * Written to match the mechanism instead of fighting it: the pseudo-class goes
 * on `SelectCurrent`, which is both the widget Textual actually hovers AND the
 * one painting the surface a user sees. `background` rather than `border`, so
 * it recolours cells the widget already draws and moves nothing -- geometry
 * changes on hover are what made C1's frame strobe, because they move the
 * pointer's own target out from under it. `$surface-lighten-1` is this app's
 * established hover background (`ListView ListItem:hover`,
 * `OptionList > .option-list--option-hover`, `DataTable > .datatable--hover`),
 * so the cue now reads the same as every other hoverable row.
 */
Select > SelectCurrent:hover {
    background: $surface-lighten-1;
}


/* Visual separators */
.section-separator {
    height: 1;
    background: $primary-darken-2;
    margin: 2 0;
}

/* ========================================
 * Tooltip and Help Icon Styles
 * ======================================== */

/* Tooltip container */
.tooltip {

    background: $panel;
    border: solid $primary;
    padding: 1;
    max-width: 40;

    display: none;
}

.tooltip-content {
    color: $text;

}

/* Help icon */
.help-icon {

    margin-left: 1;
    color: $primary;
}

.help-icon:hover {
    color: $primary-lighten-1;
}

/* ========================================
 * Chunk Preview Widget Styles
 * ======================================== */

.chunk-preview-widget {
    width: 100%;
    height: auto;
}

.chunk-preview-container {
    width: 100%;
    max-height: 30;
    background: $surface;
    border: round $primary-darken-1;
    padding: 1;
}

.chunk-preview-title {
    text-style: bold;
    margin-bottom: 1;
    color: $primary;
}

.chunk-preview-empty {
    color: $text-muted;
    text-align: center;
    padding: 2;
}

.chunk-item {
    margin-bottom: 2;
    padding: 1;
    background: $panel;
    border: round $primary-darken-2;
}

.chunk-header {
    layout: horizontal;
    margin-bottom: 1;
    padding-bottom: 1;
    border-bottom: dashed $primary-darken-2;
}

.chunk-number {
    text-style: bold;
    color: $accent;
    margin-right: 2;
}

.chunk-range {
    color: $text-muted;

    margin-right: 2;
}

.chunk-size {
    color: $text-muted;

}

.chunk-overlap {
    background: $warning 20%;
    padding: 0 1;
    margin-bottom: 1;
    border-left: thick $warning;
    text-style: italic;
    color: $text-muted;
}

.chunk-content {
    padding: 0 1;

}

.chunk-truncated {
    color: $text-muted;
    text-style: italic;
    text-align: right;
    margin-top: 0;
}

.chunk-more {
    text-align: center;
    color: $text-muted;
    text-style: italic;
    margin-top: 1;
}

.chunk-boundary {
    text-align: center;
    color: $primary-darken-1;
    margin: 1 0;
}

/* ========================================
 * Batch Selection Styles
 * ======================================== */

.batch-controls {
    layout: horizontal;
    margin: 1 0;
    padding: 1;
    background: $surface;
    border: round $primary;
}

.batch-controls.hidden {
    display: none;
}

.batch-button {
    margin: 0 1;
    min-width: 12;
    height: 3;
}

/* ========================================
 * Toast Notification Styles
 * ======================================== */

.toast-manager {
    dock: top;
    align: right top;
    width: auto;
    height: auto;
    margin: 2 2 0 0;
    layer: above;

}

.toast-stack {
    width: auto;
    height: auto;
}

.toast-notification {
    width: 35;
    margin-bottom: 1;
}

.toast-container {
    layout: horizontal;
    padding: 1;
    border: round;
    align: left middle;
}

.toast-icon {
    margin-right: 1;
    min-width: 3;
    text-align: center;
}

.toast-message {
    width: 1fr;
    text-wrap: wrap;
}

.toast-close {
    min-width: 3;
    height: 3;
    margin-left: 1;
    background: transparent;
    border: none;
}

.toast-close:hover {
    background: $background 50%;
}

/* Toast severity styles */
.toast-success {
    background: $success 90%;
    border: solid $success;
    color: $text;
}

.toast-info {
    background: $primary 90%;
    border: solid $primary;
    color: $text;
}

.toast-warning {
    background: $warning 90%;
    border: solid $warning;
    color: $text;
}

.toast-error {
    background: $error 90%;
    border: solid $error;
    color: $text;
}

/* Toast animations */
.toast-slide-in {
    /* Animation properties would go here if needed */
}

/* ========================================
 * Detailed Progress Bar Styles
 * ======================================== */

.detailed-progress-container {
    width: 100%;
    padding: 1;
    background: $panel;
    border: round $primary;
}

.progress-stage-row,
.progress-item-row,
.progress-metrics-row {
    layout: horizontal;
    margin-bottom: 1;
    align: left middle;
}

.progress-action-row {
    layout: horizontal;
    margin-bottom: 1;
    align: right middle;
}

.progress-label {
    width: 12;
    text-align: right;
    margin-right: 1;
    color: $text-muted;
}

.stage-indicator {
    width: 1fr;
    text-style: bold;
    color: $primary;
}

.current-item {
    width: 1fr;
    color: $text;
    text-style: italic;
}

.pause-button {
    min-width: 10;
}

#main-progress {
    margin-bottom: 1;
    height: 3;
}

.stage-progress {
    height: 2;
    background: $surface;
}

.progress-metrics-row {
    margin-top: 1;
    border-top: dashed $primary-darken-2;
    padding-top: 1;
}

.metric-group {
    margin-right: 3;
}

.metric-label {

    color: $text-muted;
    margin-bottom: 0;
}

.metric-value {

    text-style: bold;
    color: $primary;
}

/* ========================================
 * Embedding Template Selector Styles
 * ======================================== */

/* Template selector dialog */
#embedding-template-selector-container {
    width: 80;
    height: 50;
    background: $panel;
    border: thick $primary;
    padding: 2;
}

#embedding-template-selector-title {
    text-style: bold;
    text-align: center;
    margin-bottom: 2;
}

#embedding-template-selector-content {
    height: 1fr;
    margin-bottom: 2;
}

#embedding-template-category-pane {
    width: 25%;
    min-width: 20;
    background: $surface;
    padding: 1;
    border-right: solid $primary-darken-1;
}

#embedding-template-grid-container {
    width: 1fr;
    padding: 1;
    overflow-y: auto;
}

.embedding-template-grid {
    grid-columns: 2;
    grid-gutter: 1;
    padding: 1;
}

/* Template card styles */
.embedding-template-card-container {
    background: $surface;
    border: round $primary-darken-2;
    padding: 1;
    height: auto;
}

.embedding-template-card:hover .embedding-template-card-container {
    background: $surface-lighten-1;
    border: solid $accent;
}

.embedding-template-card-header {
    layout: horizontal;
    margin-bottom: 1;
    align: left middle;
}

.embedding-template-card-title {
    text-style: bold;
    color: $primary;
    width: 1fr;
}

.embedding-template-card-category {

    color: $text-muted;
    background: $primary 20%;
    padding: 0 1;
    border: round $primary;
}

.embedding-template-card-description {
    margin-bottom: 1;
    color: $text-muted;

}

.embedding-template-card-label {

    text-style: bold;
    margin-bottom: 0;
}

.embedding-template-card-list {
    margin-left: 1;
    margin-bottom: 1;
}

.embedding-template-card-item {

    color: $text-muted;
}

.embedding-template-card-button {
    width: 100%;
    margin-top: 1;
}

/* Quick select widget */
.embedding-template-quick-select-container {
    layout: horizontal;
    align: left middle;
    padding: 1;
    background: $surface;
    border: round $primary-darken-2;
    margin-bottom: 1;
}

.embedding-template-select-label {
    margin-right: 2;
    min-width: 10;
}

.embedding-template-quick-button {
    margin-right: 1;
    min-width: 15;
}

.embedding-template-browse-button {
    margin-left: 1;
}

.current-template-name {
    margin-left: 2;
    color: $success;
    text-style: italic;
}

/* ========================================
 * Activity Log Widget Styles
 * ======================================== */

.activity-log-widget {
    width: 100%;
    height: 100%;
}

.activity-log-container {
    width: 100%;
    height: 100%;
    background: $panel;
    border: round $primary-darken-2;
    padding: 1;
}

.activity-log-header {
    layout: horizontal;
    margin-bottom: 1;
    align: left middle;
}

.activity-log-title {
    text-style: bold;

    width: 1fr;
}

.activity-log-actions {
    layout: horizontal;
}

.activity-log-actions Button {
    margin-left: 1;
    min-width: 10;
    height: 3;
}

.activity-log-controls {
    layout: horizontal;
    margin-bottom: 1;
    align: left middle;
}

.filter-button {
    margin-right: 1;
    min-width: 8;
    height: 3;
    background: $surface;
}

.filter-button:hover {
    background: $primary 30%;
}

.filter-button.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.log-search-input {
    width: 20;
}

.activity-log-scroll {
    height: 1fr;
    background: $surface;
    border: round $primary-darken-3;
    padding: 1;
}

.log-entries-container {
    width: 100%;
}

/* Log entry styles */
.log-entry {
    layout: horizontal;
    margin-bottom: 1;
    padding: 0;
    align: left top;
}

.log-timestamp {
    min-width: 10;

    color: $text-muted;
    text-align: right;
    padding-right: 1;
}

.log-icon {
    min-width: 3;
    text-align: center;
}

.log-category {
    min-width: 12;
    color: $primary;

    padding: 0 1;
}

.log-message {
    width: 1fr;
    padding-left: 1;
}

/* Level-specific colors */
.log-info {
    color: $text;
}

.log-info .log-icon {
    color: $primary;
}

.log-success {
    color: $success;
}

.log-success .log-message {
    color: $success;
}

.log-warning {
    color: $warning;
}

.log-warning .log-message {
    color: $warning;
}

.log-error {
    color: $error;
}

.log-error .log-message {
    color: $error;
}

.log-debug {
    color: $text-muted;
    text-style: italic;
}

.log-debug .log-message {
    color: $text-muted;
}

/* Small button styles */
.small-button {
    height: 3;
    min-width: 8;

}

/* ========================================
 * Performance Metrics Widget Styles
 * ======================================== */


.metrics-title {
    text-style: bold;
    text-align: center;
    margin-bottom: 1;

}

.metrics-grid {
    grid-size: 2;
    grid-gutter: 1;
    width: 100%;
    margin-bottom: 1;
}

/* Metric box styling */
.metric-box {
    background: $surface;
    border: round $primary-darken-2;
    padding: 1;
    height: auto;
}


.metric-label {

    color: $text-muted;
}

.metric-value {

    text-style: bold;
    color: $primary;
    text-align: center;
    margin-bottom: 0;
}


.io-rate {
    width: 50%;
    text-align: center;

}

.io-rate:first-child {
    color: $success;
}

.io-rate:last-child {
    color: $warning;
}

/* ===== MODULE: features/_splash.tcss ===== */
/* Splash Screen Styles */

/* Main splash screen container */
SplashScreen, .splash-screen {
    layer: overlay;
    background: $background;
    width: 100%;
    height: 100%;
    align: center middle;
    dock: top;
}

/* Center container for splash content */
#splash-center {
    width: 100%;
    height: 100%;
    align: center middle;
}

/* Content container */
#splash-content {
    width: 100%;
    height: 100%;
    align: center middle;
    padding: 0;
}

/* Main splash display area */
#splash-main, .splash-main {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    margin: 0;
}

/* Splash display widget - the actual content display area */
#splash-display, .splash-display {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    align: center middle;
    padding: 0;
    margin: 0;
}

/* Progress text */
#splash-progress-text, .splash-progress-text {
    width: 100%;
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
}

/* Progress bar styling */
#splash-progress-bar, .splash-progress-bar {
    width: 80%;
    max-width: 100;
    height: 1;
    margin: 0 0 0 0;
    align: center middle;
}

#splash-progress-bar Bar {
    color: $success;
}

#splash-progress-bar PercentageStatus {
    text-style: dim;
}

/* Animation-specific styles */

/* Matrix rain effect */
.matrix-rain {
    color: $success;
    text-style: bold;
}

/* Glitch effect */
.glitch-effect {
    color: $text;
    text-style: bold;
}

.glitch-effect-error {
    color: $error;
    text-style: bold;
}

.glitch-effect-warning {
    color: $warning;
    text-style: bold;
}

.glitch-effect-success {
    color: $success;
    text-style: bold;
}

/* Retro terminal effect */
.retro-terminal {
    color: $success;
    background: rgba(0, 0, 0, 0.9);
    text-style: bold;
}

.retro-scanline {
    background: rgba(0, 255, 0, 0.1);
}

/* Fade effect styles */
.fade-in {
    opacity: 0.0;
}


/* Loading placeholder for lazy-loaded content */
.loading-placeholder {
    color: $text-muted;
    text-align: center;
    padding: 4;
}

/* Hide splash screen when not active */
SplashScreen.hidden {
    display: none;
}

/* ===== MODULE: features/_wizards.tcss ===== */
/* ========================================
 * Wizard Framework Styles
 * ======================================== */

/* ========================================
 * Base Wizard Container
 * ======================================== */

.wizard-container {
    layout: vertical;
    height: 100%;
    width: 100%;
    background: $surface;
    padding: 0;
}

.wizard-title {
    text-style: bold;
    text-align: center;
    background: $primary-darken-2;
    color: $text;
    padding: 1 2;
    margin-bottom: 0;
    border-bottom: thick $primary-darken-1;
    width: 100%;
    height: 3;
}

/* ========================================
 * Progress Indicator
 * ======================================== */

.wizard-progress {
    layout: horizontal;
    align: center middle;
    padding: 2;
    background: $panel;
    border-bottom: solid $primary-darken-2;
    height: auto;
}

.step-indicator-container {
    layout: horizontal;
    align: center middle;
    width: 1fr;
}

.step-number {
    width: 3;
    height: 3;
    border: round $primary;
    background: $panel;
    align: center middle;
    margin-right: 1;
    text-align: center;
}

.step-number.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    border: round $ds-focus-accent;
    text-style: bold underline;
}

.step-number.complete {
    background: $success;
    color: $text;
    border: solid $success;
}

.step-title {
    margin-right: 1;
    color: $text-muted;
}

.step-title.active {
    color: $ds-focus-fg;
    text-style: bold underline;
}

.step-title.complete {
    color: $success;
}

.step-connector {
    height: 1;
    width: 1fr;
    background: $primary-darken-2;
    margin: 0 1;
}

.step-connector.complete {
    background: $success;
}

/* ========================================
 * Step Container
 * ======================================== */

.wizard-steps-container {
    height: 1fr;
    width: 100%;
    overflow-y: auto;
    padding: 0;
    background: $surface;
}

.wizard-step {
    width: 100%;
    height: 100%;
    padding: 2;
    display: block;
    visibility: hidden;
}

.wizard-step.active {
    visibility: visible;
}

.wizard-step.hidden {
    display: none;
}

/* Step animations removed - not supported in Textual */

/* ========================================
 * Navigation Bar
 * ======================================== */

.wizard-navigation {
    layout: horizontal;
    align: center middle;
    padding: 1 2;
    background: $panel;
    border-top: thick $primary-darken-2;
    height: 5;
}

.wizard-progress-text {
    width: 1fr;
    text-align: center;
    color: $text-muted;
}

#wizard-back, #wizard-next {
    min-width: 15;
    height: 3;
}

#wizard-back:disabled {
    opacity: 0.5;
}

#wizard-next:disabled {
    opacity: 0.5;
}

/* ========================================
 * Content Type Selection
 * ======================================== */


.content-type-card {
    background: $panel;
    border: round $primary-darken-2;
    padding: 2;
    align: center middle;
    height: 15;
}

.content-type-card:hover {
    background: $panel-lighten-1;
    border: solid $accent;
}

.content-type-card.selected {
    background: $ds-focus-bg;
    border: round $ds-focus-accent;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.content-type-title {
    text-style: bold;
    margin-bottom: 0;
    text-align: center;
}

.content-type-description {
    color: $text-muted;
    text-align: center;
}

.content-type-card.selected .content-type-title,
.content-type-card.selected .content-type-description {
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* ========================================
 * Content Selection
 * ======================================== */


.content-search-input {
    width: 100%;
    margin-bottom: 2;
}

.content-search-input.hidden {
    display: none;
}


.preview-label {
    text-style: bold;
    margin-bottom: 1;
    color: $primary;
}

.content-list {
    width: 100%;
}

.content-item {
    width: 100%;
    padding: 1;
    margin-bottom: 0;
    border-bottom: dashed $primary-darken-3;
}

.content-item:hover {
    background: $panel 50%;
}




.placeholder-text {
    text-align: center;
    color: $text-muted;
    padding: 2;
}

/* ========================================
 * Quick Settings
 * ======================================== */

.settings-section {
    margin-bottom: 2;
    padding: 1;
    background: $panel;
    border: round $primary-darken-3;
}

.settings-label {
    text-style: bold;
    margin-bottom: 1;
    color: $primary;
}

.settings-input {
    width: 100%;
    margin-bottom: 0;
}

.settings-help {
    color: $text-muted;
    margin-top: 0;
}

.preset-cards-container {
    layout: horizontal;
    margin-bottom: 2;
    padding: 1;
}

.preset-card {
    background: $panel;
    border: round $primary-darken-2;
    padding: 2;
    margin-right: 1;
    width: 1fr;
    height: auto;
}

.preset-card:hover {
    background: $panel-lighten-1;
    border: solid $accent;
}

.preset-card.selected {
    background: $ds-focus-bg;
    border: round $ds-focus-accent;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.preset-icon {
    text-align: center;
    margin-bottom: 1;
}

.preset-name {
    text-style: bold;
    text-align: center;
    margin-bottom: 0;
}

.preset-description {
    color: $text-muted;
    text-align: center;
    margin-bottom: 1;
}

.preset-details {
    border-top: dashed $primary-darken-3;
    padding-top: 1;
}

.preset-detail {
    color: $text-muted;
    margin-bottom: 0;
}

.preset-card.selected .preset-name,
.preset-card.selected .preset-description,
.preset-card.selected .preset-detail {
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Advanced settings */
.advanced-settings-container {
    margin-top: 2;
}

.advanced-toggle {
    width: 100%;
    background: $surface;
    border: round $primary-darken-3;
    color: $text-muted;
    text-align: left;
}

.advanced-toggle:hover {
    background: $panel;
    color: $text;
}

.advanced-settings {
    margin-top: 1;
    padding: 2;
    background: $surface;
    border: round $primary-darken-3;
}

.advanced-settings.hidden {
    display: none;
}

.advanced-settings Label {
    margin-top: 1;
}

.advanced-settings Select,
.advanced-settings Input {
    width: 100%;
    margin-bottom: 1;
}

/* ========================================
 * Processing Step
 * ======================================== */


.progress-text {
    text-align: center;
    text-style: bold;
    margin-bottom: 1;
    color: $primary;
}

.current-item {
    text-align: center;
    color: $text-muted;
    margin-bottom: 2;
    text-style: italic;
}

.progress-stats {
    layout: horizontal;
    align: center middle;
    padding-top: 1;
    border-top: dashed $primary-darken-2;
}

.progress-stats Label {
    width: 1fr;
    text-align: center;
    color: $text-muted;
}


/* ========================================
 * Validation and Errors
 * ======================================== */

.error-message {
    color: $error;
    background: $error 10%;
    border: round $error;
    padding: 1;
    margin: 1;
    text-align: center;
}

/* ========================================
 * Animations and Transitions
 * ======================================== */

/* Staggered entrance animations removed - not supported in Textual */

/* Progress bar animation removed - not supported in Textual */


