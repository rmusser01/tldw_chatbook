/* Media queries not supported in Textual - using fixed layouts */

/* ========================================
 * Chatbook Creation Wizard Specific Styles
 * ======================================== */

/* Basic Info Step */
BasicInfoStep {
    layout: vertical;
    padding: 2;
}

BasicInfoStep .form-group {
    margin-bottom: 2;
}

BasicInfoStep .form-label {
    color: $text-muted;
    margin-bottom: 0;
}

BasicInfoStep .form-input {
    width: 100%;
    margin-top: 0;
}

BasicInfoStep #chatbook-description {
    height: 6;
}

BasicInfoStep .info-box {
    padding: 1;
    background: $boost;
    border: round $primary;
    margin-top: 2;
}

/* Content Selection Step */
ContentSelectionStep {
    layout: vertical;
    height: 100%;
}

ContentSelectionStep .selection-header {
    height: 3;
    padding: 1;
    background: $boost;
    border: round $background-darken-1;
    margin-bottom: 1;
}

ContentSelectionStep .content-tree-container {
    height: 1fr;
}

/* Export Options Step */
ExportOptionsStep {
    layout: vertical;
    padding: 2;
}

ExportOptionsStep .option-group {
    margin-bottom: 2;
    padding: 1;
    background: $boost;
    border: round $background-darken-1;
}

ExportOptionsStep .option-title {
    text-style: bold;
    margin-bottom: 1;
}

ExportOptionsStep .radio-option {
    margin: 0 0 1 1;
}

ExportOptionsStep .checkbox-option {
    margin: 0 0 1 1;
}

/* Preview Confirm Step */
PreviewConfirmStep {
    layout: vertical;
    padding: 2;
}

PreviewConfirmStep .preview-header {
    margin-bottom: 2;
}

PreviewConfirmStep .chatbook-title {
    text-style: bold;
    margin-bottom: 1;
}

PreviewConfirmStep .preview-section {
    margin-bottom: 2;
    padding: 1;
    background: $boost;
    border: round $background-darken-1;
}

PreviewConfirmStep .section-title {
    text-style: bold;
    margin-bottom: 1;
}

PreviewConfirmStep .content-list {
    margin-left: 2;
    color: $text-muted;
}

PreviewConfirmStep .file-tree {
    height: 12;
    border: round $background-darken-1;
    background: $background;
    padding: 1;
    margin: 1 0;
}

PreviewConfirmStep .location-section {
    margin-top: 2;
    padding: 1;
    background: $panel;
    border: round $primary;
}

PreviewConfirmStep .location-path {
    color: $primary;
    margin: 1 0;
}

/* Progress Step */
ProgressStep {
    layout: vertical;
    padding: 2;
    align: center middle;
}

ProgressStep .progress-container {
    width: 100%;
    max-width: 60;
    padding: 2;
    background: $boost;
    border: round $background-darken-1;
}

ProgressStep .progress-title {
    text-align: center;
    text-style: bold;
    margin-bottom: 2;
}

ProgressStep #export-progress, ProgressStep #import-progress {
    margin: 2 0;
}

ProgressStep .progress-status {
    margin: 2 0;
}

ProgressStep .status-item {
    margin: 0 0 1 2;
    color: $text-muted;
}

ProgressStep .status-item.completed {
    color: $success;
}

ProgressStep .status-item.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

ProgressStep .status-item.error {
    color: $error;
}

ProgressStep .completion-message {
    text-align: center;
    padding: 2;
    margin-top: 2;
    background: $success 20%;
    border: round $success;
}

ProgressStep .completion-actions {
    layout: horizontal;
    height: auto;
    align: center middle;
    margin-top: 2;
}

ProgressStep .completion-actions Button {
    margin: 0 1;
}

ProgressStep .hidden {
    display: none;
}

/* ========================================
 * Chatbook Import Wizard Specific Styles
 * ======================================== */

/* File Selection Step */
FileSelectionStep {
    layout: vertical;
    padding: 2;
}

FileSelectionStep .file-selection-container {
    layout: vertical;
    height: 100%;
    align: center middle;
}

FileSelectionStep .drop-zone {
    width: 80%;
    height: 20;
    border: dashed $background-darken-2;
    background: $boost;
    align: center middle;
    margin: 2 0;
}

FileSelectionStep .drop-zone.hover {
    border: solid $primary;
    background: $primary 10%;
}

FileSelectionStep .drop-zone-content {
    text-align: center;
    padding: 2;
}

FileSelectionStep .drop-zone-icon {
    margin-bottom: 1;
    color: $text-muted;
}

FileSelectionStep .drop-zone-text {
    color: $text-muted;
    margin-bottom: 1;
}

FileSelectionStep .file-path-display {
    width: 80%;
    margin: 2 0;
    padding: 1;
    background: $boost;
    border: round $background-darken-1;
}

FileSelectionStep .path-label {
    color: $text-muted;
    margin-bottom: 0;
}

FileSelectionStep .path-value {
    color: $primary;
    margin-top: 0;
}

FileSelectionStep .browse-button {
    margin-top: 2;
}

/* Preview Validation Step */
PreviewValidationStep {
    layout: vertical;
    padding: 2;
}

PreviewValidationStep .preview-header {
    margin-bottom: 2;
}

PreviewValidationStep .chatbook-info {
    padding: 1 2;
    background: $boost;
    border: round $background-darken-1;
    margin-bottom: 2;
}

PreviewValidationStep .info-title {
    text-style: bold;
    margin-bottom: 1;
}

PreviewValidationStep .info-row {
    layout: horizontal;
    height: auto;
    margin: 0 0 1 1;
}

PreviewValidationStep .info-label {
    width: 15;
    color: $text-muted;
}

PreviewValidationStep .info-value {
    width: 1fr;
}

PreviewValidationStep .content-preview {
    padding: 1 2;
    background: $boost;
    border: round $background-darken-1;
    margin-bottom: 2;
}

PreviewValidationStep .preview-title {
    text-style: bold;
    margin-bottom: 1;
    color: $primary;
}

PreviewValidationStep .content-tree {
    height: 15;
    background: $background;
    border: round $background-darken-1;
    padding: 1;
}

PreviewValidationStep .validation-results {
    padding: 1 2;
    background: $boost;
    border: round $background-darken-1;
}

PreviewValidationStep .validation-title {
    text-style: bold;
    margin-bottom: 1;
}

PreviewValidationStep .validation-item {
    margin: 0 0 1 1;
}

PreviewValidationStep .validation-success {
    color: $success;
}

PreviewValidationStep .validation-warning {
    color: $warning;
}

PreviewValidationStep .validation-error {
    color: $error;
}

/* Conflict Resolution Step */
ConflictResolutionStep {
    layout: vertical;
    padding: 2;
}

ConflictResolutionStep .resolution-header {
    margin-bottom: 2;
    padding: 1;
    background: $boost;
    border: round $background-darken-1;
}

ConflictResolutionStep .strategy-section {
    margin-bottom: 2;
    padding: 1 2;
    background: $boost;
    border: round $background-darken-1;
}

ConflictResolutionStep .strategy-title {
    text-style: bold;
    margin-bottom: 1;
    color: $primary;
}

ConflictResolutionStep .radio-option {
    margin: 0 0 1 1;
}

ConflictResolutionStep .strategy-description {
    margin: 0 0 1 3;
    color: $text-muted;
}

ConflictResolutionStep .conflict-preview {
    padding: 1 2;
    background: $boost;
    border: round $warning;
}

ConflictResolutionStep .conflict-title {
    text-style: bold;
    color: $warning;
    margin-bottom: 1;
}

ConflictResolutionStep .conflict-list {
    margin-left: 2;
    color: $text-muted;
}

ConflictResolutionStep .no-conflicts {
    text-align: center;
    padding: 3;
    color: $success;
}

/* Import Options Step */
ImportOptionsStep {
    layout: vertical;
    padding: 2;
}

ImportOptionsStep .options-section {
    margin-bottom: 2;
    padding: 1 2;
    background: $boost;
    border: round $background-darken-1;
}

ImportOptionsStep .section-title {
    text-style: bold;
    margin-bottom: 1;
    color: $primary;
}

ImportOptionsStep .checkbox-option {
    margin: 0 0 1 1;
}

ImportOptionsStep .option-description {
    margin: 0 0 1 3;
    color: $text-muted;
}

/* Import Progress Step */
ImportProgressStep {
    layout: vertical;
    padding: 2;
    align: center middle;
}

ImportProgressStep .progress-container {
    width: 100%;
    max-width: 60;
    padding: 2;
    background: $boost;
    border: round $background-darken-1;
}

ImportProgressStep .progress-title {
    text-align: center;
    text-style: bold;
    margin-bottom: 2;
}

ImportProgressStep #import-progress {
    margin: 2 0;
}

ImportProgressStep .progress-status {
    margin: 2 0;
}

ImportProgressStep .status-item {
    margin: 0 0 1 2;
    color: $text-muted;
}

ImportProgressStep .status-item.completed {
    color: $success;
}

ImportProgressStep .status-item.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

ImportProgressStep .status-item.error {
    color: $error;
}

/* A type that imported nothing (all skipped) or only partly imported is not
 * green -- the colour is part of the claim (task-19734). */
ImportProgressStep .status-item.warning {
    color: $warning;
}

/* The completion banner is coloured by the outcome it reports, so a run that
 * imported nothing cannot be framed in the success palette (task-19734). */
ImportProgressStep .completion-message {
    text-align: center;
    padding: 2;
    margin-top: 2;
    background: $panel;
    border: round $background-darken-1;
}

ImportProgressStep .completion-message.outcome-imported {
    background: $success 20%;
    border: round $success;
}

ImportProgressStep .completion-message.outcome-partial {
    background: $warning 20%;
    border: round $warning;
}

ImportProgressStep .completion-message.outcome-skipped {
    background: $warning 20%;
    border: round $warning;
}

ImportProgressStep .completion-message.outcome-empty {
    background: $panel;
    border: round $background-darken-1;
}

/* A chatbook that HAD items none of which were attempted is not the same as
 * an empty one, and it is not a success either (task-19734). */
ImportProgressStep .completion-message.outcome-excluded {
    background: $warning 20%;
    border: round $warning;
}

ImportProgressStep .completion-message.outcome-failed {
    background: $error 20%;
    border: round $error;
}

ImportProgressStep .completion-stats {
    margin-top: 2;
    padding: 1 2;
    background: $boost;
    border: round $background-darken-1;
}

ImportProgressStep .stat-row {
    layout: horizontal;
    height: auto;
    margin: 0 0 1 0;
}

ImportProgressStep .stat-label {
    width: 20;
    color: $text-muted;
}

ImportProgressStep .stat-value {
    width: 1fr;
    text-align: right;
}

/* ========================================
 * SmartContentTree Styles (used by wizards)
 * ======================================== */

SmartContentTree {
    layout: vertical;
    height: 100%;
}

SmartContentTree .tree-controls {
    height: auto;
    padding: 1;
    background: $boost;
    border: round $background-darken-1;
    margin-bottom: 1;
}

SmartContentTree .search-row {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

SmartContentTree .search-input {
    width: 1fr;
    margin-right: 1;
}

SmartContentTree .filter-button {
    min-width: 12;
}

SmartContentTree .category-filters {
    layout: horizontal;
    height: auto;
    margin-bottom: 1;
}

SmartContentTree .category-checkbox {
    margin-right: 2;
}

SmartContentTree .selection-controls {
    layout: horizontal;
    height: auto;
}

SmartContentTree .selection-button {
    margin-right: 1;
    min-width: 10;
}

SmartContentTree .tree-container {
    height: 1fr;
    border: round $background-darken-1;
    background: $boost;
    padding: 1;
}

SmartContentTree .tree-stats {
    height: 2;
    padding: 0 1;
    text-align: right;
    color: $text-muted;
}

/* Tree node styling */
SmartContentTree Tree > .tree--cursor {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

SmartContentTree Tree > .selected-node {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* ── First-run setup wizard ─────────────────────────────────────────── */
/* TASK-1495: padding/margins on this section were trimmed from their
 * original values (welcome/provider padding "2 4" -> "1 4"; subtitle
 * margin-bottom 2 -> 1) to reclaim just enough vertical budget for the
 * Provider step's API-key Input to fit on screen at 120x40 alongside its
 * (now-capped, see ".setup-choice-list" below) provider list -- see that
 * rule's own comment for the full row-budget accounting. */
.setup-welcome { padding: 1 4; }
.setup-provider { padding: 0 2; }
.setup-title { text-style: bold; text-align: center; margin-bottom: 1; }
.setup-subtitle { color: $text-muted; margin-bottom: 1; }
.setup-provider .setup-title,
.setup-provider .setup-subtitle { margin-bottom: 0; }
.setup-step-error {
    color: $error;
    background: $error 15%;
    text-style: bold;
    margin-top: 1;
}
.setup-field-label { margin-top: 1; }
.setup-probe-status { color: $text-muted; margin-top: 1; }
.setup-summary-row { height: 1; }
.setup-summary-ok { color: $success; }
.setup-summary-missing { color: $error; }

/* TASK-1495: the step region clips without scrolling; primary inputs/CTAs
 * can render below a hard fold with no scrollbar (Provider's API-key field
 * and "Use this server" button; the Full-track Summary's exit buttons).
 * Root cause -- BaseWizard.py (never modified) styles the shared
 * ".wizard-step" class as "height: 100%" with no overflow, and each step's
 * own content wrapper (a plain Vertical) inherits Textual's Vertical default
 * of "height: 1fr; overflow: hidden hidden", so oversized content is clipped
 * by the INNER wrapper before the outer ".wizard-steps-container"'s own
 * "overflow-y: auto" (see above in this file) ever gets a chance to scroll
 * anything -- that container's child (the active step) always measures
 * exactly 100% of its parent, never "overflowing" it by definition.
 *
 * Both rules below are scoped to ".setup-step"/the setup wizard's own
 * per-step classes (added in FirstRunSetupWizard.py, SetupStep.__init__ and
 * each step's compose()) rather than editing ".wizard-step" or
 * ".wizard-steps-container" directly, so the Chatbook create/import wizards
 * (whose steps carry neither class) are byte-for-byte unaffected.
 */
.setup-step {
    /* Height stays 100% (inherited from ".wizard-step") -- this becomes the
     * actual scroll VIEWPORT for the step's content. */
    overflow-y: auto;
}

.setup-welcome,
.setup-provider,
.setup-model,
.setup-voice,
.setup-rag,
.setup-speech,
.setup-tools,
.setup-notes,
.setup-appearance,
.setup-protect,
.setup-summary {
    /* Size to natural content height instead of Vertical's default 1fr, so
     * content taller than the step's 100%-height viewport actually
     * registers as "overflow" for ".setup-step" above to scroll. */
    height: auto;
}

/* Task 2.7: Voice keeps a stable compact control rhythm while the shared
 * setup-step viewport owns scrolling at narrow and short terminal sizes. */
.setup-voice {
    padding: 0 2 1 2;
}

.setup-voice-segmented {
    layout: horizontal;
    height: 3;
    min-height: 3;
    border: solid $primary;
    overflow: hidden hidden;
}

.setup-voice-segmented SetupRadioButton {
    width: 1fr;
    min-width: 0;
    height: 3;
}

.setup-voice-segmented SetupRadioButton.-on {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.setup-voice-output-row {
    height: 5;
}

.setup-voice-output-row > Vertical {
    width: 1fr;
    height: 5;
}

#setup-voice-sample-count {
    height: 1;
    text-align: right;
    color: $text-muted;
}

#setup-voice-test {
    margin-top: 1;
}

#setup-voice-status {
    height: auto;
    min-height: 1;
    margin-top: 1;
}

/* Design intent #2/#3: a step's internal choice list (Provider's ~27-row
 * catalog; Model's up-to-20 discovered models; Appearance's 20+ themes) must
 * not by itself consume the whole step's visible height and push the rest
 * of the step (the API-key field, Summary-style action rows) out of view.
 * RadioSet is a VerticalScroll (Textual default height: auto, no cap) --
 * capping it here gives it its OWN scrollbar so the step's remaining
 * content stays on screen without any manual scrolling.
 *
 * A five-row minimum keeps the control from collapsing as asynchronous
 * labels/statuses change; the seven-row cap exposes more choices when space
 * is available without letting the catalog displace the key field or footer.
 * At supported narrow sizes the containing .setup-step remains the scroll
 * viewport, while the fixed progress/navigation regions stay on screen. */
.setup-choice-list {
    min-height: 5;
    max-height: 7;
    border: solid $primary;
}

.setup-choice-list:focus {
    border: solid $ds-focus-accent;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}

/* TASK-1495 AC #3: the Summary's exit actions are docked to the step
 * viewport's bottom edge (the row is a direct child of the .setup-step
 * scroll container -- see SummaryStep.compose). Docked widgets reserve
 * their own space and never scroll with content, so "Start chatting" /
 * "Done" stay visible however tall the read-back matrix grows. */
.setup-summary-actions {
    dock: bottom;
    height: auto;
    padding: 0 4 1 4;
}
.setup-summary-actions Button {
    margin-right: 2;
}

/* TASK-1497: second structural cue for the selected radio row (the first is
 * the ●/○ glyph swap in SetupRadioButton) — bold survives monochrome. */
.setup-choice-list SetupRadioButton.-on {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    border-left: thick $ds-focus-accent;
    text-style: bold underline;
}

/* TASK-1501: aligned tool rows. Switch is 3 rows tall (bordered); without an
 * explicit row height the unstyled Horizontals let successive switches'
 * borders collide into the next row's label. */
.setup-tool-row {
    height: 3;
    margin-bottom: 1;
}
.setup-tool-row Switch {
    margin-right: 2;
}
.setup-tool-text {
    width: 1fr;
    height: auto;
}
.setup-tool-name {
    text-style: bold;
}
.setup-tool-desc {
    color: $text-muted;
}

/* TASK-1500/1507: tertiary controls (Show all themes…, Skip — explore on my
 * own) — link-like: quiet until focused/hovered, clearly subordinate to the
 * primary choices they sit under. */
.setup-tertiary-button {
    background: transparent;
    border: none;
    color: $text-muted;
    text-style: underline;
    height: 1;
    min-width: 0;
    padding: 0 1;
    margin-top: 1;
}
.setup-tertiary-button:hover {
    color: $text;
    background: transparent;
}
.setup-tertiary-button:focus {
    color: $text;
    text-style: bold underline;
}

/* TASK-1498: section headers inside the provider list, and the pinned
 * found-a-server banner above it. */
.setup-choice-header {
    color: $text-muted;
    text-style: bold;
    padding: 0 1;
}
.setup-detected-banner {
    margin-bottom: 1;
}

#setup-provider-connection {
    height: auto;
    min-height: 7;
}

#setup-provider-endpoint {
    width: 100%;
    min-height: 3;
}

.setup-endpoint-value {
    height: auto;
    min-height: 1;
    text-wrap: wrap;
    color: $text-muted;
}

.setup-provider-connection-actions {
    height: 3;
    min-height: 3;
    margin-top: 1;
}

.setup-provider-connection-actions Button {
    min-width: 12;
    margin-right: 1;
}

#setup-provider-auth-toggle {
    height: auto;
    min-height: 3;
    margin-top: 1;
}

#setup-provider-api-key {
    width: 100%;
    min-height: 3;
}

.setup-detection-results {
    height: auto;
    min-height: 3;
    max-height: 8;
    border: solid $primary;
    margin-top: 1;
}

.setup-detection-results:focus {
    border: solid $ds-focus-accent;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}

/* TASK-1498: the wizard's own show/hide toggles (discovery banner + button,
 * Keep/Replace/Clear row) — the repo's ".hidden" convention is styled only
 * for specific widgets elsewhere, so scope a real display:none here. */
.setup-provider .hidden {
    display: none;
}

/* TASK-1505: persistent key-hints line docked under the wizard. */
.setup-key-hints {
    dock: bottom;
    height: 1;
    color: $text-muted;
    text-align: center;
    background: $panel;
}

FirstRunSetupWizard SetupWizardContainer .wizard-progress {
    height: 4;
    min-height: 4;
    max-height: 4;
    padding: 0 1;
    margin: 0;
}

.setup-progress-item {
    height: 3;
    min-width: 0;
    margin: 0;
}

.setup-progress-item.-active .step-number {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    border: solid $ds-focus-accent;
}

.setup-progress-item.-active .step-title {
    color: $ds-focus-fg;
    text-style: bold underline;
}

.setup-progress-item.-complete .step-number {
    background: $ds-surface-raised;
    color: $ds-text-primary;
    border: solid $success;
}

.setup-progress-item.-complete .step-title {
    color: $ds-text-primary;
    text-style: bold;
}

.setup-progress-item.-upcoming .step-number {
    background: $panel;
    color: $text-muted;
    border: solid $primary;
}

.setup-progress-item.-upcoming .step-title {
    color: $text-muted;
}

/* TASK-1506: key input and its Test button share one row. */
.setup-key-row {
    height: 3;
}
.setup-key-row Input {
    width: 1fr;
}
.setup-key-row Button {
    margin-left: 1;
    min-width: 8;
}

/* TASK-1505: with the key-hints line docked at the screen's bottom, the
 * wizard container must yield that row — height:100% (the shared framework
 * default) would push the navigation bar's last row off screen. Scoped to
 * the setup wizard's own screen. */
FirstRunSetupWizard SetupWizardContainer {
    height: 1fr;
}

FirstRunSetupWizard SetupWizardContainer .wizard-title {
    height: 3;
    padding: 0 2;
    margin: 0;
}

FirstRunSetupWizard SetupWizardContainer .wizard-steps-container {
    height: 1fr;
    padding: 0;
    margin: 0;
}

FirstRunSetupWizard SetupWizardContainer .wizard-navigation {
    height: 4;
    min-height: 4;
    padding: 0 2;
    margin: 0;
}

FirstRunSetupWizard .setup-key-hints {
    height: 1;
    min-height: 1;
}

/* WizardProgress active-step states (TASK-16811): moved here from the
   widget's DEFAULT_CSS so the real $ds-focus-* tokens apply (the local
   fallbacks that used to sit beside them shadowed the bundle's values). */
WizardProgress .step-number.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    border: round $ds-focus-accent;
    text-style: bold underline;
}

WizardProgress .step-title.active {
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* ===== MODULE: features/_chatbooks.tcss ===== */
/* _chatbooks.tcss */
/* Styles for the Chatbooks window */

/* Main window */
ChatbooksWindow {
    background: $background;
}

/* Main horizontal layout */
#main-layout {
    layout: horizontal;
    height: 100%;
}

/* Left sidebar */
#chatbooks-sidebar {
    width: 30;
    background: $panel;
    border-right: solid $background-darken-1;
    padding: 1;
    layout: vertical;
}

.sidebar-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
    text-align: center;
}

#chatbooks-list {
    height: 1fr;
    background: $boost;
    border: round $background-darken-1;
}

#chatbooks-list ListItem {
    padding: 0 1;
    height: 3;
}

#chatbooks-list ListItem:hover {
    background: $surface-lighten-1;
    color: $text;
}

#chatbooks-list ListItem.-highlight {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

/* Right content area */
#content-area {
    width: 1fr;
    layout: vertical;
    padding: 1;
}

/* Header section */
#chatbooks-header {
    background: $boost;
    border: round $background-darken-1;
    padding: 2;
    margin-bottom: 1;
}

.header-title {
    text-style: bold;
    text-align: center;
    color: $primary;
    margin-bottom: 1;
}

.header-subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: 2;
}

#action-buttons {
    layout: horizontal;
    align: center middle;
    height: 3;
}

#action-buttons Button {
    margin: 0 1;
    min-width: 20;
}

/* Dynamic content area */
#dynamic-content {
    height: 1fr;
    background: $boost;
    border: round $background-darken-1;
    padding: 2;
    overflow-y: auto;
}

/* Welcome text */
.welcome-text {
    color: $text;
    padding: 2;
}

/* Status text */
.status-text {
    color: $text-muted;
    text-align: center;
    padding: 2;
}

/* Info text */
.info-text {
    color: $text-muted;
    text-align: center;
    padding: 2;
}

/* Chatbook details */
.chatbook-details {
    layout: vertical;
    padding: 1;
}

.chatbook-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.chatbook-desc {
    color: $text;
    margin-bottom: 1;
}

.chatbook-size {
    color: $text-muted;
    margin-bottom: 1;
}

.chatbook-date {
    color: $text-muted;
    margin-bottom: 2;
}

/* Management buttons */
.management-buttons {
    layout: horizontal;
    height: 3;
    margin-top: 2;
}

.management-buttons Button {
    margin-right: 1;
    min-width: 12;
}

/* Error button variant */
Button.error {
    background: $error;
    color: $text;
}

Button.error:hover {
    background: $error-darken-1;
}

/* Template management styles */
.templates-list {
    layout: vertical;
    height: auto;
    max-height: 20;
    overflow-y: auto;
    margin: 1 0 2 0;
    background: $panel;
    border: round $background-darken-1;
    padding: 1;
}

.template-item {
    padding: 1;
    margin-bottom: 1;
    background: $boost;
    border: round $background-darken-1;
}

.template-item:hover {
    background: $primary 10%;
    border: round $primary;
}

.template-name {
    text-style: bold;
    color: $primary;
    margin-bottom: 0;
}

.template-description {
    color: $text-muted;
    text-style: italic;
}

/* ===== MODULE: features/_scheduling.tcss ===== */
/* ========================================
 * FEATURES: Scheduling
 * ========================================
 * Scheduling workbench specific styles
 * ======================================== */

/* The destination header + sync bar above the tabs are auto-height siblings;
 * without an explicit 1fr the auto-height TabbedContent measures its fr
 * children against the whole content area and overflows past the footer. */
#schedules-shell {
    height: 1fr;
    min-height: 0;
}

#scheduling-tabs {
    height: 1fr;
}

SchedulesWorkbench TabbedContent,
SchedulesWorkbench TabbedContent ContentSwitcher,
SchedulesWorkbench TabbedContent TabPane {
    height: 1fr;
    min-height: 0;
}

#scheduling-workbench {
    layout: horizontal;
    height: 1fr;
    min-height: 10;
    padding: 1;
    margin: 0;
    overflow: hidden;
    border: solid $ds-grid-line;
}

/* Intentional ~30/45/25 width split for the scheduling workbench design plan,
 * expressed with fr units so the three panes share leftover space with the
 * fixed-width vertical dividers. This avoids percentage-based overflow/wrapping
 * and differs from workflows/acp which use a 25/50/25 fr ratio. */
#scheduling-list-pane { width: 3fr; min-width: 30; border: solid $ds-grid-line; padding: 1; }
#scheduling-detail-pane { width: 4fr; min-width: 52; border: solid $ds-grid-line; padding: 1; }
#scheduling-inspector-pane { width: 2fr; min-width: 34; border: solid $ds-grid-line; padding: 1; }

/* The queue table must fill its pane, or empty queues collapse to a single
 * clipped row at short heights (80x24). */
#scheduling-task-table {
    height: 1fr;
}

#scheduling-queue-filter {
    height: 1;
    border: none;
    padding: 0 1;
    margin: 0 0 1 0;
    background: $surface-darken-1;
}

/* Compact mode: the filter's margin row goes to the table (80x24 has
 * exactly one spare row; without this the queue shows only the filter). */
#scheduling-workbench.compact #scheduling-queue-filter {
    margin: 0;
}

SchedulesWorkbench.schedules-workbench-compact #scheduling-workbench {
    padding: 0;
}

SchedulesWorkbench.schedules-workbench-compact #scheduling-list-pane {
    width: 24;
    min-width: 20;
}

SchedulesWorkbench.schedules-workbench-compact #scheduling-detail-pane {
    width: 1fr;
    min-width: 32;
}

SchedulesWorkbench.schedules-workbench-compact #scheduling-inspector-pane {
    width: 20;
    min-width: 16;
}

/* Pane headers */
#scheduling-list-title,
#scheduling-task-detail-header,
#scheduling-task-inspector-header {
    text-style: bold;
    color: $text;
    padding: 0 0 0 0;
    border-bottom: solid $ds-grid-line;
    margin-bottom: 1;
}

/* Empty state */
#scheduling-task-detail-empty-state {
    color: $text-muted;
    text-align: center;
    padding: 3 1;
}

/* Lifecycle action row */
#scheduling-task-detail-lifecycle {
    height: auto;
    padding: 1 0;
    margin-top: 1;
}

#scheduling-task-detail-lifecycle Button {
    margin: 0 1 0 0;
}

/* Follow-in-Console prominence */
#schedules-follow-in-console {
    margin-top: 1;
    width: 100%;
    text-style: bold;
}

#scheduling-task-detail .follow-why {
    color: $text-muted;
    height: auto;
    padding: 0 1;
}

/* Status badge base (detail pane) */
#scheduling-task-status-badge {
    width: auto;
    height: 1;
    padding: 0 1;
    text-style: bold;
    color: $text;
    border: none;
    text-align: center;
}

#scheduling-task-status-badge.waiting {
    background: $primary;
}

#scheduling-task-status-badge.running,
#scheduling-task-status-badge.completed,
#scheduling-task-status-badge.found-results {
    background: $success;
}

#scheduling-task-status-badge.paused,
#scheduling-task-status-badge.needs-attention,
#scheduling-task-status-badge.missed {
    background: $warning;
    color: $text;
}

#scheduling-task-status-badge.blocked,
#scheduling-task-status-badge.conflict {
    background: $error;
}

#scheduling-task-status-badge.disabled,
#scheduling-task-status-badge.archived {
    background: $surface-darken-1;
    color: $text-muted;
}

/* Inspector metadata */
#scheduling-inspector-metadata {
    height: auto;
    padding-bottom: 1;
}

#scheduling-inspector-metadata Horizontal {
    height: auto;
    width: 100%;
    padding: 0;
    margin: 0;
}

.scheduling-inspector-label {
    color: $text-muted;
    padding: 0 1 0 0;
    width: 10;
}

.scheduling-inspector-value {
    color: $text;
    width: 1fr;
    height: auto;
}

#scheduling-conflict-card {
    height: auto;
    margin-top: 1;
}

#scheduling-conflict-card.conflict {
    border: solid $error;
    padding: 1;
    color: $error;
    background: $error 10%;
}

/* Narrow-window degradation: panes are hidden by the workbench's resize
 * handler (with a notice) instead of being silently clipped. */
.pane-hidden {
    display: none;
}

#scheduling-pane-notice {
    color: $text-muted;
    text-style: italic;
    height: auto;
    padding: 0;
}

/* Compact mode (see SchedulesWorkbench.on_resize): the Queue tab label
 * already names the pane; the in-pane title's row goes to the table. */
#scheduling-workbench.compact #scheduling-list-title {
    display: none;
}

/* ===== MODULE: features/_code_repo.tcss ===== */
/* ========================================
 * Code Repository Copy/Paste Feature Styles
 * ======================================== */

/* Repository browser container - now embedded in tab */
.repo-window-container {
    width: 100%;
    height: 100%;
    background: $surface;
    padding: 0;
}

/* ========================================
 * Header Section
 * ======================================== */

.repo-header {
    dock: top;
    height: 7;
    background: $boost;
    padding: 1;
    border-bottom: solid $primary;
}

.repo-header-content {
    layout: grid;
    grid-size: 4 2;
    grid-columns: 3fr 1fr 1fr 1fr;
    grid-rows: 3 2;
    grid-gutter: 1 1;
    width: 100%;
}

.repo-url-input {
    width: 100%;
}

#repo-url-input {
    width: 100%;
}

#load-repo-btn {
    min-width: 10;
}

#token-config-btn {
    min-width: 8;
}

#token-config-btn.token-configured {
    background: $success 20%;
    border: solid $success;
}

#branch-selector {
    min-width: 15;
}

#repo-settings-btn {
    width: 3;
    min-width: 3;
}

/* Selection summary */
.selection-summary {
    column-span: 4;
    layout: grid;
    grid-size: 3 1;
    grid-columns: 1fr 1fr 1fr;
    align: left middle;
    width: 100%;
}

.summary-stat {
    text-align: left;
    color: $text-muted;
}

/* ========================================
 * Filter Bar
 * ======================================== */

.filter-bar {
    dock: top;
    height: 3;
    background: $panel;
    layout: grid;
    grid-size: 6 1;
    grid-columns: 2fr 1fr 3 3 3 1fr;
    grid-gutter: 0 1;
    padding: 0 1;
    border-bottom: solid $primary-darken-1;
}

#file-search {
    width: 100%;
}

#file-type-filter {
    width: 100%;
}

.filter-quick-btn {
    width: 3;
    height: 3;
    min-width: 3;
    padding: 0;
    background: $surface;
    border: solid $primary-darken-2;
}

.filter-quick-btn:hover {
    background: $primary 30%;
    border: solid $primary;
}

/* ========================================
 * Main Content Area
 * ======================================== */

.main-content {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 2fr 3fr;
    height: 1fr;
    background: $background;
}

/* Tree container */
.tree-container {
    border-right: solid $primary;
    overflow: hidden;
    padding: 1;
    background: $surface;
}

#repo-tree {
    height: 100%;
    width: 100%;
    border: none;
}

/* Preview container - now split into two sections */
.preview-panel {
    padding: 1;
    overflow: hidden;
    background: $surface;
    layout: vertical;
    height: 100%;
}

/* Aggregated text container (top half) */
.aggregated-text-container {
    height: 50%;
    margin-bottom: 1;
    layout: vertical;
}

/* File preview container (bottom half) */
.file-preview-container {
    height: 50%;
    layout: vertical;
}

.preview-header {
    height: 3;
    border-bottom: dashed $primary-darken-2;
    margin-bottom: 1;
    padding: 0 1;
    align: left middle;
}

#preview-title {
    text-style: bold;
    color: $primary;
}

#compilation-title {
    text-style: bold;
    color: $primary;
}

.preview-content {
    height: 1fr;
    border: round $primary-darken-2;
    padding: 1;
    background: $surface-darken-1;
    overflow-y: auto;
}

#file-preview {
    width: 100%;
    height: 100%;
    background: $surface-darken-1;
    padding: 1;
}

#aggregated-text {
    width: 100%;
    height: 100%;
    background: $surface-darken-1;
    padding: 1;
}

/* ========================================
 * Tree View Styles
 * ======================================== */

TreeView {
    height: 100%;
    width: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    border: solid $primary-darken-2;
    padding: 1;
    background: $surface;
}

.tree-container {
    width: 100%;
    height: auto;
}

.tree-loading {
    width: 100%;
    text-align: center;
    padding: 2;
    color: $text-muted;
}

.tree-empty {
    width: 100%;
    text-align: center;
    padding: 4;
    color: $text-muted;
}

/* Tree node styles */
TreeNode {
    height: 3;
    width: 100%;
}

.tree-node-row {
    layout: grid;
    grid-size: 4 1;
    grid-columns: auto 3 3 1fr;
    height: 3;
    align: left middle;
    width: 100%;
}

.tree-node-row:hover {
    background: $panel-lighten-1;
}

.tree-node-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.tree-indent {
    width: auto;
    content-align: left middle;
}

.tree-expand-btn {
    width: 3;
    height: 3;
    min-width: 3;
    background: transparent;
    border: none;
    padding: 0;
}

.tree-expand-btn:hover {
    background: $surface-lighten-1;
    color: $text;
}

.tree-expand-spacer {
    width: 3;
    height: 3;
}

.tree-checkbox {
    width: 3;
    height: 3;
}

.tree-content {
    padding-left: 1;
    width: 100%;
    content-align: left middle;
}

/* ========================================
 * Action Bar
 * ======================================== */

.action-bar {
    dock: bottom;
    height: 3;
    background: $panel;
    layout: grid;
    grid-size: 6 1;
    grid-columns: 1fr auto auto auto auto 1fr;
    grid-gutter: 0 1;
    align: center middle;
    padding: 0 2;
    border-top: solid $primary;
}

.action-bar Button {
    min-width: 15;
}

#reset-btn {
    min-width: 10;
}

#generate-compilation-btn {
    min-width: 20;
}

/* ========================================
 * Loading Overlay
 * ======================================== */

.loading-overlay {
    dock: top;
    width: 100%;
    height: 100%;
    background: $background 90%;
    align: center middle;
    layer: above;
}

.loading-overlay.hidden {
    display: none;
}

.loading-overlay LoadingIndicator {
    margin-bottom: 2;
}

.loading-label {
    text-align: center;
    margin-top: 2;
    text-style: bold;
    color: $text;
}

/* ========================================
 * Error Messages
 * ======================================== */

.error-message {
    color: $error;
    text-align: center;
    padding: 2;
    text-style: bold;
}

/* ========================================
 * Responsive Adjustments
 * ======================================== */

/* Note: Textual doesn't support @media queries
   These styles would need to be applied dynamically
   based on terminal size detection in Python code */


/* ========================================
 * Syntax Highlighting Support
 * ======================================== */

#file-preview {
    /* monospace font style */
}

/* ===== MODULE: features/_coding.tcss ===== */
/* ========================================
 * FEATURES: Coding Window
 * ======================================== 
 * Styles for the coding tab and its components
 * Includes sidebar navigation and content areas
 * ======================================== */

/* Main container */
CodingWindow {
    layout: horizontal;
    height: 100%;
    width: 100%;
}

/* Navigation pane (left sidebar) */
.coding-nav-pane {
    dock: left;
    width: 25%;
    min-width: 20;
    max-width: 40;
    background: $boost;
    padding: 1 2;
    border-right: thick $background-darken-1;
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
}

.coding-nav-pane.collapsed {
    width: 0 !important;
    min-width: 0 !important;
    border-right: none !important;
    padding: 0 !important;
    overflow: hidden !important;
    display: none;
}

/* Navigation buttons */
.coding-nav-button {
    width: 100%;
    height: 3;
    margin: 1 0;
    padding: 0 2;
    text-align: left;
    background: $surface;
}

.coding-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}

/* Content pane */
.coding-content-pane {
    height: 100%;
    width: 100%;
    padding: 2;
    background: $background;
}

/* Sidebar toggle button */
#coding-sidebar-toggle-button {
    dock: left;
    width: 3;
    height: 3;
    margin: 0 1 0 0;
    padding: 0;
    text-align: center;
    background: $surface;
}

#coding-sidebar-toggle-button.collapsed {
    dock: left;
    margin-left: 0;
}

/* View areas */
.coding-view-area {
    height: 100%;
    width: 100%;
    padding: 1;
}

/* Pane titles */
.coding-view-area .pane-title {
    text-style: bold underline;
    margin-bottom: 1;
    width: 100%;
    text-align: center;
}

/* Code repository specific */
#coding-view-repo-copy-paste Vertical {
    height: auto;
    align: center middle;
    padding: 2;
}

#coding-view-repo-copy-paste Label {
    margin-bottom: 2;
    text-align: center;
}

#open-repo-selector {
    width: auto;
    min-width: 30;
    height: 3;
    margin-top: 2;
}

/* ===== MODULE: features/_tab_dropdown.tcss ===== */
/* ========================================
 * FEATURES: Tab Dropdown Navigation
 * ======================================== 
 * Dropdown-based tab navigation system
 * Replaces horizontal tab bar with compact dropdown
 * ======================================== */

/* Container for the dropdown - positioned at top of window */
#tab-dropdown-container {
    dock: top;
    width: 100%;      /* Full width of window */
    height: 3;        /* Match the original tab bar height */
    padding: 0 1;
    background: $panel;
    border-bottom: solid $border;
    margin: 0;
    align: center middle;  /* Center the dropdown in the container */
}

/* The Select widget itself */
#tab-dropdown-select {
    width: 30;        /* Fixed width for the dropdown selector */
    height: 100%;
    background: $panel;
    color: $text;
    border: solid $border;
    border-bottom: solid $border;
    padding: 0 1;
    margin: 0;        /* No margin needed - centering handled by container */
}

/* Select widget hover state */
#tab-dropdown-select:hover {
    background: $panel-lighten-1;
    color: $text;
}

/* Select widget focus state */
#tab-dropdown-select:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

/* Dropdown overlay container */
#tab-dropdown-select SelectOverlay {
    background: $background;
    border: solid $border;
    max-height: 20;      /* Limit dropdown height to prevent full-screen coverage */
    margin-top: 0;       /* No gap - directly below the select */
    width: auto;         /* Auto width to fit content */
    min-width: 30;       /* Match the select widget width */
    /* layer: above; */  /* Ensure dropdown appears above other content if supported */
}

/* Individual options in the dropdown */
#tab-dropdown-select SelectOverlay Option {
    padding: 0 2;
    background: $panel;
    color: $text-muted;
    min-height: 3;       /* Comfortable click target */
}

/* Option hover state */
#tab-dropdown-select SelectOverlay Option:hover {
    background: $surface-lighten-1;
    color: $text;
}

/* Currently selected option (when dropdown is open) */
#tab-dropdown-select SelectOverlay Option.-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Disabled state (if needed in future) */
#tab-dropdown-select:disabled {
    opacity: 0.6;
    background: $panel-darken-1;
    color: $text-muted;  /* Using existing variable instead of $text-disabled */
}

/* Loading state (if needed for async operations) */
#tab-dropdown-select.-loading {
    color: $text-muted;
}

/* Textual CSS doesn't support transition animations */

/* Ensure dropdown doesn't interfere with main content */
#content {
    margin-top: 0;   /* No top margin needed - content flows after dropdown */
}

/* ===== MODULE: features/_watchlists.tcss ===== */
/* ========================================
 * FEATURES: Watchlists
 * ========================================
 * Styles for the WatchlistsCollectionsScreen dashboard and panes.
 * ======================================== */

/* Overview dashboard grid and cards.
 *
 * TASK-998, second finding. The UAT called these "seven empty bordered
 * cards" and read it as a first-run problem. It is not: they were empty in
 * EVERY state, populated or not, and had been since the dashboard shipped.
 * Measured at 160x42 with a source present:
 *
 *     #overview-total-sources  region=Region(height=1)  content=Size(height=0)
 *
 * Two compounding causes, one per rule below.
 *
 * The grid had no `height`, so it took `Grid`'s `1fr` default and was handed
 * six rows for three rows of cards plus two gutters -- about one row each.
 * `height: auto` sizes it to the cards instead, which is the only way a fixed
 * card height means anything.
 *
 * And `padding: 1` inside `height: 4` with a `round` border left ZERO content
 * rows: 4 - 2 (border) - 2 (padding) = 0. Even given its four rows the card
 * could not have painted the label or the number. The padding is now
 * horizontal only, so the two lines the card actually renders
 * ("Total sources" / the value) have exactly the two rows they need.
 *
 * This is the same family as TASK-995 and task-875 elsewhere on this screen:
 * a container too short for its children, where the border is the only thing
 * that survives.
 */
#watchlists-overview-grid {
    layout: grid;
    grid-size: 3;
    grid-gutter: 1;
    height: auto;
    margin: 1 0;
}

.overview-card {
    height: 4;
    padding: 0 1;
    background: $surface;
    border: round $surface-lighten-1;
    text-align: center;
    text-style: bold;
}

/* Failed runs table in overview */
#overview-failed-runs {
    height: 1fr;
    border: round $surface-lighten-1;
}

/* Empty state actions */
#wc-empty-actions {
    height: auto;
    margin: 1 0;
}

/* Section detail title */
#watchlists-detail-title {
    text-style: bold;
    color: $text;
}

/* Workbench: rails around a vertically stacked centre */
.watchlists-workbench {
    width: 100%;
    height: 1fr;
    min-height: 0;
}

.watchlists-region-left_rail {
    width: 28;
    min-width: 0;
    height: 100%;
    border: round $ds-grid-line;
}

/* Widened from 28 (Task 5): at 26 usable columns every Inspector action
 * label truncated -- "Stage Watchlists Cont", "Open current Watchlis",
 * "Console follow unavai" -- measured live at 235x52. 34 fits the longest
 * label ("Stage Watchlists Context in Console") close to on one line; the
 * `Button` rule below wraps as a fallback for whatever still does not fit,
 * rather than clipping it.
 *
 * Keeps its region border (Task 6, fix round 3): the ONE box per region is
 * drawn by the region wrapper, and the pane inside is stripped by ID below
 * (`#watchlists-inspector-pane`). See that rule for why the region, not the
 * pane, is the survivor.
 */
.watchlists-region-right_rail {
    width: 34;
    min-width: 0;
    height: 100%;
    border: round $ds-grid-line;
}

.watchlists-region-right_rail Button {
    width: 100%;
    text-wrap: wrap;
}

/* Collapsed breadcrumb levels (Task 5 fix round 2): muted and left-aligned
 * so they read as ancestry, not as an action -- distinct from the deepest
 * level's action buttons directly below them, which keep the default
 * centered/emphasized Button look.
 */
.inspector-breadcrumb {
    color: $ds-text-muted;
    text-align: left;
}

.watchlists-centre {
    width: 1fr;
    min-width: 0;
    height: 100%;
    min-height: 0;
}

/* The always-rendered centre header (section tab strip + the snapshot's
 * loading/error/empty/summary marker), shown above the regions on EVERY
 * tab since task-2513 -- see
 * `WatchlistsCollectionsScreen._build_centre_status_header`. `Vertical`'s
 * own `DEFAULT_CSS` claims `height: 1fr` (textual/containers.py), and an
 * `fr` sibling here would compete with ITEMS's own `1fr`/`2fr` share for
 * the centre's height instead of taking only what its (fixed-height) tab
 * strip and one-line marker actually need. `height: auto` fixes that; no
 * border, this is plain chrome, not a region.
 */
#wl-centre-status {
    height: auto;
}

/* Exactly one box per region (Task 6, fix round 3): the *region wrapper*
 * draws it and the pane inside draws none, rather than the other way round.
 *
 * These two ids are declared in `components/_agentic_terminal.tcss` (the
 * shared destination-pane block, ~line 3544) with `border: solid
 * $ds-grid-line`. An ID selector here matches that block's specificity
 * exactly and wins on source order -- `features/` loads after `components/`
 * in `build_css.py` -- so this narrows to Watchlists' panes and touches
 * none of the other destinations that share that block. (An earlier round
 * wrongly believed stripping the border required editing the shared
 * `.destination-workbench-pane` class and thus 13 other screens.)
 *
 * Suppressing the PANE rather than the REGION is what makes the region
 * boxes uniformly `round` and puts each region's scrollbar inside the box
 * that owns it.
 */
#watchlists-detail-pane,
#watchlists-inspector-pane {
    border: none;
}

/* ITEMS keeps its region border (Task 6, fix round 3) -- the pane inside is
 * stripped by the rule above.
 *
 * `2fr` (fix round 2, human-authorised lever change): ITEMS hosts every
 * section pane and their DataTables, so it gets a double share of the
 * centre stack; CONTENT (below) is content-sized rather than a competing
 * `fr` claimant, which leaves ITEMS the `.watchlists-centre` Vertical's
 * only `fr` sibling and the tall reading area.
 */
.watchlists-region-items {
    width: 100%;
    height: 2fr;
    min-height: 0;
    border: round $ds-grid-line;
}

.watchlists-read-mode .watchlists-region-items {
    height: auto;
    min-height: 10;
    max-height: 50;
    overflow: hidden;
}

.watchlists-read-mode #watchlists-detail-pane,
.watchlists-read-mode #watchlists-items-pane {
    height: auto;
    min-height: 0;
}

.watchlists-read-mode #items-table {
    height: auto;
    min-height: 1;
    max-height: 40;
    overflow-y: auto;
}

#items-pagination {
    height: 1;
    min-height: 1;
}

#items-page-previous,
#items-page-next {
    width: auto;
}

#items-page-label {
    width: 1fr;
    text-align: center;
}

/* Read is a stacked scroll document: CONTENT owns a bounded 20–50-row box,
 * while only its article body scrolls. The outer region clips overflow so
 * its title, actions, footer and border remain fixed around that body.
 */
.watchlists-region-content {
    width: 100%;
    height: auto;
    border: round $ds-grid-line;
}

.watchlists-read-mode .watchlists-region-content {
    height: auto;
    min-height: 20;
    max-height: 50;
    overflow: hidden;
}

/* `Vertical` defaults to `height: 1fr`; use natural height inside the
 * content-sized outer region so short and medium articles grow correctly.
 */
#watchlists-content-pane {
    height: auto;
}

.watchlists-read-mode #watchlists-content-pane {
    height: auto;
    min-height: 0;
}

.watchlists-read-mode #content-body-scroll {
    height: auto;
    min-height: 1;
    max-height: 45;
    overflow-y: auto;
}

/* Keep the action strip one row. Ordinary article verbs fit at the compact
 * width once Button's generic 16-cell floor is removed; change-only verbs
 * use native focus-driven horizontal scrolling. A painted scrollbar would
 * consume this single row, so the scroll owner keeps no scrollbar chrome.
 */
#content-actions {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-size-horizontal: 0;
}

#content-actions Button {
    width: auto;
    min-width: 0;
}

#content-position {
    width: 1fr;
}

/* Solo must actually fill the centre (Task 6, fix round 3, Finding 3).
 *
 * `Z` (`action_solo_region` -> `RegionLayout.solo`) collapses the other
 * centre region to a one-line header. CONTENT is the only capped region,
 * so a soloed CONTENT would stay pinned at its `max-height` while the
 * collapsed header took one row -- the rest of the centre blank.
 *
 * The cap exists so a long article cannot crowd ITEMS. When ITEMS is
 * collapsed there is nothing to crowd, so the cap is lifted (to the full
 * centre height) and the region takes the remaining space. `_region_widget`
 * adds `.watchlists-region-sole-centre` for exactly that state -- see its
 * comment for why it keys on "only expanded centre region" rather than on
 * `RegionLayout.solo_region`.
 *
 * Must stay AFTER `.watchlists-region-content` above: both are single-class
 * selectors, so this only wins the `height`/`max-height` tie on source
 * order.
 */
.watchlists-region-sole-centre {
    height: 1fr;
    max-height: 100%;
}

.watchlists-read-mode
.watchlists-region-items.watchlists-region-sole-centre {
    height: 1fr;
    max-height: 100%;
}

.watchlists-read-mode
.watchlists-region-content.watchlists-region-sole-centre {
    height: 1fr;
    max-height: 100%;
}

.watchlists-read-mode .watchlists-region-sole-centre #watchlists-detail-pane,
.watchlists-read-mode .watchlists-region-sole-centre #watchlists-items-pane,
.watchlists-read-mode .watchlists-region-sole-centre #items-table {
    height: 1fr;
    max-height: 100%;
}

.watchlists-read-mode .watchlists-region-sole-centre #watchlists-content-pane,
.watchlists-read-mode .watchlists-region-sole-centre #content-body-scroll {
    height: 1fr;
    max-height: 100%;
}

.watchlists-region-title {
    height: 1;
    text-style: bold;
    color: $ds-text-primary;
}

.watchlists-region-placeholder {
    color: $ds-text-muted;
}

/* Collapsed regions keep a one-line, focusable header so nothing vanishes.
 *
 * `width: 100%` is only correct when the header is a direct child of the
 * centre `VerticalScroll` (`#wl-centre` / `.watchlists-centre`) -- there "100%"
 * means the centre column's own width. A rail header (LEFT_RAIL/RIGHT_RAIL)
 * is a direct child of the workbench `Horizontal` itself, so the same rule
 * there means the ENTIRE workbench width, pushing every region after it off
 * the right edge of the screen (Finding 1, fix round 2). Rails get a fixed
 * narrow width instead -- the same fixed-width-handle pattern
 * `console_rail_handle.py` uses for its collapsed rail buttons -- with
 * `min-width`/`max-width` pinned so Button's own `min-width: 16` default
 * (textual/widgets/_button.py) can't win the cascade and re-widen it.
 */
.watchlists-region-header {
    height: 1;
    min-height: 1;
    color: $ds-text-muted;
}

.watchlists-centre > .watchlists-region-header {
    width: 100%;
}

.watchlists-workbench > .watchlists-region-header {
    width: 16;
    min-width: 0;
    max-width: 16;
}

/* Section tab strip (Task 3, styled in Task 6 fix round 3 -- folded in by
 * the reviewer because the active section was invisible).
 *
 * `WatchlistsTabStrip.__init__` pins the strip to `height: 1`, and
 * `.watchlists-tab` carried no styling of its own, so the active tab picked
 * up the global `.is-active { border: round $ds-action-focus }`
 * (`components/_agentic_terminal.tcss`). A `round` border needs 2 lines
 * before it has a content line at all, so inside a 1-row strip the button
 * rendered as its own top border and nothing else: the active section's
 * LABEL never painted, which is the one thing the strip exists to show.
 *
 * Fixed here rather than in the shared sheet: that global rule is used by
 * many screens, and it is overridden the same way wherever a height-1
 * control meets it -- `#mcp-hub-rail Button.mcp-rail-row.is-active` and
 * `#mcp-mode-strip .mcp-mode-chip.is-active` in `_agentic_terminal.tcss`
 * both carry exactly this `border: none` + `text-style: bold underline`
 * pair. This mirrors the MCP mode strip, which is the same widget shape (a
 * one-row strip of mode chips), rather than inventing a new active look.
 */
.watchlists-tab-strip Button.watchlists-tab {
    width: auto;
    min-width: 10;
    height: 1;
    padding: 0 1;
    border: none;
}

.watchlists-tab-strip .watchlists-tab.is-active {
    border: none;
    text-style: bold underline;
}

/* Focus must not impersonate the active tab (bold underline above), and the
 * active tab must stay legible while focused -- same split the MCP mode
 * strip uses.
 */
.watchlists-tab-strip .watchlists-tab:focus,
.watchlists-tab-strip .watchlists-tab:hover:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
    outline: none;
    border: none;
}

.watchlists-tab-strip .watchlists-tab.is-active:focus,
.watchlists-tab-strip .watchlists-tab.is-active:hover:focus {
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: bold underline;
    outline: none;
    border: none;
}

/* Tree node labels read as a list, so they align left (TASK-1091).
 *
 * Every node is a `Button`, and Textual centres a Button's label. With names
 * of different lengths that puts each one at a different indent:
 *
 *     ▸     Daily  0
 *     ▸  Security Watch  0
 *
 * The third Watchlists UAT read that leading gap as a stored leading space and
 * filed it as a trimming bug. It is not — `WatchlistBundleService.create`/
 * `rename` both strip before storing, and a whitespace-only name is already
 * rejected (verified directly against the service). The cause is label
 * centring, and left-alignment is the fix.
 *
 * Both properties are required. Textual's Button sets `text-align: center`
 * AND `content-align: center middle`; overriding only the first leaves the
 * label centred, which is what a first attempt at this did.
 */
.watchlist-tree .watchlist-tree-root,
.watchlist-tree .watchlist-tree-watchlist,
.watchlist-tree .watchlist-tree-source {
    text-align: left;
    content-align: left middle;
}

/* Left-rail tree selection highlight (task-876).
 *
 * `WatchlistTree` rendered every node as a `compact=True` Button and never
 * read `tree_scope`, so nothing in the rail showed which node the centre
 * was scoped to -- the scope-named summary in the centre header was the
 * only feedback at all. This does not have the LabModeStrip/tab-strip
 * border-clipping defect -- `compact=True` already forces `border: none
 * !important` (Textual's own Button CSS), so the bundle's global
 * `.is-active { border: round $ds-action-focus; }` never gets a chance to
 * clip anything here. What it DOES need, same as every other `.is-active`
 * consumer in this file, is a legible look: the bare global rule only adds
 * `text-style: bold`, which is too subtle against three different node
 * classes sitting one row apart with no other affordance.
 *
 * Scoped with the `.watchlist-tree` ancestor class (matching the
 * `.watchlists-tab-strip .watchlists-tab.is-active` idiom just above)
 * purely for extra specificity headroom, not because it is required here.
 */
.watchlist-tree .watchlist-tree-root.is-active,
.watchlist-tree .watchlist-tree-watchlist.is-active,
.watchlist-tree .watchlist-tree-source.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

/* Focus must not impersonate the active node (bold, no underline above):
 * the app's global `Button:focus` rule (components/_buttons.tcss) grants
 * `bold underline` to ANY focused button, active or not -- exactly the
 * ambiguity the Watchlists tab strip and Lab/MCP mode strips already guard
 * against. Kept a flat "bold, no underline" for the active node whether or
 * not it also holds focus (rather than the tab-strip's flip to a second
 * palette) since a tree node has no separate "resting active" appearance to
 * preserve.
 */
.watchlist-tree .watchlist-tree-root.is-active:focus,
.watchlist-tree .watchlist-tree-watchlist.is-active:focus,
.watchlist-tree .watchlist-tree-source.is-active:focus,
.watchlist-tree .watchlist-tree-root.is-active:hover:focus,
.watchlist-tree .watchlist-tree-watchlist.is-active:hover:focus,
.watchlist-tree .watchlist-tree-source.is-active:hover:focus {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
    outline: none;
}

/* The tree's write verbs (TASK-895): two one-row strips above the roots.
 *
 * `min-width: 0` is the load-bearing declaration. Textual's own Button CSS
 * pins `min-width: 16` (textual/widgets/_button.py) and `compact=True` only
 * removes the border, not that floor -- so three action buttons in a
 * `Horizontal` would claim 48 columns inside a rail whose interior is 26,
 * and the labels would render clipped with an ellipsis. That is not merely
 * ugly: `Tests/UI/test_destination_visual_parity_correction.py::
 * test_watchlists_left_rail_is_labelled_when_expanded` fails on any `…` in
 * the composited rail, which is how this was caught.
 *
 * At `width: auto` + `padding: 0 1` the two rows measure 21 and 20 columns
 * against 26 available, so both fit whole with the rail at its current
 * width of 28.
 *
 * `height: 1` on the strip matches every other one-row control group on
 * this screen (`.destination-filter-strip`, the tab strip): the rail is a
 * plain `Vertical`, so a strip left at `auto` would size to the tallest
 * child rather than to a row.
 */
.watchlist-tree-actions {
    width: 100%;
    height: 1;
}

.watchlist-tree-actions Button.watchlist-tree-action {
    width: auto;
    min-width: 0;
    height: 1;
    padding: 0 1;
    border: none;
}

/* Why the verbs above are off, when they are. Muted like
 * `.watchlists-region-placeholder`, and `height: auto` so the reason wraps
 * to as many rows as the 26-column rail needs rather than being clipped to
 * one -- a stated reason that does not fit is not a stated reason.
 */
.watchlist-tree-actions-note {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
}

/* TASK-2304 AC#3: what the number after every tree node counts.
 *
 * One row, pinned to one row (`height: 1`) like every other single-line
 * control group on this screen -- the tree is a plain `Vertical`, so a
 * `Static` left at `auto` is fine today but would silently grow if the copy
 * ever wrapped, pushing a watchlist off the bottom of the rail. Muted for
 * the same reason `.watchlist-tree-actions-note` is: it is a caption for the
 * rows below it, not one of them.
 */
.watchlist-tree-count-legend {
    width: 100%;
    height: 1;
    color: $ds-text-muted;
}

/* The two prompts the write verbs need (TASK-895).
 *
 * Centred and sized, unlike the older OPML dialogs in the same module,
 * which are unstyled `ModalScreen`s and therefore fill the terminal from
 * the top-left corner. Type selectors so this reaches the modal screen
 * itself (`align` has to be set on the parent of the box being centred),
 * and the id rules below size the box.
 */
WatchlistNameDialog,
WatchlistSourcePickerDialog,
WatchlistPickerDialog {
    align: center middle;
}

#watchlist-name-dialog,
#watchlist-add-source-dialog,
#watchlist-pick-dialog {
    width: 60;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: $surface;
    border: round $ds-grid-line;
}

/* TASK-2303 AC#3: the line that says what pressing a row does. `height:
 * auto` for the same reason `#watchlist-name-error` has it -- this sentence
 * is the whole point of the row, so it wraps rather than being clipped.
 * Muted because it is a caption for the list below it, not an entry in it.
 */
.watchlist-picker-instructions {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
}

/* The rejection reason for an empty or duplicate name. `height: auto` so a
 * long name's message wraps instead of being clipped -- the whole point of
 * this line is that the user can read why nothing happened.
 */
#watchlist-name-error {
    width: 100%;
    height: auto;
    color: $error;
}

#watchlist-add-source-options,
#watchlist-pick-options {
    width: 100%;
    height: auto;
    max-height: 16;
}

#watchlist-add-source-options Button,
#watchlist-pick-options Button {
    width: 100%;
    min-width: 0;
    height: 1;
    border: none;
    text-align: left;
}

/* TASK-998. The first-run panel that replaces the seven empty Overview cards.
 *
 * `height: auto` on both the wrapper and the body is the load-bearing pair.
 * `Vertical` defaults to `height: 1fr`, so the wrapper would claim the whole
 * region and re-create the "large box containing nothing" this task exists to
 * remove; and a `Static` left at its default single row would clip multi-
 * paragraph copy to its first line, which is the same class of defect as
 * TASK-995 one region over. `text-wrap: wrap` because this copy has to
 * survive the centre pane at 160 columns as well as at 235.
 *
 * No border. The region wrapper (`.watchlists-region-items`) already draws
 * one box, and Task 6's rule for this screen is one border and one heading
 * per region -- an inner box here would be the doubled-chrome defect that
 * task removed.
 */
#overview-first-run {
    width: 100%;
    height: auto;
    padding: 1 0;
}

.watchlists-first-run-title {
    width: 100%;
    height: auto;
    text-style: bold;
    color: $ds-text-primary;
}

.watchlists-first-run-body {
    width: 100%;
    height: auto;
    padding: 1 0 0 0;
    text-wrap: wrap;
    color: $ds-text-muted;
}

/* The Inspector's own first-run line, muted the same way, so the rail reads
 * as one voice with `.watchlists-region-placeholder` rather than as an
 * alert.
 */
#inspector-first-run-hint {
    width: 100%;
    height: auto;
    text-wrap: wrap;
    color: $ds-text-muted;
}

/* TASK-1362 (spec §2): the Inspector's noise-selector editor -- the only
 * edit affordance a source has. Sized exactly like the create form's copy of
 * the field (`#sources-create-ignore-selectors` below): `max-height: 4` is
 * two content rows between the top and bottom border rows, and `height: auto`
 * under that cap stops TextArea's own default from claiming a full `fr` share
 * of the rail and pushing the source's four action buttons off the bottom.
 *
 * Only the TOP border carries a label here (`Ignore (CSS)`); unlike the
 * create form's copy this field has no `border_subtitle`, because the rail is
 * ~26 columns and Textual truncates an over-wide border label silently -- see
 * `InspectorPane._IGNORE_SELECTORS_LABEL`. The row count is unaffected: a
 * bordered widget spends the same two rows either way.
 */
#inspector-noise-selectors {
    width: 100%;
    height: auto;
    max-height: 4;
    margin: 0;
}

#inspector-save-selectors-button {
    width: 100%;
    margin: 0;
}

/* TASK-997. The expand chevron drew on its own indented line ABOVE the
 * watchlist name:
 *
 *     │ Unassigned  0            │
 *     │       ▸                  │
 *     │ Morning AI Brief  0      │
 *
 * `_watchlist_node` now wraps the two buttons in this row so they share a
 * line. `height: 1` is what makes the row a row: `Horizontal` defaults to
 * `height: 1fr`, which inside the rail's `Vertical` would let one watchlist
 * claim whatever vertical space the tree had left.
 *
 * `min-width: 0` on the chevron is the other half of the original defect and
 * is load-bearing, exactly as it is for `.watchlist-tree-action` above:
 * Textual's Button CSS pins `min-width: 16` and `compact=True` removes only
 * the border, not that floor. A one-glyph chevron was therefore SIXTEEN
 * columns wide with the glyph centred in them -- which is why it painted
 * seven columns in from the left edge of a 26-column rail, reading as a
 * stray mark rather than as this watchlist's control.
 *
 * The name button is left at its natural `width: auto` rather than given
 * `1fr`: at `1fr` a name longer than the remaining rail would be ellipsized
 * (`test_watchlists_left_rail_is_labelled_when_expanded` fails on any `…`),
 * and the `is-active` highlight would stretch the full rail width instead of
 * hugging the label the way the sibling root nodes do.
 *
 * `width: 3` and not `2`, which is the tighter look this was first written
 * for: Textual's `Button` reserves a column each side via `line-pad: 1`, so
 * a 2-column button has ZERO content columns and Rich raises
 * `ValueError: range() arg 3 must not be zero` while wrapping the glyph. The
 * obvious `line-pad: 0` is not available -- Textual's integer property parser
 * rejects a literal 0 for it (`_process_integer` errors on `value == 0`), so
 * the stylesheet fails to parse and every rule after it is lost. 3 is the
 * narrowest width that renders.
 *
 * The source rows deliberately get NO rule: their four-space label indent
 * plus Textual's one-column line pad places the left-aligned source name one
 * column past the watchlist name (column 6 versus column 5 in a 26-column
 * rail), so the nesting reads without adding a margin that would only move
 * with the chevron's width.
 */
.watchlist-tree .watchlist-tree-row {
    width: 100%;
    height: 1;
}

.watchlist-tree Button.watchlist-tree-expander {
    width: 3;
    min-width: 0;
    height: 1;
    padding: 0;
    border: none;
}

/* TASK-897. `#sources-toolbar` is a bare `Vertical` wrapping several
 * `.destination-filter-strip` rows, and had no height rule anywhere -- so it
 * inherited Textual's `height: 1fr` default and its size came from whatever
 * its sibling `#sources-table` was not using, rather than from its own
 * controls.
 *
 * With rows in the table that looked fine (measured 160x42: toolbar 3, table
 * 13). With an EMPTY table -- the first thing a new user sees -- the table
 * collapsed to 1 row and the toolbar swallowed the rest: toolbar 15 of a
 * 16-row pane, and 25 of 26 at 235x52. Growing the terminal did not help,
 * because `1fr` grows with it.
 *
 * The four sibling toolbars (runs/items/rules/notifications) are `Horizontal`
 * with `.destination-filter-strip`, which pins `height: 1` in
 * layout/_panes.tcss, so they were never affected. This one is the only
 * wrapper, and so the only one that needed its own rule.
 */
#sources-toolbar {
    height: auto;
}

/* TASK-995. The Sources toolbar rendered as one bare `▊▔▔▔` bar with no
 * controls at all, which blocked the entire new-user path: create a
 * watchlist, press "Create source", and there is no visible way to add one.
 *
 * Two independent causes compounded, and both are fixed here.
 *
 * 1. HEIGHT. `.destination-filter-strip` is `height: 1`
 *    (layout/_panes.tcss) but a bordered `Input`/`Select` is three rows, so
 *    only the top border row survived. The widgets now pass `compact=True`
 *    (sources_pane.py / items_pane.py / watchlists_collections_screen.py),
 *    Textual's own supported one-row form -- the same idiom this codebase
 *    already uses ~300 times, including for `Input`/`Select` in
 *    mcp_server_mutations.py. That is done in Python rather than by
 *    un-pinning the strip: `.destination-filter-strip` is shared chrome
 *    (schedules, workflows and four sibling Watchlists toolbars), and the
 *    one-row strip is this screen's design language -- the tab strip, the
 *    tree action row and the header bar are all one row. Growing the strip
 *    to three rows instead would have cost the Sources table a quarter of
 *    its rows at 160x42, re-opening TASK-897.
 *
 * 2. WIDTH, which the strip's height alone would not have fixed. Nothing
 *    sized these controls, so `Input`'s Textual default (`width: 100%`) and
 *    `_conversations.tcss`'s bare global `Select { width: 100%; }` each
 *    claimed the FULL strip: measured at 160x42 the four of them stacked to
 *    x=31,122,213,304 in a pane 93 columns wide, putting `New source` at
 *    x=395 -- 300 columns off the right edge of a 160-column terminal. The
 *    explicit widths below are what keeps every control on screen.
 *
 *    These must live in the bundle, not in a widget's `DEFAULT_CSS`:
 *    Textual always ranks a CSS_PATH rule above any `DEFAULT_CSS` rule
 *    regardless of specificity, so that bare `Select { width: 100% }` beats
 *    DEFAULT_CSS every time. Same lesson as `#mcp-tools-filter-server-slot
 *    Select` and `#mcp-audit-filter-*` in components/_agentic_terminal.tcss.
 *    `margin: 0` is part of that override too -- the same global rule adds
 *    `margin-bottom: 1`, which would push a one-row Select to two rows.
 *
 * Widths are sized to their longest option label plus the dropdown arrow
 * ("All statuses" 12, "Playlist"/"Inactive" 8), leaving the search box the
 * remainder: 19 columns at 160x42 and 94 at 235x52.
 */
#sources-toolbar Input,
#sources-toolbar Select,
#items-toolbar Input,
#items-toolbar Select,
#watchlists-header-bar Select {
    height: 1;
    min-height: 1;
    margin: 0;
}

#sources-search-input {
    width: 1fr;
    min-width: 12;
}

#sources-type-select {
    width: 12;
}

#sources-status-filter {
    width: 16;
}

#sources-active-filter {
    width: 12;
}

#sources-tags-filter {
    width: 1fr;
    min-width: 12;
}

/* TASK-1035. The create-source form had no rule anywhere, so it took
 * Textual's defaults for its container and painted like an unfinished
 * sketch: `Create` on row 40 and `Cancel` on row 43 with blank rows between
 * them, and `#sources-table` squeezed to a single row underneath.
 *
 * The container is now a `Vertical` rather than a bare `Grid` (see
 * `sources_pane.py`), which fixes the row spread; `height: auto` is what
 * stops it then claiming `1fr` of the pane and starving the table a second
 * way -- the same defect and the same one-line fix as `#sources-toolbar`
 * immediately above (TASK-897).
 */
#sources-create-form {
    height: auto;
    width: 100%;
}

/* TASK-1362. Name and URL share one row so the noise field below has rows to
 * occupy. Measured with the form open at 160x42: the Sources pane is 16 rows
 * (toolbar 2 + form 13 + table 1), i.e. the form had no spare row at all, and
 * a field of any height pushed `Create`/`Cancel` -- and then the table -- past
 * the pane's bottom edge, which is the unreachable-control defect TASK-1035
 * existed to fix. Pairing costs neither Input its border or its size, and it
 * is what this form already does for Type/Active and Tags/cadence.
 */
#sources-create-form .sources-create-identity-row {
    width: 100%;
    height: 3;
}

#sources-create-form #sources-create-name,
#sources-create-form #sources-create-url {
    width: 1fr;
    margin: 0;
}

/* Type + Active share one row. Two things are pinned here.
 *
 * The `Active` label was `width: 1fr` at Textual's default and claimed the
 * whole 168-column row, pushing the `Switch` to x=198 -- one column past
 * the pane's right edge at 235x52, so the only control for "is this source
 * active" was neither visible nor clickable.
 *
 * `margin: 0` on the Select undoes the bare global `Select { width: 100%;
 * margin-bottom: 1; }` in features/_conversations.tcss, which added a blank
 * row under the row and pushed the fields below it further down a pane that
 * has no rows to spare. Same override, same reason, as the toolbar block
 * above.
 */
#sources-create-form .sources-create-type-row {
    width: 100%;
    height: 3;
}

#sources-create-form #sources-create-type {
    width: 1fr;
    margin: 0;
}

#sources-create-form .sources-create-active-label {
    width: auto;
    height: 3;
    content-align: left middle;
    padding: 0 1;
}

/* TASK-2302 AC#3: the visible label for a Select that painted as a bare
 * "RSS ▼". Sized exactly like `.sources-create-active-label` above -- same
 * row, same three rows of height, same vertical centring -- because it is
 * the same idiom, and `width: auto` is what stops it claiming the row and
 * pushing the control it names off the pane's right edge (the defect that
 * comment records for the `Active` label).
 *
 * `height: 3` is overridden to 1 inside the compact destination row below;
 * a `Static` of height 3 in a one-row container is the strip defect
 * TASK-995 fixed, three rows of label over one row of box.
 */
#sources-create-form .sources-create-field-label {
    width: auto;
    height: 3;
    content-align: left middle;
    padding: 0 1;
}

/* TASK-2302 AC#1: the destination row. Compact (one row) for the reason the
 * tags row above it is: the Sources pane is 16 rows at 160x42 and a
 * full-height row would push `Create`/`Cancel` past its bottom edge. The
 * Select needs the same `margin: 0` override as its two siblings -- the bare
 * global `Select { width: 100%; margin-bottom: 1; }` in
 * features/_conversations.tcss otherwise adds a blank row and reintroduces
 * exactly that overflow.
 */
#sources-create-form .sources-create-destination-row {
    width: 100%;
    height: 1;
}

#sources-create-form .sources-create-destination-row
.sources-create-field-label {
    height: 1;
}

#sources-create-form #sources-create-watchlist {
    width: 1fr;
    margin: 0;
}

/* Tags + check cadence share the next row, for the reason spelled out above:
 * the Sources pane is 16 rows tall at 160x42 and a sixth full-height field row
 * would put `Create`/`Cancel` past its bottom edge. The Select needs the same
 * `margin: 0` override as the type Select -- the bare global
 * `Select { width: 100%; margin-bottom: 1; }` in features/_conversations.tcss
 * otherwise adds a blank row beneath it and reintroduces exactly that overflow.
 */
#sources-create-form .sources-create-tags-row {
    width: 100%;
    height: 1;
}

#sources-create-form #sources-create-tags {
    width: 1fr;
    margin: 0;
}

#sources-create-form #sources-create-frequency {
    width: 16;
    margin: 0;
}

/* TASK-1362 (spec §2): the noise control. `max-height: 4` is the whole field
 * -- two rows of selectors between its border rows, with the label on the top
 * border and the help copy on the bottom (see `_IGNORE_SELECTORS_LABEL` in
 * sources_pane.py). Two `Static` rows for that text is two rows this form does
 * not have, and a taller field puts `Create`/`Cancel` off the bottom of a
 * 16-row pane at 160x42. `height: auto` under the cap keeps it from claiming
 * `1fr` of the form the way TextArea's own default would, which is the same
 * defect and the same fix as `#sources-toolbar` and the form container above.
 */
#sources-create-form #sources-create-ignore-selectors {
    width: 100%;
    height: auto;
    max-height: 4;
    margin: 0;
}

/* TASK-2310: a compact, one-row inline label placed immediately before a
 * filter/picker Select inside a `.destination-filter-strip` row (height: 1)
 * -- Sources' type/status/active filters, Items' status filter, Artifacts'
 * mode/preset/cadence pickers, Rules' condition/severity. UAT: these Selects
 * painted bare resting values ("All ▾", "Off ▾") with no clue what
 * they filter. Unlike `.sources-create-field-label` above (a
 * `#sources-create-form`-scoped, height: 3 idiom for a full field row), this
 * is generic and height: 1 to fit inside an EXISTING one-row toolbar strip --
 * no new row, no extra height budget (the same TASK-995 constraint every
 * `.destination-filter-strip` row already lives under). `color: $text-muted`
 * keeps it visually secondary to the Select's own value, which is what the
 * user is actually scanning for.
 */
.watchlists-inline-select-label {
    width: auto;
    height: 1;
    content-align: left middle;
    padding: 0 1 0 0;
    color: $text-muted;
}

/* TASK-2310: the Rule form's Threshold explanation line -- one row, muted,
 * directly under the Threshold Input it describes. `#rules-create-form` is
 * an unstyled single-column `Grid` (Textual's own default), so each child
 * -- including this one -- is already its own row; no width/height fight
 * to win here, just keep it visually secondary like the Select labels above.
 */
.rules-create-threshold-help {
    width: 100%;
    height: 1;
    color: $text-muted;
}

/* TASK-2313: a muted, one-line caption -- used for AC#4's empty-table
 * guidance (Runs/Rules/Notifications, matching in spirit, not literal
 * reuse, Overview's own first-run guidance so a genuinely empty list
 * reads as "nothing here yet" rather than "broken") and for AC#6's
 * persistent column-meaning legends (e.g. Items' Queued glyph).
 */
.watchlists-hint-line {
    width: 100%;
    height: auto;
    color: $text-muted;
    padding: 1 0;
}

/* `.dialog-buttons` (features/_media.tcss) supplies the side-by-side pair
 * itself -- `layout: horizontal`, and `margin: 0 1; min-width: 12` on each
 * Button -- so this form and `WatchlistNameDialog` pair their Create/Cancel
 * the same way rather than stacking them.
 *
 * Two properties are deliberately not inherited. The dialog centres its
 * pair inside a narrow modal; this form is inline and 168 columns wide,
 * where a centred pair would float away from the fields it belongs to. And
 * the dialog's `height: 3` would put the pair a row past the bottom of a
 * 16-row Sources pane at 160x42; one row is also what every other button on
 * this screen uses (`New source`, `Preview`, `Import OPML`, the tree's
 * `New`), so the pair reads as part of the screen rather than a modal
 * dropped into it.
 */
#sources-create-form .sources-create-buttons {
    align: left middle;
    width: 100%;
    height: 1;
}

#items-search-input {
    width: 1fr;
    min-width: 12;
}

#items-status-select {
    width: 16;
}

/* TASK-3791 plan task 5. The pill is a notice, not a verb: no border
 * chrome, content width (the 1fr search box yields to it), and a
 * pointer so its click-to-reload affordance reads as one.
 */
#items-new-items-pill {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

#items-new-items-pill:hover {
    text-style: bold underline;
}

#watchlists-backend-select {
    width: 12;
}

/* TASK-1105 lived here. Clicking any Watchlists table row other than the
 * first left the selection on row 0, so `Preview`, `Check now` and `Delete`
 * all acted on the wrong source. The cause is the app-wide keyboard-focus
 * fallback `*:focus { outline: solid $ds-focus-accent; }` (core/_reset.tcss):
 * Textual paints an `outline` OVER a widget's outermost rendered lines, and
 * the overwritten segments lose the `{"row", "column"}` metadata that
 * `DataTable._on_click` needs, so the bottom row of a FOCUSED table is
 * unclickable. The Sources table is three rows tall here (header + two rows),
 * which left row 0 as the only reachable data row.
 *
 * It was fixed with `.watchlists-region DataTable:focus { outline: none; }`
 * plus a `$ds-focus-bg`/`$ds-focus-fg` cursor recolour, scoped to this
 * screen, and its notes called out that every other table in the app still
 * had it. TASK-1160 promoted exactly those two rules to a bare
 * `DataTable:focus` type selector in components/_lists.tcss, which every
 * region here inherits unchanged, and removed this local copy so there is one
 * mechanism rather than two.
 * Tests/UI/test_watchlists_source_row_click_selects.py still guards the
 * Watchlists behaviour end to end.
 */

/* TASK-1020. The Overview region's and the Inspector's third state: the
 * overview worker has been started and has not answered yet. Muted like
 * `.watchlists-region-placeholder` and `.watchlists-first-run-body` so a
 * transient line does not read as an alert, and `height: auto` so it does not
 * claim the region's rows on the way past.
 */
.watchlists-loading-state {
    width: 100%;
    height: auto;
    text-wrap: wrap;
    color: $ds-text-muted;
}

/* Artifacts pane (spec #2 phase 1, task 4; re-tuned spec #2 phase 2a,
 * task 5): a briefing list over a briefing body, over a scripts list over
 * a script body, all inside the ITEMS region's fixed budget.
 *
 * Task-15779 note: everything below the briefings table now lives inside
 * `BriefingDetailRegion` (`#artifacts-detail-region`, its own rule below)
 * -- the recompose boundary that lets a briefing selection rebuild the
 * detail WITHOUT destroying the table above it. The pane's own `fr` pool
 * is therefore two-deep: the table takes `2fr` against the region's
 * `8fr` (the detail half's old 6+1+1 shares, pooled), and the region's
 * children re-divide that share 6:1:1 among themselves. The reasoning
 * below about each child's share and floor is unchanged -- only the level
 * at which the detail-side `fr`s resolve moved.
 *
 * Every one of the four needs an explicit `fr` share, and the two DETAIL
 * halves are the ones that actually bite. `ArtifactsPane` is a `Vertical`,
 * so its children lay out top to bottom: scope note (1), toolbar (1),
 * table, "Briefing detail" title (1), detail, Cast toolbar (1), scripts
 * table, script detail (no separate title -- see `ArtifactsPane.compose`).
 * Both detail `Static`s hold a `rich.markdown`/turn render that is
 * naturally dozens of rows for a real briefing/script, and a `Static`
 * sizes to its content by default -- left to that default it does not stop
 * at the bottom of the region: the region's own height is fixed (`2fr` of
 * the centre column, see `.watchlists-region-items` above), so the surplus
 * is laid out BELOW the terminal's last row, where a reader can neither
 * see it nor scroll to it -- measured at 160x42 pre-task-5, a 40-line
 * briefing body put the detail's lower edge ~30 rows past the viewport.
 *
 * `fr` + `overflow-y: auto` is the fix, and it is the same idiom
 * `.watchlists-region-content` already uses for the same reason: give each
 * box a share of the budget it cannot exceed and let its content scroll
 * inside it. `min-height` on every half keeps the split from degenerating
 * -- no single half may be squeezed to nothing by the others.
 *
 * The 2:6 weighting between the briefing list and its body (not 1:1, as
 * task 4 shipped it) is task 5's own trade-off, measured rather than
 * assumed: adding the scripts section as a plain second `1fr` pair made
 * an even FOUR-way split (or even a heavily briefing-biased one, `4fr`
 * each against the scripts' `1fr`) shrink `#artifacts-detail` down to its
 * `min-height` floor of 4 rows -- not enough to show more than its header,
 * which broke `test_generate_records_a_complete_briefing_and_renders_
 * its_body`'s "the link is actually painted" assertion (a SHORT, 5-
 * paragraph canned body, not the 40-paragraph geometry fixture). The list
 * itself does not need much room -- scrolling a few rows to see an older
 * briefing costs nothing -- so it gives up share to the body it sits
 * above, which is why a user opened Artifacts in the first place.
 *
 * `#artifacts-table`'s `min-height: 4` is what keeps the LIST usable once
 * it has given up most of its share: at the pane's real 10-unit `fr` pool
 * (`2 + 6 + 1 + 1`), `2fr` alone resolves to EXACTLY this floor (measured:
 * `region.height == 4`) the moment a briefing is selected at all -- the
 * scripts section's own fixed rows (toolbar, table, detail) are already
 * in the layout at that point regardless of whether any script has
 * actually been cast yet, since `ArtifactsPane.compose` gates that whole
 * section on `selected_briefing is not None`, not on `scripts` being
 * non-empty. Without this rule, `2fr` alone drops below one usable data
 * row at 180x50. It is now pinned by `test_the_briefings_table_keeps_
 * at_least_three_usable_rows`, which asserts `region.height >= 4` (a
 * header row plus at least 3 data rows) with both a briefing AND a script
 * present -- dropping this rule REDs it rather than silently shrinking
 * the list to something unusable.
 */
#artifacts-table {
    width: 100%;
    height: 2fr;
    min-height: 4;
}

/* Task-15779: the recompose boundary holding everything below the
 * briefings table (title, detail, citations, scripts/audio). `8fr`
 * against the table's `2fr` stands in for the old flat 2:(6+1+1) split;
 * the children's own 6:1:1 shares below now resolve inside this box.
 * `min-height: 8` is the no-selection floor (title's 4 rows plus the
 * detail's own `min-height: 4`); `overflow-y: auto` mirrors
 * `#watchlists-artifacts-pane`'s belt-and-suspenders rule one level
 * down -- when a short terminal leaves less than the children's floors
 * need, the region scrolls rather than silently clipping the scripts
 * section past its bottom edge.
 */
#artifacts-detail-region {
    width: 100%;
    height: 8fr;
    min-height: 8;
    overflow-y: auto;
}

#artifacts-detail {
    width: 100%;
    height: 6fr;
    min-height: 4;
    overflow-y: auto;
}

/* Cast scripts (spec #2 phase 2a, Task 5): a second list-over-body pair
 * under the briefing's own, rendered only once a briefing is selected
 * (`ArtifactsPane.compose`). `1fr` each, the smallest share of the four --
 * a script's own list/body matter less moment-to-moment than the briefing
 * they were cast from, and `DataTable` itself has an observed floor near 2
 * rows (header + a data/empty row) that `min-height` alone does not push
 * below, so `min-height: 1` here is a documented floor-of-intent rather
 * than a binding one. Dropping the "Script detail" `.pane-title` (see
 * `ArtifactsPane.compose`'s own comment -- that shared class alone costs 4
 * rows: `height: 3` + `margin-bottom: 1`) is what actually bought back the
 * room `#artifacts-detail` needed above; a script names itself instead,
 * in `_script_detail_renderable`'s own header ("Script: <preset>"). Longer
 * scripts/turns overflow into this section's OWN `overflow-y: auto`, same
 * as the briefing body already does.
 *
 * Task-16852 note: the body/detail half's `1fr` now belongs to
 * `ScriptDetailRegion` (`#artifacts-script-detail-region`, its own rule
 * below) -- the nested recompose boundary that lets a SCRIPT selection
 * rebuild the script detail WITHOUT destroying `#artifacts-scripts-table`
 * above it, mirroring the table/`BriefingDetailRegion` split above. The
 * region's own only `fr` child is `#artifacts-script-detail` itself, so
 * that rule is unchanged -- it still claims all the height the region's
 * `1fr` allots it, same as when it was a direct sibling of the table.
 */
#artifacts-scripts-table {
    width: 100%;
    height: 1fr;
    min-height: 1;
}

#artifacts-script-detail-region {
    width: 100%;
    height: 1fr;
    min-height: 1;
}

#artifacts-script-detail {
    width: 100%;
    height: 1fr;
    min-height: 1;
    overflow-y: auto;
}

/* Audio (spec #2 phase 2b, Task 7): Synthesize/Play/Stop, rendered only
 * once a script is selected (`ArtifactsPane.compose`, nested under the
 * same `selected_briefing is not None` gate the scripts section above
 * already uses). Deliberately NOT a fifth `fr` participant, and
 * deliberately no second scrollable detail region either: this section's
 * own toolbar reuses `.destination-filter-strip` (`layout/_panes.tcss`)
 * with no extra rule needed, exactly like `#artifacts-scripts-toolbar`
 * above it needs none -- and the audio status/duration/error itself is
 * folded straight into `_script_detail_renderable`'s own render (appended
 * after the script's turns), inside `#artifacts-script-detail`'s ALREADY
 * measured `1fr` + `overflow-y: auto`. A first draft gave the audio
 * status its own `Static`/id and one more fixed toolbar row on top of
 * that; measured, not assumed, against `test_the_briefings_table_keeps_
 * at_least_three_usable_rows`'s pinned `region.height >= 4`: the extra
 * fixed rows squeezed `#artifacts-scripts-table` down to its header alone,
 * losing the one visible data row `test_casting_a_complete_briefing_
 * writes_a_script_row_and_the_table_shows_it` already depends on. Folding
 * the status text into the existing detail region costs exactly one new
 * fixed row (the toolbar) instead of that plus a whole new scrollable
 * region, and both pinned tests stay green.
 */
#artifacts-audio-toolbar {
    width: 100%;
}

/* Belt-and-suspenders: whatever the `fr` split above computes for these
 * four regions, the pane as a whole scrolls rather than letting any
 * child's region extend silently past the terminal's own last row -- the
 * exact failure mode the comment above already names for a single
 * overlong body, now possible again one level up once a second
 * list-over-body pair sits below the first.
 */
#watchlists-artifacts-pane {
    overflow-y: auto;
}

/* The scope line states which watchlist these briefings belong to and that
 * they are written locally -- muted, like every other standing statement of
 * provenance on this screen (`.watchlists-region-placeholder`).
 */
#artifacts-scope-note {
    width: 100%;
    height: auto;
    text-wrap: wrap;
    color: $ds-text-muted;
}

/* Selection-mode, default-preset, and cadence pickers (spec #2 phase 2a,
 * Task 4; cadence added by phase 4, Task 4).
 * `#artifacts-picker-toolbar` is a second `.destination-filter-strip` row,
 * rendered only when a watchlist is in scope (`ArtifactsPane.compose`) --
 * `.destination-filter-strip` already pins `height: 1; min-height: 1;`
 * (layout/_panes.tcss), same as `#artifacts-toolbar` above it.
 *
 * All three `Select`s need the exact TASK-995 override `#sources-toolbar
 * Select` carries: the bare global `Select { width: 100%; margin-bottom: 1; }`
 * (features/_conversations.tcss) always wins over `DEFAULT_CSS` regardless
 * of specificity, so without `margin: 0` here a one-row picker strip grows
 * a blank row underneath it, and without an explicit `width` each Select
 * claims the whole strip -- the same two-part defect TASK-995 fixed for
 * Sources, on a different toolbar.
 */
#artifacts-picker-toolbar Select {
    height: 1;
    min-height: 1;
    margin: 0;
}

#artifacts-mode-select {
    width: 26;
}

#artifacts-preset-select {
    width: 24;
}

/* Cadence's own options are the shortest of the three ("Off"/"Daily"/
 * "Weekly"/"Every 12h"), so this can be narrower than its siblings --
 * matching `#sources-status-filter`'s own width for a similar-length
 * label set (features/_watchlists.tcss above).
 */
#artifacts-cadence-select {
    width: 16;
}

/* Briefing preset manager modal (spec #2 phase 2a, Task 3).
 *
 * Centred and explicitly sized, exactly like `WatchlistNameDialog`/
 * `WatchlistSourcePickerDialog` above -- an unstyled `ModalScreen` fills the
 * terminal from the top-left corner. Wider than those two (96, not 60):
 * this modal holds a preset list AND a multi-field editor with a variable
 * number of speaker rows side by side, not one input and a button pair.
 *
 * `width: 96` on `#bpm-dialog` below is pinned by
 * `test_modal_dialog_and_columns_fit_on_screen_with_production_css`
 * (`Tests/Watchlists/test_watchlists_briefing_presets_ui.py`), which asserts
 * the dialog's rendered region is exactly 96 columns wide -- not merely
 * "nonzero" or "fits in the viewport" (a bare `ModalScreen` with no sizing
 * rule at all still reports a nonzero, in-viewport region: its `Vertical`
 * child falls back to filling the whole screen, which the loose assertion
 * would not have caught; the review round that added the exact-width
 * assertion measured this directly). An intentional width change should
 * find that test and update it, rather than trip over it as a mystery
 * failure.
 */
BriefingPresetModal {
    align: center middle;
}

#bpm-dialog {
    width: 96;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border: round $ds-grid-line;
}

#bpm-title {
    width: 100%;
    height: auto;
    text-style: bold;
    margin-bottom: 1;
}

#bpm-body {
    width: 100%;
    height: auto;
    max-height: 28;
}

/* One compact button per preset (task-895's own "one button per candidate
 * rather than a Select" convention, `WatchlistSourcePickerDialog`) -- a
 * `Select` posts `Changed` on mount, which this modal's pull-only reads
 * are built to never listen for (see the module docstring).
 */
#bpm-list-column {
    width: 28;
    height: auto;
    max-height: 100%;
    padding-right: 1;
    border-right: solid $ds-grid-line;
}

#bpm-preset-list {
    width: 100%;
    height: auto;
    max-height: 20;
}

#bpm-preset-list Button {
    width: 100%;
    min-width: 0;
    height: 1;
    border: none;
    text-align: left;
}

#bpm-preset-list-empty {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
}

#bpm-editor-column {
    width: 1fr;
    height: auto;
    max-height: 100%;
    padding-left: 1;
}

.bpm-column-heading {
    width: 100%;
    height: auto;
    text-style: bold;
    margin-top: 1;
}

.bpm-field {
    width: 100%;
    height: 3;
}

.bpm-field-label {
    width: 14;
    padding-top: 1;
}

.bpm-field Input {
    width: 1fr;
}

/* One row per speaker: name, role prompt, character Select, voice Select,
 * Remove. `height: 3` matches every bordered `Input`/`Select` in this row --
 * a shorter row would clip their own borders, the same defect class
 * `#overview-total-sources` (top of this file) already documents once.
 */
.bpm-speaker-row {
    width: 100%;
    height: 3;
}

/* UAT batch-5 review, m1: column labels for the row above, reusing the
 * SAME `bpm-speaker-name`/`-role`/`-character`/`-voice` width classes so
 * they land in the same columns as the fields they name. `height: auto`
 * (not the data rows' `height: 3`, sized for bordered Input/Select) --
 * a bare `Static` needs none of that.
 */
.bpm-speaker-header-row {
    width: 100%;
    height: auto;
    margin-top: 1;
}

.bpm-speaker-column-label {
    color: $text-muted;
}

.bpm-speaker-name,
.bpm-speaker-role {
    width: 1fr;
    margin-right: 1;
}

.bpm-speaker-character,
.bpm-speaker-voice {
    width: 22;
    margin-right: 1;
}

.bpm-speaker-row Button {
    width: auto;
    min-width: 0;
    height: 3;
    border: none;
}

/* The `validate_roster` rejection reason -- a duplicate/empty speaker name
 * -- or "enter a preset name". `height: auto` so a long message wraps
 * instead of being clipped, matching `#watchlist-name-error` above.
 */
#bpm-error {
    width: 100%;
    height: auto;
    color: $error;
    margin-top: 1;
}

#bpm-actions {
    width: 100%;
    height: 3;
    align-horizontal: right;
    margin-top: 1;
}

#bpm-actions Button {
    min-width: 12;
    height: 3;
    border: none;
    margin-left: 1;
}

/* Kept briefings modal (task-1780, Task 5): `KeptBriefingsModal`.
 *
 * Same centred/explicitly-sized shape as `BriefingPresetModal` above -- an
 * unstyled `ModalScreen` fills the terminal from the top-left corner.
 * `width: 104` (not 96, `BriefingPresetModal`'s own width): deliberately a
 * DIFFERENT pinned value, so a geometry test asserting this exact number
 * cannot pass by accident against the wrong modal's rule sharing the same
 * value (the same "prove it, do not assume it" discipline
 * `test_modal_dialog_and_columns_fit_on_screen_with_production_css`'s own
 * comment names for `#bpm-dialog`). A future width change should find that
 * sibling test's own `#kbm-dialog` pin and update it deliberately, not trip
 * over it as a mystery failure.
 */
KeptBriefingsModal {
    align: center middle;
}

#kbm-dialog {
    width: 104;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border: round $ds-grid-line;
}

#kbm-title {
    width: 100%;
    height: auto;
    text-style: bold;
    margin-bottom: 1;
}

#kbm-body {
    width: 100%;
    height: auto;
    max-height: 32;
}

/* One compact button per kept briefing -- task-895's own "one button per
 * candidate rather than a Select" convention, exactly like
 * `#bpm-list-column`/`#bpm-preset-list` above.
 */
#kbm-list-column {
    width: 32;
    height: auto;
    max-height: 100%;
    padding-right: 1;
    border-right: solid $ds-grid-line;
}

#kbm-kept-list {
    width: 100%;
    height: auto;
    max-height: 26;
}

#kbm-kept-list Button {
    width: 100%;
    min-width: 0;
    height: 1;
    border: none;
    text-align: left;
}

#kbm-kept-list-empty {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
}

#kbm-detail-column {
    width: 1fr;
    height: auto;
    max-height: 100%;
    padding-left: 1;
}

.kbm-column-heading {
    width: 100%;
    height: auto;
    text-style: bold;
    margin-top: 1;
}

#kbm-detail {
    width: 100%;
    height: auto;
    max-height: 16;
    overflow-y: auto;
}

/* The keep/cast error surface -- a provider's own message, or a
 * `ScriptCastError`/`GenerationInFlightError`'s safe-to-show text. `height:
 * auto` so a long message wraps instead of clipping, matching `#bpm-error`
 * above.
 */
#kbm-error {
    width: 100%;
    height: auto;
    color: $error;
    margin-top: 1;
}

#kbm-detail-actions {
    width: 100%;
    height: 3;
    margin-top: 1;
}

#kbm-detail-actions Button {
    min-width: 12;
    height: 3;
    border: none;
}

/* The cast preset picker, rendered only once a kept briefing is selected.
 * Same TASK-995 override every other one-row `Select` strip in this file
 * needs (`#artifacts-picker-toolbar Select` above is the closest sibling):
 * the bare global `Select { width: 100%; margin-bottom: 1; }`
 * (features/_conversations.tcss) always wins over `DEFAULT_CSS` regardless
 * of specificity.
 */
#kbm-cast-toolbar Select {
    height: 1;
    min-height: 1;
    margin: 0;
}

#kbm-preset-select {
    width: 34;
}

/* One block per kept script: header, then its turns. `border-top` visually
 * separates consecutive scripts without costing a `.pane-title`'s own 4
 * rows per entry (`ArtifactsPane.compose`'s own comment on that cost).
 */
.kbm-script {
    width: 100%;
    height: auto;
    margin-top: 1;
    border-top: solid $ds-grid-line;
    padding-top: 1;
}

#kbm-scripts-empty {
    width: 100%;
    height: auto;
    color: $ds-text-muted;
}

#kbm-actions {
    width: 100%;
    height: 3;
    align-horizontal: right;
    margin-top: 1;
}

#kbm-actions Button {
    min-width: 12;
    height: 3;
    border: none;
    margin-left: 1;
}

/* Snapshot view modal (task-1494): `SnapshotViewModal`. Same centred/
 * explicitly-sized shape as `KeptBriefingsModal`/`BriefingPresetModal`
 * above -- an unstyled `ModalScreen` fills the terminal from the top-left
 * corner. `width: 90` is deliberately a THIRD pinned value, distinct from
 * both siblings' (96/104) -- see `#kbm-dialog`'s own comment on why a
 * shared width would let a geometry test pass against the wrong modal.
 */
SnapshotViewModal {
    align: center middle;
}

#svm-dialog {
    width: 90;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border: round $ds-grid-line;
}

#svm-header {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

/* The snapshot body is the one field here with no natural size cap --
 * `extracted_content` is a full page's extracted text -- so it gets its
 * own scrollable region rather than growing the whole dialog past the
 * terminal, mirroring `#kbm-detail`'s identical `max-height` + `overflow-y`
 * pair above.
 */
#svm-body-scroll {
    width: 100%;
    height: auto;
    max-height: 28;
    overflow-y: auto;
}

#svm-body {
    width: 100%;
    height: auto;
}

#svm-actions {
    width: 100%;
    height: 3;
    align-horizontal: right;
    margin-top: 1;
}

#svm-actions Button {
    min-width: 12;
    height: 3;
    border: none;
}

/* ===== MODULE: features/_lab.tcss ===== */
/* Lab destination (Models | Speech | Evals).
 *
 * These rules MUST live app-tier, not in LabModeStrip.DEFAULT_CSS: the
 * bundle's global `.is-active` rule (border: round) outranks DEFAULT_CSS
 * regardless of specificity, so a widget-tier override silently loses and
 * the active chip's label is clipped by the one-row strip. Mirrors
 * `.personas-mode-chip.is-active` and `#mcp-mode-strip Button.mcp-mode-chip`.
 *
 * This copy is authoritative at runtime. `LabModeStrip.DEFAULT_CSS`
 * (tldw_chatbook/UI/Screens/lab_mode_strip.py) keeps a second, lower-
 * specificity copy of `.lab-mode-chip` rules purely as a fallback for
 * harness apps that mount the strip without loading this bundle. The two
 * have already diverged (that copy adds min-height; this one adds
 * background/color) -- keep them in lockstep when either changes.
 */

#lab-mode-strip Button.lab-mode-chip {
    width: auto;
    min-width: 0;
    height: 1;
    padding: 0 1;
    border: none;
}

#lab-mode-strip .lab-mode-chip.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

#lab-mode-strip .lab-mode-chip.is-active:focus,
#lab-mode-strip .lab-mode-chip.is-active:hover:focus {
    outline: none;
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* A focused non-active chip must not impersonate the active one. The app's
 * global Button:focus grants bold underline, which is exactly the active
 * chip's signature -- so a keyboard user tabbing the strip would see two
 * chips read as active. Underline stays exclusive to .is-active. Mirrors
 * the same guard MCP applies to its mode chips. */
#lab-mode-strip .lab-mode-chip:focus,
#lab-mode-strip .lab-mode-chip:hover:focus {
    text-style: bold;
    outline: none;
}

/* --- Lab workbench ------------------------------------------------------
 *
 * Region widths are declared here rather than inline so the layout contract
 * is inspectable in one place.
 *
 * The rail is fractional, not fixed. It was `width/min-width/max-width: 26`,
 * which measured 26 cells at 80, 120 and 200 columns alike -- 32.5% of an
 * 80-column terminal for a list whose longest label is 14 characters, while
 * every sibling rail in the app is fractional (`#mcp-hub-rail` is
 * `3fr` with `min-width: 24`). The bounds keep the labels intact at 80
 * columns without letting the rail sprawl at 200.
 *
 * The 24 floor fits the exact surviving longest label, "Speech Recognition",
 * including padding, border, and the active accent. The rendered oracle in
 * `Tests/UI/test_lab_workbench.py` pins it.
 */

.lab-workbench {
    width: 100%;
    height: 1fr;
    min-height: 0;
}

#lab-rail {
    width: 1fr;
    min-width: 24;
    max-width: 32;
    height: 100%;
    min-height: 0;
    padding: 0;
    background: $ds-surface-panel;
    border-right: solid $ds-column-line;
}

#lab-body {
    width: 4fr;
    min-width: 0;
    height: 100%;
    min-height: 0;
    padding: 0 1;
}

/* TASK-1076: was a hard `30` at every terminal width -- the exact anti-
 * pattern `#lab-rail` documents above (measured 30 cells at 80, 120, 160
 * and 200 columns alike). At 200 columns that left the inspector's usable
 * content ~28 cells wide (`.ds-inspector`'s own padding takes 2), so a
 * plain sentence like "K requested 20 * K returned 20 * canary degenerate"
 * wrapped mid-phrase with 170+ unused columns beside it. Fractional now,
 * like the rail, so it actually grows on a wide terminal. `2fr` (a
 * heavier weight than the rail's own `1fr`, since a FIXED pane was
 * previously eating this whole width and `1fr` alone only grew it to 34
 * cells at 200 columns, measured) -- `#lab-body` stays `4fr`, still the
 * largest of the three regions, so the grid is not starved for it.
 */
#lab-inspector {
    width: 2fr;
    min-width: 30;
    max-width: 50;
    height: 100%;
    min-height: 0;
}

/* Rail rows.
 *
 * The `border: none` is REQUIRED, not cosmetic. The bundle declares an
 * unscoped `.is-active { border: round $ds-action-focus; }` earlier in this
 * sheet, and app-tier CSS beats widget DEFAULT_CSS regardless of
 * specificity. A height-1 row that picks up that border renders two rows
 * tall -- a half-bordered artifact that displaces every row below it.
 * `#mcp-hub-rail Button.mcp-rail-row.is-active` carries the same override
 * for the same reason.
 */
.lab-rail Button.lab-rail-row {
    width: 100%;
    height: 1;
    min-height: 1;
    padding: 0 1 0 2;
    border: none;
    /* `text-align` alone does NOT left-align a one-line Button label --
       `content-align` positions the label box itself and defaults to
       centered, so without this the nine provider rows each sat at a
       different indent and the list had no shared left edge to scan down.
       Same pairing as `Button.mcp-rail-row`, `Button.mcp-inspector-action`
       and `Button.mcp-callout`, which each hit this and fixed it the same
       way. */
    text-align: left;
    content-align: left middle;
}

/* The active row is a solid fill plus an accent bar; a merely focused row
 * gets underline only (below). They must not converge: the app's global
 * `Button:focus` grants bold, and the old active style was `$ds-focus-bg` --
 * measured identical to the focus background, so a focused row and the
 * active row rendered the same colour and two rows read as selected at
 * once. The mode strip 60 lines above already guards against exactly this.
 *
 * `border: none` first is REQUIRED, not cosmetic: the bundle declares an
 * unscoped `.is-active { border: round $ds-action-focus; }` earlier in this
 * sheet, and app-tier CSS beats widget DEFAULT_CSS regardless of
 * specificity. A height-1 row that picks up that round border renders two
 * rows tall. `border-left` alone consumes a column, never a row, so the
 * accent bar is safe on a one-line button.
 */
.lab-rail .lab-rail-row.is-active {
    border: none;
    border-left: thick $accent;
    background: $primary;
    color: $ds-text-primary;
    text-style: bold;
}

.lab-rail .lab-rail-row.is-active:focus,
.lab-rail .lab-rail-row.is-active:hover:focus {
    outline: none;
    border: none;
    border-left: thick $accent;
    background: $primary;
    color: $ds-text-primary;
    text-style: bold;
}

.lab-rail .lab-rail-row:focus,
.lab-rail .lab-rail-row:hover:focus {
    outline: none;
    background: $ds-surface-raised;
    text-style: underline;
}

/* Section headings carry the accent so the rail has a scannable hierarchy;
 * unstyled they forced the list to be read line by line to find where
 * "Local servers" ended and "Models" began. `margin-top` opens the gap
 * between groups -- the second heading otherwise butts against the last row
 * of the first group. */
.lab-rail-section {
    height: 1;
    min-height: 1;
    padding: 0 1;
    margin-top: 1;
    color: $accent;
    text-style: bold;
}

/* --- Header row ---------------------------------------------------------
 *
 * One row carrying title, subtitle, this mode's status chips, and the
 * readiness badge -- the same shape Console collapses its own
 * DestinationHeader into (`#console-workbench-header.console-header-inline`,
 * height 1, border none).
 *
 * Lab previously rendered the stacked `.workbench-header` block instead: a
 * bordered 5 rows, plus a conditional chip row beneath it. That is the only
 * 5-row destination header in the app -- the other eleven destinations size
 * their title with `$ds-destination-header-height` (= 1). The eight rows it
 * cost were the eight that pushed Models' `Start Server` button past the
 * bottom of a 40-row terminal.
 *
 * `.lab-header-inline` is a class, not an id, so all three Lab modes can
 * carry it -- Speech and Evals compose their own DestinationHeader rather
 * than going through this frame, and if only Models were collapsed the mode
 * strip would sit at y=4 on Models and y=8 on the other two, jumping four
 * rows on every switch (measured). It ties `.workbench-header` on
 * specificity (0,1,0) and wins on source order: features/_lab.tcss is
 * emitted after components/ in CSS_MODULES. The descendant rules below are
 * (0,2,0), which beats the density rule that hides the subtitle in compact
 * mode -- the row is one line at any density, so hiding the subtitle would
 * only waste horizontal space.
 */
#lab-header-row {
    height: 1;
    min-height: 1;
    padding: 0 1;
    background: $ds-surface-panel;
}

.lab-header-inline {
    layout: horizontal;
    width: 1fr;
    height: 1;
    min-height: 1;
    padding: 0 1;
    margin: 0;
    border: none;
    background: $ds-surface-panel;
}

/* Inside the frame's header row the padding is already supplied by
   `#lab-header-row`; doubling it would indent Models' title two cells
   further than Speech's. */
#lab-header-row .lab-header-inline {
    padding: 0;
}

.lab-header-inline .workbench-header-title {
    width: auto;
    height: 1;
    min-height: 1;
}

.lab-header-inline .workbench-header-subtitle {
    display: block;
    width: 1fr;
    height: 1;
    min-height: 1;
    margin-left: 2;
}

.lab-header-inline .workbench-header-status {
    width: auto;
    height: 1;
    min-height: 1;
    margin-left: 2;
}

/* The chip shares the header's single row with the title, subtitle and
 * readiness badge. `width: auto` means a mode with long chip copy claims
 * whatever it wants and starves the 1fr header beside it -- Speech's
 * capability chip once rendered the full recovery sentence here and
 * collapsed `#lab-destination-header` to ONE cell, truncating the title to
 * "S". Chip copy stays short and the cap makes that structural rather than
 * a convention each mode has to remember. */
.lab-status-chip {
    width: auto;
    max-width: 40%;
    height: 1;
    padding: 0 1;
    color: $ds-text-muted;
    text-overflow: ellipsis;
}

/* The title must survive whatever the chip does. */
.lab-header-inline .workbench-header-title {
    min-width: 6;
}

/* Rail width is per-mode, because label length is per-mode. Speech's rows carry
 * double-width emoji -- "🔤 Speech Recognition" measures 21 cells, and at the
 * shared floor Textual dropped the overflowing word entirely, rendering
 * "🔤 Speech" and a bare "📚". Measured, not estimated. */
.lab-mode-stts #lab-rail {
    min-width: 28;
    max-width: 34;
}

/* Evals' rail is a library, not a menu: section headings carry counts and
 * their empty states put two buttons side by side ("+ New dataset" /
 * "Import…"). At the shared floor those wrapped instead. */
.lab-mode-evals #lab-rail {
    min-width: 30;
    max-width: 38;
}

/* --- Evals panes inside the frame's regions -----------------------------
 *
 * `#evals-library-pane, #evals-detail-pane, #evals-inspector-pane` carry
 * `border: solid $ds-grid-line` + a panel background from the hand-rolled
 * three-pane workbench they used to live in
 * (components/_agentic_terminal.tcss). Inside the frame those borders are
 * doubled -- `#lab-rail` already draws the column rule -- and each one costs
 * two columns of content width, which truncated the rail's own
 * "Create sample bench" button.
 *
 * Two ids each, so these beat that grouped one-id rule, and features/ is
 * emitted after components/ regardless. The panes keep their ids: those are
 * their stable selectors and several tests query them.
 */
#lab-rail #evals-library-pane,
#lab-body #evals-detail-pane,
#lab-inspector #evals-inspector-pane {
    border: none;
    background: transparent;
    min-height: 0;
    padding: 0;
}

/* `#lab-rail` and `#lab-inspector` are VerticalScroll containers that
 * already hold a collapse header row. A pane at `height: 100%` there makes
 * the scrollable content header + 100% -- measured `virtual_size` 35 against
 * a `container_size` of 34, so both rails were permanently scrollable by one
 * row and the collapse header could be scrolled out of reach, even with
 * short content. `auto` lets the pane size to its content and leaves
 * overflow to the scroll container, which is its job.
 *
 * This is the same mistake as `#evals-results-grid`'s `height: 100%` fixed
 * in this branch: 100% is the full parent height and ignores siblings.
 * Caught by Qodo on PR #1010. */
#lab-rail #evals-library-pane,
#lab-inspector #evals-inspector-pane {
    height: auto;
}

/* `#lab-body` is a plain Vertical with no header sibling, so the detail
 * pane genuinely should fill it. */
#lab-body #evals-detail-pane {
    height: 100%;
}

/* "No datasets" offers authoring and import together. In the old three-pane
 * workbench that pane was ~53 columns and the two buttons sat side by side;
 * in the frame's rail they need 34 and get 28, so "Import…" was clipped off
 * the right edge -- present in the DOM, unreachable on screen. Stacking
 * keeps both offered, which is what the design spec's empty-state table
 * actually asks for; only the axis changes. */
#lab-rail .evals-rail-empty-actions {
    layout: vertical;
    height: auto;
}

#lab-rail .evals-rail-empty-actions Button {
    width: 100%;
}

/* --- Speech panes, Console grammar ---------------------------------------
 *
 * One row per thing. The legacy playground spent 4 rows on every
 * label/input pair and 5 on each explanatory notice, which made the form 93
 * rows tall in a 34-row viewport and put `Generate Speech` at y=60. These
 * rules exist to keep that from coming back: chips are height 1, the action
 * strip is height 1, and only the text input is allowed to grow.
 */
.speech-pane {
    height: 1fr;
    padding: 0 1;
    overflow-y: auto;
}

.speech-pane-title {
    height: 1;
    min-height: 1;
    text-style: bold;
    color: $ds-status-info;
}

#speech-playground-actions {
    height: 1;
    min-height: 1;
    margin: 1 0 0 0;
}

/* The only element allowed to take the remaining space -- everything else on
   this screen is one row. */
.speech-input {
    height: 1fr;
    min-height: 5;
    margin: 1 0;
    border: solid $ds-grid-line;
}

.speech-input:focus {
    border: solid $ds-input-focus-border;
}

.speech-chip-row {
    height: 1;
    min-height: 1;
}

/* `width: auto` with a cap, for the reason the Lab status chip carries one:
   an unbounded auto chip starves its neighbours on the same row. */
.speech-chip {
    width: auto;
    max-width: 30;
    height: 1;
    padding: 0 1;
    margin-right: 1;
    color: $ds-text-muted;
    background: $ds-surface-panel;
    text-overflow: ellipsis;
}

.speech-status-line {
    height: 1;
    min-height: 1;
    margin-top: 1;
    color: $ds-status-warning;
}

.speech-readiness-line {
    height: auto;
    min-height: 1;
    margin-top: 1;
    color: $ds-status-info;
}

.speech-detail-line {
    height: auto;
    min-height: 1;
    color: $ds-text-muted;
}

.audio-cpp-runtime-card {
    height: auto;
    min-height: 1;
    margin-top: 1;
}

.audio-cpp-runtime-status {
    height: auto;
    min-height: 1;
    padding: 0 1;
    color: $ds-text-primary;
    text-style: bold;
}

.audio-cpp-runtime-pending,
.audio-cpp-runtime-reason {
    height: auto;
    min-height: 1;
    padding: 0 1;
    color: $ds-text-muted;
}

.audio-cpp-diagnostics-warning {
    height: auto;
    min-height: 1;
    color: $ds-status-warning;
}

.audio-cpp-diagnostics-lines {
    height: auto;
    min-height: 1;
    max-height: 12;
    overflow-y: auto;
    color: $ds-text-muted;
}

.audio-cpp-diagnostics-lines:focus {
    outline: heavy $ds-action-focus;
    background: $ds-focus-bg;
    color: $ds-text-primary;
    scrollbar-color-active: $ds-action-focus;
}

#audio-cpp-runtime-actions {
    height: 1;
    min-height: 1;
}

#audio-cpp-runtime-actions Button.workbench-action {
    width: auto;
    min-width: 0;
    padding: 0 1;
    margin: 0 2 0 0;
    border: none;
}

.speech-split-stacked #audio-cpp-runtime-actions {
    layout: vertical;
    height: 3;
    min-height: 3;
}

.speech-split-stacked #audio-cpp-runtime-actions Button.workbench-action {
    width: 100%;
    margin: 0;
    text-align: left;
    content-align: left middle;
}

/* Textual's Button carries a default min-width, so the shared
 * `.workbench-action { width: auto }` alone still spread six actions across
 * the full pane -- "Export" rendered as "Ex" and "Clear" fell off the right
 * edge entirely. Console packs its action strip left; so does this. */
#speech-playground-actions Button.workbench-action {
    width: auto;
    min-width: 0;
    padding: 0 1;
    margin: 0 2 0 0;
    border: none;
}


/* Reverse-video section head, matching Console's inspector section bars
 * (Sources / Run / Tools) rather than inventing a third heading style. */
.speech-section-head {
    height: 1;
    min-height: 1;
    margin-top: 1;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}


/* Text | Result, side by side. The pane has width to spend and does not have
 * 34 rows of content to spend vertically -- filling the height with one tall
 * empty box is what made the first two passes read as sparse. */
.speech-split {
    height: 1fr;
    /* Reference setup and the runtime card are auto-height siblings. Without
     * a floor they consume the short Lab viewport and Textual compresses the
     * synthesis text/current-result split to one or two unusable rows. The
     * current-result pane needs thirteen rows when the clone-only profile-save
     * action is present; keep that complete action set inside the split and
     * let the outer pane scroll for the runtime/clone setup below it. */
    min-height: 13;
    margin-top: 1;
}

.speech-split-pane {
    width: 1fr;
    height: 100%;
    min-width: 0;
    min-height: 0;
}

#speech-result-pane {
    margin-left: 2;
}

/* Below SPEECH_SPLIT_MIN_WIDTH two columns would be ~20 cells each, so the
 * split stacks. Toggled from `on_resize` because Textual has no media
 * queries -- same approach as the Personas compact workbench. */
.speech-split-stacked .speech-split {
    layout: vertical;
}

.speech-split-stacked #speech-result-pane {
    margin-left: 0;
    margin-top: 1;
}

.speech-input {
    height: 1fr;
    min-height: 4;
    margin: 0;
}

.speech-result-state {
    height: 1;
    min-height: 1;
    padding: 0 1;
    color: $ds-text-muted;
}

#speech-result-actions {
    height: 1;
    min-height: 1;
    margin-top: 1;
}

#speech-result-actions Button.workbench-action {
    width: auto;
    min-width: 0;
    padding: 0 1;
    margin: 0 2 0 0;
    border: none;
}

/* Result chips stack one per row here, unlike the settings line: they are
   read as a list of facts about one artifact, not scanned across. */
#speech-result-pane .speech-chip {
    width: 100%;
    max-width: 100%;
    margin: 0;
}

/* Narrow: stack the one-row rows rather than let them overflow.
 *
 * At 80 columns the Lab body is ~41 cells. Six actions and four chips do not
 * fit on one row each -- Stop/Export/Clear and two chips were being cut off
 * at the right edge, present in the DOM and unreachable on screen. Dropping
 * actions below a threshold would hide capability; stacking keeps every
 * option and spends rows, which is the correct trade on a narrow terminal
 * where rows are the cheaper resource.
 */
.speech-split-stacked #speech-playground-actions,
.speech-split-stacked #speech-result-actions,
.speech-split-stacked #speech-settings-line {
    layout: vertical;
    height: auto;
    min-height: 1;
}

/* The Playground inventory is a fixed six actions. Textual's horizontal
 * container resolves `height: auto` one row short after it switches to a
 * vertical layout, so reserve the six actual rows rather than clipping the
 * final cross-surface navigation action. */
.speech-split-stacked #speech-playground-actions {
    height: 6;
    min-height: 6;
}

.speech-split-stacked #speech-playground-actions Button.workbench-action,
.speech-split-stacked #speech-result-actions Button.workbench-action {
    width: 100%;
    margin: 0;
    text-align: left;
    content-align: left middle;
}

.speech-split-stacked .speech-chip {
    width: 100%;
    max-width: 100%;
    margin: 0;
}

/* With the rows stacked, the pane scrolls rather than clipping. */
.speech-split-stacked {
    overflow-y: auto;
}

/* Stacked, the panes must overflow rather than compress. `height: 1fr` on
 * the text area let it shrink to a single row so the Result pane fell off
 * the bottom with nothing to scroll -- virtual height equalled the
 * container, so the content was clipped, not scrollable. Fixed heights make
 * the pane genuinely taller than its viewport, which is what turns
 * `overflow-y: auto` into a usable scroll. */
.speech-split-stacked .speech-split-pane {
    height: auto;
}

.speech-split-stacked .speech-input {
    height: 6;
    min-height: 6;
}

/* The split itself must stop being `1fr` when stacked: at 1fr it resolved to
 * 3 rows while its two panes needed 17, so it squeezed them and the overflow
 * happened inside a container that does not scroll. `auto` lets it take its
 * content height and pushes the scrolling up to `.speech-pane`, which has
 * `overflow-y: auto`. */
.speech-split-stacked .speech-split {
    height: auto;
}

/* An override is stated, not implied. The Playground owns session-scoped
 * values that never write back, so the user must be able to see at a glance
 * what they have deliberately changed. The asterisk in the label carries it
 * for anyone who cannot use the colour. */
.speech-chip-override {
    color: $ds-status-warning;
    text-style: bold;
}

/* Parameter rows: label left, control right, one row each. The legacy form
 * spent four rows on exactly this pairing, which is most of why it was 93
 * rows tall. */
.speech-param-row {
    height: 1;
    min-height: 1;
}

.speech-param-label {
    width: 24;
    height: 1;
    color: $ds-text-muted;
}

.speech-param-control {
    width: 1fr;
    height: 1;
    min-height: 1;
    border: none;
}

/* The axes reflow onto a second line rather than truncating. Six chips need
 * more than the ~81 cells the Lab body gives at 120 columns -- "Format" was
 * being cut to "Format: un" and "Speed" fell off the edge. These are the
 * variables the user is comparing; they are the last thing that may be
 * clipped. One column when stacked. */
.speech-axis-grid {
    grid-size: 3;
    grid-rows: 1;
    grid-gutter: 0 1;
    height: auto;
    margin-bottom: 1;
}

.speech-split-stacked .speech-axis-grid {
    grid-size: 1;
}

/* Four player actions do not fit the ~38-cell result pane on one row --
 * "Export" rendered at x=101..111 against a pane ending at 107, clipped by
 * the parent rather than by itself. A 2x2 grid fits, and reflows to one
 * column when stacked. */
#speech-result-actions {
    layout: grid;
    grid-size: 2;
    grid-rows: 1;
    grid-gutter: 0 1;
    height: auto;
    margin-top: 1;
}

.speech-split-stacked #speech-result-actions {
    grid-size: 1;
}

/* Axis cells: label then the real control, one row. The label carries the
 * override marker; the control carries the legacy id so the existing
 * synthesis handler reads it unchanged. */
.speech-axis-cell {
    height: 1;
    min-height: 1;
}

.speech-axis-cell .speech-chip {
    width: 10;
    max-width: 10;
    margin: 0;
    background: transparent;
}

.speech-axis-control {
    width: 1fr;
    height: 1;
    min-height: 1;
    border: none;
    background: $ds-surface-panel;
}

/* `border: none` on a Select does NOT reach its inner SelectCurrent, which
 * keeps its own three-row bordered box. Clipped to `height: 1`, every axis
 * rendered its top border and nothing else -- a visible control showing
 * neither its value nor its arrow. The child needs the rule too. */
.speech-axis-control SelectCurrent {
    border: none;
    height: 1;
    min-height: 1;
    padding: 0 1;
}

.speech-axis-control SelectCurrent Static {
    height: 1;
}

/* The speed Input has the same inner-border problem in reverse: it is the
 * bordered widget itself. */
Input.speech-axis-control {
    padding: 0 1;
}

/* --- Speech: player, generation status, clip source ------------------- */

/* The result is one current artifact. It owns enough intrinsic height for its
 * summary, lifecycle copy, and always-visible actions. */
.speech-player {
    height: auto;
    padding: 0 1;
    border-top: solid $ds-grid-line;
}

#audio-player-container > .speech-section-head {
    margin-top: 0;
}

.speech-player-status {
    height: 1;
    color: $ds-text-primary;
    text-style: bold;
}

.speech-result-lifecycle {
    height: auto;
    min-height: 1;
    color: $ds-text-muted;
}

.speech-result-provenance {
    height: auto;
    min-height: 1;
    color: $ds-text-muted;
}

.speech-player-transport {
    height: 1;
}

#audio-progress-bar {
    width: 1fr;
    height: 1;
}

.speech-player-time {
    width: auto;
    min-width: 12;
    content-align: right middle;
    color: $text-muted;
}

/* Generic Collapsible styling elsewhere is a three-row form header. Speech's
 * diagnostics and tuning disclosures are compact workbench rows. */
#speech-param-group,
#speech-connection-details,
#speech-log-group,
#audio-cpp-runtime-details,
#audio-cpp-runtime-diagnostics {
    height: auto;
    min-height: 1;
    padding: 0;
    margin-bottom: 0;
    border: none;
    background: transparent;
}

#speech-param-group > CollapsibleTitle,
#speech-connection-details > CollapsibleTitle,
#speech-log-group > CollapsibleTitle,
#audio-cpp-runtime-details > CollapsibleTitle,
#audio-cpp-runtime-diagnostics > CollapsibleTitle {
    height: 1;
    min-height: 1;
    padding: 0 1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#speech-param-group > Contents,
#speech-connection-details > Contents,
#speech-log-group > Contents,
#audio-cpp-runtime-details > Contents,
#audio-cpp-runtime-diagnostics > Contents {
    height: auto;
}

/* One row: what is happening, and how far along. */
.speech-generation-status {
    height: 1;
    padding: 0 1;
}

.speech-generation-text {
    width: 1fr;
    color: $text-muted;
}

#generation-progress {
    width: auto;
    min-width: 20;
    height: 1;
}

/* Diagnostic, so it stays behind a collapsed disclosure rather than
   occupying rows nobody reads. */
#speech-log-group {
    height: auto;
    border: none;
    background: transparent;
}

.speech-log {
    height: 8;
    background: transparent;
}

/* The reference-clip / voice-sample picker, mounted only for the providers
   that use one. */
.speech-source-row {
    height: 1;
    margin-top: 1;
}

.speech-source-status {
    width: 1fr;
    color: $text-muted;
}

.speech-clone-setup-host,
#speech-clone-setup {
    height: auto;
    min-height: 0;
}

#speech-clone-setup {
    margin-top: 1;
    padding: 0 1;
    border-top: solid $ds-grid-line;
    background: $ds-surface-panel;
}

.speech-clone-guidance,
.speech-clone-privacy,
.speech-clone-error {
    height: auto;
    min-height: 1;
    color: $ds-text-muted;
}

.speech-clone-privacy {
    color: $ds-status-warning;
}

.speech-clone-error {
    color: $ds-status-info;
}

.speech-clone-reference-row,
.speech-clone-actions {
    height: 1;
    min-height: 1;
    margin-top: 1;
}

.speech-clone-reference-row Button,
.speech-clone-actions Button {
    width: auto;
    min-width: 0;
    height: 1;
    padding: 0 1;
    margin: 0 1 0 0;
    border: none;
}

.speech-clone-transcript {
    height: 4;
    min-height: 3;
    margin-top: 1;
}

.speech-split-stacked .speech-clone-reference-row,
.speech-split-stacked .speech-clone-actions {
    layout: vertical;
    height: auto;
}

.speech-split-stacked .speech-clone-reference-row Button,
.speech-split-stacked .speech-clone-actions Button {
    width: 100%;
    margin: 0;
    text-align: left;
    content-align: left middle;
}

/* --- Speech: TTS Settings --------------------------------------------- */

/* One row per setting. The legacy form spent FOUR on each -- a blank row,
 * the input's top border, the label+value row, the bottom border -- which
 * is what put `save-settings-btn` at y=102 in a 26-row viewport. */
.speech-setting-row {
    height: 1;
    padding: 0 1;
}

.speech-setting-label {
    width: 28;
    color: $text-muted;
}

.speech-setting-control {
    width: 1fr;
    height: 1;
    min-height: 1;
    border: none;
    background: $ds-surface-panel;
}

/* Read-only global ownership stays visible without competing for the row's
   flexible width. Static defaults to 1fr; that used to leave the actual
   value control only two cells wide at every tested terminal width. */
.speech-setting-scope {
    width: auto;
    min-width: 0;
    margin-left: 1;
    color: $text-muted;
}

/* `border: none` on a Select does not reach its inner SelectCurrent, which
 * keeps its own three-row box and, clipped to `height: 1`, paints only its
 * top border. */
.speech-setting-control SelectCurrent {
    border: none;
    height: 1;
    min-height: 1;
    padding: 0 1;
}

Input.speech-setting-control {
    padding: 0 1;
}

/* The forms-wide `Input:focus` rule re-adds a border at higher specificity
 * than the border-none class rule above, and the reset-tier `*:focus`
 * accessibility outline paints OVER the widget's outermost rendered lines
 * (its own comment warns of exactly this) — on a height-1 row that line IS
 * the only content line, so focusing the field replaced the typed value
 * with the outline's box characters (TASK-15421 AC3). Opt out of both and
 * show focus with the content-safe tint instead — the same opt-out +
 * recolour pattern the reset comment prescribes (TASK-1160's DataTable
 * precedent). */
Input.speech-setting-control:focus {
    border: none;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

.speech-settings-group {
    height: auto;
    border: none;
    background: transparent;
    margin-bottom: 1;
}

/* The action strip sits OUTSIDE the scroll region: `save-settings-btn`
 * measured at y=102 after every provider block, four screens below the
 * fold. Keeping it above the groups is what makes it reachable regardless
 * of how many are expanded. */
.speech-settings-pane {
    height: 1fr;
}

#speech-settings-actions {
    height: 1;
    padding: 0 1;
    margin-bottom: 1;
}

#speech-settings-groups {
    height: 1fr;
    overflow-y: auto;
}

.studio-tts-scope {
    height: auto;
    min-height: 2;
    padding: 0 1;
    color: $ds-text-muted;
}

#speech-settings-actions {
    height: auto;
    min-height: 1;
}

#speech-settings-actions Button.workbench-action,
#studio-tts-voice-destination-actions Button.workbench-action,
#voice-blends-actions Button.workbench-action {
    width: auto;
    min-width: 0;
    height: 1;
    padding: 0 1;
    margin: 0 2 0 0;
    border: none;
}

.studio-tts-settings-stacked #speech-settings-actions {
    layout: vertical;
    height: 4;
}

.studio-tts-settings-stacked #speech-settings-actions Button.workbench-action {
    width: 100%;
    margin-right: 0;
}

.studio-tts-setting-row {
    height: auto;
    min-height: 1;
}

.studio-tts-source {
    width: 34;
    min-width: 18;
    padding-left: 1;
    color: $ds-text-muted;
    text-overflow: ellipsis;
}

.studio-tts-field-error {
    width: auto;
    min-width: 16;
    padding-left: 1;
    color: $ds-status-error;
}

.studio-tts-settings-stacked .studio-tts-setting-row {
    layout: vertical;
    height: auto;
    min-height: 3;
    margin-bottom: 1;
}

.studio-tts-settings-stacked .studio-tts-setting-row .speech-setting-label,
.studio-tts-settings-stacked .studio-tts-setting-row .speech-setting-control,
.studio-tts-settings-stacked .studio-tts-setting-row .studio-tts-source,
.studio-tts-settings-stacked .studio-tts-setting-row .studio-tts-field-error {
    width: 100%;
    min-width: 0;
}

.studio-tts-settings-stacked .studio-tts-setting-row .studio-tts-source,
.studio-tts-settings-stacked .studio-tts-setting-row .studio-tts-field-error {
    height: auto;
    min-height: 1;
}

#studio-tts-chatterbox-options {
    height: auto;
}

#studio-tts-voice-destination-actions,
#voice-blends-actions {
    height: auto;
    min-height: 1;
    margin: 0 1 1 1;
}

.studio-tts-settings-stacked #studio-tts-voice-destination-actions {
    layout: vertical;
    height: 2;
}

.studio-tts-settings-stacked #studio-tts-voice-destination-actions Button.workbench-action {
    width: 100%;
    margin-right: 0;
}

.studio-tts-helper {
    height: auto;
    min-height: 1;
    padding: 0 1;
    color: $ds-text-muted;
}

#tts-adopt-studio-preferences-btn {
    width: auto;
    min-width: 0;
    height: 1;
    padding: 0 1;
    border: none;
}

/* Voice-profile portability uses one scrollable, terminal-native review
 * surface. The vertical action stack remains reachable at 80x24 without
 * relying on pointer-only affordances or clipped horizontal controls. */
TTSProfileExportChoiceModal,
TTSVoiceBundleConsentModal,
TTSVoiceBundleReviewModal {
    align: center middle;
    background: $background 75%;
}

.stts-portability-dialog {
    width: 90%;
    max-width: 76;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $panel;
    border: round $accent;
    overflow-y: auto;
}

.stts-portability-title {
    height: auto;
    margin-bottom: 1;
    text-style: bold;
}

.stts-portability-copy,
.stts-portability-recovery {
    height: auto;
    margin-bottom: 1;
}

.stts-portability-recovery {
    color: $warning;
}

.stts-portability-actions {
    layout: vertical;
    height: auto;
    margin-top: 1;
}

.stts-portability-actions Button {
    width: 100%;
    height: 3;
    min-width: 0;
    margin-bottom: 1;
}

/* Portable material controls stay visibly inert without stacking the generic
 * whole-widget fade, Textual's disabled ink and the app's disabled token.
 * The neutral surface carries state; the label remains readable at the
 * product's 3:1 disabled-control floor in every bundled theme. */
.stts-portability-dialog .stts-portability-actions Button:disabled,
STTSProfileLibrary #stts-profile-actions #stts-profile-import-btn:disabled {
    opacity: 100%;
    text-opacity: 100%;
    text-style: none;
    color: $text;
    background: $surface-darken-1;
}

.stts-portability-actions Button:focus,
.stts-portability-dialog Checkbox:focus,
.stts-portability-dialog Select:focus,
.stts-portability-dialog TextArea:focus {
    outline: heavy $accent;
}

#stts-bundle-review-facts {
    height: 9;
    min-height: 6;
}


/* AudioBook actions live above the scroll region, so they stay on screen
 * whatever is expanded below. Inside it they measured at y=40 in a 26-row
 * viewport, after eight collapsible groups. */
#audiobook-actions {
    height: 1;
    min-height: 1;
    padding: 0 1;
    margin-bottom: 1;
}

#audiobook-actions Button {
    width: auto;
    min-width: 0;
    height: 1;
    padding: 0 1;
    margin: 0 2 0 0;
    border: none;
}

/* Model Library is an operate surface: rows grow with truthful package facts,
 * while the allocated pane (including a narrow Lab rail) owns scrolling. */
#llm-view-curated,
#llm-view-installed,
CuratedView,
InstalledView {
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

CuratedView .curated-header,
InstalledView .installed-header {
    layout: vertical;
    height: auto;
}

CuratedView .curated-header Button,
InstalledView .installed-header Button {
    width: 100%;
    min-width: 0;
    margin: 0 0 1 0;
}

CuratedView .curated-list,
InstalledView .installed-list {
    height: 1fr;
    min-height: 0;
    overflow-y: auto;
}

CuratedView .curated-model-row,
InstalledView .installed-model-row,
CuratedView .audio-cpp-companions,
InstalledView .audio-cpp-companions,
CuratedView .audio-cpp-package-copy,
InstalledView .audio-cpp-package-copy,
InstalledView .installed-recovery-status {
    width: 100%;
    min-width: 0;
    height: auto;
}

CuratedView .audio-cpp-actions,
InstalledView ModelActivationControls.audio-cpp-actions,
InstalledView ModelActivationControls.audio-cpp-actions Horizontal {
    layout: vertical;
    width: 100%;
    min-width: 0;
    height: auto;
}

CuratedView .audio-cpp-actions Button,
InstalledView .audio-cpp-actions Button {
    width: 100%;
    min-width: 0;
    margin: 0 0 1 0;
}

InstalledView .installed-recovery-status {
    color: $warning;
    margin-bottom: 1;
}

CuratedView .curated-disabled-reason,
CuratedView .curated-recovery-status,
InstalledView .model-disabled-reason {
    width: 100%;
    min-width: 0;
    height: auto;
    margin-bottom: 1;
    color: $warning;
}

CuratedView Button:focus,
CuratedView CollapsibleTitle:focus,
InstalledView Button:focus,
InstalledView CollapsibleTitle:focus {
    outline: heavy $accent;
}

/* App-tier disabled ink overrides Textual's generic dimming. The neutral
 * surface plus normal text token remains >=3:1 in all five shipped themes. */
CuratedView Button:disabled,
InstalledView Button:disabled {
    opacity: 100%;
    text-opacity: 100%;
    text-style: none;
    color: $text;
    background: $surface-darken-1;
}

/* ===== MODULE: features/_logs.tcss ===== */
/* ========================================
 * FEATURES: Logs
 * ========================================
 * Logs destination: filter bar, log view, status line, action bar.
 * The user loop: reproduce a problem -> come here -> copy the relevant
 * lines -> share them for investigation. Nothing may occlude log content.
 * ======================================== */

LogsWindow {
    layout: vertical;
}

/* The legacy `.window` class forces `layout: horizontal` (see
 * layout/_windows.tcss); outrank it by id so the Logs destination stays
 * vertical. */
#logs-window {
    layout: vertical;
}

/* Filter bar: level chips + text filter + pause toggle, single row. */
#logs-filter-bar {
    height: 1;
    padding: 0 1;
}

#logs-filter-bar Button {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 1;
    background: $surface;
    color: $text-muted;
}

#logs-filter-bar Button.is-active {
    color: $text;
    text-style: bold underline;
}

#logs-filter-bar Button:hover {
    background: $surface;
    color: $text;
}

#logs-filter-text {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1;
    background: $surface-darken-1;
}

#logs-pause {
    content-align: right middle;
}

/* The log itself takes all remaining space; one entry per row, long
 * lines scroll horizontally instead of wrapping mid-word. */
#app-log-display {
    height: 1fr;
    border: none;
    padding: 0 1;
}

#logs-empty-state {
    color: $text-muted;
    padding: 2;
    height: auto;
}

#logs-status-line {
    height: 1;
    color: $text-muted;
    padding: 0 1;
}

/* Action bar pinned at the bottom: the share actions, always visible,
 * never overlapping log content. */
#logs-action-bar {
    height: auto;
    padding: 0 1;
}

#logs-action-bar Button {
    margin-right: 1;
}

/* ===== MODULE: features/_writing.tcss ===== */
/* ========================================
 * FEATURES: Writing
 * ========================================
 * The legacy `.window` class forces `layout: horizontal` (see
 * layout/_windows.tcss); WritingWindow has no DEFAULT_CSS of its own, so
 * its status line and three-panel layout ended up side-by-side, jammed
 * onto one row. Outrank it by id (same pattern as #logs-window, UX-046).
 * ======================================== */

#writing-window {
    layout: vertical;
}

#writing-status {
    height: auto;
    width: 100%;
}

#writing-layout {
    height: 1fr;
    width: 100%;
}

/* ===== MODULE: features/config_search.tcss ===== */
/* config_search.tcss */
/* Styling for configuration file search functionality */

/* Search container */
.config-search-container {
    width: 100%;
    margin-bottom: 1;
    padding: 1;
    background: $panel;
    border: solid $primary;
}

/* Search input */
.config-search-input {
    width: 100%;
    margin-bottom: 1;
}

/* Search results collapsible */
.config-search-results {
    width: 100%;
    margin-bottom: 1;
}

.config-search-results Collapsible > Contents {
    max-height: 20;
    overflow-y: auto;
}

/* Results list */
.config-results-list {
    width: 100%;
    height: auto;
    max-height: 20;
    background: $surface;
}

/* Individual search result item */
.config-search-result-item {
    width: 100%;
    padding: 1;
    margin-bottom: 0;
}

.config-search-result-item:hover {
    background: $boost;
}

/* Result info section */
.result-info {
    width: 1fr;
    padding-right: 1;
}

.result-path {
    text-style: bold;
    color: $primary;
}

.result-value {
    color: $text;
    margin-top: 0;
}

.result-context {
    color: $text-muted;
    text-style: italic;
    margin-top: 0;
}

/* Result action buttons */
.result-actions {
    dock: right;
    width: auto;
    height: 3;
    align: center middle;
}

.result-goto-btn {
    margin-right: 1;
    min-width: 8;
}

.result-edit-btn {
    min-width: 8;
}

/* Highlight matches in search results */
ConfigSearchResult.-highlight {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

/* Ensure the config editor has proper spacing when search is shown */
#config-text-area {
    height: 1fr;
    min-height: 20;
}

/* Highlight effect for found UI elements */
.search-highlight {
    background: $warning 30%;
    border: solid $warning;
    border-bottom: solid $warning;
}

Input.search-highlight:focus,
TextArea.search-highlight:focus {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    outline: none;
}

Select.search-highlight {
    background: $warning 30%;
}

Checkbox.search-highlight {
    color: $warning;
}

TextArea.search-highlight {
    border: solid $warning;
    border-bottom: solid $warning;
}

/* ===== MODULE: features/feature_alerts.tcss ===== */
/* feature_alerts.tcss */
/* Styling for feature availability alerts */

FeatureNotAvailableDialog {
    width: 70;
    height: auto;
    background: $panel;
    border: thick $warning;
    align: center middle;
    layer: dialog;
    padding: 2 4;
    opacity: 0.98;
}

FeatureNotAvailableDialog > Vertical {
    width: 100%;
    height: auto;
}

FeatureNotAvailableDialog .dialog-title {
    text-align: center;
    color: $warning;
    text-style: bold;
    margin-bottom: 1;
    padding: 1 0;
}

FeatureNotAvailableDialog .dialog-message {
    margin-bottom: 1;
    text-align: center;
    color: $text;
}

FeatureNotAvailableDialog .install-command {
    background: $boost;
    padding: 1 2;
    margin: 1 0;
    border: solid $primary;
    text-align: center;
    color: $text-muted;
}

FeatureNotAvailableDialog .button-container {
    dock: bottom;
    align: center middle;
    height: 3;
    margin-top: 1;
}

FeatureNotAvailableDialog Button {
    margin: 0 1;
    min-width: 12;
}

/* ===== MODULE: utilities/_helpers.tcss ===== */
/* ========================================
 * UTILITIES: Helpers
 * ======================================== 
 * Utility classes for common patterns
 * ======================================== */

/* Visibility utilities */
.hidden {
    display: none !important;
}

/* ===== MODULE: utilities/_states.tcss ===== */
/* ========================================
 * UTILITIES: States
 * ======================================== 
 * State modifiers: disabled, hidden, active, etc.
 * ======================================== */

/* --- Utility/Not-Tab Specific --- */

.disabled {
    /* Make the button semi-transparent. This is the most effective way
       to show it's inactive and works just like web CSS. */
    opacity: 0.6;

    /* To achieve a "grayscale" effect, we manually set the colors
       to be less vibrant, using Textual's design tokens for theming. */
    background: $panel-darken-2;
    color: $text-muted;

    /* You can also ensure the border is muted. */
    border: round $primary-darken-2;
}
/* --- End of Utility/Not-Tab Specific --- */

/* ===== MODULE: utilities/_overrides.tcss ===== */
/* ========================================
 * UTILITIES: Overrides
 * ======================================== 
 * Important overrides and edge case fixes
 * ======================================== */

/* TASK-382 / TASK-386: opaque, bordered tooltip surface.
 *
 * Textual's default Tooltip is borderless and fills with $panel, so over the
 * Console header or a provider-test result line it reads as bare text bleeding
 * into the widget underneath (interleaved fragments like "control actions.").
 * A visible border plus an explicit opaque fill turns it into a distinct
 * surface that fully COVERS what it overlaps instead of garbling it. */
Tooltip {
    background: $panel;
    color: $text;
    border: round $primary;
    padding: 0 1;
    max-width: 60;
}
