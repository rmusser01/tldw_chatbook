    padding: $ds-space-1;
}

#workflows-inspector-pane,
#acp-inspector-pane {
    width: $ds-fr-2;
    min-width: $ds-size-34;
    border: solid $ds-grid-line;
    padding: $ds-space-1;
}

.acp-selected-session-row {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.acp-inspector-group-title {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

#personas-list-detail-divider,
#personas-detail-inspector-divider,
#watchlists-list-detail-divider,
#watchlists-detail-inspector-divider,
#schedules-list-detail-divider,
#schedules-detail-inspector-divider,
#workflows-list-detail-divider,
#workflows-detail-inspector-divider,
#acp-list-detail-divider,
#acp-detail-inspector-divider {
    background: $ds-grid-line;
}

.artifacts-column-title,
.personas-column-title,
.watchlists-column-title,
.schedules-column-title,
.workflows-column-title,
.acp-column-title,
.skills-column-title,
.ccp-column-title,
.settings-column-title {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    background: $ds-surface-raised;

    color: $accent;
    text-style: bold;
}

RagProfileNameModal,
RagProfileSwitchConfirmModal {
    align: center middle;
}

_CredentialEditorModal,
_CredentialClearModal {
    align: center middle;
}



.is-active {
    border: round $ds-action-focus;
    text-style: bold;
}

.personas-mode-chip.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.personas-mode-chip.is-active:focus {
    outline: none;
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}


ListItem.personas-library-row.-highlight,
ListItem.personas-conversation-row.-highlight {
    background: $ds-grid-line;
    color: $ds-text-primary;
    text-style: bold;
}


ListItem.personas-library-row.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}


ListItem.personas-library-row.is-active.-highlight {
    outline: none;
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}


#personas-library-rows:focus {
    outline: none;
}

.is-disabled {
    opacity: 0.55;
}

.is-blocked {
    border: round $ds-status-error;
    background: $ds-status-error 10%;
}

.is-running {
    border: round $ds-status-running;
}

.is-paused {
    border: round $ds-status-paused;
}

.is-unsaved {
    border: round $ds-status-unsaved;
}

.is-stale {
    color: $ds-text-muted;
}

.is-conflict {
    border: thick $ds-status-error;
}

.needs-approval {
    border: thick $ds-status-approval-required;
    background: $ds-status-approval-required 12%;
}

.source-local {
    border: round $ds-authority-local;
}

.source-server {
    border: round $ds-authority-server;
}

.source-workspace {
    border: round $ds-authority-workspace;
}

.source-remote-only {
    border: round $ds-authority-remote-only;
}

.source-dry-run {
    border: dashed $ds-grid-line;
    color: $ds-text-muted;
}



#mcp-mode-strip Button.mcp-mode-chip {
    width: auto;
    min-width: $ds-size-10;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
}

#mcp-mode-strip .mcp-mode-chip.is-active {
    text-style: bold underline;
}


#mcp-mode-strip .mcp-mode-chip:focus,
#mcp-mode-strip .mcp-mode-chip:hover:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
    outline: none;
}

#mcp-mode-strip .mcp-mode-chip.is-active:focus,
#mcp-mode-strip .mcp-mode-chip.is-active:hover:focus {
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: bold underline;
    outline: none;
}


#lab-mode-strip Button.lab-mode-chip {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
}

#lab-mode-strip .lab-mode-chip.is-active {
    border: none;
    text-style: bold underline;
}

#lab-mode-strip .lab-mode-chip:focus,
#lab-mode-strip .lab-mode-chip:hover:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
    outline: none;
}

#lab-mode-strip .lab-mode-chip.is-active:focus,
#lab-mode-strip .lab-mode-chip.is-active:hover:focus {
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: bold underline;
    outline: none;
}

#mcp-hub-rail {
    width: $ds-fr-3;
    min-width: $ds-size-24;
}

#mcp-hub-rail .mcp-rail-heading {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-top: $ds-space-1;
}


#mcp-hub-rail Button.mcp-rail-row.is-active {
    border: none;
    text-style: bold;
}

#mcp-hub-canvas {
    width: $ds-fr-5;
    min-width: $ds-size-38;
}

#mcp-hub-inspector {
    width: $ds-fr-3;
    min-width: $ds-size-28;
    height: $ds-height-full;
    min-height: $ds-size-0;
}


#mcp-hub-grid.mcp-compact #mcp-hub-rail {
    width: $ds-fr-2;
    min-width: $ds-size-16;
}

#mcp-hub-grid.mcp-compact #mcp-hub-canvas {
    width: $ds-agentic-mcp-compact-canvas-share;
    min-width: $ds-size-30;
}

#mcp-hub-grid.mcp-compact #mcp-hub-inspector {
    width: $ds-fr-2;
    min-width: $ds-size-20;
}


#mcp-overview-summary-row {
    height: auto;
    min-height: $ds-size-1;
}

#mcp-detail-title {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

#mcp-overview-callouts .ds-recovery-callout {
    margin-top: $ds-space-1;
}


#mcp-hub-inspector Button.mcp-inspector-action:disabled {
    opacity: 100%;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: none;
}

#mcp-hub-inspector Button.mcp-inspector-action:disabled:hover {
    opacity: 100%;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: none;
}


Button.mcp-inspector-action {
    text-align: left;
    content-align: left middle;
}


.mcp-status-ready { color: $ds-status-ready; }
.mcp-status-warning { color: $ds-status-warning; }
.mcp-status-error { color: $ds-status-error; }
.mcp-status-info { color: $ds-status-info; }

.mcp-status-muted { color: $ds-text-muted; }

Button.mcp-callout {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;

    text-align: left;
    content-align: left middle;
}

#mcp-servers-form {
    height: auto;
    min-height: $ds-size-0;
}


#mcp-servers-table {
    height: auto;
    max-height: $ds-agentic-mcp-table-cap;
}


#mcp-tools-table {
    height: auto;
    max-height: $ds-agentic-mcp-table-cap;
}


#mcp-perm-table {
    height: auto;
    max-height: $ds-agentic-mcp-table-cap;
}


#mcp-perm-preview {
    height: auto;
    min-height: $ds-size-0;
}


#mcp-tools-filter-server-slot Select {
    width: $ds-size-28;
}




#mcp-detail-builtin-toggles {
    height: auto;
    min-height: $ds-size-0;
}


#mcp-detail-tool-gates {
    height: auto;
    min-height: $ds-size-0;
}

#mcp-detail-toolbar Button {
    height: $ds-size-1;
    min-height: $ds-size-1;
    border: none;
}


#mcp-import-list {
    height: auto;
    min-height: $ds-size-0;
}


#mcp-detail-scroll:focus,
#mcp-adv-scroll:focus {
    outline: none;
    border: none;
    background: $ds-surface-panel;
}


MCPSchemaForm Checkbox {
    width: auto;
    height: auto;
    min-height: $ds-size-1;
}
MCPSchemaForm Checkbox > .toggle--button {
    color: $ds-surface-panel;
}
MCPSchemaForm Checkbox.-on > .toggle--button {
    color: $success;
}




#mcp-audit-table {
    height: auto;
    max-height: $ds-agentic-mcp-table-cap;
}


#mcp-audit-findings-table {
    height: auto;
    max-height: $ds-agentic-mcp-table-cap;
}


#mcp-audit-subview-strip {
    height: auto;
    min-height: $ds-size-0;
}


#mcp-audit-filter-decision {
    width: $ds-size-24;
}
#mcp-audit-filter-initiator {
    width: $ds-size-20;
}


#approval-batch-body,
#approval-batch-actions {
    height: auto;
}


#approval-batch-rows {
    height: auto;
    min-height: $ds-size-0;

    max-height: $ds-size-15;
    overflow-y: auto;
}
.approval-row {
    height: auto;
    min-height: $ds-size-1;
    width: $ds-width-fill;
}

.approval-row-controls {
    height: auto;
    min-height: $ds-size-1;
    width: $ds-width-fill;
}
.approval-row-header {
    width: $ds-width-fill;
}
.approval-row-args {
    width: $ds-width-fill;
}
.approval-row-full-command {
    width: $ds-width-fill;
    height: $ds-size-6;
    min-height: $ds-size-3;
}
.approval-row-raw-label,
.approval-row-raw-metadata,
.approval-row-raw-warning,
.approval-row-raw-scope {
    width: $ds-width-fill;
    height: auto;
}

.approval-row-decision {
    width: $ds-agentic-prompt-vars-pane;
}

.approval-row-reason,
.approval-row-scope {
    width: $ds-width-fill;
    height: auto;
}

.approval-row-fast-approve,
.approval-row-fast-deny {
    width: $ds-size-14;
    min-width: $ds-size-14;
}

.approval-row.needs-decision {
    border: solid $ds-status-approval-required;
    background: $ds-status-approval-required 10%;
}


ConsoleScopePickerModal {
    align: center middle;
}


ConsolePromptsModal {
    align: center middle;
}


PromptBlockEditor #prompt-editor-lane-options Checkbox {
    width: auto;
    height: $ds-size-3;
    margin-bottom: $ds-space-0;
}


#internal-prompts-search { width: $ds-width-fill; margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0; }
#internal-prompts-list { height: $ds-height-fill; }
.internal-prompts-group-header { text-style: bold; padding: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0; color: $text-muted; }
.internal-prompt-row { width: $ds-width-fill; height: auto; text-align: left; content-align: left middle; }
.internal-prompt-row.row-customized { border-left: thick $accent; }
.internal-prompt-row.row-default-changed { border-left: thick $warning; }
#internal-prompt-editor-modal { width: $ds-percent-90; max-width: $ds-size-120; height: auto; max-height: $ds-percent-90; padding: $ds-space-1 $ds-space-2; background: $panel; border: thick $primary; }
.internal-prompt-editor-contract { color: $warning; padding: $ds-space-1 $ds-space-0; }
.internal-prompt-editor-chips { color: $text-muted; }
.internal-prompt-editor-applies { color: $text-muted; text-style: italic; }
.internal-prompt-editor-preview { background: $boost; padding: $ds-space-1; height: auto; max-height: $ds-size-12; }
.internal-prompt-editor-error { color: $error; }
.internal-prompt-editor-actions { align-horizontal: right; height: auto; padding: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0; }

ImageGenSettingsPanel Checkbox > .toggle--button {
    color: $ds-surface-panel;
}
ImageGenSettingsPanel Checkbox.-on > .toggle--button {
    color: $success;
}


LibraryIngestCanvas .type-group-contents {
    height: auto;
}
LibraryIngestCanvas .type-group-contents Checkbox {
    width: auto;
    height: auto;
}
LibraryIngestCanvas .type-group-field-label {
    color: $text-muted;
    margin-top: $ds-space-1;
}


LibraryIngestCanvas Input > .input--placeholder,
LibraryIngestCanvas Input:disabled > .input--placeholder {
    color: $ds-text-placeholder;
}


LibraryIngestCanvas Input:focus {
    outline: heavy $accent;
}

LibraryIngestCanvas Button:focus {
    text-style: bold reverse;
}
LibraryIngestCanvas Checkbox:focus {
    outline: heavy $accent;
}

LibraryIngestCanvas Select:focus {
    outline: heavy $accent;
}

LibraryIngestCanvas Select:focus > SelectCurrent {
    border: heavy $ds-input-focus-accent;
}

LibraryIngestCanvas CollapsibleTitle:focus {
    text-style: bold reverse;
}



LibraryIngestCanvas Collapsible > CollapsibleTitle {
    width: $ds-width-fill;
    height: $ds-size-1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}


LibraryIngestCanvas Collapsible {
    padding-bottom: $ds-space-0;
}
LibraryIngestCanvas Collapsible Contents {
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-3;
}


LibraryIngestCanvas Collapsible > CollapsibleTitle:focus {
    border-bottom: none;
    text-style: bold reverse;
    outline-left: heavy $ds-focus-accent;
    outline-right: heavy $ds-focus-accent;
}

LibraryIngestCanvas Collapsible.-collapsed > CollapsibleTitle:focus {
    border-bottom: none;
}


LibraryIngestCanvas .type-group-field-error {

    color: $ds-status-error-readable;
    height: auto;
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-2;
}


LibraryIngestCanvas Input.-ingest-option-invalid {
    border: tall $ds-status-error-readable;
}


LibraryIngestCanvas Button:disabled {

    opacity: 100%;
    text-opacity: 100%;
    color: $text-muted;
    background: $surface-darken-1;
}


LibraryIngestCanvas Input:disabled,
LibraryIngestCanvas Select:disabled,
LibraryIngestCanvas Checkbox:disabled {
    opacity: 100%;
    text-opacity: 100%;
    color: $text-muted;
    background: $surface-darken-1;
}

LibraryIngestCanvas Select:disabled SelectCurrent {
    background: $surface-darken-1;
    color: $text-muted;
}
LibraryIngestCanvas Select:disabled SelectCurrent Static#label {
    color: $text-muted;
}


Toast {
    margin-bottom: $ds-space-2;
}


LibraryIngestCanvas:focus {
    border: none;
    outline: none;
}
LibraryIngestCanvas:focus-within {
    border: none;
    outline: none;
}

#notes-sync-body,
#notes-sync-roots-body {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-gutter: stable;
}

#notes-sync-pinned-actions,
#notes-sync-roots-pinned-actions {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    max-height: $ds-size-3;
    background: $surface-darken-1;
}

.notes-sync-conflict-choice.is-selected {
    background: $accent 18%;
    text-style: bold;
}

.notes-sync-conflict-title,
.notes-sync-conflict-path,
.notes-sync-conflict-effect,
.notes-sync-conflict-selected {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    text-wrap: wrap;
    text-overflow: clip;
}

.notes-sync-conflict-path,
.notes-sync-conflict-effect,
.notes-sync-conflict-selected {
    color: $text-muted;
}

.notes-sync-comparison-diff {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-8;
    min-height: $ds-size-4;
    overflow-x: auto;
    overflow-y: auto;
}

.notes-sync-receipt-actions,
.notes-sync-history-actions {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-1;
}

.notes-sync-receipt-actions > Button,
.notes-sync-history-actions > Button {
    min-width: $ds-size-0;
}

.notes-sync-history-page {
    width: auto;
    min-width: $ds-size-6;
    height: $ds-size-1;
    content-align: left middle;
}

ConsoleCapturePolicyDialog,
ConsoleExchangeExportDialog {
    align: center middle;
}

#capture-policy-dialog,
#exchange-export-dialog {
    width: $ds-size-76;
    max-width: $ds-percent-96;
    height: $ds-size-22;
    max-height: $ds-percent-96;
    border: tall $primary;
    background: $surface;
    padding: $ds-space-1 $ds-space-2;
}

#capture-policy-title,
#exchange-export-title {
    height: $ds-size-1;
    text-style: bold;
}

#capture-policy-body,
#exchange-export-body {
    height: $ds-height-fill;
    scrollbar-gutter: stable;
}

#capture-policy-scopes,
#capture-policy-details,
#exchange-export-profiles,
#exchange-export-destinations {
    height: auto;
}

#capture-policy-effective,
#capture-policy-reason,
#capture-policy-count,
#capture-policy-status,
#exchange-export-profile-copy,
#exchange-export-full-reason,
#exchange-export-status {
    height: auto;
}

#capture-policy-reason,
#exchange-export-full-reason {
    color: $warning;
}

#capture-policy-actions,
#exchange-export-actions {
    height: $ds-size-3;
    min-height: $ds-size-3;
    align-horizontal: right;
}

#capture-policy-actions Button,
#exchange-export-actions Button {
    min-width: $ds-size-10;
    margin-left: $ds-space-1;
}

#capture-policy-status.-error,
#exchange-export-status.-error {
    color: $error;
}

#exchange-export-path {
    height: $ds-size-3;
}


BuddyConversationModal #approval-batch-body {
    height: auto;
}
BuddyConversationModal .approval-row-decision {
    width: $ds-width-fill;
    min-width: $ds-size-10;
}


ConsoleAgentProgressModal { align: center middle; background: $background 60%; }
#agent-progress-dialog { width: $ds-percent-90; max-width: $ds-size-110; height: $ds-percent-85; border: round $primary; background: $panel; padding: $ds-space-1 $ds-space-2; }
#agent-progress-scope, #agent-progress-count, #agent-progress-status { height: auto; margin-bottom: $ds-space-1; }
#agent-progress-scope { color: $ds-text-muted; }
#agent-progress-list { height: $ds-size-5; min-height: $ds-size-3; margin-bottom: $ds-space-1; }
#agent-progress-detail { height: $ds-height-fill; min-height: $ds-size-3; margin-bottom: $ds-space-1; }
#agent-progress-body { height: auto; }
#agent-progress-actions { height: $ds-size-3; align-horizontal: right; }
#agent-progress-actions Button { min-width: $ds-size-10; margin-left: $ds-space-1; }

/* ===== MODULE: components/_workbench.tcss ===== */




.workbench-frame {
    width: $ds-width-full;
    height: $ds-height-full;
    min-height: $ds-size-0;
    layout: vertical;
    overflow: hidden;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.workbench-header {
    height: auto;
    min-height: $ds-size-2;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.workbench-header-title {
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-style: bold;
}

.workbench-header-subtitle {
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $ds-text-muted;
}

.workbench-header.has-empty-subtitle .workbench-header-subtitle {
    display: none;
}

.workbench-header-status {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
}


#personas-header.status-blocked .workbench-header-status {
    color: $ds-status-blocked;
}


#personas-conversation-resume:disabled {
    opacity: 100%;
    text-opacity: 100%;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: none;
}


#personas-conversation-resume,
#personas-conversation-continue-console,
#personas-conversation-back,
#personas-conversation-open-library,
#personas-conversation-back-source {
    height: $ds-size-3;
    min-height: $ds-size-3;
}

#personas-conversations-search {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
    border: none;
}


#personas-workbench.personas-workbench-narrow.personas-transcript-active #personas-preview-pane {
    display: none;
}

#personas-workbench.personas-workbench-narrow.personas-transcript-active #personas-work-area {
    border: none;
    padding: $ds-space-0;
}

#personas-workbench.personas-workbench-narrow.personas-transcript-active #personas-conversation-navigation-actions {
    layout: vertical;
}

#personas-workbench.personas-workbench-narrow.personas-transcript-active .personas-conversation-navigation-action {
    width: $ds-width-full;
    padding: $ds-space-0;
}

.workbench-command-strip,
.workbench-mode-strip {
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    layout: horizontal;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.workbench-action,
.workbench-mode {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

.workbench-action {
    padding: $ds-space-0 $ds-space-1;
}

.workbench-action.is-primary {
    text-style: bold;
}


.workbench-action.is-disabled {
    color: rgb(245,245,245);
    opacity: 1;
    text-style: none;
}

.workbench-mode {
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
}

.workbench-mode.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

.workbench-recovery-callout {
    height: auto;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    border: solid $ds-status-warning;
    background: $ds-status-warning 10%;
    color: $ds-text-primary;
}

.workbench-recovery-callout.is-hidden {
    display: none;
}

.workbench-recovery-title {
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-style: bold;
}

.workbench-recovery-body {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-primary;
}

.workbench-recovery-action {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

.workbench-pane-region {
    height: $ds-height-fill;
    min-height: $ds-size-0;
    layout: horizontal;
    overflow: hidden;
}

.workbench-pane {
    width: $ds-width-fill;
    height: $ds-height-fill;
    min-width: $ds-size-0;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

.workbench-pane.is-collapsed {
    width: $ds-size-3;
    min-width: $ds-size-3;
}

.workbench-pane-title,
.workbench-pane-status {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

.workbench-pane-title {
    text-style: bold;
}

.workbench-state-block {
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    layout: horizontal;
    background: $ds-surface-raised;
    color: $ds-text-muted;
}

.workbench-state-route,
.workbench-state-density {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

.workbench-frame .status-ready {
    border-title-color: $ds-status-ready;
}

.workbench-frame .status-running,
.workbench-frame .status-loading {
    border-title-color: $ds-status-running;
}

.workbench-frame .status-blocked,
.workbench-frame .status-error {
    border-title-color: $ds-status-error;
}

.workbench-frame .status-paused,
.workbench-frame .status-empty {
    border-title-color: $ds-status-warning;
}

.density-normal .workbench-header {
    min-height: $ds-size-2;
    padding: $ds-space-0 $ds-space-1;
}

.density-normal .workbench-pane {
    padding: $ds-space-1;
}

.density-compact .workbench-header {
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}

.density-compact .workbench-header-subtitle {
    display: none;
}

.density-compact .workbench-pane {
    padding: $ds-space-0 $ds-space-1;
}


.shell-header-compact .workbench-header {
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}

.shell-header-compact .workbench-header-subtitle {
    display: none;
}


WorkbenchHelpPanel {
    align: center middle;
}

#workbench-help-panel {
    width: $ds-size-76;
    max-width: $ds-percent-95;
    height: auto;
    max-height: $ds-percent-90;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    padding: $ds-space-1 $ds-space-2;
}

#workbench-help-scroll {
    height: $ds-height-fill;
    min-height: $ds-size-3;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

#workbench-help-body {
    width: $ds-width-full;
    height: auto;
}

#workbench-help-close {
    width: auto;
    height: auto;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

/* ===== MODULE: components/_widgets.tcss ===== */





Collapsible {
    height: auto;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: round $surface-lighten-1;
    background: $surface;
}


Collapsible > CollapsibleTitle:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border-bottom: solid $ds-focus-accent;
    outline: none;
}

Collapsible.-collapsed > CollapsibleTitle:focus {
    border-bottom: solid $ds-focus-accent;
}


#settings-library-rag-card Collapsible > CollapsibleTitle {
    height: $ds-size-2;
    min-height: $ds-size-2;
    padding: $ds-space-0 $ds-space-1;
    background: $surface-lighten-1;
    color: $text;
    border-bottom: solid $border;
}

#settings-library-rag-card Collapsible > CollapsibleTitle:hover {
    background: $surface;
    color: $text;
}

#settings-library-rag-card Collapsible.-collapsed > CollapsibleTitle {
    border-bottom: none;
}


#settings-library-rag-card Collapsible > CollapsibleTitle:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border-bottom: solid $ds-focus-accent;
    outline: none;
}

#settings-library-rag-card Collapsible.-collapsed > CollapsibleTitle:focus {
    border-bottom: solid $ds-focus-accent;
}

Collapsible > Contents {
    height: auto;
    padding: $ds-space-1;
    background: $surface;
}


#chat-rag-panel > .collapsible--header,
#character-rag-panel > .collapsible--header {
    height: $ds-size-1;
    min-height: $ds-size-1;
}


.settings-collapsible {
    height: auto !important;
    min-height: $ds-size-3 !important;
}

.settings-collapsible > Contents {
    height: auto !important;
    padding: $ds-space-1;
}


.settings-collapsible Checkbox {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.settings-collapsible Toggle {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.chat-system-prompt-styling {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-3;
    max-height: $ds-size-10;
    border: round $surface;
    margin-bottom: $ds-space-1;
}




AppFooterStatus {
    dock: bottom;
    height: $ds-size-1;
    background: $primary-background-darken-1;
    width: $ds-width-full;
    layout: horizontal;
    padding: $ds-space-0 $ds-space-1;

}

#footer-key-palette {
    width: auto;
    padding: $ds-space-0 $ds-space-1;
    color: $text-muted;
    dock: left;
    visibility: visible;
    display: initial;
}

#footer-key-quit {
    width: auto;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    color: $text-muted;
    dock: left;
}

#footer-spacer {
    width: $ds-width-fill;
    height: $ds-size-1;
}

#footer-word-count {
    width: auto;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    color: $text-muted;
    display: block;
}

#footer-token-count {
    width: auto;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    color: $text-muted;
    display: block;
}

#internal-db-size-indicator {
    width: auto;
    height: $ds-size-1;


    color: $text-muted;
    dock: right;
    padding: $ds-space-0 $ds-space-1;
    margin-left: $ds-space-2;
}



.loading-state-container {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-10;
}

.loading-view {
    align: center middle;
    padding: $ds-space-2;
}

.loading-text {
    margin-top: $ds-space-1;
    color: $text-muted;
}

.error-view {
    align: center middle;
    padding: $ds-space-2;
    background: $error 10%;
    border: round $error;
}

.error-icon {
    color: $error;
    text-style: bold;
}

.error-message {
    margin: $ds-space-1 $ds-space-0;
    color: $error;
    text-align: center;
}

.error-actions {
    margin-top: $ds-space-1;
    align: center middle;
}

.error-actions Button {
    margin: $ds-space-0 $ds-space-1;
}


.skeleton-container {
    width: $ds-width-full;
    padding: $ds-space-1;
}

.skeleton-avatar {
    width: $ds-size-8;
    height: $ds-size-4;
    background: $surface-lighten-2;
    border: round $surface-lighten-2;
}

.skeleton-title {
    width: $ds-widgets-skeleton-title-share;
    height: $ds-size-1;
    background: $surface-lighten-2;
    margin-bottom: $ds-space-1;
}

.skeleton-subtitle {
    width: $ds-percent-40;
    height: $ds-size-1;
    background: $surface-lighten-1;
}

.skeleton-line {
    height: $ds-size-1;
    background: $surface-lighten-1;
    margin-bottom: $ds-space-1;
}

.skeleton-line-full {
    width: $ds-width-full;
}

.skeleton-line-90 {
    width: $ds-percent-90;
}

.skeleton-line-80 {
    width: $ds-percent-80;
}

.skeleton-line-70 {
    width: $ds-percent-70;
}


.skeleton-line,
.skeleton-avatar,
.skeleton-title,
.skeleton-subtitle {
    opacity: 70%;
}


InlineLoader.loading {
    color: $primary;
}

InlineLoader.success {
    color: $success;
}

InlineLoader.error {
    color: $error;
}




EmojiButton.emoji_button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

PathBreadcrumbs .breadcrumb-button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

BaseTamagotchi:focus {
    border: round $ds-focus-accent;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

ChatbooksWindowImproved .search-input:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

/* ===== MODULE: components/stats_screen.css ===== */



#stats-container {
    background: $surface;
    height: $ds-height-full;
    width: $ds-width-full;
    padding: $ds-space-1;
}


.stats-header {
    text-align: center;
    text-style: bold;
    background: $primary-background-lighten-2;
    color: $text;
    padding: $ds-space-1 $ds-space-2;
    margin-bottom: $ds-space-1;
    border: solid $primary;
}


#stats-scroll {
    height: $ds-height-full;
    background: $surface;
}

#stats-content {
    padding: $ds-space-0 $ds-space-2;
    height: auto;
}




.subsection-header {
    color: $text-muted;
    margin: $ds-space-1 $ds-space-0;
    padding-left: $ds-space-2;
}


.stats-grid {
    layout: grid;
    grid-size: 2 2;
    grid-gutter: 1 1;
    margin-bottom: $ds-space-1;
    height: auto;
    grid-rows: auto;
}

.stats-grid.overview-grid {
    grid-size: 2 2;
}

.stats-grid.activity-grid {
    grid-size: 2 2;
}

.stats-grid.prefs-grid {
    grid-size: 2 2;
}

.stats-grid.ranges-grid {
    grid-size: 2 2;
}

.stats-grid.fun-grid {
    grid-size: 2 2;
}


StatCard {
    background: $panel;
    border: solid $border;
    height: auto;
    min-height: $ds-size-6;
    padding: $ds-space-1;
}

StatCard:hover {
    background: $primary-background-lighten-1;
    border: solid $primary;
}

.stat-card-inner {
    layout: vertical;
    align: center middle;
    width: $ds-width-full;
    height: auto;
}

.stat-card-icon {
    text-align: center;
    text-style: none;
    margin-bottom: $ds-space-0;
}

.stat-card-title {
    text-align: center;
    color: $text-muted;
    text-style: none;
    margin-bottom: $ds-space-0;
}

.stat-card-value {
    text-align: center;
    text-style: bold;
    color: $primary;
    margin: $ds-space-0;
}

.stat-card-subtitle {
    text-align: center;
    color: $text-disabled;
    text-style: italic;
    margin-top: $ds-space-0;
}


.topic-bar-container {
    width: $ds-width-full;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
    align: left middle;
}

.topic-label {
    min-width: $ds-size-20;
    text-align: left;
    color: $text;
}

.topic-bar-bg {
    width: $ds-width-fill;
    height: $ds-size-1;
    background: $surface-lighten-1;
    margin-left: $ds-space-1;
}

.topic-bar-fill {
    height: $ds-size-1;
    background: $primary;
    transition: width 500ms;
}


.topics-container {
    background: $panel;
    border: solid $border;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
    height: auto;
}


.topic-range-card {
    height: auto;
    min-height: $ds-size-4;
}

.topic-range-card .stat-card-value {
    text-style: none;
}


.character-stats-container {
    background: $panel;
    border: solid $border;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
    height: auto;
}

.character-total {
    text-style: bold;
    color: $primary;
    margin-bottom: $ds-space-1;
}

.character-item {
    padding: $ds-space-0 $ds-space-1;
    margin-bottom: $ds-space-1;
}

.character-name {
    text-style: bold;
    color: $text;
}

.character-stats {
    color: $text-muted;
    text-style: italic;
    padding-left: $ds-space-2;
}


.loading-container {
    align: center middle;
    height: $ds-size-20;
}

.loading-text {
    margin-top: $ds-space-2;
    color: $text-muted;
}


.error-container {
    align: center middle;
    padding: $ds-size-4;
}

.error-message {
    color: $error;
    text-style: bold;
    margin-bottom: $ds-space-2;
}

.retry-button {
    margin-top: $ds-space-1;
}


.no-data-message {
    text-align: center;
    color: $text-muted;
    padding: $ds-size-4;
}



/* ===== MODULE: components/_settings_splash_theme.tcss ===== */





#settings-theme-tree {
    width: $ds-width-full;
    height: $ds-size-12;
    min-height: $ds-size-8;
    border: solid $ds-grid-line;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}


.settings-theme-preview {
    width: $ds-width-full;
    height: auto;
    margin: $ds-space-1 $ds-space-0;
    border: solid $ds-grid-line;
}

.settings-theme-preview-row {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
}


.color-swatch {
    width: $ds-size-9;
    min-width: $ds-size-9;
    height: $ds-size-1;
    min-height: $ds-size-1;
    border: none;
    content-align: center middle;
    text-style: bold;
}

.color-preset-swatch {
    width: $ds-size-3;
    min-width: $ds-size-3;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    border: none;
}


.color-preset-swatch:focus {
    outline: solid $ds-focus-accent;
    text-style: bold;
}


#settings-theme-dark-mode {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-bottom: $ds-space-0;
    border: none;
    padding: $ds-space-0;
}
#settings-theme-dark-mode > .toggle--button {
    color: $ds-surface-panel;
}
#settings-theme-dark-mode.-on > .toggle--button {
    color: $success;
}



#settings-workbench.settings-workbench-compact #settings-theme-card .settings-action-row {
    layout: vertical;
    height: auto;
}
#settings-workbench.settings-workbench-compact #settings-theme-card .theme-editor-action {
    width: $ds-width-full;
}


.settings-splash-gallery {
    height: $ds-size-24;
    min-height: $ds-size-16;
    width: $ds-width-full;
}

#settings-splash-card-list {
    width: $ds-percent-45;
    height: $ds-height-full;
    border: solid $primary-lighten-2;
}

#settings-splash-preview-scroll {
    width: $ds-width-fill;
    height: $ds-height-full;
    border: solid $primary-lighten-2;
    background: $surface;
}

.settings-splash-preview {
    width: $ds-width-full;
    height: $ds-height-full;
}

.settings-splash-preview #splash-display {
    width: $ds-width-full;
    height: $ds-height-full;
}



    SettingsThemeEditor .theme-preset-blues-0 { background: $ds-theme-preset-blues-0; }
    SettingsThemeEditor .theme-preset-blues-1 { background: $ds-theme-preset-blues-1; }
    SettingsThemeEditor .theme-preset-blues-2 { background: $ds-theme-preset-blues-2; }
    SettingsThemeEditor .theme-preset-blues-3 { background: $ds-theme-preset-blues-3; }
    SettingsThemeEditor .theme-preset-blues-4 { background: $ds-theme-preset-blues-4; }
