    min-width: $ds-size-0;
    width: $ds-width-fill;
}


ConsoleWorkspaceFilesModal.-compact #console-workspace-files-actions #console-workspace-files-back {
    width: $ds-size-17;
    min-width: $ds-size-17;
}

ConsoleWorkspaceFilesModal.-compact #console-workspace-files-actions #console-workspace-files-back-to-files {
    width: $ds-size-15;
    min-width: $ds-size-15;
}

