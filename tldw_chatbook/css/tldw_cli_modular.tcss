   (components/_widgets.tcss, single consumer). */
$ds-widgets-skeleton-title-share: 60%;
/* Console's rendered frame color (see Console_Modules.frame.
 * CONSOLE_FRAME_COLOR; themes.py pins the same value). The monolith's
 * single grandfathered hex, tokenized on arrival (spec 3.5: it does not
 * travel). */
$ds-console-frame: #6f7782;

/* ========================================
 * MOTION (ADR-150)
 * ========================================
 * Transition durations. fast: hover/affordance feedback; medium: panel and
 * visibility changes; slow: large layout shifts only. No duration outside
 * this scale in new UI. */
$ds-duration-fast: 0.2s;
$ds-duration-medium: 0.3s;
$ds-duration-slow: 0.5s;

/* ========================================
 * OPACITY (ADR-150)
 * ========================================
 * Legacy de-emphasis only. The disabled state of action controls is NOT
 * opacity: TASK-25822 measured opacity-on-dim-text compositing to 1.34:1
 * (reads as absent, not unavailable) — disabled uses $ds-disabled-bg +
 * $ds-text-disabled-readable with full opacity. */
$ds-opacity-dim: 70%;

/* ========================================
 * TYPOGRAPHY EMPHASIS (ADR-150)
 * ========================================
 * TUI typography is weight/style, not size — one cell is one glyph.
 * Scalar keywords only (Textual substitutes variables per token). */
$ds-text-strong: bold;
$ds-text-emphasis: italic;

/* ========================================
 * COMPONENT STATE SURFACES (ADR-150)
 * ========================================
 * The resting/hover/disabled surface vocabulary for action controls.
 * Focus is governed separately by the non-obscuring focus contract above
 * ($ds-focus-bg/$ds-focus-fg) — hover must NOT reuse the focus surface. */
$ds-hover-bg: $surface-lighten-1;
$ds-hover-fg: $ds-text-primary;
$ds-disabled-bg: $surface-darken-1;
/* Recessed resting surface for ENABLED chrome that sits visually below the
 * panel (inactive toggles, sunken strips). Not a disabled state — disabled
 * action controls use $ds-disabled-bg + $ds-text-disabled-readable. Same
 * hue, different semantics: re-theming disabled states must not drag
 * enabled chrome with it (Qodo review, PR #2632). */
$ds-surface-sunken: $surface-darken-1;

/* ========================================
 * LAYOUT LAWS (ADR-150)
 * ========================================
 * App-shell geometry shared by every screen using the standard sidebar
 * shell. Feature-specific geometry stays in its feature sheet until a
 * second consumer appears, then it promotes here. */
$ds-sidebar-width: 25%;
$ds-sidebar-min-width: 35;
$ds-sidebar-max-width: 80;

/* ===== MODULE: core/_reset.tcss ===== */
/* ========================================
 * CORE: Reset/Normalize
 * ======================================== 
 * Base resets and default styles
 * ======================================== */

/* Visible non-obscuring keyboard focus fallback.
 *
 * "Non-obscuring" is the intent, not a guarantee: Textual paints an `outline`
 * OVER the widget's outermost rendered lines rather than around them, so for
 * any widget that draws meaningful content or click metadata on its own
 * perimeter this rule DOES obscure. `DataTable` is the case that bites --
 * see the TASK-1160 block in components/_lists.tcss, which opts every table
 * out of this rule and replaces the cue with content-safe recolouring. Prefer
 * that pattern over adding another screen-local `outline: none`. */
*:focus {
    outline: solid $ds-focus-accent;
}

/* REMOVED: These rules were causing layout shifts and visual issues */
/* *:hover { border: none; } */
/* *:focus-within { border: none; } */

/* Widgets should maintain consistent dimensions across all states */
/* Focus and hover states should only change colors, not layout */

/* ===== MODULE: core/_base.tcss ===== */
/* ========================================
 * CORE: Base Styles
 * ======================================== 
 * Root elements: Screen, Header, Footer
 * Foundation for the entire application
 * ======================================== */

Screen { layout: vertical; }
Header { dock: top; height: 1; background: $panel; }
Footer { dock: bottom; height: 1; background: $panel; }
#content { height: 1fr; width: 100%; }

/* App-wide scrollbar defaults (TASK-394). Consolidated here -- a deliberate
 * foundation rule -- from the two bare `VerticalScroll` selectors that had
 * leaked out of feature modules (the splash/theme module and _conversations);
 * this is the union of what both set, so the effective app-wide scrollbar is
 * unchanged. */
VerticalScroll {
    scrollbar-background: $surface-darken-1;
    scrollbar-color: $primary;
    scrollbar-color-hover: $primary-lighten-1;
    scrollbar-color-active: $primary-lighten-2;
    scrollbar-size: 1 1;
}

/* task-1562: keep transient toasts off the right-hand inspector rails.
 * The default bottom-right ToastRack stacks directly over the Scope
 * Inspector (Settings) and Inspector (Console) -- the panes that carry
 * recovery/boundary copy. Bottom-center floats over transient flowing
 * content instead of persistent guidance. */
Toast {
    /* task-1562: keep transient toasts off the right-hand inspector rails
     * (Scope Inspector in Settings, Inspector in Console) -- they carry
     * recovery/boundary copy. The rack's built-in right-bottom align and
     * its own margins resist app-tier overrides, but a margin on the
     * Toast itself reliably offsets it from that anchor; 46 cells clears
     * the inspector column at supported widths. */
    margin-right: 46;
    /* task-1625: full tinted border per severity instead of the stock
       side-stripe -- DESIGN.md's Don'ts prohibit side-stripe-only
       callouts (>1-cell colored border-left). */
    border: round $ds-grid-line;
    border-left: round $ds-grid-line;
}
Toast.-information {
    border: round $ds-status-info;
    border-left: round $ds-status-info;
}
Toast.-warning {
    border: round $ds-status-warning;
    border-left: round $ds-status-warning;
}
Toast.-error {
    border: round $ds-status-error;
    border-left: round $ds-status-error;
}
/* Qodo PR #1139: three call sites pass severity="success" -- not a
   Textual SeverityLevel, but the Toast still gains a "-success" class,
   which previously fell through unstyled. */
Toast.-success {
    border: round $ds-status-ready;
    border-left: round $ds-status-ready;
}

/* ===== MODULE: core/_typography.tcss ===== */
/* ========================================
 * CORE: Typography
 * ======================================== 
 * Text styles, fonts, and text decorations
 * ======================================== */

/* ===== MODULE: layout/_windows.tcss ===== */
/* ========================================
 * LAYOUT: Windows
 * ======================================== 
 * Base window styles and window management
 * ======================================== */

/* Base style for ALL windows. The watcher will set display: True/False */
.window {
    height: 100%;
    width: 100%;
    layout: horizontal; /* Or vertical if needed by default */
    overflow: hidden;
}

.placeholder-window { 
    align: center middle; 
    background: $panel; 
    display: none;  /* Placeholders should always be hidden */
}

/* ===== MODULE: layout/_tabs.tcss ===== */
/* ========================================
 * LAYOUT: Tab System
 * ======================================== 
 * Tab navigation and tab button styles
 * ======================================== */

#tabs { dock: top; height: 4; background: $background; padding: 0 1; }
#tabs Button { 
    width: 1fr; 
    height: 100%; 
    min-height: 4;
    border: none;  /* No border for tab buttons */
    background: $panel; 
    color: $text-muted; 
    padding: 0 1;
}
#tabs Button:hover { 
    background: $panel-lighten-1; 
    color: $text;
}
#tabs Button.-active { 
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Single-line tab links navigation */
#tab-links-container {
    dock: top;
    height: 4;
    background: $panel;
    padding: 0 1;
    border: solid $accent;
}

#tab-links-inner {
    layout: horizontal;
    height: auto;
    width: auto;
    background: transparent;
    margin: 0;
    padding: 0;
}

#tab-links-inner > Static {
    width: auto;
    height: 1;
    margin: 0;
}

.tab-link {
    color: $text-muted;
    padding: 0 1;
    text-style: none;
    width: auto;
    height: auto;
}

.tab-link:hover {
    color: $text;
    text-style: underline;
    background: $panel-lighten-1;
}

.tab-link.-active {
    color: $ds-focus-fg;
    text-style: bold underline;
    background: transparent;
}

.tab-link.-active:hover {
    text-style: bold underline;
}

Tab.-active,
Tabs:focus .-active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.tab-separator {
    color: $text-muted;
    padding: 0;
    width: auto;
    height: 1;
}

/* Group separators - visually heavier than within-group separators */
.tab-group-separator {
    color: $accent;
    padding: 0 2;
    width: auto;
    height: 1;
    text-style: bold;
}

/* Group separator in button-based tab bar */
#tabs .tab-group-separator {
    width: auto;
    min-width: 3;
    height: 100%;
    min-height: 4;
    background: transparent;
    color: $accent;
    border: none;
    padding: 0 1;
}

/* ===== MODULE: layout/_sidebars.tcss ===== */
/* ========================================
 * LAYOUT: Sidebars
 * ======================================== 
 * Generic sidebar patterns and collapsible behavior
 * Used across multiple features
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


/* ----------------------------------------
 * Enhanced Sidebar Styles
 * ---------------------------------------- */

/* Enhanced sidebar container */
.enhanced-sidebar {
    height: $ds-height-full;
    background: $boost;
}

/* Sidebar header with improved visibility */
.sidebar-header {
    height: $ds-size-3;
    padding: $ds-space-0 $ds-space-1;
    background: $surface;
    border-bottom: solid $surface-lighten-1;
    align: center middle;
}

.sidebar-title {
    text-style: bold;
    color: $text;
    text-align: left;
}

/* Search container with better visibility */
.search-container {
    height: $ds-size-3;
    padding: $ds-space-0 $ds-space-1;
    background: transparent;
    border-bottom: none;
}

.search-input {
    width: $ds-width-full;
    border: round $surface-lighten-1;
    background: $background;
}

/* ----------------------------------------
 * Visual Grouping & Organization
 * ---------------------------------------- */

/* Quick Actions Bar */
.quick-actions-bar {
    height: $ds-size-3;
    padding: $ds-space-0 $ds-space-1;
    margin-bottom: $ds-space-1;
    background: $primary 10%;
    border-bottom: solid $primary;
}

.quick-action-btn {
    width: auto;
    margin: $ds-space-0 $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
}

/* Search Input */
.sidebar-search-input {
    width: $ds-width-full;
    margin: $ds-space-1 $ds-space-0;
    border: round $accent;
}

/* Group Headers */
.group-header {
    text-style: bold;
    color: $text-muted;
    margin: $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
}

/* Section Dividers */
.sidebar-section-divider {
    height: $ds-size-1;
    margin: $ds-space-2 $ds-space-0;
    border-top: solid $primary 30%;
    opacity: 50%;
}

/* Settings Groups with Enhanced Visibility */
.settings-group {
    padding-left: $ds-space-1;
    margin: $ds-space-1 $ds-space-0;
}

/* Improved contrast - from 5% to 15-20% */
.primary-group {
    background: $success 15%;
}

.secondary-group {
    background: $primary 15%;
}

.advanced-group {
    background: $warning 15%;
}

/* Enhanced setting groups with clear visual hierarchy */
.setting-group {
    margin: $ds-space-2 $ds-space-0;
    padding: $ds-space-1;
}

.setting-group-essential {
    border-left: solid $success;
    background: transparent;
}

.setting-group-common {
    border-left: solid $primary;
    background: transparent;
}

.setting-group-advanced {
    border-left: solid $warning;
    background: transparent;
}

/* Priority Indicators */
.priority-high > CollapsibleTitle {
    text-style: bold;
    border-left: thick $success;
    padding-left: $ds-space-1;
}

/* Nested indentation */
.settings-group .settings-collapsible {
    margin-left: $ds-space-1;
}

/* Fix for Collapsible widgets in sidebars */
.settings-collapsible {
    height: auto;
    min-height: $ds-size-3;  /* Ensure title is visible */
}

.settings-collapsible CollapsibleTitle {
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}

.settings-collapsible Contents {
    height: auto;
    padding: $ds-space-1;
}

/* Ensure checkboxes and other controls are visible */
.settings-collapsible Checkbox {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.settings-collapsible Input {
    height: auto;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.settings-collapsible Select {
    height: auto;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* Sidebar Styling */
/* Generic .sidebar (used by #chat-left-sidebar and potentially others) */
.sidebar {
    dock: left;
    /* Layout law (ADR-150): standard shell sidebar geometry is tokenized. */
    width: $ds-sidebar-width; /* Reduced from 35% for better chat area space */
    min-width: $ds-sidebar-min-width; /* Reduced from 45 */
    max-width: $ds-sidebar-max-width; /* Maximum width (optional) */
    background: $boost;
    padding: $ds-space-0 $ds-space-inline;
    border-right: solid $surface;
    height: $ds-height-full;
    overflow-y: auto;
    overflow-x: hidden;
}
/* Collapsed state for the existing left sidebar */
.sidebar.collapsed {
    width: $ds-size-0 !important;
    min-width: $ds-size-0 !important; /* Ensure min-width is also 0 */
    border-right: none !important;
    padding: $ds-space-0 !important;
    overflow: hidden !important;
    display: none; /* ensures it doesn't grab focus */
}

/* Common sidebar elements */
.sidebar-title { text-style: bold; margin-bottom: $ds-space-1; width: $ds-width-full; text-align: left; }

/* Sidebar header with resize controls */
.sidebar-header-with-resize {
    height: $ds-size-2;
    align: left middle;
    margin-bottom: $ds-space-1;
}

.sidebar-header-with-resize .flex-grow {
    width: $ds-width-fill;
}

.sidebar-label { margin-top: $ds-space-1; text-style: bold; }
.sidebar-input {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    border: solid $primary-lighten-2;
    border-bottom: solid $primary-lighten-2;
}
.sidebar-textarea { 
    width: $ds-width-full; 
    height: $ds-size-5;  /* Default height for text areas */
    border: round $surface; 
    margin-bottom: $ds-space-1; 
}

/* Notes expand button */
/* T169: the two legacy "notes content header"/"notes content label"
 * classes previously declared here were pruned -- pre-workbench Notes tab
 * CSS (Notes_Window.py, since removed) with zero live references anywhere
 * in tldw_chatbook/*.py. .notes-expand-button below is still live (Chat
 * sidebar's "Notes" expand control). */
.notes-expand-button {
    width: auto;
    min-width: $ds-size-12;
    height: $ds-size-3;
    margin-left: $ds-space-1;
    padding: $ds-space-0 $ds-space-2;
    color: $text;
    background: $surface;
    text-style: bold;
    text-align: center;
}

/* Ensure button text is visible */
#chat-notes-expand-button {
    color: $text !important;
}

/* General sidebar button styling.
 * ADR-161 task 6: margin-bottom replaces the old `margin: 1 0` shorthand --
 * features/_conversations.tcss's deleted duplicate overrode it with a bare
 * `margin-bottom: 1`, and Textual applies a cross-rule longhand as a
 * full-group replacement, so the computed margin was already (0, 0, 1, 0).
 * The folded form reproduces exactly that. */
.sidebar-button {
    width: $ds-width-full;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-2;
    text-align: center;
}

/* Notes textarea states */
.notes-textarea-normal {
    height: $ds-size-10;
}

.notes-textarea-expanded {
    height: $ds-size-25;
    border: round $accent;
}
.sidebar Select { 
    width: $ds-width-full; 
    margin-bottom: $ds-space-1; 
    border: solid $primary-lighten-2;
    border-bottom: solid $primary-lighten-2;
}

.prompt-display-textarea {
    height: $ds-size-7; /* Example height */
    border: round $primary-lighten-2;
    background: $primary-background;
}

/* ADR-161 task 6: folded the winning declarations of the deleted
 * features/_conversations.tcss duplicate (margin, border color); the
 * computed styles are unchanged. */
.sidebar-listview {
    height: $ds-size-10; /* Example height for listviews in sidebars */
    margin-bottom: $ds-space-1;
    border: round $surface;
    background: $primary-background;
}

/* Enhanced sidebar sections with UX improvements */
.sidebar-section-collapsible {
    margin-bottom: $ds-space-1;
    border: round $surface-lighten-1;
    background: $surface;
}

.sidebar-section-collapsible:focus-within {
    border: round $ds-focus-accent;
    background: $ds-focus-bg;
}

/* Section loading state */
.section-loading {
    align: center middle;
    height: $ds-size-3;
}

.loading-fade {
    opacity: 50%;
}

/* Search mode indicator */
.sidebar.search-active {
    border: solid $warning;
}

/* ----------------------------------------
 * Enhanced Sidebar Components
 * ---------------------------------------- */

/* Tab content styling */
.tab-content {
    padding: $ds-space-1;
    height: $ds-height-full;
}

.setting-input {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    border: solid $primary-lighten-1;
    border-bottom: solid $primary-lighten-1;
}

/* Modified settings indicator */
.setting-modified {
    border: solid $accent !important;
    background: $accent 10% !important;
}

/* Temperature visual indicator */
.temperature-container {
    height: $ds-size-3;
    align: left middle;
}

.temperature-input {
    width: $ds-percent-70;
}

.temp-indicator {
    width: $ds-percent-30;
    text-align: center;
    padding-left: $ds-space-1;
}

/* System prompt styling */
.system-prompt-input {
    width: $ds-width-full;
    height: $ds-size-8;
    border: round $surface;
    margin-bottom: $ds-space-1;
    background: $background 5%;
}

/* New chat buttons */
.new-chat-buttons {
    height: $ds-size-3;
    margin: $ds-space-1 $ds-space-0;
    align: center middle;
}

.primary-button {
    width: $ds-percent-45;
    margin: $ds-space-0 $ds-space-1;
}

.secondary-button {
    width: $ds-percent-45;
    margin: $ds-space-0 $ds-space-1;
}

/* Info display fields */
.info-display {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    background: $surface 20%;
    color: $text-muted;
}

/* Checkbox styling */
.streaming-toggle, .advanced-toggle {
    margin: $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
}

/* TabbedContent customization */
TabbedContent {
    height: auto;
}

TabbedContent > TabPane {
    padding: $ds-space-0;
    height: auto;
}

TabbedContent Tabs {
    background: $surface 10%;
    height: $ds-size-3;
}

TabbedContent Tab {
    padding: $ds-space-0 $ds-space-1;
}

TabbedContent Tab.-active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Hide the tab underline indicator */
TabbedContent Underline {
    height: $ds-size-0;
    display: none;
}

/* Search results styling */
.search-results {
    padding: $ds-space-1;
}

.search-result-item {
    margin: $ds-space-1 $ds-space-0;
    padding: $ds-space-1;
    background: $surface 10%;
    border: round $surface-lighten-1;
}

.search-result-item:hover {
    background: $surface-lighten-1;
    color: $text;
    border: round $surface-lighten-2;
}

/* Highlight matched text in search */
.search-highlight {
    background: $warning 30%;
    text-style: bold;
}

/* Loading indicator for lazy tabs */
.tab-loading {
    align: center middle;
    height: $ds-size-10;
}

/* Reset button styling */
.reset-button {
    width: auto;
    min-width: $ds-size-3;
    height: $ds-size-2;
    padding: $ds-space-0 $ds-space-1;
    background: $warning 20%;
    border: tall $warning;
}

.reset-button:hover {
    background: $surface-lighten-1;
    color: $text;
}

/* Note: Textual doesn't support @media queries for responsive design
   These rules would need to be applied programmatically based on screen size */

/* --- End of Sidebar Styling --- */

/* ===== MODULE: layout/_destination.tcss ===== */
/* ========================================
 * LAYOUT: Destination workbench
 * ========================================
 * ADR-161 task 10: the destination-* workbench wrappers (308+ uses)
 * consolidated to one home: layout/_panes.tcss's rules (that sheet was
 * destination-only and is deleted; this sheet takes its manifest slot so
 * cascade order is unchanged) plus the two destination-only rules from
 * components/_agentic_terminal.tcss, tokenized on arrival. Scoped
 * .destination-section overrides stay with their surfaces (features/
 * _settings.tcss, features/_library*.tcss); the ds-destination-header
 * primitive lives in components/_ds_primitives.tcss.
 * ======================================== */

.destination-workbench {
    height: $ds-height-fill;
    min-height: $ds-size-0;
    width: $ds-width-full;
}

.destination-workbench-pane {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-height-full;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
}

.destination-pane-title {
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-style: bold;
    color: $ds-text-primary;
}

.destination-mode-strip,
.destination-filter-strip,
.destination-footer-row {
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}


.destination-action-button {
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}

.destination-pane-divider {
    width: $ds-size-1;
    min-width: $ds-size-1;
    height: $ds-height-full;
    min-height: $ds-size-0;
    background: $ds-grid-line;
}

/* ===== MODULE: layout/_containers.tcss ===== */
/* ========================================
 * LAYOUT: Containers
 * ======================================== 
 * Section containers, subsections, and content areas
 * ======================================== */

/* TabbedContent height fixes */
#config-tabs {
    height: 100%;
    width: 100%;
}

#config-tabs TabPane {
    height: 100%;
    width: 100%;
    padding: 1;
}

/* Container for the HorizontalScroll, this takes the original #tabs styling for docking */
#tabs-outer-container {
    dock: top;
    height: 3; /* Or your desired tab bar height */
    background: $background; /* Or your tab bar background */
    padding: 0 1; /* Padding for the overall bar */
    width: 100%;
    margin-top: 1; /* Add buffer space above the tab bar */
}

/* The HorizontalScroll itself, which will contain the buttons */
#tabs {
    width: 100%;
    height: 100%; /* Fill the outer container's height */
    overflow-x: auto !important; /* Ensure horizontal scrolling is enabled */
    /* overflow-y: hidden; /* Usually not needed for a single row of tabs */
}

#tabs Button {
    width: auto;         /* Let button width be determined by content + padding */
    min-width: 10;       /* Minimum width to prevent squishing too much */
    height: 100%;        /* Fill the height of the scrollable area */
    border: none; /* Your existing style */
    background: $panel;  /* Your existing style */
    color: $text-muted;  /* Your existing style */
    padding: 0 2;        /* Add horizontal padding to buttons */
    margin: 0 1 0 0;     /* Small right margin between buttons */
}

#tabs Button:last-of-type { /* No margin for the last button */
    margin-right: 0;
}

#tabs Button:hover {
    background: $panel-lighten-1; /* Your existing style */
    color: $text;                 /* Your existing style */
}

/* ===== MODULE: components/_ds_primitives.tcss ===== */
/* ========================================
 * COMPONENTS: DS Primitives (atomic layer)
 * ========================================
 * The token-native primitive containers that grew up inside the
 * agentic-terminal monolith and form the base layer other families
 * compose from: panels, toolbars, field rows, callouts, approval cards,
 * the destination header, and the six app-wide shell primitives task 10
 * added (inspector, status badge, recovery callout, source role, event
 * row, shortcut bar). Family reference:
 * backlog/docs/component-patterns.md (ADR-161).
 *
 * ADR-161 task 9: the first six classes were extracted from
 * components/_agentic_terminal.tcss, tokenized on arrival, and placed
 * FIRST among the component sheets as the atomic layer. Tie semantics of
 * that move (task-9 review correction): sheets between this entry and
 * the old monolith position could NOT override these rules at equal
 * specificity before the move and now can -- neutral in practice only
 * because single-definition governance keeps conflicting definitions
 * from existing, not because ordering is unchanged. The move is
 * bundle-internal only (two-track rule): no local $ds-* fallbacks live
 * here.
 *
 * Density variants: every .density-compact/.density-comfortable half
 * that touches a class in this sheet rides with it here (task 10 moved
 * the ds-inspector / ds-recovery-callout halves in with their classes).
 * ======================================== */

.ds-destination-header {
    height: auto;
    min-height: $ds-destination-header-min-height;
    padding: $ds-space-1 $ds-space-2;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: tall $ds-action-focus;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-style: $ds-text-strong;
}

.ds-panel {
    height: auto;
    min-height: $ds-panel-min-height;
    padding: $ds-space-1 $ds-space-2;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.ds-approval-card {
    height: auto;
    padding: $ds-space-1 $ds-space-2;
    border: thick $ds-status-approval-required;
    background: $ds-status-approval-required 12%;
    color: $ds-text-primary;
}

/* Field rows are label-above-value: every current user (Personas card and
   editors) composes them as Vertical containers, so the row must not force a
   horizontal layout (it jammed "Name"+value side by side and squeezed Inputs
   into the leftover width). */
.ds-field-row {
    height: auto;
    min-height: $ds-field-row-min-height;
    padding: $ds-space-0 $ds-space-1;
}

.ds-toolbar {
    height: auto;
    min-height: $ds-toolbar-min-height;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.ds-info-callout {
    border: round $ds-status-info;
    background: $ds-status-info 10%;
    padding: $ds-space-0 $ds-space-1;
    height: auto;
}

.density-compact .ds-panel,
.density-compact .ds-approval-card {
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.density-compact .ds-destination-header {
    min-height: $ds-destination-header-compact-min-height;
    padding: $ds-space-0 $ds-space-1;
}

.density-comfortable .ds-panel,
.density-comfortable .ds-approval-card {
    padding: $ds-space-1 $ds-space-2;
    margin: $ds-space-1 $ds-space-1;
}

.density-comfortable .ds-destination-header {
    min-height: $ds-destination-header-comfortable-min-height;
    padding: $ds-space-1 $ds-space-2;
}

/* ADR-161 task 10: the six app-wide shell primitives below
 * (.ds-inspector, .ds-status-badge, .ds-recovery-callout, .ds-source-role,
 * .ds-event-row, .ds-shortcut-bar) live in this sheet -- moved in
 * tokenized from components/_agentic_terminal.tcss because three of them
 * are composed across surfaces (MCP/Evals/Personas/ACP/Schedules/
 * Settings/Skills/Workbench audited 2026-09-14), which is the components
 * home. They are not registry classes until a catalog pass documents
 * them. */

.ds-inspector {
    height: auto;
    min-width: $ds-size-24;
    padding: $ds-space-1;
    border: round $ds-grid-line;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
}

.ds-status-badge {
    width: auto;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    text-style: bold;
    color: $ds-text-primary;
    background: $ds-surface-raised;
}

.ds-recovery-callout {
    height: auto;
    padding: $ds-space-1 $ds-space-2;
    border: round $ds-status-warning;
    background: $ds-status-warning 10%;
    color: $ds-text-primary;
}

.ds-source-role {
    width: auto;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: round $ds-source-role-context;
    color: $ds-text-primary;
    background: $ds-surface-raised;
}

.ds-event-row {
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border-bottom: solid $ds-grid-line;
    color: $ds-text-primary;
}

.ds-shortcut-bar {
    dock: bottom;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-inspector;
    color: $ds-text-muted;
}

.density-compact .ds-inspector,
.density-compact .ds-recovery-callout {
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.density-comfortable .ds-inspector,
.density-comfortable .ds-recovery-callout {
    padding: $ds-space-1 $ds-space-2;
    margin: $ds-space-1 $ds-space-1;
}

/* ===== MODULE: components/_buttons.tcss ===== */
/* ========================================
 * COMPONENTS: Buttons
 * ======================================== 
 * All button variants and states
 * ======================================== */

/* Base button style with enhanced UX */
Button {
    /* No border by default - rely on background color for visual appearance */
    border: none;
}

/* Shared hover state with readable, non-obscuring cues */
Button:hover {
    background: $ds-hover-bg;
    color: $ds-hover-fg;
    text-style: $ds-text-strong;
}

/* Enhanced focus state with visible, non-obscuring cues */
Button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

/* When both hovering AND focused */
Button:hover:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

/* Disabled state.
   TASK-25822: the darkened surface plus muted-but-readable text IS the cue --
   an additional `opacity: 50%` composited the label down to 1.34:1 and made
   the control look absent. Two non-colour cues remain (surface + weight). */
Button:disabled,
Button.-style-default:disabled,
Button.-style-flat:disabled {
    opacity: 100%;
    text-opacity: 100%;
    text-style: none;
    background: $ds-disabled-bg;
    color: $ds-text-disabled-readable;
}

Button:disabled:hover {
    background: $ds-disabled-bg;
    text-style: none;
}

.sidebar-toggle {
    width: 1fr;              /* Equal flexible width */
    height: $ds-control-height;
    /* margin-right: 1; Removed default margin, apply specific below */
    border: none;
    /* Enabled but recessed chrome: sunken resting surface, not the
       disabled token (PR #2632 review follow-up). */
    background: $ds-surface-sunken;
    color: $ds-text-primary;
}
.sidebar-toggle:hover { background: $ds-surface-raised; }

.action-button {
    margin-right: $ds-space-inline;
    min-width: 12;
}

.action-button.primary {
    background: $primary;
    color: $text;
}

.action-button.primary.large {
    min-width: 20;
    height: 3;
    text-style: $ds-text-strong;
}

.button-group {
    width: 100%;
    height: auto;
    margin: $ds-space-section $ds-space-0;
}

.button-group-left {
    align: left top;
}

.button-group-center {
    align: center top;
}

.button-group-right {
    align: right top;
}

/* ===== MODULE: components/_forms.tcss ===== */
/* ========================================
 * COMPONENTS: Forms
 * ======================================== 
 * Form elements: inputs, textareas, selects
 * ======================================== */

/* ADR-161 task 6: the winning declarations of the former
 * features/_tools-settings.tcss bare duplicates were folded here
 * (tokenized on arrival) so this owning sheet carries the single
 * definition with unchanged computed styles. */
.form-label {
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-0;
    text-style: $ds-text-strong;
    color: $text-muted;
}

.form-section-title {
    text-style: $ds-text-strong;
    color: $primary;
    margin: $ds-space-section $ds-space-0 $ds-space-stack $ds-space-0;
    border-bottom: solid $primary;
    padding-bottom: $ds-space-0;
}

.form-description {
    color: $ds-text-muted;
    margin-bottom: $ds-space-section;
    text-style: $ds-text-emphasis;
}

.form-actions {
    margin-top: $ds-space-section;
    layout: horizontal;
    height: $ds-control-height;
    width: 100%;
    align: center middle;
}

.form-actions Button {
    margin: 0 $ds-space-inline 0 0;
}

.provider-models-textarea {
    height: $ds-textarea-min-height;
    margin-bottom: $ds-space-stack;
}

/* Standardized form components */
.form-textarea {
    width: 100%;
    height: auto;
    min-height: $ds-textarea-min-height;
    margin-bottom: $ds-space-stack;
}


.form-checkbox {
    margin: $ds-space-stack 0;
}

/* Form layout helpers */
.form-row {
    width: 100%;
    height: auto;
    margin-bottom: $ds-space-stack;
}

.form-col {
    width: 1fr;
    padding: 0 $ds-space-inline;
}

.form-col:first-child {
    padding-left: 0;
}

.form-col:last-child {
    padding-right: 0;
}

/* Form sections */
.form-section-collapsible {
    margin: $ds-space-stack 0;
}

.form-button {
    margin: 0 $ds-space-inline;
}

/* ADR-161 task 8a: .status-label/.status-area moved to their family's
 * owning sheet components/_status.tcss (byte-identical winners). */

/* Title/Author input fields fix */
.title-author-row Input {
    height: $ds-control-height;
    width: 100%;
    margin-bottom: $ds-space-stack;
}

Input:focus,
TextArea:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

/* TASK-17961. Third member of the `*:focus { outline: solid ... }`
 * (core/_reset.tcss) family that TASK-1160 (`DataTable:focus`,
 * components/_lists.tcss) and TASK-2300 (`Select.-textual-compact:focus`,
 * also components/_lists.tcss) already fixed: the outline paints OVER a
 * widget's outermost rendered lines, and Textual pins `border: none
 * !important` on `Input.-textual-compact` (textual/widgets/_input.py), so a
 * compact Input is exactly ONE row tall and that row IS its value -- the
 * outline overwrites it outright, turning a focused compact Input into an
 * empty bordered box.
 *
 * The rule above (`Input:focus, TextArea:focus`) also reaches compact
 * inputs, and its `border: solid ...` is app CSS -- app CSS always outranks
 * a widget's own DEFAULT_CSS in Textual's cascade regardless of
 * `!important` (`Styles.extract_rules`'s `default_rules` tier), so it
 * re-adds a real border Textual's compact contract had removed. Left in
 * place, that border alone (no outline needed) would still eat the
 * compact input's one content row, so `border: none` is restated here too,
 * not just `outline: none`. `background: $ds-focus-bg` is the
 * non-obscuring replacement cue -- a colour, not geometry, so it costs
 * nothing on a 1-row control. */
Input.-textual-compact:focus {
    border: none;
    outline: none;
    background: $ds-focus-bg;
}

/* TASK-14879: File Notes fields already use the stable border treatment
 * above. Remove the global perimeter outline so it cannot repaint the first
 * or last editor/search cells over meaningful content. */
LibraryFileNotesWorkspace Input:focus,
LibraryFileNotesWorkspace TextArea:focus {
    outline: none;
}

/* Long-form Notes bodies keep their resting fill while typing. The heavy
 * semantic perimeter is the focus cue; it costs no rows or columns and leaves
 * compact fields and every unrelated TextArea on the shared focused fill. */
#library-note-body:focus,
#file-notes-editor:focus {
    outline: heavy $ds-action-focus;
    background: $ds-surface-raised;
}

/* Some decorative themes intentionally place `$primary` close to `$panel`
 * (pastel_dreams measures 1.03:1). Keep the semantic outline, and make the
 * existing TextArea border the contrast-safe second boundary without adding
 * geometry. Textual's mode class is the reliable cross-theme lightness seam. */
.-dark-mode #library-note-body:focus,
.-dark-mode #file-notes-editor:focus {
    border: solid white;
}

.-light-mode #library-note-body:focus,
.-light-mode #file-notes-editor:focus {
    border: solid black;
}

/* TASK-2300. `Select:focus` used to be in the rule above, and it is the one
 * member of that list that does not draw its own border.
 *
 * `Input` and `TextArea` each carry `border: tall $border-blurred` on
 * themselves, so the declaration above REPLACES a border that already exists
 * and costs nothing. A `Select` draws its border on its child
 * `SelectCurrent` (`Select` DEFAULT_CSS: `&:focus > SelectCurrent { border:
 * tall $border; }`) and has none of its own -- so the same declaration ADDED
 * a second one, two rows of chrome, around a widget whose three rows were
 * already spoken for. Measured live at 235x52, the New Rule form's condition
 * Select with focus on it:
 *
 *     ┌──────────────────────┐
 *     │▊▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▎│     <- SelectCurrent's own top border
 *     └──────────────────────┘
 *
 * Three rows of frame and no value. Clicking the control to open it is what
 * focuses it, so this is the state of every Select the moment a user reaches
 * for one -- the same "a bare border where a control should be" the 2026-08-04
 * UAT reported for the Items filter, on a different Select for a different
 * reason.
 *
 * Only the recolouring half is kept, on the `Select` itself where it always
 * was. The border half is not re-homed onto `SelectCurrent` -- Textual's own
 * `&:focus > SelectCurrent { border: tall $border; }` already recolours
 * exactly that border on focus, at exactly the geometry it is already sized
 * for, so re-stating it here in app colours would buy a shade and cost a
 * fight: the re-homed rule (`Select:focus > SelectCurrent`, specificity
 * (0,1,2)) also outranked `.settings-compact-select > SelectCurrent`'s
 * deliberate `border: none` (0,1,1), putting the frame back INSIDE a control
 * that draws its own frame outside. Review wave, Critical 1: this family of
 * rules keeps losing to the fact that "a Select" is three different shapes,
 * so the app now styles only what every shape has -- its colours.
 *
 * ROUND 2, O1 -- and how far even that reaches is worth stating, because the
 * previous wording claimed more than it delivered ("the recolouring half is
 * what marks focus now"). It is NOT, on its own. `SelectCurrent` is a child
 * with an opaque `background: $surface` covering the whole parent, so on a
 * borderless compact `Select` this declaration is painted over completely and
 * only Textual's 5% `background-tint` survives (~1.10:1, measured). What
 * actually marks focus is per shape:
 *
 *   three-row `Select`    Textual's own `&:focus > SelectCurrent { border:
 *                         tall $border; }` -- a real, visible border swap
 *   `.settings-compact-*` its own `:focus` rules, border AND background
 *   borderless compact    `Select.-textual-compact:focus > SelectCurrent`
 *                         in components/_lists.tcss, added by O1
 *
 * This rule is kept because it is the one that reaches a `Select` whose child
 * does NOT cover it (padding, a themed variant), and because removing a
 * pre-existing app-wide declaration on the strength of one shape's geometry
 * is how this family of bugs started.
 */
Select:focus {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

/* TASK-17961. `ToggleButton` (the base class behind `Checkbox`/
 * `RadioButton` -- Textual type selectors match subclasses, same reasoning
 * TASK-1160 used for `DataTable:focus`) half of the same
 * `*:focus{outline:solid...}` family fixed by TASK-1160 (`DataTable:focus`,
 * components/_lists.tcss) and TASK-2300 (`Select.-textual-compact:focus`,
 * also components/_lists.tcss). Measured on the real regression --
 * `workspace_create_modal.py`'s "Switch to this workspace" Checkbox
 * (`compact=True`): blurred it renders `▐X▌ Switch to this workspace`
 * fine; focused, before this fix, it collapsed to an empty bordered box.
 *
 * `outline: none` on the bare selector is necessary but not sufficient for
 * the compact case: this app's own `border: solid $ds-focus-accent` above
 * ALSO re-adds a real border on focus (compact toggles are borderless only
 * via Textual's `border: none !important` on `.-textual-compact`, which
 * cannot outrank this app's CSS -- app CSS always wins over a widget's own
 * DEFAULT_CSS in Textual's cascade regardless of `!important`, same
 * mechanism as the compact-Input fix above). Textual's own DEFAULT_CSS is
 * a second, independent source: `ToggleButton`'s
 * `&.-textual-compact { &:focus { border: tall $border; } }` reinstates a
 * border on compact-focus even with no app CSS in play, so the restated
 * `border: none` below neutralizes both. Either border alone, combined
 * with this app's unscoped `Checkbox { height: 2; }` (features/
 * _conversations.tcss), leaves zero rows for content -- so the compact
 * variant restates `border: none` too. Focus stays visible either way via
 * the existing `.toggle--label` recolour contract below (pinned by
 * Tests/UI/test_non_obscuring_focus_contract.py) -- untouched by this
 * fix. */
ToggleButton:focus {
    outline: none;
    border: solid $ds-focus-accent;
    background: $ds-surface-raised;
}

ToggleButton.-textual-compact:focus {
    outline: none;
    border: none;
    background: $ds-surface-raised;
}

ToggleButton:focus > .toggle--label,
ToggleButton.-textual-compact:focus > .toggle--label,
ToggleButton:blur:hover > .toggle--label {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

Switch:focus {
    border: solid $ds-focus-accent;
    background: $ds-focus-bg;
}

/* New base media ingestion form styling */
.form-input {
    height: $ds-control-height;
    width: 100%;
    margin-bottom: $ds-space-stack;
    border: solid $primary;
    padding: 0 $ds-space-inline;
}

.form-input:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

.form-input.error {
    border: solid $error;
    background: $error 10%;
}

.form-select {
    height: $ds-control-height;
    width: 100%;
    margin-bottom: $ds-space-stack;
}

.form-checkbox {
    margin: $ds-space-stack 0;
}

/* Responsive metadata columns */
.metadata-row {
    layout: horizontal;
    width: 100%;
    height: auto;
    margin-bottom: $ds-space-stack;
}

.metadata-col {
    width: 1fr;
    height: auto;
}

/* Mode toggle section - CRITICAL for visibility */
.mode-toggle-container {
    width: 100%;
    height: auto;
    margin-bottom: $ds-space-stack;
    padding: $ds-space-inset;
}

.mode-title {
    text-style: $ds-text-strong;
    color: $primary;
    margin-bottom: $ds-space-stack;
}

.mode-toggle {
    width: 100%;
    height: auto;
    margin-bottom: $ds-space-stack;
}

/* Essential container sections - CRITICAL for Input widget visibility */
.essential-section {
    width: 100%;
    height: auto;        /* Allow container to size to content */
    margin-bottom: $ds-space-section;
    padding: $ds-space-inset;
}

.media-options-section {
    width: 100%;
    height: auto;
    margin-bottom: $ds-space-section;
}

.options-section {
    width: 100%;
    height: auto;
    margin-bottom: $ds-space-section;
    padding: $ds-space-inset;
}

.process-button-section {
    width: 100%;
    height: auto;
    margin-top: $ds-space-section;
    padding: $ds-space-inset;
    align: center middle;
}

/* Time range inputs layout */
.time-range-row {
    width: 100%;
    height: auto;
    margin-bottom: $ds-space-stack;
}

.time-col {
    width: 1fr;
    height: auto;
    padding: 0 $ds-space-inline;
}

.time-col:first-child {
    padding-left: 0;
}

.time-col:last-child {
    padding-right: 0;
}

/* Advanced mode visibility controls */
.advanced-only {
    display: block;
}

.simple-mode .advanced-only {
    display: none;
}

.advanced-mode .advanced-only {
    display: block;
}

/* Form textarea styling */
.form-textarea {
    width: 100%;
    min-height: $ds-textarea-min-height;
    max-height: 10;
    margin-bottom: $ds-space-stack;
    border: solid $primary;
    padding: $ds-space-inset;
}

.form-textarea:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

/* ADR-161 task 9: the Settings compact field vocabulary's cross-surface
 * members, moved tokenized from components/_agentic_terminal.tcss.
 * Probe evidence (task 9, production cascade): genuinely different from
 * the standard form classes -- documented variants, not merge candidates:
 *   settings-detail-row -- the read-only detail line (panel fill, primary
 *       text, one-row minimum) vs form-row's auto-height unstyled row.
 *       Consumed on TWO production surfaces (the Settings workbench and
 *       the STTS speech settings pane via SpeechSettingsPane), so it rides
 *       the boot bundle instead of the lazily-loaded settings screen
 *       sheet (same rationale as AGENTIC_SPLIT_PINNED_TOKENS).
 *   settings-compact-input -- the one-row editable field with the task-1586
 *       left-edge control convention (TASK-13154.1: the border suppression
 *       is what lets the single row paint its text; form-input's full
 *       border would spend the row on chrome). Also composed by the
 *       pattern gallery, so it too rides the boot bundle.
 * The Settings-screen-only siblings (settings-input-row,
 * settings-select-row, settings-status-row, settings-compact-select,
 * settings-focus-card) stay in the monolith for the task-10 feature carve,
 * as do the scoped overrides (#settings-impact-pane .settings-detail-row,
 * #settings-web-search-panel .settings-compact-input, ...) that belong to
 * their surfaces. */
.settings-detail-row {
    width: $ds-width-full;
    min-height: $ds-control-height-compact;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.settings-compact-input {
    width: $ds-width-fill;
    height: $ds-control-height-compact;
    min-height: $ds-control-height-compact;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    /* task-1586 control convention: the one-column left edge marks "this
       row is editable" at rest; full borders stay off because they cost
       a row above and below on these one-row fields. */
    border: none;
    border-left: solid $ds-control-edge;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
}

.settings-compact-input:focus {
    border: none;
    border-left: thick $ds-action-focus;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    /* No underline: it made placeholder copy read as a link (task-185). */
    text-style: $ds-text-strong;
    outline: none;
}

.settings-compact-input.settings-invalid-input {
    background: $ds-status-error 18%;
    color: $ds-text-primary;
    text-style: $ds-text-strong;
    outline: none;
}

.settings-compact-input.settings-invalid-input:focus {
    /* task-1369: keep the error tint while focused so the invalid marker is
       not lost; slightly stronger than the unfocused 18% to still read as
       focused. */
    background: $ds-status-error 28%;
    color: $ds-text-primary;
    text-opacity: 1;
    text-style: $ds-text-strong;
    outline: none;
}

/* Note: Textual doesn't support @media queries
   Responsive behavior must be handled programmatically
   in the Python code using terminal size detection */

/* ===== MODULE: components/_sections.tcss ===== */
/* COMPONENTS: Sections — canonical .section-title/.section-header/
 * .subsection-title, usage-weight winners tokenized on arrival
 * (ADR-161 task 4). */

.section-title {
    text-style: $ds-text-strong;
    color: $primary;
    text-align: center;
    height: auto;
    margin-bottom: $ds-space-section;
}

.section-header {
    text-style: $ds-text-strong;
    color: $primary;
    padding: $ds-space-1 $ds-space-0;
}

.subsection-title {
    text-style: $ds-text-strong;
    color: $secondary;
    /* 4 values: Textual rejects 3 */
    margin: $ds-space-section $ds-space-0 $ds-space-stack $ds-space-0;
}

/* ===== MODULE: components/_lists.tcss ===== */
/* ========================================
 * COMPONENTS: Lists
 * ======================================== 
 * ListViews, list items, and list patterns
 * ======================================== */

ListView ListItem {
    padding: 0 1;
    height: auto;
}

ListView ListItem:hover {
    background: $surface-lighten-1;
    color: $text;
}

ListView ListItem.-highlight {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

DataTable > .datatable--cursor {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

DataTable > .datatable--hover {
    background: $surface-lighten-1;
    color: $text;
}

DataTable > .datatable--selected {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

/* TASK-1160. The app-wide keyboard-focus fallback in core/_reset.tcss
 *
 *     *:focus { outline: solid $ds-focus-accent; }
 *
 * makes the bottom row of EVERY focused `DataTable` unclickable.
 *
 * Textual paints an `outline` OVER the widget's outermost rendered lines
 * rather than around them -- that is exactly what distinguishes it from
 * `border`, which costs geometry. The overwritten segments lose the
 * `{"row", "column"}` Rich style metadata, and `DataTable._on_click`
 * resolves the clicked cell from nothing else:
 *
 *     meta = event.style.meta
 *     if "row" not in meta or "column" not in meta:
 *         return
 *
 * so the click is silently dropped. Measured in a bare Textual app (no
 * tldw CSS at all, the outline rule the only variable), 6-row table,
 * region height 7:
 *
 *     no outline            outline
 *     click y=5 -> row 4    click y=5 -> row 4
 *     click y=6 -> row 5    click y=6 -> row 0   <- last row dead
 *
 * The whole perimeter is affected, not just the last row: column x=0 is
 * dead on every row, and the top line -- a `DataTable`'s column header --
 * is overwritten outright (that was TASK-1034's "focused results grid
 * loses its header").
 *
 * It reads as intermittent rather than broken because `MouseDown` focuses
 * the table before the `Click` is resolved, so the FIRST click on a
 * blurred table still lands. The second click onto the bottom row is the
 * one that does nothing.
 *
 * Fixed once here rather than per table: a bare type selector so none of
 * the ~40 `DataTable` call sites has to opt in. `DataTable:focus` is
 * (0,1,1) against the reset's (0,1,0), so it wins wherever it applies, and
 * Textual type selectors match subclasses too.
 *
 * Focus stays visible -- the reset's "non-obscuring keyboard focus"
 * contract is kept, not dropped -- via two cues that recolour cells the
 * table already draws and therefore never overwrite a segment or its meta:
 * the cursor cell and the column header both take the sanctioned readable
 * `$ds-focus-bg`/`$ds-focus-fg` pair. Two cues, because the cursor can be
 * turned off (`cursor_type="none"`) or scrolled out of view, while the
 * header is always on screen. Textual's own `DataTable:focus {
 * background-tint: $foreground 5%; }` survives on top of both.
 *
 * This supersedes the two screen-local workarounds that preceded it:
 * TASK-1105's `.watchlists-region DataTable:focus` and TASK-1034's
 * `#evals-grid-table:focus`, both now removed from their feature modules.
 */
DataTable:focus {
    outline: none;
}

DataTable:focus > .datatable--cursor {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

DataTable:focus > .datatable--header {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

OptionList > .option-list--option-highlighted,
OptionList:focus > .option-list--option-highlighted,
SelectionList > .selection-list--button-highlighted,
SelectionList > .selection-list--button-selected,
SelectionList > .selection-list--button-selected-highlighted,
Tree > .tree--cursor,
Tree:focus > .tree--cursor {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

/* TASK-14879: File Notes Trees render entries on their perimeter cells, so
 * the app-wide outline obscures the first/last visible rows. The focused
 * cursor supplies the content-safe workbench cue instead. */
LibraryFileNotesWorkspace Tree:focus {
    outline: none;
}

LibraryFileNotesWorkspace Tree:focus > .tree--cursor {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* TASK-368: the discovered-model SelectionList checkbox glyph (▐X▌) must clearly
   distinguish selected from unselected. The shared native-choice contract above
   paints the toggle classes the same ($surface/$text), erasing the
   checked/unchecked distinction and rendering the ▐▌ caps fg==bg (invisible).
   Scope a distinct toggle to THIS list only (id specificity). The CHECKED states
   are a sanctioned high-contrast override (the $ds-focus contract); the base
   unchecked glyph renders as an empty box (no inner X). `-button-highlighted`
   (an unchecked row under the cursor) is left to the shared contract above. */
#settings-discovered-models-list .selection-list--button {
    color: $ds-grid-line;
    background: $ds-grid-line;
}
#settings-discovered-models-list .selection-list--button-selected,
#settings-discovered-models-list .selection-list--button-selected-highlighted {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* TASK-430 AC#1: the file picker's list must show a clearly-visible selected
   row. The generic OptionList rule above paints $surface (≈ dialog
   background), which is near-invisible; scope a higher-contrast focus token
   to the picker list only, using the sanctioned non-obscuring focus color
   (TASK-345). */
#file-list-pane .option-list--option-highlighted {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

OptionList > .option-list--option-hover,
Tree > .tree--highlight-line {
    background: $surface-lighten-1;
    color: $text;
}

/* TASK-2300. The same app-wide focus fallback TASK-1160 opted `DataTable`
 * out of, biting a second widget -- this time destroying content outright.
 *
 *     *:focus { outline: solid $ds-focus-accent; }      core/_reset.tcss
 *
 * An expanded `Select` moves focus to its own `SelectOverlay`
 * (`Select._watch_expanded` -> `overlay.focus(...)`), so the overlay is
 * ALWAYS the focused widget for the whole time it is on screen. Textual
 * paints an `outline` OVER a widget's outermost rendered lines rather than
 * around them, and it costs no geometry -- so those lines have to be
 * expendable for the rule to be harmless.
 *
 * On a COMPACT `Select` they are not. `Select.compose` data-binds `compact`
 * onto the overlay, and `OptionList.-textual-compact` sets
 * `border: none !important; padding: 0`, so the overlay's box model reserves
 * no perimeter at all: every cell of it is an option cell. The outline
 * therefore overwrites the FIRST and LAST option rows outright and the first
 * and last character of every row in between. Measured at 235x52 against the
 * production stylesheet, `#items-status-select` (6 statuses, region 16x6):
 *
 *     with the outline            without
 *     ┌──────────────┐            All statuses
 *     │ew            │            New
 *     │ead           │            Read
 *     │ngested       │            Ingested
 *     │gnored        │            Ignored
 *     └──────────────┘            Error
 *
 * Two of six options gone, four mangled -- and for any compact Select with
 * two options or fewer, the overlay renders as a bare box with nothing in
 * it, which is exactly what the 2026-08-04 Watchlists UAT reported (F30).
 *
 * Fixed here rather than per screen, for the same reason TASK-1160 was: a
 * bare type selector so no `Select` call site has to opt in, and Textual
 * type selectors match subclasses (`PruneSafeSelect`'s overlay is a plain
 * `SelectOverlay`, but the rule would follow a subclass too).
 *
 * Focus stays visible without the reset's cue: the overlay is only ever on
 * screen while it holds focus, so an "is this focused" ring conveys nothing
 * there, while the highlighted-option recolour (Textual's own
 * `.option-list--option-highlighted`, plus the sanctioned pair above)
 * already says which option is current. Same trade TASK-1160 made for the
 * table cursor -- recolour content the widget already draws, never overwrite
 * cells it needs.
 */
SelectOverlay:focus {
    outline: none;
}

/* TASK-2300, second instance -- found in live verification, after the
 * overlay above was already fixed and the suite was green. The control
 * itself, not its popup.
 *
 * A `Select` that is compact AND has not been given a frame of its own is ONE
 * row tall (`Select.-textual-compact > SelectCurrent { border: none
 * !important }` in Textual's own CSS, and this app's filter strips pin
 * `height: 1` on top of that). So its single rendered line IS its value, and
 * `*:focus { outline: solid ... }` (core/_reset.tcss) -- which paints OVER a
 * widget's outermost rendered lines at no geometric cost -- lands on it.
 * Measured at 235x52 against the production stylesheet,
 * `#items-status-select`:
 *
 *     blurred   'All statuses  ▼    '
 *     focused   '┌──────────────┐   '
 *
 * The control the user just clicked stops saying what it is set to. Same
 * substitution as the overlay above and as TASK-1160's table cursor: drop the
 * cue that overwrites content, keep the ones that recolour it
 * (`Select:focus`'s background/colour half in components/_forms.tcss).
 *
 * REVIEW WAVE, Critical 1 -- what this rule must NOT do. It first shipped as
 *
 *     Select.-textual-compact:focus,
 *     Select.-textual-compact:hover { border: none; outline: none; }
 *
 * and "compact" turned out to be the wrong predicate for "has no perimeter".
 * `.settings-compact-select` (components/_agentic_terminal.tcss) is compact
 * too, and gives its Selects `height: 3` with a `border` of their OWN, sized
 * around -- so ~21 Settings/Speech/ImageGen/Splash controls lost their frame
 * on focus, and hovering one strobed it on and off every frame: the pointer
 * on the border row made the `Select` the hover target, the border went, the
 * child slid under the pointer, the `Select` un-hovered, the border came
 * back. Measured on `#settings-provider-value`:
 *
 *     rest     ┌────────────────────────┐
 *              │ Manual / custom provider ▼ │
 *              └────────────────────────┘
 *     focused   Manual / custom provider ▼      <- frame gone, two blank rows
 *
 * The `border` declarations are gone rather than re-scoped: with the two
 * rules that used to put a border on a `Select` now moved onto the child that
 * reserves room for one (components/_forms.tcss, features/_embeddings.tcss),
 * nothing gives a borderless compact `Select` a border any more, so they were
 * dead weight whose only remaining effect was to strip a border from Selects
 * that had asked for one. The `:hover` half goes with them -- `*:focus` is
 * focus-only, so hover never needed an exemption at all, and a hover rule that
 * changes geometry is precisely what made the flicker self-sustaining.
 *
 * What is left is `outline`, on `:focus`, which is the one cue that genuinely
 * costs no geometry and therefore genuinely cannot be reserved for.
 * `.settings-compact-select:focus` sets `outline: none` itself, so this
 * agrees with it rather than overriding it.
 *
 * ROUND 2, O1 -- and taking the outline away left nothing behind. The
 * replacement cue was supposed to be `Select:focus`'s recolour
 * (components/_forms.tcss), but that paints the SELECT, and `SelectCurrent`
 * covers the whole of it with an opaque `background: $surface` of its own, so
 * the recolour never reached the screen. All that did was Textual's 5%
 * `background-tint`. Measured on `#items-status-select` and
 * `#watchlists-backend-select`:
 *
 *     rest #1e1e1e   focused #272727    ~1.10:1
 *
 * `core/_variables.tcss` (TASK-345) names 1.1:1 as *exactly* the failure that
 * killed the non-obscuring focus contract once already -- an invisible focus
 * ring is how a Tab+Enter activated the wrong control. And with the hover cue
 * fixed in the same wave, hover (#2d2d2d) had become STRONGER than focus,
 * which is backwards.
 *
 * So the recolour is re-homed one level in, onto the child that actually
 * paints. Unlike Critical 1's rule this is a COLOUR, not geometry: it cannot
 * resize anything, and its specificity ((0,2,2), which does outrank
 * `.settings-compact-select:focus > SelectCurrent`'s (0,2,1)) is harmless
 * because that rule sets `$ds-input-focus-bg` too -- the same token, so the
 * bordered controls are byte-identical either way. Verified by measurement,
 * not by reading: `#settings-provider-value` focuses to #586d82 before and
 * after.
 */
Select.-textual-compact:focus {
    outline: none;
}

Select.-textual-compact:focus > SelectCurrent {
    background: $ds-input-focus-bg;
}

/* ===== MODULE: components/_navigation.tcss ===== */
/* ========================================
 * COMPONENTS: Navigation
 * ========================================
 * Navigation patterns and menus
 * ======================================== */

/* task-3200 review round 1 (main_navigation.py, MainNavigationBar.DEFAULT_CSS):
   a destination button whose render straddles the nav strip's scroll viewport
   edge gets `.nav-button-clip-ghost` + `disabled = True` so it reads as empty
   space instead of a mid-word-cut label -- but the generic `Button:disabled`
   rule in components/_buttons.tcss (an earlier module in this same bundle,
   see build_css.py's CSS_MODULES order) sets `opacity: 50%` for EVERY
   disabled button app-wide, and this bundle (loaded via `App.CSS_PATH`) takes
   priority over widget `DEFAULT_CSS` regardless of `!important` there
   (confirmed live: the ghosted "Watchlists" fragment still rendered as a
   visibly distinct `rgb(62,62,62)` on `rgb(16,16,16)`, not pixel-exact, with
   `!important` only in `MainNavigationBar.DEFAULT_CSS` -- the widget-level
   override alone cannot win against this tier). Overriding it HERE, in the
   same tier, lets ordinary specificity settle it: this two-class-plus-
   pseudo-class selector outranks `Button:disabled`'s single
   class-plus-pseudo-class one -- no `!important` needed on this side. */
.nav-button.nav-button-clip-ghost:disabled {
    opacity: 100%;
    background: $background;
    color: $background;
}

/* ADR-161 task 8b: the `NavigationButton.active` / `:focus` /
   `.active:focus` rules that used to sit here were deleted as dead (fix
   round 1: the deletion is safe, and this comment now states the REAL
   mechanism -- the original "the scoped bar rules outrank the type
   selector" rationale was experimentally disproved and is wrong in
   direction). They had been moved here (TASK-16811) from the DEFAULT_CSS
   of the base_components NavigationButton deleted with
   Widgets/base_components.py in ADR-161 task 2. The surviving
   UI/Navigation/main_navigation.py NavigationButton shares the CSS type
   name, and the rules were dead against it for two independent reasons:

   1. It NEVER receives an `active` class (only `is-active`), so
      `NavigationButton.active` / `.active:focus` matched nothing live.
   2. Value-identity for `NavigationButton:focus`: its declarations are
      identical to the app-tier `Button:focus` / `Button:hover:focus`
      rules in components/_buttons.tcss (background: $ds-focus-bg;
      color: $ds-focus-fg; text-style: bold underline; outline: none),
      and every NavigationButton is a Button -- deleting a same-value
      duplicate cannot change computed styles.

   WARNING (why nobody should "restore" these rules on an out-ranking
   belief): tier beats specificity in Textual -- this bundle (App.CSS_PATH)
   outranks widget-default-tier sources regardless of specificity or
   `!important`, exactly as the task-3200 comment above and
   main_navigation.py's own tier note document. The bar's scoped
   `.nav-button:focus` rules are lifted BUNDLED_CSS, i.e. widget-defaults
   tier, so they could NEVER neutralize an app-tier type selector; an
   app-tier `NavigationButton:focus` rule here would win every shared
   property against them (verified: re-inserting the deleted rule's shape
   with a red background at this tier paints red). Probe evidence for the
   deletion itself: focused plain and is-active+focused buttons on the
   real mounted bar computed byte-identical before and after. */

/* ===== MODULE: components/_change_review.tcss ===== */
/* Agent Change Review screen (TASK-1973). A pushed overlay: header with the
   turn selector, honesty banner, changed-file tree beside a windowed diff
   pane. Heights are explicit everywhere a Horizontal/Vertical appears --
   the fr-inside-flex default has bitten this codebase repeatedly (approval
   card TASK-1846, MCP lockstep rules). */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */

#change-review-screen {
    height: $ds-height-fill;
    width: $ds-width-fill;
}
#change-review-header {
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}
#change-review-title {
    width: auto;
    padding-right: $ds-space-2;
    text-style: bold;
}
#change-review-turn-select {
    width: $ds-size-44;
}
#change-review-totals {
    width: $ds-width-fill;
    content-align: right middle;
}
/* TASK-18060 Task 7 (review-rail spec §3): the whole-file comment
   affordance named alongside footer key `C` — a small button near the
   totals. */
.change-review-comment-file-btn {
    width: auto;
    min-width: $ds-size-8;
    margin-left: $ds-space-1;
}
/* TASK-16801 arc B (spec §5): the commit affordance, beside the comment
   button. Hidden outside `current` mode by the screen itself (its `display`
   starts False in `compose`), so no rule here needs to hide it. */
.change-review-git-commit-btn {
    width: auto;
    min-width: $ds-size-8;
    margin-left: $ds-space-1;
}
/* TASK-16801 arc B (spec §6): push and the PR compare link, beside commit.
   Same hidden-by-default treatment — `compose()` starts both with
   `display = False` and `_refresh_mode_affordances` owns them from there. */
.change-review-git-push-btn,
.change-review-git-pr-btn {
    width: auto;
    min-width: $ds-size-8;
    margin-left: $ds-space-1;
}
.change-review-banner {
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-status-warning;
}
#change-review-body {
    height: $ds-height-fill;
}
#change-review-tree {
    width: $ds-size-46;
    height: $ds-height-fill;
}
/* TASK-18060 Task 7: hosts the diff pane plus the sibling inline comment
   `Input` and notes strip — see `change_review_screen.py`'s `compose()`
   for why they must be siblings of `#change-review-diff`, never its
   descendants (the pane's own key-reclaim `on_key` must not see keys
   meant for the comment input). */
#change-review-right {
    width: $ds-width-fill;
    height: $ds-height-fill;
}
#change-review-diff {
    width: $ds-width-fill;
    height: $ds-height-fill;
    padding: $ds-space-0 $ds-space-1;
    /* TASK-18060 Task 6 follow-up: the diff `Text` renders with
       `no_wrap=True` (conventional diff-viewer behavior, and the only way
       to make the line cursor's rendered row == its logical line index --
       see `_render_diff`/`_scroll_cursor_into_view`) -- a long line must
       therefore scroll horizontally rather than clip. `scrollbar-size`
       mirrors the sibling diff viewport's own convention
       (`ConsoleTurnFileCard`'s `.console-turn-file-diff`, and this
       codebase's other scrollable diff/log panes) so the new horizontal
       scrollbar stays thin. */
    overflow-x: auto;
    scrollbar-size: 1 1;
}
.change-review-diff-body {
    /* TASK-18060 Task 6 follow-up: `width: auto` (not `1fr`) is load-
       bearing, not cosmetic -- a `1fr` width caps this Static's measured
       width at the PANE's viewport width, so Textual's `Content` layer
       still folds/wraps a long line at that width regardless of the
       `text-wrap` rule below (confirmed empirically: `no_wrap`/`text-wrap:
       nowrap` alone, with `width: 1fr`, still produced extra wrapped rows).
       `auto` lets the Static size to its OWN longest line, so nothing
       needs to fold -- `#change-review-diff`'s `overflow-x: auto` then
       scrolls that width horizontally instead of clipping or wrapping it.
       `text-wrap: nowrap` is kept explicit (belt-and-braces with the
       Python-side `Text(no_wrap=True)` in `_render_diff`) so intent is
       readable at both layers even though `width: auto` alone already
       removes the squeeze that would trigger a wrap. */
    width: auto;
    height: auto;
    text-wrap: nowrap;
}
#change-review-footer {
    height: $ds-size-1;
    color: $ds-text-muted;
    padding: $ds-space-0 $ds-space-1;
}

/* TASK-18060 Task 7 (review-rail spec §3): the inline comment input, a
   sibling of the diff pane mounted below it (never inside it). */
.change-review-comment-input {
    height: auto;
    margin: $ds-space-0 $ds-space-1;
}
/* The focused file's existing notes -- kind-labeled, `sent`/pending, with
   a delete affordance on pending rows. Empty (no notes for the focused
   file) collapses to zero height via `display: none`, set at refresh
   time -- the same "renders nothing" convention as the rail section. */
.change-review-notes-strip {
    height: auto;
    max-height: $ds-size-12;
    overflow-y: auto;
    padding: $ds-space-0 $ds-space-1;
    border-top: solid $ds-grid-line;
}
.change-review-note-row {
    height: auto;
    min-height: $ds-size-1;
}
.change-review-note-text {
    width: $ds-width-fill;
}
.change-review-note-delete {
    width: auto;
    min-width: $ds-size-3;
}

/* TASK-1974: the revert confirm modal. Small and centered, per this repo's
   modal discipline; the edited-since warning carries the guard's payload. */
ChangeRevertConfirmModal {
    align: center middle;
}
#change-revert-confirm {
    width: $ds-size-70;
    height: auto;
    max-height: $ds-size-24;
    padding: $ds-space-1 $ds-space-2;
    background: $ds-surface-panel;
    border: round $ds-status-approval-required;
}
#change-revert-edited-warning {
    height: auto;
    margin: $ds-space-1 $ds-space-0;
    color: $ds-status-warning;
}
#change-revert-buttons {
    height: auto;
    min-height: $ds-size-1;
    margin-top: $ds-space-1;
}

/* TASK-16801 arc B (spec §5): the commit confirm modal. Same centered,
   bordered discipline as the revert modal above; the file checklist is the
   only scrolling region (it can hold a whole working tree), and every
   container carries an explicit height for the same fr-inside-flex reason
   the top of this file records. */
ChangeGitCommitModal {
    align: center middle;
}
#change-git-commit {
    width: $ds-size-80;
    height: auto;
    max-height: $ds-size-32;
    padding: $ds-space-1 $ds-space-2;
    background: $ds-surface-panel;
    border: round $ds-status-approval-required;
}
#change-git-commit-target {
    height: auto;
    text-style: bold;
}
#change-git-commit-warnings {
    height: auto;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    color: $ds-status-warning;
}
#change-git-commit-files {
    height: auto;
    max-height: $ds-size-12;
    margin: $ds-space-1 $ds-space-0;
    border: solid $ds-grid-line;
}
.change-git-commit-file {
    height: auto;
    min-height: $ds-size-1;
    width: $ds-width-fill;
    border: none;
    background: transparent;
}
#change-git-commit-error {
    height: auto;
    color: $ds-status-error;
}
#change-git-commit-buttons {
    height: auto;
    min-height: $ds-size-1;
    margin-top: $ds-space-1;
}

/* TASK-16801 arc B (spec §6): the push / PR target-confirmation modal. Same
   bordered discipline as the commit modal above; it holds no scrolling
   region (at most two selectors and three lines of copy), so every
   container carries an explicit auto height. */
ChangeGitPushModal {
    align: center middle;
}
#change-git-push {
    width: $ds-size-80;
    height: auto;
    max-height: $ds-size-20;
    padding: $ds-space-1 $ds-space-2;
    background: $ds-surface-panel;
    border: round $ds-status-approval-required;
}
#change-git-push-target {
    height: auto;
    text-style: bold;
}
#change-git-push-root {
    width: $ds-width-fill;
    margin-top: $ds-space-1;
}
#change-git-push-summary {
    height: auto;
    margin-top: $ds-space-1;
}
#change-git-push-remote {
    width: $ds-width-fill;
    margin-top: $ds-space-1;
}
#change-git-push-buttons {
    height: auto;
    min-height: $ds-size-1;
    margin-top: $ds-space-1;
}

/* ===== MODULE: components/_messages.tcss ===== */
/* ========================================
 * COMPONENTS: Messages
 * ========================================
 * Message display components. ADR-161 task 8c: the shared transcript
 * grammar (the classes composed identically by ChatMessage -- Console
 * transcripts and tool widgets -- and ChatMessageEnhanced -- the Chat
 * window) is defined ONLY here: .message-header/.message-text/
 * .message-actions plus the strip's Button states and the delete-button
 * hover. The widgets' DEFAULT_CSS copies (identical or bundle-wins
 * subsets) were deleted; ChatMessage now has no DEFAULT_CSS at all.
 * ======================================== */

ChatMessage {
    width: 100%;
    height: auto;
    max-height: 50vh;  /* Limit message height to 50% of viewport */
    margin-bottom: 1;
    overflow-y: auto;  /* Allow scrolling within long messages */
}
ChatMessage > Vertical {
    border: round $surface;
    background: $panel;
    padding: 0 1;
    width: 100%;
    height: auto;
}
ChatMessage.-user > Vertical {
    background: $boost; /* Different background for user */
    border: round $accent;
}
ChatMessage.-tool-call > Vertical {
    background: $surface-lighten-1;
    border: round $warning;
}
ChatMessage.-tool-result > Vertical {
    background: $surface-lighten-1;
    border: round $success;
}
.message-header {
    width: 100%;
    padding: 0 1;
    background: $surface-darken-1;
    text-style: bold;
    height: 1; /* Ensure header is minimal height */
}
.message-text {
    padding: 1; /* Padding around the text itself */
    width: 100%;
    height: auto;
    max-height: 40vh;  /* Limit text area to 40% of viewport */
    overflow-y: auto;  /* Allow scrolling within long text */
}

.message-text.tts-generating {
    opacity: 0.8;
    border-left: thick $accent;
}
.message-actions {
    height: auto;
    width: 100%;
    padding: 1; /* Add padding around buttons */
    /* Use a VALID border type */
    border-top: solid $surface-lighten-1; /* CHANGED thin to solid */
    align: right middle; /* Align buttons to the right */
    display: block; /* Default display state */
}
.message-actions Button {
    min-width: 8;
    height: 1;
    margin: 0 0 0 1; /* Space between buttons */
    border: none;
    background: $surface-lighten-2;
    color: $text-muted;
}
.message-actions Button:hover {
    background: $surface;
    color: $text;
}
.message-actions Button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}
.message-actions Button:focus:hover {
    background: $ds-surface-raised;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}
/* The destructive member of the action strip (both message widgets
   compose the trash button with `action-button delete-button`). Promoted
   from the two identical DEFAULT_CSS copies (ADR-161 task 8c). */
.message-actions .delete-button:hover {
    background: $error;
    color: white;
}
/* Initially hide AI actions until generation is complete */
ChatMessage.-ai .message-actions.-generating {
    display: none;
}

/* ===== MODULE: components/_dialogs.tcss ===== */
/* ========================================
 * COMPONENTS: Dialogs
 * ========================================
 * Modal dialogs and popup styles
 * ======================================== */

/* FileSave/FileOpen (vendored Third_Party/textual_fspicker) input bar --
   the filename Input + file-type filter Select row shared by every
   FileOpen/FileSave dialog in the app (Evals export, STTS, library
   import/export, Voice Cloning, LLM model browsing, etc).
   `_conversations.tcss`'s bare, unscoped `Select { width: 100%; }` rule
   always beats `file_dialog.py`'s own `DEFAULT_CSS` regardless of source
   order -- Textual's cascade ranks EVERY CSS_PATH-sourced rule (this
   bundle) above any widget's own DEFAULT_CSS no matter how specific the
   DEFAULT_CSS selector is (same Defect 1 lesson as
   `#mcp-tools-filter-server-slot Select` / `.approval-row-decision`
   elsewhere in this bundle). Without this override, the filter Select
   claims the ENTIRE input-bar row, squeezing the filename Input down to a
   handful of columns -- observed ~5 at 235x52, where a keyboard-only
   export/save flow needs to both read and type into that field
   (task-1479). A 3-type compound selector already outranks the bare
   1-type `Select {}` rule on specificity, so no id is needed for it to
   win here. Scoped to the vendored dialogs themselves (`FileSave`/
   `FileOpen`), not the separate `EnhancedFileDialog` picker
   (`Widgets/enhanced_file_picker.py`), which composes its own Input/Select
   with its own ids and is out of scope for this fix. */
FileSave InputBar Select,
FileOpen InputBar Select,
EnhancedFileDialog InputBar Select {
    width: 24;
    margin-bottom: 0;
}

/* The EnhancedFileDialog selector above (TASK-16478) also defends the
   enhanced picker's own input-bar row (`Widgets/enhanced_file_picker.py`):
   its class-level DEFAULT_CSS cannot beat the bare `Select { width: 100% }`
   rule (CSS_PATH-sourced rules outrank any DEFAULT_CSS specificity; the
   same Defect 1 lesson). Before it, every filtered Enhanced picker
   (Roleplay character import/avatar/expression uploads, Console
   attachments) rendered the filter Select at 100% width: the filename
   Input crushed to ~6 columns and the Select/Cancel buttons laid out past
   the dialog's right edge, clipped out of view -- the dialog looked
   buttonless. The type selector matches EnhancedFileOpen/
   EnhancedFileSave/EnhancedSelectDirectory via the CSS type-name MRO. */

.dialog-title {
    text-align: center;
    text-style: $ds-text-strong;
    margin-bottom: $ds-space-stack;
}

.dialog-buttons {
    layout: horizontal;
    height: 3;
    align: center middle;
}

.dialog-buttons Button {
    margin: $ds-space-0 $ds-space-inline;
    min-width: 12;
}

/* ===== MODULE: components/_status.tcss ===== */
/* ========================================
 * COMPONENTS: Status
 * ========================================
 * Status indicators and displays. ADR-161 task 8a filled this owning
 * sheet: `.status-label`/`.status-area` moved from components/_forms.tcss
 * (byte-identical winners) and the per-line `.status-item` core promoted
 * bare from the two declaration-identical scoped sets in
 * features/_wizards.tcss (ProgressStep/ImportProgressStep); all of it
 * tokenized on arrival.
 * ======================================== */

.status-label {
    margin-top: $ds-space-section;
    margin-bottom: $ds-space-0;
    color: $ds-text-muted;
}

.status-area {
    width: $ds-width-full;
    background: $ds-surface-raised;
    border: round $border;
    padding: $ds-space-inset;
    margin-top: $ds-space-stack;
}

/* State compounds keep their original specificity relationships: the
 * app-wide bare `.error` (features sheets) continues to supply the error
 * tint/border underneath, exactly as under the old scoped rules. */
.status-item {
    /* top/right/bottom stack gap + a $ds-space-2 left indent under the
     * progress marker -- the wizards' original `margin: 0 0 1 2`. */
    margin: $ds-space-0 $ds-space-0 $ds-space-stack $ds-space-2;
    color: $text-muted;
}

.status-item.completed {
    color: $success;
}

.status-item.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.status-item.error {
    color: $error;
}

/* ===== MODULE: components/_agentic_terminal.tcss ===== */
/* ========================================
 * COMPONENTS: Agentic Terminal chrome
 * ========================================
 * ADR-161 task 10 (TASK-24451 closed): the vocabulary grab-bag was carved
 * into single-purpose sheets -- console-* -> features/_console{,_panels}
 * .tcss (bundle-resident; the boot-parsed console split sheet was
 * dissolved), library-* -> features/_library{,_panels}.tcss and
 * settings-* -> features/_settings.tcss (the screen-owned split SOURCES
 * for screen_agentic_{library,settings}.tcss), home-only rules ->
 * features/_home.tcss, destination-* -> layout/_destination.tcss, and
 * the ds-* shell primitives -> components/_ds_primitives.tcss.
 *
 * What remains here is the shared agentic-SHELL family chrome: the
 * all-shells height/strip/region grids, the scoped residue keyed to
 * individual shells (mcp/personas/artifacts/evals/watchlists pane
 * geometry, #console-shell-scoped overlays), and bare widget types
 * (Toast). The semantic token contract for the family lives in
 * core/_variables.tcss; required readable status labels: Ready, Running,
 * Paused, Blocked, Unavailable, Approval required, Unsaved, Recovered.
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent/fr scales + named
   $ds-agentic-* single-consumer geometry), transcribed value-identically
   from the raw literals; comments stay load-bearing. */



/* F-054/F-057: sentence badges must wrap. ID rules override the fixed
   .ds-status-badge size; 1fr avoids intrinsic-width overflow. Keep these
   overrides in sync with MCPInspector/MCPServersMode.DEFAULT_CSS for
   standalone harnesses. */
#mcp-inspector-state,
#mcp-overview-summary {
    width: $ds-width-fill;
    height: auto;
    min-height: $ds-size-1;
}

ConsoleSettingsModal {
    align: center middle;
}

ConsoleSettingsModal Input {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-3;
    min-height: $ds-size-3;
    padding: $ds-space-0 $ds-space-1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

ConsoleSettingsModal Select {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

ConsoleSettingsModal Checkbox {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

ConsoleSettingsModal Select > SelectCurrent {
    width: $ds-width-fill;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    content-align: left middle;
}

ConsoleSettingsModal Select > SelectCurrent Static#label {
    width: $ds-width-fill;
    height: $ds-size-1;
    background: transparent;
    color: $ds-text-primary;
}

ConsoleSettingsModal Select > SelectCurrent .arrow {
    background: transparent;
    color: $ds-text-muted;
}

ConsoleSettingsModal Input:focus {
    height: $ds-size-3;
    min-height: $ds-size-3;
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

ConsoleSettingsModal Input > .input--cursor {
    background: $ds-input-focus-accent;
    color: $ds-surface-panel;
}

ConsoleSettingsModal Input > .input--selection {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}

ConsoleSettingsModal Select:focus {
    border: none;
    border-bottom: none;
    outline: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

ConsoleSettingsModal Select:focus > SelectCurrent {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

ConsoleSettingsModal Select > SelectOverlay {
    padding: $ds-space-0 $ds-space-1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    min-width: $ds-size-30;
}

ConsoleSettingsModal Select > SelectOverlay Option {
    padding: $ds-space-0 $ds-space-2;
    min-height: $ds-size-3;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
}

ConsoleSettingsModal Select > SelectOverlay Option:hover {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

ConsoleSettingsModal Select > SelectOverlay Option.-selected {
    padding: $ds-space-0 $ds-space-2;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

ConsolePromptPickerModal {
    align: center middle;
}

ConsoleStylePickerModal {
    align: center middle;
}

ConsoleSystemPromptModal {
    align: center middle;
}

/* TASK-199: one shared Prompt-variable dialog for Console and Library lanes.
   Only the variable field owns scrolling; destination, authorization, status,
   and actions remain fixed and reachable at the 64x24 support floor. */
PromptVariablesDialog {
    align: center middle;
}

#prompt-variables-dialog {
    width: $ds-size-76;
    max-width: $ds-percent-96;
    height: $ds-percent-90;
    max-height: $ds-size-36;
    min-height: $ds-size-18;
    padding: $ds-space-1 $ds-space-2;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    overflow-x: hidden;
    overflow-y: hidden;
}

#prompt-variables-destination {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

#prompt-variables-system-authorization {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

#prompt-variables-dialog #prompt-variables-apply-system {
    width: $ds-size-5;
    min-width: $ds-size-5;
    max-width: $ds-size-5;
    height: $ds-size-3;
    min-height: $ds-size-3;
    padding: $ds-space-0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-overflow: clip;
}

#prompt-variables-system-state {
    width: $ds-size-5;
    min-width: $ds-size-5;
    max-width: $ds-size-5;
    height: $ds-size-3;
    min-height: $ds-size-3;
    content-align: center middle;
    color: $ds-text-primary;
    text-style: bold;
}

#prompt-variables-system-copy {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-2;
    min-height: $ds-size-2;
    content-align: left top;
    color: $ds-text-primary;
    text-wrap: wrap;
    text-overflow: clip;
}

/* TASK-31665 AC#15: visible thumb -- see the first of these rules. */
#prompt-variables-scroll {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-3;
    border-top: solid $ds-grid-line;
    border-bottom: solid $ds-grid-line;
    background: $ds-surface-panel;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-text-muted;
    scrollbar-color-hover: $ds-text-muted;
    scrollbar-color-active: $ds-action-focus;
}

.prompt-variable-row {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-5;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.prompt-variable-label {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
}

#prompt-variables-dialog .prompt-variable-input {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    border: none;
    border-left: solid $ds-grid-line;
    background: $surface-darken-1;
    color: $ds-text-primary;
}

#prompt-variables-dialog .prompt-variable-input:focus {
    border-left: thick $ds-action-focus;
    background: $ds-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#prompt-variables-status {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $ds-status-warning;
}

#prompt-variables-actions {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    align-horizontal: right;
}

#prompt-variables-cancel,
#prompt-variables-original,
#prompt-variables-apply {
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
    border: none;
}

#prompt-variables-cancel,
#prompt-variables-apply {
    width: $ds-size-10;
    min-width: $ds-size-10;
}

#prompt-variables-original {
    width: $ds-agentic-prompt-vars-pane;
    min-width: $ds-agentic-prompt-vars-pane;
}

#prompt-variables-actions Button:focus {
    outline: heavy $ds-action-focus;
}

#prompt-variables-actions Button:disabled {
    opacity: 100%;
    text-opacity: 100%;
    background: $surface-darken-1;
    color: $text-muted;
}

/* TASK-870: "View full log" read-only run-log viewer, sized/laid out the
   same way as the system prompt editor above (a large text body plus a
   single action row), minus the multi-field editing chrome that modal
   doesn't need. */
ConsoleRunLogModal {
    align: center middle;
}

#home-dashboard,
#console-shell,
#library-shell,
#artifacts-shell,
#personas-shell,
#watchlists-collections-shell,
#schedules-shell,
#mcp-shell,
#acp-shell,
#skills-shell,
#settings-shell {
    height: $ds-height-full;
    min-height: $ds-size-0;
}

#home-title,
#console-title,
#library-title,
#artifacts-title,
#personas-title,
#watchlists-collections-title,
#schedules-title,
#workflows-title,
#mcp-title,
#acp-title,
#skills-title,
#settings-title {
    height: $ds-destination-header-height;
    min-height: $ds-destination-header-height;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    border: none;
}

#home-purpose,
#console-purpose,
#library-purpose,
#artifacts-purpose,
#mcp-purpose,
#console-status-row,
#library-status-row,
#console-mode-bar,
#artifacts-mode-strip,
#personas-mode-strip,
#watchlists-header-bar,
#schedules-filter-strip,
#workflows-mode-strip,
#mcp-mode-strip,
#acp-purpose,
#acp-mode-strip,
#skills-mode-strip,
#settings-category-strip {
    height: $ds-destination-compact-strip-height;
    min-height: $ds-destination-compact-strip-height;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    border: none;
}

#watchlists-header-bar {
    /* The backend Select needs three rows; auto height consumes the shell. */
    height: $ds-size-3;
    min-height: $ds-size-3;
}

.home-dashboard-region,
.library-region,
#artifacts-list-pane,
#artifacts-detail-pane,
#artifacts-inspector-pane,
#personas-list-pane,
#personas-detail-pane,
#personas-inspector-pane,
#watchlists-detail-pane,
#watchlists-inspector-pane,
#workflows-list-pane,
#workflows-detail-pane,
#workflows-inspector-pane,
#mcp-server-tree-pane,
#mcp-detail-pane,
#mcp-readiness-pane,
#acp-list-pane,
#acp-detail-pane,
#acp-inspector-pane,
#skills-list-pane,
#skills-detail-pane,
#skills-inspector-pane,
#settings-category-pane,
#settings-detail-pane,
#settings-impact-pane,
#ccp-character-library-pane,
#ccp-behavior-detail-pane,
#ccp-attachment-inspector-pane {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-height-full;
    min-height: $ds-size-0;
    padding: $ds-space-1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

/* TASK-15504: File Notes and Session Git are trust-sensitive local-file
   surfaces. Their disabled actions previously inherited three compounding
   dimmers and could become unreadable. Keep the label at full opacity, use
   semantic readable ink on an inert surface, and pair it with the visible
   disabled marker supplied by the widgets. This lives at the app tier
   because widget DEFAULT_CSS cannot override Textual's Button rule. */
LibraryFileNotesWorkspace Button:disabled,
LibraryFileNotesGitPanel Button:disabled {
    opacity: 100%;
    text-opacity: 100%;
    text-style: none;
    color: $ds-text-primary;
    background: $surface-darken-1;
}

.file-notes-git-commit-error,
#file-notes-save-status.-error {
    opacity: 100%;
    text-opacity: 100%;
    color: $ds-status-error-readable;
    background: $error-darken-3;
}

/* TASK-15509: Session Git previously redeclared a fixed focus palette inside
   widget DEFAULT_CSS, masking theme-level design-system overrides. Keep a
   built-in semantic fallback in the widget for isolated mounting, then let
   the app tier own the shared workbench focus surface in production. */
LibraryFileNotesGitPanel .file-notes-git-row:focus,
LibraryFileNotesGitPanel .file-notes-git-row.-highlight,
LibraryFileNotesGitPanel .file-notes-git-commit-included-row:focus,
LibraryFileNotesGitPanel .file-notes-git-commit-included-row.-highlight {
    background: $primary-background;
    color: $text;
    text-style: bold underline;
    outline: none;
}

LibraryFileNotesGitPanel Button.-style-default:focus {
    background: $primary-background;
    color: $text;
    text-style: bold underline;
    outline: none;
}

LibraryFileNotesGitPanel #file-notes-git-push-body:focus,
LibraryFileNotesGitPanel #file-notes-git-commit-body:focus {
    outline: heavy $primary;
}

/* Disabled-action recovery remains on screen and uses readable semantic ink.
   These lines carry the reason and next step, so muted telemetry contrast is
   not sufficient across the complete shipped theme catalog. */
#file-notes-action-status,
#file-notes-git-status,
#file-notes-git-push-result-reason,
#file-notes-git-commit-check-again-reason {
    opacity: 100%;
    text-opacity: 100%;
    color: $ds-text-primary;
}

#file-notes-authority {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    max-height: $ds-size-2;
    color: $ds-text-muted;
    text-wrap: wrap;
    overflow: hidden hidden;
}

ConsoleTerminalWorkspace Button {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    content-align: center middle;
}

ConsoleTerminalWorkspace Button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Shared direct-section body. The owner applies the measured content-row
   allocation inline; no CSS ceiling may override a smaller Context grant. */
ConsoleBoundedSection {
    height: auto;
    min-height: $ds-size-0;
}

ConsoleAgentHistoryModal { align: center middle; background: $background 60%; }
#agent-history-dialog { width: $ds-percent-90; max-width: $ds-size-110; height: $ds-percent-85; border: round $primary; background: $panel; padding: $ds-space-1 $ds-space-2; }
#agent-history-state { height: auto; color: $ds-text-muted; margin-bottom: $ds-space-1; }
#agent-history-table { height: $ds-height-fill; min-height: $ds-size-3; }
#agent-history-actions { height: $ds-size-3; margin-top: $ds-space-1; align-horizontal: right; }
#agent-history-actions Button { min-width: $ds-size-12; margin-left: $ds-space-1; }

/* task-32287 review: and so do the sibling cards that share the surface.
   With the surface `auto`, a child left on Textual's `height: 1fr` default
   resolves that fraction against the whole offered box instead of the
   surface's content, so each of these rendered 50 rows in a 50-row harness
   -- the ballooning simply moved down a level. The two skill cards need
   their button rows named as well (`Horizontal`, also unstyled, also
   `1fr`): a `1fr` grandchild re-inflates an `auto` parent exactly as
   `#approval-batch-actions` did. ChatQuestionCard is absent
   here on purpose: it already ships `height: auto; max-height: 24` in its
   own BUNDLED_CSS and measures 14 rows in that same harness. */
/* #skill-install-buttons/#skill-script-buttons are the button rows INSIDE
   SkillInstallConfirmCard/SkillScriptConfirmCard, not scoped to the Console
   card ids above -- the same two cards are also mounted, under different
   outer ids (#buddy-install/#buddy-script), inside
   BuddyConversationModal (buddy_conversation_modal.py). The id selectors
   here are deliberately global so both hosts get the fix; verified green
   in the Buddy modal too. */
#chat-resume-panel,
#chat-skill-install-card,
#chat-skill-script-card,
#skill-install-buttons,
#skill-script-buttons {
    height: auto;
}

/* task-3401.10: modal full-player screen -- centered panel, frame area above
   a status line (position/drift/dropped/mode) and the hints line (only
   implemented actions, decision 031). */
VideoPlayerScreen {
    align: center middle;
}

VideoPlayerScreen .video-player-frame {
    height: auto;
    max-height: $ds-size-26;
    padding: $ds-space-0 $ds-space-1;
}

#video-player-status {
    color: $ds-text-muted;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}

#video-player-hints {
    color: $ds-text-muted;
    text-style: dim;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}

/* TASK-26042: read-only Workspace Files modal.  The modal's rows are pinned;
   only the tree and safe viewer scroll.  At compact widths it deliberately
   becomes full-screen, so there is no misleading visible backdrop target. */
ConsoleWorkspaceFilesModal {
    align: center middle;
}

ConsoleCitationSourcesModal {
    align: center middle;
}

/* task-18812 / ADR-071: focus mode. The -focus class lives on the
   ChatScreen itself (MainNavigationBar is composed by BaseAppScreen as a
   sibling of #console-shell, so #console-shell-rooted selectors cannot
   reach it). display:none only — no raw visual values (ADR-042). The
   one-line #screen-footer-status status bar is intentionally KEPT. */
ChatScreen.-focus MainNavigationBar {
    display: none;
}


/* Meetings rail: the voice rows (TASK-31826). Class-keyed on purpose -- an
   `#id Button` rule would be an ancestor-scoped bare-type subject, which the
   Perf Guard CSS ratchet counts.

   A Textual container defaults to `height: 1fr`, so these blocks split the
   rail's leftover rows between them and collapsed to one row (the offer's
   three answer buttons were clipped out of the compositor entirely at
   100x30 -- review C1). Sizing them to their content instead lets the rail's
   VerticalScroll do the work. */
.meetings-rail-block,
.meetings-rail-actions {
    height: auto;
}

/* Same treatment `.console-retrieval-scope-action` needed (TASK-24607):
   `width: auto` alone does not shrink a Button, its DEFAULT_CSS carries
   `min-width: 16`. Four 16-column buttons need 65 columns; the rail is half
   a workbench, so "Import…" was clipped to one column at 100 (review I4). */
.meetings-rail-button {
    width: auto;
    min-width: $ds-size-0;
}

#artifacts-workbench,
#personas-workbench,
#watchlists-workbench,
#workflows-workbench,
#mcp-workbench,
#acp-workbench,
#skills-workbench,
#settings-workbench,
#evals-workbench,
#meetings-workbench {
    height: $ds-height-fill;
    /* Must stay below the worst-case available height at small terminal
       sizes, otherwise content overflows and the footer status bar
       intercepts clicks on the covered rows. Pane content scrolls
       internally. */
    min-height: $ds-size-10;
    padding: $ds-space-1;
    margin: $ds-space-0;
    overflow: hidden;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

#artifacts-list-pane,
#artifacts-detail-pane,
#artifacts-inspector-pane,
#personas-list-pane,
#personas-detail-pane,
#personas-inspector-pane,
#watchlists-detail-pane,
#watchlists-inspector-pane,
#workflows-list-pane,
#workflows-detail-pane,
#workflows-inspector-pane,
#mcp-server-tree-pane,
#mcp-detail-pane,
#mcp-readiness-pane,
#acp-list-pane,
#acp-detail-pane {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

#artifacts-inspector-pane,
#personas-inspector-pane,
#watchlists-inspector-pane,
#workflows-inspector-pane,
#mcp-readiness-pane,
#acp-inspector-pane {
    margin: $ds-space-0;
}

#personas-list-pane,
#personas-detail-pane,
#personas-inspector-pane,
#watchlists-detail-pane,
#watchlists-inspector-pane,
#workflows-list-pane,
#workflows-detail-pane,
#workflows-inspector-pane,
#acp-list-pane,
#acp-detail-pane,
#acp-inspector-pane,
#evals-library-pane,
#evals-detail-pane,
#evals-inspector-pane {
    height: $ds-height-full;
    min-height: $ds-size-0;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

#personas-inspector-pane {
    width: $ds-fr-2;
    min-width: $ds-size-30;
    border: solid $ds-grid-line;
    padding: $ds-space-1;
}

#personas-readiness-console {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    text-wrap: wrap;
}

/* Workbench column split (2:4:2). Required here because the generic
   .destination-workbench-pane width (1fr) outranks the screen's DEFAULT_CSS,
   which would squeeze the work area to a third of its intended width. */
#personas-library-pane {
    width: $ds-fr-2;
    min-width: $ds-size-24;
}

#personas-work-area {
    width: $ds-fr-4;
    min-width: $ds-size-40;
}

#personas-workbench.personas-workbench-compact {
    padding: $ds-space-0;
}

#personas-library-pane.personas-workbench-compact-pane {
    width: $ds-width-fill;
    min-width: $ds-size-16;
    padding: $ds-space-0 $ds-space-1;
}

#personas-work-area.personas-workbench-compact-pane {
    width: $ds-fr-3;
    min-width: $ds-size-34;
    padding: $ds-space-0 $ds-space-1;
}

#personas-inspector-pane.personas-workbench-compact-pane {
    width: $ds-width-fill;
    min-width: $ds-size-22;
    padding: $ds-space-0 $ds-space-1;
}

#workflows-list-pane,
#acp-list-pane {
    width: $ds-fr-2;
    min-width: $ds-size-30;
    border: solid $ds-grid-line;
    padding: $ds-space-1;
}

#workflows-detail-pane,
#acp-detail-pane {
    width: $ds-fr-4;
    min-width: $ds-size-52;
    border: solid $ds-grid-line;
    padding: $ds-space-1;
}

#workflows-inspector-pane,
#acp-inspector-pane {
    width: $ds-fr-2;
    min-width: $ds-size-34;
    border: solid $ds-grid-line;
    padding: $ds-space-1;
}

.acp-selected-session-row {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.acp-inspector-group-title {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

#personas-list-detail-divider,
#personas-detail-inspector-divider,
#watchlists-list-detail-divider,
#watchlists-detail-inspector-divider,
#schedules-list-detail-divider,
#schedules-detail-inspector-divider,
#workflows-list-detail-divider,
#workflows-detail-inspector-divider,
#acp-list-detail-divider,
#acp-detail-inspector-divider {
    background: $ds-grid-line;
}

.artifacts-column-title,
.personas-column-title,
.watchlists-column-title,
.schedules-column-title,
.workflows-column-title,
.acp-column-title,
.skills-column-title,
.ccp-column-title,
.settings-column-title {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    background: $ds-surface-raised;
    /* task-1625: the pane titles are the screen's one visual-voice
       carrier -- Focus Phosphor per DESIGN.md, bold, nowhere else. */
    color: $accent;
    text-style: bold;
}

RagProfileNameModal,
RagProfileSwitchConfirmModal {
    align: center middle;
}

_CredentialEditorModal,
_CredentialClearModal {
    align: center middle;
}

/* ADR-161 task 9 split these density rules by family; task 10 moved the
   ds-inspector / ds-recovery-callout halves to components/
   _ds_primitives.tcss with their classes, so no member remains here. */

.is-active {
    border: round $ds-action-focus;
    text-style: bold;
}

.personas-mode-chip.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.personas-mode-chip.is-active:focus {
    outline: none;
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Keyboard-browse cursor: visually distinct from the flat subdued bg.
   $ds-grid-line (#26364D) is lighter than $ds-surface-raised/#ds-focus-bg
   (#142033) so browsed rows are visible without special-casing focus state.
   Place BEFORE the .is-active rules so equal-specificity cascade gives
   .is-active the final word. */
ListItem.personas-library-row.-highlight,
ListItem.personas-conversation-row.-highlight {
    background: $ds-grid-line;
    color: $ds-text-primary;
    text-style: bold;
}

/* Selected/active row: wins because it appears later in the sheet. */
ListItem.personas-library-row.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

/* Active row that is also the browse cursor: .is-active styling wins
   (later in sheet, same specificity as the -highlight rule above). */
ListItem.personas-library-row.is-active.-highlight {
    outline: none;
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

/* task-445: the global `*:focus { outline: solid $ds-focus-accent; }`
   fallback (core/_reset.tcss) draws its outline around the ListView's own
   box once it takes keyboard focus after a row is selected -- and that box
   is taller than the 1-2 rows it holds (it fills the rail's remaining
   height), so the outline rendered as a tall empty bordered rectangle
   hanging below the selected row (RP UX review). Rows already show
   selection via .is-active/.-highlight backgrounds above, so the fallback
   outline is both redundant and visually broken here. */
#personas-library-rows:focus {
    outline: none;
}

.is-disabled {
    opacity: 0.55;
}

.is-blocked {
    border: round $ds-status-error;
    background: $ds-status-error 10%;
}

.is-running {
    border: round $ds-status-running;
}

.is-paused {
    border: round $ds-status-paused;
}

.is-unsaved {
    border: round $ds-status-unsaved;
}

.is-stale {
    color: $ds-text-muted;
}

.is-conflict {
    border: thick $ds-status-error;
}

.needs-approval {
    border: thick $ds-status-approval-required;
    background: $ds-status-approval-required 12%;
}

.source-local {
    border: round $ds-authority-local;
}

.source-server {
    border: round $ds-authority-server;
}

.source-workspace {
    border: round $ds-authority-workspace;
}

.source-remote-only {
    border: round $ds-authority-remote-only;
}

.source-dry-run {
    border: dashed $ds-grid-line;
    color: $ds-text-muted;
}

/* --- MCP Hub (Phase 1 workbench) ------------------------------------- */

#mcp-mode-strip Button.mcp-mode-chip {
    width: auto;
    min-width: $ds-size-10;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
}

#mcp-mode-strip .mcp-mode-chip.is-active {
    text-style: bold underline;
}

/* A1: focus must not impersonate .is-active above (bold underline). Kept in
   lockstep with the lower-specificity baseline copy in MCPScreen.DEFAULT_CSS
   (mcp_screen.py) -- see that copy's comment for why it uses raw
   $surface/$text/$text-muted tokens instead of these $ds- aliases. */
#mcp-mode-strip .mcp-mode-chip:focus,
#mcp-mode-strip .mcp-mode-chip:hover:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
    outline: none;
}

#mcp-mode-strip .mcp-mode-chip.is-active:focus,
#mcp-mode-strip .mcp-mode-chip.is-active:hover:focus {
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: bold underline;
    outline: none;
}

/* --- Lab mode strip (Models | Speech | Evals) ---------------------------
   Mirrors the MCP chip rules above: the generic `.is-active { border: round
   $ds-action-focus }` rule (line ~3869) otherwise draws a border around the
   1-row chip, clipping its label out of the 1-high strip entirely. */
#lab-mode-strip Button.lab-mode-chip {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
}

#lab-mode-strip .lab-mode-chip.is-active {
    border: none;
    text-style: bold underline;
}

#lab-mode-strip .lab-mode-chip:focus,
#lab-mode-strip .lab-mode-chip:hover:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
    outline: none;
}

#lab-mode-strip .lab-mode-chip.is-active:focus,
#lab-mode-strip .lab-mode-chip.is-active:hover:focus {
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: bold underline;
    outline: none;
}

#mcp-hub-rail {
    width: $ds-fr-3;
    min-width: $ds-size-24;
}

#mcp-hub-rail .mcp-rail-heading {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-top: $ds-space-1;
}

/* Override border away from the generic `.is-active` rule (`border: round
   $ds-action-focus`, earlier in this sheet). Button.mcp-rail-row rows are
   fixed at height 1 (see MCPRail.DEFAULT_CSS); a round border needs at
   least 2 lines to render, so on a height-1 button it consumes the row's
   only line and the content area collapses to height 0 -- the label never
   renders, leaving a blank bordered box for the selected row. Mirrors the
   sibling `.mcp-mode-chip.is-active` rule below (and MCPScreen.DEFAULT_CSS's
   copy of it), which already carries this same `border: none` override. */
#mcp-hub-rail Button.mcp-rail-row.is-active {
    border: none;
    text-style: bold;
}

#mcp-hub-canvas {
    width: $ds-fr-5;
    min-width: $ds-size-38;
}

#mcp-hub-inspector {
    width: $ds-fr-3;
    min-width: $ds-size-28;
    height: $ds-height-full;
    min-height: $ds-size-0;
}

/* F-057: below ~120 cols (`.mcp-compact` on #mcp-hub-grid, toggled by
   MCPWorkbench.on_resize) the triad rebalances toward the canvas so the
   servers table keeps its primary columns in-viewport; the rail/inspector
   take narrower shares + min-widths (their content wraps/truncates
   honestly -- see `#mcp-inspector-state` above and MCPRail's width-aware
   row truncation budget). More specific AND later than the pane rules
   above, so it wins both contests. Kept in lockstep with the bare-harness
   copy in MCPWorkbench.DEFAULT_CSS. */
#mcp-hub-grid.mcp-compact #mcp-hub-rail {
    width: $ds-fr-2;
    min-width: $ds-size-16;
}

#mcp-hub-grid.mcp-compact #mcp-hub-canvas {
    width: $ds-agentic-mcp-compact-canvas-share;
    min-width: $ds-size-30;
}

#mcp-hub-grid.mcp-compact #mcp-hub-inspector {
    width: $ds-fr-2;
    min-width: $ds-size-20;
}

/* A5: the row wrapping the aggregate summary's colored glyph + neutral
   sentence (kept in lockstep with the width rules in
   MCPServersMode.DEFAULT_CSS, mcp_servers_mode.py -- required in EVERY
   harness, not just the bundled one: without an explicit width split, both
   Static children of the Horizontal default to 1fr/full-width and the
   second one renders entirely off-screen).
   F-057: `height: auto` (was 1) so the wrapped summary sentence's second
   line actually gets rows to render on at ~100-col widths -- the child
   `#mcp-overview-summary` override above can only wrap into space the row
   itself provides. `#mcp-detail-title` stays at exactly 1 (single-line
   badge + label). */
#mcp-overview-summary-row {
    height: auto;
    min-height: $ds-size-1;
}

#mcp-detail-title {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

#mcp-overview-callouts .ds-recovery-callout {
    margin-top: $ds-space-1;
}

/* A2: disabled inspector action buttons must stay legible. The generic
   `Button:disabled` rule above (from _buttons.tcss, same "user CSS" tier as
   this file -- see MCPInspector.DEFAULT_CSS's matching rule and comment for
   why a widget-level DEFAULT_CSS override alone can never win this fight)
   stacks `opacity: 50%` on `$text-disabled` on a dark surface, which reads
   as functionally invisible on top of `.console-action-secondary`. Restore
   full opacity and use a dim-but-still-readable color instead. */
#mcp-hub-inspector Button.mcp-inspector-action:disabled {
    opacity: 100%;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: none;
}

#mcp-hub-inspector Button.mcp-inspector-action:disabled:hover {
    opacity: 100%;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: none;
}

/* A3: same Button center-default lesson as Button.mcp-rail-row
   (MCPRail.DEFAULT_CSS) and Button.mcp-callout below -- left-align the
   inspector's action stack. Kept in lockstep with the baseline copy in
   MCPInspector.DEFAULT_CSS (mcp_inspector.py). */
Button.mcp-inspector-action {
    text-align: left;
    content-align: left middle;
}

/* --- MCP Hub Phase 2 ------------------------------------------------- */
.mcp-status-ready { color: $ds-status-ready; }
.mcp-status-warning { color: $ds-status-warning; }
.mcp-status-error { color: $ds-status-error; }
.mcp-status-info { color: $ds-status-info; }
/* task-2239: the off/opt-in display state (the disabled built-in server) --
quiet, not alarming; same muted tier as the legend/hint lines. */
.mcp-status-muted { color: $ds-text-muted; }

Button.mcp-callout {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    /* Button defaults BOTH text-align AND content-align to center (see
       Textual's own Button.DEFAULT_CSS, and the same lesson documented on
       Button.mcp-rail-row in MCPRail.DEFAULT_CSS) -- text-align alone does
       not left-align a one-line Button label; without content-align the
       whole callout line still rendered centered under the table. */
    text-align: left;
    content-align: left middle;
}

#mcp-servers-form {
    height: auto;
    min-height: $ds-size-0;
}

/* Kept in lockstep with the baseline copy in MCPServersMode.DEFAULT_CSS
   (mcp_servers_mode.py) -- T7 (P3 UX batch) gave the overview table
   `height: auto; max-height: 70%;` so it hugs its own row count instead of
   a `1fr` table ballooning to fill the pane and stranding
   #mcp-overview-callouts dozens of rows below its last row (same bug class
   as #mcp-detail-builtin-toggles below). Without this bundle-layer copy,
   app-loaded CSS cascading on top of DEFAULT_CSS could silently
   reintroduce that regression. */
#mcp-servers-table {
    height: auto;
    max-height: $ds-agentic-mcp-table-cap;
}

/* Kept in lockstep with the baseline copy in MCPToolsMode.DEFAULT_CSS
   (mcp_tools_mode.py) -- same fix, same rationale, as #mcp-servers-table
   immediately above. */
#mcp-tools-table {
    height: auto;
    max-height: $ds-agentic-mcp-table-cap;
}

/* T9 (P4): kept in lockstep with the baseline copy in
   MCPPermissionsMode.DEFAULT_CSS (mcp_permissions_mode.py) -- same fix,
   same rationale, as #mcp-servers-table/#mcp-tools-table above: the matrix
   hugs its own row count instead of ballooning to fill the canvas, leaving
   room for the policy-preview strip below it. */
#mcp-perm-table {
    height: auto;
    max-height: $ds-agentic-mcp-table-cap;
}

/* T9 (P4): kept in lockstep with the baseline copy in
   MCPPermissionsMode.DEFAULT_CSS -- the policy-preview strip below the
   matrix is a single Static (a sentence or two at most); without this,
   Vertical's own default sizing could let it compete with the matrix table
   above for the canvas's remaining space instead of hugging its own
   content, same bug class as #mcp-detail-builtin-toggles/#mcp-import-list
   below. */
#mcp-perm-preview {
    height: auto;
    min-height: $ds-size-0;
}

/* Defect 1 fix (QA round mcp-hub-phase3-2026-07): kept in lockstep with the
   baseline copy in MCPToolsMode.DEFAULT_CSS (mcp_tools_mode.py), but here
   it's load-bearing, not just defensive. Textual's cascade always treats
   every CSS_PATH-sourced rule (this bundle) as higher priority than any
   widget's own DEFAULT_CSS, regardless of selector specificity -- so
   _conversations.tcss's global, unscoped `Select { width: 100%; }` rule
   (intended for a completely different screen's sidebar forms) was
   silently winning over MCPToolsMode's own, far more specific override,
   collapsing the filter-server Select to a 0x0 region against its
   `width: auto` slot parent (the sibling filter Input already claims the
   full bar at `width: 1fr`). This copy must live in the bundle itself,
   with equal-or-higher specificity than that bare rule, to actually win. */
#mcp-tools-filter-server-slot Select {
    width: $ds-size-28;
}

/* task-32286: the TASK-14807 `MCPToolsMode #mcp-tools-local-enabled`
   Checkbox width/height escape hatch that used to live here is retired --
   the master control is now a toggle Button (mcp_tools_mode.py's
   `_local_tools_toggle_label()`, matching `mcp_servers_mode._gate_button()`
   since task-32284), which sizes to its own label (Button's own
   DEFAULT_CSS `width: auto`) and needs no bundle override. The app-wide
   unscoped `Checkbox { width: 100%; height: 2; }` rule this escape hatch
   was fighting was itself retired in TASK-18960, so nothing was left for
   it to win against. */

/* Kept in lockstep with the baseline copy in MCPServersMode.DEFAULT_CSS
   (mcp_servers_mode.py) -- without an explicit height override here too,
   Textual's Vertical default (height: 1fr) expands this container to fill
   the rest of #mcp-detail-scroll, pushing its sibling "Copy client config"
   Button roughly 800px below the built-in enable/expose checkboxes it
   should sit directly under. QA defect 1, mcp-hub-phase2-2026-07 round. */
#mcp-detail-builtin-toggles {
    height: auto;
    min-height: $ds-size-0;
}

/* task-3240 fix round 1 (Minor 2): kept in lockstep with the baseline copy
   in MCPServersMode.DEFAULT_CSS (mcp_servers_mode.py) -- same bug class
   and same fix as #mcp-detail-builtin-toggles immediately above: without
   an explicit height override here too, Textual's Vertical default
   (height: 1fr) would expand this new sibling container (the "Tool
   gates" checkbox group) to fill the rest of #mcp-detail-scroll, pushing
   the "Copy client config" Button far below it. The widget-test harness
   (Tests/UI/test_mcp_servers_mode.py) never loads this bundle, so a
   regression here would be invisible to those tests -- only a bundled-CSS
   harness or the live app would catch it. */
#mcp-detail-tool-gates {
    height: auto;
    min-height: $ds-size-0;
}

#mcp-detail-toolbar Button {
    height: $ds-size-1;
    min-height: $ds-size-1;
    border: none;
}

/* A1: kept in lockstep with the baseline copy in MCPImportPanel.DEFAULT_CSS
   (mcp_profile_form.py) -- without an explicit height override here too,
   Textual's Vertical default (height: 1fr) expands this container to
   consume whatever vertical space the panel has left, stranding the
   sibling "Import N servers"/Cancel action row far below the preview list
   on a real terminal window (same bug class as #mcp-detail-builtin-toggles,
   QA defect 1, mcp-hub-phase2-2026-07 round). */
#mcp-import-list {
    height: auto;
    min-height: $ds-size-0;
}

/* T7 (P3 UX batch): quiet focus treatment for the hub's scrollable content
   panes. Both are VerticalScroll (can_focus=True by default, via
   ScrollableContainer) and, without a rule here, fall back to the generic
   `*:focus { outline: solid $ds-focus-accent; }` fallback (core/_reset.tcss)
   -- a heavy boxed cue for panes that just scroll read-only detail text /
   the legacy Advanced form. Mirrors the idiom already established for
   Console content panes elsewhere in this file (#console-left-rail-body:
   focus, #console-workspace-context:focus, #console-workspace-
   conversations:focus): drop the outline/border and shift the background
   instead, so keyboard focus stays visible without boxing the pane. Uses
   $ds-surface-panel (this codebase's quiet-surface token) rather than
   Textual's built-in $boost, which nothing else in this design system
   references. */
#mcp-detail-scroll:focus,
#mcp-adv-scroll:focus {
    outline: none;
    border: none;
    background: $ds-surface-panel;
}

/* task-2272 item 1 (PR-T3 Task 6): the Test Tool's typed form rendered every
   boolean field as an empty ~2-row box -- no toggle glyph, no label, state
   impossible to read (`search_rag`'s `use_semantic`, found in the PR-5 live
   check).

   Cause, measured in a test app with this bundle loaded: `css/features/
   _conversations.tcss` ships an unscoped `Checkbox { width: 100%; height:
   2; }` type selector that reaches every checkbox app-wide (the SAME rule
   `.settings-imagegen-backend-row Checkbox`, `LibraryIngestCanvas .type-
   group-contents Checkbox` and `#evals-bench-capture-continuations` each
   already carry their own escape from). Checkbox's own border takes both of
   those rows, leaving the widget's CONTENT height at literally 0 -- so the
   glyph and label had nowhere to paint and the box was all the user saw.
   `height: auto` gives the border its two rows AND the content its one back.

   The glyph paints "X" in BOTH states, distinguished by colour alone
   (task-1624's finding for `ImageGenSettingsPanel`) -- reuse that fix's
   idiom so OFF hides the glyph against the panel and ON shows it: with no
   On/Off word beside it here, the glyph IS the state carrier, and a boolean
   the user cannot read is a lie about what was sent to the tool. */
MCPSchemaForm Checkbox {
    width: auto;
    height: auto;
    min-height: $ds-size-1;
}
MCPSchemaForm Checkbox > .toggle--button {
    color: $ds-surface-panel;
}
MCPSchemaForm Checkbox.-on > .toggle--button {
    color: $success;
}

/* --- MCP Hub Phase 5 (T9: Audit mode + Console batch approvals) ------ */

/* Kept in lockstep with the baseline copy in MCPAuditMode.DEFAULT_CSS
   (mcp_audit_mode.py) -- same fix, same rationale, as #mcp-servers-table/
   #mcp-tools-table/#mcp-perm-table above: the execution-log table hugs its
   own row count instead of ballooning to fill the canvas. */
#mcp-audit-table {
    height: auto;
    max-height: $ds-agentic-mcp-table-cap;
}

/* Kept in lockstep with the baseline copy in MCPAuditMode.DEFAULT_CSS --
   same fix, same rationale, for the T8 Findings sub-view table. */
#mcp-audit-findings-table {
    height: auto;
    max-height: $ds-agentic-mcp-table-cap;
}

/* Kept in lockstep with the baseline copy in MCPAuditMode.DEFAULT_CSS.
   The T8 Executions/Findings sub-view toggle strip is a Horizontal, which
   defaults to `height: 1fr` -- without this override it would expand to
   compete with the table below it for the canvas's remaining space
   instead of hugging its own two-button content, same bug class as
   #mcp-perm-preview/#mcp-detail-builtin-toggles/#mcp-import-list above. */
#mcp-audit-subview-strip {
    height: auto;
    min-height: $ds-size-0;
}

/* Same Defect-1 Select-width lesson as #mcp-tools-filter-server-slot
   Select above (QA round mcp-hub-phase3-2026-07): `_conversations.tcss`'s
   bare `Select { width: 100%; }` rule always beats DEFAULT_CSS regardless
   of source order, so an id-scoped bundle rule is required for it to
   actually win. MCPAuditMode.DEFAULT_CSS already avoids the 0x0 collapse a
   different way for these two Selects (each lives in its own definite-
   width slot Vertical, not a bare auto-sized one -- see that file's own
   comment) -- these two rules are additional, defensive, EXPLICIT-width
   pins directly on the Selects' own ids (mirroring their slots' widths,
   24/20), kept in lockstep with the matching pair T9 added to
   MCPAuditMode.DEFAULT_CSS itself, so the Selects stay correctly sized
   even if the slot wrapper's own CSS were ever removed or the Select were
   ever mounted outside it. */
#mcp-audit-filter-decision {
    width: $ds-size-24;
}
#mcp-audit-filter-initiator {
    width: $ds-size-20;
}

/* task-32287: the card's body and its action bar hug their content too.
   Both were unstyled -- `#approval-batch-body` is a Container and
   `#approval-batch-actions` a Horizontal, so both defaulted to `height:
   1fr` and expanded to fill the card, which (despite `.ds-approval-card`'s
   own `height: auto`) therefore took whatever its parent offered: a
   ONE-row batch measured 46 lines in a 50-row harness, with the ten-plus
   blank rows between the action bar and the bottom border the 2026-09-10
   live pass reported. */
#approval-batch-body,
#approval-batch-actions {
    height: auto;
}

/* The Console MCP batch-approval card's per-row layout
   (`ChatApprovalCard.set_batch()`, chat_approval_card.py -- T5 deferred
   this CSS to T9's phase gate). This card carries no `DEFAULT_CSS` of its
   own at all (unlike the MCP mode widgets above) -- these rules are the
   ONLY styling `.approval-row*` has anywhere, bundle or otherwise.

   `.approval-row` is a Horizontal, which defaults to `height: 1fr` --
   live-repro'd ballooning to the full card height (and its decision
   Select claiming the full ROW width in turn) before this fix, the same
   fr-inside-flex bug class as the MCP lockstep rules above. `height:
   auto` makes each row hug its own single line of content instead.

   `#approval-batch-rows` (the Vertical wrapping all rows) gets the same
   `height: auto` treatment as #mcp-perm-preview/#mcp-detail-builtin-
   toggles/#mcp-import-list above -- without it, its own `height: 1fr`
   default would balloon it to fill the card and push the sibling
   Approve-all/Submit/Deny-all action bar (#approval-batch-actions) far
   below the visible rows.

   `.approval-row-header`/`.approval-row-args` (Statics, natively `width:
   auto`) get an explicit `1fr` share each so unbounded text (a long
   tool/server header, or an args summary up to 80 chars) can't hog the
   row and squeeze the decision Select out of view. `.approval-row-
   decision` (the class selector on the row's Select) gets an explicit
   fixed width -- a CLASS selector already outranks the bare `Select {
   width: 100%; }` type selector on specificity alone, so (unlike the two
   MCP Select fixes above) no id-scoped selector is needed here for it to
   win; without this rule the Select would otherwise claim the row's FULL
   width instead of its own bounded share, overlapping/clipping behind the
   header and args text laid out before it. */
#approval-batch-rows {
    height: auto;
    min-height: $ds-size-0;
    /* TASK-1846: bound the rows so the action bar below them is reachable
       at ANY row count. The card is `height: auto` inside a plain Container
       (`ChatTaskCards`), so before this a long batch simply grew past the
       viewport and took Submit/Approve-all/Deny-all with it -- measured on
       an 80x24 terminal, five rows already pushed Submit to y=24. Splitting
       arguments onto their own line costs a line per row and would have
       moved that cliff from five rows to four, so the cap fixes the older
       bug rather than inheriting it. 15 leaves room for the header, the
       deadline and the action bar at 24 rows; taller batches scroll. */
    max-height: $ds-size-15;
    overflow-y: auto;
}
.approval-row {
    height: auto;
    min-height: $ds-size-1;
    width: $ds-width-fill;
}
/* TASK-1846 AC#2: `.approval-row` is now a Vertical -- header, arguments,
   and `.approval-row-controls` each on their own FULL width line (plus, since
   task-32278, the reason and scope lines below).
   Before the split all four shared one Horizontal, and the
   controls' 27 + 14 + 14 = 55 fixed cells left the arguments 10 cells at 80
   columns: `{"path":"~/` of `{"path":"~/notes/secrets.md"}`. Since
   TASK-1861 the card offers one decision per TARGET, so that clipped text
   was the decision.

   Keeping the header BESIDE the controls was tried and is wrong: in the
   Console's ~52-cell chat pane those 54 fixed cells starve the header to
   one cell, which wraps to nine lines and pushes the arguments out of the
   card -- caught only by looking at a real terminal.

   The controls row is a Horizontal and needs the SAME `height: auto` as
   `.approval-row` above -- a Horizontal defaults to `height: 1fr`, the
   fr-inside-flex bug this block already documents, and left at the default
   it balloons to the card height and takes the args line off screen. */
.approval-row-controls {
    height: auto;
    min-height: $ds-size-1;
    width: $ds-width-fill;
}
.approval-row-header {
    width: $ds-width-fill;
}
.approval-row-args {
    width: $ds-width-fill;
}
.approval-row-full-command {
    width: $ds-width-fill;
    height: $ds-size-6;
    min-height: $ds-size-3;
}
.approval-row-raw-label,
.approval-row-raw-metadata,
.approval-row-raw-warning,
.approval-row-raw-scope {
    width: $ds-width-fill;
    height: auto;
}
/* task-32278: the label area is this width MINUS 8 cells of Textual chrome
   (`SelectCurrent`: `border: tall` 1+1, `padding: 0 2` 2+2, `.arrow`
   `width: 1` with `padding: 0 0 0 1`). The closed Select does not
   ellipsize -- `SelectCurrent` is `height: auto` and its `Static#label`
   wraps -- so a label one cell over grows the control instead of clipping:
   "Always allow this exact input" measured FOUR lines tall at width 26.
   The labels are short now (longest: "Always · these args", 19); 27 is
   19 + 8, and `Tests/UI/test_chat_approval_card.py` reads this number back
   out of this file so the two cannot drift apart again. */
.approval-row-decision {
    width: $ds-agentic-prompt-vars-pane;
}
/* task-32278: the row's reason line (why this is asking -- the visible
   replacement for the old header tooltip) and its scope line (what the
   selected decision commits to, and where to undo it). Both carry full
   sentences, so they get the same explicit `1fr` share as the header and
   args lines above rather than a `width: auto` that overflows the row. */
.approval-row-reason,
.approval-row-scope {
    width: $ds-width-fill;
    height: auto;
}
/* Fleet-UX expert review F5 (task-1234): single-row cards additionally
   mount two compact fast-path buttons after the decision Select --
   "Approve once"/"Deny" submit immediately, bypassing Select+Submit for
   the two most common decisions (`ChatApprovalCard.set_batch`'s
   `single_row` gate; never rendered for a multi-row batch). `compact`
   already keeps these borderless/1-row tall; fixed widths keep them from
   claiming `Button`'s `width: auto` share and squeezing the row. */
.approval-row-fast-approve,
.approval-row-fast-deny {
    width: $ds-size-14;
    min-width: $ds-size-14;
}
/* task-5 (Phase-5 follow-up): a bulk "Approve all"/"Deny all" press can't
   legally reach every narrowed row (`ChatApprovalCard._set_all_batch_
   decisions` -- a row whose `options` exclude every bulk candidate is left
   on its current value instead of crashing). Left unstyled, that row looks
   identical to one nobody has decided on yet. `.needs-decision` (added by
   that same skip path, cleared by the row's own `Select.Changed`) gives it
   the same warning treatment as `.library-rag-callout.is-blocked` above:
   border + a light background tint, using the semantic
   `$ds-status-approval-required` token rather than the generic `$ds-
   status-warning` one, since this state literally IS "still needs an
   approval decision." */
.approval-row.needs-decision {
    border: solid $ds-status-approval-required;
    background: $ds-status-approval-required 10%;
}

/* ConsoleScopePickerModal (rag-scope-narrowing spec §4, Task 8): RAG
   retrieval scope picker -- type tabs, text+tag filters, sort select,
   paginated checkbox list, All/Selected view toggle, bulk select-all/clear
   confirmation, and footer count/Save/Clear/Cancel. Mirrors
   ConsolePromptPickerModal's modal shell (round border, $ds-surface-panel,
   1 2 padding) sized wider/taller for the extra filter/list chrome. */
ConsoleScopePickerModal {
    align: center middle;
}

/* TASK-1775: one Console Prompt Workbench shell, opened only from the
   composer's existing overflow menu. It extends the Chat Context modal's
   dense terminal grammar: a flat header, bounded work region, and stable
   footer. Source, artifact kind, unavailable state, and recovery remain
   text labels; accent color is reserved for focus and the primary Improve
   action. */
ConsolePromptsModal {
    align: center middle;
}

/* The legacy app-wide Checkbox rule fixes every checkbox at width: 100% and
   height: 2, leaving no content row inside Textual's tall border. Keep the
   shared Prompt editor's lane choices intrinsic and paintable. */
PromptBlockEditor #prompt-editor-lane-options Checkbox {
    width: auto;
    height: $ds-size-3;
    margin-bottom: $ds-space-0;
}

/* Internal Prompts settings page */
#internal-prompts-search { width: $ds-width-fill; margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0; }
#internal-prompts-list { height: $ds-height-fill; }
.internal-prompts-group-header { text-style: bold; padding: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0; color: $text-muted; }
.internal-prompt-row { width: $ds-width-fill; height: auto; text-align: left; content-align: left middle; }
.internal-prompt-row.row-customized { border-left: thick $accent; }
.internal-prompt-row.row-default-changed { border-left: thick $warning; }
#internal-prompt-editor-modal { width: $ds-percent-90; max-width: $ds-size-120; height: auto; max-height: $ds-percent-90; padding: $ds-space-1 $ds-space-2; background: $panel; border: thick $primary; }
.internal-prompt-editor-contract { color: $warning; padding: $ds-space-1 $ds-space-0; }
.internal-prompt-editor-chips { color: $text-muted; }
.internal-prompt-editor-applies { color: $text-muted; text-style: italic; }
.internal-prompt-editor-preview { background: $boost; padding: $ds-space-1; height: auto; max-height: $ds-size-12; }
.internal-prompt-editor-error { color: $error; }
.internal-prompt-editor-actions { align-horizontal: right; height: auto; padding: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0; }

ImageGenSettingsPanel Checkbox > .toggle--button {
    color: $ds-surface-panel;
}
ImageGenSettingsPanel Checkbox.-on > .toggle--button {
    color: $success;
}

/* task-2012: css/features/_conversations.tcss ships an UNSCOPED
   `Checkbox { width: 100%; height: 2; }` that clips the ingest option
   panel's checkbox content row to a border-only husk (same escape family
   as the per-ID escapes other screens carry against that rule). The
   container rule kills the panel's trailing phantom height; the label
   rule styles the value-field labels added beside it. */
LibraryIngestCanvas .type-group-contents {
    height: auto;
}
LibraryIngestCanvas .type-group-contents Checkbox {
    width: auto;
    height: auto;
}
LibraryIngestCanvas .type-group-field-label {
    color: $text-muted;
    margin-top: $ds-space-1;
}

/* task-14824 (3): Textual's stock `$text-disabled` placeholder measured
   3.52:1 enabled / 3.49:1 disabled on this canvas. Component-class
   selector because the placeholder is painted by `Input`'s own
   `input--placeholder` component style, which a `color` on the Input
   itself never reaches. Both states are covered: `:disabled` darkens the
   field's background, so the placeholder is re-measured against it. */
LibraryIngestCanvas Input > .input--placeholder,
LibraryIngestCanvas Input:disabled > .input--placeholder {
    color: $ds-text-placeholder;
}

/* task-2014: focus on this canvas was a background-color change only --
   invisible in monochrome and to low-vision users, and it hides the
   job-tick focus-theft (task-2010). DESIGN.md's focus contract is
   `outline: heavy $accent`; outlines draw over the widget's own edge
   cells, so dimensions stay stable. */
LibraryIngestCanvas Input:focus {
    outline: heavy $accent;
}
/* (task-2041) NOT an outline: `outline: heavy` on a 1-row compact button
   draws over the label row, so every focused action button rendered as a
   label-less box -- and the armed "Press again to clear N finished"
   confirm was invisible exactly when it must be read. Reverse video is
   monochrome-visible AND keeps the label. */
LibraryIngestCanvas Button:focus {
    text-style: bold reverse;
}
LibraryIngestCanvas Checkbox:focus {
    outline: heavy $accent;
}
/* task-14824 (1): this rule was DEAD on screen and had been since task-2014.
   `Select` composes an opaque `SelectCurrent` that fills its parent's ENTIRE
   region (its own `border: tall` + `padding: 0 2` make it exactly the
   parent's size), and the compositor paints a child over its parent -- so
   the parent's outline never reached a cell. The "set but painted over by a
   child" family, same as the `Select:disabled SelectCurrent` pair below.
   Note the rule still cannot be verified from `Select.render_lines()`: that
   renders the widget alone, WITHOUT the covering child, and shows the
   outline happily. The test reads the compositor.
   The colour half is kept (it is what a partially-covered Select shows);
   the STRUCTURAL cue moves to the child that is actually on screen. */
LibraryIngestCanvas Select:focus {
    outline: heavy $accent;
}
/* Heavy replaces SelectCurrent's own `tall` border, so the cue is a glyph
   swap (▊▔▎▁ -> ┏━┓┃┗━┛) at identical thickness: no row is consumed (the
   task-3302 trap where a full `outline: heavy` ate a 1-row compact
   control's only row) and the value stays readable inside it. */
LibraryIngestCanvas Select:focus > SelectCurrent {
    border: heavy $ds-input-focus-accent;
}

LibraryIngestCanvas CollapsibleTitle:focus {
    text-style: bold reverse;
}

/* task-2015: at narrow widths the options-panel summary title clipped
   mid-word with no ellipsis, hiding the chunking config entirely. The
   stock CollapsibleTitle is width:auto, so the PARENT clips it before its
   own text-overflow can engage -- constrain the width and pin one line so
   the ellipsis actually renders. */
/* Child combinator for specificity: css/features/_conversations.tcss ships
   an unscoped `Collapsible > CollapsibleTitle { height: 3; }` LATER in the
   bundle -- at equal specificity it won, re-adding two filler rows inside
   every panel title (task-2043). */
LibraryIngestCanvas Collapsible > CollapsibleTitle {
    width: $ds-width-fill;
    height: $ds-size-1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* task-2043: Textual's Collapsible defaults supply the panel filler rows
   (Collapsible padding-bottom: 1 + Contents padding: 1 0 0 3) -- a
   collapsed panel carried ~3 blank rows below its title and an expanded
   one trailed blank rows. Scoped removal; row separation comes from the
   panels' own stacking. */
LibraryIngestCanvas Collapsible {
    padding-bottom: $ds-space-0;
}
LibraryIngestCanvas Collapsible Contents {
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-3;
}

/* task-2100: the app-wide `Collapsible > CollapsibleTitle:focus` rule adds
   a border-bottom that, combined with this canvas's height:1 titles,
   consumed the ONLY row -- a focused panel title rendered as a blank line.
   Reverse video carries focus without costing the row.
   task-3312 (#4): reverse video alone is color-only -- byte-identical
   glyphs, the one focusable the task-3302 structural-focus sweep missed.
   Heavy SIDE rails add the glyph-level cue, same treatment as
   `.library-canvas-action:focus` above: the edge cells land on
   CollapsibleTitle's own `padding: 0 1`, so the ▶/▼ symbol and the title
   text survive, and outline never changes dimensions on focus/blur.
   Declared HERE (child combinator, (0,1,3)) rather than as a descendant
   selector: components/_widgets.tcss ships an app-wide `Collapsible >
   CollapsibleTitle:focus { outline: none; }` LATER in the bundle, which
   at equal (0,1,2) specificity silently discarded the rails (measured --
   `outline_left` stayed the ('', green) default). */
LibraryIngestCanvas Collapsible > CollapsibleTitle:focus {
    border-bottom: none;
    text-style: bold reverse;
    outline-left: heavy $ds-focus-accent;
    outline-right: heavy $ds-focus-accent;
}
/* The collapsed variant needs its own rule: the app-wide
   `Collapsible.-collapsed > CollapsibleTitle:focus` border re-appears at
   (0,2,2) specificity, which outranks the (0,1,3) rule above -- and every
   type-group panel STARTS collapsed. */
LibraryIngestCanvas Collapsible.-collapsed > CollapsibleTitle:focus {
    border-bottom: none;
}

/* task-2130: inline option-validation message -- a TEXT line (never
   color-only; the color is decoration on top of words). Display-managed
   by the screen's option-change handler. */
LibraryIngestCanvas .type-group-field-error {
    /* task-2230 (a11y): $error measured 3.06:1 on this canvas -- an AA
       fail, and LESS readable than ordinary help text at 7.21:1, which
       inverted the importance hierarchy. The readable token measures
       7.71:1 and still reads as an error colour. */
    color: $ds-status-error-readable;
    height: auto;
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-2;
}

/* task-2230 (a11y): the invalid-field border rendered ONLY while focused
   (1.05:1 unfocused = invisible) while the gate line instructed the user
   to "Fix the highlighted options" -- pointing at a highlight that had
   already vanished. Mark the field whenever its value is invalid. */
LibraryIngestCanvas Input.-ingest-option-invalid {
    border: tall $ds-status-error-readable;
}

/* task-2130: the disabled Start-ingest label measured ~1.5:1 against its
   background (round-4 Sam persona) -- readable muted text instead, so a
   keyboard user can find the primary action to learn why it is gated. */
LibraryIngestCanvas Button:disabled {
    /* The TASK-1801 lesson applies verbatim: the visible colour is a STACK
       (_buttons.tcss `opacity: 50%` + `color: $text-disabled` + Textual's
       own disabled dim), so no colour-only override survives it. Neutralise
       the opacity layer and state the colour; the flat background is what
       still says "not ready". */
    opacity: 100%;
    text-opacity: 100%;
    color: $text-muted;  /* 115-gray: 3.15:1 measured live on the canvas bg */
    background: $surface-darken-1;
}

/* task-3304 (MI-07): schema-disabled option FIELDS (Parakeet model folder /
   transcription model under provider "default", web page/depth limits under
   "individual", chunk size/overlap with chunking off) rendered near-
   identically to enabled ones -- their only treatment was Textual's
   app-default `*:disabled:can-focus { opacity: 0.7 }` whole-widget fade,
   the same compounding-dimmer family the Legible Disabled rule
   (TASK-1801/DESIGN.md) exists for. Same recipe as the Button rule above:
   neutralise the fade, state a colour that stays >= 3:1 on its own
   background, and let the darkened surface carry "inert" -- the WHY is a
   text annotation on the field's label (the canvas derives it from the
   schema's gate metadata). App tier on purpose: widget DEFAULT_CSS cannot
   override Textual's own disabled styling (same-tier, widget wins). */
LibraryIngestCanvas Input:disabled,
LibraryIngestCanvas Select:disabled,
LibraryIngestCanvas Checkbox:disabled {
    opacity: 100%;
    text-opacity: 100%;
    color: $text-muted;
    background: $surface-darken-1;
}
/* SelectCurrent paints its own opaque $surface and colours the value via
   its inner `Static#label` -- without these two the Select override above
   never reaches the screen (the "set but painted over by a child" defect
   family from the Watchlists focus round). */
LibraryIngestCanvas Select:disabled SelectCurrent {
    background: $surface-darken-1;
    color: $text-muted;
}
LibraryIngestCanvas Select:disabled SelectCurrent Static#label {
    color: $text-muted;
}

/* task-2130: completion toasts overdrew both canvas bottom-border rows
   (round-4, exact rows pinned by the evidence agent). Same lever as
   task-1562's inspector clearance: the rack's built-in align resists
   app-tier margins, but a margin on the Toast itself reliably offsets it
   from the bottom-right anchor. App-wide by necessity (screen-level
   mount); two rows clears both frame borders. */
Toast {
    margin-bottom: $ds-space-2;
}

/* task-2160: clicking dead text focuses the scroll container itself, and
   its inherited focus decoration painted fragmented blue dashes down the
   pane edges (round-5's "stray blue tick-marks", root-caused in round 6).
   The container keeps keyboard scrollability; its focus stops painting. */
LibraryIngestCanvas:focus {
    border: none;
    outline: none;
}
LibraryIngestCanvas:focus-within {
    border: none;
    outline: none;
}

#notes-sync-body,
#notes-sync-roots-body {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-gutter: stable;
}

#notes-sync-pinned-actions,
#notes-sync-roots-pinned-actions {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    max-height: $ds-size-3;
    background: $surface-darken-1;
}

.notes-sync-conflict-choice.is-selected {
    background: $accent 18%;
    text-style: bold;
}

.notes-sync-conflict-title,
.notes-sync-conflict-path,
.notes-sync-conflict-effect,
.notes-sync-conflict-selected {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    text-wrap: wrap;
    text-overflow: clip;
}

.notes-sync-conflict-path,
.notes-sync-conflict-effect,
.notes-sync-conflict-selected {
    color: $text-muted;
}

.notes-sync-comparison-diff {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-8;
    min-height: $ds-size-4;
    overflow-x: auto;
    overflow-y: auto;
}

.notes-sync-receipt-actions,
.notes-sync-history-actions {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-1;
}

.notes-sync-receipt-actions > Button,
.notes-sync-history-actions > Button {
    min-width: $ds-size-0;
}

.notes-sync-history-page {
    width: auto;
    min-width: $ds-size-6;
    height: $ds-size-1;
    content-align: left middle;
}

ConsoleCapturePolicyDialog,
ConsoleExchangeExportDialog {
    align: center middle;
}

#capture-policy-dialog,
#exchange-export-dialog {
    width: $ds-size-76;
    max-width: $ds-percent-96;
    height: $ds-size-22;
    max-height: $ds-percent-96;
    border: tall $primary;
    background: $surface;
    padding: $ds-space-1 $ds-space-2;
}

#capture-policy-title,
#exchange-export-title {
    height: $ds-size-1;
    text-style: bold;
}

#capture-policy-body,
#exchange-export-body {
    height: $ds-height-fill;
    scrollbar-gutter: stable;
}

#capture-policy-scopes,
#capture-policy-details,
#exchange-export-profiles,
#exchange-export-destinations {
    height: auto;
}

#capture-policy-effective,
#capture-policy-reason,
#capture-policy-count,
#capture-policy-status,
#exchange-export-profile-copy,
#exchange-export-full-reason,
#exchange-export-status {
    height: auto;
}

#capture-policy-reason,
#exchange-export-full-reason {
    color: $warning;
}

#capture-policy-actions,
#exchange-export-actions {
    height: $ds-size-3;
    min-height: $ds-size-3;
    align-horizontal: right;
}

#capture-policy-actions Button,
#exchange-export-actions Button {
    min-width: $ds-size-10;
    margin-left: $ds-space-1;
}

#capture-policy-status.-error,
#exchange-export-status.-error {
    color: $error;
}

#exchange-export-path {
    height: $ds-size-3;
}

/* Buddy transcripts scroll the complete decision card. A 1fr batch body
   inside the auto-height card collapses and clips its controls at 60x20. */
BuddyConversationModal #approval-batch-body {
    height: auto;
}
BuddyConversationModal .approval-row-decision {
    width: $ds-width-fill;
    min-width: $ds-size-10;
}

/* Session-only progress inspection shares the Console modal grammar. */
ConsoleAgentProgressModal { align: center middle; background: $background 60%; }
#agent-progress-dialog { width: $ds-percent-90; max-width: $ds-size-110; height: $ds-percent-85; border: round $primary; background: $panel; padding: $ds-space-1 $ds-space-2; }
#agent-progress-scope, #agent-progress-count, #agent-progress-status { height: auto; margin-bottom: $ds-space-1; }
#agent-progress-scope { color: $ds-text-muted; }
#agent-progress-list { height: $ds-size-5; min-height: $ds-size-3; margin-bottom: $ds-space-1; }
#agent-progress-detail { height: $ds-height-fill; min-height: $ds-size-3; margin-bottom: $ds-space-1; }
#agent-progress-body { height: auto; }
#agent-progress-actions { height: $ds-size-3; align-horizontal: right; }
#agent-progress-actions Button { min-width: $ds-size-10; margin-left: $ds-space-1; }

/* ===== MODULE: components/_workbench.tcss ===== */
/* ========================================
 * COMPONENTS: Workbench
 * ========================================
 * Shared destination workbench frame, command, mode, recovery, pane,
 * state, and density contracts.
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


.workbench-frame {
    width: $ds-width-full;
    height: $ds-height-full;
    min-height: $ds-size-0;
    layout: vertical;
    overflow: hidden;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.workbench-header {
    height: auto;
    min-height: $ds-size-2;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.workbench-header-title {
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-style: bold;
}

.workbench-header-subtitle {
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $ds-text-muted;
}

.workbench-header.has-empty-subtitle .workbench-header-subtitle {
    display: none;
}

.workbench-header-status {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
}

/* task-523: red cue when the Roleplay Console handoff provider is unready.
   `status-blocked` lands on the DestinationHeader (#personas-header); the
   badge word is the child #workbench-header-status (also .ds-status-badge,
   whose app-tier `color: $ds-text-primary` this id+class+descendant selector
   outranks so the "Blocked" word actually turns red). */
#personas-header.status-blocked .workbench-header-status {
    color: $ds-status-blocked;
}

/* Resume is briefly disabled while Roleplay dispatches exact typed navigation.
   Neutralize the generic opacity stack and keep the busy label readable while
   the raised surface and dim treatment still distinguish the disabled state. */
#personas-conversation-resume:disabled {
    opacity: 100%;
    text-opacity: 100%;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: none;
}

/* App-tier console-action classes are one-line by default. The preview's
   explicit three-row control stack needs three-line hit targets. */
#personas-conversation-resume,
#personas-conversation-continue-console,
#personas-conversation-back,
#personas-conversation-open-library,
#personas-conversation-back-source {
    height: $ds-size-3;
    min-height: $ds-size-3;
}

#personas-conversations-search {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
    border: none;
}

/* At the 52x20 floor the saved-chat preview owns the single pane. Keep full
   action labels and transcript rows visible instead of spending its cells on
   the separate test-chat toggle, collapsed rails and nested panel border. */
#personas-workbench.personas-workbench-narrow.personas-transcript-active #personas-preview-pane {
    display: none;
}

#personas-workbench.personas-workbench-narrow.personas-transcript-active #personas-work-area {
    border: none;
    padding: $ds-space-0;
}

#personas-workbench.personas-workbench-narrow.personas-transcript-active #personas-conversation-navigation-actions {
    layout: vertical;
}

#personas-workbench.personas-workbench-narrow.personas-transcript-active .personas-conversation-navigation-action {
    width: $ds-width-full;
    padding: $ds-space-0;
}

.workbench-command-strip,
.workbench-mode-strip {
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    layout: horizontal;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.workbench-action,
.workbench-mode {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

.workbench-action {
    padding: $ds-space-0 $ds-space-1;
}

.workbench-action.is-primary {
    text-style: bold;
}

/* TASK-1801: this bar stacked THREE dimmers and measured 1.45:1 live --
   `$ds-text-disabled` is an alpha token (~38%), `.is-disabled` adds
   `opacity: 0.55`, and Textual's Button:disabled adds `text-style: bold dim`
   plus `color: auto 50%`. None of that is visible from any single rule.

   Note the class: this bar uses `is-disabled`, NOT `console-action-disabled`.
   An earlier edit to the latter measured no change at all and was reverted
   rather than shipped unverified.

   Neutralising the opacity layer and stating the colour bright enough to
   survive Textual's halving (which `text-style: none` does NOT clear --
   verified by measuring the running app) gets this to ~3.6:1. This bar's
   background is lighter than the composer menu's near-black, so 4.5:1 is
   not reachable while `dim` still halves the result; DESIGN.md states 3:1
   as the floor for disabled controls for exactly this reason. */
.workbench-action.is-disabled {
    color: rgb(245,245,245);
    opacity: 1;
    text-style: none;
}

.workbench-mode {
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
}

.workbench-mode.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

.workbench-recovery-callout {
    height: auto;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    border: solid $ds-status-warning;
    background: $ds-status-warning 10%;
    color: $ds-text-primary;
}

.workbench-recovery-callout.is-hidden {
    display: none;
}

.workbench-recovery-title {
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-style: bold;
}

.workbench-recovery-body {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-primary;
}

.workbench-recovery-action {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

.workbench-pane-region {
    height: $ds-height-fill;
    min-height: $ds-size-0;
    layout: horizontal;
    overflow: hidden;
}

.workbench-pane {
    width: $ds-width-fill;
    height: $ds-height-fill;
    min-width: $ds-size-0;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

.workbench-pane.is-collapsed {
    width: $ds-size-3;
    min-width: $ds-size-3;
}

.workbench-pane-title,
.workbench-pane-status {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

.workbench-pane-title {
    text-style: bold;
}

.workbench-state-block {
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    layout: horizontal;
    background: $ds-surface-raised;
    color: $ds-text-muted;
}

.workbench-state-route,
.workbench-state-density {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

.workbench-frame .status-ready {
    border-title-color: $ds-status-ready;
}

.workbench-frame .status-running,
.workbench-frame .status-loading {
    border-title-color: $ds-status-running;
}

.workbench-frame .status-blocked,
.workbench-frame .status-error {
    border-title-color: $ds-status-error;
}

.workbench-frame .status-paused,
.workbench-frame .status-empty {
    border-title-color: $ds-status-warning;
}

.density-normal .workbench-header {
    min-height: $ds-size-2;
    padding: $ds-space-0 $ds-space-1;
}

.density-normal .workbench-pane {
    padding: $ds-space-1;
}

.density-compact .workbench-header {
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}

.density-compact .workbench-header-subtitle {
    display: none;
}

.density-compact .workbench-pane {
    padding: $ds-space-0 $ds-space-1;
}

/* task-31825: the auto height trigger, distinct from `.density-compact`
   above (the user's own global density preference, and on Console an
   inner `#console-shell` wrapper it manages itself -- reusing that class
   name here would let the two signals fight over the same selector).
   `BaseAppScreen.VERTICAL_BREAKPOINTS` puts `shell-header-compact` on the
   screen itself at/below the 24-row floor (task-31419's 80x24
   measurement), so any `.workbench-header` under it -- every plain
   DestinationHeader caller, with no per-screen CSS of its own -- picks up
   the same compact geometry `.density-compact` already declares. A screen
   with its own higher-specificity override (Console's `#console-workbench-
   header.console-header-inline`, Lab's `.lab-header-inline`, Research
   Workspace's `#research-workspace-header .workbench-header`) keeps its
   existing shape unchanged, same as it does against `.density-compact`
   today. */
.shell-header-compact .workbench-header {
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}

.shell-header-compact .workbench-header-subtitle {
    display: none;
}

/* task-1232 round 1 (fleet-UX expert review F2, Critical fix): the F1 help
   overlay used to be a bare, unstyled Vertical -- Textual's own defaults
   (height: 1fr, overflow: hidden hidden) silently clipped anything past the
   fold with no scrollbar. Mirrors ConsoleScopePickerModal's bounded-panel +
   scrollable-body + pinned-footer shape (_agentic_terminal.tcss
   #console-scope-picker-modal / #console-scope-picker-list). */
WorkbenchHelpPanel {
    align: center middle;
}

#workbench-help-panel {
    width: $ds-size-76;
    max-width: $ds-percent-95;
    height: auto;
    max-height: $ds-percent-90;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    padding: $ds-space-1 $ds-space-2;
}

#workbench-help-scroll {
    height: $ds-height-fill;
    min-height: $ds-size-3;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

#workbench-help-body {
    width: $ds-width-full;
    height: auto;
}

#workbench-help-close {
    width: auto;
    height: auto;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

/* ===== MODULE: components/_widgets.tcss ===== */
/* ========================================
 * COMPONENTS: Widgets
 * ======================================== 
 * Miscellaneous reusable widgets
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales + named
   \$ds-widgets-skeleton-title-share), transcribed value-identically from
   the raw literals; comments stay load-bearing. */


/* Collapsible widget styling with enhanced UX */
Collapsible {
    height: auto;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: round $surface-lighten-1;
    background: $surface;
}

/* NOTE: Textual's Collapsible title is the CollapsibleTitle widget type --
 * there is no ".collapsible--header" component class on this Textual
 * version (8.2.7). Rules keyed on that dead class never matched anything,
 * so a focused title fell through to Textual's own CollapsibleTitle:focus
 * default (a background/foreground pairing derived from the theme that can
 * render as an unreadable solid block against this app's palette). Target
 * the real widget type so the app's own focus treatment applies.
 *
 * I2 (SP3 final review): that selector rename alone made this file's
 * decorative Collapsible styling (height/background/padding/hover/
 * border-bottom below) apply to EVERY Collapsible app-wide (~35 screens) for
 * the first time -- pre-fix, the dead ".collapsible--header" selector meant
 * NONE of it (not even :focus) ever actually applied anywhere. Only the
 * Library/RAG settings screen was visually QA'd against the new appearance
 * (Docs/superpowers/qa/rag-settings-sp3-2026-07/). So only the genuinely
 * app-wide bug -- an invisible focused title -- stays global here; the
 * decorative restyle is scoped to the Library/RAG card further down, so
 * every other screen's Collapsibles keep their pre-fix appearance. */
Collapsible > CollapsibleTitle:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border-bottom: solid $ds-focus-accent;
    outline: none;
}

Collapsible.-collapsed > CollapsibleTitle:focus {
    border-bottom: solid $ds-focus-accent;
}

/* Settings-scoped decorative restyle: only the Library/RAG card's
 * Collapsible groups (Search/Embedding/Chunking/Vector store/Reranking)
 * were captured and reviewed against this height/background/padding/hover/
 * border treatment -- see the QA captures referenced above. */
#settings-library-rag-card Collapsible > CollapsibleTitle {
    height: $ds-size-2;
    min-height: $ds-size-2;
    padding: $ds-space-0 $ds-space-1;
    background: $surface-lighten-1;
    color: $text;
    border-bottom: solid $border;
}

#settings-library-rag-card Collapsible > CollapsibleTitle:hover {
    background: $surface;
    color: $text;
}

#settings-library-rag-card Collapsible.-collapsed > CollapsibleTitle {
    border-bottom: none;
}

/* An ID-qualified selector outranks a plain-type :focus selector in
 * Textual's (id, class, type) specificity model (textual/css/model.py's
 * SelectorSet._total_specificity sums each tier separately and compares
 * id first) -- so the two scoped rules above would otherwise beat the
 * GLOBAL :focus rules near the top of this block for a title that is both
 * inside this card AND focused, reintroducing the invisible-focused-title
 * bug scoped to just Library/RAG. Restate the focus treatment at matching
 * (ID-qualified) specificity so it still wins here, exactly as it did
 * before this rule was scoped. */
#settings-library-rag-card Collapsible > CollapsibleTitle:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border-bottom: solid $ds-focus-accent;
    outline: none;
}

#settings-library-rag-card Collapsible.-collapsed > CollapsibleTitle:focus {
    border-bottom: solid $ds-focus-accent;
}

Collapsible > Contents {
    height: auto;
    padding: $ds-space-1;
    background: $surface;
}

/* Half height for RAG Settings collapsible header */
#chat-rag-panel > .collapsible--header,
#character-rag-panel > .collapsible--header {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

/* Fix for settings collapsibles in sidebars */
.settings-collapsible {
    height: auto !important;
    min-height: $ds-size-3 !important;
}

.settings-collapsible > Contents {
    height: auto !important;
    padding: $ds-space-1;
}

/* Ensure controls inside collapsibles are visible */
.settings-collapsible Checkbox {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.settings-collapsible Toggle {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.chat-system-prompt-styling {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-3;
    max-height: $ds-size-10; /* Limit height */
    border: round $surface;
    margin-bottom: $ds-space-1;
}

/* --- Window Footer Widget --- */

/* KEEP IN SYNC with AppFooterStatus.DEFAULT_CSS (task-264): the widget
   bakes the core layout rules (dock/height/background, #footer-key-quit,
   #footer-spacer, #internal-db-size-indicator) in for stylesheet-less
   harnesses; edits HERE (the live bundle source -- built into
   tldw_cli_modular.tcss) must be mirrored there or harness geometry
   silently diverges from production. */
AppFooterStatus {
    dock: bottom;
    height: $ds-size-1;  /* Single row height */
    background: $primary-background-darken-1;
    width: $ds-width-full;
    layout: horizontal;
    padding: $ds-space-0 $ds-space-1;
    /* Removed align: right middle; from parent, will control children individually */
}

#footer-key-palette {
    width: auto;
    padding: $ds-space-0 $ds-space-1; /* Padding around each key binding */
    color: $text-muted;
    dock: left; /* Dock key bindings to the left */
    visibility: visible;
    display: initial;
}

#footer-key-quit {
    width: auto;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1; /* Padding around each key binding */
    color: $text-muted;
    dock: left; /* Dock key bindings to the left */
}

#footer-spacer {
    width: $ds-width-fill; /* Takes up remaining space in the middle */
    height: $ds-size-1;
}

#footer-word-count {
    width: auto;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    color: $text-muted;
    display: block;
}

#footer-token-count {
    width: auto;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    color: $text-muted;
    display: block;
}

#internal-db-size-indicator { /* This is for the DB sizes */
    width: auto;
    height: $ds-size-1;
    /* content-align: right; Textual doesn't have content-align for Static directly */
    /* dock: right; Docking within Horizontal might be tricky, align on parent is better */
    color: $text-muted;
    dock: right; /* Dock DB sizes to the right */
    padding: $ds-space-0 $ds-space-1; /* Add padding to the right of DB sizes as well */
    margin-left: $ds-space-2; /* Add buffer before DB status */
}
/* --- End of Window Footer Widget --- */

/* --- Loading States --- */
.loading-state-container {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-10;
}

.loading-view {
    align: center middle;
    padding: $ds-space-2;
}

.loading-text {
    margin-top: $ds-space-1;
    color: $text-muted;
}

.error-view {
    align: center middle;
    padding: $ds-space-2;
    background: $error 10%;
    border: round $error;
}

.error-icon {
    color: $error;
    text-style: bold;
}

.error-message {
    margin: $ds-space-1 $ds-space-0;
    color: $error;
    text-align: center;
}

.error-actions {
    margin-top: $ds-space-1;
    align: center middle;
}

.error-actions Button {
    margin: $ds-space-0 $ds-space-1;
}

/* Skeleton loader styles */
.skeleton-container {
    width: $ds-width-full;
    padding: $ds-space-1;
}

.skeleton-avatar {
    width: $ds-size-8;
    height: $ds-size-4;
    background: $surface-lighten-2;
    border: round $surface-lighten-2;
}

.skeleton-title {
    width: $ds-widgets-skeleton-title-share;
    height: $ds-size-1;
    background: $surface-lighten-2;
    margin-bottom: $ds-space-1;
}

.skeleton-subtitle {
    width: $ds-percent-40;
    height: $ds-size-1;
    background: $surface-lighten-1;
}

.skeleton-line {
    height: $ds-size-1;
    background: $surface-lighten-1;
    margin-bottom: $ds-space-1;
}

.skeleton-line-full {
    width: $ds-width-full;
}

.skeleton-line-90 {
    width: $ds-percent-90;
}

.skeleton-line-80 {
    width: $ds-percent-80;
}

.skeleton-line-70 {
    width: $ds-percent-70;
}

/* Skeleton loader visual indication */
.skeleton-line,
.skeleton-avatar,
.skeleton-title,
.skeleton-subtitle {
    opacity: 70%;
}

/* Inline loader states */
InlineLoader.loading {
    color: $primary;
}

InlineLoader.success {
    color: $success;
}

InlineLoader.error {
    color: $error;
}

/* --- End of Loading States --- */

/* Focus-state rules relocated from widget-local CSS (TASK-16811): each
   needs the bundle's $ds-* focus tokens, and the local `$var:` fallbacks
   that used to accompany them shadowed the real values per CSS source. */
EmojiButton.emoji_button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

PathBreadcrumbs .breadcrumb-button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

BaseTamagotchi:focus {
    border: round $ds-focus-accent;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

ChatbooksWindowImproved .search-input:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

/* ===== MODULE: components/stats_screen.css ===== */
/* Statistics Screen Styling */

/* Main container */
#stats-container {
    background: $surface;
    height: 100%;
    width: 100%;
    padding: 1;
}

/* Header */
.stats-header {
    text-align: center;
    text-style: bold;
    background: $primary-background-lighten-2;
    color: $text;
    padding: 1 2;
    margin-bottom: 1;
    border: solid $primary;
}

/* Scrollable content */
#stats-scroll {
    height: 100%;
    background: $surface;
}

#stats-content {
    padding: 0 2;
    height: auto;
}

/* Section headers */
.section-header {
    text-style: bold;
    color: $primary;
    margin-top: 2;
    margin-bottom: 1;
    padding-left: 1;
    border-left: thick $primary;
}

.subsection-header {
    color: $text-muted;
    margin: 1 0;
    padding-left: 2;
}

/* Grid layouts */
.stats-grid {
    layout: grid;
    grid-size: 2 2;
    grid-gutter: 1 1;
    margin-bottom: 1;
    height: auto;
    grid-rows: auto;
}

.stats-grid.overview-grid {
    grid-size: 2 2;
}

.stats-grid.activity-grid {
    grid-size: 2 2;
}

.stats-grid.prefs-grid {
    grid-size: 2 2;
}

.stats-grid.ranges-grid {
    grid-size: 2 2;
}

.stats-grid.fun-grid {
    grid-size: 2 2;
}

/* Stat Card Component */
StatCard {
    background: $panel;
    border: solid $border;
    height: auto;
    min-height: 6;
    padding: 1;
}

StatCard:hover {
    background: $primary-background-lighten-1;
    border: solid $primary;
}

.stat-card-inner {
    layout: vertical;
    align: center middle;
    width: 100%;
    height: auto;
}

.stat-card-icon {
    text-align: center;
    text-style: none;
    margin-bottom: 0;
}

.stat-card-title {
    text-align: center;
    color: $text-muted;
    text-style: none;
    margin-bottom: 0;
}

.stat-card-value {
    text-align: center;
    text-style: bold;
    color: $primary;
    margin: 0;
}

.stat-card-subtitle {
    text-align: center;
    color: $text-disabled;
    text-style: italic;
    margin-top: 0;
}

/* Topic Bar Component */
.topic-bar-container {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    align: left middle;
}

.topic-label {
    min-width: 20;
    text-align: left;
    color: $text;
}

.topic-bar-bg {
    width: 1fr;
    height: 1;
    background: $surface-lighten-1;
    margin-left: 1;
}

.topic-bar-fill {
    height: 1;
    background: $primary;
    transition: width 500ms;
}

/* Topics container */
.topics-container {
    background: $panel;
    border: solid $border;
    padding: 1;
    margin-bottom: 1;
    height: auto;
}

/* Topic range cards */
.topic-range-card {
    height: auto;
    min-height: 4;
}

.topic-range-card .stat-card-value {
    text-style: none;
}

/* Character stats */
.character-stats-container {
    background: $panel;
    border: solid $border;
    padding: 1;
    margin-bottom: 1;
    height: auto;
}

.character-total {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.character-item {
    padding: 0 1;
    margin-bottom: 1;
}

.character-name {
    text-style: bold;
    color: $text;
}

.character-stats {
    color: $text-muted;
    text-style: italic;
    padding-left: 2;
}

/* Loading states */
.loading-container {
    align: center middle;
    height: 20;
}

.loading-text {
    margin-top: 2;
    color: $text-muted;
}

/* Error states */
.error-container {
    align: center middle;
    padding: 4;
}

.error-message {
    color: $error;
    text-style: bold;
    margin-bottom: 2;
}

.retry-button {
    margin-top: 1;
}

/* No data message */
.no-data-message {
    text-align: center;
    color: $text-muted;
    padding: 4;
}

/* Note: Textual doesn't support media queries
   Grid will automatically adjust based on available space */

/* ===== MODULE: components/_settings_splash_theme.tcss ===== */
/* Settings splash-screen viewer + theme editor styles.
 *
 * TASK-394: this module previously also carried the OLD (pre-Settings) splash
 * viewer's generic component styles -- bare `VerticalScroll` plus app-wide class
 * names (.setting-label, .section-header, .help-text, .action-buttons,
 * .settings-section, .card-list, .preview-*). Those either leaked app-wide or
 * were dead. The genuinely shared ones moved verbatim to
 * `components/_shared_components.tcss` (same bundle position -> unchanged
 * cascade); the app-wide scrollbar default moved to `core/_base.tcss`; the
 * zero-importer orphans were removed. What remains below is the LIVE, feature-
 * scoped styling for the in-Settings theme editor and splash-screen viewer
 * (`settings_theme_editor.py`, `settings_splash_screen_viewer.py`). */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


/* ===== Settings theme editor ===== */
#settings-theme-tree {
    width: $ds-width-full;
    height: $ds-size-12;
    min-height: $ds-size-8;
    border: solid $ds-grid-line;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

/* TASK-31259: the preview is a Console-shaped stub whose rows are painted from
   the palette being edited (see SettingsThemeEditor._refresh_preview), so it
   follows every keystroke instead of the applied app theme. */
.settings-theme-preview {
    width: $ds-width-full;
    height: auto;
    margin: $ds-space-1 $ds-space-0;
    border: solid $ds-grid-line;
}

.settings-theme-preview-row {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
}

/* TASK-31254: a 1-row Static with `border: solid` paints only its top border
   glyphs -- the hex text (and the "invalid" label) never had a content row.
   No border; the colour IS the swatch and the text sits on it. */
.color-swatch {
    width: $ds-size-9;
    min-width: $ds-size-9;
    height: $ds-size-1;
    min-height: $ds-size-1;
    border: none;
    content-align: center middle;
    text-style: bold;
}

.color-preset-swatch {
    width: $ds-size-3;
    min-width: $ds-size-3;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    border: none;
}

/* task-1369: preset swatches are keyboard-activatable (focusable + Enter/
   Space), so they need a visible focus indicator. An outline paints over the
   swatch's own cells without needing a border row, so the colour stays
   visible (TASK-31254). */
.color-preset-swatch:focus {
    outline: solid $ds-focus-accent;
    text-style: bold;
}

/* TASK-31254: escape the app-wide `Checkbox { height: 2 }` + tall border that
   leaves zero content rows (the TASK-18960 family; same idiom as
   `.settings-imagegen-backend-row Checkbox`). One row: glyph + On/Off label. */
#settings-theme-dark-mode {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-bottom: $ds-space-0;
    border: none;
    padding: $ds-space-0;
}
#settings-theme-dark-mode > .toggle--button {
    color: $ds-surface-panel;
}
#settings-theme-dark-mode.-on > .toggle--button {
    color: $success;
}


/* TASK-31279: below SETTINGS_COMPACT_WORKBENCH_MAX_WIDTH (100 cols) the
   detail pane is ~45 cells; four 16-cell-minimum buttons cannot share a row,
   so the library and action rows stack and each button takes the width. */
#settings-workbench.settings-workbench-compact #settings-theme-card .settings-action-row {
    layout: vertical;
    height: auto;
}
#settings-workbench.settings-workbench-compact #settings-theme-card .theme-editor-action {
    width: $ds-width-full;
}

/* ===== Settings splash screen viewer ===== */
.settings-splash-gallery {
    height: $ds-size-24;
    min-height: $ds-size-16;
    width: $ds-width-full;
}

#settings-splash-card-list {
    width: $ds-percent-45;
    height: $ds-height-full;
    border: solid $primary-lighten-2;
}

#settings-splash-preview-scroll {
    width: $ds-width-fill;
    height: $ds-height-full;
    border: solid $primary-lighten-2;
    background: $surface;
}

.settings-splash-preview {
    width: $ds-width-full;
    height: $ds-height-full;
}

.settings-splash-preview #splash-display {
    width: $ds-width-full;
    height: $ds-height-full;
}

/* ===== MODULE: components/_settings_personal_context.tcss ===== */
/* Canonical Settings > My Profile. Dense, text-labelled, narrow-safe controls. */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


#personal-context-settings-panel {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    padding: $ds-space-0 $ds-space-1 $ds-space-1 $ds-space-1;
}

#personal-context-status {
    width: auto;
    height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    text-style: bold;
}

.personal-context-toolbar {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-gutter: 0 1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.personal-context-toolbar Button {
    width: $ds-width-full;
    min-width: $ds-size-0;
    margin: $ds-space-0;
}

.personal-context-scope-row {
    height: auto;
    min-height: $ds-size-3;
}

.personal-context-scope-row Select {
    width: $ds-width-fill;
    min-width: $ds-size-12;
}

#personal-context-record-list {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    max-height: $ds-size-10;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.personal-context-record-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-3;
    margin: $ds-space-0;
    text-align: left;
}

.personal-context-record-selected {
    border-left: thick $accent;
}

#personal-context-editor {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    margin: $ds-space-1 $ds-space-0;
}

#personal-context-editor Input,
#personal-context-editor Select {
    width: $ds-width-full;
    min-width: $ds-size-0;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#personal-context-editor-error {
    color: $error;
    height: auto;
    min-height: $ds-size-1;
}

RecoveryPassphraseDialog {
    align: center middle;
}

#personal-context-recovery-dialog {
    width: $ds-size-60;
    max-width: $ds-percent-92;
    height: auto;
    padding: $ds-space-1 $ds-space-2;
    border: thick $accent;
    background: $surface;
}

#personal-context-recovery-dialog Input {
    width: $ds-width-full;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#personal-context-recovery-dialog .button-container {
    width: $ds-width-full;
    height: auto;
    align: center middle;
}

#settings-workbench.settings-workbench-compact #personal-context-settings-panel {
    padding: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#settings-workbench.settings-workbench-compact .personal-context-toolbar {
    grid-size: 1;
    grid-columns: 1fr;
    grid-gutter: 0;
}

#settings-workbench.settings-workbench-compact .personal-context-scope-row {
    layout: vertical;
}

#settings-workbench.settings-workbench-compact .personal-context-scope-row .settings-input-label,
#settings-workbench.settings-workbench-compact .personal-context-scope-row Select {
    width: $ds-width-full;
}

/* ===== MODULE: components/_profile_interview.tcss ===== */
/* Personal Context interview and deterministic final review. */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales + named
   \$ds-profile-link-modal-* geometry), transcribed value-identically from
   the raw literals; comments stay load-bearing. */


ProfileInterviewScreen,
ProfileInterviewCancelModal,
PersonalContextReviewModal,
PersonalContextProposalReviewModal,
PersonalContextLinkModal {
    align: center middle;
    background: $background 70%;
}

#profile-interview-shell,
#personal-context-review-modal,
#personal-context-link-modal,
#profile-interview-cancel-modal {
    min-width: $ds-size-0;
    border: round $surface-lighten-2;
    background: $panel;
    padding: $ds-space-1 $ds-space-2;
}

#profile-interview-shell {
    width: $ds-size-76;
    max-width: $ds-percent-96;
    height: $ds-size-22;
    max-height: $ds-percent-96;
}

#personal-context-review-modal {
    width: $ds-size-96;
    max-width: $ds-percent-96;
    height: $ds-percent-90;
    max-height: $ds-size-30;
}

#personal-context-link-modal {
    width: $ds-profile-link-modal-cols;
    max-width: $ds-percent-96;
    height: $ds-profile-link-modal-body-share;
    max-height: $ds-size-28;
}

#profile-interview-cancel-modal {
    width: $ds-size-64;
    max-width: $ds-percent-92;
    height: auto;
    min-height: $ds-size-14;
}

.profile-interview-title {
    width: $ds-width-full;
    height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $accent;
    text-style: bold;
}

.profile-interview-disclosure,
.profile-interview-state,
.profile-interview-progress,
.profile-interview-copy {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.profile-interview-disclosure,
.profile-interview-progress,
.profile-interview-copy {
    color: $text-muted;
}

.profile-interview-state {
    background: $surface;
    padding: $ds-space-0 $ds-space-1;
}

#profile-interview-body,
#personal-context-review-list,
#personal-context-link-review-list {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-height-fill;
}

.personal-context-link-decision-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    background: $surface;
}

.profile-interview-question {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-2;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    text-style: bold;
}

.profile-interview-error,
.personal-context-review-warning {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    color: $warning;
    background: $warning 10%;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#profile-interview-answer,
.personal-context-review-row Input,
.personal-context-review-row Select,
.personal-context-proposal-field {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-3;
    border: none;
    border-left: solid $surface-lighten-2;
    background: $surface-darken-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#profile-interview-answer:focus,
.personal-context-review-row Input:focus,
.personal-context-review-row Select:focus,
.personal-context-proposal-field:focus {
    border-left: thick $accent;
    background: $accent 10%;
    text-style: bold;
}

.profile-interview-actions {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-gutter: 0 1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.profile-interview-actions Button {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-3;
    margin: $ds-space-0;
}

.profile-interview-cancel-actions {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-3;
}

.profile-interview-cancel-actions Button {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-3;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

.personal-context-review-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    border-bottom: solid $surface-lighten-1;
    padding: $ds-space-0 $ds-space-1 $ds-space-1 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.personal-context-review-row Checkbox {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-3;
    text-style: bold;
}

.personal-context-review-row Button {
    width: $ds-width-full;
    min-width: $ds-size-0;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* ===== MODULE: components/_shared_components.tcss ===== */
/* Shared UI component styles.
 *
 * TASK-394: these generic, app-wide component classes (used across settings
 * forms, previews, eval/dataset/coderepo panels, etc.) previously lived in
 * `components/_settings_splash_theme.tcss` -- a feature module whose bare
 * definitions leaked and, worse, disguised their app-wide reach. They are moved
 * here verbatim, at the SAME bundle position (right after the splash/theme
 * module), so the effective cascade is unchanged while the splash module stops
 * owning generic component styles. (Consolidating these with the other bare
 * duplicate definitions scattered across feature modules is a larger,
 * out-of-scope cleanup; this move only relocates the splash module's copies.)
 */

/* Scrollable card / preview lists */
.card-list {
    height: 1fr;
    scrollbar-size: 1 1;
}

/* Preview panels shared by settings, coderepo, dataset, eval, chunk previews */
.preview-panel {
    width: 1fr;
    height: 100%;
    border: solid $primary;
    padding: 1;
}

.preview-container {
    width: 1fr;
    layout: vertical;
    border: solid $primary;
    padding: 1;
}

.preview-content {
    padding: 1;
    text-align: center;
}

/* Settings form components */
.settings-section {
    height: auto;
    padding: 1;
    margin-top: 1;
    border-top: solid $primary;
}

.help-text {
    text-style: italic;
    color: $text-muted;
    padding: 0 0 1 0;
    text-align: center;
}

/* Action button rows */
.action-buttons {
    height: 3;
    layout: horizontal;
    align: center middle;
    padding: 1;
    margin-top: 1;
}

.action-buttons Button {
    margin: 0 1;
}

/* Generic window heading. Relocated from features/_ingest_tldw_api_tabs.tcss
   when that sheet was retired with the standalone ingest window (task-745):
   the rule is unscoped and was the ONLY bundled definition of .window-title,
   while ChatbookExportManagementWindow, ChatbookTemplatesWindow and
   Voice_Cloning_Window all mount it. Deleting the sheet without moving this
   would have silently unstyled three live windows. */
.window-title {
    text-style: bold;
    text-align: center;
    padding: 1 0;
    background: $primary;
    color: $text;
}

/* Relocated from features/_search-rag.tcss (RAG UX v2 PR-2 Task 2) when that
   sheet was retired: both rules are unscoped and were the ONLY bundled
   definitions of their class, while CodeRepoCopyPasteWindow (.action-spacer)
   and MediaViewerPanel (.param-group) still mount them. Deleting the sheet
   without moving these would have silently unstyled both live widgets. */
.action-spacer {
    width: 1fr;
}

.param-group {
    width: 1fr;
}

/* ===== MODULE: features/_console.tcss ===== */
/* ========================================
 * FEATURES: Console (terminal surface)
 * ========================================
 * ADR-161 task 10: the console-* terminal-surface vocabulary -- shell,
 * workspace tree/grid, rails, transcript region, composer, session tabs,
 * status/citations -- extracted from components/_agentic_terminal.tcss
 * and tokenized on arrival. Bundle-resident by design: the generated
 * console split sheet always rode the boot parse (TldwCli.CSS_PATH loads
 * it eagerly because the Console is the initial tab), so the split
 * indirection was dropped (task-10-report.md section 2) and these bytes
 * ride the bundle directly. Panel vocabulary (inspector/staged/prompts/
 * activity/scope/settings panes) lives in features/_console_panels.tcss.
 * ======================================== */


#console-style-picker-modal {
    width: $ds-size-76;
    max-width: $ds-percent-95;
    height: auto;
    max-height: $ds-percent-85;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: $ds-space-1 $ds-space-2;
}

#console-style-picker-filter {
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-style-picker-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

#console-style-picker-results {
    height: auto;
    max-height: $ds-size-20;
    min-height: $ds-size-0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

.console-style-picker-row {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-style-picker-row-highlighted {
    border: tall $ds-action-focus;
    background: $ds-input-focus-bg;
    text-style: bold;
}

#console-style-picker-empty {
    height: auto;
    margin: $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

#console-style-picker-detail {
    height: auto;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-muted;
}

/* The mic button stays real-clickable (never Textual `disabled`) while
   dictation is unavailable -- a genuinely disabled widget can never be
   pressed again, which would remove the only re-probe trigger that exists
   (task-15). Dimming here restores the *appearance* of disabled, carried
   before by `disabled`'s own styling, without the *semantics*: the tooltip
   alone is not enough, since it is invisible to anyone who does not hover,
   and to the rendered terminal text a screen reader would read. */
.console-dictation-unavailable {
    text-opacity: 60%;
}

/* Console's runtime frame (_frame_console_region) is the single border
   source for .console-region; no CSS border here to avoid a doubled frame. */
.console-region {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-height-full;
    min-height: $ds-size-0;
    padding: $ds-space-1;
    background: $ds-surface-panel;
}

#console-workspace-grid {
    height: $ds-console-workspace-grid-height;
    min-height: $ds-size-20;
    padding: $ds-space-0;
    margin: $ds-space-0;
    overflow: hidden;
    border-top: solid $ds-grid-line;
    border-bottom: solid $ds-grid-line;
    background: $ds-surface-panel;
}

#console-control-bar {
    height: auto;
    min-height: $ds-size-1;
    max-height: $ds-size-2;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    border: none;
    background: $ds-surface-panel;
    overflow: hidden;
}

.console-control-chip-row,
.console-control-action-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    layout: horizontal;
    align: left middle;
}

#console-auto-speak-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    layout: horizontal;
    align: left middle;
}

#console-speech-controls,
#console-auto-speak-control,
#console-hands-free-control {
    width:auto;height:$ds-size-1;min-height:$ds-size-1;max-height:$ds-size-1;layout:horizontal;align:left middle;
}

#console-speech-controls {margin:$ds-space-0 $ds-space-2 $ds-space-0 $ds-space-0;}

#console-auto-speak-label,
#console-hands-free-label {width:auto;height:$ds-size-1;margin-right:$ds-space-1;}

#console-auto-speak,
#console-hands-free-switch {
    width:$ds-size-5;min-width:$ds-size-5;max-width:$ds-size-5;height:$ds-size-1;min-height:$ds-size-1;max-height:$ds-size-1;
    padding:$ds-space-0;margin:$ds-space-0;border:none;
}

#console-auto-speak {margin-right:$ds-space-1;}

#console-auto-speak-retry,
#console-auto-speak-resume {
    width:auto;height:$ds-size-1;min-height:$ds-size-1;max-height:$ds-size-1;margin:$ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

#console-status-chips {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    layout: horizontal;
    border: none;
    padding: $ds-space-0 $ds-space-1;
    /* TASK-17650: cancel .ds-panel's bottom margin — it rendered as a
       permanent blank row between the chips and the footer. */
    margin: $ds-space-0;
}

/* TASK-15704: both mounted presentations stay one row high. The fixed restore
   control leads; the copy or scroll viewport consumes only the remaining
   width, so neither can push past the strip at narrow terminal sizes. */
#console-status-expanded,
#console-status-collapsed {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    layout: horizontal;
    align: left middle;
}

/* TASK-2154.5 (LY-03): expanded chip overflow scrolls horizontally (focus
   auto-scroll for keyboard, Shift+wheel / trackpad swipe for mouse) instead
   of silently clipping later chips. The scrollbar itself is hidden because
   the inner viewport is a single row -- same contract as the native tab
   strip. */
#console-status-chip-scroll {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    layout: horizontal;
    overflow-x: auto;
    overflow-y: hidden;
    border: none;
    padding: $ds-space-0;
    scrollbar-size-horizontal: 0;
}

#console-status-collapse,
#console-status-expand {
    width: $ds-size-9;
    min-width: $ds-size-9;
    max-width: $ds-size-9;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    border: none;
    padding: $ds-space-0;
}

#console-status-collapsed-copy {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $ds-text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.console-control-chip {
    width: auto;
    /* RAG-46: a ~10x1-cell hit target is easy to miss with mouse/touch. Raised
       from 7 to 12 (min-width) and the horizontal padding from `0 1` to `0 2`
       to widen both the box and its clickable interior; short labels like
       "RAG: off" now render with more breathing room instead of a
       near-flush-to-edge fit. */
    min-width: $ds-size-12;
    /* task-1671: 22 cut model ids mid-token ("Model: claude-3-hai…").
       The ask was 25 chars of the MODEL NAME, and the "Model: " prefix
       costs 7 with 2 more for padding -- hence 34. Chips are width:auto,
       so this cap only bites long labels: "Library search: off" and
       friends are unchanged. Focus still lifts the cap entirely. */
    max-width: $ds-size-34;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-2;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

#console-cost-chip {
    max-width: $ds-width-full;
}

.console-chip-dim {
    color: $ds-text-muted;
}

.console-chip-alert {
    color: $ds-text-primary;
    text-style: bold;
}

/* task-4 (PR3 cost ticker): the cost chip's "cache expired" state -- not
   an alert (nothing needs the user's attention) and not a plain dim
   readiness pill either, so it gets its own informational color rather
   than reusing either. */
.console-chip-cold {
    color: $ds-status-info;
}

/* task-7: the temporary-chat chip -- distinct from the neutral readiness
   chips above so "this chat is not saved" reads as a state worth noticing,
   not just another setting pill. */
#console-temporary-chip {
    color: $warning;
    text-style: italic;
}

/* Keyboard reachability: chips ellipsize at 22 cells, so focusing a chip
   lifts the width cap to reveal the full label (the tooltip carries the
   same text on hover). Later chips clip under the bar's hidden overflow. */
.console-control-chip:focus {
    max-width: $ds-width-full;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    /* TASK-383: the global `*:focus { outline: solid }` fallback OVERLAYS a box
       onto this height-1 chip, replacing the label with border glyphs (the
       "empty outlined box" defect). The high-contrast bg/fg + bold underline
       above already give a non-obscuring focus cue, so suppress the outline
       that would otherwise hide the label. */
    outline: none;
}

.console-control-action {
    width: auto;
    min-width: $ds-size-7;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: transparent;
    color: $ds-text-primary;
    content-align: left middle;
}

.console-control-action:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-control-summary-line {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
}

.console-hidden-control {
    display: none;
}

#console-main-column,
#console-right-rail {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-height-full;
    /* TASK-24605: was `min-height: 20`. On a 24-row terminal the rail is
       allotted 13 rows, so a 20-row minimum made it lay out its children
       against 20 and then clip to 13 -- and the child that fell off the
       bottom was the fold hint, the LAST one. Measured live at 80x24: the
       body overflowed (scrollbar painted) while the hint reported
       display=True and appeared nowhere, which is exactly the state the
       fold convention exists to prevent. The floor now sits below what the
       smallest supported terminal actually yields, so the rail sizes to its
       real box and the hint stays inside it. */
    min-height: $ds-size-12;
}

#console-workspace-handoff-rows {
    height: auto;
    min-height: $ds-size-0;
}

#console-workspace-conversations-header {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    layout: horizontal;
    align: left middle;
}

.console-workspace-action.console-workspace-conversations-toggle {
    width: $ds-size-3;
    min-width: $ds-size-3;
    max-width: $ds-size-3;
    margin: $ds-space-0;
}

#console-workspace-selected-conversation {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
    background: $ds-surface-panel;
}

/* TASK-31429 (rail colour grammar): the line that NAMES the active chat
   takes the active hue; the same Static's "No active …" placeholder keeps
   the muted id rule above. id+class so it outranks that id rule. */
#console-workspace-selected-conversation.console-workspace-selected-conversation-active {
    color: $ds-active-fg;
}

/* The row is 3 rows tall so the bordered Input inside it can show its value:
   a `tall` border spends one row above and one below the text, so a 1-row
   input paints its top edge and nothing else. */
#console-workspace-conversation-search-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    layout: horizontal;
    align: left middle;
}

#console-workspace-conversation-search {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

#console-workspace-conversation-search-clear {
    width: auto;
    min-width: $ds-size-7;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
}

#console-workspace-conversations {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-0;
    overflow-y: hidden;
    overflow-x: hidden;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-workspace-conversation-row {
    height: auto;
    min-height: $ds-size-2;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    text-align: left;
    content-align: left middle;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

/* TASK-31429 (rail colour grammar): a row's fleet run-marker state colours
   its text with the same status tokens the Inspector rows use. Ordered
   BEFORE `-selected` (equal specificity, last wins) so the selected row
   keeps the active hue whatever its marker. */
.console-workspace-conversation-row-running {
    color: $ds-status-running;
}

.console-workspace-conversation-row-needs-approval {
    color: $ds-status-approval-required;
}

.console-workspace-conversation-row-finished-ok {
    color: $ds-status-ready;
}

.console-workspace-conversation-row-finished-failed {
    color: $ds-status-error-readable;
}

.console-workspace-conversation-row-subagent-unseen {
    color: $ds-status-info;
}

/* TASK-31429: selection is a foreground hue (primary = what you are in),
   no longer the focus tint -- so "which chat am I in" and "where is
   keyboard focus" read as two different signals. Focus rules below still
   paint the focus tint on top when the selected row is focused. */
.console-workspace-conversation-row-selected {
    color: $ds-active-fg;
    text-style: bold;
}

#console-left-rail {
    height: $ds-height-full;
    min-height: $ds-size-0;
    overflow: hidden;
}

#console-left-rail:focus {
    outline: none;
    background: $ds-surface-panel;
}

/* TASK-31665 AC#15: visible thumb -- see the first of these rules. */
#console-left-rail-body {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-height-fill;
    min-height: $ds-size-0;
    padding: $ds-space-0;
    overflow-y: auto;
    overflow-x: hidden;
    /* TASK-1191: do not remove `scrollbar-gutter: stable`.
     * ConsoleWorkspaceContextTray._fit_height_to_content's single fit pass
     * (Widgets/Console/console_workspace_context.py) depends on this rail's
     * content width never shifting when rows are added/removed and the
     * scrollbar toggles on/off -- `stable` reserves the gutter column
     * unconditionally, so a toggling scrollbar cannot change
     * `content_region.width` out from under an already-scheduled fit pass.
     * Without it, that width shift could feed back into another relabel
     * recompose after the single pass already ran, reopening the
     * multi-pass settle race TASK-1191 retired. */
    scrollbar-gutter: stable;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-text-muted;
    scrollbar-color-hover: $ds-text-muted;
    scrollbar-color-active: $ds-action-focus;
}

#console-left-rail-body:focus {
    outline: none;
    border: none;
    background: $ds-surface-panel;
}

#console-session-context:focus,
#console-workspaces-context:focus,
#console-workspace-context:focus {
    outline: none;
    border: none;
    background: $ds-surface-panel;
}

#console-workspace-conversations:focus {
    outline: none;
    border: none;
    background: $ds-surface-panel;
}

.console-left-rail-section {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    /* TASK-2154.3 (LY-07): no horizontal padding here -- the enclosing
       .console-rail-section-body already supplies the single content indent
       (rail IA spec section 3). The second indent spent 2 of the rail's
       ~23 content cells and pushed the 12-col label + 10-col value status
       pairs one cell past the row's right edge. */
    padding: $ds-space-0;
}

#console-send-authority-summary {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-6;
    min-height: $ds-size-6;
    max-height: $ds-size-6;
    padding: $ds-space-0 $ds-space-1;
    overflow: hidden;
}

/* TASK-31663 AC#5: constrained-height form. At 80x24 a six-row block left a
   THREE-row scroll body, too short for the Environment section; two rows
   makes it seven. `ConsoleInspectorRail._sync_authority_summary_density`
   pins the SAME numbers inline (inline wins in Textual) -- keep them in
   step. `console-` prefix keeps this out of the boot bundle. */
#console-send-authority-summary.console-authority-compact {
    height: $ds-size-2;
    min-height: $ds-size-2;
    max-height: $ds-size-2;
}

#console-send-authority-summary:focus {
    outline: heavy $ds-action-focus;
}

#console-send-authority-heading {
    text-style: bold;
    color: $ds-text-primary;
}

.console-send-authority-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#console-main-column {
    width: $ds-fr-13;
    min-width: $ds-size-60;
    padding: $ds-space-0;
}

ConsoleTerminalWorkspace#console-main-column {
    layout: grid;
    grid-size: 6;
    grid-columns: 1fr 1fr 1fr 1fr 1fr 1fr;
    grid-rows: auto auto auto auto 1fr auto auto auto;
    grid-gutter: 0;
    width: $ds-fr-13;
    min-width: $ds-size-60;
    height: $ds-height-full;
    min-height: $ds-size-0;
    padding: $ds-space-0;
    overflow: hidden;
    background: $ds-surface-panel;
}

#console-terminal-danger,
#console-terminal-access,
#console-terminal-open-settings,
#console-terminal-arm,
#console-terminal-metadata,
#console-terminal-viewport,
#console-terminal-status {
    column-span: 6;
}

#console-terminal-danger,
#console-terminal-access,
#console-terminal-metadata,
#console-terminal-status {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#console-terminal-danger {
    background: $ds-status-error 20%;
    color: $ds-status-error;
    text-style: bold;
}

#console-terminal-access,
#console-terminal-metadata,
#console-terminal-status {
    color: $ds-text-muted;
}

#console-terminal-viewport {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-height-full;
    min-height: $ds-size-0;
    padding: $ds-space-0;
    overflow: hidden;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-terminal-viewport:focus {
    outline: solid $ds-action-focus;
}

#console-right-rail {
    width: $ds-fr-4;
    min-width: $ds-size-34;
    overflow: hidden;
}

#console-right-rail,
#console-transcript-region {
    background: $ds-surface-panel;
}

.console-rail-handle {
    width: $ds-size-13;
    min-width: $ds-size-13;
    max-width: $ds-size-13;
    height: $ds-height-full;
    min-height: $ds-size-20;
    padding: $ds-space-0;
    border: none;
    background: $ds-surface-panel;
}

.console-rail-handle-right {
    width: $ds-size-11;
    min-width: $ds-size-11;
    max-width: $ds-size-11;
    height: auto;
    min-height: $ds-size-3;
    max-height: $ds-size-6;
    border: none;
    background: transparent;
}

.console-rail-handle-button {
    width: $ds-size-11;
    min-width: $ds-size-0;
    max-width: $ds-size-11;
    height: $ds-height-full;
    min-height: $ds-height-full;
    max-height: $ds-height-full;
    text-align: center;
    content-align: center middle;
}

.console-rail-handle-button-right {
    width: $ds-size-11;
    max-width: $ds-size-11;
    height: $ds-size-3;
    min-height: $ds-size-3;
    max-height: $ds-size-3;
}

.console-rail-handle-vertical {
    width: $ds-size-3;
    min-width: $ds-size-3;
    max-width: $ds-size-3;
    height: $ds-height-full;
    min-height: $ds-size-20;
    max-height: $ds-height-full;
    align-horizontal: center;
}

.console-rail-handle-button.console-rail-handle-button-vertical {
    width: $ds-size-1;
    min-width: $ds-size-1;
    max-width: $ds-size-1;
    height: $ds-height-fill;
    min-height: $ds-size-7;
    max-height: $ds-height-full;
}

/* TASK-345: controls that previously had NO :focus rule fell back to
   Textual's imperceptible default shift. Non-obscuring contract vocabulary
   only (ds tokens + bold underline; no accent, no reverse). */
.console-rail-collapse-button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* TASK-31429: the row IS the Button; class+pseudo beats selected/run hues. */
.console-workspace-conversation-row:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-workspace-action-row Button:focus,
.console-rail-header Button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-rail-collapse-button {
    width: $ds-size-3;
    min-width: $ds-size-3;
    max-width: $ds-size-3;
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-align: left;
    content-align: left middle;
}

.console-rail-handle-badge {
    height: auto;
    min-height: $ds-size-1;
    width: $ds-width-full;
    text-align: center;
    color: $ds-text-primary;
    background: $ds-surface-raised;
}

.console-rail-handle-badge-vertical {
    width: $ds-size-1;
    min-width: $ds-size-1;
    max-width: $ds-size-1;
}

.console-rail-header {
    height: $ds-size-1;
    min-height: $ds-size-1;
    layout: horizontal;
}

.console-rail-title {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    text-align: left;
    content-align: left middle;
}

/* TASK-25715: the Context header and the Inspector's group heading are one
   shared band -- same background, colour and padding -- and a contract test
   pins them together. #2220/TASK-24609 moved the Inspector side to `padding:
   0` so its headings start in the same column as the rows they label, which
   silently broke the band from the other side.

   Context follows the Inspector rather than the reverse. Re-indenting the
   Inspector heading would restore the band by re-opening the heading/row
   misalignment TASK-24609 fixed, and padding its ROWS instead was already
   measured and rejected there: it costs each row a column and wrapped two
   live-work rows at the rail's 46-column width. Dropping this indent costs
   the Context header nothing -- the raised background still spans the full
   row -- and gives the section title one more column, which the 27-column
   rail can use. The border-top rule and the 2-row minimum are deliberate
   (TASK-23193) and stay. */
.console-rail-section-header {
    height: auto;
    min-height: $ds-size-2;
    border-top: solid $ds-column-line;
    padding: $ds-space-0;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    content-align: center middle;
}

.console-rail-section-title {
    width: $ds-width-fill;
    text-style: bold;
    color: $ds-text-primary;
}

.console-rail-section-toggle {
    width: $ds-size-3;
    min-width: $ds-size-3;
    text-style: bold;
}

.console-rail-section-toggle:focus {
    background: $ds-action-focus 30%;
    text-style: underline bold;
}

.console-workspace-conversations-header {
    height: auto;
    min-height: $ds-size-2;
    border-top: solid $ds-column-line;
    content-align: center middle;
}

.console-rail-section-body {
    height: auto;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
    margin-bottom: $ds-space-1;
}

.console-bounded-section-viewport {
    height: auto;
    min-height: $ds-size-0;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-gutter: stable;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    /* TASK-31663 AC#4: the SECTION-inner bar, same invisible thumb as the
       outer scroller above -- fixing only one would leave the rail's two
       scrollbars disagreeing about whether they can be seen. */
    scrollbar-color: $ds-text-muted;
    scrollbar-color-hover: $ds-text-muted;
    scrollbar-color-active: $ds-action-focus;
}

/* TASK-24702: was `$ds-action-focus 12%`. Measured live by parsing the
   terminal's own SGR stream, that blend renders (31,55,74) -- 1.35:1
   against the rail background and 1.11:1 against the pinned card. WCAG's
   minimum for a non-text UI indicator is 3:1, so the focus cue was
   effectively invisible; at 80x24, 5 of 12 Tab stops showed nothing at all.
   Raised here, in the shared convention, rather than only on the two
   containers TASK-24612 added -- every consumer of this rule had the same
   problem, and fixing only the new selectors would have left the rail's
   sections quieter than its containers. */
.console-bounded-section-viewport:focus,
.console-bounded-section-viewport:focus-within {
    background: $ds-action-focus 45%;
}

/* TASK-31663 AC#1/AC#2: the rail's Button focus carrier. Seven ring stops
   painted identical text focused and unfocused (background swap only,
   1.68:1) and a tint cannot reach 3:1 on this theme, so the cue must change
   CELLS. Lossless: every rail Button already paints a leading space.
   Class-keyed, NOT `#console-right-rail Button` -- that form taxed every
   Button in the app (test_textual_css_fastpath.py's ratchet). Coverage and
   losslessness pinned by test_console_inspector_focus_carriers.py. */
Button.console-rail-focus-carrier:focus {
    outline-left: thick $ds-action-focus;
}

/* Inspector ROWS are deliberately absent above: the `*:focus` fallback in
   `css/core/_reset.tcss` already gives them corner brackets on their own
   padding -- a cue deliberately DISTINCT from the `█` column the focused
   scroller paints. An `outline-left: thick` here was dead code (a 1-2 line
   row has no middle line to paint on). See TASK-31663 notes. */

/* The rail's SCROLLER stop. Textual paints children OVER a container's own
   strips, so the body's edge shows only in inter-section gaps -- none at
   80x24. The section body's `padding-left: 1` is the innermost free column.
   Accepted cost: `outline-left` is a `BoxProperty` forcing
   `refresh(layout=True)`, so scroller focus enter/leave relayouts each
   section body; investigated as a flake cause and CLEARED twice. */
#console-workspace-tree {
    width: $ds-width-full;
    min-width: $ds-size-0;
    min-height: $ds-size-0;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-gutter: stable;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

#console-workspace-tree:focus {
    /* TASK-28226: this tree can be only two rows tall. The global four-sided
       focus outline overpaints both rows after an action menu restores focus;
       the focus-specific cursor below supplies the content-safe high-contrast
       cue while this tint reinforces which compact region owns focus. */
    outline: none;
    background: $ds-action-focus 12%;
}

#console-workspace-tree > .tree--cursor {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

#console-workspace-tree:focus > .tree--cursor {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-bounded-section-hint {
    display: none;
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $ds-text-muted;
    background: $ds-surface-panel;
    text-style: italic;
}

.console-pinned-terminal-action {
    width: $ds-width-full;
    min-width: $ds-size-0;
    max-width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-authority-local;
    text-align: left;
    content-align: left middle;
}

.console-pinned-terminal-action:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

#console-rail-system-line {
    height: $ds-size-1;
    color: $ds-text-primary;
}

#console-rail-system-line.console-rail-system-line-dim {
    color: $ds-text-muted;
}

.console-live-work-source-readiness {
    height: auto;
    min-height: $ds-size-0;
    margin: $ds-space-0;
}

#console-live-work-section,
#console-live-work-header,
#console-pending-launch-card {
    height: auto;
    min-height: $ds-size-0;
}

#console-live-work-section {
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

.console-live-work-source-row {
    height: auto;
    min-height: $ds-size-1;
}

.console-left-rail-section.console-settings-summary {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $ds-surface-panel;
}

#console-transcript-region,
#console-session-surface {
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

#console-session-surface {
    padding: $ds-space-0;
    margin: $ds-space-0;
    border: none;
}

#console-transcript-region {
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $ds-surface-panel;
}

#console-left-rail.console-edge-region-focused #console-context-rail-collapse,
#console-context-rail-handle.console-edge-region-focused #console-context-rail-open,
#console-right-rail.console-edge-region-focused #console-inspector-rail-collapse,
#console-inspector-rail-handle.console-edge-region-focused #console-inspector-rail-open {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* TASK-17651: the composer is a dense-form one-row field (task-1586
   convention), not a framed region. Zero chrome rows: no border box, no
   vertical padding — the bar IS its 1-4 draft rows. The one-column left
   edge is the structural marker; it recolors for the has-draft state and
   flips to thick focus accent (same column width, no layout shift). */
#console-native-composer {
    height: auto;
    min-height: $ds-console-composer-height;
    /* TASK-17654: moves with ConsoleComposerBar.MAX_DRAFT_ROWS. */
    max-height: $ds-size-8;
    padding: $ds-space-0 $ds-space-1;
    /* TASK-17657/17659: DELIBERATE one-row gap on each side of the composer
       (owner calls) — the bar floats clear of the status row above and the
       footer below. Not the TASK-17650 phantom: both rows are pinned by the
       single-separator contract test. Compact mode drops them. */
    margin: $ds-space-1 $ds-space-0;
    layout: vertical;
    align: left middle;
    border: none;
    border-left: solid $ds-control-edge;
    background: $ds-surface-panel;
}

#console-native-composer.console-composer-has-draft {
    border-left: solid $ds-status-ready;
}

#console-native-composer.console-composer-focused {
    border-left: thick $ds-action-focus;
    background: $ds-input-focus-bg;
}

#console-native-composer:focus {
    /* The global *:focus outline (core/_reset.tcss) draws its corner
       glyphs INSIDE the one-row bar (there are no padding rows left to
       absorb it); the dense-form edge + background above is the focus
       treatment. */
    outline: none;
}

#console-native-composer.console-composer-setup-blocked #console-command-visible-text {
    color: $ds-status-warning;
}

#console-composer-expanded,
#console-composer-collapsed {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    layout: horizontal;
    align: left middle;
}

#console-native-composer.console-composer-collapsed {
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    padding: $ds-space-0;
    border: none;
    border-left: solid $ds-control-edge;
    background: $ds-surface-raised;
}

#console-composer-status,
.console-composer-recovery,
.console-send-disabled-reason,
.console-control-label {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

#console-composer-collapse {
    width: $ds-size-12;
    min-width: $ds-size-12;
}

#console-composer-collapsed-status {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-overflow: ellipsis;
    text-wrap: nowrap;
    color: $ds-text-muted;
}

#console-raw-cli-status.console-raw-cli-danger,
#console-composer-collapsed-status.console-raw-cli-danger {
    color: $ds-status-error-readable;
    text-style: bold;
}

#console-collapsed-stop-generation {
    width: $ds-size-8;
    min-width: $ds-size-8;
}

#console-composer-expand {
    width: $ds-size-12;
    min-width: $ds-size-12;
}

#console-native-composer.console-composer-has-draft #console-command-visible-text,
#console-native-composer:focus-within #console-command-visible-text,
#console-command-visible-text:focus {
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-composer-actions {
    width: $ds-size-45;
    min-width: $ds-size-45;
    max-width: $ds-size-45;
    height: $ds-size-1;
    min-height: $ds-size-1;
    layout: horizontal;
    /* Left-aligned so Send stays flush against the draft it submits;
       Stop's budgeted-but-hidden slot sits after Mic at the right edge. */
    align: left middle;
}

.console-composer-recovery {
    width: $ds-size-0;
    min-width: $ds-size-0;
    max-width: $ds-size-0;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-status-warning;
    text-style: bold;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

.console-send-disabled-reason {
    width: $ds-size-0;
    min-width: $ds-size-0;
    max-width: $ds-size-0;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-status-warning;
    text-style: bold;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

/* TASK-2154.6 (FR-04): the idle "type a message" guidance is not a blocker,
   so it renders quietly instead of in the warning style above. */
.console-send-disabled-reason-idle {
    color: $ds-text-muted;
    text-style: none;
}

.console-voice-status {
    width: $ds-size-0;
    min-width: $ds-size-0;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-status-running;
    text-style: bold;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

.console-voice-status-error {
    color: $ds-status-error;
}

#console-composer-status {
    width: auto;
    min-width: $ds-size-0;
}

#console-session-surface .chat-input-area {
    display: none;
}

.console-transcript-system-event {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border-left: solid $ds-status-warning;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-chat-tabs,
#console-chat-tabs #chat-sessions-container,
#console-chat-tabs .chat-session {
    height: $ds-height-full;
    min-height: $ds-size-0;
}

/* task-32287: the inline task-card surface (ChatTaskCards) hugs its cards.
   As a plain Container it kept Textual's `height: 1fr` default and took a
   full share of the session column next to `#console-transcript-surface`
   below -- 17 rows at 200x50 for an 11-row card (blank rows above the
   transcript), and only 6 rows at 80x24, where it CLIPPED the approval
   card's Approve-all/Submit/Deny-all bar out of the compositor entirely
   (the bar's own coordinates rendered the transcript's empty state). The
   surface is `display: none` whenever no card is pending, so `auto` costs
   the transcript nothing until an agent actually asks for something. */
#console-task-surface {
    height: auto;
}

#console-transcript-surface {
    height: $ds-height-fill;
    min-height: $ds-size-0;
    layers: console-background console-content;
}

#console-transcript-background-effect {
    layer: console-background;
    width: $ds-width-full;
    height: $ds-height-full;
    color: $ds-text-muted;
    background: transparent;
}

#console-native-transcript {
    height: $ds-height-fill;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
    /* TASK-20937.3: neither the transcript nor its region owns a frame
       edge. The workbench grid closes the surface at top/bottom, while
       Context and Inspect own the two interior dividers. */
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
    scrollbar-size: 1 1;
}

#console-transcript-surface #console-native-transcript {
    layer: console-content;
    height: $ds-height-fill;
    min-height: $ds-size-0;
    background: transparent;
}

#console-transcript-title,
.console-transcript-title {
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    margin: $ds-space-0;
    background: $ds-surface-panel;
    color: $ds-text-muted;
    text-style: none;
}

#console-transcript-region.console-transcript-region-focused #console-transcript-title {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

#console-native-tab-strip,
.console-session-tab-strip {
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    margin: $ds-space-0;
    margin-bottom: $ds-space-1;
    background: $ds-surface-panel;
}

/* Scrollable tab strip: overflow scrolls horizontally (wheel, keyboard, or
   scroll-to-active) instead of silently clipping tabs. The scrollbar itself
   is hidden because the strip is a single row tall. */
#console-native-tab-strip {
    scrollbar-size-horizontal: 0;
}

/* TASK-28028: 1-cell ‹ › hints at the strip row's edges, shown only while
   tabs are hidden past that edge (display toggled from Python). */
#console-tab-overflow-left,
#console-tab-overflow-right {
    color: $ds-text-muted;
    text-style: none;
    background: transparent;
}

.console-session-tab,
#console-new-chat-tab,
#console-new-temporary-tab {
    width: auto;
    min-width: $ds-size-8;
    height: $ds-size-1;
    min-height: $ds-size-1;
    /* TASK-2154.4 (LY-02): no CSS padding here -- Button's own line-pad (1
       cell each side, not zero-able in CSS) already provides the visual gap,
       and stacking padding on top of it left plain Buttons only width-4
       label cells: 'Temporary' (9 chars) clipped to 'Temporar' in its
       12-wide button. (Session tabs escaped: their nowrap+clip DEFAULT_CSS
       paints past the line-pad area up to the widget edge.) padding: 0
       leaves the label budget at width-2. */
    padding: $ds-space-0;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-session-close-button {
    padding: $ds-space-0;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-style: bold;
}

.console-session-tab-active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-session-tab-active:hover,
.console-session-tab-active:hover:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

#console-native-transcript:focus {
    /* TASK-17651: no border in either state (stable geometry, zero rows).
       TASK-20937.3 puts the non-color pane cue on the stable title row;
       the scrollbar recolor remains a secondary color cue.
       The global *:focus outline (core/_reset.tcss) would overpaint the
       outermost transcript CONTENT rows now that no border absorbs it —
       the reset's own documented DataTable pattern: opt out, recolor. */
    border: none;
    outline: none;
    scrollbar-color: $ds-focus-accent;
}

.console-transcript-rule {
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $ds-column-line;
    /* TASK-17658: the separator is a hatch fill, not a fixed-length dash
       string — it reaches edge to edge at any terminal width. */
    hatch: horizontal $ds-column-line;
}

.console-transcript-message {
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-thinking-detail {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-muted;
    text-wrap: wrap;
}

.console-transcript-message-roleplay-user,
.console-transcript-message-role-user {
    background: $primary 8%;
}

.console-transcript-message-roleplay-character,
.console-transcript-message-role-assistant {
    background: $accent 8%;
}

.console-transcript-speaker-label,
.console-transcript-message-body {
    height: auto;
}

.console-transcript-speaker-label {
    color: $ds-text-primary;
    text-style: bold;
}

.console-message-header {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
}

.console-message-header > .console-transcript-speaker-label {
    width: $ds-width-fill;
    height: $ds-size-1;
    min-height: $ds-size-1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.console-message-speech-presentation {
    width: $ds-size-14;
    min-width: $ds-size-14;
    height: $ds-size-1;
    min-height: $ds-size-1;
    align: right middle;
}

.console-message-speech-status {
    width: $ds-size-10;
    min-width: $ds-size-10;
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $ds-text-muted;
    text-align: right;
}

Button.console-message-speech-action {
    width: $ds-size-4;
    min-width: $ds-size-4;
    max-width: $ds-size-4;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0;
    border: none;
    background: transparent;
    color: $ds-text-primary;
}

Button.console-message-speech-action:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-transcript-roleplay-user-label {
    color: $ds-chat-user-accent;
    text-style: bold;
}

.console-transcript-roleplay-character-label {
    color: $ds-chat-user-accent;
    text-style: bold;
}

.console-transcript-role-assistant-label {
    color: $ds-chat-user-accent;
    text-style: bold;
}

.-dark-mode .console-transcript-roleplay-user-label {
    color: $ds-chat-user-accent-dark;
}

.-light-mode .console-transcript-roleplay-user-label {
    color: $ds-chat-user-accent-light;
}

.-dark-mode .console-transcript-roleplay-character-label,
.-dark-mode .console-transcript-role-assistant-label {
    color: $ds-chat-assistant-accent-dark;
}

.-light-mode .console-transcript-roleplay-character-label,
.-light-mode .console-transcript-role-assistant-label {
    color: $ds-chat-assistant-accent-light;
}

/* Immersive RP is opt-in: prose follows the semantic speaker accent while
   Markdown's own code/link nodes retain their more specific readable styles. */
.console-transcript-message-immersive-user > .console-transcript-message-body,
.console-transcript-message-immersive-user > .console-markdown-body {
    color: $ds-chat-user-accent;
}

.-dark-mode .console-transcript-message-immersive-user > .console-transcript-message-body,
.-dark-mode .console-transcript-message-immersive-user > .console-markdown-body {
    color: $ds-chat-user-accent-dark;
}

.-light-mode .console-transcript-message-immersive-user > .console-transcript-message-body,
.-light-mode .console-transcript-message-immersive-user > .console-markdown-body {
    color: $ds-chat-user-accent-light;
}

.console-transcript-message-immersive-assistant > .console-transcript-message-body,
.console-transcript-message-immersive-assistant > .console-markdown-body,
.console-transcript-message-immersive-character > .console-transcript-message-body,
.console-transcript-message-immersive-character > .console-markdown-body {
    color: $ds-chat-user-accent;
}

.-dark-mode .console-transcript-message-immersive-assistant > .console-transcript-message-body,
.-dark-mode .console-transcript-message-immersive-assistant > .console-markdown-body,
.-dark-mode .console-transcript-message-immersive-character > .console-transcript-message-body,
.-dark-mode .console-transcript-message-immersive-character > .console-markdown-body {
    color: $ds-chat-assistant-accent-dark;
}

.-light-mode .console-transcript-message-immersive-assistant > .console-transcript-message-body,
.-light-mode .console-transcript-message-immersive-assistant > .console-markdown-body,
.-light-mode .console-transcript-message-immersive-character > .console-transcript-message-body,
.-light-mode .console-transcript-message-immersive-character > .console-markdown-body {
    color: $ds-chat-assistant-accent-light;
}

/* TASK-1990.1/TASK-22454: flavor assistant / character prose without rewriting
   Markdown. Quoted speech, quoted inner thought, emphasis-as-action, and strong
   emphasis are Content component spans; visible delimiters, text styles, labels,
   and Markdown structure continue to carry meaning without color. */
.-dark-mode .console-transcript-message-immersive-assistant .console-roleplay-markdown-block > .console-rp-speech,
.-dark-mode .console-transcript-message-immersive-character .console-roleplay-markdown-block > .console-rp-speech {
    color: $ds-chat-rp-speech-dark;
}

.-light-mode .console-transcript-message-immersive-assistant .console-roleplay-markdown-block > .console-rp-speech,
.-light-mode .console-transcript-message-immersive-character .console-roleplay-markdown-block > .console-rp-speech {
    color: $ds-chat-rp-speech-light;
}

.-dark-mode .console-transcript-message-immersive-assistant .console-roleplay-markdown-block > .console-rp-thought,
.-dark-mode .console-transcript-message-immersive-character .console-roleplay-markdown-block > .console-rp-thought {
    color: $ds-chat-rp-thought-dark;
    text-style: italic;
}

.-light-mode .console-transcript-message-immersive-assistant .console-roleplay-markdown-block > .console-rp-thought,
.-light-mode .console-transcript-message-immersive-character .console-roleplay-markdown-block > .console-rp-thought {
    color: $ds-chat-rp-thought-light;
    text-style: italic;
}

.-dark-mode .console-transcript-message-immersive-assistant .console-roleplay-markdown-block > .console-rp-action,
.-dark-mode .console-transcript-message-immersive-character .console-roleplay-markdown-block > .console-rp-action {
    color: $ds-chat-rp-action-dark;
    text-style: italic;
}

.-light-mode .console-transcript-message-immersive-assistant .console-roleplay-markdown-block > .console-rp-action,
.-light-mode .console-transcript-message-immersive-character .console-roleplay-markdown-block > .console-rp-action {
    color: $ds-chat-rp-action-light;
    text-style: italic;
}

.-dark-mode .console-transcript-message-immersive-assistant .console-roleplay-markdown-block > .console-rp-strong,
.-dark-mode .console-transcript-message-immersive-character .console-roleplay-markdown-block > .console-rp-strong {
    color: $ds-chat-rp-strong-dark;
    text-style: bold;
}

.-light-mode .console-transcript-message-immersive-assistant .console-roleplay-markdown-block > .console-rp-strong,
.-light-mode .console-transcript-message-immersive-character .console-roleplay-markdown-block > .console-rp-strong {
    color: $ds-chat-rp-strong-light;
    text-style: bold;
}

/* Failure is operational state, so it outranks roleplay identity tinting. */
.console-transcript-message-failed {
    background: $error 8%;
}

.console-transcript-message-failed > .console-transcript-speaker-label {
    width: auto;
    background: $error-darken-3;
    color: $ds-status-error-readable;
}

.console-transcript-message-failed > .console-transcript-message-body,
.console-transcript-message-failed > .console-markdown-body {
    color: $ds-text-primary;
}

.console-transcript-message-failed.console-transcript-message-markdown .console-roleplay-markdown-block > .console-rp-speech,
.console-transcript-message-failed.console-transcript-message-markdown .console-roleplay-markdown-block > .console-rp-thought,
.console-transcript-message-failed.console-transcript-message-markdown .console-roleplay-markdown-block > .console-rp-action,
.console-transcript-message-failed.console-transcript-message-markdown .console-roleplay-markdown-block > .console-rp-strong {
    color: $ds-text-primary;
}

.console-transcript-message-selected {
    min-height: $ds-size-2;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-transcript-message-selected > .console-transcript-speaker-label {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}


.console-transcript-message-selected > .console-transcript-message-body,
.console-transcript-message-selected > .console-markdown-body {
    color: $ds-focus-fg;
}

.console-transcript-message-selected.console-transcript-message-markdown .console-roleplay-markdown-block > .console-rp-speech,
.console-transcript-message-selected.console-transcript-message-markdown .console-roleplay-markdown-block > .console-rp-thought,
.console-transcript-message-selected.console-transcript-message-markdown .console-roleplay-markdown-block > .console-rp-action,
.console-transcript-message-selected.console-transcript-message-markdown .console-roleplay-markdown-block > .console-rp-strong {
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Turn file card selection parity with the message rows above. These rules
   live HERE, not in the widget's DEFAULT_CSS: they need the real
   $ds-focus-* tokens, and a widget-local `$var:` "fallback" would shadow
   the bundle's values for that whole CSS source (TASK-16811). */
ConsoleTurnFileCard.console-turn-file-card-selected {
    background: $ds-focus-bg;
}
ConsoleTurnFileCard.console-turn-file-card-selected .console-turn-file-header {
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* TASK-1846: this is the record of what an agent did to the user's machine
   -- what it read, what it wrote, what left the box. It rendered `dim italic`
   in muted grey, making the audit trail the LEAST legible text in the
   transcript. Tools are the egress boundary; their trace should read at
   least as clearly as ordinary prose. Italic is kept as the quiet
   distinguishing mark from user/assistant rows; `dim` is not. */
.console-transcript-message-tool {
    color: $ds-text-primary;
    text-style: italic;
}

/* TASK-1366: inline diff row under an expanded file-write TOOL marker.
   Indented to read as belonging to the marker above it; height stays
   auto so the mounted DiffView sizes itself. */
.console-transcript-tool-diff {
    height: auto;
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-size-4;
}

.console-transcript-message-system {
    color: $ds-text-muted;
}

.console-transcript-citation-sources {
    width: auto;
    min-width: $ds-size-13;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-muted;
}

.console-transcript-citation-sources:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

/* task-17169: inline review-note marker under an annotated message. A
   non-interactive Static (the note text IS the viewer), quiet like the
   citation chip but full-width so multi-line notes wrap. */
.console-transcript-annotations {
    width: $ds-width-fill;
    height: auto;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-panel;
    color: $ds-text-muted;
}

/* console selection phase 5: docked status line for keyboard text-selection
   mode (`s`), same muted palette as the annotations marker above but pinned
   to the transcript's bottom edge like the jump pill (below), one row tall.
   Hidden until `_enter_keyboard_selection` shows it. */
.console-kb-selection-hint {
    dock: bottom;
    width: $ds-width-full;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-panel;
    color: $ds-text-muted;
}

/* TASK-385: a selected Tool/System row must read the same as a selected
   user/assistant row. The muted `-tool`/`-system` rules above share the
   single-class specificity of `-selected` and follow it in source order, so
   they would otherwise strip the selection treatment off the text. These
   two-class selectors out-specify them and re-assert the focus colours + bold
   underline for the selected state. */
.console-transcript-message-tool.console-transcript-message-selected,
.console-transcript-message-system.console-transcript-message-selected {
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* TASK-371: docked "jump to latest" pill shown while the reader is scrolled up
   during (or just after) a streaming reply. Pinned to the transcript's bottom
   edge, high-contrast so it reads as an actionable status, click to re-attach. */
.console-transcript-jump-pill {
    dock: bottom;
    width: $ds-width-full;
    height: $ds-size-1;
    content-align: center middle;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

/* TASK-2154.11 (DS-05): the pill is keyboard-focusable now. Its resting
   style already uses the focus colours, so the focused cue adds the
   underline; the height-1 row must suppress the global `*:focus {
   outline: solid }` fallback, which would overlay border glyphs and hide
   the label (same defect class as TASK-383's chip rule above). */
.console-transcript-jump-pill:focus {
    outline: none;
    text-style: bold underline;
}

/* task-558: the image-generation card row (border/border_title are set in
   Python -- ConsoleGenerationCard.__init__ -- since Textual widget borders
   aren't otherwise reachable from a class rule here; this adds the
   surrounding spacing/background the plain .console-transcript-message row
   gets, which the card previously had none of). */
.console-generation-card {
    height: auto;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-1;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-generation-card-details {
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

.console-generation-card-image-placeholder {
    color: $ds-text-muted;
    text-style: dim italic;
}

/* task-3401.5/.9: video generation card + silent in-card preview (mirrors
   the image generation card's panel treatment; the preview frame reuses the
   inline-image max bounds from Python -- ConsoleVideoPreview -- and only
   needs spacing/colors here). */
.console-video-card {
    height: auto;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-1;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-video-card-status {
    color: $ds-text-primary;
    text-style: bold;
}

.console-video-card-status-expired {
    color: $ds-text-muted;
    text-style: dim italic;
}

.console-video-card-details {
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

.console-video-preview {
    height: auto;
    padding: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.console-video-preview-frame {
    color: $ds-text-primary;
    height: auto;
}

.console-video-preview-progress {
    color: $ds-text-muted;
    height: $ds-size-1;
}

.console-transcript-action-row {
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-transcript-action-guide {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
}

.console-modal-header {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

#console-workspace-files-modal {
    width: $ds-size-110;
    max-width: $ds-percent-96;
    height: $ds-size-34;
    max-height: $ds-percent-90;
    padding: $ds-space-1 $ds-space-2;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

#console-workspace-files-pinned,
#console-workspace-files-contract,
#console-workspace-files-attention,
#console-workspace-files-status {
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $ds-text-muted;
    overflow: hidden;
}

#console-workspace-files-fold {
    display: none;
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $ds-text-muted;
    overflow: hidden;
}

#console-workspace-files-binding-row,
#console-workspace-files-filter-row,
#console-workspace-files-actions {
    height: $ds-size-3;
    min-height: $ds-size-3;
    width: $ds-width-full;
}

.console-workspace-files-binding {
    width: auto;
    max-width: $ds-width-fill;
    margin-right: $ds-space-1;
}

.console-workspace-files-binding.-selected {
    background: $ds-action-focus;
    color: $ds-text-primary;
}

#console-workspace-files-filter {
    width: $ds-width-fill;
    min-width: $ds-size-16;
}

#console-workspace-files-filter-row Button,
#console-workspace-files-actions Button {
    width: auto;
    min-width: $ds-size-9;
    margin-left: $ds-space-1;
}

#console-workspace-files-body {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-10;
}

#console-workspace-files-tree,
#console-workspace-files-viewer {
    height: $ds-height-full;
    min-width: $ds-size-0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

#console-workspace-files-tree {
    width: $ds-percent-42;
    min-width: $ds-size-28;
    margin-right: $ds-space-1;
}

#console-workspace-files-viewer {
    width: $ds-width-fill;
    padding: $ds-space-0 $ds-space-1;
}

.console-workspace-files-entry,
.console-workspace-files-file {
    width: $ds-width-full;
    min-width: $ds-size-0;
}

.console-workspace-files-path {
    color: $ds-text-muted;
    text-style: bold;
}

#console-workspace-files-preview {
    height: auto;
    color: $ds-text-primary;
}

ConsoleWorkspaceFilesModal.-fullscreen #console-workspace-files-modal {
    width: $ds-width-full;
    max-width: $ds-width-full;
    height: $ds-height-full;
    max-height: $ds-height-full;
    border: none;
    padding: $ds-space-0 $ds-space-1;
}

ConsoleWorkspaceFilesModal.-compact #console-workspace-files-body {
    height: $ds-height-fill;
}

ConsoleWorkspaceFilesModal.-compact #console-workspace-files-tree {
    width: $ds-width-full;
    min-width: $ds-size-0;
    margin-right: $ds-space-0;
}

ConsoleWorkspaceFilesModal.-compact #console-workspace-files-viewer {
    display: none;
}

ConsoleWorkspaceFilesModal.-compact.-viewer-stage #console-workspace-files-tree {
    display: none;
}

ConsoleWorkspaceFilesModal.-compact.-viewer-stage #console-workspace-files-viewer {
    display: block;
    width: $ds-width-full;
}

#console-workspace-files-back-to-files {
    display: none;
}

ConsoleWorkspaceFilesModal.-compact.-viewer-stage #console-workspace-files-back-to-files {
    display: block;
}

ConsoleWorkspaceFilesModal.-compact #console-workspace-files-actions Button {
    min-width: $ds-size-0;
    width: $ds-width-fill;
}

/* Keep the two stage/visit exits legible in the one-row compact strip. */
ConsoleWorkspaceFilesModal.-compact #console-workspace-files-actions #console-workspace-files-back {
    width: $ds-size-17;
    min-width: $ds-size-17;
}

ConsoleWorkspaceFilesModal.-compact #console-workspace-files-actions #console-workspace-files-back-to-files {
    width: $ds-size-15;
    min-width: $ds-size-15;
}

ConsoleWorkspaceFilesModal.-short #console-workspace-files-modal {
    height: $ds-height-full;
    max-height: $ds-height-full;
    padding: $ds-space-0 $ds-space-1;
}

ConsoleWorkspaceFilesModal.-short #console-workspace-files-fold {
    display: block;
}

ConsoleWorkspaceFilesModal.-short #console-workspace-files-body {
    min-height: $ds-size-0;
}

ConsoleWorkspaceFilesModal.-short #console-workspace-files-binding-row,
ConsoleWorkspaceFilesModal.-short #console-workspace-files-filter-row,
ConsoleWorkspaceFilesModal.-short #console-workspace-files-actions {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

ConsoleWorkspaceFilesModal.-short #console-workspace-files-filter-row Button,
ConsoleWorkspaceFilesModal.-short #console-workspace-files-actions Button {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

#console-citation-sources-modal {
    width: $ds-size-94;
    max-width: $ds-percent-96;
    height: $ds-size-34;
    max-height: $ds-percent-90;
    padding: $ds-space-1 $ds-space-2;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

#console-citation-sources-state {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

#console-citation-sources-body {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-8;
}

#console-citation-source-list {
    width: $ds-percent-34;
    min-width: $ds-size-18;
    height: $ds-height-full;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

#console-citation-source-list ListItem {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-2;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-primary;
}

#console-citation-source-detail {
    width: $ds-width-fill;
    height: $ds-height-full;
    min-width: $ds-size-0;
    padding: $ds-space-1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

#console-citation-source-marker {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
    text-style: bold;
}

#console-citation-source-title {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $ds-text-primary;
    text-style: bold;
}

#console-citation-source-chunk {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-primary;
}

#console-citation-sources-close {
    width: $ds-size-12;
    min-width: $ds-size-12;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

.console-transcript-action-button {
    width: auto !important;
    min-width: $ds-size-4 !important;
    height: $ds-size-3 !important;
    min-height: $ds-size-3 !important;
    padding: $ds-space-0 !important;
    border: none !important;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-media-card-actions {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0;
    background: $ds-surface-raised;
}

.console-media-card-action {
    width: auto !important;
    min-width: $ds-size-5 !important;
    height: $ds-size-1 !important;
    min-height: $ds-size-1 !important;
    padding: $ds-space-0 $ds-space-1 !important;
    border: none !important;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-media-card-action:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

.console-transcript-action-button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

.console-workspace-selector-row {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-style: bold;
}

.console-workspace-status-pair {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0;
}

/* TASK-31429 (rail colour grammar): quiet key, coloured value -- the label
   drops its bold so it no longer competes with the value it introduces. */
.console-workspace-status-label {
    color: $ds-text-muted;
}

.console-workspace-status-value {
    color: $ds-value-fg;
}

/* The workspace you are IN is identity, not a setting: active hue. */
#console-active-workspace-value {
    color: $ds-active-fg;
}

.console-workspace-empty-copy {
    color: $ds-text-muted;
}

/* TASK-717: conversation rows whose record is proven missing render dim and
   inert instead of impersonating openable chats. */
.console-workspace-conversation-row-broken {
    color: $ds-text-muted;
    text-style: italic;
}

.console-workspace-action-row {
    /* The fixed tray reserves one cell for its native-scroll sibling's
       scrollbar lane; keep the compact strip inside the tray clip. */
    width: $ds-percent-99;
    max-width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    /* TASK-2154.3 (LY-07): the rail IA spec's 12-col left indent (buttons
       aligned under the value column) assumed a ~35-col rail. The real rail
       renders at 24-30 cols, so the indent left only 3-6 cells for the
       buttons -- Switch clipped to "Switc", the former RAG Scope label to
       "RAG S"/"RA", and
       New rendered past the rail clip (invisible but clickable). Left-align
       the rows: Switch + New = 13 cells and RAG = 5 both fit the
       23-cell content width at the rail's 30-col minimum. */
    margin: $ds-space-0;
}

.console-workspace-context-action-row {
    width: $ds-percent-99;
    max-width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
}

#console-workspace-tree-selection-context {
    width: $ds-percent-99;
    max-width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    color: $ds-text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.console-workspace-action {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    /* TASK-712: Textual's default Button min-width (16) made Switch consume
       the whole action row, pushing New's label past the rail clip -
       invisible but still clickable. Size the compact actions to their
       labels so both fit the row. */
    min-width: $ds-size-5;
    width: auto;
}

#console-workspace-search {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-3;
    min-height: $ds-size-3;
}

#console-workspace-tree-star {
    width: $ds-width-full;
    min-width: $ds-size-6;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
}

#console-workspace-search-status {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#console-transcript-empty-state,
.console-transcript-empty-panel {
    height: $ds-height-full;
    min-height: $ds-height-full;
    width: $ds-width-full;
    layout: vertical;
    /* LY-12 (TASK-2154.24): center the empty/ready state so a fresh session
       reads as intentionally empty, not as a broken bottom-anchored void. */
    align: center middle;
    padding: $ds-space-1 $ds-space-2;
    background: transparent;
    color: $ds-text-primary;
}

#console-shell .workbench-recovery-callout,
#console-control-bar,
#console-workspace-grid,
#console-transcript-region,
#console-native-composer {
    opacity: 100%;
}

.console-transcript-empty-body {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0;
    text-align: center;
    color: $ds-text-muted;
}

/* TASK-2154.8 (FR-03): in-panel provider recovery action for the quiet empty
   state (provider blocked, no blocking card); mirrors the setup modal's
   compact action styling so the affordance reads as the same control. */
.console-empty-provider-action {
    width: auto;
    min-width: $ds-size-12;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $ds-focus-bg;
    color: $ds-text-primary;
    content-align: left middle;
}

.console-empty-provider-action:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-setup-step {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-primary;
    /* TASK-389 made a height-1 line ellipsize on unavoidable overflow instead
       of silently clipping. TASK-441: ellipsizing still drops the tail of the
       sentence, so wrap onto a second row instead -- height:auto (Static's
       default text-wrap is already "wrap") lets the widget grow to fit
       however many rows a narrow terminal's capped card width needs, and
       .console-setup-modal-card's own height:auto absorbs the extra row. */
}

.console-setup-step-done {
    color: $ds-text-muted;
}

.console-setup-step-active {
    text-style: bold;
}

.console-setup-step-pending {
    color: $ds-text-muted;
}

/* First-run blocking setup modal: a Console-scoped overlay layer painted over
 * the whole Console shell (rail + transcript + composer) while setup is
 * incomplete. The app tab bar lives outside the shell and stays reachable. */
#console-shell {
    layers: console-workbench console-setup-overlay;
}

/* TASK-2154.1 (LY-09): at 60x18 the transcript body shrinks to a single row;
   the empty panel's default padding (1 2) and body margin would consume it
   with blank space, hiding the ready line. Compact mode drops the vertical
   chrome so the empty-state copy always paints. */
#console-shell.-console-compact .console-transcript-empty-panel {
    padding: $ds-space-0 $ds-space-1;
}

#console-shell.-console-compact .console-transcript-empty-body {
    margin: $ds-space-0;
}

/* TASK-2154.1 (LY-09): the tab strip's separator margin costs one row the
   transcript body needs at 60x18 -- title (1) + strip (1) + margin (1)
   already consume the whole region budget there, leaving the empty panel
   clipped to zero height. Compact mode drops the separator. */
#console-shell.-console-compact #console-native-tab-strip,
#console-shell.-console-compact .console-session-tab-strip {
    margin-bottom: $ds-space-0;
}

/* TASK-2154.1 (LY-09): keep the historical compact override explicit so
   neither focus nor compact mode can resurrect the removed transcript frame. */
#console-shell.-console-compact #console-native-transcript,
#console-shell.-console-compact #console-native-transcript:focus {
    border: none;
}

/* TASK-17657: the composer's breathing-room row is a luxury compact mode
   cannot afford — same grammar as the tab strip's dropped margin. */
#console-shell.-console-compact #console-native-composer {
    margin: $ds-space-0;
}

#console-setup-modal {
    layer: console-setup-overlay;
    display: none;
    width: $ds-width-full;
    height: $ds-height-full;
    align: center middle;
    /* $background is a distinctly darker token than the Console shell's own
     * $ds-surface-panel background, so this alpha fill actually blends to a
     * dimmed shade (verified: ~#191d21 vs the shell's flat #242f38) instead
     * of a same-color no-op like the previous $ds-surface-panel 80% fill. */
    background: $background 60%;
    layers: console-setup-snow console-setup-card;
}

.console-setup-modal-backdrop-snow {
    layer: console-setup-snow;
    width: $ds-width-full;
    height: $ds-height-full;
    color: $ds-text-muted;
}

/* Console's rendered frame color (#6f7782) — see Console_Modules.frame.CONSOLE_FRAME_COLOR. */
.console-setup-modal-card {
    layer: console-setup-card;
    /* TASK-389: 62 gave 56 content cells (−2 border −4 padding); the honest
       step-3 line "…Composer unlocks after setup" is 59 cells, so its last word
       wrapped off. 66 gives 60 content cells so the full sentence fits. */
    width: $ds-size-66;
    max-width: $ds-percent-90;
    height: auto;
    padding: $ds-space-1 $ds-space-2;
    layout: vertical;
    border: solid $ds-console-frame;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-setup-modal-title {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0;
    color: $ds-text-primary;
    text-style: bold;
}

/* Task-2852: receipt line for a "Use in Console" handoff (e.g. Library
   Search/RAG evidence) staged while setup is still incomplete -- without
   this, evidence staged just before landing here was invisible under the
   opaque setup overlay (the staged-evidence strip it lives in is part of
   the covered workbench). height: auto (not a fixed height: 1) so a long
   source name wraps instead of clipping, matching .console-setup-step. */
.console-setup-modal-staged-notice {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0;
    color: $ds-status-info;
}

/* TASK-2154.8 (FR-10): plain-language "what is a provider" line under the
   card title; wraps like the step rows do on narrow terminals. */
.console-setup-modal-subtitle {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0;
    color: $ds-text-muted;
}

.console-setup-modal-action {
    width: auto;
    min-width: $ds-size-12;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $ds-focus-bg;
    color: $ds-text-primary;
    content-align: left middle;
}

.console-setup-modal-action:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

#console-chat-tabs {
    display: none;
}

#console-session-surface .chat-empty-state {
    min-height: $ds-size-5;
    padding: $ds-space-0 $ds-space-1;
    text-align: left;
    content-align: left top;
    border-bottom: solid $ds-grid-line;
    background: $ds-surface-panel;
}

#console-session-surface .chat-log {
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-panel;
    border: tall $ds-grid-line;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
    scrollbar-size: 1 1;
}

#console-send-message,
#console-stop-generation {
    width: $ds-size-6;
    min-width: $ds-size-6;
}

/* Attach and Save Chatbook moved into the composer's ☰ menu, so their
   sizing rules went with them -- a fixed width for a button that no
   longer renders is dead weight the next reader has to disprove. */
#console-send-message,
#console-stop-generation {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

#console-stop-generation.console-stop-active {
    border: none;
    background: $ds-status-warning 20%;
    color: $ds-text-primary;
    text-style: bold;
}

.console-control-label,
.console-staged-context-row,
.console-staged-context-summary,
.console-staged-context-recovery {
    width: auto;
    min-width: $ds-size-0;
    height: auto;
}

/* Subsection labels inside the Selected turn block. Quieter than a section
   heading, louder than a body row -- they were previously indistinguishable
   from the rows they label. */
.console-selected-turn-subsection {
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-style: bold;
    color: $ds-text-muted;
}

/* task-9: Inspector retrieval-scope row -- sibling of the Sources tray,
   never a row inside it. */
#console-retrieval-scope-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

/* TASK-24607: the row above is capped at `max-height: 1`, so a label that
   wraps loses its second line silently -- at 120 columns the label is
   allotted 11 cells, "Scope: everything" wrapped at the space, and the rail
   painted a bare "Scope:" two rows below the authority block's full
   "Scope: Everything available". Elide instead of wrapping, matching
   `.console-settings-row`, which already declares both of these. */
.console-retrieval-scope-label {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    color: $ds-text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* TASK-24607: `width: auto` alone does not shrink a Textual Button -- its
   DEFAULT_CSS carries `min-width: 16`, so this 7-glyph "Narrow…" claimed 16
   of the row's 30 cells and left the label 11, which is what forced the
   wrap. Sizing to content gives the label 20 and "Scope: everything" fits
   whole at every supported width. */
.console-retrieval-scope-action {
    width: auto;
    min-width: $ds-size-0;
    margin-left: $ds-space-1;
}

.console-compact-model-bar {
    width: auto;
    min-width: $ds-size-0;
}

/* TASK-1801: disabled composer-menu rows were unreadable -- measured 1.05:1
   and 1.25:1 in the running app, against enabled rows at 12.63:1.

   Two dimmers compound. The theme sets `text-disabled: auto 38%` (alpha over
   the panel, ~3.4:1 alone), and Textual's Button adds `text-style: bold dim`
   plus `color: auto 50%` on its disabled variant
   (`textual/widgets/_button.py`), halving intensity again. Across every
   shipped theme that puts ALL 58 below 3:1 -- including
   `high_contrast_yellow_black`.

   This MUST live in the app stylesheet, not the modal's DEFAULT_CSS: both
   Button's rules and a screen's DEFAULT_CSS sit in the same DEFAULT_CSS
   tier, where Button wins for a Button. App CSS outranks all of it. That is
   why the sibling `.console-action-disabled` rules below work and an
   identical rule inside the modal did not -- verified by measuring the
   running app both ways, not by reading specificity.

   The Console states every temporary-chat restriction on a disabled row, so
   an illegible disabled label voids that whole convention. Disabled stays
   plainly dimmer than enabled (12.63:1) so the state is still obvious. */
/* TASK-25825: six actions previously cost ~30 rows -- `height: 3` plus a
   trailing `margin-bottom: 1` on every row -- and every label was centred,
   so the list scanned badly and occluded the transcript to present very
   little. The trailing gap also pushed each disabled row's explanatory
   reason a blank line away from the row it explains, weakening exactly the
   association that reason exists to make.

   Declared HERE and not in the modal's DEFAULT_CSS for the reason the
   sibling `:disabled` rule below is: Button's own rules outrank a modal's
   DEFAULT_CSS, where an identical rule measured no change. */
.console-composer-menu-item {
    text-align: left;
    margin: $ds-space-0;
}

.console-composer-menu-item:disabled {
    text-style: none;
    text-opacity: 1;
    color: rgb(245,245,245);
}

/* ===== MODULE: features/_console_panels.tcss ===== */
/* ========================================
 * FEATURES: Console panels
 * ========================================
 * ADR-161 task 10: the console-* side-panel vocabulary (inspector,
 * staged sources, prompts, activity, scope, the Console's settings pane,
 * character context) extracted from components/_agentic_terminal.tcss
 * and tokenized on arrival. Splits from features/_console.tcss only to
 * meet the 2,000-active-line sheet ceiling (spec 3.5); the pair is one
 * vocabulary, console-surface scoped. ======================================== */


#console-settings-modal {
    width: $ds-size-120;
    max-width: $ds-percent-95;
    height: $ds-percent-94;
    max-height: $ds-percent-95;
    overflow: hidden;
    scrollbar-size: 1 1;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: $ds-space-1 $ds-space-2;
}

/* TASK-31665 AC#15: visible scrollbar thumb. `$ds-grid-line` on a
   `$ds-surface-panel` track measured 1.01:1 -- a scroller advertising a fold
   it cannot show a position for. `$ds-text-muted` is the app's established
   thumb token, generated per theme polarity; `scrollbar-color-active` keeps
   the accent so a drag still reads as a drag. Applied to five more scrollers
   below (same rationale). */
#console-settings-body {
    height: $ds-height-fill;
    min-height: $ds-size-0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-text-muted;
    scrollbar-color-hover: $ds-text-muted;
    scrollbar-color-active: $ds-action-focus;
}

.console-settings-modal-section {
    height: auto;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

#console-settings-provider-model-section,
#console-settings-connection {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
}

.console-settings-primary-section {
    padding: $ds-space-0 $ds-space-1;
    border: round $ds-action-focus;
    background: $ds-surface-raised;
}

.console-settings-modal-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-1;
}

.console-settings-modal-label {
    width: $ds-size-23;
    min-width: $ds-size-10;
    max-width: $ds-size-23;
    height: auto;
    min-height: $ds-size-3;
    content-align: left middle;
    text-wrap: wrap;
}

.console-settings-control {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    max-width: $ds-percent-75;
}

.console-settings-modal-actions {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-3;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    align-horizontal: right;
}

#console-settings-connection-actions {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
}

#console-settings-model-custom {
    width: $ds-size-18;
    min-width: $ds-size-18;
    max-width: $ds-size-18;
}

#console-settings-model-discover {
    width: $ds-size-31;
    min-width: $ds-size-31;
    max-width: $ds-size-31;
}

#console-settings-readiness-panel,
#console-settings-model-discover-scope,
#console-settings-model-discover-status,
#console-settings-readiness,
#console-settings-generation-confirmation,
#console-settings-generation-consent-copy,
#console-settings-generation-test-status {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    text-wrap: wrap;
}

.console-settings-view-tab {
    background: $ds-surface-raised;
    color: $ds-text-muted;
}

.console-settings-view-tab.console-settings-view-active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

.console-settings-action-scope,
.console-settings-disabled-reason {
    height: auto;
    min-height: $ds-size-1;
    content-align: right middle;
}

.console-settings-action-scope {
    color: $ds-text-muted;
}

.console-settings-scope {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
    text-wrap: wrap;
}

.console-settings-disabled-reason {
    color: $ds-status-warning;
    text-style: bold;
}

#console-settings-cancel,
#console-settings-save,
#console-settings-save-default {
    width: auto;
    min-width: $ds-size-12;
    height: $ds-size-1;
    min-height: $ds-size-1;
}

#console-settings-save-default {
    min-width: $ds-size-29;
}

ConsoleSettingsModal.-conversation-settings-compact #console-settings-connection-actions,
ConsoleSettingsModal.-conversation-settings-compact #console-settings-actions {
    layout: vertical;
    height: auto;
    align-horizontal: left;
}

ConsoleSettingsModal.-conversation-settings-compact #console-settings-connection-actions > .console-settings-modal-label {
    display: none;
}

ConsoleSettingsModal.-conversation-settings-compact Button.console-settings-connection-action {
    width: $ds-width-full;
    min-width: $ds-size-0;
    max-width: $ds-width-full;
}

ConsoleSettingsModal.-conversation-settings-compact Button.console-settings-connection-action {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

.console-settings-error {
    height: auto;
    min-height: $ds-size-1;
    max-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-status-error 10%;
    color: $ds-text-primary;
}

#console-prompt-picker-modal {
    width: $ds-size-76;
    max-width: $ds-percent-95;
    height: auto;
    max-height: $ds-percent-85;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: $ds-space-1 $ds-space-2;
}

#console-prompt-picker-filter {
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-prompt-picker-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

#console-prompt-picker-results {
    height: auto;
    max-height: $ds-size-20;
    min-height: $ds-size-0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

.console-prompt-picker-row {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-prompt-picker-row-highlighted {
    border: tall $ds-action-focus;
    background: $ds-input-focus-bg;
    text-style: bold;
}

.console-prompt-picker-row-blocked {
    color: $ds-text-muted;
}

#console-prompt-picker-reason {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-status-error 10%;
    color: $ds-text-primary;
}

#console-prompt-picker-empty {
    height: auto;
    margin: $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

#console-system-prompt-modal {
    width: $ds-size-84;
    max-width: $ds-percent-95;
    height: $ds-size-32;
    max-height: $ds-percent-90;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: $ds-space-1 $ds-space-2;
}

.console-system-prompt-row {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.console-system-prompt-label {
    width: $ds-size-8;
    min-width: $ds-size-8;
    max-width: $ds-size-8;
    height: $ds-size-1;
    min-height: $ds-size-1;
    content-align: left middle;
}

#console-system-prompt-scope {
    color: $ds-text-muted;
}

#console-system-prompt-text {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-10;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-system-prompt-text:focus {
    border: tall $ds-input-focus-accent;
    background: $ds-input-focus-bg;
}

#console-system-prompt-name {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-3;
    min-height: $ds-size-3;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-system-prompt-save-status {
    color: $ds-text-muted;
}

.console-system-prompt-actions {
    height: $ds-size-3;
    min-height: $ds-size-3;
    align-horizontal: right;
}

#console-run-log-modal {
    width: $ds-size-96;
    max-width: $ds-percent-95;
    height: $ds-size-36;
    max-height: $ds-percent-90;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: $ds-space-1 $ds-space-2;
}

#console-run-log-text {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-10;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-run-log-actions {
    height: $ds-size-3;
    min-height: $ds-size-3;
    align-horizontal: right;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

#console-system-prompt-clear,
#console-system-prompt-cancel,
#console-system-prompt-apply {
    width: $ds-size-12;
    min-width: $ds-size-12;
    height: $ds-size-3;
    min-height: $ds-size-3;
}

#console-workbench-header {
    /* The destination identity header is the visible Console header (ADR-015);
       layout comes from .workbench-header in _workbench.tcss. */
    height: auto;
    min-height: $ds-size-2;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
}

#console-workbench-header.console-header-inline {
    layout: horizontal;
    height: $ds-size-1;
    min-height: $ds-size-1;
    border: none;
}

#console-workbench-header.console-header-inline .workbench-header-title {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
}

#console-workbench-header.console-header-inline .workbench-header-subtitle {
    /* Keep the subtitle visible in compact density too: the shared
       `.density-compact .workbench-header-subtitle { display: none }` hid it to
       save a row in the old stacked header, but the inline header is one row at
       any density, so hiding it only wastes the horizontal space. This id+class
       rule (1,2,0) beats that density rule (0,2,0). */
    display: block;
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    margin: $ds-space-0 $ds-space-1;
}

#console-workbench-header.console-header-inline .workbench-header-status {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
}

#console-workbench-mode-strip,
#console-workbench-command-strip {
    display: none;
    height: $ds-size-0;
    min-height: $ds-size-0;
    max-height: $ds-size-0;
    padding: $ds-space-0;
    margin: $ds-space-0;
    border: none;
}

/* The policy label has two independent axes (or an explicit unavailable
   state), so it needs more room than ordinary metadata chips. */
#console-library-chip {
    max-width: $ds-size-48;
}

#console-staged-context-tray,
#console-session-context,
#console-workspaces-context,
#console-workspace-context,
#console-run-inspector {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-height-full;
    min-height: $ds-size-0;
}

#console-staged-context-tray,
#console-session-context,
#console-workspaces-context,
#console-workspace-context {
    width: $ds-width-full;
    min-width: $ds-size-0;
}

#console-staged-context-tray {
    height: auto;
    min-height: $ds-size-0;
}

#console-session-context,
#console-workspaces-context,
#console-workspace-context {
    height: auto;
    min-height: $ds-size-0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-conversation-browser-section-header {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    layout: horizontal;
    align: left middle;
}

.console-conversation-browser-section-title {
    width: $ds-width-fill;
    min-width: $ds-size-0;
}

.console-conversation-browser-group-header {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    layout: horizontal;
    align: left middle;
}

.console-conversation-browser-group-title {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    color: $ds-text-muted;
}

.console-conversation-browser-row-line {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    layout: horizontal;
}

.console-conversation-star {
    width: $ds-size-3;
    min-width: $ds-size-3;
    max-width: $ds-size-3;
    height: $ds-size-2;
    min-height: $ds-size-2;
    margin: $ds-space-0 $ds-space-1 $ds-space-1 $ds-space-0;
}

/* TASK-31663 AC#4: the thumb measured 1.01:1 against its own track. It must
   clear the 3:1 non-text floor and nothing in the surface family does on
   this theme ($ds-column-line 1.28:1, $panel-lighten-3 2.16:1), so it takes
   $ds-text-muted -- the app's other established thumb token, generated per
   theme polarity. See TASK-31663 notes. */
#console-inspector-rail-body {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-height-fill;
    min-height: $ds-size-0;
    padding: $ds-space-0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-text-muted;
    scrollbar-color-hover: $ds-text-muted;
    scrollbar-color-active: $ds-action-focus;
}

#console-inspector-more,
#console-inspector-more-body {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-0;
}

#console-inspector-more-toggle {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    text-align: left;
}

#console-staged-context-tray,
#console-session-context,
#console-workspaces-context,
#console-workspace-context,
#console-run-inspector {
    border: solid $ds-column-line;
    background: $ds-surface-panel;
}

#console-staged-context-tray.console-frame-quiet,
#console-session-context.console-frame-quiet,
#console-workspaces-context.console-frame-quiet,
#console-workspace-context.console-frame-quiet {
    border: none;
    background: $ds-surface-panel;
}

#console-run-inspector {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-0;
    border: none;
}

#console-run-inspector-state {
    height: auto;
    min-height: $ds-size-0;
}

/* TASK-24700: TASK-24605 lowered the OPEN rail's floor from 20 to 12 because
   a 24-row terminal allots it 13 and a 20-row minimum made it lay out
   against 20 and clip -- but it left this, the COLLAPSED form, at 20. The
   collapsed handle is the rail's shipping default state, so the half that
   users meet first kept the defect the fix was written for. Same floor as
   the rail it stands in for. */
.console-inspector-rail-handle {
    height: $ds-height-full;
    min-height: $ds-size-12;
    max-height: $ds-height-full;
    background: $ds-surface-panel;
}

.console-switcher-result:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Keep focused search one row. */
#console-switcher-query,
#console-switcher-query:focus {
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    border: none;
    outline: none;
    padding: $ds-space-0;
}

#console-switcher-query:focus,
.console-switcher-mode-current,
.console-switcher-result-candidate {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}

#console-switcher-query:focus {
    border-left: thick $ds-action-focus;
    text-style: bold;
}

#console-switcher-modal {
    border: tall $ds-grid-line;
    border-title-color: $ds-text-primary;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

#console-switcher-scope,
#console-switcher-selected-detail,
#console-switcher-page-status,
#console-switcher-hints {
    color: $ds-text-muted;
}

.console-switcher-result-error {
    border-left: solid $ds-status-error;
}

#console-character-avatar-frame {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-0;
    align: center middle;
}

/* TASK-31244: Character rows are compact, cell-clipped peers inside the
   section's existing bounded viewport. The widget itself introduces no
   additional scroll owner. */
#console-character-context {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-0;
}

#console-character-search {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-3;
    min-height: $ds-size-3;
    max-height: $ds-size-3;
}

.console-character-group,
.console-character-row,
.console-character-action,
#console-character-query-handoff,
#console-character-retry,
#console-character-open-roleplay {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    padding: $ds-space-0;
    text-align: left;
    content-align: left middle;
    text-overflow: ellipsis;
}

.console-character-group:focus,
.console-character-row:focus,
.console-character-action:focus,
#console-character-retry:focus,
#console-character-open-roleplay:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

#console-character-context .console-character-search-row {
    height: $ds-size-3;
    min-height: $ds-size-3;
    max-height: $ds-size-3;
}

.console-character-empty,
#console-character-loading,
#console-character-error,
#console-character-unavailable-reason {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-overflow: ellipsis;
}

#console-character-context .console-character-row.-opening {
    text-style: italic;
}

/* TASK-24612: the Inspect rail's Tab cycle contains two CONTAINERS as well
   as its controls -- the outer scroller and the rail root. Both are focus
   targets on purpose (the scroller so the keyboard can scroll it, the root
   because it is the pane F6 lands on, `right_rail.can_focus = True` at
   compose), but neither had a `:focus` rule of its own. A measured focus
   walk found their entire visible indication was a single frame glyph and,
   for a nested viewport, a lit scrollbar column. The bounded-section
   viewport above already models the right treatment; these now share it, so
   a keyboard user can see which region holds focus rather than inferring it
   from one recoloured border cell. `:focus` only -- NOT `:focus-within`:
   these two contain every other stop in the rail, so tinting them whenever
   a descendant has focus would leave the whole rail permanently tinted and
   destroy the signal it is meant to carry. */
/* TASK-24702: a LEFT EDGE, not a background tint and not a full outline.
   Three measurements decided this.

   1. A tint cannot carry the cue here. `$ds-action-focus 12%` measured
      1.35:1 against the rail ground and 1.11:1 against the pinned card;
      45% reaches ~1.74:1; even a fully opaque accent is only 3.77:1 on this
      near-black theme. To clear WCAG's 3:1 non-text floor a tint has to be
      ~85-90% opaque -- a solid block behind the text, not a tint.
   2. A full outline DOES clear it (3.77:1 / 3.01:1) and is what DESIGN.md
      prescribes -- the pinned authority summary already proves it works,
      one widget away. But `outline` paints over the widget's own edge
      cells, and at 80x24 this scroller's body is THREE rows; a top and
      bottom border would claim two of them.
   3. A one-column left edge costs one column instead of two rows, clears
      the same 3.77:1 because it is the same colour, and is already the
      house pattern -- DESIGN.md's dense-form convention flips exactly this
      edge to `thick $ds-action-focus` on focus. The rail is 33 columns at
      120 and narrower; a column is affordable where two of three rows is
      not. */
#console-inspector-rail-body:focus,
#console-right-rail:focus {
    outline-left: thick $ds-action-focus;
}

/* The COLLAPSED rail's handle -- the shipping default state, and before this
   rule focusing it changed nothing at all. RIGHT edge, measured not
   stylistic: the shell clips this button's leading pad, so col 0 carries the
   "◂" of "◂ Inspect" while the last column is always blank. A left edge would
   paint "█ Inspect". See TASK-31663 notes. */
#console-inspector-rail-open:focus {
    outline-right: thick $ds-action-focus;
}

.console-model-section-line {
    height: auto;
    min-height: $ds-size-1;
}

.console-model-section-label {
    width: $ds-size-12;
    min-width: $ds-size-12;
    color: $ds-text-muted;
}

.console-model-section-value {
    width: $ds-width-fill;
    min-width: $ds-size-10;
    color: $ds-value-fg;
}

#console-model-section-provider .console-model-section-value,
#console-model-section-model .console-model-section-value {
    text-wrap: wrap;
    max-height: $ds-size-3;
    overflow: hidden;
}

#console-model-section-temperature .console-model-section-value,
#console-model-section-max-tokens .console-model-section-value {
    text-wrap: nowrap;
}

#console-model-section-recovery {
    /* TASK-31429: this line is READ, not glanced -- readable error variant
       (design-language rule: readable beats decorative). */
    color: $ds-status-error-readable;
}

.console-agent-section-line {
    height: $ds-size-1;
    color: $ds-text-primary;
}

/* TASK-31429 (rail colour grammar): the Agent status line's run status
   (`apply_console_agent_status_state`) maps to the same status tokens the
   Inspector's fleet rows already use; idle/unavailable carry no class. */
.console-agent-section-status-running {
    color: $ds-status-running;
}

.console-agent-section-status-done {
    color: $ds-status-ready;
}

.console-agent-section-status-stuck {
    color: $ds-status-warning;
}

.console-agent-section-status-error,
.console-agent-section-status-cancelled {
    color: $ds-status-error-readable;
}

.console-agent-section-steps {
    height: auto;
    color: $ds-text-muted;
    text-style: dim;
}

/* PR2b Task 4: `.console-agent-section-subagents` retired -- the plain
   Static this class styled at `#console-agent-section-subagents` was
   replaced by a `ConsoleInspectorSection` (styled entirely by its own
   `.console-inspector-section*` rules above); nothing composes this class
   anymore. */

.console-agent-section-fleet-summary {
    height: auto;
    color: $ds-status-running;
    text-style: dim;
}

.console-agent-drilldown-back {
    margin-top: $ds-space-1;
}

.console-inspector-group-heading {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-inspector-status-summary {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-inspector-action {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
}

/* TASK-24606: this used to be `height: 0` -- the authored reason for a
   disabled action was mounted and then collapsed to nothing. It is now a
   real row. Muted because it is secondary to the action it explains, but
   NOT dimmed: DESIGN.md's Legible Disabled Rule documents `dim` compounding
   with an alpha token to below 3:1, and this line is the only place several
   restrictions are explained at all. */
.console-inspector-disabled-reason {
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
}

/* TASK-24606 + the Legible Disabled Rule. Textual's `Button:disabled` adds
   `text-style: bold dim` AND `color: auto 50%`, and a widget's own
   DEFAULT_CSS cannot beat it -- both sit in the same tier, where `Button`
   wins for a `Button`. The override therefore lives here, in the app
   stylesheet, and states a colour bright enough to survive that halving.
   `text-style: none` does NOT clear Textual's `dim` (measured), so the
   colour has to carry it. Disabled must still read as clearly quieter than
   enabled, which it does: enabled inspector actions render at full
   `$ds-text-primary` on the action background. */
Button.console-inspector-action:disabled {
    color: $ds-text-primary;
    text-opacity: 100%;
}

/* PR2b Task 3: the reusable Inspector-style section component (header +
   optional chevron + optional right-aligned summary, row body, optional
   "View all" tail). Ships the grammar once -- Agents (Task 4) is the first
   consumer; Changes/Sources/Workspace sections follow later against these
   same classes (spec section 7). */
.console-inspector-section {
    height: auto;
    min-height: $ds-size-0;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.console-inspector-section-header {
    height: $ds-size-1;
    min-height: $ds-size-1;
    layout: horizontal;
    align: left middle;
}

.console-inspector-section-title {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    text-style: bold;
    color: $ds-text-primary;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.console-inspector-section-summary {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    color: $ds-text-muted;
    text-align: right;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.console-inspector-section-toggle {
    width: $ds-size-3;
    min-width: $ds-size-3;
    height: $ds-size-1;
    text-style: bold;
}

.console-inspector-section-toggle:focus {
    background: $ds-action-focus 30%;
    text-style: underline bold;
}

.console-inspector-section-body {
    height: auto;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
}

/* TASK-31662: one line per row unless its pair needs two (see
   `ConsoleInspectorSectionRow`). A floor of `2` left 25% of the Environment
   section's row-lines blank. */
.console-inspector-section-row {
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}

/* The one-line form's inner row: primary (1fr) + secondary (auto), the
   same split the section header uses for title + summary. */
.console-inspector-section-row-line {
    width: $ds-width-full;
    height: $ds-size-1;
}

.console-inspector-section-row:focus {
    background: $ds-action-focus 20%;
}

.console-inspector-section-row-primary {
    height: $ds-size-1;
    color: $ds-text-primary;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* TASK-31665 AC#9: no `text-style: dim` -- it DOUBLE-dimmed an already-muted
   token to 3.42:1 (AA fail) where sibling muted strings paint 5.91:1. `dim`
   is a real second step (~65% fg retained), not a no-op. */
.console-inspector-section-row-secondary {
    height: $ds-size-1;
    color: $ds-text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* Status-colored variants of the row's PRIMARY line only -- the secondary
   (dimmed detail) line stays muted regardless of status. Class names are
   built via f-string interpolation in console_inspector_section.py, which
   is out of scope for test_css_class_coverage_contract.py by design (its
   docstring: "f-strings ... are out of scope"); these rules are shipped
   for real styling, not to satisfy that contract.

   DESCENDANT, not child (`>`), since TASK-31662: the one-line form nests
   the primary in `.console-inspector-section-row-line`, so `>` silently
   dropped the status colour for every row sharing a line. */
.console-inspector-section-row-running .console-inspector-section-row-primary {
    color: $ds-status-running;
}

.console-inspector-section-row-done .console-inspector-section-row-primary {
    color: $ds-status-ready;
}

/* TASK-31664 (a11y): this text must be READ (a failing-check name), so it
   takes the READABLE token. $ds-status-error is $error at 3.06:1 (AA fail);
   $ds-status-error-readable is the per-theme $text-error. */
.console-inspector-section-row-error .console-inspector-section-row-primary {
    color: $ds-status-error-readable;
}

/* The row the critique measured at 2.53:1 carries status="blocked", NOT
   "error", so the rule above never reached it. Both are must-be-READ states
   and deliberately share one readable token. See TASK-31664 notes. */
.console-inspector-section-row-blocked .console-inspector-section-row-primary {
    color: $ds-status-error-readable;
}

/* TASK-31665 AC#5: no top margin. With the section's own bottom margin the
   tail button floated between two blank lines, "orphaned ~28 lines from its
   data"; flush under the last row makes its owner unambiguous. */
.console-inspector-section-row-stuck > .console-inspector-section-row-primary {
    color: $ds-status-warning;
}

.console-inspector-section-row-cancelled > .console-inspector-section-row-primary {
    color: $ds-text-muted;
}

.console-inspector-section-view-all {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
}

/* Context (staged sources) section pinned at the top of the Inspector rail
   body (task-400): bottom margin separates it from the run inspector below. */
.console-inspector-context-section {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
}

.console-settings-summary {
    height: auto;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
}

.console-inspector-session-settings {
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $ds-surface-panel;
}

.console-settings-header {
    height: $ds-size-1;
    min-height: $ds-size-1;
    layout: horizontal;
    align: left middle;
}

/* TASK-24609: this declared neither weight nor colour, and the
   `destination-section` class it also carries has no rule in scope inside
   the rail, so "Session Settings" rendered identically to the eight
   `.console-settings-row` lines it heads and the section boundary was
   invisible. Same treatment as `.console-rail-section-title`, which is the
   one heading style every section title in this rail should share. */
.console-settings-title {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    text-style: bold;
    color: $ds-text-primary;
}

.console-settings-row {
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    overflow: hidden hidden;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#console-settings-open {
    width: auto;
    min-width: $ds-size-9;
    max-width: $ds-size-14;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
}

#console-prompt-improvement-recovery {
    display: none;
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    layout: horizontal;
    align: right middle;
}

#console-prompt-improvement-status {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    color: $ds-status-ready;
    content-align: left middle;
    padding: $ds-space-0 $ds-space-1;
}

#console-prompt-improvement-undo {
    width: $ds-size-8;
    min-width: $ds-size-8;
}

#console-prompt-improvement-review {
    width: $ds-size-16;
    min-width: $ds-size-16;
}

#console-command-visible-text {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-1;
    /* TASK-17654: moves with ConsoleComposerBar.MAX_DRAFT_ROWS. */
    max-height: $ds-size-8;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    overflow: hidden;
}

#console-command-input {
    display: none;
    width: $ds-size-0;
    min-width: $ds-size-0;
    height: $ds-size-0;
    min-height: $ds-size-0;
}

/* TASK-19426: one causal Assistant turn owns its activity disclosures,
   final answer, and adjuncts. The left-edge ownership accent is singular;
   nested activity rows stay quiet so they read as evidence inside the turn
   rather than as neighboring transcript cards. */
.console-assistant-turn {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1 $ds-space-1 $ds-space-1;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.-dark-mode .console-assistant-turn {
    border-left: tall $ds-chat-assistant-accent-dark;
}

.-light-mode .console-assistant-turn {
    border-left: tall $ds-chat-assistant-accent-light;
}

.console-assistant-turn > .console-message-header,
.console-assistant-activity-stack,
.console-assistant-adjunct-stack {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-0;
}

.console-assistant-turn > .console-message-header {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

.console-assistant-activity-stack {
    padding: $ds-space-0 $ds-space-1;
}

.console-assistant-turn > .console-transcript-message {
    width: $ds-width-full;
    height: auto;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

/* Selection belongs to the answer, not its entire ownership surface. */
.console-assistant-turn > .console-transcript-message-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}

.console-activity-disclosure {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-activity-header {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    overflow: hidden;
}

.console-activity-label {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    overflow: hidden;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.console-activity-status {
    width: $ds-size-9;
    min-width: $ds-size-9;
    max-width: $ds-size-9;
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-align: right;
    text-style: bold;
}

.console-activity-status-success {
    background: $ds-status-ready 10%;
    color: $ds-text-primary;
}

.console-activity-status-blocked {
    background: $ds-status-blocked 16%;
    color: $ds-text-primary;
}

/* task-32279: the three narrowed refusal states. They share the blocked
   tint on purpose -- which authority refused is carried by the WORD, never
   by colour -- and each widens the standard nine-cell column to fit that
   word, the same way the proprietary-thinking state below already does. */
.console-activity-status-denied,
.console-activity-status-blocked_off {
    background: $ds-status-blocked 16%;
    color: $ds-text-primary;
    width: $ds-size-15;
    min-width: $ds-size-15;
    max-width: $ds-size-15;
}

.console-activity-status-blocked_kill_switch {
    background: $ds-status-blocked 16%;
    color: $ds-text-primary;
    width: $ds-size-23;
    min-width: $ds-size-23;
    max-width: $ds-size-23;
}

.console-activity-status-failed {
    background: $ds-status-error 16%;
    color: $ds-text-primary;
}

.console-activity-status-done {
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-activity-status-live {
    background: $ds-status-running 12%;
    color: $ds-text-primary;
}

.console-activity-status-stopped,
.console-activity-status-unavailable {
    background: $ds-status-warning 12%;
    color: $ds-text-primary;
}

/* The proprietary-thinking state is the only status longer than the
   standard nine-cell column. Preserve its literal non-color cue instead of
   clipping the header to a warning tint and midpoint. */
.console-activity-status-unavailable {
    width: $ds-size-13;
    min-width: $ds-size-13;
    max-width: $ds-size-13;
}

/* These height-one headers opt out of the global outline because it would
   paint over their only content row. Text + background + underline provide
   the non-color focus cue without changing geometry in either theme. */
.console-activity-header:focus {
    outline: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.console-activity-header-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

.console-activity-header:focus > .console-activity-status,
.console-activity-header-selected > .console-activity-status {
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-style: bold underline;
}

.console-activity-disclosure-selected > .console-activity-action-stack {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}

.console-activity-action-stack {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
}

.console-activity-detail-stack {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-0;
    margin: $ds-space-0 $ds-space-1 $ds-space-1 $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.console-activity-disclosure-expanded > .console-activity-detail-stack {
    background: $ds-surface-panel;
}

.console-activity-detail-stack .console-transcript-message {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-0;
    background: transparent;
}

.console-activity-detail-stack .console-transcript-tool-diff {
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-2;
}

ChatScreen.-focus #console-workbench-header {
    display: none;
}

.console-action-primary {
    border: none;
    height: $ds-size-1;
    min-height: $ds-size-1;
    background: $ds-action-focus 35%;
    color: $ds-text-primary;
    text-style: bold;
}

.console-action-secondary {
    border: none;
    height: $ds-size-1;
    min-height: $ds-size-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.console-action-subdued {
    border: none;
    height: $ds-size-1;
    min-height: $ds-size-1;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: none;
}

.console-action-disabled {
    border: none;
    height: $ds-size-1;
    min-height: $ds-size-1;
    background: $ds-surface-panel;
    color: $ds-text-disabled;
    text-style: none;
}

.console-action-disabled:hover,
.console-action-disabled:focus,
.console-action-disabled:hover:focus {
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-disabled;
    text-style: none;
    outline: none;
}

.console-staged-context-header {
    height: auto;
    min-height: $ds-size-1;
}

#console-staged-context-title {
    width: $ds-width-fill;
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-style: bold;
}

#console-staged-context-count {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-align: right;
    color: $ds-text-muted;
}

.console-staged-source-row {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0;
}

.console-staged-source-primary {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    border: none;
    padding: $ds-space-0;
    text-align: left;
    background: transparent;
    color: $ds-text-primary;
}

.console-staged-source-primary:hover,
.console-staged-source-primary:focus {
    border: none;
    background: $ds-action-focus 18%;
    text-style: bold;
}

.console-staged-source-primary-ready { color: $ds-status-ready; }
.console-staged-source-primary-warning { color: $ds-status-warning; }
.console-staged-source-primary-listed { color: $ds-status-paused; }  /* TASK-32330: muted tone for listed-not-sent rows */
.console-staged-source-primary-blocked { color: $ds-status-blocked; }

.console-staged-source-detail {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
}

.console-staged-source-detail Static {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
}

.console-staged-source-snippet {
    color: $ds-text-primary;
}

.console-staged-source-authority,
.console-staged-source-freshness,
.console-staged-source-action-copy {
    color: $ds-text-muted;
}

.console-staged-source-action {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    border: none;
    padding: $ds-space-0;
    background: transparent;
    color: $ds-action-focus;
}

.console-staged-source-name {
    text-wrap: wrap;
    max-height: $ds-size-2;
    overflow: hidden;
}

.console-staged-source-status {
    height: $ds-size-1;
    color: $ds-text-muted;
}

.console-staged-source-status.ready { color: $ds-status-ready; }
.console-staged-source-status.running { color: $ds-status-running; }
.console-staged-source-status.blocked { color: $ds-status-blocked; }

/* TASK-24608: run-inspector rows carry the same status vocabulary the tray
   above uses, and until now NOTHING in the repo defined any of these -- the
   class was built by f-string, swapped on every in-place update, and covered
   by passing tests while painting exactly nothing. The visible cost was on
   the rows whose TEXT does not repeat the status: "Approvals: 3 pending"
   carries status "blocked" and was pixel-identical to "Approvals: 0 pending".
   Colour is reinforcement only here -- every row still reads as blocked from
   its own words -- so this follows The Label Before Color Rule rather than
   becoming the sole carrier. `muted` is the normalizer's fallback and stays
   at the default row colour deliberately: an unrecognised status must not
   borrow the authority of a measured one. */
.console-inspector-row-ready { color: $ds-status-ready; }
.console-inspector-row-running { color: $ds-status-running; }
.console-inspector-row-blocked { color: $ds-status-blocked; }
.console-inspector-row-muted { color: $ds-text-muted; }

/* TASK-24700: the OUTER fold hint ("more sections below") had no rule at all
   while the LOCAL one (.console-bounded-section-hint) is muted + italic, so
   the more important of the two indicators painted as plain body text and
   read louder than the less important one. Same treatment, minus the
   `display: none` -- this hint's visibility is owned by the rail's fold
   reconcile, not by CSS. */
.console-inspector-outer-scroll-hint {
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $ds-text-muted;
    text-style: italic;
}

/* TASK-24701: second wave of the TASK-24608 defect -- classes attached in
   Python with no rule behind them. This one is the worst of the set: it
   carries a Library operation's `error_summary`, so a FAILED retained write
   rendered in the same colour as a successful one. */
.console-library-activity-error {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-status-error;
}

.console-library-activity-action,
.console-library-activity-source-ref {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
}

/* TASK-24609: rows start in the same column as the heading that labels
   them. The first attempt gave ROWS `padding: 0 0 0 1` to meet the heading.
   That was wrong in a way only the geometry tests caught: it costs every
   inspector row one column of content width, and at the rail's 46-column
   measured width two live-work rows wrapped that had previously fit, moving
   the bounded section's row demand from 20 to 22. The heading gives up its
   indent instead -- alignment for free, and the raised background still
   spans the full row. */
.console-inspector-group-heading {
    padding: $ds-space-0;
}

#console-staged-context-empty {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
}

/* RAG UX v2 PR-4 (task-1): the staged-evidence strip -- the MAIN-surface
   reader of the pending live-work launch, mounted directly above the
   composer (the status chips sit below the composer). Hidden entirely
   (`display` toggled from the widget)
   when nothing is staged, so it costs zero rows on the common path.
   M3 (final review): `min-height: 1` overrides the shared `.ds-panel`
   `min-height: 3` -- with 1-2 rows of real content (a header row plus N
   evidence rows) that left blank filler rows beneath the last row.
   Sibling to the `#console-status-chips` `min-height: 1` override above
   for the same reason on that other small fixed-content Console panel. */
#console-staged-evidence-strip {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-1;
    max-height: $ds-size-6;
    border: none;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
}

.console-staged-evidence-header {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    layout: horizontal;
}

.console-staged-evidence-heading {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    color: $ds-text-muted;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

.console-staged-evidence-unstage {
    width: auto;
    min-width: $ds-size-9;
    height: $ds-size-1;
    min-height: $ds-size-1;
    border: none;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.console-staged-evidence-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $ds-text-primary;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

.console-staged-evidence-row.blocked {
    color: $ds-status-blocked;
}

.console-staged-evidence-row.running {
    color: $ds-status-running;
}

.console-staged-evidence-row.muted {
    color: $ds-text-muted;
}

.console-staged-evidence-overflow,
.console-staged-evidence-notice {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $ds-text-muted;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

#console-scope-picker-modal {
    width: $ds-size-90;
    max-width: $ds-percent-95;
    height: auto;
    max-height: $ds-percent-90;
    border: round $ds-grid-line;
    background: $ds-surface-panel;
    padding: $ds-space-1 $ds-space-2;
}

.console-scope-picker-tabs {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.console-scope-picker-tab {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

.console-scope-picker-tab-active {
    background: $ds-action-focus;
    text-style: bold;
}

#console-scope-picker-text-filter {
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-scope-picker-text-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

.console-scope-picker-tag-row {
    height: auto;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.console-scope-picker-chip-row {
    height: auto;
    min-height: $ds-size-1;
}

#console-scope-picker-tag-search {
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-scope-picker-tag-search:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

.console-scope-picker-tag-chip {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

.console-scope-picker-tag-chip-active {
    background: $ds-action-focus;
    text-style: bold;
}

.console-scope-picker-sort-row {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.console-scope-picker-sort-label {
    width: $ds-size-6;
    min-width: $ds-size-6;
    content-align: left middle;
}

.console-scope-picker-view-row {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.console-scope-picker-view-btn {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

.console-scope-picker-view-active {
    background: $ds-action-focus;
    text-style: bold;
}

#console-scope-picker-list {
    height: $ds-height-fill;
    min-height: $ds-size-8;
    max-height: $ds-size-20;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
}

.console-scope-picker-row {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-primary;
}

.console-scope-picker-row-greyed {
    color: $ds-text-muted;
}

#console-scope-picker-empty {
    height: auto;
    margin: $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

.console-scope-picker-page-row {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0;
    align-horizontal: center;
}

#console-scope-picker-page-label {
    width: auto;
    min-width: $ds-size-12;
    content-align: center middle;
    margin: $ds-space-0 $ds-space-1;
}

.console-scope-picker-bulk-row {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#console-scope-picker-confirm-text {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-status-warning 10%;
    color: $ds-text-primary;
}

.console-scope-picker-confirm-actions {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.console-scope-picker-footer {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    align-horizontal: right;
}

#console-scope-picker-count {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    content-align: left middle;
    color: $ds-text-muted;
}

#console-prompts-modal {
    width: $ds-percent-90;
    max-width: $ds-size-104;
    height: $ds-percent-90;
    max-height: $ds-size-44;
    min-width: $ds-size-40;
    min-height: $ds-size-18;
    border: tall $ds-grid-line;
    background: $ds-surface-panel;
    padding: $ds-space-1 $ds-space-2;
}

#console-prompts-header {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-2;
    border-bottom: solid $ds-grid-line;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#console-prompts-title {
    height: $ds-size-1;
    color: $ds-text-primary;
    text-style: bold;
}

#console-prompts-location,
#console-prompts-model-status,
#console-prompts-browse-status {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
}

#console-prompts-body,
#console-prompts-browse {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

/* The editor follows a host status row inside a bounded Vertical. Use the
   remaining fraction instead of its standalone 100% height so its actions
   stay above the modal footer. */
#console-prompts-editor {
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

.console-prompts-primary-action {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    border: none;
    background: $ds-action-focus;
    color: $ds-text-primary;
    text-style: bold;
}

.console-prompts-primary-action:focus,
#console-prompts-modal Button:focus {
    outline: heavy $ds-action-focus;
}

.console-prompts-primary-action:disabled,
#console-prompts-modal Button:disabled {
    background: $surface-darken-1;
    color: $ds-text-disabled;
}

#console-prompts-browse-controls {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

#console-prompts-source {
    width: $ds-size-18;
    min-width: $ds-size-14;
    height: $ds-size-3;
    border: none;
    border-left: solid $ds-grid-line;
    background: $surface-darken-1;
}

#console-prompts-search {
    width: $ds-width-fill;
    min-width: $ds-size-12;
    height: $ds-size-3;
    border: none;
    border-left: solid $ds-grid-line;
    background: $surface-darken-1;
}

#console-prompts-source:focus,
#console-prompts-search:focus {
    border-left: thick $ds-action-focus;
    background: $ds-focus-bg;
    text-style: bold;
}

#console-prompts-retry {
    width: auto;
    min-width: $ds-size-8;
    height: $ds-size-3;
    border: none;
    background: $ds-surface-raised;
}

#console-prompts-results {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-4;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    border-top: solid $ds-grid-line;
    border-bottom: solid $ds-grid-line;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

#console-prompts-result-list {
    width: $ds-width-full;
    height: auto;
}

.console-prompts-result {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-3;
    border: none;
    border-bottom: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-align: left;
    content-align: left middle;
}

.console-prompts-result:hover,
.console-prompts-result:focus {
    background: $ds-focus-bg;
}

#console-prompts-pagination,
#console-prompts-footer {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    align: right middle;
}

#console-prompts-page {
    width: $ds-width-fill;
    min-width: $ds-size-12;
    height: $ds-size-3;
    content-align: center middle;
    color: $ds-text-muted;
}

#console-prompts-pagination Button,
#console-prompts-footer Button,
#console-prompts-improve-mode Button,
#console-prompts-convert {
    width: auto;
    min-width: $ds-size-8;
    height: $ds-size-3;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#console-prompts-footer {
    border-top: solid $ds-grid-line;
}

#console-prompts-dirty-guard {
    display: none;
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-1;
    border: round $ds-status-warning;
    background: $ds-status-warning 10%;
    color: $ds-text-primary;
}

#console-prompts-dirty-guard.visible {
    display: block;
}

#console-prompts-compatibility {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-2;
    color: $ds-status-warning;
}

#console-prompts-compat-system,
#console-prompts-compat-user {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-3;
    border: round $ds-grid-line;
    background: $surface-darken-1;
}

#console-prompts-improve-mode,
#console-prompts-recipe-mode {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

#console-prompts-improve-mode Button,
#console-prompts-recipe-mode Button {
    width: $ds-width-full;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

#console-prompts-recipe-outcome-description,
#console-prompts-recipe-saved-description,
#console-prompts-recipe-blank-description {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
}

#console-prompts-recipe-save-confirmation-panel {
    display: none;
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-0 $ds-space-1 $ds-space-1 $ds-space-1;
    border: round $ds-status-ready;
    background: $ds-status-ready 8%;
}

#console-prompts-recipe-save-confirmation {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-primary;
}

#console-prompts-open-saved-recipe {
    width: $ds-width-full;
    height: $ds-size-3;
}

ConsolePromptsModal.-narrow #console-prompts-modal {
    width: $ds-percent-96;
    height: $ds-percent-96;
    padding: $ds-space-0 $ds-space-1;
}

ConsolePromptsModal.-narrow #console-prompts-browse-controls {
    layout: vertical;
    height: $ds-size-6;
    min-height: $ds-size-6;
}

ConsolePromptsModal.-narrow #console-prompts-source,
ConsolePromptsModal.-narrow #console-prompts-search {
    width: $ds-width-full;
}

/* Slash-command completion popup: floats above the composer. Position,
 * offset, width, and height are set imperatively in
 * ConsoleCommandPopup.show_suggestions/reposition. */
#console-command-popup {
    position: absolute;
    display: none;
    background: $ds-surface-panel;
    padding: $ds-space-0 $ds-space-1;
}

/* Textual's default OptionList chrome (tall border + padding) costs two
 * rows and pushed every option row out of small popups (a 1-row popup had a
 * 0-row content region and painted an empty band). The popup itself carries
 * the background, so strip the inner chrome. */
#console-command-popup OptionList {
    border: none;
    padding: $ds-space-0;
}

/* Governed Console exchange capture surfaces (ADR-089). */
#console-library-access {
    width: $ds-size-76;
    max-width: $ds-percent-96;
    height: $ds-size-34;
    max-height: $ds-percent-96;
    min-width: $ds-size-0;
}

#console-library-access-body {
    height: $ds-height-fill;
    min-height: $ds-size-0;
    max-height: $ds-size-24;
    scrollbar-gutter: stable;
}

.console-library-access-actions {
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
}

#console-library-access .console-library-access-actions Button {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    border: none;
    padding: $ds-space-0;
    margin-right: $ds-space-1;
}

#console-rag-settings {
    width: $ds-size-64;
    max-width: $ds-percent-96;
    height: $ds-size-20;
    max-height: $ds-percent-96;
    min-width: $ds-size-0;
}

#console-rag-settings-body {
    height: $ds-height-fill;
    min-height: $ds-size-0;
    scrollbar-gutter: stable;
}

.console-rag-settings-item-scope {
    height: auto;
    color: $text-muted;
    margin-bottom: $ds-space-1;
}

.console-rag-settings-sources {
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    grid-rows: 1 1;
    height: $ds-size-2;
}

.console-rag-settings-actions {
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
}

#console-rag-settings .console-rag-settings-actions Button {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    border: none;
    padding: $ds-space-0;
    margin-right: $ds-space-1;
}

#console-inspector-policy-status {
    height: auto;
    color: $text-muted;
}
#console-agent-progress { width: $ds-width-fill; height: $ds-size-1; min-height: $ds-size-1; margin: $ds-space-1 $ds-space-0; }

/* ===== MODULE: features/_library.tcss ===== */
/* ========================================
 * FEATURES: Library (shell + navigation)
 * ========================================
 * ADR-161 task 10: the library-* shell/navigation/canvas vocabulary,
 * extracted from components/_agentic_terminal.tcss and tokenized on
 * arrival. This sheet is the SOURCE for the screen-owned split: the build
 * moves every all-library-token rule to the lazily-loaded
 * screen_agentic_library.tcss (parsed on first Library visit,
 * TASK-25812); mixed-scope rules (state classes, ds-* compounds) ride the
 * bundle here. Content workbenches (collections/media/RAG/notes/prompts/
 * ingest/skills) live in features/_library_panels.tcss. Never add local
 * $ds-* fallbacks here (two-track rule, TASK-15993).
 * ======================================== */

/* Header sentinel: unit-splitting attaches leading comments to the
 * next rule, so without this no-op the provenance essay above would
 * travel with the first moved rule into the generated screen sheet
 * (same trick as the split preamble's sentinel). Stays in the bundle:
 * its token matches no split owner. */
.tldw-split-source-header-end { }

.library-adaptive-reader-shell > .library-adaptive-reader-pane-grip:hover,
.library-adaptive-reader-shell > .library-adaptive-reader-pane-grip.-active {
    background: $ds-surface-raised;
    tint: transparent;
}

#library-conversations-canvas > .ds-toolbar {
    width: $ds-width-full;
    min-width: $ds-size-0;
    max-width: $ds-width-full;
}

/* task-32042: content-width actions keep full labels in narrow selection rows;
   min-width: 0 lifts Button's 16-cell floor. */
#library-conversations-canvas > .ds-toolbar > .library-toolbar-count,
#library-conversations-canvas > .ds-toolbar > .library-canvas-action {
    width: auto;
    min-width: $ds-size-0;
}

.library-source-action.is-active,
.library-source-action.is-active:focus {
    border: none;
    background: transparent;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

/* task-32142 fix round 1 escalated minor: #library-note-preview-body-title
   (the Preview title) carries `.destination-section` like Info's
   Properties/Reuse & Export/Danger headers, but no selector reached it --
   the class was inert there in both sizes. Grouped into the SAME rule its
   Info siblings already use, rather than inventing a new style nothing
   else in this canvas has. */
#library-shell-grid.library-notes-compact #library-note-context-region .destination-section,
#library-shell-grid.library-notes-compact #library-note-preview-region .destination-section,
#library-shell-grid.library-notes-compact #library-note-context-meta,
#library-shell-grid.library-notes-compact #library-note-context-region > .library-canvas-action {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
}

#notes-sync-fold-hint,
#notes-sync-disconnect-copy,
.library-disabled-reason {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    max-height: $ds-size-2;
    color: $text-muted;
    background: $surface-darken-1;
    text-wrap: wrap;
    text-overflow: clip;
}

#library-shell-grid.library-notes-compact #notes-sync-authority,
#library-shell-grid.library-notes-compact #notes-sync-roots-authority,
#library-shell-grid.library-notes-compact .library-notes-lasting-status,
#library-shell-grid.library-notes-compact #notes-sync-fold-hint {
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* ===== MODULE: features/_library_panels.tcss ===== */
/* ========================================
 * FEATURES: Library panels (content workbenches)
 * ========================================
 * ADR-161 task 10: the library-* content-workbench vocabulary
 * (collections, media, RAG, notes, prompts, ingest, skills) extracted
 * from components/_agentic_terminal.tcss and tokenized on arrival.
 * Splits from features/_library.tcss only to meet the 2,000-active-line
 * sheet ceiling; the pair is one vocabulary feeding the same
 * screen_agentic_library.tcss split. ======================================== */

/* Header sentinel: unit-splitting attaches leading comments to the
 * next rule, so without this no-op the provenance essay above would
 * travel with the first moved rule into the generated screen sheet
 * (same trick as the split preamble's sentinel). Stays in the bundle:
 * its token matches no split owner. */
.tldw-split-source-header-end { }

.library-notes-folder-row.is-selected,
.library-notes-tree-note-row.is-selected {
    text-style: bold;
    background: $ds-focus-bg;
}

.library-prompt-history-row.history-selected {
    outline: tall $ds-focus-accent;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}

/* task-28025: in the 3-column reader layout the Items panel is a narrow
   fixed column (~38 cols), and the browse/bulk toolbars overflowed it --
   Trash/Select rendered past the panel border, invisible and unclickable
   (live 2026-09-02). Mirror the conversations canvas fix: the toolbar
   fills the panel and its actions share the width (1fr, min-width:0) so
   every control stays on-screen instead of clipping off the right edge. */
#library-media-canvas > .ds-toolbar {
    width: $ds-width-full;
    min-width: $ds-size-0;
    max-width: $ds-width-full;
}

/* task-30043 (critique 2026-09-03 P1) supersedes task-28025's 1fr squeeze:
   sharing the row width chopped every label to fragments (``t so E Tr R
   Se``) and collapsed disabled bulk actions to bare "○" markers at the
   pane's 40-col floor. The canvas now switches to a multi-row grammar
   below its measured narrow threshold (library_media_canvas.py's
   _resolve_narrow_actions), so buttons keep their CONTENT width (auto,
   with min-width 0 lifting Textual Button's 16-cell floor -- six floors
   alone would overflow any pane under 96 cols) and every label stays a
   readable word; each row's label sum is budgeted to fit the 40-col
   floor, which is what keeps task-28025's fit contract true. */
#library-media-canvas > .ds-toolbar > .library-canvas-action,
#library-media-canvas > .ds-toolbar > .library-toolbar-count {
    width: auto;
    min-width: $ds-size-0;
}

#library-media-workbench.has-preview #library-media-detail-empty {
    display: none;
}

/* task-31276 (critique #4 P2) retires task-15774's dock-on-active. That
   rule moved the whole controls block to the top of the viewer the moment
   a query was submitted, so Enter teleported the bar out from under the
   mode row and shoved the Reader header (identity line, Back, title) down
   six rows -- the bar the user was typing into jumped away from the caret.
   Its premise is gone too: task-31237 made the viewer itself stop
   scrolling (the content box owns the overflow), so the chrome above the
   bar no longer scrolls out from under it and nothing bleeds through.
   The class stays: it still collapses the active bar's child margins,
   keeping it to 6 rows of a 24-row terminal instead of 8. */
#library-media-content-search-controls.-library-media-search-active #library-media-content-search,
#library-media-content-search-controls.-library-media-search-active #library-media-content-search-status {
    margin: $ds-space-0;
}

/* Reserved for real failures only (unsafe query, missing dependencies/
 * index, no provider) -- the ready state has no callout at all (A2), and
 * the empty-query / no-scope gates render `.library-rag-quiet-line`
 * instead (A1), so there is no "is-ready" callout variant to style. */
.library-rag-callout.is-blocked {
    border: solid $ds-status-warning;
    background: $ds-status-warning 10%;
}

/* PR-3 Task 3 (carried Task 1 review ruling): an uncited/unverified
 * `ready` answer must show its citation-recovery copy at LEAST as
 * prominently as the answer text itself. Reuses the same bordered box and
 * warning token as `.is-blocked` above, under its own modifier name -- this
 * state is not a run-gate block (the query ran, and produced an answer);
 * keeping the two meanings distinct in the stylesheet matches the render
 * code, which never conflates "blocked" and "needs scrutiny" either. */
.library-rag-callout.is-caution {
    border: solid $ds-status-warning;
    background: $ds-status-warning 10%;
}

.library-rag-result-row.is-selected {
    border: heavy $ds-focus-accent;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

#notes-sync-authority,
#notes-sync-roots-authority,
.library-notes-lasting-status {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    max-height: $ds-size-2;
    text-wrap: wrap;
    text-overflow: clip;
}

.notes-sync-conflict-view,
.library-notes-sync-attention-actions > .notes-sync-conflict-choice {
    width: $ds-width-full;
    min-width: $ds-size-0;
}

/* ===== MODULE: features/_settings.tcss ===== */
/* ========================================
 * FEATURES: Settings workbench
 * ========================================
 * ADR-161 task 10: the settings-* workbench vocabulary, extracted from
 * components/_agentic_terminal.tcss and tokenized on arrival. This sheet
 * is the SOURCE for the screen-owned split: all-settings-token rules move
 * to the lazily-loaded screen_agentic_settings.tcss (TASK-25812), while
 * pinned/mixed rules (settings-input-label, destination-section scoped
 * overrides) ride the bundle here. Distinct from features/
 * _tools-settings.tcss (the deprecated legacy Tools/Settings window).
 * Never add local $ds-* fallbacks here (two-track rule).
 * ======================================== */

/* Header sentinel: unit-splitting attaches leading comments to the
 * next rule, so without this no-op the provenance essay above would
 * travel with the first moved rule into the generated screen sheet
 * (same trick as the split preamble's sentinel). Stays in the bundle:
 * its token matches no split owner. */
.tldw-split-source-header-end { }

/* Section headers inside the settings detail pane get a raised bar and a
   blank line above, so each content block reads as a distinct section.
   (The class itself is shared; scope stays inside settings.) */
#settings-detail-pane .destination-section {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.settings-input-label {
    /* task-1713: 12 cells truncated most labels ("Palette limit" ->
       "Palette", "Tool result display cap" -> "Tool result"), which read
       as unit-less mystery numerics in the critique. */
    width: $ds-size-24;
    min-width: $ds-size-12;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-style: bold;
}

.settings-select-row .settings-input-label {
    height: $ds-size-3;
    min-height: $ds-size-3;
    content-align: left middle;
}

/* The Library/RAG detail card (Search/Embedding/Chunking/Vector store/
 * Reranking groups) has the longest field labels in Settings ("Default
 * results", "Embedding model ⚠", "Distance metric ⚠", "Rerank results", ...).
 * The generic 12-column label width clips them to their first wrapped word
 * (Static wraps at the column width but the row stays height:1, so only
 * that first line paints) -- e.g. "Default results" rendered as just
 * "Default", and "Reranker model"/"Reranker top-k" (pre UX-review-2026-07
 * naming) both rendered as the identical "Reranker". Widen the column for
 * this card only so every RAG label fits on one line unambiguously; other
 * Settings categories keep the base 12-column rhythm.
 */
#settings-library-rag-card .settings-input-label {
    width: $ds-size-20;
    min-width: $ds-size-20;
}

.settings-compact-select > SelectOverlay Option.-selected {
    padding: $ds-space-0 $ds-space-2;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.settings-speech-stacked .settings-speech-input-row .settings-input-label,
.settings-speech-stacked .settings-speech-input-row .settings-speech-control-stack,
.settings-speech-stacked .settings-speech-input-row > Input,
.settings-speech-stacked .settings-speech-input-row > Select,
.settings-speech-stacked .settings-speech-input-row > Switch {
    width: $ds-width-full;
    min-width: $ds-size-0;
}


/* task-1624: the Checkbox glyph paints "X" in BOTH states, distinguishing
   them by color alone -- it read as checked either way in the critique.
   Hide the glyph while off so its presence carries the state; the On/Off
   word beside it (switch_word) stays the text carrier. */
/* task-1713 counterweight: the widened shared label column (24) does not
   fit the Image Gen backend rows' five controls at 120 cols -- the
   geometry guard test pins that width. Backend-row labels are short
   backend names; 12 never truncated them. */
.settings-imagegen-backend-row .settings-input-label {
    width: $ds-size-12;
    min-width: $ds-size-12;
}

/* ===== MODULE: features/_home.tcss ===== */
/* ========================================
 * FEATURES: Home
 * ========================================
 * ADR-161 task 10: the home-only vocabulary (triage grid, rail rows,
 * next-action callout, canvas actions) extracted from
 * components/_agentic_terminal.tcss and tokenized on arrival. The shared
 * agentic-shell comma rules (all-shells heights/strips/regions) are NOT
 * home vocabulary; they stay in components/_agentic_terminal.tcss chrome.
 * ======================================== */


#home-triage-grid {
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    border: solid $ds-column-line;
    background: $ds-surface-panel;
}

#home-header-line {
    height: $ds-home-compact-row-height;
    min-height: $ds-home-compact-row-height;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    border: none;
}

#home-rail,
#home-canvas {
    border: solid $ds-column-line;
    background: $ds-surface-panel;
}

.home-rail-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-2;
    min-height: $ds-size-2;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.home-rail-row-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.home-rail-section-body {
    height: auto;
    min-height: $ds-size-0;
}

.home-rail-empty-copy {
    color: $ds-text-muted;
    padding: $ds-space-0 $ds-space-1;
}

#home-next-action-callout {
    color: $ds-text-muted;
    padding: $ds-space-0 $ds-space-1;
}

#home-canvas-actions .ds-toolbar {
    height: auto;
    min-height: $ds-home-control-button-height;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    border: none;
    background: $ds-surface-panel;
}

.home-canvas-action {
    height: $ds-home-control-button-height;
    min-height: $ds-home-control-button-height;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    border: none;
}

/* ===== MODULE: features/_chat.tcss ===== */
/* ========================================
 * FEATURES: Chat
 * ======================================== 
 * Chat tab specific styles
 *
 * Fully tokenized per ADR-150 / backlog/docs/design-language.md — the
 * migration reference pattern: spacing from the $ds-space-* scale, control
 * heights from $ds-control-*, motion from $ds-duration-*, state surfaces
 * from $ds-hover/-disabled/-focus tokens. ADR-161 §3.10 in-place literal
 * migration (2026-09-13) completed the sheet: feature-specific geometry
 * (fixed gutter widths, textarea expansion heights) now maps to the
 * $ds-size and $ds-percent scales too -- zero raw dimension literals,
 * transcribed value-identically.
 * ======================================== */

/* --- Chat sidebar toggle buttons --- */
.chat-sidebar-toggle-button {
    width: $ds-size-3;
    height: $ds-height-full;
    min-width: $ds-size-3;
    max-width: $ds-size-3;
    border: none;
    background: $background;
    color: $ds-text-muted;
    padding: $ds-space-1 0 0 0;
    margin: $ds-space-0;
    content-align: center top;
}

.chat-sidebar-toggle-button:hover {
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.chat-sidebar-toggle-button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border: none;
    outline: none;
}

/* --- Chat Window specific layouts --- */
#chat-main-content {
    layout: vertical;
    height: $ds-height-full;
    width: $ds-width-fill; /* Takes remaining space */
    min-width: $ds-size-40; /* Prevent squashing */
}

/* --- Compact Model Bar --- */
#compact-model-bar {
    height: $ds-control-height;
    width: $ds-width-full;
    padding: $ds-space-0 $ds-space-inline;
    background: $ds-surface-raised;
    border-bottom: solid $ds-grid-line;
    align: left middle;
}

#compact-model-bar Select {
    width: $ds-width-fill;
    margin: $ds-space-0 $ds-space-inline $ds-space-0 $ds-space-0;
    height: $ds-control-height;
}

.compact-bar-label {
    width: auto;
    padding: $ds-space-0 $ds-space-inline;
    color: $ds-text-muted;
}

.compact-bar-temp {
    width: $ds-size-12;
    margin: $ds-space-0 $ds-space-inline $ds-space-0 $ds-space-0;
    height: $ds-control-height;
}

.compact-bar-toggle {
    width: auto;
    min-width: $ds-size-5;
    height: $ds-control-height;
    border: none;
    /* Enabled but recessed chrome: sunken resting surface, NOT the
       disabled token (Qodo review, PR #2632). */
    background: $ds-surface-sunken;
    color: $ds-text-muted;
}

.compact-bar-toggle:hover {
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

/* Send button states */
.send-button {
    width: $ds-fr-2;
    margin-left: $ds-space-inline;
    text-style: $ds-text-strong;
}

.send-button.stop-state {
    background: $error;
}

/* Attachment button */
.attach-button {
    width: auto;
    margin-left: $ds-space-inline;
}

/* Voice input widget styles */
.voice-input-widget {
    padding: $ds-space-inset;
    background: $ds-surface-raised;
    border: solid $primary;
}

/* Notes area expansion states */
.notes-textarea-normal {
    height: $ds-size-10;
}

.notes-textarea-expanded {
    height: $ds-size-25;
}

/* ADR-161 task 8c: `.chat-message.user` / `.chat-message.assistant` were
 * dead -- zero compose sites (the transcript widgets are ChatMessage /
 * ChatMessageEnhanced, styled from components/_messages.tcss) -- and were
 * deleted. */

/* Loading and error states */
.loading-indicator {
    text-align: center;
    padding: $ds-space-2;
    color: $ds-text-muted;
}

.error-message {
    color: $error;
    padding: $ds-space-inset;
    margin: $ds-space-stack;
    border: solid $error;
}
/* Send button styling (shared) */
.send-button { /* Targets Button */
    width: $ds-width-fill;      /* Equal flexible width */
    height: $ds-control-height;
    /* align-self: stretch; REMOVED */
    margin-top: $ds-space-0;
    padding: $ds-space-0;      /* No padding for button */
    transition: background $ds-duration-fast, color $ds-duration-fast;
}

/* Stop button state: the shared Button:disabled contract applies.
 * This sheet previously stacked `opacity: 0.7` on the global disabled
 * colors -- the exact TASK-25822 contrast failure (disabled read as
 * absent). The class+pseudo selector outranks `Button:disabled`, so the
 * override is removed rather than re-stated; the global rule supplies full
 * opacity, $ds-disabled-bg, and $ds-text-disabled-readable.
 * Intentional a11y fix, the one deliberate visual change in this
 * migration (Qodo review, PR #2632). */

/* Visual feedback for stop state */
.send-button.stop-state {
    background: $error;
    color: white;
}

.stop-button {
    width: $ds-width-fill;      /* Equal flexible width */
    height: $ds-control-height;
    margin-top: $ds-space-0;
}

/* Clone Chat Button in chat-right-sidebar */
.clone-chat-button {
    margin-top: $ds-space-stack;   /* Add space above the button */
    width: $ds-width-full;     /* Full width like other sidebar buttons */
}

/* Chat Sidebar - Prompts Section */
#chat-prompts-collapsible Input,
#chat-prompts-collapsible ListView,
#chat-prompts-collapsible Button {
    margin-bottom: $ds-space-stack; /* Consistent spacing */
}
#chat-prompt-list-view { /* ID for the prompt list in chat sidebar */
    height: $ds-size-8; /* Adjust as needed */
    border: round $ds-surface-raised;
    margin-bottom: $ds-space-stack;
}
.loaded-prompt-area { /* Container for loaded prompt details in chat sidebar */
    margin-top: $ds-space-stack;
    padding: $ds-space-0 $ds-space-inline;   /* Padding for content inside */
    background: $ds-surface-raised; /* Slightly different background to group elements */
    /* To get rounded corners for the area itself, apply a border style */
    border: round $primary-background-lighten-1; /* Example: round border with a light color */
                                               /* Or use 'round $surface' if you want it less distinct */
                                               /* Or 'none' if you only want background and no explicit border */
}
/* End of Character Sidebar Specific Styles */

/* --- Chat Settings Mode Styles --- */

/* Settings mode toggle container */
.settings-mode-container {
    layout: horizontal;
    height: $ds-control-height;
    width: $ds-width-full;
    align: center middle;
    margin-bottom: $ds-space-stack;
    padding: $ds-space-0 $ds-space-inline;
}

/* Mode labels */
.mode-label {
    margin: $ds-space-0 $ds-space-inline;
    color: $ds-text-muted;
}

/* Settings mode toggle switch */
.settings-mode-toggle {
    margin: $ds-space-0 $ds-space-inline;
}

/* Settings search input */
.settings-search-input {
    width: $ds-width-full;
    margin-bottom: $ds-space-section;
    border: round $primary;
}



/* RAG preset select */
.rag-preset-select {
    width: $ds-percent-50;
}

/* Section headers.
 * ADR-161 task 6: this rule was a bare `.section-header` redefinition
 * that task 4's consolidation deliberately left as the cascade's global
 * winner (see the manifest note in build_css.py); the single-definition
 * rule (spec 3.7) now requires the bare selector to live only in the
 * owning sheet components/_sections.tcss. It is scoped here to `Screen`
 * -- composition, legal anywhere -- which preserves the computed styles
 * exactly: the (0,1,1) compound wins the properties it declares by
 * specificity where it used to win by bundle order (stats_screen.css's
 * screen copy still interposes between the two sheets, so folding into
 * the owner would have changed text-style and margin-top). */
Screen .section-header {
    text-style: bold underline;
    color: $primary;
    margin-bottom: $ds-space-stack;
    margin-top: $ds-space-stack;
}

.subsection-header {
    text-style: $ds-text-strong;
    color: $secondary;
    margin-bottom: $ds-space-stack;
    margin-top: $ds-space-stack;
}

/* Info text */
.info-text {
    color: $ds-text-muted;
    text-style: $ds-text-emphasis;
    margin-bottom: $ds-space-stack;
}

/* Hidden class for mode switching */
.hidden {
    display: none;
}

/* Search highlighting */
.search-hidden {
    display: none;
}

.search-highlighted {
    background: $warning 20%;
    border: round $warning;
}

/* Settings containers for mode switching */
#chat-basic-settings-container {
    width: $ds-width-full;
}

#chat-advanced-settings-container {
    width: $ds-width-full;
}

/* --- End Chat Settings Mode Styles ---*/

/* --- Enhanced Chat Settings Styles --- */

/* Mode toggle container */
.mode-toggle-container {
    layout: horizontal;
    height: $ds-size-4;  /* Increased height to prevent cutoff */
    width: $ds-width-full;
    align: center middle;
    margin-bottom: $ds-space-stack;
    padding: $ds-space-0 $ds-space-0 $ds-space-inset $ds-space-0;  /* Add bottom padding */
}

/* Mode labels */
.mode-label {
    margin: $ds-space-0 $ds-space-inline;
    color: $ds-text-muted;
}

/* Settings mode toggle switch */
.settings-mode-toggle {
    margin: $ds-space-0 $ds-space-inline;
    /* Custom styling for better visibility */
    background: $ds-surface-panel;
    border: solid $primary;
}

/* Switch widget styling for better visibility */
.settings-mode-toggle > .switch--slider {
    background: $primary;  /* Neutral blue when off (Basic mode) */
}

.settings-mode-toggle.-on > .switch--slider {
    background: $accent;  /* Accent color when on (Advanced mode) */
}

/* Switch thumb/handle styling */
.settings-mode-toggle .switch--slider {
    border: solid $primary;
}

/* Advanced Settings checkbox styling */
.advanced-settings-checkbox {
    margin-top: $ds-space-stack;
    margin-bottom: $ds-space-stack;
}

.advanced-settings-checkbox > Checkbox {
    color: $ds-text-primary;
}

.advanced-settings-checkbox:hover {
    color: $accent;
}

/* Settings search input */
.settings-search-input {
    width: $ds-width-full;
    margin-bottom: $ds-space-section;
    border: round $primary;
}

/* RAG Settings Panel - Prominent styling */
.rag-settings-panel {
    padding: $ds-space-inset;
    border: round $ds-surface-raised;  /* Changed to match other panels */
    background: $ds-surface-panel;     /* Changed to standard panel background */
    margin-bottom: $ds-space-stack;
}

/* Remove extra padding from RAG panel content */
.rag-settings-panel Container {
    padding: $ds-space-0;
    height: auto;
}

/* Highlight RAG panel when focused */
.rag-settings-panel:focus-within {
    border: round $ds-focus-accent;
    background: $ds-surface-panel;
}

/* Remove highlight when collapsed */
.rag-settings-panel.collapsed {
    border: round $ds-surface-raised !important;
    background: $ds-surface-panel !important;
}

/* RAG enable toggle */
.rag-enable-toggle {
    margin-bottom: $ds-space-stack;
}

/* RAG preset select */
.rag-preset-select {
    width: $ds-width-full;
    margin-bottom: $ds-space-stack;
}

/* RAG scope options */
.rag-scope-options {
    margin-bottom: $ds-space-stack;
}

.rag-scope-options Checkbox {
    margin-bottom: $ds-space-0;
}

/* Ensure proper spacing for sidebar labels in RAG panel */
.rag-settings-panel .sidebar-label {
    margin-top: $ds-space-0;
    margin-bottom: $ds-space-0;
}

/* Advanced only sections - hidden by default in basic mode */
.advanced-only {
    display: none;
}

/* Show advanced sections when in advanced mode */
.sidebar.advanced-mode .advanced-only {
    display: block;
}

/* Hide advanced-only when in basic mode */
.sidebar.basic-mode .advanced-only {
    display: none;
}

/* Search highlighting */
.search-highlight {
    background: $warning 20%;
    border: round $warning;
}

/* --- End Enhanced Chat Settings Styles ---*/

/* --- Visual Polish: Standardized Button Classes --- */

/* Primary action buttons (Send, Submit) */
.btn-primary {
    background: $primary;
    color: $ds-text-primary;
    text-style: $ds-text-strong;
    border: none;
}

.btn-primary:hover {
    background: $primary-lighten-1;
}


/* Ghost buttons (text-only, minimal) */
.btn-ghost {
    background: transparent;
    color: $ds-text-muted;
    border: none;
}

.btn-ghost:hover {
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

/* --- End Visual Polish ---*/

/* Durable Watchlists operation receipts: compact enough for the Console's
   narrow transcript column, but visibly distinct from assistant prose. */
#console-watchlists-operation-cards {
    height: auto;
    min-height: $ds-size-0;
    width: $ds-width-fill;
}

WatchlistsOperationCard {
    height: auto;
    min-height: $ds-size-7;
    width: $ds-width-fill;
    margin: $ds-space-0 $ds-space-0 $ds-space-stack $ds-space-0;
    padding: $ds-space-0 $ds-space-inline;
    border: round $ds-grid-line;
    background: $ds-surface-raised;
}

.watchlists-operation-status {
    height: $ds-control-height-compact;
    color: $ds-status-running;
    text-style: $ds-text-strong;
}

.watchlists-operation-title {
    height: $ds-control-height-compact;
    color: $ds-text-primary;
    text-style: $ds-text-strong;
}

.watchlists-operation-id {
    height: $ds-control-height-compact;
    color: $ds-text-muted;
}

.watchlists-operation-error {
    height: auto;
    max-height: $ds-size-2;
    color: $ds-status-error-readable;
}

.watchlists-operation-actions {
    height: auto;
    min-height: $ds-control-height-compact;
    width: $ds-width-fill;
    margin: $ds-space-stack 0 0 0;
}

.watchlists-operation-actions Button {
    margin: $ds-space-0 $ds-space-inline $ds-space-0 $ds-space-0;
}

/* ===== MODULE: features/_conversations.tcss ===== */
/* ========================================
 * FEATURES: Conversations (Refactored)
 * ======================================== 
 * Conversations, Characters, and Prompts tab
 * Single sidebar design following best practices
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales + named
   $ds-conversations-ai-generate-share), transcribed value-identically from
   the raw literals; comments stay load-bearing. */


/* --- Main container layout --- */
#conversations_characters_prompts-window {
    layout: horizontal;
    height: $ds-height-full;
}

/* --- Sidebar Styling (Single, unified sidebar) --- */
.ccp-sidebar {
    width: $ds-percent-30;
    min-width: $ds-size-25;
    max-width: $ds-percent-40;
    height: $ds-height-full;
    background: $boost;
    padding: $ds-space-1;
    border-right: thick $background-darken-1;
    overflow-y: auto;
    overflow-x: hidden;
}

/* Collapsed state for sidebar */
.ccp-sidebar.collapsed {
    width: $ds-size-0 !important;
    min-width: $ds-size-0 !important;
    border-right: none !important;
    padding: $ds-space-0 !important;
    overflow: hidden !important;
    display: none !important;
}


/* --- View Areas within Content --- */
.ccp-view-area {
    width: $ds-width-full;
    height: $ds-height-full;
    overflow-y: auto;
    overflow-x: hidden;
    padding: $ds-space-1;
}

/* Hidden class for view switching */
.ccp-view-area.hidden {
    display: none !important;
}

.hidden {
    display: none !important;
}

/* --- Title Styling --- */
.pane-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
    text-align: center;
    width: $ds-width-full;
    background: $primary-background-darken-1;
    padding: $ds-space-0 $ds-space-1;
    height: $ds-size-3;
}

.sidebar-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
    text-align: center;
    color: $primary;
}

/* --- Sidebar Components --- */
.sidebar-label {
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-0;
    color: $text-muted;
}

.sidebar-input {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    border: solid $primary-lighten-2;
    border-bottom: solid $primary-lighten-2;
}

.sidebar-textarea {
    width: $ds-width-full;
    height: $ds-size-5;
    margin-bottom: $ds-space-1;
    border: round $surface;
}

.sidebar-textarea.small {
    height: $ds-size-3;
}

/* ADR-161 task 6: the bare .sidebar-button/.sidebar-listview duplicates
 * that used to live here were folded into their owning sheet
 * layout/_sidebars.tcss (same computed values); only feature-specific
 * compounds remain in this sheet. */
.sidebar-button.small {
    width: $ds-percent-45;
    margin-right: $ds-space-1;
}

.sidebar-button.danger {
    background: $error-darken-1;
}

.sidebar-button.danger:hover {
    background: $error;
}

/* Export buttons container */
.export-buttons {
    layout: horizontal;
    height: $ds-size-3;
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

.export-buttons Button {
    width: $ds-width-fill;
    margin-right: $ds-space-1;
}

.export-buttons Button:last-child {
    margin-right: $ds-space-0;
}

/* --- Editor Styling --- */
.editor-scroll {
    width: $ds-width-full;
    height: $ds-height-fill;
    overflow-y: auto;
    padding: $ds-space-1;
}

.field-value {
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
}

.field-textarea {
    width: $ds-width-full;
    height: $ds-size-8;
    margin-bottom: $ds-space-1;
    border: round $surface;
}

.editor-input {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

.editor-textarea {
    width: $ds-width-full;
    height: $ds-size-10;
    margin-bottom: $ds-space-1;
    border: round $surface;
}

.editor-textarea.small {
    height: $ds-size-5;
}

/* AI Generation buttons */
.field-with-ai {
    layout: horizontal;
    height: auto;
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

.field-with-ai TextArea {
    width: $ds-percent-85;
    margin-right: $ds-space-1;
}

.ai-generate-button {
    width: $ds-conversations-ai-generate-share;
    height: $ds-size-3;
    margin-top: $ds-space-0;
    background: $primary;
}

.ai-generate-button:hover {
    background: $primary-lighten-1;
}

.ai-generate-button.full-width {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

/* Image controls */
.image-controls {
    layout: horizontal;
    height: $ds-size-3;
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

.image-controls Button {
    width: $ds-width-fill;
    margin-right: $ds-space-1;
}

.image-controls Button:last-child {
    margin-right: $ds-space-0;
}

.image-status {
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    color: $text-muted;
}

.character-image {
    width: $ds-width-full;
    height: $ds-size-15;
    border: round $surface;
    margin-bottom: $ds-space-1;
    align: center middle;
    background: $surface-darken-1;
}

/* Editor action buttons */
.editor-actions {
    layout: horizontal;
    height: $ds-size-3;
    width: $ds-width-full;
    margin-top: $ds-space-2;
    margin-bottom: $ds-space-1;
}

.editor-actions Button {
    width: $ds-width-fill;
    margin-right: $ds-space-1;
}

.editor-actions Button:last-child {
    margin-right: $ds-space-0;
}

.primary-button {
    background: $success;
}

.primary-button:hover {
    background: $success-lighten-1;
}

.secondary-button {
    background: $surface;
}

.secondary-button:hover {
    background: $surface-lighten-1;
}

/* Dictionary specific styles */
.dict-entries-list {
    height: $ds-size-12;
    margin-bottom: $ds-space-1;
    border: round $surface;
}

.dict-entry-controls {
    layout: horizontal;
    height: $ds-size-3;
    width: $ds-width-full;
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
}

.dict-entry-controls Button {
    width: $ds-width-fill;
    margin-right: $ds-space-1;
}

.dict-entry-controls Button:last-child {
    margin-right: $ds-space-0;
}

/* Collapsible styling enhancements */
Collapsible {
    margin-bottom: $ds-space-1;
}

Collapsible > CollapsibleTitle {
    background: $primary-background-darken-1;
    color: $text;
    padding: $ds-space-0 $ds-space-1;
    height: $ds-size-3;
}

Collapsible.-active > CollapsibleTitle {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border-bottom: solid $ds-focus-accent;
}

/* Select widget styling */
Select {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

/* Checkbox styling -- RETIRED (TASK-18960).
 *
 * This was a bare, unscoped `Checkbox` TYPE selector, so it reached every
 * Checkbox app-wide, not just this screen's. Combined with `ToggleButton`'s
 * own `border: tall` (2 rows of chrome, present even blurred -- unrelated
 * to focus), `height: 2` left literally 0 rows for the label/glyph: any
 * bordered, non-compact Checkbox anywhere in the app rendered blank.
 * TASK-17961's painted-frame verification caught this on Settings >
 * Workspaces' "Show archived" Checkbox; `Tests/UI/
 * test_checkbox_height_render.py` pins the fix.
 *
 * Traced (not just deleted blind) before retiring:
 * - This file's own screen -- the id it titles itself after,
 *   `#conversations_characters_prompts-window` -- has no live Python
 *   consumer; TAB_CCP's route now aliases entirely to `PersonasScreen`
 *   (`UI/Navigation/screen_registry.py`). The `.ccp-sidebar`/`.ccp-view-
 *   area` classes this file also defines have ZERO Python references
 *   anywhere in the repo (review-verified full grep) -- dead CSS like the
 *   id itself -- so nothing conversations-UI-scoped depends on this rule
 *   to retire it INTO.
 * - `width: 100%`/`margin-bottom: 0` are retired with it rather than kept
 *   bare: `margin-bottom: 0` already matches `ToggleButton`'s own
 *   DEFAULT_CSS default (no margin declared), and every documented
 *   escape hatch already fighting this exact rule elsewhere in the bundle
 *   (`.settings-imagegen-backend-row Checkbox`, `MCPSchemaForm Checkbox`,
 *   `PromptBlockEditor #prompt-editor-lane-options Checkbox`,
 *   `LibraryIngestCanvas .type-group-contents Checkbox`,
 *   `#evals-bench-capture-continuations` (features/_evals.tcss) -- see
 *   their own comments, e.g. components/_agentic_terminal.tcss and
 *   features/_evals.tcss) drops `width: 100%` too, standardizing on
 *   `width: auto` alongside `height: auto`. (A sixth,
 *   `MCPToolsMode #mcp-tools-local-enabled`, was in this list until
 *   task-32286 turned that row into a toggle Button and retired it.)
 *   That five-deep precedent, plus the sweep below,
 *   is why this is a full retirement and not a narrower height-only fix.
 * - The sweep this retirement was checked against (grepping every
 *   `Checkbox(` call app-wide for one relying on this rule with no escape
 *   hatch of its own) found this bug was NOT limited to the one
 *   Settings > Workspaces checkbox named in the task brief -- at least
 *   three more non-compact, unscoped Checkboxes were equally blank before
 *   this fix: `library_prompts_canvas.py`'s
 *   "Include current text as starter content"
 *   (`#library-prompt-recipe-starter`), and `stts_profile_library.py`'s
 *   `#bundle-warning-ack` and `#stts-bundle-inactive-consent`. Retiring
 *   the rule (rather than rescoping it to a container none of these sit
 *   in) fixes all of them at once via Textual's own `ToggleButton`
 *   DEFAULT_CSS (`width: auto`, implicit `height: auto`), which is a
 *   fully-painted, non-blank border+content box.
 */

/* Message display area */
#ccp-conversation-messages-view {
    padding: $ds-space-1;
}

/* Scrollbar styling is now an app-wide default in core/_base.tcss (TASK-394):
 * a bare `VerticalScroll` type selector here applied to every scroll view in
 * the app, not just conversations. */

/* Note: Textual doesn't support @media queries for responsive design */
/* Width adjustments would need to be handled programmatically */

/* --- End of refactored Conversations, Characters & Prompts styles --- */

/* ===== MODULE: features/_notes.tcss ===== */
/* ========================================
 * FEATURES: Notes
 * ======================================== 
 * Notes tab specific styles
 * ======================================== */

/* --- Notes Tab Window ---
 * T169: #notes-main-content, .notes-editor, and #notes-controls-area
 * pruned -- pre-workbench legacy Notes tab CSS (Notes_Window.py, since
 * removed; the standalone Notes tab was replaced by the Library
 * workbench's Notes canvas) with zero live references anywhere in
 * tldw_chatbook/*.py.
 */

/* T169: .auto-save-label pruned -- zero live references (same
 * pre-workbench legacy Notes tab as above). */

/* --- End of Notes Tab Window --- */

/* ===== MODULE: features/_media.tcss ===== */
/* ========================================
 * FEATURES: Media
 * ========================================
 * Media tab specific styles
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


/* --- Media Tab --- */
/* MediaWindow v2 - Component-based architecture */
/* Individual component styles are defined in their respective DEFAULT_CSS */

/* Legacy styles for compatibility - will be removed once MediaWindow_v2 is fully integrated */

/* --- Legacy Media Tab Styles --- */
/* DEPRECATED: MediaWindow_v2 has its own layout
#media-window {
    layout: horizontal;
    width: 100%;
}
*/

.media-nav-pane {
    dock: left;
    width: auto;
    min-width: $ds-size-20;
    max-width: $ds-size-40;
    background: $boost;
    padding: $ds-space-1;
    border-right: thick $background-darken-1;
    overflow-y: auto;
    overflow-x: hidden;
}

.media-nav-pane.collapsed {
    width: $ds-size-0 !important;
    min-width: $ds-size-0 !important;
    border-right: none !important;
    padding: $ds-space-0 !important;
    overflow: hidden !important;
    display: none !important;
}

.media-nav-pane .media-nav-button {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    border: none;
    height: $ds-size-3;
    text-align: left;
    padding: $ds-space-0 $ds-space-1;
}
.media-nav-pane .media-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}

.media-content-pane {
    padding: $ds-space-0;
    layout: vertical;
    width: $ds-width-fill;
}

/* Ensure media views fill vertical space when shown */
.media-content-pane > .media-view-area {
    height: $ds-height-fill;
}

#media-sidebar-toggle-button {
    dock: top;
    height: $ds-size-3;
    width: $ds-size-5;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-1;
}

.media-view-area {
    width: $ds-width-full;
    height: $ds-height-fill;
}

/* Grid layout for content area within each media view */
/* DEPRECATED: MediaWindow_v2 uses Horizontal layout, not Grid
.media-view-area > Grid {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 35% 65%;
    grid-gutter: 1;
    height: 1fr;
    width: 100%;
}
*/

/* Target ListItems inside the media list to control their height */
.media-items-list > ListItem {
    width: $ds-width-full;
    height: auto; /* This prevents a single item from stretching to fill the whole ListView */
    padding: $ds-space-0;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* Styles for media item components */
.media-item-title {
    height: auto;
    text-style: bold;
}

.media-item-snippet {
    height: auto;
    color: $text-muted;
    max-height: $ds-size-2;
    overflow-y: hidden;
}

.media-item-meta {
    height: auto;
    text-style: italic;
    color: $text-disabled;
}

/* Style for the Vertical container inside ListItems */
.media-items-list > ListItem > Vertical {
    height: auto;
    width: $ds-width-full;
}

/* Ensure all child elements inside media items take full width */
.media-items-list > ListItem > Vertical > * {
    width: $ds-width-full;
}

/* DEPRECATED: MediaWindow_v2 uses different class names
.media-content-left-pane {
    width: 35%
}
*/

/* Children of .media-content-left-pane */
.media-content-left-pane > Label.pane-title {
    height: auto;
    width: $ds-width-full;
    text-align: center;
    margin-bottom: $ds-space-1;
}
.media-content-left-pane > Input.media-search-input {
    height: $ds-size-3;
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

/* Keyword filter styles */
.keyword-filter-label {
    height: auto;
    margin-bottom: $ds-space-1;
}

.keyword-filter-input {
    height: $ds-size-3;
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

/* ListView for media items */
/* DEPRECATED: MediaWindow_v2 components have their own styling
.media-items-list {
    width: 100%;
    height: 1fr;
    border: round $primary-lighten-2;
    background: $primary-background;
    margin-bottom: 1;
    overflow-y: auto;
    overflow-x: hidden;
    min-height: 10;
}
*/

.media-pagination-bar {
    height: $ds-size-3;
    width: $ds-width-full;
    align-horizontal: center;
}
.media-pagination-bar Button {
    width: auto;
    min-width: $ds-size-10;
    margin: $ds-space-0 $ds-space-1;
}
.media-pagination-bar .media-page-label {
    width: $ds-width-fill;
    text-align: center;
    padding: $ds-space-0 $ds-space-1;
}

/* DEPRECATED: MediaWindow_v2 uses MediaViewerPanel with its own styling
.media-content-right-pane {
    width: 1fr;
    height: 1fr;
    padding: 1;
    overflow-y: auto;
    layout: vertical;
}
*/

.media-details-theme {
    height: $ds-height-fill;
    width: $ds-width-full;
    overflow-y: auto !important;
    min-height: $ds-size-0;
}

/* Force Markdown content in Media tab to expand fully */
.media-content-right-pane Markdown {
    height: $ds-height-fill !important;
    overflow-y: auto !important;
}

/* Additional override for any potential Textual default constraints */
VerticalScroll.media-content-right-pane {
    height: $ds-height-fill !important;
}

VerticalScroll.media-content-right-pane > Markdown {
    height: $ds-height-fill !important;
}

/* --- Media Details Widget --- */
MediaDetailsWidget {
    height: $ds-height-fill;
    width: $ds-width-full;
    layout: vertical;
}

.metadata-section {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-1;
    background: $boost;
    border-bottom: thick $background-darken-1;
}

.metadata-view {
    layout: vertical;
    height: auto;
}

.metadata-section {
    height: auto;
    width: $ds-width-full;
    layout: vertical;
    margin-bottom: $ds-space-1;
}

.metadata-view {
    layout: vertical;
    height: auto;
    width: $ds-width-full;
}

.metadata-display {
    padding: $ds-space-0 $ds-space-1;
    margin-bottom: $ds-space-0;
    height: auto;
}

.metadata-edit {
    layout: vertical;
    padding: $ds-space-1;
    height: auto;
    min-height: $ds-size-30;
}

.edit-fields {
    layout: vertical;
    margin-bottom: $ds-space-1;
}

.edit-fields Label {
    margin-top: $ds-space-0;
    margin-bottom: $ds-space-0;
    text-style: bold;
    height: $ds-size-1;
}

.edit-fields Input {
    width: $ds-width-full;
    margin-bottom: $ds-space-0;
    height: $ds-size-3;
}

.edit-fields Input:disabled {
    opacity: 0.6;
    background: $boost-darken-1;
}

/* --- Formatting Options --- */
.formatting-options {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    margin-bottom: $ds-space-1;
    layout: horizontal;
    align: center middle;
}

.format-reading-checkbox {
    width: auto;
    height: $ds-size-3;
    padding: $ds-space-0 $ds-space-1;
}

.format-reading-checkbox:hover {
    background: $boost;
}

.edit-actions {
    layout: horizontal;
    height: auto;
    align: left top;
    margin-top: $ds-space-1;
}

.edit-actions Button {
    margin-right: $ds-space-1;
    min-width: $ds-size-10;
}

.media-content-display {
    height: $ds-height-fill;
    width: $ds-width-full;
    padding: $ds-space-1;
}

/* Content search section */
.content-search-section {
    width: $ds-width-full;
    padding: $ds-space-1;
    background: $boost;
    border-bottom: solid $primary-background;
}

.search-controls {
    layout: horizontal;
    align: center middle;
    height: $ds-size-3;
}

.content-search-input {
    width: $ds-width-fill;
    margin-right: $ds-space-1;
}

.content-search-button {
    width: $ds-size-4;
    min-width: $ds-size-4;
    margin-right: $ds-space-1;
}

.content-search-nav {
    width: $ds-size-3;
    min-width: $ds-size-3;
    margin-right: $ds-space-1;
}

.content-search-status {
    width: auto;
    color: $text-muted;
    text-style: italic;
}

/* --- Deleted Items Styling --- */
.deleted-media-item {
    opacity: 0.6;
}

.deleted-media-item:hover {
    opacity: 0.8;
}

.media-item-deleted {
    color: $text-disabled;
    text-style: strike;
}

.media-item-title.media-item-deleted {
    color: $error;
    text-style: strike;
}

/* Show deleted checkbox styling */
.show-deleted-checkbox {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    height: auto;
}

/* Metadata buttons container */
.metadata-buttons {
    layout: horizontal;
    height: $ds-size-3;
    width: $ds-width-full;
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
}

.metadata-edit-button {
    width: auto;
    min-width: $ds-size-10;
    dock: left;
}

.metadata-delete-button {
    width: auto;
    min-width: $ds-size-10;
    dock: right;
}

/* Hidden state */
.hidden {
    display: none;
}

/* --- Collections/Tags Window --- */
.collections-main-container {
    layout: horizontal;
    width: $ds-width-full;
}

.collections-left-pane {
    width: $ds-percent-40;
    min-width: $ds-size-30;
    layout: vertical;
    padding: $ds-space-1;
    border-right: thick $background-darken-1;
}

.collections-right-pane {
    width: $ds-width-fill;
    padding: $ds-space-1;
    overflow-y: auto;
}

.keyword-list {
    height: $ds-height-fill;
    border: round $primary-lighten-2;
    background: $primary-background;
    overflow-y: auto;
}

.keyword-list .keyword-item {
    padding: $ds-space-1;
    margin-bottom: $ds-space-0;
}

.keyword-list .keyword-item.selected,
.keyword-list .keyword-item.selected:hover {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.keyword-list .keyword-item:hover {
    background: $surface-lighten-1;
    color: $text;
}

.keyword-action-buttons {
    layout: horizontal;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

.keyword-action-buttons Button {
    width: $ds-width-fill;
    margin-right: $ds-space-1;
}

.action-buttons-container {
    layout: vertical;
    margin-bottom: $ds-space-2;
}

.action-buttons-container Button {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

.selection-info {
    padding: $ds-space-1;
    background: $boost;
    margin-bottom: $ds-space-1;
    text-align: center;
}

.keyword-details, .usage-stats {
    padding: $ds-space-1;
    background: $boost;
    margin-top: $ds-space-1;
    min-height: $ds-size-10;
}

/* Rename/Merge Dialog Styles */
#rename-dialog-container, #merge-dialog-container {
    align: center middle;
    width: $ds-size-50;
    min-height: $ds-size-10;
    padding: $ds-space-2;
    background: $surface;
    border: thick $primary;
}

#rename-title, #merge-title {
    text-align: center;
    text-style: bold;
    margin-bottom: $ds-space-1;
}

#merge-instruction {
    text-align: center;
    margin-bottom: $ds-space-1;
    color: $text-muted;
}

#new-keyword-input, #new-target-input {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

#target-keyword-list {
    height: $ds-size-15;
    margin-bottom: $ds-space-1;
    border: round $primary-lighten-2;
    background: $primary-background;
}

#rename-buttons, #merge-buttons {
    layout: horizontal;
    height: $ds-size-3;
    align: center middle;
}

#rename-buttons Button, #merge-buttons Button {
    margin: $ds-space-0 $ds-space-1;
    min-width: $ds-size-12;
}

/* --- Multi-Item Review Window --- */
.multi-review-container {
    width: $ds-width-full;
    padding: $ds-space-1;
}

.selection-section, .items-section, .analysis-section {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    padding: $ds-space-1;
    background: $boost;
}

.selection-section {
    height: auto;
    min-height: $ds-size-15;
}

.items-section {
    height: auto;
    min-height: $ds-size-20;
    max-height: $ds-size-40;
}

.analysis-section {
    height: auto;
    min-height: $ds-size-30;
}

.search-controls, .tag-filter-section, .selection-controls {
    layout: horizontal;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

.search-controls Input {
    width: $ds-width-fill;
    margin-right: $ds-space-1;
}

.tag-filter-section Label {
    width: auto;
    margin-right: $ds-space-1;
}

.tag-input {
    width: $ds-width-fill;
}

.selection-controls Button {
    margin-right: $ds-space-1;
}

.selection-info {
    width: auto;
    padding: $ds-space-0 $ds-space-1;
}

.review-items-list {
    height: $ds-height-fill;
    border: round $primary-lighten-2;
    background: $primary-background;
    overflow-y: auto;
}

.review-items-list .review-item {
    padding: $ds-space-1;
    margin-bottom: $ds-space-0;
}

.review-items-list .review-item.selected,
.review-items-list .review-item.selected:hover {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.review-items-list .review-item:hover {
    background: $surface-lighten-1;
    color: $text;
}

.item-title {
    text-style: bold;
    color: $text;
}

.item-meta {
    color: $text-muted;
    text-style: italic;
}

.analysis-prompt {
    width: $ds-width-full;
    height: $ds-size-10;
    margin-bottom: $ds-space-1;
}

.analysis-controls {
    layout: horizontal;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

.analysis-controls Checkbox {
    width: auto;
    margin-right: $ds-space-2;
}

.analysis-controls Button {
    margin-right: $ds-space-1;
    min-width: $ds-size-15;
}

.analysis-progress {
    width: $ds-width-full;
    height: $ds-size-1;
    margin-bottom: $ds-space-1;
}

.progress-label {
    text-align: center;
    margin-bottom: $ds-space-1;
    color: $text-muted;
}

.results-container {
    height: $ds-height-fill;
    background: $primary-background;
    padding: $ds-space-1;
}

.analysis-results {
    layout: vertical;
    width: $ds-width-full;
}

.analysis-result-card {
    width: $ds-width-full;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
    background: $boost;
    border: round $primary-lighten-2;
}

.result-header {
    layout: horizontal;
    height: auto;
    margin-bottom: $ds-space-1;
}

.result-title {
    width: $ds-width-fill;
    text-style: bold;
}

.result-meta {
    color: $text-muted;
    margin-bottom: $ds-space-1;
}

.result-content {
    padding: $ds-space-1;
    max-height: $ds-size-20;
    overflow-y: auto;
}

.result-separator {
    text-align: center;
    color: $text-disabled;
    margin-top: $ds-space-1;
}

/* Delete confirmation dialog for keywords */
#delete-dialog {
    layout: vertical;
    padding: $ds-space-2;
}

.dialog-subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: $ds-space-1;
}

.dialog-message {
    text-align: center;
    margin-bottom: $ds-space-2;
}

/* --- End of Media Tab --- */

/* ===== MODULE: features/_llm-management.tcss ===== */
/* ========================================
 * FEATURES: LLM Management
 * ======================================== 
 * LLM Management tab styles
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


/* --- LLM Management Tab --- */
#llamacpp-snapshot-manager {
    height: auto;
    width: $ds-width-full;
    margin-top: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    background: $panel;
}

#llamacpp-snapshot-manager .section-title,
#llamacpp-snapshot-manager .snapshot-copy,
#llamacpp-snapshot-manager .snapshot-keep-label,
#snapshot-retention,
#snapshot-operation-status,
#snapshot-disabled-reason,
#snapshot-details,
#snapshot-preferences-result,
#snapshot-enabled,
#settings-snapshot-enabled,
#settings-snapshot-controls CollapsibleTitle,
#llamacpp-snapshot-manager CollapsibleTitle,
#settings-snapshot-controls .settings-help-copy,
#settings-snapshot-controls .settings-input-label {
    height: auto;
    text-wrap: wrap;
}

#llamacpp-snapshot-manager .snapshot-actions {
    height: $ds-size-3;
    width: $ds-width-full;
}

#llamacpp-snapshot-manager #snapshot-save,
#llamacpp-snapshot-manager #snapshot-restore,
#llamacpp-snapshot-manager #snapshot-delete,
#llamacpp-snapshot-manager #snapshot-refresh,
#llamacpp-snapshot-manager #snapshot-previous,
#llamacpp-snapshot-manager #snapshot-next,
#llamacpp-snapshot-manager #snapshot-apply,
#llamacpp-snapshot-manager #snapshot-reload {
    min-width: $ds-size-8;
    width: $ds-width-fill;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    text-wrap: nowrap;
    height: $ds-size-3;
    min-height: $ds-size-3;
    max-height: $ds-size-3;
}

#llamacpp-snapshot-manager #snapshot-save:disabled,
#llamacpp-snapshot-manager #snapshot-restore:disabled,
#llamacpp-snapshot-manager #snapshot-delete:disabled,
#llamacpp-snapshot-manager #snapshot-refresh:disabled,
#llamacpp-snapshot-manager #snapshot-previous:disabled,
#llamacpp-snapshot-manager #snapshot-next:disabled,
#llamacpp-snapshot-manager #snapshot-apply:disabled,
#llamacpp-snapshot-manager #snapshot-reload:disabled {
    border: none;
}

#snapshot-slots,
#snapshot-records {
    height: $ds-size-5;
    width: $ds-width-full;
}

#snapshot-disabled-reason,
#snapshot-operation-status,
#settings-snapshot-result {
    color: $warning;
}

#llamacpp-snapshot-manager .snapshot-copy {
    color: $text-muted;
}

#snapshot-retention {
    text-style: bold;
}

#snapshot-keep,
#settings-snapshot-keep {
    width: $ds-size-8;
}

#llamacpp-snapshot-manager .snapshot-keep-label {
    width: $ds-size-12;
}

#settings-snapshot-controls {
    height: auto;
    margin-bottom: $ds-space-1;
}

.gguf-source-mode-row {
    layout: horizontal;
    width: $ds-width-full;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

.gguf-source-label {
    width: $ds-size-18;
    height: $ds-size-3;
    content-align: right middle;
    padding-right: $ds-space-1;
}

.gguf-source-mode {
    width: $ds-width-fill;
    min-width: $ds-size-12;
    height: $ds-size-3;
}

.gguf-source-region {
    display: none;
    width: $ds-width-full;
    height: auto;
    margin-bottom: $ds-space-1;
}

.gguf-source-region.-active {
    display: block;
}

.gguf-source-choice-row {
    layout: horizontal;
    width: $ds-width-full;
    height: $ds-size-3;
}

.gguf-source-choice-row Input,
.gguf-source-managed-select {
    width: $ds-width-fill;
    min-width: $ds-size-8;
    height: $ds-size-3;
}

.gguf-source-refresh,
.gguf-source-browse {
    width: auto;
    margin-left: $ds-space-1;
}

.gguf-source-authority,
.gguf-source-copy,
.gguf-source-status {
    width: $ds-width-full;
    height: auto;
    text-wrap: wrap;
}

.gguf-source-authority {
    color: $warning;
    text-style: bold;
}

.gguf-source-copy,
.gguf-source-status {
    color: $text-muted;
}

.gguf-source-status {
    margin-bottom: $ds-space-1;
}

.gguf-source-narrow .gguf-source-choice-row {
    layout: vertical;
    height: $ds-size-6;
}

.gguf-source-narrow .gguf-source-refresh,
.gguf-source-narrow .gguf-source-browse {
    width: $ds-width-full;
    margin-left: $ds-space-0;
}

/* Textual dims disabled focusable controls (and Button text) below readable
 * contrast. Keep this override local to the two GGUF runtime forms; their
 * status line explains why launch controls are unavailable. */
#llm-view-llama-cpp Button:disabled,
#llm-view-llama-cpp Input:disabled,
#llm-view-llama-cpp Select:disabled,
#llm-view-llamafile Button:disabled,
#llm-view-llamafile Input:disabled,
#llm-view-llamafile Select:disabled {
    opacity: 100%;
    text-opacity: 100%;
    color: $text;
    background: $surface-darken-1;
}

#llm-view-llama-cpp Button:disabled,
#llm-view-llama-cpp Input:disabled,
#llm-view-llamafile Button:disabled,
#llm-view-llamafile Input:disabled {
    border: dashed $foreground;
}

#llm-view-llama-cpp Select:disabled > SelectCurrent,
#llm-view-llama-cpp Select:disabled > SelectCurrent Static#label,
#llm-view-llama-cpp Select:disabled > SelectCurrent .arrow,
#llm-view-llamafile Select:disabled > SelectCurrent,
#llm-view-llamafile Select:disabled > SelectCurrent Static#label,
#llm-view-llamafile Select:disabled > SelectCurrent .arrow {
    opacity: 100%;
    text-opacity: 100%;
    color: $text;
    background: $surface-darken-1;
}

#llm-view-llama-cpp Select:disabled > SelectCurrent,
#llm-view-llamafile Select:disabled > SelectCurrent {
    border: dashed $foreground !important;
}

#llm_management-window { /* Matches TAB_LLM ("llm_management") */
    layout: horizontal;
}

.llm-nav-pane { /* Style for the left navigation pane */
    dock: left;
    width: auto;
    min-width: $ds-size-25;
    max-width: $ds-size-60;
    height: $ds-height-full;
    background: $boost; /* Or $surface-darken-1 or $surface-lighten-1 */
    padding: $ds-space-1;
    border-right: thick $background-darken-1;
    overflow-y: auto;
    overflow-x: hidden;
}

.llm-nav-pane .llm-nav-button { /* Style for navigation buttons */
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    border: none;
    height: $ds-size-3;
    text-align: left;
    padding: $ds-space-0 $ds-space-1;
}
.llm-nav-pane .llm-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}
/* Active state for selected llm nav button */
.llm-nav-pane .llm-nav-button.-active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.llm-content-pane { /* Style for the right content display area */
    width: $ds-width-fill;
    height: $ds-height-full;
    padding: $ds-space-1 $ds-space-2;
    overflow-y: auto;
}

.llm-view-area { /* Common class for individual content areas */
    width: $ds-width-full;
    height: $ds-height-full; /* Or auto */
    display: none; /* Initially hidden until activated */
}

/* LLM Management Tab Specific Styles */
#llm_management-window .llm-view-area > VerticalScroll { /* Target the new VS inside each view */
    height: $ds-height-full; /* Ensure the VerticalScroll takes full height of its parent view area */
}

#llamacpp-args-help-collapsible,
#llamafile-args-help-collapsible,
#vllm-args-help-collapsible { /* Style for the collapsible itself */
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
    border: round $primary-lighten-1; /* Optional border for the collapsible */
}

#llamacpp-args-help-collapsible > .collapsible--header,
#llamafile-args-help-collapsible > .collapsible--header,
#vllm-args-help-collapsible > .collapsible--header { /* Style for the collapsible title */
    background: $surface-darken-1; /* Slightly different background for the header */
}

.help-text-display {
    height: $ds-size-25; /* Or your desired fixed height for the scrollable help text */
    width: $ds-width-full;
    border: round $surface;
    padding: $ds-space-1;
    margin-top: $ds-space-1; /* Space between collapsible title and the content */
    background: $panel; /* Background for the help text area */
    overflow-y: scroll !important; /* Ensure vertical scrolling */
}

/* Ensure input fields for additional args are appropriately sized if they were TextAreas */
/* If you changed #llamacpp-additional-args to Input, this might not be needed for it */
#llamacpp-additional-args, /* This is now an Input, so this rule might be less relevant for it */
#llamafile-additional-args,
#vllm-additional-args {
    height: $ds-size-3; /* For single-line Input or small TextArea */
    /* If it's a TextArea and you want more lines: */
    /* min-height: 3; */
    /* max-height: 7; */
    /* height: auto; */
}

/* Log output styles for Llama.cpp and Llamafile views */
#llm-view-llama-cpp .log_output,
#llm-view-llamafile .log_output {
    width: $ds-width-full;
    height: $ds-size-15; /* Fixed height to ensure scrolling works */
    min-height: $ds-size-10;
    max-height: $ds-size-20;
    border: panel $primary-darken-2;
    background: $background-darken-1;
    margin-top: $ds-space-1;
    overflow-y: auto;
}

/* Optional: Style for the input_container if needed */
.input_container {
    layout: horizontal;
    height: auto;
    margin-bottom: $ds-space-1;
}
.input_container Input {
    width: $ds-width-fill; /* Input takes available space */
    margin-right: $ds-space-1; /* Space before browse button */
}
.input_container .browse_button {
    width: auto; /* Let button size itself */
    height: $ds-height-full;
}

.button_container {
    layout: horizontal;
    height: auto;
    margin-top: $ds-space-1;
}
.button_container Button {
    margin-left: $ds-space-1; /* Space between buttons */
}
/* Ollama Specific Styles within #llm-view-ollama */
#llm-view-ollama {
    layout: vertical; /* Ensures children stack vertically by default */
    /* overflow-y: auto; /* Add if direct children of llm-view-ollama might overflow before VerticalScroll */
}
#llm-view-ollama VerticalScroll { /* Ensure the VerticalScroll takes up space */
    height: $ds-height-full;
}

#llm-view-ollama .label { /* General label styling if not already covered */
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-0; /* Tighten space below label if input is right after */
    text-style: bold;
}
#llm-view-ollama .section_label { /* For labels that act as section headers */
    margin-top: $ds-space-2; /* More space above section labels */
    padding: $ds-space-0;
    /* no decorative border — the design system's "Border Has A Job" rule */
    text-align: left;
    width: $ds-width-full;
}

#llm-view-ollama .input_field,
#llm-view-ollama .input_field_short,
#llm-view-ollama .input_field_long {
    margin-bottom: $ds-space-1; /* Space after input fields */
}
#llm-view-ollama .input_field_long { /* For paths or longer inputs */
    width: $ds-width-full;
}

#llm-view-ollama .input_action_container { /* For Input + Button on same line */
    layout: horizontal;
    height: auto; /* Fit content */
    margin-bottom: $ds-space-0; /* Status/Output will provide margin */
}
#llm-view-ollama .input_action_container .input_field_short {
    width: $ds-width-fill; /* Input takes most space */
    margin-right: $ds-space-1;
    margin-bottom: $ds-space-0; /* No bottom margin if button is next to it */
}
#llm-view-ollama .input_action_container .action_button_short {
    width: auto; /* Let button size itself */
    min-width: $ds-size-10; /* Ensure it's not too small */
    height: $ds-size-3; /* Match the default Input height (100% of an auto parent collapses) */
}
#llm-view-ollama .input_action_container .browse_button_short {
    width: auto;
    min-width: $ds-size-15;
    height: $ds-size-3;
}

#llm-view-ollama .action_container { /* For standalone buttons */
    width: $ds-width-full;
    height: auto;
    margin-bottom: $ds-space-0;
}
#llm-view-ollama .action_button { /* For buttons that take full width or are main actions */
    width: $ds-width-full;
    margin-top: $ds-space-1; /* If it's after a section label or input */
}
#llm-view-ollama .full_width_button {
    width: $ds-width-full;
    margin-top: $ds-space-1;
}

#llm-view-ollama .delete_button Button { /* Specific styling for delete button if needed */
    background: $error-darken-1;
    color: $text;
}
#llm-view-ollama .delete_button Button:hover {
    background: $error;
}

/* New Status TextArea */
.ollama-status-textarea {
    width: $ds-width-full;
    height: $ds-size-3; /* Small, 1-2 lines of text */
    border: round $primary-darken-1;
    background: $surface;
    margin-top: $ds-space-1; /* Space above status */
    margin-bottom: $ds-space-1; /* Space below status, before main output or next section */
    padding: $ds-space-0 $ds-space-1;
    color: $text-muted; /* Subdued text color for status */
}

/* Output TextAreas */
#llm-view-ollama .output_textarea_medium { /* For JSON lists, model info */
    width: $ds-width-full;
    height: $ds-size-25; /* Or adjust as needed */
    border: round $primary;
    background: $panel;
    margin-bottom: $ds-space-1; /* Space before next element/spacer */
}
#llm-view-ollama .output_textarea_small { /* For embeddings */
    width: $ds-width-full;
    height: $ds-size-6;
    border: round $primary;
    background: $panel;
    margin-bottom: $ds-space-1;
}

/* Main RichLog for streaming */
#llm-view-ollama .log_output_large { /* Renamed from .log_output for specificity */
    width: $ds-width-full;
    height: $ds-size-10; /* Make it taller */
    border: panel $primary-darken-2;
    background: $background-darken-1; /* Darker background for log */
}

/* Spacer element */
.ollama-spacer {
    height: $ds-size-1; /* Creates 1 cell of vertical space */
    width: $ds-width-full;
}

/* OLLAMA compact layout grid */
.ollama-button-bar {
    layout: horizontal;
    height: auto;
    width: $ds-width-full;
    margin: $ds-space-1 $ds-space-0;
    align-horizontal: center;
}
.ollama-button-bar Button {
    width: $ds-width-fill;
    margin: $ds-space-0 $ds-space-1;
}

.ollama-actions-grid {
    layout: horizontal;
    height: auto;
    align-vertical: top; /* Align columns to the top */
    margin-bottom: $ds-space-1;
}

.ollama-actions-column {
    layout: vertical;
    width: $ds-width-fill;
    height: auto; /* 100% of the auto-height grid collapsed columns to empty boxes */
    padding: $ds-space-1;
    border: round $panel-lighten-1;
    margin: $ds-space-0 $ds-space-1;
}
.ollama-actions-column:first-of-type {
    margin-left: $ds-space-0;
}
.ollama-actions-column:last-of-type {
    margin-right: $ds-space-0;
}

.column-title {
    text-style: bold underline;
    width: $ds-width-full;
    text-align: center;
    margin-bottom: $ds-space-1;
}

/* Override input container margin inside a column */
.ollama-actions-column .input_action_container {
    margin-bottom: $ds-space-1;
}
.ollama-actions-column .full_width_button {
    margin-top: $ds-space-0; /* Tighten up space for buttons below inputs */
}

/* --- End of LLM Management Tab --- */

/* ===== MODULE: features/_tools-settings.tcss ===== */
/* ========================================
 * FEATURES: Tools and Settings
 * ======================================== 
 * Tools and Settings tab
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


/* --- Tools & Settings Tab --- */
#tools_settings-window { /* Matches TAB_TOOLS_SETTINGS */
    layout: horizontal; /* Main layout for this tab */
}

.tools-nav-pane {
    dock: left;
    width: auto; /* Changed from 25% */
    min-width: $ds-size-25; /* Example min-width */
    max-width: $ds-size-60; /* Example max-width */
    height: $ds-height-full;
    background: $boost; /* Or $surface-lighten-1 */
    padding: $ds-space-1;
    border-right: thick $background-darken-1;
    overflow-y: auto;
    overflow-x: hidden;
}

.tools-nav-pane .ts-nav-button { /* Style for navigation buttons */
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    border: none; /* Cleaner look for nav buttons */
    height: $ds-size-3;
}
.tools-nav-pane .ts-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}

.tools-nav-pane .ts-nav-button.active-nav {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.tools-content-pane {
    width: $ds-width-fill; /* Takes remaining horizontal space */
    height: $ds-height-full;
    padding: $ds-space-1 $ds-space-2; /* Padding for the content area */
    overflow-y: auto; /* If content within sub-views might scroll */
}

/* Ensure ContentSwitcher fills the pane */
.tools-content-pane ContentSwitcher {
    height: $ds-height-full;
    width: $ds-width-full;
}

.ts-view-area { /* Class for individual content areas */
    width: $ds-width-full;
    height: $ds-height-full;
    overflow-y: auto;
    overflow-x: hidden;
    /* Let ContentSwitcher handle visibility */
}

.config-file-settings-container {
    height: $ds-height-full;
    width: $ds-width-full;
    overflow-y: auto;
    overflow-x: hidden;
}

/* Ensure TabbedContent fills container */
.config-file-settings-container TabbedContent {
    height: $ds-height-full;
    width: $ds-width-full;
}

.config-file-settings-container TabPane {
    height: $ds-height-full;
    width: $ds-width-full;
}

/* Specific config tabs styling */
#config-tabs {
    height: $ds-height-full;
    width: $ds-width-full;
    min-height: $ds-size-30;
}

/* Inner container for config file settings */
.config-file-settings-inner {
    height: $ds-height-full;
    width: $ds-width-full;
    layout: vertical;
}

/* Settings form styling */
.section-description {
    color: $text-muted;
    margin-bottom: $ds-space-2;
    text-align: center;
    text-style: italic;
    height: auto;
}

.settings-group {
    margin-bottom: $ds-space-2;
    padding: $ds-space-1;
    background: $surface;
    border: round $primary-background;
    height: auto;
}

.settings-select, .settings-input {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    min-height: $ds-size-3;
    height: auto;
}

.checkbox-group {
    margin-bottom: $ds-space-1;
}

.warning-text {
    color: $warning;
    margin-bottom: $ds-space-1;
    text-style: italic;
}

.settings-actions {
    margin-top: $ds-space-2;
    layout: horizontal;
    height: auto;
    align: center middle;
}

.settings-actions Button {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

/* Configuration file settings specific */
.config-file-settings-container {
    height: $ds-height-full;
    width: $ds-width-full;
}

.config-editor {
    height: $ds-size-20;
    min-height: $ds-size-20;
    border: round $primary;
    background: $panel;
    margin-bottom: $ds-space-1;
}

.config-button-container {
    layout: horizontal;
    height: auto;
    margin-top: $ds-space-1;
    align: center middle;
}

.config-button-container Button {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

.tab-description {
    color: $text-muted;
    margin-bottom: $ds-space-1;
    text-style: italic;
}

/* --- Core Settings Styles --- */
.core-settings-container {
    padding: $ds-space-1 $ds-space-2;
    width: $ds-width-full;
    height: $ds-height-full;
}

.settings-group {
    background: $surface;
    padding: $ds-space-1;
    margin-bottom: $ds-space-2;
    border: round $primary-background;
}

.settings-input {
    width: $ds-width-full;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.settings-select {
    width: $ds-width-full;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.settings-subsection-title {
    color: $text;
    text-style: bold;
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
}

.settings-note {
    color: $text-muted;
    text-style: italic;
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
}

.checkbox-group {
    layout: horizontal;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.checkbox-group Checkbox {
    margin-right: $ds-space-2;
}

.settings-actions {
    layout: horizontal;
    margin-top: $ds-space-2;
    align: center middle;
}

.settings-actions Button {
    margin: $ds-space-0 $ds-space-1;
    min-width: $ds-size-15;
}

/* --- End Core Settings Styles ---*/

/* --- Config Form Styles --- */
.config-form {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-1 $ds-space-2;
    overflow-y: auto;
}

/* ADR-161 task 6: the bare .form-label/.form-section-title/.form-actions
 * duplicates that used to live here were folded into their owning sheet
 * components/_forms.tcss (same computed values, tokenized); only
 * feature-specific compounds remain in this sheet. */

.form-description {
    color: $text-muted;
    margin-bottom: $ds-space-2;
    text-style: italic;
}

.form-subsection-title {
    text-style: bold;
    color: $secondary;
    margin: $ds-space-1 $ds-space-0 $ds-space-1 $ds-space-0;
}

.form-actions Button {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    min-width: $ds-size-15;
}

/* TextArea styling for config forms */
.config-form TextArea {
    width: $ds-width-full;
    height: $ds-size-10;
    margin-bottom: $ds-space-1;
    border: round $primary;
    background: $panel;
}

.system-prompt-textarea {
    height: $ds-size-15;
}

.provider-models-textarea {
    height: $ds-size-5;
}

/* Collapsible styling in config forms */
.config-form Collapsible {
    margin-bottom: $ds-space-1;
    border: round $primary-background;
    background: $surface;
}

.config-form Collapsible > CollapsibleTitle {
    background: $boost;
    padding: $ds-space-0 $ds-space-1;
}

/* Help text */
.help-text {
    color: $text-muted;
    margin-bottom: $ds-space-1;
    text-style: italic;
}

/* Database status */
.db-status {
    color: $text-muted;
    margin-bottom: $ds-space-1;
}

/* ===== MODULE: features/_ingest.tcss ===== */
/* ========================================
 * FEATURES: Ingest
 * ======================================== 
 * Media ingestion tab styles
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


/* --- Ingest Content Tab --- */
#ingest-window { /* Matches TAB_INGEST */
    layout: vertical !important; /* Override .window class */
    height: $ds-height-full;
    width: $ds-width-full;
}

/* Override the horizontal layout from .window class */
#ingest-window.window {
    layout: vertical !important;
}
.tldw-api-media-specific-options { /* Common class for specific option blocks */
    padding: $ds-space-1;
    border: round $surface;
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
}

/* Added to ensure initially hidden specific options are indeed hidden */
.tldw-api-media-specific-options.hidden {
     display: none;
}

.ingest-nav-pane { /* Style for the left navigation pane */
    dock: left;
    width: $ds-percent-25;
    min-width: $ds-size-20;
    max-width: $ds-size-40;
    height: $ds-height-full;
    background: $boost; /* Or a slightly different shade */
    padding: $ds-space-1;
    border-right: thick $background-darken-1;
    /* Removed overflow properties - let VerticalScroll handle scrolling */
}

.ingest-nav-pane .ingest-nav-button { /* Style for navigation buttons */
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    border: none;
    height: $ds-size-3;
}
.ingest-nav-pane .ingest-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}
/* Active state for selected ingest nav button */
.ingest-nav-pane .ingest-nav-button.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Collapsible sidebar styles */
.ingest-nav-pane.collapsed {
    width: $ds-size-4;
    min-width: $ds-size-4;
    padding: $ds-space-1 $ds-space-0;
}

.nav-header {
    width: $ds-width-full;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

.nav-toggle-button {
    width: $ds-size-3;
    height: $ds-size-3;
    min-width: $ds-size-3;
    padding: $ds-space-0;
    text-align: center;
}

/* Adjust button appearance when collapsed */
.ingest-nav-pane.collapsed .ingest-nav-button {
    width: $ds-size-3;
    padding: $ds-space-0;
    /* Show only first letter or icon */
    overflow: hidden;
}

/* Style for sidebar section titles */
.ingest-nav-pane .sidebar-title {
    text-style: bold;
    color: $primary;
    margin-top: $ds-space-2;
    margin-bottom: $ds-space-1;
    padding-left: $ds-space-1;
    border-left: thick $accent;
}
/* Active state for selected ingest nav button (optional) */
/* .ingest-nav-pane .ingest-nav-button.-active-view {
    background: $accent-darken-1;
    color: $text;
} */

.ingest-content-pane { /* Style for the right content display area */
    width: $ds-width-fill;
    height: $ds-height-full;
    padding: $ds-space-1 $ds-space-2;
    /* Removed overflow - let child VerticalScroll widgets handle scrolling */
}

.ingest-view-area { /* Common class for individual content areas */
    width: $ds-width-full;
    height: $ds-height-full;
}
.ingest-label {
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-0;
}
.ingest-selected-files-list {
    min-height: $ds-size-5;
    max-height: $ds-size-10;
    height: auto;
    border: round $ds-focus-accent;
    margin-bottom: $ds-space-1;
    background: $surface;
}
.LocalIngestionPanel .file-selection-container {
    height: $ds-height-fill;
    min-height: $ds-size-15;
    border: solid $primary;
    margin-bottom: $ds-space-1;
    padding: $ds-space-1;
}
.ingest-preview-area {
    height: $ds-height-fill;
    min-height: $ds-size-10;
    border: round $primary-lighten-2;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
    background: $surface;
}
.ingest-preview-area > Static#ingest-prompts-preview-placeholder {
    color: $text-muted;
    width: $ds-width-full;
    text-align: center;
    padding: $ds-space-2 $ds-space-0;
}
.ingest-status-area {
    min-height: $ds-size-5;
    max-height: $ds-size-15;
    height: auto;
    margin-top: $ds-space-1;
}

.prompt-preview-item {
    border: panel $background-lighten-2;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
}
.prompt-preview-item .prompt-title {
    text-style: bold;
}
.prompt-preview-item .prompt-field-label {
    text-style: italic;
    color: $text-muted;
}
.prompt-preview-item Markdown {
    background: $surface-darken-1;
    padding: $ds-space-0 $ds-space-1;
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
    border: solid $primary-darken-1; /* Use 'solid' instead of 'narrow' */
    max-height: $ds-size-10;
    overflow-y: auto;
}
.prompt-preview-item .prompt-details-text {
    max-height: $ds-size-5;
    overflow-y: auto;
    background: $surface;
    padding: $ds-space-0 $ds-space-1;
    border: dashed $primary-darken-2; /* Use 'dashed' instead of 'dotted' */
    margin-bottom: $ds-space-1;
}

/* Ensure VerticalScroll containers fill their parent */
.ingest-view-area VerticalScroll {
    height: $ds-height-fill;
    width: $ds-width-full;
}

/* Ensure VerticalScroll containers fill available space */
VerticalScroll.ingest-view-area {
    height: $ds-height-fill;
    width: $ds-width-full;
}

VerticalScroll.ingest-form-scrollable {
    height: $ds-height-fill;
    width: $ds-width-full;
}

/* Scrollable form container needs padding to prevent content cutoff */
.ingest-form-scrollable {
    height: $ds-height-full;
    overflow-y: auto;
    padding: $ds-space-1;
}

/* Removed .ingest-media-tab-content - no longer needed since parent is VerticalScroll */




.ingest-form-row {
    margin-top: $ds-space-1;
}

.ingest-form-col {
    width: $ds-percent-50;
    padding-right: $ds-space-1;
}

.title-author-row {
    margin-bottom: $ds-space-1;
}

/* Ensure title/author input boxes are visible */
.title-author-row Input {
    height: $ds-size-3;
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

.ingest-textarea-small {
    min-height: $ds-size-3;
    max-height: $ds-size-8;
    height: auto;
    margin-bottom: $ds-space-1;
}

.ingest-textarea-medium {
    min-height: $ds-size-10;
    max-height: $ds-size-20;
    height: auto;
    margin-bottom: $ds-space-1;
}


/* All ingest views are controlled programmatically */
.ingest-view-area {
    /* display controlled by app.py watcher */
    height: $ds-height-full;
    width: $ds-width-full;
}

/* --- Visibility styles for ingest views --- */
/* Views are controlled programmatically via styles.display */


/* Ensure the IngestWindowTabbed container fills available space */
IngestWindowTabbed {
    height: $ds-height-fill;
    width: $ds-width-full;
    layout: vertical;
}

/* Ensure TabbedContent in ingest window displays properly */
#ingest-window TabbedContent {
    height: $ds-height-fill;  /* Use fr unit for flexible sizing */
    width: $ds-width-full;
}

.media-tab-container {
    height: $ds-height-fill;  /* Use fr unit instead of 100% */
    padding: $ds-space-1;
}

.source-toggle-container {
    dock: top;
    height: auto;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
    border-bottom: solid $primary;
}

.tab-title {
    text-style: bold;

    margin-bottom: $ds-space-1;
}

.source-toggle {
    layout: horizontal;
    height: auto;
    margin-top: $ds-space-1;
}

.source-toggle RadioButton {
    margin-right: $ds-space-2;
}

.source-content {
    height: $ds-height-fill;
    width: $ds-width-full;
    overflow-y: auto;
}

/* Ensure content areas within tabs fill space */
.ingest-form-scrollable {
    height: $ds-height-fill;
    width: $ds-width-full;
}




.source-content.hidden {
    display: none;
}

/* Compact file lists for better space usage */
.ingest-selected-files-list {
    min-height: $ds-size-3;
    max-height: $ds-size-8;
    height: auto;
    border: round $ds-focus-accent;
    margin-bottom: $ds-space-1;
    background: $surface;
}

/* Status section at top of forms */
.status-dashboard {
    width: $ds-width-full;
    height: auto;
    max-height: $ds-size-8;      /* Prevent status from taking too much space */
    min-height: $ds-size-3;
    background: $surface;
    border: round $primary;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
}

/* Mode-specific visibility controls */
.simple-mode .advanced-only {
    display: none !important;
}

.advanced-mode .advanced-only {
    display: block !important;
}

/* URL input always visible */
.url-input-section {
    display: block;
    margin-top: $ds-space-1;
    padding: $ds-space-1;
    border: round $primary;
    background: $surface;
}

/* Simplified form sections */
.essential-fields {
    border: round $accent;
    padding: $ds-space-1;
    margin-bottom: $ds-space-2;
    background: $surface-lighten-1;
}

/* Placeholder text */
.placeholder-text {
    color: $text-muted;
    text-align: center;
    padding: $ds-size-4;
}

/* Mode toggle styles */
.mode-toggle-container {
    dock: top;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
}

.mode-toggle {
    layout: horizontal;
    height: auto;
}

.mode-toggle RadioButton {
    margin-right: $ds-space-2;
}

/* File selection row */
.file-selection-row {
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

.file-selection-row Button {
    margin-right: $ds-space-1;
}

/* Enhanced file list with metadata */
.file-list-with-metadata {
    min-height: $ds-size-5;
    max-height: $ds-size-10;
    border: round $primary;
    background: $surface;
}

/* Metadata row */
.metadata-row {
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
}

.metadata-col {
    width: $ds-percent-50;
    padding-right: $ds-space-1;
}

/* Process button */
.process-button {
    width: $ds-width-full;
    height: $ds-size-4;
    margin-top: $ds-space-2;
    text-style: bold;
}

/* Advanced options container */
.advanced-options-container {
    margin-top: $ds-space-1;
}

.advanced-options-container.hidden {
    display: none;
}

/* Time range row */
.time-range-row {
    margin-top: $ds-space-1;
}

.time-col {
    width: $ds-percent-50;
    padding-right: $ds-space-1;
}

/* Chunk settings row */
.chunk-settings-row {
    margin-top: $ds-space-1;
}

.chunk-col {
    width: $ds-percent-50;
    padding-right: $ds-space-1;
}

/* Status Dashboard Styles */
.status-dashboard-container {
    border: round $primary;
    background: $surface;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
}

.status-main-row {
    height: $ds-size-3;
    align: left middle;
}

.status-message {
    width: $ds-width-fill;
    text-style: bold;
}

.file-counter {
    width: auto;
    margin-left: $ds-space-2;
    color: $text-muted;
}

.time-display {
    width: auto;
    margin-left: $ds-space-2;
    color: $text-muted;
}

.action-buttons {
    width: auto;
    dock: right;
    layout: horizontal;
}

.action-buttons.hidden {
    display: none;
}

.small-button {
    height: $ds-size-3;
    min-width: $ds-size-8;
    margin-left: $ds-space-1;
}

.small-button.hidden {
    display: none;
}

/* Progress bar in dashboard */
.status-dashboard-container ProgressBar {
    margin-top: $ds-space-1;
    height: $ds-size-1;
}

.status-dashboard-container ProgressBar.hidden {
    display: none;
}

/* Alert container */
.alert-container {
    margin-top: $ds-space-1;
    padding: $ds-space-1;
    border: round $error;
    background: $error 10%;
}

.alert-container.hidden {
    display: none;
}

.alert-messages {
    color: $text;
    max-height: $ds-size-6;
    overflow-y: auto;
}

/* Enhanced File List Styles */
.file-list-enhanced {
    border: round $primary;
    background: $surface;
    padding: $ds-space-0;
}

.file-items-container {
    max-height: $ds-size-10;
    overflow-y: auto;
    padding: $ds-space-1;
}

.file-list-item-container {
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
    border: round $surface-lighten-2;
    background: $surface-lighten-1;
    height: auto;
}

.file-list-item-container:hover {
    background: $surface-lighten-2;
    border: round $primary;
}

.file-info-main {
    width: $ds-width-fill;
}

.file-name-row {
    height: auto;
    margin-bottom: $ds-space-0;
}

.file-icon {
    width: $ds-size-3;
    text-align: center;
}

.file-name {
    width: $ds-width-fill;
    text-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
}

.file-metadata {
    color: $text-muted;

    margin-left: $ds-space-3;
}

.file-remove-button {
    width: $ds-size-3;
    height: $ds-size-3;
    min-width: $ds-size-3;
    margin: $ds-space-0;
    padding: $ds-space-0;
    text-align: center;
}

.no-files-message {
    text-align: center;
    color: $text-muted;
    padding: $ds-space-3;
}

.file-list-summary {
    dock: bottom;
    height: $ds-size-3;
    padding: $ds-space-1;
    border-top: solid $primary;
    background: $surface-darken-1;
    text-align: center;
    color: $text-muted;
}

/* --- END OF INTEGRATED NEW CSS --- */

/* ===== MODULE: features/_evaluation_unified.tcss ===== */
/* ========================================
 * FEATURES: Unified Evaluation Dashboard
 * ======================================== 
 * Single-page responsive design with collapsibles
 * Based on original UX design specifications
 * ======================================== */


.dashboard-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.quick-actions {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
}

/* Drop zone styling */
.drop-zone {
    layout: horizontal;
    height: 3;
    background: $panel;
    border: dashed $primary;
    padding: 0 2;
    align: center middle;
    margin: 1 0;
}

.drop-zone:hover {
    background: $boost;
    border: solid $primary;
}


/* --- Main Content Area --- */
.main-content {
    padding: 1;
}

/* Ensure VerticalScroll works properly inside the evals dashboard.
   This selector MUST stay scoped: a bare `VerticalScroll` rule applies
   app-wide and (because stylesheet rules always outrank widget DEFAULT_CSS
   in Textual, regardless of specificity) silently overrides every widget's
   own `height: 1fr` sizing, pushing follow-on siblings off-screen. */

/* Make sure the entire window uses available height */
EvalsWindow {
    height: 100%;
}

/* --- Collapsible Sections --- */
Collapsible {
    margin-bottom: 1;
    border: tall $surface;
    background: $panel;
}

Collapsible > Container {
    padding: 1;
}

Collapsible.-collapsed {
    margin-bottom: 1;
}

/* Note: Textual doesn't support @media queries
   Use reactive attributes or resize events for responsive design */

/* Template Grid */
.template-grid {
    layout: grid;
    grid-columns: 1fr 1fr;
    grid-gutter: 1;
    margin-top: 1;
}

.template-card {
    height: 5;
    padding: 1;
    background: $surface;
    border: tall $primary;
    text-align: center;
}

.template-card:hover {
    background: $boost;
    border: thick $primary;
}

/* Action Bar */
.action-bar {
    layout: horizontal;
    background: $surface;
    padding: 1;
    margin: 2 0;
    border: tall $primary;
    align: center middle;
}

/* Results Dashboard */
.results-header {
    layout: horizontal;
    height: 3;
    margin-bottom: 1;
    align: left middle;
}

.results-header Static {
    width: 1fr;
}

.results-header Select {
    width: 20;
}

.results-list {
    height: 15;
    background: $surface;
    border: tall $secondary;
    margin-bottom: 2;
}

.stat-card {
    background: $surface;
    padding: 1;
    border: tall $secondary;
    text-align: center;
}

.stat-value {
    text-style: bold;
    color: $primary;
}

.button-row {
    layout: horizontal;
    margin-bottom: 1;
}

.button-row Button {
    margin-right: 1;
}

/* Status Bar */
.status-bar {
    height: 3;
    background: $surface;
    border-top: solid $primary;
    padding: 0 2;
    layout: horizontal;
    align: left middle;
}

.status-text {
    width: 1fr;
}

/* Responsive Adjustments - handled in Python code via resize events */
/* For narrow screens, switch grids to single column */

/* Utility Classes */
.hidden {
    display: none;
}

.help-text {
    color: $text-muted;
    text-style: italic;
}

/* Disabled States */
Button:disabled {
    opacity: 0.5;
}

/* Loading States */
.loading {
    opacity: 0.6;
}

/* Error States */
.error {
    border: tall $error;
    background: $error 10%;
}

/* ===== MODULE: features/_evals.tcss ===== */

/* Explicit, not relying on the generic `.evals-rail-row { border: none }`
   above to win by cascade order against `.is-active { border: round
   $ds-action-focus }` (components/_agentic_terminal.tcss). Both rules are
   equal specificity (one class each); today `.evals-rail-row` happens to
   be declared later in the manifest, so it wins, but a manifest reorder
   could silently flip that and reintroduce the row's only content line
   being consumed by a round border (a real height-1 button needs at
   least 2 lines for a round border to render at all) -- mirrors
   `#mcp-hub-rail Button.mcp-rail-row.is-active`'s own override for the
   identical reason. */
.evals-rail-row.is-active {
    border: none;
    text-style: bold;
}

#evals-inspector-bench .ds-recovery-callout {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* ===== MODULE: features/_metrics.tcss ===== */
/* ========================================
 * FEATURES: Metrics
 * ======================================== 
 * Metrics display styles
 * ======================================== */

/* --- Metrics Screen Styling --- */
MetricsScreen {
    padding: 1 2; /* Add some padding around the screen content */
    /* layout: vertical; /* MetricsScreen is a Static, VerticalScroll handles layout */
    /* align: center top; /* If needed, but VerticalScroll might handle this */
}

#metrics-container {
    padding: 1;
    /* border: round $primary-lighten-2; /* Optional: a subtle border */
    /* background: $surface; /* Optional: a slightly different background */
}

/* Styling for individual metric labels within MetricsScreen */
MetricsScreen Label {
    width: 100%;
    margin-bottom: 1; /* Space between metric items */
    padding: 1;       /* Padding inside each label's box */
    background: $panel-lighten-1; /* A slightly lighter background for each item */
    border: round $primary-darken-1; /* Border for each item */
    /* Textual CSS doesn't allow direct styling of parts of a Label's text (like key vs value) */
    /* The Python code uses [b] for keys, which Rich Text handles. */
}

/* Style for the title label: "Application Metrics" */
/* This targets the first Label directly inside the VerticalScroll with ID metrics-container */
#metrics-container > Label:first-of-type {
    text-style: bold underline;
    align: center middle;
    padding: 1 0 2 0; /* More padding below the title */
    background: transparent; /* No specific background for the title itself */
    border: none; /* No border for the title itself */
    margin-bottom: 2; /* Extra space after the title */
}

/* Style for error messages within MetricsScreen */
/* These require the Python code to add the respective class to the Label widget */
MetricsScreen Label.-error-message {
    color: $error; /* Text color for errors */
    background: $error 20%; /* Background for error messages, e.g., light red. USES $error WITH 20% ALPHA */
    /* border: round $error; /* Optional: border for error messages */
    text-style: bold;
}

/* Style for info messages (e.g. "file empty") within MetricsScreen */
MetricsScreen Label.-info-message {
    color: $text-muted; /* Or another color that indicates information */
    background: $panel; /* A more subdued background, or $transparent */
    /* border: round $primary-lighten-1; /* Optional: border for info messages */
    text-style: italic;
}
/* --- End of Metrics Screen Styling --- */

/* ===== MODULE: features/_embeddings.tcss ===== */
/* ========================================
 * Embeddings Feature Styles
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


/* Sidebar title styling */
.sidebar-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    color: $text-muted;
}

/* ========================================
 * Confirmation Dialog Styles
 * ======================================== */

/* Dialog container for modal screens */
#dialog-container {
    align: center middle;
    background: $surface;
    border: thick $primary;
    padding: $ds-space-2;
    width: $ds-size-50;
    height: auto;
}

#dialog-title {
    text-style: bold;
    text-align: center;
    margin-bottom: $ds-space-1;
    width: $ds-width-full;
}

#dialog-message {
    text-align: center;
    margin-bottom: $ds-space-2;
    color: $text-muted;
    width: $ds-width-full;
}

#dialog-buttons {
    layout: horizontal;
    align: center middle;
    width: $ds-width-full;
    margin-top: $ds-space-1;
}

#dialog-buttons Button {
    margin: $ds-space-0 $ds-space-1;
    min-width: $ds-size-10;
}

/* Modal screen background */
ModalScreen {
    align: center middle;
    background: $background 80%;
}

/* ========================================
 * Form Validation Error Styles
 * ======================================== */

/* Error message displays */
.error-message {
    color: $error;

    margin-top: $ds-space-0;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    text-style: italic;
}

.error-message.hidden {
    display: none;
}

/* ========================================
 * Enhanced List Item Styles
 * ======================================== */

.model-header {
    layout: horizontal;
    margin-bottom: $ds-space-0;
}

.model-name {
    text-style: bold;
    margin-right: $ds-space-1;
}

.model-provider {
    color: $text-muted;

}

.model-download-status,
.model-memory-status,
.model-size {

    margin-right: $ds-space-2;
}

.model-size {
    color: $text-muted;
}

/* ========================================
 * Empty State Styles
 * ======================================== */

.empty-state-container {
    width: $ds-width-full;
    height: $ds-height-full;
    align: center middle;
    padding: $ds-space-3;
}

.empty-state-content {
    align: center middle;
    width: auto;
}

.empty-state-icon {

    margin-bottom: $ds-space-1;
    text-align: center;
}

.empty-state-title {
    text-style: bold;

    margin-bottom: $ds-space-1;
    text-align: center;
}

.empty-state-description {
    color: $text-muted;
    margin-bottom: $ds-space-2;
    text-align: center;
    max-width: $ds-size-40;
}

.empty-state-action {
    margin-top: $ds-space-1;
}

/* ========================================
 * Enhanced Visual Design
 * ======================================== */

/* Enhanced hover states */
/* Button:hover handled in components/_buttons.tcss to fix persistent hover issue */

/* TASK-2300 + review wave I1. This was `Select:hover { border: solid ... }`,
 * which added two rows of chrome to a widget that has no border of its own
 * (a `Select` draws one on its child) -- so on a one-row compact Select the
 * value vanished behind it, on the way TO clicking, before anything had been
 * chosen.
 *
 * The first fix moved it to `Select:hover > SelectCurrent`, which is DEAD:
 * Textual assigns `:hover` to the innermost widget under the pointer that has
 * a hover style, and `_has_hover_style` is derived from the selector NAMES a
 * rule mentions (`css/stylesheet.py:506`). Naming `SelectCurrent` in the rule
 * is what makes `SelectCurrent` the hover target -- so the `Select` never gets
 * `:hover` and `Select:hover > ...` can never match. Measured on the
 * production bundle: `select.mouse_hover=False`, `current.mouse_hover=True`,
 * painted rows identical at rest and hovered.
 *
 * Written to match the mechanism instead of fighting it: the pseudo-class goes
 * on `SelectCurrent`, which is both the widget Textual actually hovers AND the
 * one painting the surface a user sees. `background` rather than `border`, so
 * it recolours cells the widget already draws and moves nothing -- geometry
 * changes on hover are what made C1's frame strobe, because they move the
 * pointer's own target out from under it. `$surface-lighten-1` is this app's
 * established hover background (`ListView ListItem:hover`,
 * `OptionList > .option-list--option-hover`, `DataTable > .datatable--hover`),
 * so the cue now reads the same as every other hoverable row.
 */
Select > SelectCurrent:hover {
    background: $surface-lighten-1;
}


/* Visual separators */
.section-separator {
    height: $ds-size-1;
    background: $primary-darken-2;
    margin: $ds-space-2 $ds-space-0;
}

/* ========================================
 * Tooltip and Help Icon Styles
 * ======================================== */

/* Tooltip container */
.tooltip {

    background: $panel;
    border: solid $primary;
    padding: $ds-space-1;
    max-width: $ds-size-40;

    display: none;
}

.tooltip-content {
    color: $text;

}

/* Help icon */
.help-icon {

    margin-left: $ds-space-1;
    color: $primary;
}

.help-icon:hover {
    color: $primary-lighten-1;
}

/* ========================================
 * Chunk Preview Widget Styles
 * ======================================== */

.chunk-preview-widget {
    width: $ds-width-full;
    height: auto;
}

.chunk-preview-container {
    width: $ds-width-full;
    max-height: $ds-size-30;
    background: $surface;
    border: round $primary-darken-1;
    padding: $ds-space-1;
}

.chunk-preview-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
    color: $primary;
}

.chunk-preview-empty {
    color: $text-muted;
    text-align: center;
    padding: $ds-space-2;
}

.chunk-item {
    margin-bottom: $ds-space-2;
    padding: $ds-space-1;
    background: $panel;
    border: round $primary-darken-2;
}

.chunk-header {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    padding-bottom: $ds-space-1;
    border-bottom: dashed $primary-darken-2;
}

.chunk-number {
    text-style: bold;
    color: $accent;
    margin-right: $ds-space-2;
}

.chunk-range {
    color: $text-muted;

    margin-right: $ds-space-2;
}

.chunk-size {
    color: $text-muted;

}

.chunk-overlap {
    background: $warning 20%;
    padding: $ds-space-0 $ds-space-1;
    margin-bottom: $ds-space-1;
    border-left: thick $warning;
    text-style: italic;
    color: $text-muted;
}

.chunk-content {
    padding: $ds-space-0 $ds-space-1;

}

.chunk-truncated {
    color: $text-muted;
    text-style: italic;
    text-align: right;
    margin-top: $ds-space-0;
}

.chunk-more {
    text-align: center;
    color: $text-muted;
    text-style: italic;
    margin-top: $ds-space-1;
}

.chunk-boundary {
    text-align: center;
    color: $primary-darken-1;
    margin: $ds-space-1 $ds-space-0;
}

/* ========================================
 * Batch Selection Styles
 * ======================================== */

.batch-controls {
    layout: horizontal;
    margin: $ds-space-1 $ds-space-0;
    padding: $ds-space-1;
    background: $surface;
    border: round $primary;
}

.batch-controls.hidden {
    display: none;
}

.batch-button {
    margin: $ds-space-0 $ds-space-1;
    min-width: $ds-size-12;
    height: $ds-size-3;
}

/* ========================================
 * Toast Notification Styles
 * ======================================== */

.toast-manager {
    dock: top;
    align: right top;
    width: auto;
    height: auto;
    margin: $ds-space-2 $ds-space-2 $ds-space-0 $ds-space-0;
    layer: above;

}

.toast-stack {
    width: auto;
    height: auto;
}

.toast-notification {
    width: $ds-size-35;
    margin-bottom: $ds-space-1;
}

.toast-container {
    layout: horizontal;
    padding: $ds-space-1;
    border: round;
    align: left middle;
}

.toast-icon {
    margin-right: $ds-space-1;
    min-width: $ds-size-3;
    text-align: center;
}

.toast-message {
    width: $ds-width-fill;
    text-wrap: wrap;
}

.toast-close {
    min-width: $ds-size-3;
    height: $ds-size-3;
    margin-left: $ds-space-1;
    background: transparent;
    border: none;
}

.toast-close:hover {
    background: $background 50%;
}

/* Toast severity styles */
.toast-success {
    background: $success 90%;
    border: solid $success;
    color: $text;
}

.toast-info {
    background: $primary 90%;
    border: solid $primary;
    color: $text;
}

.toast-warning {
    background: $warning 90%;
    border: solid $warning;
    color: $text;
}

.toast-error {
    background: $error 90%;
    border: solid $error;
    color: $text;
}

/* Toast animations */
.toast-slide-in {
    /* Animation properties would go here if needed */
}

/* ========================================
 * Detailed Progress Bar Styles
 * ======================================== */

.detailed-progress-container {
    width: $ds-width-full;
    padding: $ds-space-1;
    background: $panel;
    border: round $primary;
}

.progress-stage-row,
.progress-item-row,
.progress-metrics-row {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    align: left middle;
}

.progress-action-row {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    align: right middle;
}

.progress-label {
    width: $ds-size-12;
    text-align: right;
    margin-right: $ds-space-1;
    color: $text-muted;
}

.stage-indicator {
    width: $ds-width-fill;
    text-style: bold;
    color: $primary;
}

.current-item {
    width: $ds-width-fill;
    color: $text;
    text-style: italic;
}

.pause-button {
    min-width: $ds-size-10;
}

#main-progress {
    margin-bottom: $ds-space-1;
    height: $ds-size-3;
}

.stage-progress {
    height: $ds-size-2;
    background: $surface;
}

.progress-metrics-row {
    margin-top: $ds-space-1;
    border-top: dashed $primary-darken-2;
    padding-top: $ds-space-1;
}

.metric-group {
    margin-right: $ds-space-3;
}

.metric-label {

    color: $text-muted;
    margin-bottom: $ds-space-0;
}

.metric-value {

    text-style: bold;
    color: $primary;
}

/* ========================================
 * Embedding Template Selector Styles
 * ======================================== */

/* Template selector dialog */
#embedding-template-selector-container {
    width: $ds-size-80;
    height: $ds-size-50;
    background: $panel;
    border: thick $primary;
    padding: $ds-space-2;
}

#embedding-template-selector-title {
    text-style: bold;
    text-align: center;
    margin-bottom: $ds-space-2;
}

#embedding-template-selector-content {
    height: $ds-height-fill;
    margin-bottom: $ds-space-2;
}

#embedding-template-category-pane {
    width: $ds-percent-25;
    min-width: $ds-size-20;
    background: $surface;
    padding: $ds-space-1;
    border-right: solid $primary-darken-1;
}

#embedding-template-grid-container {
    width: $ds-width-fill;
    padding: $ds-space-1;
    overflow-y: auto;
}

.embedding-template-grid {
    grid-columns: 2;
    grid-gutter: 1;
    padding: $ds-space-1;
}

/* Template card styles */
.embedding-template-card-container {
    background: $surface;
    border: round $primary-darken-2;
    padding: $ds-space-1;
    height: auto;
}

.embedding-template-card:hover .embedding-template-card-container {
    background: $surface-lighten-1;
    border: solid $accent;
}

.embedding-template-card-header {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    align: left middle;
}

.embedding-template-card-title {
    text-style: bold;
    color: $primary;
    width: $ds-width-fill;
}

.embedding-template-card-category {

    color: $text-muted;
    background: $primary 20%;
    padding: $ds-space-0 $ds-space-1;
    border: round $primary;
}

.embedding-template-card-description {
    margin-bottom: $ds-space-1;
    color: $text-muted;

}

.embedding-template-card-label {

    text-style: bold;
    margin-bottom: $ds-space-0;
}

.embedding-template-card-list {
    margin-left: $ds-space-1;
    margin-bottom: $ds-space-1;
}

.embedding-template-card-item {

    color: $text-muted;
}

.embedding-template-card-button {
    width: $ds-width-full;
    margin-top: $ds-space-1;
}

/* Quick select widget */
.embedding-template-quick-select-container {
    layout: horizontal;
    align: left middle;
    padding: $ds-space-1;
    background: $surface;
    border: round $primary-darken-2;
    margin-bottom: $ds-space-1;
}

.embedding-template-select-label {
    margin-right: $ds-space-2;
    min-width: $ds-size-10;
}

.embedding-template-quick-button {
    margin-right: $ds-space-1;
    min-width: $ds-size-15;
}

.embedding-template-browse-button {
    margin-left: $ds-space-1;
}

.current-template-name {
    margin-left: $ds-space-2;
    color: $success;
    text-style: italic;
}

/* ========================================
 * Activity Log Widget Styles
 * ======================================== */

.activity-log-widget {
    width: $ds-width-full;
    height: $ds-height-full;
}

.activity-log-container {
    width: $ds-width-full;
    height: $ds-height-full;
    background: $panel;
    border: round $primary-darken-2;
    padding: $ds-space-1;
}

.activity-log-header {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    align: left middle;
}

.activity-log-title {
    text-style: bold;

    width: $ds-width-fill;
}

.activity-log-actions {
    layout: horizontal;
}

.activity-log-actions Button {
    margin-left: $ds-space-1;
    min-width: $ds-size-10;
    height: $ds-size-3;
}

.activity-log-controls {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    align: left middle;
}

.filter-button {
    margin-right: $ds-space-1;
    min-width: $ds-size-8;
    height: $ds-size-3;
    background: $surface;
}

.filter-button:hover {
    background: $primary 30%;
}

.filter-button.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.log-search-input {
    width: $ds-size-20;
}

.activity-log-scroll {
    height: $ds-height-fill;
    background: $surface;
    border: round $primary-darken-3;
    padding: $ds-space-1;
}

.log-entries-container {
    width: $ds-width-full;
}

/* Log entry styles */
.log-entry {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0;
    align: left top;
}

.log-timestamp {
    min-width: $ds-size-10;

    color: $text-muted;
    text-align: right;
    padding-right: $ds-space-1;
}

.log-icon {
    min-width: $ds-size-3;
    text-align: center;
}

.log-category {
    min-width: $ds-size-12;
    color: $primary;

    padding: $ds-space-0 $ds-space-1;
}

.log-message {
    width: $ds-width-fill;
    padding-left: $ds-space-1;
}

/* Level-specific colors */
.log-info {
    color: $text;
}

.log-info .log-icon {
    color: $primary;
}

.log-success {
    color: $success;
}

.log-success .log-message {
    color: $success;
}

.log-warning {
    color: $warning;
}

.log-warning .log-message {
    color: $warning;
}

.log-error {
    color: $error;
}

.log-error .log-message {
    color: $error;
}

.log-debug {
    color: $text-muted;
    text-style: italic;
}

.log-debug .log-message {
    color: $text-muted;
}

/* Small button styles */
.small-button {
    height: $ds-size-3;
    min-width: $ds-size-8;

}

/* ========================================
 * Performance Metrics Widget Styles
 * ======================================== */


.metrics-title {
    text-style: bold;
    text-align: center;
    margin-bottom: $ds-space-1;

}

.metrics-grid {
    grid-size: 2;
    grid-gutter: 1;
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

/* Metric box styling */
.metric-box {
    background: $surface;
    border: round $primary-darken-2;
    padding: $ds-space-1;
    height: auto;
}


.metric-label {

    color: $text-muted;
}

.metric-value {

    text-style: bold;
    color: $primary;
    text-align: center;
    margin-bottom: $ds-space-0;
}


.io-rate {
    width: $ds-percent-50;
    text-align: center;

}

.io-rate:first-child {
    color: $success;
}

.io-rate:last-child {
    color: $warning;
}

/* ===== MODULE: features/_splash.tcss ===== */
/* Splash Screen Styles */

/* Main splash screen container */
SplashScreen, .splash-screen {
    layer: overlay;
    background: $background;
    width: 100%;
    height: 100%;
    align: center middle;
    dock: top;
}

/* Center container for splash content */
#splash-center {
    width: 100%;
    height: 100%;
    align: center middle;
}

/* Content container */
#splash-content {
    width: 100%;
    height: 100%;
    align: center middle;
    padding: 0;
}

/* Main splash display area */
#splash-main, .splash-main {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    margin: 0;
}

/* Splash display widget - the actual content display area */
#splash-display, .splash-display {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    align: center middle;
    padding: 0;
    margin: 0;
}

/* Progress text */
#splash-progress-text, .splash-progress-text {
    width: 100%;
    text-align: center;
    color: $text-muted;
    margin-bottom: 1;
}

/* Progress bar styling */
#splash-progress-bar, .splash-progress-bar {
    width: 80%;
    max-width: 100;
    height: 1;
    margin: 0 0 0 0;
    align: center middle;
}

#splash-progress-bar Bar {
    color: $success;
}

#splash-progress-bar PercentageStatus {
    text-style: dim;
}

/* Animation-specific styles */

/* Matrix rain effect */
.matrix-rain {
    color: $success;
    text-style: bold;
}

/* Glitch effect */
.glitch-effect {
    color: $text;
    text-style: bold;
}

.glitch-effect-error {
    color: $error;
    text-style: bold;
}

.glitch-effect-warning {
    color: $warning;
    text-style: bold;
}

.glitch-effect-success {
    color: $success;
    text-style: bold;
}

/* Retro terminal effect */
.retro-terminal {
    color: $success;
    background: rgba(0, 0, 0, 0.9);
    text-style: bold;
}

.retro-scanline {
    background: rgba(0, 255, 0, 0.1);
}

/* Fade effect styles */
.fade-in {
    opacity: 0.0;
}


/* Loading placeholder for lazy-loaded content */
.loading-placeholder {
    color: $text-muted;
    text-align: center;
    padding: 4;
}

/* Hide splash screen when not active */
SplashScreen.hidden {
    display: none;
}

/* ===== MODULE: features/_wizards.tcss ===== */
/* Wizard Framework Styles */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space, size, percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */

/* Base Wizard Container */

.wizard-container {
    layout: vertical;
    height: $ds-height-full;
    width: $ds-width-full;
    background: $surface;
    padding: $ds-space-0;
}

.wizard-title {
    text-style: bold;
    text-align: center;
    background: $primary-darken-2;
    color: $text;
    padding: $ds-space-1 $ds-space-2;
    margin-bottom: $ds-space-0;
    border-bottom: thick $primary-darken-1;
    width: $ds-width-full;
    height: $ds-size-3;
}

/* Progress Indicator */

.wizard-progress {
    layout: horizontal;
    align: center middle;
    /* TASK-21148 (UAT Z-3): 1-row padding — the old 2 spent four rows of
       chrome before any step content at 40-row terminals. */
    padding: $ds-space-1 $ds-space-2;
    background: $panel;
    border-bottom: solid $primary-darken-2;
    height: auto;
}

.step-indicator-container {
    layout: horizontal;
    align: center middle;
    width: $ds-width-fill;
}

.step-number {
    width: $ds-size-3;
    height: $ds-size-3;
    border: round $primary;
    background: $panel;
    align: center middle;
    margin-right: $ds-space-1;
    text-align: center;
}

.step-number.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    border: round $ds-focus-accent;
    text-style: bold underline;
}

.step-number.complete {
    background: $success;
    color: $text;
    border: solid $success;
}

.step-title {
    margin-right: $ds-space-1;
    color: $text-muted;
}

.step-title.active {
    color: $ds-focus-fg;
    text-style: bold underline;
}

.step-title.complete {
    color: $success;
}

.step-connector {
    height: $ds-size-1;
    width: $ds-width-fill;
    background: $primary-darken-2;
    margin: $ds-space-0 $ds-space-1;
}

.step-connector.complete {
    background: $success;
}

/* Step Container */

.wizard-steps-container {
    height: $ds-height-fill;
    width: $ds-width-full;
    overflow-y: auto;
    padding: $ds-space-0;
    background: $surface;
}

.wizard-step {
    width: $ds-width-full;
    height: $ds-height-full;
    padding: $ds-space-1 $ds-space-2;
    display: block;
    visibility: hidden;
}

.wizard-step.active {
    visibility: visible;
}

.wizard-step.hidden {
    display: none;
}

/* Step animations removed - not supported in Textual */

/* Navigation Bar */

.wizard-navigation {
    layout: horizontal;
    align: center middle;
    padding: $ds-space-1 $ds-space-2;
    background: $panel;
    border-top: thick $primary-darken-2;
    height: $ds-size-5;
}

/* TASK-21142 (UAT N-2): Textual focus order is VISUAL (y, x) order, so the
   footer adopts the Windows-wizard convention — progress text docked left,
   right-aligned [Back][Next][Exit] cluster — making Next the first enabled
   Tab stop after step content, before the abandon action. */
.setup-navigation { align: right middle; }
.setup-navigation .wizard-progress-text {
    dock: left;
    width: auto;
    height: $ds-height-full;
    content-align: left middle;
    padding: $ds-space-0 $ds-space-2;
}
.setup-navigation #wizard-cancel { height: $ds-size-3; min-width: $ds-size-12; }

.wizard-progress-text {
    width: $ds-width-fill;
    text-align: center;
    color: $text-muted;
}

#wizard-back, #wizard-next {
    min-width: $ds-size-15;
    height: $ds-size-3;
}

#wizard-back:disabled {
    opacity: 0.5;
}

#wizard-next:disabled {
    opacity: 0.5;
}

/* Content Type Selection */


.content-type-card {
    background: $panel;
    border: round $primary-darken-2;
    padding: $ds-space-2;
    align: center middle;
    height: $ds-size-15;
}

.content-type-card:hover {
    background: $panel-lighten-1;
    border: solid $accent;
}

.content-type-card.selected {
    background: $ds-focus-bg;
    border: round $ds-focus-accent;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.content-type-title {
    text-style: bold;
    margin-bottom: $ds-space-0;
    text-align: center;
}

.content-type-description {
    color: $text-muted;
    text-align: center;
}

.content-type-card.selected .content-type-title,
.content-type-card.selected .content-type-description {
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Content Selection */


.content-search-input {
    width: $ds-width-full;
    margin-bottom: $ds-space-2;
}

.content-search-input.hidden {
    display: none;
}


.preview-label {
    text-style: bold;
    margin-bottom: $ds-space-1;
    color: $primary;
}

.content-list {
    width: $ds-width-full;
}

.content-item {
    width: $ds-width-full;
    padding: $ds-space-1;
    margin-bottom: $ds-space-0;
    border-bottom: dashed $primary-darken-3;
}

.content-item:hover {
    background: $panel 50%;
}




.placeholder-text {
    text-align: center;
    color: $text-muted;
    padding: $ds-space-2;
}

/* Quick Settings */

.settings-section {
    margin-bottom: $ds-space-2;
    padding: $ds-space-1;
    background: $panel;
    border: round $primary-darken-3;
}

.settings-input {
    width: $ds-width-full;
    margin-bottom: $ds-space-0;
}

.settings-help {
    color: $text-muted;
    margin-top: $ds-space-0;
}

.preset-cards-container {
    layout: horizontal;
    margin-bottom: $ds-space-2;
    padding: $ds-space-1;
}

.preset-card {
    background: $panel;
    border: round $primary-darken-2;
    padding: $ds-space-2;
    margin-right: $ds-space-1;
    width: $ds-width-fill;
    height: auto;
}

.preset-card:hover {
    background: $panel-lighten-1;
    border: solid $accent;
}

.preset-card.selected {
    background: $ds-focus-bg;
    border: round $ds-focus-accent;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.preset-icon {
    text-align: center;
    margin-bottom: $ds-space-1;
}

.preset-name {
    text-style: bold;
    text-align: center;
    margin-bottom: $ds-space-0;
}

.preset-description {
    color: $text-muted;
    text-align: center;
    margin-bottom: $ds-space-1;
}

.preset-details {
    border-top: dashed $primary-darken-3;
    padding-top: $ds-space-1;
}

.preset-detail {
    color: $text-muted;
    margin-bottom: $ds-space-0;
}

.preset-card.selected .preset-name,
.preset-card.selected .preset-description,
.preset-card.selected .preset-detail {
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Advanced settings */
.advanced-settings-container {
    margin-top: $ds-space-2;
}

.advanced-toggle {
    width: $ds-width-full;
    background: $surface;
    border: round $primary-darken-3;
    color: $text-muted;
    text-align: left;
}

.advanced-toggle:hover {
    background: $panel;
    color: $text;
}

.advanced-settings {
    margin-top: $ds-space-1;
    padding: $ds-space-2;
    background: $surface;
    border: round $primary-darken-3;
}

.advanced-settings.hidden {
    display: none;
}

.advanced-settings Label {
    margin-top: $ds-space-1;
}

.advanced-settings Select,
.advanced-settings Input {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

/* Processing Step */


.progress-text {
    text-align: center;
    text-style: bold;
    margin-bottom: $ds-space-1;
    color: $primary;
}

.current-item {
    text-align: center;
    color: $text-muted;
    margin-bottom: $ds-space-2;
    text-style: italic;
}

.progress-stats {
    layout: horizontal;
    align: center middle;
    padding-top: $ds-space-1;
    border-top: dashed $primary-darken-2;
}

.progress-stats Label {
    width: $ds-width-fill;
    text-align: center;
    color: $text-muted;
}


/* Validation and Errors */

.error-message {
    color: $error;
    background: $error 10%;
    border: round $error;
    padding: $ds-space-1;
    margin: $ds-space-1;
    text-align: center;
}

/* Animations and Transitions */

/* Staggered entrance animations removed - not supported in Textual */

/* Progress bar animation removed - not supported in Textual */


/* Responsive adjustments */

/* Media queries not supported in Textual - using fixed layouts */

/* Chatbook Creation Wizard Specific Styles */

/* Basic Info Step */
BasicInfoStep {
    layout: vertical;
    padding: $ds-space-2;
}

BasicInfoStep .form-group {
    margin-bottom: $ds-space-2;
}

BasicInfoStep .form-label {
    color: $text-muted;
    margin-bottom: $ds-space-0;
}

BasicInfoStep .form-input {
    width: $ds-width-full;
    margin-top: $ds-space-0;
}

BasicInfoStep #chatbook-description {
    height: $ds-size-6;
}

BasicInfoStep .info-box {
    padding: $ds-space-1;
    background: $boost;
    border: round $primary;
    margin-top: $ds-space-2;
}

/* Content Selection Step */
ContentSelectionStep {
    layout: vertical;
    height: $ds-height-full;
}

ContentSelectionStep .selection-header {
    height: $ds-size-3;
    padding: $ds-space-1;
    background: $boost;
    border: round $background-darken-1;
    margin-bottom: $ds-space-1;
}

ContentSelectionStep .content-tree-container {
    height: $ds-height-fill;
}

/* Export Options Step */
ExportOptionsStep {
    layout: vertical;
    padding: $ds-space-2;
}

ExportOptionsStep .option-group {
    margin-bottom: $ds-space-2;
    padding: $ds-space-1;
    background: $boost;
    border: round $background-darken-1;
}

ExportOptionsStep .option-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
}

ExportOptionsStep .radio-option {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-1;
}

ExportOptionsStep .checkbox-option {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-1;
}

/* Preview Confirm Step */
PreviewConfirmStep {
    layout: vertical;
    padding: $ds-space-2;
}

PreviewConfirmStep .preview-header {
    margin-bottom: $ds-space-2;
}

PreviewConfirmStep .chatbook-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
}

PreviewConfirmStep .preview-section {
    margin-bottom: $ds-space-2;
    padding: $ds-space-1;
    background: $boost;
    border: round $background-darken-1;
}

PreviewConfirmStep .section-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
}

PreviewConfirmStep .content-list {
    margin-left: $ds-space-2;
    color: $text-muted;
}

PreviewConfirmStep .file-tree {
    height: $ds-size-12;
    border: round $background-darken-1;
    background: $background;
    padding: $ds-space-1;
    margin: $ds-space-1 $ds-space-0;
}

PreviewConfirmStep .location-section {
    margin-top: $ds-space-2;
    padding: $ds-space-1;
    background: $panel;
    border: round $primary;
}

PreviewConfirmStep .location-path {
    color: $primary;
    margin: $ds-space-1 $ds-space-0;
}

/* Progress Step */
ProgressStep {
    layout: vertical;
    padding: $ds-space-2;
    align: center middle;
}

ProgressStep .progress-container {
    width: $ds-width-full;
    max-width: $ds-size-60;
    padding: $ds-space-2;
    background: $boost;
    border: round $background-darken-1;
}

ProgressStep .progress-title {
    text-align: center;
    text-style: bold;
    margin-bottom: $ds-space-2;
}

ProgressStep #export-progress, ProgressStep #import-progress {
    margin: $ds-space-2 $ds-space-0;
}

ProgressStep .progress-status {
    margin: $ds-space-2 $ds-space-0;
}

/* ADR-161 task 8a: ProgressStep/ImportProgressStep status-item rules were
 * declaration-identical; the shared core (base + completed/active/error)
 * promotes bare into components/_status.tcss. Import's warning-only state
 * stays scoped below (task-19734: an import that skipped everything is not
 * green -- the colour is part of the claim). */

ProgressStep .completion-message {
    text-align: center;
    padding: $ds-space-2;
    margin-top: $ds-space-2;
    background: $success 20%;
    border: round $success;
}

ProgressStep .completion-actions {
    layout: horizontal;
    height: auto;
    align: center middle;
    margin-top: $ds-space-2;
}

ProgressStep .completion-actions Button {
    margin: $ds-space-0 $ds-space-1;
}

ProgressStep .hidden {
    display: none;
}

/* Chatbook Import Wizard Specific Styles */

/* File Selection Step */
FileSelectionStep {
    layout: vertical;
    padding: $ds-space-2;
}

FileSelectionStep .file-selection-container {
    layout: vertical;
    height: $ds-height-full;
    align: center middle;
}

FileSelectionStep .drop-zone {
    width: $ds-percent-80;
    height: $ds-size-20;
    border: dashed $background-darken-2;
    background: $boost;
    align: center middle;
    margin: $ds-space-2 $ds-space-0;
}

FileSelectionStep .drop-zone.hover {
    border: solid $primary;
    background: $primary 10%;
}

FileSelectionStep .drop-zone-content {
    text-align: center;
    padding: $ds-space-2;
}

FileSelectionStep .drop-zone-icon {
    margin-bottom: $ds-space-1;
    color: $text-muted;
}

FileSelectionStep .drop-zone-text {
    color: $text-muted;
    margin-bottom: $ds-space-1;
}

FileSelectionStep .file-path-display {
    width: $ds-percent-80;
    margin: $ds-space-2 $ds-space-0;
    padding: $ds-space-1;
    background: $boost;
    border: round $background-darken-1;
}

FileSelectionStep .path-label {
    color: $text-muted;
    margin-bottom: $ds-space-0;
}

FileSelectionStep .path-value {
    color: $primary;
    margin-top: $ds-space-0;
}

FileSelectionStep .browse-button {
    margin-top: $ds-space-2;
}

/* Preview Validation Step */
PreviewValidationStep {
    layout: vertical;
    padding: $ds-space-2;
}

PreviewValidationStep .preview-header {
    margin-bottom: $ds-space-2;
}

PreviewValidationStep .chatbook-info {
    padding: $ds-space-1 $ds-space-2;
    background: $boost;
    border: round $background-darken-1;
    margin-bottom: $ds-space-2;
}

PreviewValidationStep .info-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
}

PreviewValidationStep .info-row {
    layout: horizontal;
    height: auto;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-1;
}

PreviewValidationStep .info-label {
    width: $ds-size-15;
    color: $text-muted;
}

PreviewValidationStep .info-value {
    width: $ds-width-fill;
}

PreviewValidationStep .content-preview {
    padding: $ds-space-1 $ds-space-2;
    background: $boost;
    border: round $background-darken-1;
    margin-bottom: $ds-space-2;
}

PreviewValidationStep .preview-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
    color: $primary;
}

PreviewValidationStep .content-tree {
    height: $ds-size-15;
    background: $background;
    border: round $background-darken-1;
    padding: $ds-space-1;
}

PreviewValidationStep .validation-results {
    padding: $ds-space-1 $ds-space-2;
    background: $boost;
    border: round $background-darken-1;
}

PreviewValidationStep .validation-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
}

PreviewValidationStep .validation-item {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-1;
}

PreviewValidationStep .validation-success {
    color: $success;
}

PreviewValidationStep .validation-warning {
    color: $warning;
}

PreviewValidationStep .validation-error {
    color: $error;
}

/* Conflict Resolution Step */
ConflictResolutionStep {
    layout: vertical;
    padding: $ds-space-2;
}

ConflictResolutionStep .resolution-header {
    margin-bottom: $ds-space-2;
    padding: $ds-space-1;
    background: $boost;
    border: round $background-darken-1;
}

ConflictResolutionStep .strategy-section {
    margin-bottom: $ds-space-2;
    padding: $ds-space-1 $ds-space-2;
    background: $boost;
    border: round $background-darken-1;
}

ConflictResolutionStep .strategy-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
    color: $primary;
}

ConflictResolutionStep .radio-option {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-1;
}

ConflictResolutionStep .strategy-description {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-3;
    color: $text-muted;
}

ConflictResolutionStep .conflict-preview {
    padding: $ds-space-1 $ds-space-2;
    background: $boost;
    border: round $warning;
}

ConflictResolutionStep .conflict-title {
    text-style: bold;
    color: $warning;
    margin-bottom: $ds-space-1;
}

ConflictResolutionStep .conflict-list {
    margin-left: $ds-space-2;
    color: $text-muted;
}

ConflictResolutionStep .no-conflicts {
    text-align: center;
    padding: $ds-space-3;
    color: $success;
}

/* Import Options Step */
ImportOptionsStep {
    layout: vertical;
    padding: $ds-space-2;
}

ImportOptionsStep .options-section {
    margin-bottom: $ds-space-2;
    padding: $ds-space-1 $ds-space-2;
    background: $boost;
    border: round $background-darken-1;
}

ImportOptionsStep .section-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
    color: $primary;
}

ImportOptionsStep .checkbox-option {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-1;
}

ImportOptionsStep .option-description {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-3;
    color: $text-muted;
}

/* Import Progress Step */
ImportProgressStep {
    layout: vertical;
    padding: $ds-space-2;
    align: center middle;
}

ImportProgressStep .progress-container {
    width: $ds-width-full;
    max-width: $ds-size-60;
    padding: $ds-space-2;
    background: $boost;
    border: round $background-darken-1;
}

ImportProgressStep .progress-title {
    text-align: center;
    text-style: bold;
    margin-bottom: $ds-space-2;
}

ImportProgressStep #import-progress {
    margin: $ds-space-2 $ds-space-0;
}

ImportProgressStep .progress-status {
    margin: $ds-space-2 $ds-space-0;
}

ImportProgressStep .status-item.warning {
    color: $warning;
}

/* The completion banner is coloured by the outcome it reports, so a run that
 * imported nothing cannot be framed in the success palette (task-19734). */
ImportProgressStep .completion-message {
    text-align: center;
    padding: $ds-space-2;
    margin-top: $ds-space-2;
    background: $panel;
    border: round $background-darken-1;
}

ImportProgressStep .completion-message.outcome-imported {
    background: $success 20%;
    border: round $success;
}

ImportProgressStep .completion-message.outcome-partial {
    background: $warning 20%;
    border: round $warning;
}

ImportProgressStep .completion-message.outcome-skipped {
    background: $warning 20%;
    border: round $warning;
}

ImportProgressStep .completion-message.outcome-empty {
    background: $panel;
    border: round $background-darken-1;
}

/* A chatbook that HAD items none of which were attempted is not the same as
 * an empty one, and it is not a success either (task-19734). */
ImportProgressStep .completion-message.outcome-excluded {
    background: $warning 20%;
    border: round $warning;
}

ImportProgressStep .completion-message.outcome-failed {
    background: $error 20%;
    border: round $error;
}

ImportProgressStep .completion-stats {
    margin-top: $ds-space-2;
    padding: $ds-space-1 $ds-space-2;
    background: $boost;
    border: round $background-darken-1;
}

ImportProgressStep .stat-row {
    layout: horizontal;
    height: auto;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

ImportProgressStep .stat-label {
    width: $ds-size-20;
    color: $text-muted;
}

ImportProgressStep .stat-value {
    width: $ds-width-fill;
    text-align: right;
}

/* SmartContentTree Styles (used by wizards) */

SmartContentTree {
    layout: vertical;
    height: $ds-height-full;
}

SmartContentTree .tree-controls {
    height: auto;
    padding: $ds-space-1;
    background: $boost;
    border: round $background-darken-1;
    margin-bottom: $ds-space-1;
}

SmartContentTree .search-row {
    layout: horizontal;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

SmartContentTree .search-input {
    width: $ds-width-fill;
    margin-right: $ds-space-1;
}

SmartContentTree .filter-button {
    min-width: $ds-size-12;
}

SmartContentTree .category-filters {
    layout: horizontal;
    height: auto;
    margin-bottom: $ds-space-1;
}

SmartContentTree .category-checkbox {
    margin-right: $ds-space-2;
}

SmartContentTree .selection-controls {
    layout: horizontal;
    height: auto;
}

SmartContentTree .selection-button {
    margin-right: $ds-space-1;
    min-width: $ds-size-10;
}

SmartContentTree .tree-container {
    height: $ds-height-fill;
    border: round $background-darken-1;
    background: $boost;
    padding: $ds-space-1;
}

SmartContentTree .tree-stats {
    height: $ds-size-2;
    padding: $ds-space-0 $ds-space-1;
    text-align: right;
    color: $text-muted;
}

/* Tree node styling */
SmartContentTree Tree > .tree--cursor {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

SmartContentTree Tree > .selected-node {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* ── First-run setup wizard ─────────────────────────────────────────── */
/* TASK-1495: padding/margins on this section were trimmed from their
 * original values (welcome/provider padding "2 4" -> "1 4"; subtitle
 * margin-bottom 2 -> 1) to reclaim just enough vertical budget for the
 * Provider step's API-key Input to fit on screen at 120x40 alongside its
 * (now-capped, see ".setup-choice-list" below) provider list -- see that
 * rule's own comment for the full row-budget accounting. */
.setup-welcome { padding: $ds-space-1 $ds-size-4; }
.setup-provider { padding: $ds-space-0 $ds-space-2; }
.setup-title { text-style: bold; text-align: center; margin-bottom: $ds-space-1; }
.setup-subtitle { color: $text-muted; margin-bottom: $ds-space-1; }
.setup-provider .setup-title,
.setup-provider .setup-subtitle { margin-bottom: $ds-space-0; }
.setup-step-error {
    color: $error;
    background: $error 15%;
    text-style: bold;
    margin-top: $ds-space-1;
}
/* TASK-21140 (UAT G-3): calm informational lines that previously borrowed
   the error class and rendered reassurance as a failure. */
.setup-step-note { color: $text-muted; margin-top: $ds-space-1; }
.setup-field-label { margin-top: $ds-space-1; }
.setup-probe-status { color: $text-muted; margin-top: $ds-space-1; }
.setup-summary-row { height: $ds-size-1; }
.setup-summary-ok { color: $success; }
.setup-summary-missing { color: $error; }

/* TASK-1495: the step region clips without scrolling; primary inputs/CTAs
 * can render below a hard fold with no scrollbar (Provider's API-key field
 * and "Use this server" button; the Full-track Summary's exit buttons).
 * Root cause -- BaseWizard.py (never modified) styles the shared
 * ".wizard-step" class as "height: 100%" with no overflow, and each step's
 * own content wrapper (a plain Vertical) inherits Textual's Vertical default
 * of "height: 1fr; overflow: hidden hidden", so oversized content is clipped
 * by the INNER wrapper before the outer ".wizard-steps-container"'s own
 * "overflow-y: auto" (see above in this file) ever gets a chance to scroll
 * anything -- that container's child (the active step) always measures
 * exactly 100% of its parent, never "overflowing" it by definition.
 *
 * Both rules below are scoped to ".setup-step"/the setup wizard's own
 * per-step classes (added in FirstRunSetupWizard.py, SetupStep.__init__ and
 * each step's compose()) rather than editing ".wizard-step" or
 * ".wizard-steps-container" directly, so the Chatbook create/import wizards
 * (whose steps carry neither class) are byte-for-byte unaffected.
 */
.setup-step {
    /* Height stays 100% (inherited from ".wizard-step") -- this becomes the
     * actual scroll VIEWPORT for the step's content. */
    overflow-y: auto;
}

.setup-welcome,
.setup-provider,
.setup-model,
.setup-voice,
.setup-rag,
.setup-speech,
.setup-tools,
.setup-notes,
.setup-appearance,
.setup-protect,
.setup-summary {
    /* Size to natural content height instead of Vertical's default 1fr, so
     * content taller than the step's 100%-height viewport actually
     * registers as "overflow" for ".setup-step" above to scroll. */
    height: auto;
}

/* Task 2.7: Voice keeps a stable compact control rhythm while the shared
 * setup-step viewport owns scrolling at narrow and short terminal sizes. */
.setup-voice {
    padding: $ds-space-0 $ds-space-2 $ds-space-1 $ds-space-2;
}

.setup-voice-segmented {
    layout: horizontal;
    height: $ds-size-3;
    min-height: $ds-size-3;
    border: solid $primary;
    overflow: hidden hidden;
}

.setup-voice-segmented SetupRadioButton {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-3;
}

.setup-voice-segmented SetupRadioButton.-on {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.setup-voice-output-row {
    height: $ds-size-5;
}

.setup-voice-output-row > Vertical {
    width: $ds-width-fill;
    height: $ds-size-5;
}

#setup-voice-sample-count {
    height: $ds-size-1;
    text-align: right;
    color: $text-muted;
}

#setup-voice-test {
    margin-top: $ds-space-1;
}

#setup-voice-status {
    height: auto;
    min-height: $ds-size-1;
    margin-top: $ds-space-1;
}

/* Design intent #2/#3: keep choice lists independently scrollable at 5–7 rows
 * so catalogs cannot displace the key field or footer. The containing step
 * remains the narrow-screen viewport; progress/navigation stay fixed. */
.setup-choice-list {
    min-height: $ds-size-5;
    max-height: $ds-size-7;
    border: solid $primary;
}

.setup-choice-list:focus {
    border: solid $ds-focus-accent;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}

/* TASK-1495 AC #3: the Summary's exit actions are docked to the step
 * viewport's bottom edge (the row is a direct child of the .setup-step
 * scroll container -- see SummaryStep.compose). Docked widgets reserve
 * their own space and never scroll with content, so "Start chatting" /
 * "Done" stay visible however tall the read-back matrix grows. */
.setup-summary-actions {
    dock: bottom;
    height: auto;
    padding: $ds-space-0 $ds-size-4 $ds-space-1 $ds-size-4;
}
/* task-32140 review: five buttons no longer fit one non-wrapping row at
 * 80x24 or 120x40 (Horizontal never wraps) -- two docked rows instead. */
.setup-summary-actions-row {
    height: auto;
    margin-bottom: $ds-space-1;
}
.setup-summary-actions Button {
    margin-right: $ds-space-2;
}

/* TASK-1497: second structural cue for the selected radio row (the first is
 * the ●/○ glyph swap in SetupRadioButton) — bold survives monochrome. */
.setup-choice-list SetupRadioButton.-on {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    border-left: thick $ds-focus-accent;
    text-style: bold underline;
}

/* TASK-1501: aligned tool rows. Switch is 3 rows tall (bordered); without an
 * explicit row height the unstyled Horizontals let successive switches'
 * borders collide into the next row's label. */
.setup-tool-row {
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}
.setup-tool-row Switch {
    margin-right: $ds-space-2;
}
.setup-tool-text {
    width: $ds-width-fill;
    height: auto;
}
.setup-tool-name {
    text-style: bold;
}
.setup-tool-desc {
    color: $text-muted;
}

/* TASK-1500/1507: tertiary controls (Show all themes…, Skip — explore on my
 * own) — link-like: quiet until focused/hovered, clearly subordinate to the
 * primary choices they sit under. */
.setup-tertiary-button {
    background: transparent;
    border: none;
    color: $text-muted;
    text-style: underline;
    height: $ds-size-1;
    min-width: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
    margin-top: $ds-space-1;
}
.setup-tertiary-button:hover {
    color: $text;
    background: transparent;
}
.setup-tertiary-button:focus {
    color: $text;
    text-style: bold underline;
}

/* TASK-1498: section headers inside the provider list, and the pinned
 * found-a-server banner above it. */
.setup-choice-header {
    color: $text-muted;
    text-style: bold;
    padding: $ds-space-0 $ds-space-1;
}
.setup-detected-banner {
    margin-bottom: $ds-space-1;
}

#setup-provider-connection {
    height: auto;
    min-height: $ds-size-7;
}

#setup-provider-endpoint {
    width: $ds-width-full;
    min-height: $ds-size-3;
}

.setup-endpoint-value {
    height: auto;
    min-height: $ds-size-1;
    text-wrap: wrap;
    color: $text-muted;
}

.setup-provider-connection-actions {
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin-top: $ds-space-1;
}

.setup-provider-connection-actions Button {
    min-width: $ds-size-12;
    margin-right: $ds-space-1;
}

#setup-provider-auth-toggle {
    height: auto;
    min-height: $ds-size-3;
    margin-top: $ds-space-1;
}

#setup-provider-api-key {
    width: $ds-width-full;
    min-height: $ds-size-3;
}

.setup-detection-results {
    height: auto;
    min-height: $ds-size-3;
    max-height: $ds-size-8;
    border: solid $primary;
    margin-top: $ds-space-1;
}

.setup-detection-results:focus {
    border: solid $ds-focus-accent;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}

/* TASK-1498: the wizard's own show/hide toggles (discovery banner + button,
 * Keep/Replace/Clear row) — the repo's ".hidden" convention is styled only
 * for specific widgets elsewhere, so scope a real display:none here. */
.setup-provider .hidden {
    display: none;
}

/* TASK-1505: persistent key-hints line docked under the wizard. */
.setup-key-hints {
    dock: bottom;
    height: $ds-size-1;
    color: $text-muted;
    text-align: center;
    background: $panel;
}

/* TASK-21148 (UAT F-2/F-3): the tracker stacks each title UNDER its number
   box, so the row needs box(3) + title(1) = 4 content rows and items size
   themselves. The old fixed 4/3 caps clipped the stacked titles. */
FirstRunSetupWizard SetupWizardContainer .wizard-progress {
    height: auto;
    max-height: $ds-size-5;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
}

.setup-progress-item {
    height: auto;
    min-width: $ds-size-0;
    margin: $ds-space-0;
}

.setup-progress-item.-active .step-number {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    border: solid $ds-focus-accent;
}

.setup-progress-item.-active .step-title {
    color: $ds-focus-fg;
    text-style: bold underline;
}

.setup-progress-item.-complete .step-number {
    background: $ds-surface-raised;
    color: $ds-text-primary;
    border: solid $success;
}

.setup-progress-item.-complete .step-title {
    color: $ds-text-primary;
    text-style: bold;
}

/* TASK-21143 (UAT N-7): visited step whose probe failed — amber "!", never
   the ✓ users read as "this part is OK". */
.setup-progress-item.-attention .step-number {
    background: $ds-surface-raised;
    color: $warning;
    border: solid $warning;
    text-style: bold;
}
.setup-progress-item.-attention .step-title {
    color: $warning;
    text-style: bold;
}

.setup-progress-item.-upcoming .step-number {
    background: $panel;
    color: $text-muted;
    border: solid $primary;
}

.setup-progress-item.-upcoming .step-title {
    color: $text-muted;
}

/* TASK-1506: key input and its Test button share one row. */
.setup-key-row {
    height: $ds-size-3;
}
.setup-key-row Input {
    width: $ds-width-fill;
}
.setup-key-row Button {
    margin-left: $ds-space-1;
    min-width: $ds-size-8;
}

/* TASK-1505: with the key-hints line docked at the screen's bottom, the
 * wizard container must yield that row — height:100% (the shared framework
 * default) would push the navigation bar's last row off screen. Scoped to
 * the setup wizard's own screen. */
FirstRunSetupWizard SetupWizardContainer {
    height: $ds-height-fill;
}

FirstRunSetupWizard SetupWizardContainer .wizard-title {
    height: $ds-size-3;
    padding: $ds-space-0 $ds-space-2;
    margin: $ds-space-0;
}

FirstRunSetupWizard SetupWizardContainer .wizard-steps-container {
    height: $ds-height-fill;
    padding: $ds-space-0;
    margin: $ds-space-0;
}

FirstRunSetupWizard SetupWizardContainer .wizard-navigation {
    height: $ds-size-4;
    min-height: $ds-size-4;
    padding: $ds-space-0 $ds-space-2;
    margin: $ds-space-0;
}

FirstRunSetupWizard .setup-key-hints {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

/* WizardProgress active-step states (TASK-16811): moved here from the
   widget's DEFAULT_CSS so the real $ds-focus-* tokens apply (the local
   fallbacks that used to sit beside them shadowed the bundle's values). */
WizardProgress .step-number.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    border: round $ds-focus-accent;
    text-style: bold underline;
}

WizardProgress .step-title.active {
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* TASK-21148 (UAT Z-2): sub-minimum terminal nudge in the wizard chrome. */
.setup-size-hint {
    dock: bottom;
    height: $ds-size-1;
    color: $warning;
    text-align: center;
}
/* Explicit: the docked row must fully vanish when hidden — module concat
   order must not decide whether .hidden wins. */
.setup-size-hint.hidden { display: none; }

/* TASK-21148 (UAT F-2/F-3): tracker titles under the number boxes; boxes
   sized for two-digit steps. */
.setup-progress-item .step-indicator-stack {
    layout: vertical;
    align: center top;
    width: auto;
    height: auto;
}
.setup-progress-item .step-number {
    width: auto;
    min-width: $ds-size-4;
    margin-right: $ds-space-0;
}
.setup-progress-item .step-title {
    margin-right: $ds-space-0;
    text-align: center;
}


/* TASK-21148 (UAT P-1/Z-3): collapsible sections inside steps spent ~3
   blank rows before their first field. */
.setup-step Collapsible > Contents { padding: $ds-space-0 $ds-space-1; }
.setup-step Collapsible > Contents .setup-field-label { margin-top: $ds-space-0; }
.setup-step Collapsible > Contents .setup-probe-status { margin-top: $ds-space-0; }

/* ===== MODULE: features/_chatbooks.tcss ===== */
/* _chatbooks.tcss */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */

/* Styles for the Chatbooks window */

/* Main window */
ChatbooksWindow {
    background: $background;
}

/* Main horizontal layout */
#main-layout {
    layout: horizontal;
    height: $ds-height-full;
}

/* Left sidebar */
#chatbooks-sidebar {
    width: $ds-size-30;
    background: $panel;
    border-right: solid $background-darken-1;
    padding: $ds-space-1;
    layout: vertical;
}

.sidebar-title {
    text-style: bold;
    color: $primary;
    margin-bottom: $ds-space-1;
    text-align: center;
}

#chatbooks-list {
    height: $ds-height-fill;
    background: $boost;
    border: round $background-darken-1;
}

#chatbooks-list ListItem {
    padding: $ds-space-0 $ds-space-1;
    height: $ds-size-3;
}

#chatbooks-list ListItem:hover {
    background: $surface-lighten-1;
    color: $text;
}

#chatbooks-list ListItem.-highlight {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

/* Right content area */
#content-area {
    width: $ds-width-fill;
    layout: vertical;
    padding: $ds-space-1;
}

/* Header section */
#chatbooks-header {
    background: $boost;
    border: round $background-darken-1;
    padding: $ds-space-2;
    margin-bottom: $ds-space-1;
}

.header-title {
    text-style: bold;
    text-align: center;
    color: $primary;
    margin-bottom: $ds-space-1;
}

.header-subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: $ds-space-2;
}

#action-buttons {
    layout: horizontal;
    align: center middle;
    height: $ds-size-3;
}

#action-buttons Button {
    margin: $ds-space-0 $ds-space-1;
    min-width: $ds-size-20;
}

/* Dynamic content area */
#dynamic-content {
    height: $ds-height-fill;
    background: $boost;
    border: round $background-darken-1;
    padding: $ds-space-2;
    overflow-y: auto;
}

/* Welcome text */
.welcome-text {
    color: $text;
    padding: $ds-space-2;
}

/* Status text */
.status-text {
    color: $text-muted;
    text-align: center;
    padding: $ds-space-2;
}

/* Info text */
.info-text {
    color: $text-muted;
    text-align: center;
    padding: $ds-space-2;
}

/* Chatbook details */
.chatbook-details {
    layout: vertical;
    padding: $ds-space-1;
}

.chatbook-title {
    text-style: bold;
    color: $primary;
    margin-bottom: $ds-space-1;
}

.chatbook-desc {
    color: $text;
    margin-bottom: $ds-space-1;
}

.chatbook-size {
    color: $text-muted;
    margin-bottom: $ds-space-1;
}

.chatbook-date {
    color: $text-muted;
    margin-bottom: $ds-space-2;
}

/* Management buttons */
.management-buttons {
    layout: horizontal;
    height: $ds-size-3;
    margin-top: $ds-space-2;
}

.management-buttons Button {
    margin-right: $ds-space-1;
    min-width: $ds-size-12;
}

/* Error button variant */
Button.error {
    background: $error;
    color: $text;
}

Button.error:hover {
    background: $error-darken-1;
}

/* Template management styles */
.templates-list {
    layout: vertical;
    height: auto;
    max-height: $ds-size-20;
    overflow-y: auto;
    margin: $ds-space-1 $ds-space-0 $ds-space-2 $ds-space-0;
    background: $panel;
    border: round $background-darken-1;
    padding: $ds-space-1;
}

.template-item {
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
    background: $boost;
    border: round $background-darken-1;
}

.template-item:hover {
    background: $primary 10%;
    border: round $primary;
}

.template-name {
    text-style: bold;
    color: $primary;
    margin-bottom: $ds-space-0;
}

.template-description {
    color: $text-muted;
    text-style: italic;
}

/* ===== MODULE: features/_scheduling.tcss ===== */

/* UAT display blocker (finding 2): both detail panes are a plain
 * `Vertical` (`overflow: hidden hidden` by default) taller than their
 * own box at every measured width -- History and the lifecycle action
 * row were clipped with no scrollbar, no wheel handling, no PageDown.
 * `overflow-y: auto` alone is not enough: `#scheduling-task-detail-
 * groups` is itself a plain `Vertical` (`height: 1fr` by default), which
 * clips ITS OWN children a second time before `TaskDetail` ever gets a
 * chance to scroll them -- `height: auto` lets it size to its real
 * content instead. `DefinitionDetail` nests one level shallower (no
 * separate groups wrapper -- its DetailGroups are direct children of
 * `#scheduling-automation-detail-body`), so that container gets the
 * same treatment. */
TaskDetail, DefinitionDetail {
    overflow-y: auto;
}

/* Compact mode: the filter's margin row goes to the table (80x24 has
 * exactly one spare row; without this the queue shows only the filter). */
#scheduling-workbench.compact #scheduling-queue-filter {
    margin: $ds-space-0;
}

/* The four chips collapse into the cycling control rather than the whole
 * row disappearing (ruling 6) -- one row either way, and a mouse user
 * keeps a filter affordance at the floor. The row's own bottom margin
 * goes to the table for the same reason the filter's does. */
#scheduling-workbench.compact #scheduling-queue-chips {
    margin: $ds-space-0;
}

#scheduling-workbench.compact #scheduling-queue-chips .scheduling-queue-chip {
    display: none;
}

#scheduling-workbench.compact #scheduling-chip-cycle {
    display: block;
}

/* With both side panes hidden the rail is the only thing on screen, so it
 * takes the whole width -- it used to keep the 24-column width the
 * three-pane compact split gives it, wrapping the queue into a gutter
 * while 54 columns sat empty -- and drops its own frame: the workbench's
 * border is already the visible edge, and 4 rows of pane chrome is a
 * sixth of an 80x24 terminal. */
#scheduling-workbench.compact #scheduling-list-pane {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    border: none;
    padding: $ds-space-0 $ds-space-1;
}

/* task-31823: shared by BOTH panes' secondary-actions buttons (reminder
 * + definition) -- a plain class on each Button, never an
 * ancestor-scoped bare-type rule. */
.detail-secondary-action-button {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

/* Both live instances of the pane: the docked one and, at narrow widths,
 * the fresh instance `WorkbenchHostScreen` hosts (redesign PR-4, task 6).
 * Listed by id rather than re-keyed to `TaskDetail .follow-why`, which
 * would be an ancestor-scoped bare-type rule (PR-3's fastpath ratchet). */
#scheduling-task-detail .follow-why,
#scheduling-task-detail-overlay .follow-why {
    color: $text-muted;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
}

#scheduling-automation-detail-lifecycle .detail-lifecycle-button {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

/* Same pair as the reminder pane's rule above: docked + pushed instance. */
#scheduling-queue-definition-detail .follow-why,
#scheduling-definition-detail-overlay .follow-why {
    color: $text-muted;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
}

#scheduling-task-status-badge.waiting {
    background: $primary;
}

#scheduling-task-status-badge.running,
#scheduling-task-status-badge.completed,
#scheduling-task-status-badge.found-results {
    background: $success;
}

#scheduling-task-status-badge.paused,
#scheduling-task-status-badge.needs-attention,
#scheduling-task-status-badge.missed {
    background: $warning;
    color: $text;
}

#scheduling-task-status-badge.blocked,
#scheduling-task-status-badge.conflict {
    background: $error;
}

#scheduling-task-status-badge.disabled,
#scheduling-task-status-badge.archived {
    background: $surface-darken-1;
    color: $text-muted;
}

#scheduling-conflict-card.conflict {
    border: solid $error;
    padding: $ds-space-1;
    color: $error;
    background: $error 10%;
}

/* Narrow-window degradation: panes are hidden by the workbench's resize
 * handler (with a notice) instead of being silently clipped. */
.pane-hidden {
    display: none;
}

/* Compact mode (see SchedulesWorkbench.on_resize): the screen header
 * already names the pane, so the in-pane TITLE yields its row -- but the
 * header's buttons do not. redesign PR-4, task 6 (ruling 6: "the rail
 * degrades readably at 80"): `Create ▾`, `Mark all read` and `Results`
 * are the only routes to those operations that need no selected row, and
 * what made the row unaffordable at the floor was the 3-row bordered
 * Button box, not the buttons. They flatten to one row instead
 * (height:1/border:none -- the same idiom the chip row and the Runs-on
 * mini-bar already use), and the header goes from 3 rows to 1. */
#scheduling-workbench.compact #scheduling-list-title {
    display: none;
}

#scheduling-workbench.compact #scheduling-new-task,
#scheduling-workbench.compact #scheduling-mark-all-read,
#scheduling-workbench.compact #scheduling-results-badge {
    height: $ds-size-1;
    border: none;
    background: $surface-darken-1;
}

/* schedules-redesign PR-1, Task 1 (fix round 1): DetailValueRow /
 * DetailGroup (`Widgets/detail_value_row.py`) live here per the task-1
 * brief's file list rather than as BUNDLED_CSS on the widget classes --
 * this module is concatenated into the boot-loaded app bundle in the same
 * parse pass as core/_variables.tcss, so $ds-* tokens resolve directly,
 * with no local alias workaround. Selectors are plain type/class
 * (not scheduling-prefixed): the widgets are reusable beyond Scheduling,
 * and this is just where the first consumer's CSS happens to ship;
 * graduate to a shared features file if/when a non-scheduling consumer
 * appears. */
DetailValueRow {
    height: auto;
    min-height: $ds-size-0;
}

DetailValueRow .detail-value-row-line {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

DetailValueRow .detail-value-row-label {
    color: $ds-text-muted;
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

DetailValueRow .detail-value-row-value {
    color: $ds-text-primary;
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    text-align: right;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

DetailValueRow .detail-value-row-affordance {
    color: $ds-text-disabled-readable;
    width: $ds-size-2;
    min-width: $ds-size-2;
    height: $ds-size-1;
    text-align: right;
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
}

/* schedules-redesign PR-3, Task 1: the affordance's live state. `:focus-
 * within` covers both a row focused via spec §12's Up/Down traversal AND
 * (once `begin_edit` mounts an editor into the row) the editor itself
 * holding focus -- `has_focus_within` counts a widget's own focus as
 * "within itself" too, so one selector covers both. `:hover` mirrors it
 * for mouse users. Un-dimming to the same colour as the value tells a user
 * "Enter/click acts on this row" without a new token. */
DetailValueRow:focus-within .detail-value-row-affordance,
DetailValueRow:hover .detail-value-row-affordance {
    color: $ds-text-primary;
}

DetailValueRow .detail-value-row-error {
    color: $ds-status-error-readable;
    width: $ds-width-fill;
    height: $ds-size-1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* schedules-redesign PR-3, Task 5: the Runs-on row's proactively-shown
 * Cancel[/Retry] buttons -- a plain sibling `Horizontal` of the "Runs on"
 * `DetailValueRow` inside its own `DetailGroup` (NOT nested inside the
 * row itself: `begin_edit` would hide the row's own value `Static`,
 * which the existing transfer-badge rendering pins verbatim -- see
 * `task_detail.TaskDetail._configure_runs_on_row`'s docstring). Same
 * compact single-row Button idiom `#scheduling-queue-chips .scheduling-
 * queue-chip` already uses elsewhere in this file, so the row costs one
 * line rather than a full 3-row Button box. Bare class selector (not
 * scoped under `DetailValueRow`) since this widget lives outside it. */
.detail-value-row-owner-actions {
    /* `auto`, not a fixed `1` (final review M5): both buttons are
     * `.display`-toggled and hidden in the overwhelmingly common
     * no-transfer-in-flight case, but a fixed height still reserved a
     * blank line inside the Details group of every reminder and every
     * definition. `auto` measures 0 when both are hidden, 1 when either
     * shows. */
    height: auto;
    align: right middle;
}

.detail-value-row-owner-actions .detail-owner-action-button {
    height: $ds-size-1;
    min-width: $ds-size-8;
    border: none;
    margin: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
}

/* 31712 AC#4: Textual's own `Collapsible`/`Contents` body chrome --
 * `Collapsible`'s widget-tier `padding-bottom: 1`, the app-wide
 * `Collapsible { margin-bottom: 1 }` / `Collapsible { border: tall
 * $surface }` / `Collapsible > Contents { padding: 1 }` rules
 * (`tldw_cli_modular.tcss`, "Collapsible styling enhancements") -- costs 5
 * blank rows per EXPANDED group before a single row of real content is
 * drawn (measured: a 4-row Frequency group rendered at height 13, only 4
 * of those rows readable). The stray `border: tall` is the sneaky one:
 * this rule already set `border-top` only, but CSS `border-top` never
 * clears the other 3 edges, so the app-wide rule's bottom/left/right
 * `tall` border kept bleeding through underneath a rule that reads as a
 * full override -- an explicit `border: none;` before `border-top:` is
 * what actually clears it. Same idiom `LibraryIngestCanvas Collapsible`/
 * `Collapsible Contents` already uses for the same complaint (task-2043)
 * -- scoped to `DetailGroup` only, not the app-wide type, so every other
 * Collapsible in the app keeps its own spacing/border. */
DetailGroup {
    background: $ds-surface-panel;
    border: none;
    border-top: hkey $ds-grid-line;
    padding-bottom: $ds-space-0;
    margin-bottom: $ds-space-0;
}

DetailGroup Contents {
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-3;
}

/* redesign PR-4, Task 1: `WorkbenchHostScreen` (the narrow-layout/overlay
 * push pattern, spec §11) hands the factory-built widget this class so it
 * fills the space between the screen's `Header`/`Footer` regardless of
 * whether the hosted widget sizes itself (`ConflictsTab` already does,
 * via its own `BUNDLED_CSS` -- this covers the panes that don't, e.g.
 * `TaskDetail`/`DefinitionDetail`, once later tasks push those). Bare
 * class selector, carried only by whatever `WorkbenchHostScreen.compose`
 * tags with it -- not ancestor-scoped, so it never counts against the
 * bare-type fastpath ratchet (PR-3's `test_ancestor_scoped_bare_type_
 * rule_count_is_a_ratchet`). */
.workbench-host-body {
    height: $ds-height-fill;
}

/* ===== MODULE: features/_code_repo.tcss ===== */
/* ========================================
 * Code Repository Copy/Paste Feature Styles
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


/* Repository browser container - now embedded in tab */
.repo-window-container {
    width: $ds-width-full;
    height: $ds-height-full;
    background: $surface;
    padding: $ds-space-0;
}

/* ========================================
 * Header Section
 * ======================================== */

.repo-header {
    dock: top;
    height: $ds-size-7;
    background: $boost;
    padding: $ds-space-1;
    border-bottom: solid $primary;
}

.repo-header-content {
    layout: grid;
    grid-size: 4 2;
    grid-columns: 3fr 1fr 1fr 1fr;
    grid-rows: 3 2;
    grid-gutter: 1 1;
    width: $ds-width-full;
}

.repo-url-input {
    width: $ds-width-full;
}

#repo-url-input {
    width: $ds-width-full;
}

#load-repo-btn {
    min-width: $ds-size-10;
}

#token-config-btn {
    min-width: $ds-size-8;
}

#token-config-btn.token-configured {
    background: $success 20%;
    border: solid $success;
}

#branch-selector {
    min-width: $ds-size-15;
}

#repo-settings-btn {
    width: $ds-size-3;
    min-width: $ds-size-3;
}

/* Selection summary */
.selection-summary {
    column-span: 4;
    layout: grid;
    grid-size: 3 1;
    grid-columns: 1fr 1fr 1fr;
    align: left middle;
    width: $ds-width-full;
}

.summary-stat {
    text-align: left;
    color: $text-muted;
}

/* ========================================
 * Filter Bar
 * ======================================== */

.filter-bar {
    dock: top;
    height: $ds-size-3;
    background: $panel;
    layout: grid;
    grid-size: 6 1;
    grid-columns: 2fr 1fr 3 3 3 1fr;
    grid-gutter: 0 1;
    padding: $ds-space-0 $ds-space-1;
    border-bottom: solid $primary-darken-1;
}

#file-search {
    width: $ds-width-full;
}

#file-type-filter {
    width: $ds-width-full;
}

.filter-quick-btn {
    width: $ds-size-3;
    height: $ds-size-3;
    min-width: $ds-size-3;
    padding: $ds-space-0;
    background: $surface;
    border: solid $primary-darken-2;
}

.filter-quick-btn:hover {
    background: $primary 30%;
    border: solid $primary;
}

/* ========================================
 * Main Content Area
 * ======================================== */

.main-content {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 2fr 3fr;
    height: $ds-height-fill;
    background: $background;
}

/* Tree container */
.tree-container {
    border-right: solid $primary;
    overflow: hidden;
    padding: $ds-space-1;
    background: $surface;
}

#repo-tree {
    height: $ds-height-full;
    width: $ds-width-full;
    border: none;
}

/* Preview container - now split into two sections */
.preview-panel {
    padding: $ds-space-1;
    overflow: hidden;
    background: $surface;
    layout: vertical;
    height: $ds-height-full;
}

/* Aggregated text container (top half) */
.aggregated-text-container {
    height: $ds-percent-50;
    margin-bottom: $ds-space-1;
    layout: vertical;
}

/* File preview container (bottom half) */
.file-preview-container {
    height: $ds-percent-50;
    layout: vertical;
}

.preview-header {
    height: $ds-size-3;
    border-bottom: dashed $primary-darken-2;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    align: left middle;
}

#preview-title {
    text-style: bold;
    color: $primary;
}

#compilation-title {
    text-style: bold;
    color: $primary;
}

.preview-content {
    height: $ds-height-fill;
    border: round $primary-darken-2;
    padding: $ds-space-1;
    background: $surface-darken-1;
    overflow-y: auto;
}

#file-preview {
    width: $ds-width-full;
    height: $ds-height-full;
    background: $surface-darken-1;
    padding: $ds-space-1;
}

#aggregated-text {
    width: $ds-width-full;
    height: $ds-height-full;
    background: $surface-darken-1;
    padding: $ds-space-1;
}

/* ========================================
 * Tree View Styles
 * ======================================== */

TreeView {
    height: $ds-height-full;
    width: $ds-width-full;
    overflow-y: auto;
    overflow-x: hidden;
    border: solid $primary-darken-2;
    padding: $ds-space-1;
    background: $surface;
}

.tree-container {
    width: $ds-width-full;
    height: auto;
}

.tree-loading {
    width: $ds-width-full;
    text-align: center;
    padding: $ds-space-2;
    color: $text-muted;
}

.tree-empty {
    width: $ds-width-full;
    text-align: center;
    padding: $ds-size-4;
    color: $text-muted;
}

/* Tree node styles */
TreeNode {
    height: $ds-size-3;
    width: $ds-width-full;
}

.tree-node-row {
    layout: grid;
    grid-size: 4 1;
    grid-columns: auto 3 3 1fr;
    height: $ds-size-3;
    align: left middle;
    width: $ds-width-full;
}

.tree-node-row:hover {
    background: $panel-lighten-1;
}

.tree-node-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.tree-indent {
    width: auto;
    content-align: left middle;
}

.tree-expand-btn {
    width: $ds-size-3;
    height: $ds-size-3;
    min-width: $ds-size-3;
    background: transparent;
    border: none;
    padding: $ds-space-0;
}

.tree-expand-btn:hover {
    background: $surface-lighten-1;
    color: $text;
}

.tree-expand-spacer {
    width: $ds-size-3;
    height: $ds-size-3;
}

.tree-checkbox {
    width: $ds-size-3;
    height: $ds-size-3;
}

.tree-content {
    padding-left: $ds-space-1;
    width: $ds-width-full;
    content-align: left middle;
}

/* ========================================
 * Action Bar
 * ======================================== */

.action-bar {
    dock: bottom;
    height: $ds-size-3;
    background: $panel;
    layout: grid;
    grid-size: 6 1;
    grid-columns: 1fr auto auto auto auto 1fr;
    grid-gutter: 0 1;
    align: center middle;
    padding: $ds-space-0 $ds-space-2;
    border-top: solid $primary;
}

.action-bar Button {
    min-width: $ds-size-15;
}

#reset-btn {
    min-width: $ds-size-10;
}

#generate-compilation-btn {
    min-width: $ds-size-20;
}

/* ========================================
 * Loading Overlay
 * ======================================== */

.loading-overlay {
    dock: top;
    width: $ds-width-full;
    height: $ds-height-full;
    background: $background 90%;
    align: center middle;
    layer: above;
}

.loading-overlay.hidden {
    display: none;
}

.loading-overlay LoadingIndicator {
    margin-bottom: $ds-space-2;
}

.loading-label {
    text-align: center;
    margin-top: $ds-space-2;
    text-style: bold;
    color: $text;
}

/* ========================================
 * Error Messages
 * ======================================== */

.error-message {
    color: $error;
    text-align: center;
    padding: $ds-space-2;
    text-style: bold;
}

/* ========================================
 * Responsive Adjustments
 * ======================================== */

/* Note: Textual doesn't support @media queries
   These styles would need to be applied dynamically
   based on terminal size detection in Python code */


/* ========================================
 * Syntax Highlighting Support
 * ======================================== */

#file-preview {
    /* monospace font style */
}

/* ===== MODULE: features/_coding.tcss ===== */
/* ========================================
 * FEATURES: Coding Window
 * ======================================== 
 * Styles for the coding tab and its components
 * Includes sidebar navigation and content areas
 * ======================================== */

/* Main container */
CodingWindow {
    layout: horizontal;
    height: 100%;
    width: 100%;
}

/* Navigation pane (left sidebar) */
.coding-nav-pane {
    dock: left;
    width: 25%;
    min-width: 20;
    max-width: 40;
    background: $boost;
    padding: 1 2;
    border-right: thick $background-darken-1;
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
}

.coding-nav-pane.collapsed {
    width: 0 !important;
    min-width: 0 !important;
    border-right: none !important;
    padding: 0 !important;
    overflow: hidden !important;
    display: none;
}

/* Navigation buttons */
.coding-nav-button {
    width: 100%;
    height: 3;
    margin: 1 0;
    padding: 0 2;
    text-align: left;
    background: $surface;
}

.coding-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}

/* Content pane */
.coding-content-pane {
    height: 100%;
    width: 100%;
    padding: 2;
    background: $background;
}

/* Sidebar toggle button */
#coding-sidebar-toggle-button {
    dock: left;
    width: 3;
    height: 3;
    margin: 0 1 0 0;
    padding: 0;
    text-align: center;
    background: $surface;
}

#coding-sidebar-toggle-button.collapsed {
    dock: left;
    margin-left: 0;
}

/* View areas */
.coding-view-area {
    height: 100%;
    width: 100%;
    padding: 1;
}

/* Pane titles */
.coding-view-area .pane-title {
    text-style: bold underline;
    margin-bottom: 1;
    width: 100%;
    text-align: center;
}

/* Code repository specific */
#coding-view-repo-copy-paste Vertical {
    height: auto;
    align: center middle;
    padding: 2;
}

#coding-view-repo-copy-paste Label {
    margin-bottom: 2;
    text-align: center;
}

#open-repo-selector {
    width: auto;
    min-width: 30;
    height: 3;
    margin-top: 2;
}

/* ===== MODULE: features/_tab_dropdown.tcss ===== */
/* ========================================
 * FEATURES: Tab Dropdown Navigation
 * ======================================== 
 * Dropdown-based tab navigation system
 * Replaces horizontal tab bar with compact dropdown
 * ======================================== */

/* Container for the dropdown - positioned at top of window */
#tab-dropdown-container {
    dock: top;
    width: 100%;      /* Full width of window */
    height: 3;        /* Match the original tab bar height */
    padding: 0 1;
    background: $panel;
    border-bottom: solid $border;
    margin: 0;
    align: center middle;  /* Center the dropdown in the container */
}

/* The Select widget itself */
#tab-dropdown-select {
    width: 30;        /* Fixed width for the dropdown selector */
    height: 100%;
    background: $panel;
    color: $text;
    border: solid $border;
    border-bottom: solid $border;
    padding: 0 1;
    margin: 0;        /* No margin needed - centering handled by container */
}

/* Select widget hover state */
#tab-dropdown-select:hover {
    background: $panel-lighten-1;
    color: $text;
}

/* Select widget focus state */
#tab-dropdown-select:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

/* Dropdown overlay container */
#tab-dropdown-select SelectOverlay {
    background: $background;
    border: solid $border;
    max-height: 20;      /* Limit dropdown height to prevent full-screen coverage */
    margin-top: 0;       /* No gap - directly below the select */
    width: auto;         /* Auto width to fit content */
    min-width: 30;       /* Match the select widget width */
    /* layer: above; */  /* Ensure dropdown appears above other content if supported */
}

/* Individual options in the dropdown */
#tab-dropdown-select SelectOverlay Option {
    padding: 0 2;
    background: $panel;
    color: $text-muted;
    min-height: 3;       /* Comfortable click target */
}

/* Option hover state */
#tab-dropdown-select SelectOverlay Option:hover {
    background: $surface-lighten-1;
    color: $text;
}

/* Currently selected option (when dropdown is open) */
#tab-dropdown-select SelectOverlay Option.-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Disabled state (if needed in future) */
#tab-dropdown-select:disabled {
    opacity: 0.6;
    background: $panel-darken-1;
    color: $text-muted;  /* Using existing variable instead of $text-disabled */
}

/* Loading state (if needed for async operations) */
#tab-dropdown-select.-loading {
    color: $text-muted;
}

/* Textual CSS doesn't support transition animations */

/* Ensure dropdown doesn't interfere with main content */
#content {
    margin-top: 0;   /* No top margin needed - content flows after dropdown */
}

/* ===== MODULE: features/_watchlists.tcss ===== */

/* Empty state actions */
#wc-empty-actions {
    height: auto;
    margin: $ds-space-1 $ds-space-0;
}

.watchlists-read-mode #content-body-scroll {
    height: $ds-height-fill;
    min-height: $ds-size-1;
    overflow-y: auto;
}

/* Keep the action strip one row. Ordinary article verbs fit at the compact
 * width once Button's generic 16-cell floor is removed; change-only verbs
 * use native focus-driven horizontal scrolling. A painted scrollbar would
 * consume this single row, so the scroll owner keeps no scrollbar chrome.
 */
#content-actions {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-size-horizontal: 0;
}

#content-actions Button {
    width: auto;
    min-width: $ds-size-0;
}

#content-position {
    width: $ds-width-fill;
}

.watchlists-tab-strip .watchlists-tab.is-active {
    border: none;
    text-style: bold underline;
}

.watchlists-tab-strip .watchlists-tab.is-active:focus,
.watchlists-tab-strip .watchlists-tab.is-active:hover:focus {
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: bold underline;
    outline: none;
    border: none;
}

/* Left-rail tree selection highlight (task-876).
 *
 * `WatchlistTree` rendered every node as a `compact=True` Button and never
 * read `tree_scope`, so nothing in the rail showed which node the centre
 * was scoped to -- the scope-named summary in the centre header was the
 * only feedback at all. This does not have the LabModeStrip/tab-strip
 * border-clipping defect -- `compact=True` already forces `border: none
 * !important` (Textual's own Button CSS), so the bundle's global
 * `.is-active { border: round $ds-action-focus; }` never gets a chance to
 * clip anything here. What it DOES need, same as every other `.is-active`
 * consumer in this file, is a legible look: the bare global rule only adds
 * `text-style: bold`, which is too subtle against three different node
 * classes sitting one row apart with no other affordance.
 *
 * Scoped with the `.watchlist-tree` ancestor class (matching the
 * `.watchlists-tab-strip .watchlists-tab.is-active` idiom just above)
 * purely for extra specificity headroom, not because it is required here.
 */
.watchlist-tree .watchlist-tree-root.is-active,
.watchlist-tree .watchlist-tree-watchlist.is-active,
.watchlist-tree .watchlist-tree-source.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}

/* Focus must not impersonate the active node (bold, no underline above):
 * the app's global `Button:focus` rule (components/_buttons.tcss) grants
 * `bold underline` to ANY focused button, active or not -- exactly the
 * ambiguity the Watchlists tab strip and Lab/MCP mode strips already guard
 * against. Kept a flat "bold, no underline" for the active node whether or
 * not it also holds focus (rather than the tab-strip's flip to a second
 * palette) since a tree node has no separate "resting active" appearance to
 * preserve.
 */
.watchlist-tree .watchlist-tree-root.is-active:focus,
.watchlist-tree .watchlist-tree-watchlist.is-active:focus,
.watchlist-tree .watchlist-tree-source.is-active:focus,
.watchlist-tree .watchlist-tree-root.is-active:hover:focus,
.watchlist-tree .watchlist-tree-watchlist.is-active:hover:focus,
.watchlist-tree .watchlist-tree-source.is-active:hover:focus {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
    outline: none;
}

/* The two prompts the write verbs need (TASK-895).
 *
 * Centred and sized, unlike the older OPML dialogs in the same module,
 * which are unstyled `ModalScreen`s and therefore fill the terminal from
 * the top-left corner. Type selectors so this reaches the modal screen
 * itself (`align` has to be set on the parent of the box being centred),
 * and the id rules below size the box.
 */
WatchlistNameDialog,
WatchlistSourcePickerDialog,
WatchlistPickerDialog {
    align: center middle;
}

/* Briefing preset manager modal (spec #2 phase 2a, Task 3).
 *
 * Centred and explicitly sized, exactly like `WatchlistNameDialog`/
 * `WatchlistSourcePickerDialog` above -- an unstyled `ModalScreen` fills the
 * terminal from the top-left corner. Wider than those two (96, not 60):
 * this modal holds a preset list AND a multi-field editor with a variable
 * number of speaker rows side by side, not one input and a button pair.
 *
 * `width: 96` on `#bpm-dialog` below is pinned by
 * `test_modal_dialog_and_columns_fit_on_screen_with_production_css`
 * (`Tests/Watchlists/test_watchlists_briefing_presets_ui.py`), which asserts
 * the dialog's rendered region is exactly 96 columns wide -- not merely
 * "nonzero" or "fits in the viewport" (a bare `ModalScreen` with no sizing
 * rule at all still reports a nonzero, in-viewport region: its `Vertical`
 * child falls back to filling the whole screen, which the loose assertion
 * would not have caught; the review round that added the exact-width
 * assertion measured this directly). An intentional width change should
 * find that test and update it, rather than trip over it as a mystery
 * failure.
 */
BriefingPresetModal {
    align: center middle;
}

/* Kept briefings modal (task-1780, Task 5): `KeptBriefingsModal`.
 *
 * Same centred/explicitly-sized shape as `BriefingPresetModal` above -- an
 * unstyled `ModalScreen` fills the terminal from the top-left corner.
 * `width: 104` (not 96, `BriefingPresetModal`'s own width): deliberately a
 * DIFFERENT pinned value, so a geometry test asserting this exact number
 * cannot pass by accident against the wrong modal's rule sharing the same
 * value (the same "prove it, do not assume it" discipline
 * `test_modal_dialog_and_columns_fit_on_screen_with_production_css`'s own
 * comment names for `#bpm-dialog`). A future width change should find that
 * sibling test's own `#kbm-dialog` pin and update it deliberately, not trip
 * over it as a mystery failure.
 */
KeptBriefingsModal {
    align: center middle;
}

/* Snapshot view modal (task-1494): `SnapshotViewModal`. Same centred/
 * explicitly-sized shape as `KeptBriefingsModal`/`BriefingPresetModal`
 * above -- an unstyled `ModalScreen` fills the terminal from the top-left
 * corner. `width: 90` is deliberately a THIRD pinned value, distinct from
 * both siblings' (96/104) -- see `#kbm-dialog`'s own comment on why a
 * shared width would let a geometry test pass against the wrong modal.
 */
SnapshotViewModal {
    align: center middle;
}

/* ===== MODULE: features/_lab.tcss ===== */
/* Lab destination (Models | Speech | Evals).
 *
 * ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
 * value below is a $ds token (space/size/percent scales), transcribed
 * value-identically from the raw literals; comments stay load-bearing.
 *
 * These rules MUST live app-tier, not in LabModeStrip.DEFAULT_CSS: the
 * bundle's global `.is-active` rule (border: round) outranks DEFAULT_CSS
 * regardless of specificity, so a widget-tier override silently loses and
 * the active chip's label is clipped by the one-row strip. Mirrors
 * `.personas-mode-chip.is-active` and `#mcp-mode-strip Button.mcp-mode-chip`.
 *
 * This copy is authoritative at runtime. `LabModeStrip.DEFAULT_CSS`
 * (tldw_chatbook/UI/Screens/lab_mode_strip.py) keeps a second, lower-
 * specificity copy of `.lab-mode-chip` rules purely as a fallback for
 * harness apps that mount the strip without loading this bundle. The two
 * have already diverged (that copy adds min-height; this one adds
 * background/color) -- keep them in lockstep when either changes.
 */

#lab-mode-strip Button.lab-mode-chip {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
}

#lab-mode-strip .lab-mode-chip.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

#lab-mode-strip .lab-mode-chip.is-active:focus,
#lab-mode-strip .lab-mode-chip.is-active:hover:focus {
    outline: none;
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* A focused non-active chip must not impersonate the active one. The app's
 * global Button:focus grants bold underline, which is exactly the active
 * chip's signature -- so a keyboard user tabbing the strip would see two
 * chips read as active. Underline stays exclusive to .is-active. Mirrors
 * the same guard MCP applies to its mode chips. */
#lab-mode-strip .lab-mode-chip:focus,
#lab-mode-strip .lab-mode-chip:hover:focus {
    text-style: bold;
    outline: none;
}

/* --- Lab workbench ------------------------------------------------------
 *
 * Region widths are declared here rather than inline so the layout contract
 * is inspectable in one place.
 *
 * The rail is fractional, not fixed. It was `width/min-width/max-width: 26`,
 * which measured 26 cells at 80, 120 and 200 columns alike -- 32.5% of an
 * 80-column terminal for a list whose longest label is 14 characters, while
 * every sibling rail in the app is fractional (`#mcp-hub-rail` is
 * `3fr` with `min-width: 24`). The bounds keep the labels intact at 80
 * columns without letting the rail sprawl at 200.
 *
 * The 24 floor fits the exact surviving longest label, "Speech Recognition",
 * including padding, border, and the active accent. The rendered oracle in
 * `Tests/UI/test_lab_workbench.py` pins it.
 */

.lab-workbench {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

#lab-rail {
    width: $ds-width-fill;
    min-width: $ds-size-24;
    max-width: $ds-size-32;
    height: $ds-height-full;
    min-height: $ds-size-0;
    padding: $ds-space-0;
    background: $ds-surface-panel;
    border-right: solid $ds-column-line;
}

#lab-body {
    width: $ds-fr-4;
    min-width: $ds-size-0;
    height: $ds-height-full;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
}

/* The app-tier global Select rule claims 100% width and a bottom margin.
 * Keep Remote's local variant toolbar balanced; widget-tier BUNDLED_CSS
 * cannot override app-tier geometry in Textual's cascade. */
#remote-variant-sort {
    width: $ds-size-24;
    min-width: $ds-size-18;
    margin-left: $ds-space-1;
    margin-bottom: $ds-space-0;
}

RemoteView.-narrow #remote-variant-sort {
    width: $ds-width-full;
    min-width: $ds-size-0;
    margin-left: $ds-space-0;
    margin-bottom: $ds-space-0;
}

/* TASK-1076: was a hard `30` at every terminal width -- the exact anti-
 * pattern `#lab-rail` documents above (measured 30 cells at 80, 120, 160
 * and 200 columns alike). At 200 columns that left the inspector's usable
 * content ~28 cells wide (`.ds-inspector`'s own padding takes 2), so a
 * plain sentence like "K requested 20 * K returned 20 * canary degenerate"
 * wrapped mid-phrase with 170+ unused columns beside it. Fractional now,
 * like the rail, so it actually grows on a wide terminal. `2fr` (a
 * heavier weight than the rail's own `1fr`, since a FIXED pane was
 * previously eating this whole width and `1fr` alone only grew it to 34
 * cells at 200 columns, measured) -- `#lab-body` stays `4fr`, still the
 * largest of the three regions, so the grid is not starved for it.
 */
#lab-inspector {
    width: $ds-fr-2;
    min-width: $ds-size-30;
    max-width: $ds-size-50;
    height: $ds-height-full;
    min-height: $ds-size-0;
}

/* Rail rows.
 *
 * The `border: none` is REQUIRED, not cosmetic. The bundle declares an
 * unscoped `.is-active { border: round $ds-action-focus; }` earlier in this
 * sheet, and app-tier CSS beats widget DEFAULT_CSS regardless of
 * specificity. A height-1 row that picks up that border renders two rows
 * tall -- a half-bordered artifact that displaces every row below it.
 * `#mcp-hub-rail Button.mcp-rail-row.is-active` carries the same override
 * for the same reason.
 */
.lab-rail Button.lab-rail-row {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-2;
    border: none;
    /* `text-align` alone does NOT left-align a one-line Button label --
       `content-align` positions the label box itself and defaults to
       centered, so without this the nine provider rows each sat at a
       different indent and the list had no shared left edge to scan down.
       Same pairing as `Button.mcp-rail-row`, `Button.mcp-inspector-action`
       and `Button.mcp-callout`, which each hit this and fixed it the same
       way. */
    text-align: left;
    content-align: left middle;
}

/* The active row is a solid fill plus an accent bar; a merely focused row
 * gets underline only (below). They must not converge: the app's global
 * `Button:focus` grants bold, and the old active style was `$ds-focus-bg` --
 * measured identical to the focus background, so a focused row and the
 * active row rendered the same colour and two rows read as selected at
 * once. The mode strip 60 lines above already guards against exactly this.
 *
 * `border: none` first is REQUIRED, not cosmetic: the bundle declares an
 * unscoped `.is-active { border: round $ds-action-focus; }` earlier in this
 * sheet, and app-tier CSS beats widget DEFAULT_CSS regardless of
 * specificity. A height-1 row that picks up that round border renders two
 * rows tall. `border-left` alone consumes a column, never a row, so the
 * accent bar is safe on a one-line button.
 */
.lab-rail .lab-rail-row.is-active {
    border: none;
    border-left: thick $accent;
    background: $primary;
    color: $ds-text-primary;
    text-style: bold;
}

.lab-rail .lab-rail-row.is-active:focus,
.lab-rail .lab-rail-row.is-active:hover:focus {
    outline: none;
    border: none;
    border-left: thick $accent;
    background: $primary;
    color: $ds-text-primary;
    text-style: bold;
}

.lab-rail .lab-rail-row:focus,
.lab-rail .lab-rail-row:hover:focus {
    outline: none;
    background: $ds-surface-raised;
    text-style: underline;
}

/* Section headings carry the accent so the rail has a scannable hierarchy;
 * unstyled they forced the list to be read line by line to find where
 * "Local servers" ended and "Models" began. `margin-top` opens the gap
 * between groups -- the second heading otherwise butts against the last row
 * of the first group. */
.lab-rail-section {
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin-top: $ds-space-1;
    color: $accent;
    text-style: bold;
}

/* --- Header row ---------------------------------------------------------
 *
 * One row carrying title, subtitle, this mode's status chips, and the
 * readiness badge -- the same shape Console collapses its own
 * DestinationHeader into (`#console-workbench-header.console-header-inline`,
 * height 1, border none).
 *
 * Lab previously rendered the stacked `.workbench-header` block instead: a
 * bordered 5 rows, plus a conditional chip row beneath it. That is the only
 * 5-row destination header in the app -- the other eleven destinations size
 * their title with `$ds-destination-header-height` (= 1). The eight rows it
 * cost were the eight that pushed Models' `Start Server` button past the
 * bottom of a 40-row terminal.
 *
 * `.lab-header-inline` is a class, not an id, so all three Lab modes can
 * carry it -- Speech and Evals compose their own DestinationHeader rather
 * than going through this frame, and if only Models were collapsed the mode
 * strip would sit at y=4 on Models and y=8 on the other two, jumping four
 * rows on every switch (measured). It ties `.workbench-header` on
 * specificity (0,1,0) and wins on source order: features/_lab.tcss is
 * emitted after components/ in CSS_MODULES. The descendant rules below are
 * (0,2,0), which beats the density rule that hides the subtitle in compact
 * mode -- the row is one line at any density, so hiding the subtitle would
 * only waste horizontal space.
 */
#lab-header-row {
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-panel;
}

.lab-header-inline {
    layout: horizontal;
    width: $ds-width-fill;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    border: none;
    background: $ds-surface-panel;
}

/* Inside the frame's header row the padding is already supplied by
   `#lab-header-row`; doubling it would indent Models' title two cells
   further than Speech's. */
#lab-header-row .lab-header-inline {
    padding: $ds-space-0;
}

.lab-header-inline .workbench-header-title {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
}

.lab-header-inline .workbench-header-subtitle {
    display: block;
    width: $ds-width-fill;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-left: $ds-space-2;
}

.lab-header-inline .workbench-header-status {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-left: $ds-space-2;
}

/* The chip shares the header's single row with the title, subtitle and
 * readiness badge. `width: auto` means a mode with long chip copy claims
 * whatever it wants and starves the 1fr header beside it -- Speech's
 * capability chip once rendered the full recovery sentence here and
 * collapsed `#lab-destination-header` to ONE cell, truncating the title to
 * "S". Chip copy stays short and the cap makes that structural rather than
 * a convention each mode has to remember. */
.lab-status-chip {
    width: auto;
    max-width: $ds-percent-40;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
    text-overflow: ellipsis;
}

/* The title must survive whatever the chip does. */
.lab-header-inline .workbench-header-title {
    min-width: $ds-size-6;
}

/* Rail width is per-mode, because label length is per-mode. Speech's rows carry
 * double-width emoji -- "🔤 Speech Recognition" measures 21 cells, and at the
 * shared floor Textual dropped the overflowing word entirely, rendering
 * "🔤 Speech" and a bare "📚". Measured, not estimated. */
.lab-mode-stts #lab-rail {
    min-width: $ds-size-28;
    max-width: $ds-size-34;
}

/* Evals' rail is a library, not a menu: section headings carry counts and
 * their empty states put two buttons side by side ("+ New dataset" /
 * "Import…"). At the shared floor those wrapped instead. */
.lab-mode-evals #lab-rail {
    min-width: $ds-size-30;
    max-width: $ds-size-38;
}

/* --- Evals panes inside the frame's regions -----------------------------
 *
 * `#evals-library-pane, #evals-detail-pane, #evals-inspector-pane` carry
 * `border: solid $ds-grid-line` + a panel background from the hand-rolled
 * three-pane workbench they used to live in
 * (components/_agentic_terminal.tcss). Inside the frame those borders are
 * doubled -- `#lab-rail` already draws the column rule -- and each one costs
 * two columns of content width, which truncated the rail's own
 * "Create sample bench" button.
 *
 * Two ids each, so these beat that grouped one-id rule, and features/ is
 * emitted after components/ regardless. The panes keep their ids: those are
 * their stable selectors and several tests query them.
 */
#lab-rail #evals-library-pane,
#lab-body #evals-detail-pane,
#lab-inspector #evals-inspector-pane {
    border: none;
    background: transparent;
    min-height: $ds-size-0;
    padding: $ds-space-0;
}

/* `#lab-rail` and `#lab-inspector` are VerticalScroll containers that
 * already hold a collapse header row. A pane at `height: 100%` there makes
 * the scrollable content header + 100% -- measured `virtual_size` 35 against
 * a `container_size` of 34, so both rails were permanently scrollable by one
 * row and the collapse header could be scrolled out of reach, even with
 * short content. `auto` lets the pane size to its content and leaves
 * overflow to the scroll container, which is its job.
 *
 * This is the same mistake as `#evals-results-grid`'s `height: 100%` fixed
 * in this branch: 100% is the full parent height and ignores siblings.
 * Caught by Qodo on PR #1010. */
#lab-rail #evals-library-pane,
#lab-inspector #evals-inspector-pane {
    height: auto;
}

/* `#lab-body` is a plain Vertical with no header sibling, so the detail
 * pane genuinely should fill it. */
#lab-body #evals-detail-pane {
    height: $ds-height-full;
}

/* "No datasets" offers authoring and import together. In the old three-pane
 * workbench that pane was ~53 columns and the two buttons sat side by side;
 * in the frame's rail they need 34 and get 28, so "Import…" was clipped off
 * the right edge -- present in the DOM, unreachable on screen. Stacking
 * keeps both offered, which is what the design spec's empty-state table
 * actually asks for; only the axis changes. */
#lab-rail .evals-rail-empty-actions {
    layout: vertical;
    height: auto;
}

#lab-rail .evals-rail-empty-actions Button {
    width: $ds-width-full;
}

/* --- Speech panes, Console grammar ---------------------------------------
 *
 * One row per thing. The legacy playground spent 4 rows on every
 * label/input pair and 5 on each explanatory notice, which made the form 93
 * rows tall in a 34-row viewport and put `Generate Speech` at y=60. These
 * rules exist to keep that from coming back: chips are height 1, the action
 * strip is height 1, and only the text input is allowed to grow.
 */
.speech-pane {
    height: $ds-height-fill;
    padding: $ds-space-0 $ds-space-1;
    overflow-y: auto;
}

.speech-pane-title {
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-style: bold;
    color: $ds-status-info;
}

#speech-playground-actions {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

/* The only element allowed to take the remaining space -- everything else on
   this screen is one row. */
.speech-input {
    height: $ds-height-fill;
    min-height: $ds-size-5;
    margin: $ds-space-1 $ds-space-0;
    border: solid $ds-grid-line;
}

.speech-input:focus {
    border: solid $ds-input-focus-border;
}

.speech-chip-row {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

/* `width: auto` with a cap, for the reason the Lab status chip carries one:
   an unbounded auto chip starves its neighbours on the same row. */
.speech-chip {
    width: auto;
    max-width: $ds-size-30;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin-right: $ds-space-1;
    color: $ds-text-muted;
    background: $ds-surface-panel;
    text-overflow: ellipsis;
}

.speech-status-line {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-top: $ds-space-1;
    color: $ds-status-warning;
}

.speech-readiness-line {
    height: auto;
    min-height: $ds-size-1;
    margin-top: $ds-space-1;
    color: $ds-status-info;
}

.speech-detail-line {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
}

.audio-cpp-runtime-card {
    height: auto;
    min-height: $ds-size-1;
    margin-top: $ds-space-1;
}

.audio-cpp-runtime-status {
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-primary;
    text-style: bold;
}

.audio-cpp-runtime-pending,
.audio-cpp-runtime-reason {
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
}

.audio-cpp-diagnostics-warning {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-status-warning;
}

.audio-cpp-diagnostics-lines {
    height: auto;
    min-height: $ds-size-1;
    max-height: $ds-size-12;
    overflow-y: auto;
    color: $ds-text-muted;
}

.audio-cpp-diagnostics-lines:focus {
    outline: heavy $ds-action-focus;
    background: $ds-focus-bg;
    color: $ds-text-primary;
    scrollbar-color-active: $ds-action-focus;
}

#audio-cpp-runtime-actions {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

#audio-cpp-runtime-actions Button.workbench-action {
    width: auto;
    min-width: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-2 $ds-space-0 $ds-space-0;
    border: none;
}

.speech-split-stacked #audio-cpp-runtime-actions {
    layout: vertical;
    height: $ds-size-3;
    min-height: $ds-size-3;
}

.speech-split-stacked #audio-cpp-runtime-actions Button.workbench-action {
    width: $ds-width-full;
    margin: $ds-space-0;
    text-align: left;
    content-align: left middle;
}

/* Textual's Button carries a default min-width, so the shared
 * `.workbench-action { width: auto }` alone still spread six actions across
 * the full pane -- "Export" rendered as "Ex" and "Clear" fell off the right
 * edge entirely. Console packs its action strip left; so does this. */
#speech-playground-actions Button.workbench-action {
    width: auto;
    min-width: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-2 $ds-space-0 $ds-space-0;
    border: none;
}


/* Reverse-video section head, matching Console's inspector section bars
 * (Sources / Run / Tools) rather than inventing a third heading style. */
.speech-section-head {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-top: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}


/* Text | Result, side by side. The pane has width to spend and does not have
 * 34 rows of content to spend vertically -- filling the height with one tall
 * empty box is what made the first two passes read as sparse. */
.speech-split {
    height: $ds-height-fill;
    /* Reference setup and the runtime card are auto-height siblings. Without
     * a floor they consume the short Lab viewport and Textual compresses the
     * synthesis text/current-result split to one or two unusable rows. The
     * current-result pane needs thirteen rows when the clone-only profile-save
     * action is present; keep that complete action set inside the split and
     * let the outer pane scroll for the runtime/clone setup below it. */
    min-height: $ds-size-13;
    margin-top: $ds-space-1;
}

.speech-split-pane {
    width: $ds-width-fill;
    height: $ds-height-full;
    min-width: $ds-size-0;
    min-height: $ds-size-0;
}

#speech-result-pane {
    margin-left: $ds-space-2;
}

/* Below SPEECH_SPLIT_MIN_WIDTH two columns would be ~20 cells each, so the
 * split stacks. Toggled from `on_resize` because Textual has no media
 * queries -- same approach as the Personas compact workbench. */
.speech-split-stacked .speech-split {
    layout: vertical;
}

.speech-split-stacked #speech-result-pane {
    margin-left: $ds-space-0;
    margin-top: $ds-space-1;
}

.speech-input {
    height: $ds-height-fill;
    min-height: $ds-size-4;
    margin: $ds-space-0;
}

.speech-result-state {
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
}

#speech-result-actions {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-top: $ds-space-1;
}

#speech-result-actions Button.workbench-action {
    width: auto;
    min-width: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-2 $ds-space-0 $ds-space-0;
    border: none;
}

/* Result chips stack one per row here, unlike the settings line: they are
   read as a list of facts about one artifact, not scanned across. */
#speech-result-pane .speech-chip {
    width: $ds-width-full;
    max-width: $ds-width-full;
    margin: $ds-space-0;
}

/* Narrow: stack the one-row rows rather than let them overflow.
 *
 * At 80 columns the Lab body is ~41 cells. Six actions and four chips do not
 * fit on one row each -- Stop/Export/Clear and two chips were being cut off
 * at the right edge, present in the DOM and unreachable on screen. Dropping
 * actions below a threshold would hide capability; stacking keeps every
 * option and spends rows, which is the correct trade on a narrow terminal
 * where rows are the cheaper resource.
 */
.speech-split-stacked #speech-playground-actions,
.speech-split-stacked #speech-result-actions,
.speech-split-stacked #speech-settings-line {
    layout: vertical;
    height: auto;
    min-height: $ds-size-1;
}

/* The Playground inventory is a fixed six actions. Textual's horizontal
 * container resolves `height: auto` one row short after it switches to a
 * vertical layout, so reserve the six actual rows rather than clipping the
 * final cross-surface navigation action. */
.speech-split-stacked #speech-playground-actions {
    height: $ds-size-6;
    min-height: $ds-size-6;
}

.speech-split-stacked #speech-playground-actions Button.workbench-action,
.speech-split-stacked #speech-result-actions Button.workbench-action {
    width: $ds-width-full;
    margin: $ds-space-0;
    text-align: left;
    content-align: left middle;
}

.speech-split-stacked .speech-chip {
    width: $ds-width-full;
    max-width: $ds-width-full;
    margin: $ds-space-0;
}

/* With the rows stacked, the pane scrolls rather than clipping. */
.speech-split-stacked {
    overflow-y: auto;
}

/* Stacked, the panes must overflow rather than compress. `height: 1fr` on
 * the text area let it shrink to a single row so the Result pane fell off
 * the bottom with nothing to scroll -- virtual height equalled the
 * container, so the content was clipped, not scrollable. Fixed heights make
 * the pane genuinely taller than its viewport, which is what turns
 * `overflow-y: auto` into a usable scroll. */
.speech-split-stacked .speech-split-pane {
    height: auto;
}

.speech-split-stacked .speech-input {
    height: $ds-size-6;
    min-height: $ds-size-6;
}

/* The split itself must stop being `1fr` when stacked: at 1fr it resolved to
 * 3 rows while its two panes needed 17, so it squeezed them and the overflow
 * happened inside a container that does not scroll. `auto` lets it take its
 * content height and pushes the scrolling up to `.speech-pane`, which has
 * `overflow-y: auto`. */
.speech-split-stacked .speech-split {
    height: auto;
}

/* An override is stated, not implied. The Playground owns session-scoped
 * values that never write back, so the user must be able to see at a glance
 * what they have deliberately changed. The asterisk in the label carries it
 * for anyone who cannot use the colour. */
.speech-chip-override {
    color: $ds-status-warning;
    text-style: bold;
}

/* Parameter rows: label left, control right, one row each. The legacy form
 * spent four rows on exactly this pairing, which is most of why it was 93
 * rows tall. */
.speech-param-row {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

.speech-param-label {
    width: $ds-size-24;
    height: $ds-size-1;
    color: $ds-text-muted;
}

.speech-param-control {
    width: $ds-width-fill;
    height: $ds-size-1;
    min-height: $ds-size-1;
    border: none;
}

/* The axes reflow onto a second line rather than truncating. Six chips need
 * more than the ~81 cells the Lab body gives at 120 columns -- "Format" was
 * being cut to "Format: un" and "Speed" fell off the edge. These are the
 * variables the user is comparing; they are the last thing that may be
 * clipped. One column when stacked. */
.speech-axis-grid {
    grid-size: 3;
    grid-rows: 1;
    grid-gutter: 0 1;
    height: auto;
    margin-bottom: $ds-space-1;
}

.speech-split-stacked .speech-axis-grid {
    grid-size: 1;
}

/* Four player actions do not fit the ~38-cell result pane on one row --
 * "Export" rendered at x=101..111 against a pane ending at 107, clipped by
 * the parent rather than by itself. A 2x2 grid fits, and reflows to one
 * column when stacked. */
#speech-result-actions {
    layout: grid;
    grid-size: 2;
    grid-rows: 1;
    grid-gutter: 0 1;
    height: auto;
    margin-top: $ds-space-1;
}

.speech-split-stacked #speech-result-actions {
    grid-size: 1;
}

/* Axis cells: label then the real control, one row. The label carries the
 * override marker; the control carries the legacy id so the existing
 * synthesis handler reads it unchanged. */
.speech-axis-cell {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

.speech-axis-cell .speech-chip {
    width: $ds-size-10;
    max-width: $ds-size-10;
    margin: $ds-space-0;
    background: transparent;
}

.speech-axis-control {
    width: $ds-width-fill;
    height: $ds-size-1;
    min-height: $ds-size-1;
    border: none;
    background: $ds-surface-panel;
}

/* `border: none` on a Select does NOT reach its inner SelectCurrent, which
 * keeps its own three-row bordered box. Clipped to `height: 1`, every axis
 * rendered its top border and nothing else -- a visible control showing
 * neither its value nor its arrow. The child needs the rule too. */
.speech-axis-control SelectCurrent {
    border: none;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}

.speech-axis-control SelectCurrent Static {
    height: $ds-size-1;
}

/* The speed Input has the same inner-border problem in reverse: it is the
 * bordered widget itself. */
Input.speech-axis-control {
    padding: $ds-space-0 $ds-space-1;
}

/* --- Speech: player, generation status, clip source ------------------- */

/* The result is one current artifact. It owns enough intrinsic height for its
 * summary, lifecycle copy, and always-visible actions. */
.speech-player {
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    border-top: solid $ds-grid-line;
}

#audio-player-container > .speech-section-head {
    margin-top: $ds-space-0;
}

.speech-player-status {
    height: $ds-size-1;
    color: $ds-text-primary;
    text-style: bold;
}

.speech-result-lifecycle {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
}

.speech-result-provenance {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
}

.speech-player-transport {
    height: $ds-size-1;
}

#audio-progress-bar {
    width: $ds-width-fill;
    height: $ds-size-1;
}

.speech-player-time {
    width: auto;
    min-width: $ds-size-12;
    content-align: right middle;
    color: $text-muted;
}

/* Generic Collapsible styling elsewhere is a three-row form header. Speech's
 * diagnostics and tuning disclosures are compact workbench rows. */
#speech-param-group,
#speech-connection-details,
#speech-log-group,
#audio-cpp-runtime-details,
#audio-cpp-runtime-diagnostics {
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0;
    margin-bottom: $ds-space-0;
    border: none;
    background: transparent;
}

#speech-param-group > CollapsibleTitle,
#speech-connection-details > CollapsibleTitle,
#speech-log-group > CollapsibleTitle,
#audio-cpp-runtime-details > CollapsibleTitle,
#audio-cpp-runtime-diagnostics > CollapsibleTitle {
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#speech-param-group > Contents,
#speech-connection-details > Contents,
#speech-log-group > Contents,
#audio-cpp-runtime-details > Contents,
#audio-cpp-runtime-diagnostics > Contents {
    height: auto;
}

/* One row: what is happening, and how far along. */
.speech-generation-status {
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}

.speech-generation-text {
    width: $ds-width-fill;
    color: $text-muted;
}

#generation-progress {
    width: auto;
    min-width: $ds-size-20;
    height: $ds-size-1;
}

/* Diagnostic, so it stays behind a collapsed disclosure rather than
   occupying rows nobody reads. */
#speech-log-group {
    height: auto;
    border: none;
    background: transparent;
}

.speech-log {
    height: $ds-size-8;
    background: transparent;
}

/* The reference-clip / voice-sample picker, mounted only for the providers
   that use one. */
.speech-source-row {
    height: $ds-size-1;
    margin-top: $ds-space-1;
}

.speech-source-status {
    width: $ds-width-fill;
    color: $text-muted;
}

.speech-clone-setup-host,
#speech-clone-setup {
    height: auto;
    min-height: $ds-size-0;
}

#speech-clone-setup {
    margin-top: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    border-top: solid $ds-grid-line;
    background: $ds-surface-panel;
}

.speech-clone-guidance,
.speech-clone-privacy,
.speech-clone-error {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
}

.speech-clone-privacy {
    color: $ds-status-warning;
}

.speech-clone-error {
    color: $ds-status-info;
}

.speech-clone-reference-row,
.speech-clone-actions {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-top: $ds-space-1;
}

.speech-clone-reference-row Button,
.speech-clone-actions Button {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    border: none;
}

.speech-clone-transcript {
    height: $ds-size-4;
    min-height: $ds-size-3;
    margin-top: $ds-space-1;
}

.speech-split-stacked .speech-clone-reference-row,
.speech-split-stacked .speech-clone-actions {
    layout: vertical;
    height: auto;
}

.speech-split-stacked .speech-clone-reference-row Button,
.speech-split-stacked .speech-clone-actions Button {
    width: $ds-width-full;
    margin: $ds-space-0;
    text-align: left;
    content-align: left middle;
}

/* --- Speech: TTS Settings --------------------------------------------- */

/* One row per setting. The legacy form spent FOUR on each -- a blank row,
 * the input's top border, the label+value row, the bottom border -- which
 * is what put `save-settings-btn` at y=102 in a 26-row viewport. */
.speech-setting-row {
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}

.speech-setting-label {
    width: $ds-size-28;
    color: $text-muted;
}

.speech-setting-control {
    width: $ds-width-fill;
    height: $ds-size-1;
    min-height: $ds-size-1;
    border: none;
    background: $ds-surface-panel;
}

/* Read-only global ownership stays visible without competing for the row's
   flexible width. Static defaults to 1fr; that used to leave the actual
   value control only two cells wide at every tested terminal width. */
.speech-setting-scope {
    width: auto;
    min-width: $ds-size-0;
    margin-left: $ds-space-1;
    color: $text-muted;
}

/* `border: none` on a Select does not reach its inner SelectCurrent, which
 * keeps its own three-row box and, clipped to `height: 1`, paints only its
 * top border. */
.speech-setting-control SelectCurrent {
    border: none;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}

Input.speech-setting-control {
    padding: $ds-space-0 $ds-space-1;
}

/* The forms-wide `Input:focus` rule re-adds a border at higher specificity
 * than the border-none class rule above, and the reset-tier `*:focus`
 * accessibility outline paints OVER the widget's outermost rendered lines
 * (its own comment warns of exactly this) — on a height-1 row that line IS
 * the only content line, so focusing the field replaced the typed value
 * with the outline's box characters (TASK-15421 AC3). Opt out of both and
 * show focus with the content-safe tint instead — the same opt-out +
 * recolour pattern the reset comment prescribes (TASK-1160's DataTable
 * precedent). */
Input.speech-setting-control:focus {
    border: none;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

.speech-settings-group {
    height: auto;
    border: none;
    background: transparent;
    margin-bottom: $ds-space-1;
}

/* The action strip sits OUTSIDE the scroll region: `save-settings-btn`
 * measured at y=102 after every provider block, four screens below the
 * fold. Keeping it above the groups is what makes it reachable regardless
 * of how many are expanded. */
.speech-settings-pane {
    height: $ds-height-fill;
}

#speech-settings-actions {
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin-bottom: $ds-space-1;
}

#speech-settings-groups {
    height: $ds-height-fill;
    overflow-y: auto;
}

.studio-tts-scope {
    height: auto;
    min-height: $ds-size-2;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
}

#speech-settings-actions {
    height: auto;
    min-height: $ds-size-1;
}

#speech-settings-actions Button.workbench-action,
#studio-tts-voice-destination-actions Button.workbench-action,
#voice-blends-actions Button.workbench-action {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-2 $ds-space-0 $ds-space-0;
    border: none;
}

.studio-tts-settings-stacked #speech-settings-actions {
    layout: vertical;
    height: $ds-size-4;
}

.studio-tts-settings-stacked #speech-settings-actions Button.workbench-action {
    width: $ds-width-full;
    margin-right: $ds-space-0;
}

.studio-tts-setting-row {
    height: auto;
    min-height: $ds-size-1;
}

.studio-tts-source {
    width: $ds-size-34;
    min-width: $ds-size-18;
    padding-left: $ds-space-1;
    color: $ds-text-muted;
    text-overflow: ellipsis;
}

.studio-tts-field-error {
    width: auto;
    min-width: $ds-size-16;
    padding-left: $ds-space-1;
    color: $ds-status-error;
}

.studio-tts-settings-stacked .studio-tts-setting-row {
    layout: vertical;
    height: auto;
    min-height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

.studio-tts-settings-stacked .studio-tts-setting-row .speech-setting-label,
.studio-tts-settings-stacked .studio-tts-setting-row .speech-setting-control,
.studio-tts-settings-stacked .studio-tts-setting-row .studio-tts-source,
.studio-tts-settings-stacked .studio-tts-setting-row .studio-tts-field-error {
    width: $ds-width-full;
    min-width: $ds-size-0;
}

.studio-tts-settings-stacked .studio-tts-setting-row .studio-tts-source,
.studio-tts-settings-stacked .studio-tts-setting-row .studio-tts-field-error {
    height: auto;
    min-height: $ds-size-1;
}

#studio-tts-chatterbox-options {
    height: auto;
}

#studio-tts-voice-destination-actions,
#voice-blends-actions {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-1 $ds-space-1 $ds-space-1;
}

.studio-tts-settings-stacked #studio-tts-voice-destination-actions {
    layout: vertical;
    height: $ds-size-2;
}

.studio-tts-settings-stacked #studio-tts-voice-destination-actions Button.workbench-action {
    width: $ds-width-full;
    margin-right: $ds-space-0;
}

.studio-tts-helper {
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
}

#tts-adopt-studio-preferences-btn {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
}

/* Voice-profile portability uses one scrollable, terminal-native review
 * surface. The vertical action stack remains reachable at 80x24 without
 * relying on pointer-only affordances or clipped horizontal controls. */
TTSProfileExportChoiceModal,
TTSVoiceBundleConsentModal,
TTSVoiceBundleReviewModal {
    align: center middle;
    background: $background 75%;
}

.stts-portability-dialog {
    width: $ds-percent-90;
    max-width: $ds-size-76;
    height: auto;
    max-height: $ds-percent-90;
    padding: $ds-space-1 $ds-space-2;
    background: $panel;
    border: round $accent;
    overflow-y: auto;
}

.stts-portability-title {
    height: auto;
    margin-bottom: $ds-space-1;
    text-style: bold;
}

.stts-portability-copy,
.stts-portability-recovery {
    height: auto;
    margin-bottom: $ds-space-1;
}

.stts-portability-recovery {
    color: $warning;
}

.stts-portability-actions {
    layout: vertical;
    height: auto;
    margin-top: $ds-space-1;
}

.stts-portability-actions Button {
    width: $ds-width-full;
    height: $ds-size-3;
    min-width: $ds-size-0;
    margin-bottom: $ds-space-1;
}

/* Portable material controls stay visibly inert without stacking the generic
 * whole-widget fade, Textual's disabled ink and the app's disabled token.
 * The neutral surface carries state; the label remains readable at the
 * product's 3:1 disabled-control floor in every bundled theme. */
.stts-portability-dialog .stts-portability-actions Button:disabled,
STTSProfileLibrary #stts-profile-actions #stts-profile-import-btn:disabled {
    opacity: 100%;
    text-opacity: 100%;
    text-style: none;
    color: $text;
    background: $surface-darken-1;
}

.stts-portability-actions Button:focus,
.stts-portability-dialog Checkbox:focus,
.stts-portability-dialog Select:focus,
.stts-portability-dialog TextArea:focus {
    outline: heavy $accent;
}

#stts-bundle-review-facts {
    height: $ds-size-9;
    min-height: $ds-size-6;
}


/* AudioBook actions live above the scroll region, so they stay on screen
 * whatever is expanded below. Inside it they measured at y=40 in a 26-row
 * viewport, after eight collapsible groups. */
#audiobook-actions {
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin-bottom: $ds-space-1;
}

#audiobook-actions Button {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-2 $ds-space-0 $ds-space-0;
    border: none;
}

/* Model Library is an operate surface: rows grow with truthful package facts,
 * while the allocated pane (including a narrow Lab rail) owns scrolling. */
#llm-view-curated,
#llm-view-installed,
CuratedView,
InstalledView {
    min-width: $ds-size-0;
    min-height: $ds-size-0;
    overflow: hidden;
}

CuratedView .curated-header,
InstalledView .installed-header {
    layout: vertical;
    height: auto;
}

CuratedView .curated-header Button,
InstalledView .installed-header Button {
    width: $ds-width-full;
    min-width: $ds-size-0;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

CuratedView .curated-list,
InstalledView .installed-list {
    height: $ds-height-fill;
    min-height: $ds-size-0;
    overflow-y: auto;
}

CuratedView .curated-model-row,
InstalledView .installed-model-row,
CuratedView .audio-cpp-companions,
InstalledView .audio-cpp-companions,
CuratedView .audio-cpp-package-copy,
InstalledView .audio-cpp-package-copy,
InstalledView .installed-recovery-status {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
}

CuratedView .audio-cpp-actions,
InstalledView ModelActivationControls.audio-cpp-actions,
InstalledView ModelActivationControls.audio-cpp-actions Horizontal {
    layout: vertical;
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
}

CuratedView .audio-cpp-actions Button,
InstalledView .audio-cpp-actions Button {
    width: $ds-width-full;
    min-width: $ds-size-0;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

InstalledView .installed-recovery-status {
    color: $warning;
    margin-bottom: $ds-space-1;
}

CuratedView .curated-disabled-reason,
CuratedView .curated-recovery-status,
InstalledView .model-disabled-reason {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    margin-bottom: $ds-space-1;
    color: $warning;
}

CuratedView Button:focus,
CuratedView CollapsibleTitle:focus,
InstalledView Button:focus,
InstalledView CollapsibleTitle:focus {
    outline: heavy $accent;
}

/* App-tier disabled ink overrides Textual's generic dimming. The neutral
 * surface plus normal text token remains >=3:1 in all five shipped themes. */
CuratedView Button:disabled,
InstalledView Button:disabled {
    opacity: 100%;
    text-opacity: 100%;
    text-style: none;
    color: $text;
    background: $surface-darken-1;
}

/* --- vLLM Operate workbench -------------------------------------------
 *
 * The three classes are computed from VllmSetupView's allocated width,
 * after Lab rails have taken their share. They deliberately do not key off
 * the terminal width: an open Inspector changes the space this form owns.
 */
VllmSetupView {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-height-full;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
}

VllmSetupView #vllm-readiness-state {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    border-left: thick $accent;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    text-style: bold;
}

VllmSetupView #vllm-readiness-checklist {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-panel;
}

VllmSetupView #vllm-readiness-checklist > Label {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
}

VllmSetupView .vllm-picker-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-3;
}

VllmSetupView .vllm-picker-row > Input.vllm-picker-input {
    width: $ds-width-fill;
    min-width: $ds-size-0;
}

VllmSetupView .vllm-picker-row > Button.vllm-picker-button {
    width: auto;
    min-width: $ds-size-10;
    margin-left: $ds-space-1;
}

VllmSetupView > .section-title,
VllmSetupView > .section_label,
VllmSetupView > .description {
    height: auto;
    margin: $ds-space-0;
}

VllmSetupView #vllm-next-action,
VllmSetupView .vllm-mode-actions,
VllmSetupView .vllm-profile-actions,
VllmSetupView .vllm-source-actions,
VllmSetupView .vllm-console-actions {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
}

VllmSetupView #vllm-fold-cue {
    display: none;
    width: $ds-width-full;
    height: $ds-size-1;
    color: $ds-text-muted;
    text-style: dim;
}

VllmSetupView #vllm-local-setup,
VllmSetupView #vllm-existing-setup,
VllmSetupView #vllm-current-server,
VllmSetupView #vllm-next-restart,
VllmSetupView Input.vllm-control,
VllmSetupView Select.vllm-control,
VllmSetupView TextArea.vllm-control,
VllmSetupView Collapsible.vllm-control {
    width: $ds-width-full;
    min-width: $ds-size-0;
}

VllmSetupView Button.vllm-focus-target:focus,
VllmSetupView CollapsibleTitle.vllm-focus-target:focus,
VllmSetupView Input.vllm-focus-target:focus,
VllmSetupView Select.vllm-focus-target:focus,
VllmSetupView TextArea.vllm-focus-target:focus {
    outline: heavy $ds-focus-accent;
}

/* Focus changes ink and outline only. Geometry stays stable while users
 * traverse the complete, provider-contained Tab loop. */
VllmSetupView Button.vllm-button:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

VllmSetupView.vllm-wide .vllm-mode-actions > Button.vllm-action-button,
VllmSetupView.vllm-wide .vllm-profile-actions > Button.vllm-action-button,
VllmSetupView.vllm-wide .vllm-source-actions > Button.vllm-action-button,
VllmSetupView.vllm-wide #vllm-next-action > Button.vllm-action-button,
VllmSetupView.vllm-medium #vllm-next-action > Button.vllm-action-button {
    width: $ds-width-fill;
    min-width: $ds-size-0;
}

VllmSetupView.vllm-wide .vllm-mode-actions,
VllmSetupView.vllm-wide .vllm-profile-actions,
VllmSetupView.vllm-wide .vllm-source-actions,
VllmSetupView.vllm-wide #vllm-next-action,
VllmSetupView.vllm-wide .vllm-console-actions,
VllmSetupView.vllm-medium #vllm-next-action {
    height: $ds-size-3;
}

/* Medium and compact re-compose complete controls into rows. This uses
 * vertical flow instead of clipping or hiding core actions. */
VllmSetupView.vllm-medium .vllm-mode-actions,
VllmSetupView.vllm-medium .vllm-profile-actions,
VllmSetupView.vllm-medium .vllm-source-actions,
VllmSetupView.vllm-compact .vllm-mode-actions,
VllmSetupView.vllm-compact .vllm-profile-actions,
VllmSetupView.vllm-compact .vllm-source-actions,
VllmSetupView.vllm-compact .vllm-picker-row,
VllmSetupView.vllm-compact #vllm-next-action {
    layout: vertical;
}

VllmSetupView.vllm-medium .vllm-mode-actions > Button.vllm-action-button,
VllmSetupView.vllm-medium .vllm-profile-actions > Button.vllm-action-button,
VllmSetupView.vllm-medium .vllm-source-actions > Button.vllm-action-button,
VllmSetupView.vllm-compact .vllm-mode-actions > Button.vllm-action-button,
VllmSetupView.vllm-compact .vllm-profile-actions > Button.vllm-action-button,
VllmSetupView.vllm-compact .vllm-source-actions > Button.vllm-action-button,
VllmSetupView.vllm-compact .vllm-picker-row > Button.vllm-picker-button,
VllmSetupView.vllm-compact #vllm-next-action > Button.vllm-action-button,
VllmSetupView.vllm-compact #vllm-browse-local-model-directory-button.vllm-picker-button,
VllmSetupView.vllm-compact .vllm-console-actions > Button.vllm-action-button {
    width: $ds-width-full;
    min-width: $ds-size-0;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

VllmSetupView.vllm-compact .vllm-picker-row {
    height: auto;
}

VllmSetupView.vllm-compact .vllm-picker-row > Input.vllm-picker-input {
    width: $ds-width-full;
}

VllmSetupView.vllm-compact > .section-title {
    margin-top: $ds-space-0;
}

VllmSetupView.vllm-compact > .description {
    display: none;
}

/* The selected mode is already stated by the two complete action rows.
 * Dropping only the duplicate summary keeps the next three-row control from
 * straddling the 80x24 viewport edge. */
VllmSetupView.vllm-compact.vllm-two-actions #vllm-mode-summary {
    display: none;
}

/* ===== MODULE: features/_research_workspace.tcss ===== */
/* Research Workspace: established Neon Workbench extension.
 * All regions mount once; responsive classes only change display and sizing.
 */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent/fr scales + the named
   $ds-research-chat-pane-floor), transcribed value-identically from the
   raw literals; comments stay load-bearing. */


#research-workspace-shell {
    width: $ds-width-full;
    height: $ds-height-full;
    min-height: $ds-size-0;
    background: $background;
}

/* Runs adds the shared one-row mode strip above the legacy 100%-high window.
 * Claim only the remaining screen-content height so its footer stays contained.
 * layout: vertical -- ResearchWindow subclasses Vertical, but the global
 * `.window` rule (layout/_windows.tcss) forces layout: horizontal, which
 * crushed the whole Runs view into one squashed row (release P1).
 */
ResearchScreen #research-window.window {
    layout: vertical;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

#research-workspace-header {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-0;
    background: $panel;
}

#research-workspace-header .workbench-header {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    padding: $ds-space-0 $ds-space-1;
    border: none;
}

#research-mode-strip {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    overflow: hidden;
    background: $panel;
}

#research-mode-strip .research-mode-label {
    width: $ds-size-10;
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $accent;
    text-style: bold;
}

#research-mode-strip Button.research-mode-chip {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $surface-darken-1;
    color: $text-muted;
}

#research-mode-strip .research-mode-chip.is-active,
#research-mode-strip .research-mode-chip.is-active:focus {
    border: none;
    background: $primary;
    color: $text;
    text-style: bold underline;
    outline: none;
}

#research-mode-strip .research-mode-chip:focus {
    border: none;
    background: $surface;
    color: $text;
    text-style: bold underline;
    outline: none;
}

#research-authority-summary {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $surface-darken-1;
}

#research-processing-summary {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $surface-darken-1;
}

#research-authority-summary Static,
#research-processing-summary Static {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-right: $ds-space-2;
    color: $text-muted;
}

#research-data-source-label {
    color: $accent;
    text-style: bold;
    margin-right: $ds-space-1;
}

#research-authority-summary #research-data-source-separator {
    margin: $ds-space-0;
}

#research-authority-summary .research-data-source-button {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $surface-darken-1;
    color: $text-muted;
}

#research-authority-summary .research-data-source-button:focus {
    border: none;
    outline: none;
    background: $ds-focus-bg;
    color: $text;
    text-style: bold underline;
}

#research-authority-summary .research-data-source-button.is-active,
#research-authority-summary .research-data-source-button.is-active:focus {
    border: none;
    outline: none;
    background: $primary;
    color: $text;
    text-style: bold underline;
}

#research-authority-recovery {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $warning 15%;
    color: $text;
}

#research-workspace-menu {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $panel;
}

#research-workspace-selection {
    width: $ds-width-fill;
    height: $ds-size-1;
    color: $text-muted;
}

#research-manage-workspaces {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $surface;
    color: $text;
}

#research-manage-workspaces:focus {
    border: none;
    outline: none;
    background: $primary;
    color: $text;
    text-style: bold underline;
}

#research-pane-mode-strip {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $surface-darken-1;
    align-horizontal: center;
}

#research-pane-mode-strip .research-pane-mode-button {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $surface-darken-1;
    color: $text-muted;
}

#research-pane-mode-strip .research-pane-mode-button.is-active {
    border: none;
    background: $primary-darken-1;
    color: $text;
    text-style: bold;
}

#research-pane-mode-strip .research-pane-mode-button:focus {
    border: none;
    outline: none;
    background: $primary;
    color: $text;
    text-style: bold underline;
}

#research-workspace-grid {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
    background: $background;
    overflow: hidden;
}

.research-workspace-pane {
    height: $ds-height-full;
    min-height: $ds-size-0;
    padding: $ds-space-1;
    border: round $surface-lighten-1;
    background: $panel;
    color: $text;
}

.research-workspace-pane:focus {
    border: round $accent;
    outline: none;
}

.research-pane-title {
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $accent;
    text-style: bold;
}

.research-pane-summary {
    height: auto;
    margin-top: $ds-space-1;
    color: $text-muted;
}

.research-pane-empty {
    height: auto;
    margin-top: $ds-space-1;
    color: $text;
}

#research-sources-pane {
    width: $ds-width-fill;
    min-width: $ds-size-32;
    max-width: $ds-size-38;
}

#research-chat-pane {
    width: $ds-fr-4;
    min-width: $ds-research-chat-pane-floor;
}

#research-studio-pane {
    width: $ds-fr-2;
    min-width: $ds-size-42;
    max-width: $ds-size-50;
}

ResearchPaneHandle {
    width: $ds-size-4;
    min-width: $ds-size-4;
    max-width: $ds-size-4;
    height: $ds-height-full;
    min-height: $ds-size-0;
    background: $surface-darken-1;
    align: center middle;
}

ResearchPaneHandle .research-pane-handle-button {
    width: $ds-size-4;
    min-width: $ds-size-4;
    max-width: $ds-size-4;
    height: $ds-size-3;
    min-height: $ds-size-3;
    padding: $ds-space-0;
    border: none;
    background: $surface;
    color: $text-muted;
}

ResearchPaneHandle .research-pane-handle-button:focus {
    border: none;
    outline: heavy $accent;
    background: $primary;
    color: $text;
    text-style: bold;
}

#research-workspace-grid.layout-medium #research-sources-pane,
#research-workspace-grid.layout-medium #research-studio-pane {
    width: $ds-fr-2;
    min-width: $ds-size-32;
    max-width: $ds-size-42;
}

#research-workspace-grid.layout-medium #research-chat-pane {
    width: $ds-fr-4;
    min-width: $ds-research-chat-pane-floor;
}

#research-workspace-grid.layout-narrow .research-workspace-pane {
    width: $ds-width-full;
    min-width: $ds-size-0;
    max-width: $ds-width-full;
}

#research-workspace-status {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $panel;
    color: $text-muted;
}

#research-workspace-shell.height-compact #research-destination-header {
    height: $ds-size-2;
    min-height: $ds-size-2;
}

#research-workspace-shell.height-compact #workbench-header-subtitle {
    display: none;
}

#research-workspace-shell.height-compact #research-source-filter-summary {
    display: none;
}

#research-workspace-shell.height-compact .research-workspace-pane {
    padding: $ds-space-0;
    border: none;
}

#research-workspace-shell.height-compact .research-workspace-pane:focus {
    border: none;
    outline: heavy $accent;
}

/* Task 4 Sources workbench: compact, keyboard-first controls. */
ResearchSourcesRegion {
    width: $ds-width-full;
    height: $ds-height-full;
    min-height: $ds-size-0;
    padding: $ds-space-0;
    scrollbar-size: 1 1;
}

ResearchSourcesRegion Horizontal,
ResearchSourcesRegion Vertical {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-0;
}

ResearchSourcesRegion Button {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $surface;
    color: $text;
}

ResearchSourcesRegion Button:focus {
    border: none;
    outline: none;
    background: $primary;
    color: $text;
    text-style: bold underline;
}

#research-workspace-shell ResearchSourcesRegion Button:disabled {
    opacity: 100%;
    text-opacity: 100%;
    background: $surface-darken-1;
    color: $text-muted;
    text-style: none;
}

ResearchSourcesRegion Input,
ResearchSourcesRegion Select {
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $surface-darken-1;
}

#research-source-header,
#research-source-quick-row,
#research-source-view-row,
#research-source-selection-row,
#research-source-selection-summary,
#research-source-page-actions {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

#research-sources-heading,
#research-source-quick-url,
#research-source-search,
#research-source-selected-count,
#research-source-page-summary {
    width: $ds-width-fill;
}

#research-source-add,
#research-source-quick-submit,
#research-source-advanced,
#research-source-page-prev,
#research-source-page-next {
    width: auto;
}

#research-source-recovery {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $warning 15%;
    color: $text;
}

#research-source-filter-summary,
#research-source-move-copy-reason,
#research-source-remove-scope,
#research-source-filter-owner-limits {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    color: $text-muted;
}

#research-source-advanced-controls {
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    background: $surface-darken-1;
}

.research-source-filter-row {
    height: $ds-size-1;
}

.research-source-filter-row Select {
    width: $ds-width-fill;
}

#research-source-selection-row Button {
    width: $ds-width-fill;
    padding: $ds-space-0;
}

#research-source-batch-actions,
#research-source-folders,
.research-source-folder-actions,
.research-source-row-actions {
    layout: vertical;
    height: auto;
}

#research-source-batch-actions Button,
.research-source-folder-actions Button,
.research-source-row-actions Button {
    width: $ds-width-full;
}

#research-source-folders {
    margin-top: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    border-left: solid $surface-lighten-1;
}

#research-source-folders-label,
#research-source-receipts-heading {
    width: $ds-width-full;
    height: $ds-size-1;
    color: $accent;
    text-style: bold;
}

#research-source-folder-name,
#research-source-folder-tree {
    width: $ds-width-full;
}

ResearchSourceList,
ResearchSourceReceiptList {
    width: $ds-width-full;
    height: auto;
}

_ResearchSourceRowSlot,
_ResearchSourceReceiptSlot {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    margin-top: $ds-space-1;
    background: $surface-darken-1;
    border-left: solid $surface-lighten-1;
}

.research-source-row-heading,
.research-source-receipt-actions {
    height: $ds-size-1;
}

.research-source-row-heading Static {
    width: $ds-width-fill;
    height: $ds-size-1;
    color: $text;
    text-style: bold;
}

_ResearchSourceRowSlot Static,
_ResearchSourceReceiptSlot Static {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
}

#research-source-receipts-bound {
    width: $ds-width-full;
    height: auto;
    color: $text-muted;
}

/* Task 5 Quick Notes: compact canonical owner editor inside Studio. */
ResearchQuickNotesSection {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-0;
    margin-top: $ds-space-1;
    padding: $ds-space-0 $ds-space-1 $ds-space-1 $ds-space-1;
    background: $surface-darken-1;
    border-left: solid $accent;
}

ResearchQuickNotesSection Horizontal {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
}

ResearchQuickNotesSection Button {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $surface;
    color: $text;
}

ResearchQuickNotesSection Button:focus {
    border: none;
    outline: none;
    background: $primary;
    color: $text;
    text-style: bold underline;
}

#research-workspace-shell ResearchQuickNotesSection Button:disabled {
    opacity: 100%;
    text-opacity: 100%;
    background: $surface-darken-1;
    color: $text-muted;
    text-style: none;
}

#research-quick-notes-heading {
    width: $ds-width-fill;
    color: $accent;
    text-style: bold;
}

#research-quick-note-count {
    width: auto;
    margin-right: $ds-space-1;
    color: $text-muted;
}

#research-quick-note-search,
#research-quick-note-page {
    width: $ds-width-fill;
}

#research-quick-note-list,
#research-quick-note-title,
#research-quick-note-tags {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $surface;
}

#research-quick-note-provenance-row,
#research-quick-note-mode-row,
#research-quick-note-actions,
#research-quick-note-file-actions {
    margin-top: $ds-space-1;
}

#research-quick-note-provenance,
#research-quick-note-status,
#research-quick-note-owner-limits {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    color: $text-muted;
}

#research-quick-note-status {
    color: $text;
}

#research-quick-note-owner-limits {
    background: $warning 15%;
}

#research-quick-note-body,
#research-quick-note-preview {
    width: $ds-width-full;
    height: $ds-size-10;
    min-height: $ds-size-5;
    margin-top: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    border: solid $surface-lighten-1;
    background: $panel;
}

#research-quick-note-mode-row Button.is-active {
    background: $primary-darken-1;
    color: $text;
    text-style: bold;
}

#research-workspace-shell.height-compact #research-quick-note-body,
#research-workspace-shell.height-compact #research-quick-note-preview {
    height: $ds-size-6;
}

/* Add Sources and source inspector modals share the workbench visual world. */
ResearchAddSourceModal,
ResearchSourceInspectorModal,
ResearchOverlayConflictModal,
ResearchNoteConflictModal,
ResearchNoteSwitchRecoveryModal {
    align: center middle;
    background: $background 70%;
}

#research-add-source-dialog,
#research-source-inspector-dialog,
#research-overlay-conflict-dialog,
#research-note-conflict-dialog,
#research-note-switch-dialog {
    width: $ds-percent-90;
    max-width: $ds-size-110;
    height: $ds-percent-90;
    min-height: $ds-size-18;
    padding: $ds-space-1;
    border: round $accent;
    background: $panel;
}

#research-overlay-conflict-dialog,
#research-note-conflict-dialog,
#research-note-switch-dialog {
    height: auto;
    max-width: $ds-size-76;
}

#research-overlay-conflict-dialog Button,
#research-overlay-conflict-dialog Static,
#research-note-conflict-dialog Button,
#research-note-conflict-dialog Static,
#research-note-switch-dialog Button,
#research-note-switch-dialog Static {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
}

#research-add-source-heading-row,
#research-source-inspector-heading {
    width: $ds-width-full;
    height: $ds-size-1;
}

#research-add-source-title,
#research-source-inspector-title {
    width: $ds-width-fill;
    color: $accent;
    text-style: bold;
}

#research-add-authority {
    width: auto;
    color: $text-muted;
    margin-right: $ds-space-2;
}

#research-add-source-dialog Button,
#research-source-inspector-dialog Button {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
}

/* Unavailable actions remain readable: the surface and adjacent reason text
   convey the state without stacking app and Textual opacity dimmers. */
#research-add-source-dialog Button:disabled,
#research-add-source-dialog Input:disabled,
#research-add-source-dialog Select:disabled,
#research-source-inspector-dialog Button:disabled {
    opacity: 100%;
    text-opacity: 100%;
    color: $text-muted;
    background: $surface-darken-1;
    text-style: none;
}

#research-add-error {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    background: $error 15%;
    color: $text;
}

#research-add-source-tabs {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

.research-add-tab-body,
#research-source-inspector-body {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

.research-add-tab-body Input,
.research-add-tab-body Select,
.research-add-tab-body TextArea,
#research-source-inspector-body Input,
#research-source-inspector-body TextArea {
    width: $ds-width-full;
    min-height: $ds-size-1;
}

.research-add-actions,
.research-add-filters {
    width: $ds-width-full;
    height: auto;
}

.research-add-filters Select {
    width: $ds-width-fill;
}

#research-source-preview-text {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-1;
    background: $surface-darken-1;
}

#research-source-annotation-label {
    margin-top: $ds-space-1;
    color: $accent;
    text-style: bold;
}

/* --- Runs window internal layout ------------------------------------------
 * ResearchWindow's containers had no styles at all: the toolbar/create/body
 * rows fell back to Horizontal's 1fr height and Input/Select's 100% width,
 * so nothing usable rendered. Rows hug their content; the run list + detail
 * body claims the rest.
 */
#research-toolbar,
#research-create-row {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-0;
}

#research-source-select {
    width: $ds-size-16;
}

/* ID subjects, not `<row> Input`: the ancestor-scoped bare-type ratchet
 * (test_textual_css_fastpath, ADR-097) taxes bare-type-subject rules.
 */
#research-query-input,
#research-limits-input,
#research-providers-input {
    width: $ds-width-fill;
}

#research-policy-select {
    width: $ds-size-20;
}

#research-rounds-select {
    width: $ds-size-14;
}

#research-status {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    color: $text-muted;
}

#research-body {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

#research-run-list {
    width: $ds-percent-30;
    min-width: $ds-size-24;
    height: $ds-height-full;
    border-right: solid $surface-lighten-1;
}

#research-detail-panel {
    width: $ds-width-fill;
    height: $ds-height-full;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
    overflow-y: auto;
}

#research-run-actions,
#research-observe-actions,
#research-checkpoint-actions,
#research-followup-row {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-0;
}

#research-artifact-name,
#research-followup-input {
    width: $ds-width-fill;
}

#research-checkpoint-patch {
    height: $ds-size-6;
}

/* ===== MODULE: features/_logs.tcss ===== */
/* ========================================
 * FEATURES: Logs
 * ========================================
 * Logs destination: filter bar, log view, status line, action bar.
 * The user loop: reproduce a problem -> come here -> copy the relevant
 * lines -> share them for investigation. Nothing may occlude log content.
 * ======================================== */

LogsWindow {
    layout: vertical;
}

/* The legacy `.window` class forces `layout: horizontal` (see
 * layout/_windows.tcss); outrank it by id so the Logs destination stays
 * vertical. */
#logs-window {
    layout: vertical;
}

/* Filter bar: level chips + text filter + pause toggle, single row. */
#logs-filter-bar {
    height: 1;
    padding: 0 1;
}

#logs-filter-bar Button {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 1;
    background: $surface;
    color: $text-muted;
}

#logs-filter-bar Button.is-active {
    color: $text;
    text-style: bold underline;
}

#logs-filter-bar Button:hover {
    background: $surface;
    color: $text;
}

#logs-filter-text {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1;
    background: $surface-darken-1;
}

#logs-pause {
    content-align: right middle;
}

/* The log itself takes all remaining space; one entry per row, long
 * lines scroll horizontally instead of wrapping mid-word. */
#app-log-display {
    height: 1fr;
    border: none;
    padding: 0 1;
}

#logs-empty-state {
    color: $text-muted;
    padding: 2;
    height: auto;
}

#logs-status-line {
    height: 1;
    color: $text-muted;
    padding: 0 1;
}

/* Action bar pinned at the bottom: the share actions, always visible,
 * never overlapping log content. */
#logs-action-bar {
    height: auto;
    padding: 0 1;
}

#logs-action-bar Button {
    margin-right: 1;
}

/* ===== MODULE: features/_writing.tcss ===== */
/* ========================================
 * FEATURES: Writing
 * ========================================
 * The legacy `.window` class forces `layout: horizontal` (see
 * layout/_windows.tcss); WritingWindow has no DEFAULT_CSS of its own, so
 * its status line and three-panel layout ended up side-by-side, jammed
 * onto one row. Outrank it by id (same pattern as #logs-window, UX-046).
 * ======================================== */

#writing-window {
    layout: vertical;
}

#writing-status {
    height: auto;
    width: 100%;
}

#writing-layout {
    height: 1fr;
    width: 100%;
}

/* ===== MODULE: features/config_search.tcss ===== */
/* config_search.tcss */
/* Styling for configuration file search functionality */

/* Search container */
.config-search-container {
    width: 100%;
    margin-bottom: 1;
    padding: 1;
    background: $panel;
    border: solid $primary;
}

/* Search input */
.config-search-input {
    width: 100%;
    margin-bottom: 1;
}

/* Search results collapsible */
.config-search-results {
    width: 100%;
    margin-bottom: 1;
}

.config-search-results Collapsible > Contents {
    max-height: 20;
    overflow-y: auto;
}

/* Results list */
.config-results-list {
    width: 100%;
    height: auto;
    max-height: 20;
    background: $surface;
}

/* Individual search result item */
.config-search-result-item {
    width: 100%;
    padding: 1;
    margin-bottom: 0;
}

.config-search-result-item:hover {
    background: $boost;
}

/* Result info section */
.result-info {
    width: 1fr;
    padding-right: 1;
}

.result-path {
    text-style: bold;
    color: $primary;
}

.result-value {
    color: $text;
    margin-top: 0;
}

.result-context {
    color: $text-muted;
    text-style: italic;
    margin-top: 0;
}

/* Result action buttons */
.result-actions {
    dock: right;
    width: auto;
    height: 3;
    align: center middle;
}

.result-goto-btn {
    margin-right: 1;
    min-width: 8;
}

.result-edit-btn {
    min-width: 8;
}

/* Highlight matches in search results */
ConfigSearchResult.-highlight {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

/* Ensure the config editor has proper spacing when search is shown */
#config-text-area {
    height: 1fr;
    min-height: 20;
}

/* Highlight effect for found UI elements */
.search-highlight {
    background: $warning 30%;
    border: solid $warning;
    border-bottom: solid $warning;
}

Input.search-highlight:focus,
TextArea.search-highlight:focus {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    outline: none;
}

Select.search-highlight {
    background: $warning 30%;
}

Checkbox.search-highlight {
    color: $warning;
}

TextArea.search-highlight {
    border: solid $warning;
    border-bottom: solid $warning;
}

/* ===== MODULE: features/feature_alerts.tcss ===== */
/* feature_alerts.tcss */
/* Styling for feature availability alerts */

FeatureNotAvailableDialog {
    width: 70;
    height: auto;
    background: $panel;
    border: thick $warning;
    align: center middle;
    layer: dialog;
    padding: 2 4;
    opacity: 0.98;
}

FeatureNotAvailableDialog > Vertical {
    width: 100%;
    height: auto;
}

FeatureNotAvailableDialog .dialog-title {
    text-align: center;
    color: $warning;
    text-style: bold;
    margin-bottom: 1;
    padding: 1 0;
}

FeatureNotAvailableDialog .dialog-message {
    margin-bottom: 1;
    text-align: center;
    color: $text;
}

FeatureNotAvailableDialog .install-command {
    background: $boost;
    padding: 1 2;
    margin: 1 0;
    border: solid $primary;
    text-align: center;
    color: $text-muted;
}

FeatureNotAvailableDialog .button-container {
    dock: bottom;
    align: center middle;
    height: 3;
    margin-top: 1;
}

FeatureNotAvailableDialog Button {
    margin: 0 1;
    min-width: 12;
}

/* ===== MODULE: features/_pattern_gallery.tcss ===== */
/* ========================================
 * FEATURES: Pattern Gallery (ADR-161)
 * ========================================
 * Layout glue ONLY — no family styling here. The gallery must render the
 * canonical sheets' output, not its own: every family class it composes
 * (form-*, button-group*, .sidebar*, .section-*, .dialog-*, .status-*,
 * .ds-*) keeps the rules its owning module already defines.
 * ======================================== */

#pg-root {
    padding: $ds-space-inset;
}

/* Preview frames: canonical containers with no height rule of their own
   (form-col, bare ListView, status-area) keep Textual's Container default
   of 1fr, which resolves against the scroll root's viewport and balloons
   each preview to full screen height. Explicit frame heights pin the
   previews. Geometry only — no family styling. */
.pg-frame-forms {
    height: 44;
}

.pg-frame-list {
    height: 3;
}

/* 12 rows for the 1fr status-area preview (as before task 8a) + 8 for the
   three status-item demo rows (1+1, 1+1, 3+1 incl. the app-wide `.error`
   chrome on the error state). Geometry only — no family styling. */
.pg-frame-status {
    height: 20;
}

/* Structure preview frame for the dialog vocabulary (not a pushed modal). */
.pg-dialog-frame {
    height: auto;
    border: round $ds-grid-line;
    padding: $ds-space-inset;
}

/* Bounding box for the sidebar preview: `.sidebar` docks left, so it needs
   a definite-height container to dock inside rather than the scroll root.
   28 rows = header 3 + button 3 + toggle 3 + listview 10 + collapsible 6
   plus the button margins. */
.pg-nav-frame {
    height: 28;
}

/* Speaker accents use the same dark/light-mode switch Textual applies to
   the App (no unsuffixed assistant token exists; see core/_variables.tcss). */
.pg-msg-user {
    color: $ds-chat-user-accent;
}

/* ADR-161 task 8c: bounding frame for the shared bubble-grammar preview
   (header 1 + padded body 3 + action strip 3 + the ChatMessage margin
   slot). Geometry only -- the classes render with their owning sheet's
   rules. */
.pg-msg-frame {
    height: 9;
}

.-dark-mode .pg-msg-assistant {
    color: $ds-chat-assistant-accent-dark;
}

.-light-mode .pg-msg-assistant {
    color: $ds-chat-assistant-accent-light;
}

/* ===== MODULE: utilities/_helpers.tcss ===== */
/* ========================================
 * UTILITIES: Helpers
 * ======================================== 
 * Utility classes for common patterns
 * ======================================== */

/* Visibility utilities */
.hidden {
    display: none !important;
}

/* ===== MODULE: utilities/_states.tcss ===== */
/* ========================================
 * UTILITIES: States
 * ======================================== 
 * State modifiers: disabled, hidden, active, etc.
 * ======================================== */

/* --- Utility/Not-Tab Specific --- */

.disabled {
    /* Make the button semi-transparent. This is the most effective way
       to show it's inactive and works just like web CSS. */
    opacity: 0.6;

    /* To achieve a "grayscale" effect, we manually set the colors
       to be less vibrant, using Textual's design tokens for theming. */
    background: $panel-darken-2;
    color: $text-muted;

    /* You can also ensure the border is muted. */
    border: round $primary-darken-2;
}
/* --- End of Utility/Not-Tab Specific --- */

/* ===== MODULE: utilities/_overrides.tcss ===== */
/* ========================================
 * UTILITIES: Overrides
 * ======================================== 
 * Important overrides and edge case fixes
 * ======================================== */

/* TASK-382 / TASK-386: opaque, bordered tooltip surface.
 *
 * Textual's default Tooltip is borderless and fills with $panel, so over the
 * Console header or a provider-test result line it reads as bare text bleeding
 * into the widget underneath (interleaved fragments like "control actions.").
 * A visible border plus an explicit opaque fill turns it into a distinct
 * surface that fully COVERS what it overlaps instead of garbling it. */
Tooltip {
    background: $panel;
    color: $text;
    border: round $primary;
    padding: 0 1;
    max-width: 60;
}
