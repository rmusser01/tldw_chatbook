/* ===== MODULE: features/_media.tcss ===== */













.media-nav-pane {
    dock: left;
    width: auto;
    min-width: $ds-size-20;
    max-width: $ds-size-40;
    background: $boost;
    padding: $ds-space-1;
    border-right: thick $background-darken-1;
    overflow-y: auto;
    overflow-x: hidden;
}

.media-nav-pane.collapsed {
    width: $ds-size-0 !important;
    min-width: $ds-size-0 !important;
    border-right: none !important;
    padding: $ds-space-0 !important;
    overflow: hidden !important;
    display: none !important;
}

.media-nav-pane .media-nav-button {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    border: none;
    height: $ds-size-3;
    text-align: left;
    padding: $ds-space-0 $ds-space-1;
}
.media-nav-pane .media-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}

.media-content-pane {
    padding: $ds-space-0;
    layout: vertical;
    width: $ds-width-fill;
}


.media-content-pane > .media-view-area {
    height: $ds-height-fill;
}

#media-sidebar-toggle-button {
    dock: top;
    height: $ds-size-3;
    width: $ds-size-5;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-1;
}

.media-view-area {
    width: $ds-width-full;
    height: $ds-height-fill;
}





.media-items-list > ListItem {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-0;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}


.media-item-title {
    height: auto;
    text-style: bold;
}

.media-item-snippet {
    height: auto;
    color: $text-muted;
    max-height: $ds-size-2;
    overflow-y: hidden;
}

.media-item-meta {
    height: auto;
    text-style: italic;
    color: $text-disabled;
}


.media-items-list > ListItem > Vertical {
    height: auto;
    width: $ds-width-full;
}


.media-items-list > ListItem > Vertical > * {
    width: $ds-width-full;
}




.media-content-left-pane > Label.pane-title {
    height: auto;
    width: $ds-width-full;
    text-align: center;
    margin-bottom: $ds-space-1;
}
.media-content-left-pane > Input.media-search-input {
    height: $ds-size-3;
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}


.keyword-filter-label {
    height: auto;
    margin-bottom: $ds-space-1;
}

.keyword-filter-input {
    height: $ds-size-3;
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}




.media-pagination-bar {
    height: $ds-size-3;
    width: $ds-width-full;
    align-horizontal: center;
}
.media-pagination-bar Button {
    width: auto;
    min-width: $ds-size-10;
    margin: $ds-space-0 $ds-space-1;
}
.media-pagination-bar .media-page-label {
    width: $ds-width-fill;
    text-align: center;
    padding: $ds-space-0 $ds-space-1;
}



.media-details-theme {
    height: $ds-height-fill;
    width: $ds-width-full;
    overflow-y: auto !important;
    min-height: $ds-size-0;
}


.media-content-right-pane Markdown {
    height: $ds-height-fill !important;
    overflow-y: auto !important;
}


VerticalScroll.media-content-right-pane {
    height: $ds-height-fill !important;
}

VerticalScroll.media-content-right-pane > Markdown {
    height: $ds-height-fill !important;
}


MediaDetailsWidget {
    height: $ds-height-fill;
    width: $ds-width-full;
    layout: vertical;
}

.metadata-section {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-1;
    background: $boost;
    border-bottom: thick $background-darken-1;
}

.metadata-view {
    layout: vertical;
    height: auto;
}

.metadata-section {
    height: auto;
    width: $ds-width-full;
    layout: vertical;
    margin-bottom: $ds-space-1;
}

.metadata-view {
    layout: vertical;
    height: auto;
    width: $ds-width-full;
}

.metadata-display {
    padding: $ds-space-0 $ds-space-1;
    margin-bottom: $ds-space-0;
    height: auto;
}

.metadata-edit {
    layout: vertical;
    padding: $ds-space-1;
    height: auto;
    min-height: $ds-size-30;
}

.edit-fields {
    layout: vertical;
    margin-bottom: $ds-space-1;
}

.edit-fields Label {
    margin-top: $ds-space-0;
    margin-bottom: $ds-space-0;
    text-style: bold;
    height: $ds-size-1;
}

.edit-fields Input {
    width: $ds-width-full;
    margin-bottom: $ds-space-0;
    height: $ds-size-3;
}

.edit-fields Input:disabled {
    opacity: 0.6;
    background: $boost-darken-1;
}


.formatting-options {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    margin-bottom: $ds-space-1;
    layout: horizontal;
    align: center middle;
}

.format-reading-checkbox {
    width: auto;
    height: $ds-size-3;
    padding: $ds-space-0 $ds-space-1;
}

.format-reading-checkbox:hover {
    background: $boost;
}

.edit-actions {
    layout: horizontal;
    height: auto;
    align: left top;
    margin-top: $ds-space-1;
}

.edit-actions Button {
    margin-right: $ds-space-1;
    min-width: $ds-size-10;
}

.media-content-display {
    height: $ds-height-fill;
    width: $ds-width-full;
    padding: $ds-space-1;
}


.content-search-section {
    width: $ds-width-full;
    padding: $ds-space-1;
    background: $boost;
    border-bottom: solid $primary-background;
}

.search-controls {
    layout: horizontal;
    align: center middle;
    height: $ds-size-3;
}

.content-search-input {
    width: $ds-width-fill;
    margin-right: $ds-space-1;
}

.content-search-button {
    width: $ds-size-4;
    min-width: $ds-size-4;
    margin-right: $ds-space-1;
}

.content-search-nav {
    width: $ds-size-3;
    min-width: $ds-size-3;
    margin-right: $ds-space-1;
}

.content-search-status {
    width: auto;
    color: $text-muted;
    text-style: italic;
}


.deleted-media-item {
    opacity: 0.6;
}

.deleted-media-item:hover {
    opacity: 0.8;
}

.media-item-deleted {
    color: $text-disabled;
    text-style: strike;
}

.media-item-title.media-item-deleted {
    color: $error;
    text-style: strike;
}


.show-deleted-checkbox {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    height: auto;
}


.metadata-buttons {
    layout: horizontal;
    height: $ds-size-3;
    width: $ds-width-full;
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
}

.metadata-edit-button {
    width: auto;
    min-width: $ds-size-10;
    dock: left;
}

.metadata-delete-button {
    width: auto;
    min-width: $ds-size-10;
    dock: right;
}


.hidden {
    display: none;
}


.collections-main-container {
    layout: horizontal;
    width: $ds-width-full;
}

.collections-left-pane {
    width: $ds-percent-40;
    min-width: $ds-size-30;
    layout: vertical;
    padding: $ds-space-1;
    border-right: thick $background-darken-1;
}

.collections-right-pane {
    width: $ds-width-fill;
    padding: $ds-space-1;
    overflow-y: auto;
}

.keyword-list {
    height: $ds-height-fill;
    border: round $primary-lighten-2;
    background: $primary-background;
    overflow-y: auto;
}

.keyword-list .keyword-item {
    padding: $ds-space-1;
    margin-bottom: $ds-space-0;
}

.keyword-list .keyword-item.selected,
.keyword-list .keyword-item.selected:hover {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.keyword-list .keyword-item:hover {
    background: $surface-lighten-1;
    color: $text;
}

.keyword-action-buttons {
    layout: horizontal;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

.keyword-action-buttons Button {
    width: $ds-width-fill;
    margin-right: $ds-space-1;
}

.action-buttons-container {
    layout: vertical;
    margin-bottom: $ds-space-2;
}

.action-buttons-container Button {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

.selection-info {
    padding: $ds-space-1;
    background: $boost;
    margin-bottom: $ds-space-1;
    text-align: center;
}

.keyword-details, .usage-stats {
    padding: $ds-space-1;
    background: $boost;
    margin-top: $ds-space-1;
    min-height: $ds-size-10;
}


#rename-dialog-container, #merge-dialog-container {
    align: center middle;
    width: $ds-size-50;
    min-height: $ds-size-10;
    padding: $ds-space-2;
    background: $surface;
    border: thick $primary;
}

#rename-title, #merge-title {
    text-align: center;
    text-style: bold;
    margin-bottom: $ds-space-1;
}

#merge-instruction {
    text-align: center;
    margin-bottom: $ds-space-1;
    color: $text-muted;
}

#new-keyword-input, #new-target-input {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

#target-keyword-list {
    height: $ds-size-15;
    margin-bottom: $ds-space-1;
    border: round $primary-lighten-2;
    background: $primary-background;
}

#rename-buttons, #merge-buttons {
    layout: horizontal;
    height: $ds-size-3;
    align: center middle;
}

#rename-buttons Button, #merge-buttons Button {
    margin: $ds-space-0 $ds-space-1;
    min-width: $ds-size-12;
}


.multi-review-container {
    width: $ds-width-full;
    padding: $ds-space-1;
}

.selection-section, .items-section, .analysis-section {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    padding: $ds-space-1;
    background: $boost;
}

.selection-section {
    height: auto;
    min-height: $ds-size-15;
}

.items-section {
    height: auto;
    min-height: $ds-size-20;
    max-height: $ds-size-40;
}

.analysis-section {
    height: auto;
    min-height: $ds-size-30;
}

.search-controls, .tag-filter-section, .selection-controls {
    layout: horizontal;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

.search-controls Input {
    width: $ds-width-fill;
    margin-right: $ds-space-1;
}

.tag-filter-section Label {
    width: auto;
    margin-right: $ds-space-1;
}

.tag-input {
    width: $ds-width-fill;
}

.selection-controls Button {
    margin-right: $ds-space-1;
}

.selection-info {
    width: auto;
    padding: $ds-space-0 $ds-space-1;
}

.review-items-list {
    height: $ds-height-fill;
    border: round $primary-lighten-2;
    background: $primary-background;
    overflow-y: auto;
}

.review-items-list .review-item {
    padding: $ds-space-1;
    margin-bottom: $ds-space-0;
}

.review-items-list .review-item.selected,
.review-items-list .review-item.selected:hover {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.review-items-list .review-item:hover {
    background: $surface-lighten-1;
    color: $text;
}

.item-title {
    text-style: bold;
    color: $text;
}

.item-meta {
    color: $text-muted;
    text-style: italic;
}

.analysis-prompt {
    width: $ds-width-full;
    height: $ds-size-10;
    margin-bottom: $ds-space-1;
}

.analysis-controls {
    layout: horizontal;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

.analysis-controls Checkbox {
    width: auto;
    margin-right: $ds-space-2;
}

.analysis-controls Button {
    margin-right: $ds-space-1;
    min-width: $ds-size-15;
}

.analysis-progress {
    width: $ds-width-full;
    height: $ds-size-1;
    margin-bottom: $ds-space-1;
}

.progress-label {
    text-align: center;
    margin-bottom: $ds-space-1;
    color: $text-muted;
}

.results-container {
    height: $ds-height-fill;
    background: $primary-background;
    padding: $ds-space-1;
}

.analysis-results {
    layout: vertical;
    width: $ds-width-full;
}

.analysis-result-card {
    width: $ds-width-full;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
    background: $boost;
    border: round $primary-lighten-2;
}

.result-header {
    layout: horizontal;
    height: auto;
    margin-bottom: $ds-space-1;
}

.result-title {
    width: $ds-width-fill;
    text-style: bold;
}

.result-meta {
    color: $text-muted;
    margin-bottom: $ds-space-1;
}

.result-content {
    padding: $ds-space-1;
    max-height: $ds-size-20;
    overflow-y: auto;
}

.result-separator {
    text-align: center;
    color: $text-disabled;
    margin-top: $ds-space-1;
}


#delete-dialog {
    layout: vertical;
    padding: $ds-space-2;
}

.dialog-subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: $ds-space-1;
}

.dialog-message {
    text-align: center;
    margin-bottom: $ds-space-2;
}



/* ===== MODULE: features/_llm-management.tcss ===== */





#llamacpp-snapshot-manager {
    height: auto;
    width: $ds-width-full;
    margin-top: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    background: $panel;
}

#llamacpp-snapshot-manager .section-title,
#llamacpp-snapshot-manager .snapshot-copy,
#llamacpp-snapshot-manager .snapshot-keep-label,
#snapshot-retention,
#snapshot-operation-status,
#snapshot-disabled-reason,
#snapshot-details,
#snapshot-preferences-result,
#snapshot-enabled,
#settings-snapshot-enabled,
#settings-snapshot-controls CollapsibleTitle,
#llamacpp-snapshot-manager CollapsibleTitle,
#settings-snapshot-controls .settings-help-copy,
#settings-snapshot-controls .settings-input-label {
    height: auto;
    text-wrap: wrap;
}

#llamacpp-snapshot-manager .snapshot-actions {
    height: $ds-size-3;
    width: $ds-width-full;
}

#llamacpp-snapshot-manager #snapshot-save,
#llamacpp-snapshot-manager #snapshot-restore,
#llamacpp-snapshot-manager #snapshot-delete,
#llamacpp-snapshot-manager #snapshot-refresh,
#llamacpp-snapshot-manager #snapshot-previous,
#llamacpp-snapshot-manager #snapshot-next,
#llamacpp-snapshot-manager #snapshot-apply,
#llamacpp-snapshot-manager #snapshot-reload {
    min-width: $ds-size-8;
    width: $ds-width-fill;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    text-wrap: nowrap;
    height: $ds-size-3;
    min-height: $ds-size-3;
    max-height: $ds-size-3;
}

#llamacpp-snapshot-manager #snapshot-save:disabled,
#llamacpp-snapshot-manager #snapshot-restore:disabled,
#llamacpp-snapshot-manager #snapshot-delete:disabled,
#llamacpp-snapshot-manager #snapshot-refresh:disabled,
#llamacpp-snapshot-manager #snapshot-previous:disabled,
#llamacpp-snapshot-manager #snapshot-next:disabled,
#llamacpp-snapshot-manager #snapshot-apply:disabled,
#llamacpp-snapshot-manager #snapshot-reload:disabled {
    border: none;
}

#snapshot-slots,
#snapshot-records {
    height: $ds-size-5;
    width: $ds-width-full;
}

#snapshot-disabled-reason,
#snapshot-operation-status,
#settings-snapshot-result {
    color: $warning;
}

#llamacpp-snapshot-manager .snapshot-copy {
    color: $text-muted;
}

#snapshot-retention {
    text-style: bold;
}

#snapshot-keep,
#settings-snapshot-keep {
    width: $ds-size-8;
}

#llamacpp-snapshot-manager .snapshot-keep-label {
    width: $ds-size-12;
}

#settings-snapshot-controls {
    height: auto;
    margin-bottom: $ds-space-1;
}

.gguf-source-mode-row {
    layout: horizontal;
    width: $ds-width-full;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

.gguf-source-label {
    width: $ds-size-18;
    height: $ds-size-3;
    content-align: right middle;
    padding-right: $ds-space-1;
}

.gguf-source-mode {
    width: $ds-width-fill;
    min-width: $ds-size-12;
    height: $ds-size-3;
}

.gguf-source-region {
    display: none;
    width: $ds-width-full;
    height: auto;
    margin-bottom: $ds-space-1;
}

.gguf-source-region.-active {
    display: block;
}

.gguf-source-choice-row {
    layout: horizontal;
    width: $ds-width-full;
    height: $ds-size-3;
}

.gguf-source-choice-row Input,
.gguf-source-managed-select {
    width: $ds-width-fill;
    min-width: $ds-size-8;
    height: $ds-size-3;
}

.gguf-source-refresh,
.gguf-source-browse {
    width: auto;
    margin-left: $ds-space-1;
}

.gguf-source-authority,
.gguf-source-copy,
.gguf-source-status {
    width: $ds-width-full;
    height: auto;
    text-wrap: wrap;
}

.gguf-source-authority {
    color: $warning;
    text-style: bold;
}

.gguf-source-copy,
.gguf-source-status {
    color: $text-muted;
}

.gguf-source-status {
    margin-bottom: $ds-space-1;
}

.gguf-source-narrow .gguf-source-choice-row {
    layout: vertical;
    height: $ds-size-6;
}

.gguf-source-narrow .gguf-source-refresh,
.gguf-source-narrow .gguf-source-browse {
    width: $ds-width-full;
    margin-left: $ds-space-0;
}


#llm-view-llama-cpp Button:disabled,
#llm-view-llama-cpp Input:disabled,
#llm-view-llama-cpp Select:disabled,
#llm-view-llamafile Button:disabled,
#llm-view-llamafile Input:disabled,
#llm-view-llamafile Select:disabled {
    opacity: 100%;
    text-opacity: 100%;
    color: $text;
    background: $surface-darken-1;
}

#llm-view-llama-cpp Button:disabled,
#llm-view-llama-cpp Input:disabled,
#llm-view-llamafile Button:disabled,
#llm-view-llamafile Input:disabled {
    border: dashed $foreground;
}

#llm-view-llama-cpp Select:disabled > SelectCurrent,
#llm-view-llama-cpp Select:disabled > SelectCurrent Static#label,
#llm-view-llama-cpp Select:disabled > SelectCurrent .arrow,
#llm-view-llamafile Select:disabled > SelectCurrent,
#llm-view-llamafile Select:disabled > SelectCurrent Static#label,
#llm-view-llamafile Select:disabled > SelectCurrent .arrow {
    opacity: 100%;
    text-opacity: 100%;
    color: $text;
    background: $surface-darken-1;
}

#llm-view-llama-cpp Select:disabled > SelectCurrent,
#llm-view-llamafile Select:disabled > SelectCurrent {
    border: dashed $foreground !important;
}

#llm_management-window {
    layout: horizontal;
}

.llm-nav-pane {
    dock: left;
    width: auto;
    min-width: $ds-size-25;
    max-width: $ds-size-60;
    height: $ds-height-full;
    background: $boost;
    padding: $ds-space-1;
    border-right: thick $background-darken-1;
    overflow-y: auto;
    overflow-x: hidden;
}

.llm-nav-pane .llm-nav-button {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    border: none;
    height: $ds-size-3;
    text-align: left;
    padding: $ds-space-0 $ds-space-1;
}
.llm-nav-pane .llm-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}

.llm-nav-pane .llm-nav-button.-active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.llm-content-pane {
    width: $ds-width-fill;
    height: $ds-height-full;
    padding: $ds-space-1 $ds-space-2;
    overflow-y: auto;
}

.llm-view-area {
    width: $ds-width-full;
    height: $ds-height-full;
    display: none;
}


#llm_management-window .llm-view-area > VerticalScroll {
    height: $ds-height-full;
}

#llamacpp-args-help-collapsible,
#llamafile-args-help-collapsible,
#vllm-args-help-collapsible {
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
    border: round $primary-lighten-1;
}

#llamacpp-args-help-collapsible > .collapsible--header,
#llamafile-args-help-collapsible > .collapsible--header,
#vllm-args-help-collapsible > .collapsible--header {
    background: $surface-darken-1;
}

.help-text-display {
    height: $ds-size-25;
    width: $ds-width-full;
    border: round $surface;
    padding: $ds-space-1;
    margin-top: $ds-space-1;
    background: $panel;
    overflow-y: scroll !important;
}



#llamacpp-additional-args,
#llamafile-additional-args,
#vllm-additional-args {
    height: $ds-size-3;




}


#llm-view-llama-cpp .log_output,
#llm-view-llamafile .log_output {
    width: $ds-width-full;
    height: $ds-size-15;
    min-height: $ds-size-10;
    max-height: $ds-size-20;
    border: panel $primary-darken-2;
    background: $background-darken-1;
    margin-top: $ds-space-1;
    overflow-y: auto;
}


.input_container {
    layout: horizontal;
    height: auto;
    margin-bottom: $ds-space-1;
}
.input_container Input {
    width: $ds-width-fill;
    margin-right: $ds-space-1;
}
.input_container .browse_button {
    width: auto;
    height: $ds-height-full;
}

.button_container {
    layout: horizontal;
    height: auto;
    margin-top: $ds-space-1;
}
.button_container Button {
    margin-left: $ds-space-1;
}

#llm-view-ollama {
    layout: vertical;

}
#llm-view-ollama VerticalScroll {
    height: $ds-height-full;
}

#llm-view-ollama .label {
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-0;
    text-style: bold;
}
#llm-view-ollama .section_label {
    margin-top: $ds-space-2;
    padding: $ds-space-0;

    text-align: left;
    width: $ds-width-full;
}

#llm-view-ollama .input_field,
#llm-view-ollama .input_field_short,
#llm-view-ollama .input_field_long {
    margin-bottom: $ds-space-1;
}
#llm-view-ollama .input_field_long {
    width: $ds-width-full;
}

#llm-view-ollama .input_action_container {
    layout: horizontal;
    height: auto;
    margin-bottom: $ds-space-0;
}
#llm-view-ollama .input_action_container .input_field_short {
    width: $ds-width-fill;
    margin-right: $ds-space-1;
    margin-bottom: $ds-space-0;
}
#llm-view-ollama .input_action_container .action_button_short {
    width: auto;
    min-width: $ds-size-10;
    height: $ds-size-3;
}
#llm-view-ollama .input_action_container .browse_button_short {
    width: auto;
    min-width: $ds-size-15;
    height: $ds-size-3;
}

#llm-view-ollama .action_container {
    width: $ds-width-full;
    height: auto;
    margin-bottom: $ds-space-0;
}
#llm-view-ollama .action_button {
    width: $ds-width-full;
    margin-top: $ds-space-1;
}
#llm-view-ollama .full_width_button {
    width: $ds-width-full;
    margin-top: $ds-space-1;
}

#llm-view-ollama .delete_button Button {
    background: $error-darken-1;
    color: $text;
}
#llm-view-ollama .delete_button Button:hover {
    background: $error;
}


.ollama-status-textarea {
    width: $ds-width-full;
    height: $ds-size-3;
    border: round $primary-darken-1;
    background: $surface;
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    color: $text-muted;
}


#llm-view-ollama .output_textarea_medium {
    width: $ds-width-full;
    height: $ds-size-25;
    border: round $primary;
    background: $panel;
    margin-bottom: $ds-space-1;
}
#llm-view-ollama .output_textarea_small {
    width: $ds-width-full;
    height: $ds-size-6;
    border: round $primary;
    background: $panel;
    margin-bottom: $ds-space-1;
}


#llm-view-ollama .log_output_large {
    width: $ds-width-full;
    height: $ds-size-10;
    border: panel $primary-darken-2;
    background: $background-darken-1;
}


.ollama-spacer {
    height: $ds-size-1;
    width: $ds-width-full;
}


.ollama-button-bar {
    layout: horizontal;
    height: auto;
    width: $ds-width-full;
    margin: $ds-space-1 $ds-space-0;
    align-horizontal: center;
}
.ollama-button-bar Button {
    width: $ds-width-fill;
    margin: $ds-space-0 $ds-space-1;
}

.ollama-actions-grid {
    layout: horizontal;
    height: auto;
    align-vertical: top;
    margin-bottom: $ds-space-1;
}

.ollama-actions-column {
    layout: vertical;
    width: $ds-width-fill;
    height: auto;
    padding: $ds-space-1;
    border: round $panel-lighten-1;
    margin: $ds-space-0 $ds-space-1;
}
.ollama-actions-column:first-of-type {
    margin-left: $ds-space-0;
}
.ollama-actions-column:last-of-type {
    margin-right: $ds-space-0;
}

.column-title {
    text-style: bold underline;
    width: $ds-width-full;
    text-align: center;
    margin-bottom: $ds-space-1;
}


.ollama-actions-column .input_action_container {
    margin-bottom: $ds-space-1;
}
.ollama-actions-column .full_width_button {
    margin-top: $ds-space-0;
}



/* ===== MODULE: features/_tools-settings.tcss ===== */





#tools_settings-window {
    layout: horizontal;
}

.tools-nav-pane {
    dock: left;
    width: auto;
    min-width: $ds-size-25;
    max-width: $ds-size-60;
    height: $ds-height-full;
    background: $boost;
    padding: $ds-space-1;
    border-right: thick $background-darken-1;
    overflow-y: auto;
    overflow-x: hidden;
}

.tools-nav-pane .ts-nav-button {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    border: none;
    height: $ds-size-3;
}
.tools-nav-pane .ts-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}

.tools-nav-pane .ts-nav-button.active-nav {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.tools-content-pane {
    width: $ds-width-fill;
    height: $ds-height-full;
    padding: $ds-space-1 $ds-space-2;
    overflow-y: auto;
}


.tools-content-pane ContentSwitcher {
    height: $ds-height-full;
    width: $ds-width-full;
}

.ts-view-area {
    width: $ds-width-full;
    height: $ds-height-full;
    overflow-y: auto;
    overflow-x: hidden;

}

.config-file-settings-container {
    height: $ds-height-full;
    width: $ds-width-full;
    overflow-y: auto;
    overflow-x: hidden;
}


.config-file-settings-container TabbedContent {
    height: $ds-height-full;
    width: $ds-width-full;
}

.config-file-settings-container TabPane {
    height: $ds-height-full;
    width: $ds-width-full;
}


#config-tabs {
    height: $ds-height-full;
    width: $ds-width-full;
    min-height: $ds-size-30;
}


.config-file-settings-inner {
    height: $ds-height-full;
    width: $ds-width-full;
    layout: vertical;
}


.section-description {
    color: $text-muted;
    margin-bottom: $ds-space-2;
    text-align: center;
    text-style: italic;
    height: auto;
}

.settings-group {
    margin-bottom: $ds-space-2;
    padding: $ds-space-1;
    background: $surface;
    border: round $primary-background;
    height: auto;
}

.settings-select, .settings-input {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    min-height: $ds-size-3;
    height: auto;
}

.checkbox-group {
    margin-bottom: $ds-space-1;
}

.warning-text {
    color: $warning;
    margin-bottom: $ds-space-1;
    text-style: italic;
}

.settings-actions {
    margin-top: $ds-space-2;
    layout: horizontal;
    height: auto;
    align: center middle;
}

.settings-actions Button {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}


.config-file-settings-container {
    height: $ds-height-full;
    width: $ds-width-full;
}

.config-editor {
    height: $ds-size-20;
    min-height: $ds-size-20;
    border: round $primary;
    background: $panel;
    margin-bottom: $ds-space-1;
}

.config-button-container {
    layout: horizontal;
    height: auto;
    margin-top: $ds-space-1;
    align: center middle;
}

.config-button-container Button {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

.tab-description {
    color: $text-muted;
    margin-bottom: $ds-space-1;
    text-style: italic;
}


.core-settings-container {
    padding: $ds-space-1 $ds-space-2;
    width: $ds-width-full;
    height: $ds-height-full;
}

.settings-group {
    background: $surface;
    padding: $ds-space-1;
    margin-bottom: $ds-space-2;
    border: round $primary-background;
}

.settings-input {
    width: $ds-width-full;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.settings-select {
    width: $ds-width-full;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.settings-subsection-title {
    color: $text;
    text-style: bold;
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
}

.settings-note {
    color: $text-muted;
    text-style: italic;
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
}

.checkbox-group {
    layout: horizontal;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.checkbox-group Checkbox {
    margin-right: $ds-space-2;
}

.settings-actions {
    layout: horizontal;
    margin-top: $ds-space-2;
    align: center middle;
}

.settings-actions Button {
    margin: $ds-space-0 $ds-space-1;
    min-width: $ds-size-15;
}




.config-form {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-1 $ds-space-2;
    overflow-y: auto;
}



.form-description {
    color: $text-muted;
    margin-bottom: $ds-space-2;
    text-style: italic;
}

.form-subsection-title {
    text-style: bold;
    color: $secondary;
    margin: $ds-space-1 $ds-space-0 $ds-space-1 $ds-space-0;
}

.form-actions Button {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    min-width: $ds-size-15;
}


.config-form TextArea {
    width: $ds-width-full;
    height: $ds-size-10;
    margin-bottom: $ds-space-1;
    border: round $primary;
    background: $panel;
}

.system-prompt-textarea {
    height: $ds-size-15;
}

.provider-models-textarea {
    height: $ds-size-5;
}


.config-form Collapsible {
    margin-bottom: $ds-space-1;
    border: round $primary-background;
    background: $surface;
}

.config-form Collapsible > CollapsibleTitle {
    background: $boost;
    padding: $ds-space-0 $ds-space-1;
}


.help-text {
    color: $text-muted;
    margin-bottom: $ds-space-1;
    text-style: italic;
}


.db-status {
    color: $text-muted;
    margin-bottom: $ds-space-1;
}

/* ===== MODULE: features/_ingest.tcss ===== */





#ingest-window {
    layout: vertical !important;
    height: $ds-height-full;
    width: $ds-width-full;
}


#ingest-window.window {
    layout: vertical !important;
}
.tldw-api-media-specific-options {
    padding: $ds-space-1;
    border: round $surface;
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
}


.tldw-api-media-specific-options.hidden {
     display: none;
}

.ingest-nav-pane {
    dock: left;
    width: $ds-percent-25;
    min-width: $ds-size-20;
    max-width: $ds-size-40;
    height: $ds-height-full;
    background: $boost;
    padding: $ds-space-1;
    border-right: thick $background-darken-1;

}

.ingest-nav-pane .ingest-nav-button {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    border: none;
    height: $ds-size-3;
}
.ingest-nav-pane .ingest-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}

.ingest-nav-pane .ingest-nav-button.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}


.ingest-nav-pane.collapsed {
    width: $ds-size-4;
    min-width: $ds-size-4;
    padding: $ds-space-1 $ds-space-0;
}

.nav-header {
    width: $ds-width-full;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

.nav-toggle-button {
    width: $ds-size-3;
    height: $ds-size-3;
    min-width: $ds-size-3;
    padding: $ds-space-0;
    text-align: center;
}


.ingest-nav-pane.collapsed .ingest-nav-button {
    width: $ds-size-3;
    padding: $ds-space-0;

    overflow: hidden;
}


.ingest-nav-pane .sidebar-title {
    text-style: bold;
    color: $primary;
    margin-top: $ds-space-2;
    margin-bottom: $ds-space-1;
    padding-left: $ds-space-1;
    border-left: thick $accent;
}



.ingest-content-pane {
    width: $ds-width-fill;
    height: $ds-height-full;
    padding: $ds-space-1 $ds-space-2;

}

.ingest-view-area {
    width: $ds-width-full;
    height: $ds-height-full;
}
.ingest-label {
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-0;
}
.ingest-selected-files-list {
    min-height: $ds-size-5;
    max-height: $ds-size-10;
    height: auto;
    border: round $ds-focus-accent;
    margin-bottom: $ds-space-1;
    background: $surface;
}
.LocalIngestionPanel .file-selection-container {
    height: $ds-height-fill;
    min-height: $ds-size-15;
    border: solid $primary;
    margin-bottom: $ds-space-1;
    padding: $ds-space-1;
}
.ingest-preview-area {
    height: $ds-height-fill;
    min-height: $ds-size-10;
    border: round $primary-lighten-2;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
    background: $surface;
}
.ingest-preview-area > Static#ingest-prompts-preview-placeholder {
    color: $text-muted;
    width: $ds-width-full;
    text-align: center;
    padding: $ds-space-2 $ds-space-0;
}
.ingest-status-area {
    min-height: $ds-size-5;
    max-height: $ds-size-15;
    height: auto;
    margin-top: $ds-space-1;
}

.prompt-preview-item {
    border: panel $background-lighten-2;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
}
.prompt-preview-item .prompt-title {
    text-style: bold;
}
.prompt-preview-item .prompt-field-label {
    text-style: italic;
    color: $text-muted;
}
.prompt-preview-item Markdown {
    background: $surface-darken-1;
    padding: $ds-space-0 $ds-space-1;
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
    border: solid $primary-darken-1;
    max-height: $ds-size-10;
    overflow-y: auto;
}
.prompt-preview-item .prompt-details-text {
    max-height: $ds-size-5;
    overflow-y: auto;
    background: $surface;
    padding: $ds-space-0 $ds-space-1;
    border: dashed $primary-darken-2;
    margin-bottom: $ds-space-1;
}


.ingest-view-area VerticalScroll {
    height: $ds-height-fill;
    width: $ds-width-full;
}


VerticalScroll.ingest-view-area {
    height: $ds-height-fill;
    width: $ds-width-full;
}

VerticalScroll.ingest-form-scrollable {
    height: $ds-height-fill;
    width: $ds-width-full;
}


.ingest-form-scrollable {
    height: $ds-height-full;
    overflow-y: auto;
    padding: $ds-space-1;
}






.ingest-form-row {
    margin-top: $ds-space-1;
}

.ingest-form-col {
    width: $ds-percent-50;
    padding-right: $ds-space-1;
}

.title-author-row {
    margin-bottom: $ds-space-1;
}


.title-author-row Input {
    height: $ds-size-3;
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}

.ingest-textarea-small {
    min-height: $ds-size-3;
    max-height: $ds-size-8;
    height: auto;
    margin-bottom: $ds-space-1;
}

.ingest-textarea-medium {
    min-height: $ds-size-10;
    max-height: $ds-size-20;
    height: auto;
    margin-bottom: $ds-space-1;
}



.ingest-view-area {

    height: $ds-height-full;
    width: $ds-width-full;
}






IngestWindowTabbed {
    height: $ds-height-fill;
    width: $ds-width-full;
    layout: vertical;
}


#ingest-window TabbedContent {
    height: $ds-height-fill;
    width: $ds-width-full;
}

.media-tab-container {
    height: $ds-height-fill;
    padding: $ds-space-1;
}

.source-toggle-container {
    dock: top;
    height: auto;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
    border-bottom: solid $primary;
}

.tab-title {
    text-style: bold;

    margin-bottom: $ds-space-1;
}

.source-toggle {
    layout: horizontal;
    height: auto;
    margin-top: $ds-space-1;
}

.source-toggle RadioButton {
    margin-right: $ds-space-2;
}

.source-content {
    height: $ds-height-fill;
    width: $ds-width-full;
    overflow-y: auto;
}


.ingest-form-scrollable {
    height: $ds-height-fill;
    width: $ds-width-full;
}




.source-content.hidden {
    display: none;
}


.ingest-selected-files-list {
    min-height: $ds-size-3;
    max-height: $ds-size-8;
    height: auto;
    border: round $ds-focus-accent;
    margin-bottom: $ds-space-1;
    background: $surface;
}


.status-dashboard {
    width: $ds-width-full;
    height: auto;
    max-height: $ds-size-8;
    min-height: $ds-size-3;
    background: $surface;
    border: round $primary;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
}


.simple-mode .advanced-only {
    display: none !important;
}

.advanced-mode .advanced-only {
    display: block !important;
}


.url-input-section {
    display: block;
    margin-top: $ds-space-1;
    padding: $ds-space-1;
    border: round $primary;
    background: $surface;
}


.essential-fields {
    border: round $accent;
    padding: $ds-space-1;
    margin-bottom: $ds-space-2;
    background: $surface-lighten-1;
}


.placeholder-text {
    color: $text-muted;
    text-align: center;
    padding: $ds-size-4;
}


.mode-toggle-container {
    dock: top;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
}

.mode-toggle {
    layout: horizontal;
    height: auto;
}

.mode-toggle RadioButton {
    margin-right: $ds-space-2;
}


.file-selection-row {
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

.file-selection-row Button {
    margin-right: $ds-space-1;
}


.file-list-with-metadata {
    min-height: $ds-size-5;
    max-height: $ds-size-10;
    border: round $primary;
    background: $surface;
}


.metadata-row {
    margin-top: $ds-space-1;
    margin-bottom: $ds-space-1;
}

.metadata-col {
    width: $ds-percent-50;
    padding-right: $ds-space-1;
}


.process-button {
    width: $ds-width-full;
    height: $ds-size-4;
    margin-top: $ds-space-2;
    text-style: bold;
}


.advanced-options-container {
    margin-top: $ds-space-1;
}

.advanced-options-container.hidden {
    display: none;
}


.time-range-row {
    margin-top: $ds-space-1;
}

.time-col {
    width: $ds-percent-50;
    padding-right: $ds-space-1;
}


.chunk-settings-row {
    margin-top: $ds-space-1;
}

.chunk-col {
    width: $ds-percent-50;
    padding-right: $ds-space-1;
}


.status-dashboard-container {
    border: round $primary;
    background: $surface;
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
}

.status-main-row {
    height: $ds-size-3;
    align: left middle;
}

.status-message {
    width: $ds-width-fill;
    text-style: bold;
}

.file-counter {
    width: auto;
    margin-left: $ds-space-2;
    color: $text-muted;
}

.time-display {
    width: auto;
    margin-left: $ds-space-2;
    color: $text-muted;
}

.action-buttons {
    width: auto;
    dock: right;
    layout: horizontal;
}

.action-buttons.hidden {
    display: none;
}

.small-button {
    height: $ds-size-3;
    min-width: $ds-size-8;
    margin-left: $ds-space-1;
}

.small-button.hidden {
    display: none;
}


.status-dashboard-container ProgressBar {
    margin-top: $ds-space-1;
    height: $ds-size-1;
}

.status-dashboard-container ProgressBar.hidden {
    display: none;
}


.alert-container {
    margin-top: $ds-space-1;
    padding: $ds-space-1;
    border: round $error;
    background: $error 10%;
}

.alert-container.hidden {
    display: none;
}

.alert-messages {
    color: $text;
    max-height: $ds-size-6;
    overflow-y: auto;
}


.file-list-enhanced {
    border: round $primary;
    background: $surface;
    padding: $ds-space-0;
}

.file-items-container {
    max-height: $ds-size-10;
    overflow-y: auto;
    padding: $ds-space-1;
}

.file-list-item-container {
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
    border: round $surface-lighten-2;
    background: $surface-lighten-1;
    height: auto;
}

.file-list-item-container:hover {
    background: $surface-lighten-2;
    border: round $primary;
}

.file-info-main {
    width: $ds-width-fill;
}

.file-name-row {
    height: auto;
    margin-bottom: $ds-space-0;
}

.file-icon {
    width: $ds-size-3;
    text-align: center;
}

.file-name {
    width: $ds-width-fill;
    text-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
}

.file-metadata {
    color: $text-muted;

    margin-left: $ds-space-3;
}

.file-remove-button {
    width: $ds-size-3;
    height: $ds-size-3;
    min-width: $ds-size-3;
    margin: $ds-space-0;
    padding: $ds-space-0;
    text-align: center;
}

.no-files-message {
    text-align: center;
    color: $text-muted;
    padding: $ds-space-3;
}

.file-list-summary {
    dock: bottom;
    height: $ds-size-3;
    padding: $ds-space-1;
    border-top: solid $primary;
    background: $surface-darken-1;
    text-align: center;
    color: $text-muted;
}



/* ===== MODULE: features/_evaluation_unified.tcss ===== */





.dashboard-title {
    text-style: bold;
    color: $primary;
    margin-bottom: $ds-space-1;
}

.quick-actions {
    layout: horizontal;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}


.drop-zone {
    layout: horizontal;
    height: $ds-size-3;
    background: $panel;
    border: dashed $primary;
    padding: $ds-space-0 $ds-space-2;
    align: center middle;
    margin: $ds-space-1 $ds-space-0;
}

.drop-zone:hover {
    background: $boost;
    border: solid $primary;
}



.main-content {
    padding: $ds-space-1;
}




EvalsWindow {
    height: $ds-height-full;
}


Collapsible {
    margin-bottom: $ds-space-1;
    border: tall $surface;
    background: $panel;
}

Collapsible > Container {
    padding: $ds-space-1;
}

Collapsible.-collapsed {
    margin-bottom: $ds-space-1;
}




.template-grid {
    layout: grid;
    grid-columns: 1fr 1fr;
    grid-gutter: 1;
    margin-top: $ds-space-1;
}

.template-card {
    height: $ds-size-5;
    padding: $ds-space-1;
    background: $surface;
    border: tall $primary;
    text-align: center;
}

.template-card:hover {
    background: $boost;
    border: thick $primary;
}


.action-bar {
    layout: horizontal;
    background: $surface;
    padding: $ds-space-1;
    margin: $ds-space-2 $ds-space-0;
    border: tall $primary;
    align: center middle;
}


.results-header {
    layout: horizontal;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
    align: left middle;
}

.results-header Static {
    width: $ds-width-fill;
}

.results-header Select {
    width: $ds-size-20;
}

.results-list {
    height: $ds-size-15;
    background: $surface;
    border: tall $secondary;
    margin-bottom: $ds-space-2;
}

.stat-card {
    background: $surface;
    padding: $ds-space-1;
    border: tall $secondary;
    text-align: center;
}

.stat-value {
    text-style: bold;
    color: $primary;
}

.button-row {
    layout: horizontal;
    margin-bottom: $ds-space-1;
}

.button-row Button {
    margin-right: $ds-space-1;
}


.status-bar {
    height: $ds-size-3;
    background: $surface;
    border-top: solid $primary;
    padding: $ds-space-0 $ds-space-2;
    layout: horizontal;
    align: left middle;
}

.status-text {
    width: $ds-width-fill;
}





.hidden {
    display: none;
}

.help-text {
    color: $text-muted;
    text-style: italic;
}


Button:disabled {
    opacity: 0.5;
}


.loading {
    opacity: 0.6;
}


.error {
    border: tall $error;
    background: $error 10%;
}

/* ===== MODULE: features/_evals.tcss ===== */


.evals-rail-row.is-active {
    border: none;
    text-style: bold;
}

#evals-inspector-bench .ds-recovery-callout {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* ===== MODULE: features/_metrics.tcss ===== */





MetricsScreen {
    padding: $ds-space-1 $ds-space-2;


}

#metrics-container {
    padding: $ds-space-1;


}


MetricsScreen Label {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    padding: $ds-space-1;
    background: $panel-lighten-1;
    border: round $primary-darken-1;


}



#metrics-container > Label:first-of-type {
    text-style: bold underline;
    align: center middle;
    padding: $ds-space-1 $ds-space-0 $ds-space-2 $ds-space-0;
    background: transparent;
    border: none;
    margin-bottom: $ds-space-2;
}



MetricsScreen Label.-error-message {
    color: $error;
    background: $error 20%;

    text-style: bold;
}


MetricsScreen Label.-info-message {
    color: $text-muted;
    background: $panel;

    text-style: italic;
}


/* ===== MODULE: features/_embeddings.tcss ===== */





.sidebar-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    color: $text-muted;
}




#dialog-container {
    align: center middle;
    background: $surface;
    border: thick $primary;
    padding: $ds-space-2;
    width: $ds-size-50;
    height: auto;
}

#dialog-title {
    text-style: bold;
    text-align: center;
    margin-bottom: $ds-space-1;
    width: $ds-width-full;
}

#dialog-message {
    text-align: center;
    margin-bottom: $ds-space-2;
    color: $text-muted;
    width: $ds-width-full;
}

#dialog-buttons {
    layout: horizontal;
    align: center middle;
    width: $ds-width-full;
    margin-top: $ds-space-1;
}

#dialog-buttons Button {
    margin: $ds-space-0 $ds-space-1;
    min-width: $ds-size-10;
}


ModalScreen {
    align: center middle;
    background: $background 80%;
}




.error-message {
    color: $error;

    margin-top: $ds-space-0;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    text-style: italic;
}

.error-message.hidden {
    display: none;
}



.model-header {
    layout: horizontal;
    margin-bottom: $ds-space-0;
}

.model-name {
    text-style: bold;
    margin-right: $ds-space-1;
}

.model-provider {
    color: $text-muted;

}

.model-download-status,
.model-memory-status,
.model-size {

    margin-right: $ds-space-2;
}

.model-size {
    color: $text-muted;
}



.empty-state-container {
    width: $ds-width-full;
    height: $ds-height-full;
    align: center middle;
    padding: $ds-space-3;
}

.empty-state-content {
    align: center middle;
    width: auto;
}

.empty-state-icon {

    margin-bottom: $ds-space-1;
    text-align: center;
}

.empty-state-title {
    text-style: bold;

    margin-bottom: $ds-space-1;
    text-align: center;
}

.empty-state-description {
    color: $text-muted;
    margin-bottom: $ds-space-2;
    text-align: center;
    max-width: $ds-size-40;
}

.empty-state-action {
    margin-top: $ds-space-1;
}







Select > SelectCurrent:hover {
    background: $surface-lighten-1;
}



.section-separator {
    height: $ds-size-1;
    background: $primary-darken-2;
    margin: $ds-space-2 $ds-space-0;
}




.tooltip {

    background: $panel;
    border: solid $primary;
    padding: $ds-space-1;
    max-width: $ds-size-40;

    display: none;
}

.tooltip-content {
    color: $text;

}


.help-icon {

    margin-left: $ds-space-1;
    color: $primary;
}

.help-icon:hover {
    color: $primary-lighten-1;
}



.chunk-preview-widget {
    width: $ds-width-full;
    height: auto;
}

.chunk-preview-container {
    width: $ds-width-full;
    max-height: $ds-size-30;
    background: $surface;
    border: round $primary-darken-1;
    padding: $ds-space-1;
}

.chunk-preview-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
    color: $primary;
}

.chunk-preview-empty {
    color: $text-muted;
    text-align: center;
    padding: $ds-space-2;
}

.chunk-item {
    margin-bottom: $ds-space-2;
    padding: $ds-space-1;
    background: $panel;
    border: round $primary-darken-2;
}

.chunk-header {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    padding-bottom: $ds-space-1;
    border-bottom: dashed $primary-darken-2;
}

.chunk-number {
    text-style: bold;
    color: $accent;
    margin-right: $ds-space-2;
}

.chunk-range {
    color: $text-muted;

    margin-right: $ds-space-2;
}

.chunk-size {
    color: $text-muted;

}

.chunk-overlap {
    background: $warning 20%;
    padding: $ds-space-0 $ds-space-1;
    margin-bottom: $ds-space-1;
    border-left: thick $warning;
    text-style: italic;
    color: $text-muted;
}

.chunk-content {
    padding: $ds-space-0 $ds-space-1;

}

.chunk-truncated {
    color: $text-muted;
    text-style: italic;
    text-align: right;
    margin-top: $ds-space-0;
}

.chunk-more {
    text-align: center;
    color: $text-muted;
    text-style: italic;
    margin-top: $ds-space-1;
}

.chunk-boundary {
    text-align: center;
    color: $primary-darken-1;
    margin: $ds-space-1 $ds-space-0;
}



.batch-controls {
    layout: horizontal;
    margin: $ds-space-1 $ds-space-0;
    padding: $ds-space-1;
    background: $surface;
    border: round $primary;
}

.batch-controls.hidden {
    display: none;
}

.batch-button {
    margin: $ds-space-0 $ds-space-1;
    min-width: $ds-size-12;
    height: $ds-size-3;
}



.toast-manager {
    dock: top;
    align: right top;
    width: auto;
    height: auto;
    margin: $ds-space-2 $ds-space-2 $ds-space-0 $ds-space-0;
    layer: above;

}

.toast-stack {
    width: auto;
    height: auto;
}

.toast-notification {
    width: $ds-size-35;
    margin-bottom: $ds-space-1;
}

.toast-container {
    layout: horizontal;
    padding: $ds-space-1;
    border: round;
    align: left middle;
}

.toast-icon {
    margin-right: $ds-space-1;
    min-width: $ds-size-3;
    text-align: center;
}

.toast-message {
    width: $ds-width-fill;
    text-wrap: wrap;
}

.toast-close {
    min-width: $ds-size-3;
    height: $ds-size-3;
    margin-left: $ds-space-1;
    background: transparent;
    border: none;
}

.toast-close:hover {
    background: $background 50%;
}


.toast-success {
    background: $success 90%;
    border: solid $success;
    color: $text;
}

.toast-info {
    background: $primary 90%;
    border: solid $primary;
    color: $text;
}

.toast-warning {
    background: $warning 90%;
    border: solid $warning;
    color: $text;
}

.toast-error {
    background: $error 90%;
    border: solid $error;
    color: $text;
}


.toast-slide-in {

}



.detailed-progress-container {
    width: $ds-width-full;
    padding: $ds-space-1;
    background: $panel;
    border: round $primary;
}

.progress-stage-row,
.progress-item-row,
.progress-metrics-row {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    align: left middle;
}

.progress-action-row {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    align: right middle;
}

.progress-label {
    width: $ds-size-12;
    text-align: right;
    margin-right: $ds-space-1;
    color: $text-muted;
}

.stage-indicator {
    width: $ds-width-fill;
    text-style: bold;
    color: $primary;
}

.current-item {
    width: $ds-width-fill;
    color: $text;
    text-style: italic;
}

.pause-button {
    min-width: $ds-size-10;
}

#main-progress {
    margin-bottom: $ds-space-1;
    height: $ds-size-3;
}

.stage-progress {
    height: $ds-size-2;
    background: $surface;
}

.progress-metrics-row {
    margin-top: $ds-space-1;
    border-top: dashed $primary-darken-2;
    padding-top: $ds-space-1;
}

.metric-group {
    margin-right: $ds-space-3;
}

.metric-label {

    color: $text-muted;
    margin-bottom: $ds-space-0;
}

.metric-value {

    text-style: bold;
    color: $primary;
}




#embedding-template-selector-container {
    width: $ds-size-80;
    height: $ds-size-50;
    background: $panel;
    border: thick $primary;
    padding: $ds-space-2;
}

#embedding-template-selector-title {
    text-style: bold;
    text-align: center;
    margin-bottom: $ds-space-2;
}

#embedding-template-selector-content {
    height: $ds-height-fill;
    margin-bottom: $ds-space-2;
}

#embedding-template-category-pane {
    width: $ds-percent-25;
    min-width: $ds-size-20;
    background: $surface;
    padding: $ds-space-1;
    border-right: solid $primary-darken-1;
}

#embedding-template-grid-container {
    width: $ds-width-fill;
    padding: $ds-space-1;
    overflow-y: auto;
}

.embedding-template-grid {
    grid-columns: 2;
    grid-gutter: 1;
    padding: $ds-space-1;
}


.embedding-template-card-container {
    background: $surface;
    border: round $primary-darken-2;
    padding: $ds-space-1;
    height: auto;
}

.embedding-template-card:hover .embedding-template-card-container {
    background: $surface-lighten-1;
    border: solid $accent;
}

.embedding-template-card-header {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    align: left middle;
}

.embedding-template-card-title {
    text-style: bold;
    color: $primary;
    width: $ds-width-fill;
}

.embedding-template-card-category {

    color: $text-muted;
    background: $primary 20%;
    padding: $ds-space-0 $ds-space-1;
    border: round $primary;
}

.embedding-template-card-description {
    margin-bottom: $ds-space-1;
    color: $text-muted;

}

.embedding-template-card-label {

    text-style: bold;
    margin-bottom: $ds-space-0;
}

.embedding-template-card-list {
    margin-left: $ds-space-1;
    margin-bottom: $ds-space-1;
}

.embedding-template-card-item {

    color: $text-muted;
}

.embedding-template-card-button {
    width: $ds-width-full;
    margin-top: $ds-space-1;
}


.embedding-template-quick-select-container {
    layout: horizontal;
    align: left middle;
    padding: $ds-space-1;
    background: $surface;
    border: round $primary-darken-2;
    margin-bottom: $ds-space-1;
}

.embedding-template-select-label {
    margin-right: $ds-space-2;
    min-width: $ds-size-10;
}

.embedding-template-quick-button {
    margin-right: $ds-space-1;
    min-width: $ds-size-15;
}

.embedding-template-browse-button {
    margin-left: $ds-space-1;
}

.current-template-name {
    margin-left: $ds-space-2;
    color: $success;
    text-style: italic;
}



.activity-log-widget {
    width: $ds-width-full;
    height: $ds-height-full;
}

.activity-log-container {
    width: $ds-width-full;
    height: $ds-height-full;
    background: $panel;
    border: round $primary-darken-2;
    padding: $ds-space-1;
}

.activity-log-header {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    align: left middle;
}

.activity-log-title {
    text-style: bold;

    width: $ds-width-fill;
}

.activity-log-actions {
    layout: horizontal;
}

.activity-log-actions Button {
    margin-left: $ds-space-1;
    min-width: $ds-size-10;
    height: $ds-size-3;
}

.activity-log-controls {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    align: left middle;
}

.filter-button {
    margin-right: $ds-space-1;
    min-width: $ds-size-8;
    height: $ds-size-3;
    background: $surface;
}

.filter-button:hover {
    background: $primary 30%;
}

.filter-button.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.log-search-input {
    width: $ds-size-20;
}

.activity-log-scroll {
    height: $ds-height-fill;
    background: $surface;
    border: round $primary-darken-3;
    padding: $ds-space-1;
}

.log-entries-container {
    width: $ds-width-full;
}


.log-entry {
    layout: horizontal;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0;
    align: left top;
}

.log-timestamp {
    min-width: $ds-size-10;

    color: $text-muted;
    text-align: right;
    padding-right: $ds-space-1;
}

.log-icon {
    min-width: $ds-size-3;
    text-align: center;
}

.log-category {
    min-width: $ds-size-12;
    color: $primary;

    padding: $ds-space-0 $ds-space-1;
}

.log-message {
    width: $ds-width-fill;
    padding-left: $ds-space-1;
}


.log-info {
    color: $text;
}

.log-info .log-icon {
    color: $primary;
}

.log-success {
    color: $success;
}

.log-success .log-message {
    color: $success;
}

.log-warning {
    color: $warning;
}

.log-warning .log-message {
    color: $warning;
}

.log-error {
    color: $error;
}

.log-error .log-message {
    color: $error;
}

.log-debug {
    color: $text-muted;
    text-style: italic;
}

.log-debug .log-message {
    color: $text-muted;
}


.small-button {
    height: $ds-size-3;
    min-width: $ds-size-8;

}




.metrics-title {
    text-style: bold;
    text-align: center;
    margin-bottom: $ds-space-1;

}

.metrics-grid {
    grid-size: 2;
    grid-gutter: 1;
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}


.metric-box {
    background: $surface;
    border: round $primary-darken-2;
    padding: $ds-space-1;
    height: auto;
}


.metric-label {

    color: $text-muted;
}

.metric-value {

    text-style: bold;
    color: $primary;
    text-align: center;
    margin-bottom: $ds-space-0;
}


.io-rate {
    width: $ds-percent-50;
    text-align: center;

}

.io-rate:first-child {
    color: $success;
}

.io-rate:last-child {
    color: $warning;
}

/* ===== MODULE: features/_splash.tcss ===== */





SplashScreen, .splash-screen {
    layer: overlay;
    background: $background;
    width: $ds-width-full;
    height: $ds-height-full;
    align: center middle;
    dock: top;
}


#splash-center {
    width: $ds-width-full;
    height: $ds-height-full;
    align: center middle;
}


#splash-content {
    width: $ds-width-full;
    height: $ds-height-full;
    align: center middle;
    padding: $ds-space-0;
}


#splash-main, .splash-main {
    width: $ds-width-full;
    height: $ds-height-full;
    content-align: center middle;
    text-align: center;
    margin: $ds-space-0;
}


#splash-display, .splash-display {
    width: $ds-width-full;
    height: $ds-height-full;
    content-align: center middle;
    text-align: center;
    align: center middle;
    padding: $ds-space-0;
    margin: $ds-space-0;
}


#splash-progress-text, .splash-progress-text {
    width: $ds-width-full;
    text-align: center;
    color: $text-muted;
    margin-bottom: $ds-space-1;
}


#splash-progress-bar, .splash-progress-bar {
    width: $ds-percent-80;
    max-width: $ds-splash-progress-cap;
    height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-0;
    align: center middle;
}

#splash-progress-bar Bar {
    color: $success;
}

#splash-progress-bar PercentageStatus {
    text-style: dim;
}




.matrix-rain {
    color: $success;
    text-style: bold;
}


.glitch-effect {
    color: $text;
    text-style: bold;
}

.glitch-effect-error {
    color: $error;
    text-style: bold;
}

.glitch-effect-warning {
    color: $warning;
    text-style: bold;
}

.glitch-effect-success {
    color: $success;
    text-style: bold;
}


.retro-terminal {
    color: $success;
    background: rgba(0, 0, 0, 0.9);
    text-style: bold;
}

.retro-scanline {
    background: rgba(0, 255, 0, 0.1);
}


.fade-in {
    opacity: 0.0;
}



.loading-placeholder {
    color: $text-muted;
    text-align: center;
    padding: $ds-size-4;
}


SplashScreen.hidden {
    display: none;
}

/* ===== MODULE: features/_wizards.tcss ===== */





.wizard-container {
    layout: vertical;
    height: $ds-height-full;
    width: $ds-width-full;
    background: $surface;
    padding: $ds-space-0;
}

.wizard-title {
    text-style: bold;
    text-align: center;
    background: $primary-darken-2;
    color: $text;
    padding: $ds-space-1 $ds-space-2;
    margin-bottom: $ds-space-0;
    border-bottom: thick $primary-darken-1;
    width: $ds-width-full;
    height: $ds-size-3;
}



.wizard-progress {
    layout: horizontal;
    align: center middle;

    padding: $ds-space-1 $ds-space-2;
    background: $panel;
    border-bottom: solid $primary-darken-2;
    height: auto;
}

.step-indicator-container {
    layout: horizontal;
    align: center middle;
    width: $ds-width-fill;
}

.step-number {
    width: $ds-size-3;
    height: $ds-size-3;
    border: round $primary;
    background: $panel;
    align: center middle;
    margin-right: $ds-space-1;
    text-align: center;
}

.step-number.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    border: round $ds-focus-accent;
    text-style: bold underline;
}

.step-number.complete {
    background: $success;
    color: $text;
    border: solid $success;
}

.step-title {
    margin-right: $ds-space-1;
    color: $text-muted;
}

.step-title.active {
    color: $ds-focus-fg;
    text-style: bold underline;
}

.step-title.complete {
    color: $success;
}

.step-connector {
    height: $ds-size-1;
    width: $ds-width-fill;
    background: $primary-darken-2;
    margin: $ds-space-0 $ds-space-1;
}

.step-connector.complete {
    background: $success;
}



.wizard-steps-container {
    height: $ds-height-fill;
    width: $ds-width-full;
    overflow-y: auto;
    padding: $ds-space-0;
    background: $surface;
}

.wizard-step {
    width: $ds-width-full;
    height: $ds-height-full;
    padding: $ds-space-1 $ds-space-2;
    display: block;
    visibility: hidden;
}

.wizard-step.active {
    visibility: visible;
}

.wizard-step.hidden {
    display: none;
}





.wizard-navigation {
    layout: horizontal;
    align: center middle;
    padding: $ds-space-1 $ds-space-2;
    background: $panel;
    border-top: thick $primary-darken-2;
    height: $ds-size-5;
}


.setup-navigation { align: right middle; }
.setup-navigation .wizard-progress-text {
    dock: left;
    width: auto;
    height: $ds-height-full;
    content-align: left middle;
    padding: $ds-space-0 $ds-space-2;
}
.setup-navigation #wizard-cancel { height: $ds-size-3; min-width: $ds-size-12; }

.wizard-progress-text {
    width: $ds-width-fill;
    text-align: center;
    color: $text-muted;
}

#wizard-back, #wizard-next {
    min-width: $ds-size-15;
    height: $ds-size-3;
}

#wizard-back:disabled {
    opacity: 0.5;
}

#wizard-next:disabled {
    opacity: 0.5;
}




.content-type-card {
    background: $panel;
    border: round $primary-darken-2;
    padding: $ds-space-2;
    align: center middle;
    height: $ds-size-15;
}

.content-type-card:hover {
    background: $panel-lighten-1;
    border: solid $accent;
}

.content-type-card.selected {
    background: $ds-focus-bg;
    border: round $ds-focus-accent;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.content-type-title {
    text-style: bold;
    margin-bottom: $ds-space-0;
    text-align: center;
}

.content-type-description {
    color: $text-muted;
    text-align: center;
}

.content-type-card.selected .content-type-title,
.content-type-card.selected .content-type-description {
    color: $ds-focus-fg;
    text-style: bold underline;
}




.content-search-input {
    width: $ds-width-full;
    margin-bottom: $ds-space-2;
}

.content-search-input.hidden {
    display: none;
}


.preview-label {
    text-style: bold;
    margin-bottom: $ds-space-1;
    color: $primary;
}

.content-list {
    width: $ds-width-full;
}

.content-item {
    width: $ds-width-full;
    padding: $ds-space-1;
    margin-bottom: $ds-space-0;
    border-bottom: dashed $primary-darken-3;
}

.content-item:hover {
    background: $panel 50%;
}




.placeholder-text {
    text-align: center;
    color: $text-muted;
    padding: $ds-space-2;
}



.settings-section {
    margin-bottom: $ds-space-2;
    padding: $ds-space-1;
    background: $panel;
    border: round $primary-darken-3;
}

.settings-input {
    width: $ds-width-full;
    margin-bottom: $ds-space-0;
}

.settings-help {
    color: $text-muted;
    margin-top: $ds-space-0;
}

.preset-cards-container {
    layout: horizontal;
    margin-bottom: $ds-space-2;
    padding: $ds-space-1;
}

.preset-card {
    background: $panel;
    border: round $primary-darken-2;
    padding: $ds-space-2;
    margin-right: $ds-space-1;
    width: $ds-width-fill;
    height: auto;
}

.preset-card:hover {
    background: $panel-lighten-1;
    border: solid $accent;
}

.preset-card.selected {
    background: $ds-focus-bg;
    border: round $ds-focus-accent;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.preset-icon {
    text-align: center;
    margin-bottom: $ds-space-1;
}

.preset-name {
    text-style: bold;
    text-align: center;
    margin-bottom: $ds-space-0;
}

.preset-description {
    color: $text-muted;
    text-align: center;
    margin-bottom: $ds-space-1;
}

.preset-details {
    border-top: dashed $primary-darken-3;
    padding-top: $ds-space-1;
}

.preset-detail {
    color: $text-muted;
    margin-bottom: $ds-space-0;
}

.preset-card.selected .preset-name,
.preset-card.selected .preset-description,
.preset-card.selected .preset-detail {
    color: $ds-focus-fg;
    text-style: bold underline;
}


.advanced-settings-container {
    margin-top: $ds-space-2;
}

.advanced-toggle {
    width: $ds-width-full;
    background: $surface;
    border: round $primary-darken-3;
    color: $text-muted;
    text-align: left;
}

.advanced-toggle:hover {
    background: $panel;
    color: $text;
}

.advanced-settings {
    margin-top: $ds-space-1;
    padding: $ds-space-2;
    background: $surface;
    border: round $primary-darken-3;
}

.advanced-settings.hidden {
    display: none;
}

.advanced-settings Label {
    margin-top: $ds-space-1;
}

.advanced-settings Select,
.advanced-settings Input {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
}




.progress-text {
    text-align: center;
    text-style: bold;
    margin-bottom: $ds-space-1;
    color: $primary;
}

.current-item {
    text-align: center;
    color: $text-muted;
    margin-bottom: $ds-space-2;
    text-style: italic;
}

.progress-stats {
    layout: horizontal;
    align: center middle;
    padding-top: $ds-space-1;
    border-top: dashed $primary-darken-2;
}

.progress-stats Label {
    width: $ds-width-fill;
    text-align: center;
    color: $text-muted;
}




.error-message {
    color: $error;
    background: $error 10%;
    border: round $error;
    padding: $ds-space-1;
    margin: $ds-space-1;
    text-align: center;
}















BasicInfoStep {
    layout: vertical;
    padding: $ds-space-2;
}

BasicInfoStep .form-group {
    margin-bottom: $ds-space-2;
}

BasicInfoStep .form-label {
    color: $text-muted;
    margin-bottom: $ds-space-0;
}

BasicInfoStep .form-input {
    width: $ds-width-full;
    margin-top: $ds-space-0;
}

BasicInfoStep #chatbook-description {
    height: $ds-size-6;
}

BasicInfoStep .info-box {
    padding: $ds-space-1;
    background: $boost;
    border: round $primary;
    margin-top: $ds-space-2;
}


ContentSelectionStep {
    layout: vertical;
    height: $ds-height-full;
}

ContentSelectionStep .selection-header {
    height: $ds-size-3;
    padding: $ds-space-1;
    background: $boost;
    border: round $background-darken-1;
    margin-bottom: $ds-space-1;
}

ContentSelectionStep .content-tree-container {
    height: $ds-height-fill;
}


ExportOptionsStep {
    layout: vertical;
    padding: $ds-space-2;
}

ExportOptionsStep .option-group {
    margin-bottom: $ds-space-2;
    padding: $ds-space-1;
    background: $boost;
    border: round $background-darken-1;
}

ExportOptionsStep .option-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
}

ExportOptionsStep .radio-option {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-1;
}

ExportOptionsStep .checkbox-option {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-1;
}


PreviewConfirmStep {
    layout: vertical;
    padding: $ds-space-2;
}

PreviewConfirmStep .preview-header {
    margin-bottom: $ds-space-2;
}

PreviewConfirmStep .chatbook-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
}

PreviewConfirmStep .preview-section {
    margin-bottom: $ds-space-2;
    padding: $ds-space-1;
    background: $boost;
    border: round $background-darken-1;
}

PreviewConfirmStep .section-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
}

PreviewConfirmStep .content-list {
    margin-left: $ds-space-2;
    color: $text-muted;
}

PreviewConfirmStep .file-tree {
    height: $ds-size-12;
    border: round $background-darken-1;
    background: $background;
    padding: $ds-space-1;
    margin: $ds-space-1 $ds-space-0;
}

PreviewConfirmStep .location-section {
    margin-top: $ds-space-2;
    padding: $ds-space-1;
    background: $panel;
    border: round $primary;
}

PreviewConfirmStep .location-path {
    color: $primary;
    margin: $ds-space-1 $ds-space-0;
}


ProgressStep {
    layout: vertical;
    padding: $ds-space-2;
    align: center middle;
}

ProgressStep .progress-container {
    width: $ds-width-full;
    max-width: $ds-size-60;
    padding: $ds-space-2;
    background: $boost;
    border: round $background-darken-1;
}

ProgressStep .progress-title {
    text-align: center;
    text-style: bold;
    margin-bottom: $ds-space-2;
}

ProgressStep #export-progress, ProgressStep #import-progress {
    margin: $ds-space-2 $ds-space-0;
}

ProgressStep .progress-status {
    margin: $ds-space-2 $ds-space-0;
}



ProgressStep .completion-message {
    text-align: center;
    padding: $ds-space-2;
    margin-top: $ds-space-2;
    background: $success 20%;
    border: round $success;
}

ProgressStep .completion-actions {
    layout: horizontal;
    height: auto;
    align: center middle;
    margin-top: $ds-space-2;
}

ProgressStep .completion-actions Button {
    margin: $ds-space-0 $ds-space-1;
}

ProgressStep .hidden {
    display: none;
}




FileSelectionStep {
    layout: vertical;
    padding: $ds-space-2;
}

FileSelectionStep .file-selection-container {
    layout: vertical;
    height: $ds-height-full;
    align: center middle;
}

FileSelectionStep .drop-zone {
    width: $ds-percent-80;
    height: $ds-size-20;
    border: dashed $background-darken-2;
    background: $boost;
    align: center middle;
    margin: $ds-space-2 $ds-space-0;
}

FileSelectionStep .drop-zone.hover {
    border: solid $primary;
    background: $primary 10%;
}

FileSelectionStep .drop-zone-content {
    text-align: center;
    padding: $ds-space-2;
}

FileSelectionStep .drop-zone-icon {
    margin-bottom: $ds-space-1;
    color: $text-muted;
}

FileSelectionStep .drop-zone-text {
    color: $text-muted;
    margin-bottom: $ds-space-1;
}

FileSelectionStep .file-path-display {
    width: $ds-percent-80;
    margin: $ds-space-2 $ds-space-0;
    padding: $ds-space-1;
    background: $boost;
    border: round $background-darken-1;
}

FileSelectionStep .path-label {
    color: $text-muted;
    margin-bottom: $ds-space-0;
}

FileSelectionStep .path-value {
    color: $primary;
    margin-top: $ds-space-0;
}

FileSelectionStep .browse-button {
    margin-top: $ds-space-2;
}


PreviewValidationStep {
    layout: vertical;
    padding: $ds-space-2;
}

PreviewValidationStep .preview-header {
    margin-bottom: $ds-space-2;
}

PreviewValidationStep .chatbook-info {
    padding: $ds-space-1 $ds-space-2;
    background: $boost;
    border: round $background-darken-1;
    margin-bottom: $ds-space-2;
}

PreviewValidationStep .info-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
}

PreviewValidationStep .info-row {
    layout: horizontal;
    height: auto;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-1;
}

PreviewValidationStep .info-label {
    width: $ds-size-15;
    color: $text-muted;
}

PreviewValidationStep .info-value {
    width: $ds-width-fill;
}

PreviewValidationStep .content-preview {
    padding: $ds-space-1 $ds-space-2;
    background: $boost;
    border: round $background-darken-1;
    margin-bottom: $ds-space-2;
}

PreviewValidationStep .preview-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
    color: $primary;
}

PreviewValidationStep .content-tree {
    height: $ds-size-15;
    background: $background;
    border: round $background-darken-1;
    padding: $ds-space-1;
}

PreviewValidationStep .validation-results {
    padding: $ds-space-1 $ds-space-2;
    background: $boost;
    border: round $background-darken-1;
}

PreviewValidationStep .validation-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
}

PreviewValidationStep .validation-item {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-1;
}

PreviewValidationStep .validation-success {
    color: $success;
}

PreviewValidationStep .validation-warning {
    color: $warning;
}

PreviewValidationStep .validation-error {
    color: $error;
}


ConflictResolutionStep {
    layout: vertical;
    padding: $ds-space-2;
}

ConflictResolutionStep .resolution-header {
    margin-bottom: $ds-space-2;
    padding: $ds-space-1;
    background: $boost;
    border: round $background-darken-1;
}

ConflictResolutionStep .strategy-section {
    margin-bottom: $ds-space-2;
    padding: $ds-space-1 $ds-space-2;
    background: $boost;
    border: round $background-darken-1;
}

ConflictResolutionStep .strategy-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
    color: $primary;
}

ConflictResolutionStep .radio-option {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-1;
}

ConflictResolutionStep .strategy-description {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-3;
    color: $text-muted;
}

ConflictResolutionStep .conflict-preview {
    padding: $ds-space-1 $ds-space-2;
    background: $boost;
    border: round $warning;
}

ConflictResolutionStep .conflict-title {
    text-style: bold;
    color: $warning;
    margin-bottom: $ds-space-1;
}

ConflictResolutionStep .conflict-list {
    margin-left: $ds-space-2;
    color: $text-muted;
}

ConflictResolutionStep .no-conflicts {
    text-align: center;
    padding: $ds-space-3;
    color: $success;
}


ImportOptionsStep {
    layout: vertical;
    padding: $ds-space-2;
}

ImportOptionsStep .options-section {
    margin-bottom: $ds-space-2;
    padding: $ds-space-1 $ds-space-2;
    background: $boost;
    border: round $background-darken-1;
}

ImportOptionsStep .section-title {
    text-style: bold;
    margin-bottom: $ds-space-1;
    color: $primary;
}

ImportOptionsStep .checkbox-option {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-1;
}

ImportOptionsStep .option-description {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-3;
    color: $text-muted;
}


ImportProgressStep {
    layout: vertical;
    padding: $ds-space-2;
    align: center middle;
}

ImportProgressStep .progress-container {
    width: $ds-width-full;
    max-width: $ds-size-60;
    padding: $ds-space-2;
    background: $boost;
    border: round $background-darken-1;
}

ImportProgressStep .progress-title {
    text-align: center;
    text-style: bold;
    margin-bottom: $ds-space-2;
}

ImportProgressStep #import-progress {
    margin: $ds-space-2 $ds-space-0;
}

ImportProgressStep .progress-status {
    margin: $ds-space-2 $ds-space-0;
}

ImportProgressStep .status-item.warning {
    color: $warning;
}


ImportProgressStep .completion-message {
    text-align: center;
    padding: $ds-space-2;
    margin-top: $ds-space-2;
    background: $panel;
    border: round $background-darken-1;
}

ImportProgressStep .completion-message.outcome-imported {
    background: $success 20%;
    border: round $success;
}

ImportProgressStep .completion-message.outcome-partial {
    background: $warning 20%;
    border: round $warning;
}

ImportProgressStep .completion-message.outcome-skipped {
    background: $warning 20%;
    border: round $warning;
}

ImportProgressStep .completion-message.outcome-empty {
    background: $panel;
    border: round $background-darken-1;
}


ImportProgressStep .completion-message.outcome-excluded {
    background: $warning 20%;
    border: round $warning;
}

ImportProgressStep .completion-message.outcome-failed {
    background: $error 20%;
    border: round $error;
}

ImportProgressStep .completion-stats {
    margin-top: $ds-space-2;
    padding: $ds-space-1 $ds-space-2;
    background: $boost;
    border: round $background-darken-1;
}

ImportProgressStep .stat-row {
    layout: horizontal;
    height: auto;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

ImportProgressStep .stat-label {
    width: $ds-size-20;
    color: $text-muted;
}

ImportProgressStep .stat-value {
    width: $ds-width-fill;
    text-align: right;
}



SmartContentTree {
    layout: vertical;
    height: $ds-height-full;
}

SmartContentTree .tree-controls {
    height: auto;
    padding: $ds-space-1;
    background: $boost;
    border: round $background-darken-1;
    margin-bottom: $ds-space-1;
}

SmartContentTree .search-row {
    layout: horizontal;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

SmartContentTree .search-input {
    width: $ds-width-fill;
    margin-right: $ds-space-1;
}

SmartContentTree .filter-button {
    min-width: $ds-size-12;
}

SmartContentTree .category-filters {
    layout: horizontal;
    height: auto;
    margin-bottom: $ds-space-1;
}

SmartContentTree .category-checkbox {
    margin-right: $ds-space-2;
}

SmartContentTree .selection-controls {
    layout: horizontal;
    height: auto;
}

SmartContentTree .selection-button {
    margin-right: $ds-space-1;
    min-width: $ds-size-10;
}

SmartContentTree .tree-container {
    height: $ds-height-fill;
    border: round $background-darken-1;
    background: $boost;
    padding: $ds-space-1;
}

SmartContentTree .tree-stats {
    height: $ds-size-2;
    padding: $ds-space-0 $ds-space-1;
    text-align: right;
    color: $text-muted;
}


SmartContentTree Tree > .tree--cursor {
    background: $surface;
    color: $text;
    text-style: bold underline;
}

SmartContentTree Tree > .selected-node {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}



.setup-welcome { padding: $ds-space-1 $ds-size-4; }
.setup-provider { padding: $ds-space-0 $ds-space-2; }
.setup-title { text-style: bold; text-align: center; margin-bottom: $ds-space-1; }
.setup-subtitle { color: $text-muted; margin-bottom: $ds-space-1; }
.setup-provider .setup-title,
.setup-provider .setup-subtitle { margin-bottom: $ds-space-0; }
.setup-step-error {
    color: $error;
    background: $error 15%;
    text-style: bold;
    margin-top: $ds-space-1;
}

.setup-step-note { color: $text-muted; margin-top: $ds-space-1; }
.setup-field-label { margin-top: $ds-space-1; }
.setup-probe-status { color: $text-muted; margin-top: $ds-space-1; }
.setup-summary-row { height: $ds-size-1; }
.setup-summary-ok { color: $success; }
.setup-summary-missing { color: $error; }


.setup-step {

    overflow-y: auto;
}

.setup-welcome,
.setup-provider,
.setup-model,
.setup-voice,
.setup-rag,
.setup-speech,
.setup-tools,
.setup-notes,
.setup-appearance,
.setup-protect,
.setup-summary {

    height: auto;
}


.setup-voice {
    padding: $ds-space-0 $ds-space-2 $ds-space-1 $ds-space-2;
}

.setup-voice-segmented {
    layout: horizontal;
    height: $ds-size-3;
    min-height: $ds-size-3;
    border: solid $primary;
    overflow: hidden hidden;
}

.setup-voice-segmented SetupRadioButton {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-3;
}

.setup-voice-segmented SetupRadioButton.-on {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.setup-voice-output-row {
    height: $ds-size-5;
}

.setup-voice-output-row > Vertical {
    width: $ds-width-fill;
    height: $ds-size-5;
}

#setup-voice-sample-count {
    height: $ds-size-1;
    text-align: right;
    color: $text-muted;
}

#setup-voice-test {
    margin-top: $ds-space-1;
}

#setup-voice-status {
    height: auto;
    min-height: $ds-size-1;
    margin-top: $ds-space-1;
}


.setup-choice-list {
    min-height: $ds-size-5;
    max-height: $ds-size-7;
    border: solid $primary;
}

.setup-choice-list:focus {
    border: solid $ds-focus-accent;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}


.setup-summary-actions {
    dock: bottom;
    height: auto;
    padding: $ds-space-0 $ds-size-4 $ds-space-1 $ds-size-4;
}

.setup-summary-actions-row {
    height: auto;
    margin-bottom: $ds-space-1;
}
.setup-summary-actions Button {
    margin-right: $ds-space-2;
}


.setup-choice-list SetupRadioButton.-on {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    border-left: thick $ds-focus-accent;
    text-style: bold underline;
}


.setup-tool-row {
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
}
.setup-tool-row Switch {
    margin-right: $ds-space-2;
}
.setup-tool-text {
    width: $ds-width-fill;
    height: auto;
}
.setup-tool-name {
    text-style: bold;
}
.setup-tool-desc {
    color: $text-muted;
}


.setup-tertiary-button {
    background: transparent;
    border: none;
    color: $text-muted;
    text-style: underline;
    height: $ds-size-1;
    min-width: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
    margin-top: $ds-space-1;
}
.setup-tertiary-button:hover {
    color: $text;
    background: transparent;
}
.setup-tertiary-button:focus {
    color: $text;
    text-style: bold underline;
}


.setup-choice-header {
    color: $text-muted;
    text-style: bold;
    padding: $ds-space-0 $ds-space-1;
}
.setup-detected-banner {
    margin-bottom: $ds-space-1;
}

#setup-provider-connection {
    height: auto;
    min-height: $ds-size-7;
}

#setup-provider-endpoint {
    width: $ds-width-full;
    min-height: $ds-size-3;
}

.setup-endpoint-value {
    height: auto;
    min-height: $ds-size-1;
    text-wrap: wrap;
    color: $text-muted;
}

.setup-provider-connection-actions {
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin-top: $ds-space-1;
}

.setup-provider-connection-actions Button {
    min-width: $ds-size-12;
    margin-right: $ds-space-1;
}

#setup-provider-auth-toggle {
    height: auto;
    min-height: $ds-size-3;
    margin-top: $ds-space-1;
}

#setup-provider-api-key {
    width: $ds-width-full;
    min-height: $ds-size-3;
}

.setup-detection-results {
    height: auto;
    min-height: $ds-size-3;
    max-height: $ds-size-8;
    border: solid $primary;
    margin-top: $ds-space-1;
}

.setup-detection-results:focus {
    border: solid $ds-focus-accent;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
}


.setup-provider .hidden {
    display: none;
}


.setup-key-hints {
    dock: bottom;
    height: $ds-size-1;
    color: $text-muted;
    text-align: center;
    background: $panel;
}


FirstRunSetupWizard SetupWizardContainer .wizard-progress {
    height: auto;
    max-height: $ds-size-5;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
}

.setup-progress-item {
    height: auto;
    min-width: $ds-size-0;
    margin: $ds-space-0;
}

.setup-progress-item.-active .step-number {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    border: solid $ds-focus-accent;
}

.setup-progress-item.-active .step-title {
    color: $ds-focus-fg;
    text-style: bold underline;
}

.setup-progress-item.-complete .step-number {
    background: $ds-surface-raised;
    color: $ds-text-primary;
    border: solid $success;
}

.setup-progress-item.-complete .step-title {
    color: $ds-text-primary;
    text-style: bold;
}


.setup-progress-item.-attention .step-number {
    background: $ds-surface-raised;
    color: $warning;
    border: solid $warning;
    text-style: bold;
}
.setup-progress-item.-attention .step-title {
    color: $warning;
    text-style: bold;
}

.setup-progress-item.-upcoming .step-number {
    background: $panel;
    color: $text-muted;
    border: solid $primary;
}

.setup-progress-item.-upcoming .step-title {
    color: $text-muted;
}


.setup-key-row {
    height: $ds-size-3;
}
.setup-key-row Input {
    width: $ds-width-fill;
}
.setup-key-row Button {
    margin-left: $ds-space-1;
    min-width: $ds-size-8;
}


FirstRunSetupWizard SetupWizardContainer {
    height: $ds-height-fill;
}

FirstRunSetupWizard SetupWizardContainer .wizard-title {
    height: $ds-size-3;
    padding: $ds-space-0 $ds-space-2;
    margin: $ds-space-0;
}

FirstRunSetupWizard SetupWizardContainer .wizard-steps-container {
    height: $ds-height-fill;
    padding: $ds-space-0;
    margin: $ds-space-0;
}

FirstRunSetupWizard SetupWizardContainer .wizard-navigation {
    height: $ds-size-4;
    min-height: $ds-size-4;
    padding: $ds-space-0 $ds-space-2;
    margin: $ds-space-0;
}

FirstRunSetupWizard .setup-key-hints {
    height: $ds-size-1;
    min-height: $ds-size-1;
}


WizardProgress .step-number.active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    border: round $ds-focus-accent;
    text-style: bold underline;
}

WizardProgress .step-title.active {
    color: $ds-focus-fg;
    text-style: bold underline;
}


.setup-size-hint {
    dock: bottom;
    height: $ds-size-1;
    color: $warning;
    text-align: center;
}

.setup-size-hint.hidden { display: none; }


.setup-progress-item .step-indicator-stack {
    layout: vertical;
    align: center top;
    width: auto;
    height: auto;
}
.setup-progress-item .step-number {
    width: auto;
    min-width: $ds-size-4;
    margin-right: $ds-space-0;
}
.setup-progress-item .step-title {
    margin-right: $ds-space-0;
    text-align: center;
}



.setup-step Collapsible > Contents { padding: $ds-space-0 $ds-space-1; }
.setup-step Collapsible > Contents .setup-field-label { margin-top: $ds-space-0; }
.setup-step Collapsible > Contents .setup-probe-status { margin-top: $ds-space-0; }

/* ===== MODULE: features/_chatbooks.tcss ===== */






ChatbooksWindow {
    background: $background;
}


#main-layout {
    layout: horizontal;
    height: $ds-height-full;
}


#chatbooks-sidebar {
    width: $ds-size-30;
    background: $panel;
    border-right: solid $background-darken-1;
    padding: $ds-space-1;
    layout: vertical;
}

.sidebar-title {
    text-style: bold;
    color: $primary;
    margin-bottom: $ds-space-1;
    text-align: center;
}

#chatbooks-list {
    height: $ds-height-fill;
    background: $boost;
    border: round $background-darken-1;
}

#chatbooks-list ListItem {
    padding: $ds-space-0 $ds-space-1;
    height: $ds-size-3;
}

#chatbooks-list ListItem:hover {
    background: $surface-lighten-1;
    color: $text;
}

#chatbooks-list ListItem.-highlight {
    background: $surface;
    color: $text;
    text-style: bold underline;
}


#content-area {
    width: $ds-width-fill;
    layout: vertical;
    padding: $ds-space-1;
}


#chatbooks-header {
    background: $boost;
    border: round $background-darken-1;
    padding: $ds-space-2;
    margin-bottom: $ds-space-1;
}

.header-title {
    text-style: bold;
    text-align: center;
    color: $primary;
    margin-bottom: $ds-space-1;
}

.header-subtitle {
    text-align: center;
    color: $text-muted;
    margin-bottom: $ds-space-2;
}

#action-buttons {
    layout: horizontal;
    align: center middle;
    height: $ds-size-3;
}

#action-buttons Button {
    margin: $ds-space-0 $ds-space-1;
    min-width: $ds-size-20;
}


#dynamic-content {
    height: $ds-height-fill;
    background: $boost;
    border: round $background-darken-1;
    padding: $ds-space-2;
    overflow-y: auto;
}


.welcome-text {
    color: $text;
    padding: $ds-space-2;
}


.status-text {
    color: $text-muted;
    text-align: center;
    padding: $ds-space-2;
}


.info-text {
    color: $text-muted;
    text-align: center;
    padding: $ds-space-2;
}


.chatbook-details {
    layout: vertical;
    padding: $ds-space-1;
}

.chatbook-title {
    text-style: bold;
    color: $primary;
    margin-bottom: $ds-space-1;
}

.chatbook-desc {
    color: $text;
    margin-bottom: $ds-space-1;
}

.chatbook-size {
    color: $text-muted;
    margin-bottom: $ds-space-1;
}

.chatbook-date {
    color: $text-muted;
    margin-bottom: $ds-space-2;
}


.management-buttons {
    layout: horizontal;
    height: $ds-size-3;
    margin-top: $ds-space-2;
}

.management-buttons Button {
    margin-right: $ds-space-1;
    min-width: $ds-size-12;
}


Button.error {
    background: $error;
    color: $text;
}

Button.error:hover {
    background: $error-darken-1;
}


.templates-list {
    layout: vertical;
    height: auto;
    max-height: $ds-size-20;
    overflow-y: auto;
    margin: $ds-space-1 $ds-space-0 $ds-space-2 $ds-space-0;
    background: $panel;
    border: round $background-darken-1;
    padding: $ds-space-1;
}

.template-item {
    padding: $ds-space-1;
    margin-bottom: $ds-space-1;
    background: $boost;
    border: round $background-darken-1;
}

.template-item:hover {
    background: $primary 10%;
    border: round $primary;
}

.template-name {
    text-style: bold;
    color: $primary;
    margin-bottom: $ds-space-0;
}

.template-description {
    color: $text-muted;
    text-style: italic;
}

/* ===== MODULE: features/_scheduling.tcss ===== */


TaskDetail, DefinitionDetail {
    overflow-y: auto;
}


#scheduling-workbench.compact #scheduling-queue-filter {
    margin: $ds-space-0;
}


#scheduling-workbench.compact #scheduling-queue-chips {
    margin: $ds-space-0;
}

#scheduling-workbench.compact #scheduling-queue-chips .scheduling-queue-chip {
    display: none;
}

#scheduling-workbench.compact #scheduling-chip-cycle {
    display: block;
}


#scheduling-workbench.compact #scheduling-list-pane {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    border: none;
    padding: $ds-space-0 $ds-space-1;
}


.detail-secondary-action-button {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}


#scheduling-task-detail .follow-why,
#scheduling-task-detail-overlay .follow-why {
    color: $text-muted;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
}

#scheduling-automation-detail-lifecycle .detail-lifecycle-button {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}


#scheduling-queue-definition-detail .follow-why,
#scheduling-definition-detail-overlay .follow-why {
    color: $text-muted;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
}

#scheduling-task-status-badge.waiting {
    background: $primary;
}

#scheduling-task-status-badge.running,
#scheduling-task-status-badge.completed,
#scheduling-task-status-badge.found-results {
    background: $success;
}

#scheduling-task-status-badge.paused,
#scheduling-task-status-badge.needs-attention,
#scheduling-task-status-badge.missed {
    background: $warning;
    color: $text;
}

#scheduling-task-status-badge.blocked,
#scheduling-task-status-badge.conflict {
    background: $error;
}

#scheduling-task-status-badge.disabled,
#scheduling-task-status-badge.archived {
    background: $surface-darken-1;
    color: $text-muted;
}

#scheduling-conflict-card.conflict {
    border: solid $error;
    padding: $ds-space-1;
    color: $error;
    background: $error 10%;
}


.pane-hidden {
    display: none;
}


#scheduling-workbench.compact #scheduling-list-title {
    display: none;
}

#scheduling-workbench.compact #scheduling-new-task,
#scheduling-workbench.compact #scheduling-mark-all-read,
#scheduling-workbench.compact #scheduling-results-badge {
    height: $ds-size-1;
    border: none;
    background: $surface-darken-1;
}


DetailValueRow {
    height: auto;
    min-height: $ds-size-0;
}

DetailValueRow .detail-value-row-line {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

DetailValueRow .detail-value-row-label {
    color: $ds-text-muted;
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

DetailValueRow .detail-value-row-value {
    color: $ds-text-primary;
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    text-align: right;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

DetailValueRow .detail-value-row-affordance {
    color: $ds-text-disabled-readable;
    width: $ds-size-2;
    min-width: $ds-size-2;
    height: $ds-size-1;
    text-align: right;
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
}


DetailValueRow:focus-within .detail-value-row-affordance,
DetailValueRow:hover .detail-value-row-affordance {
    color: $ds-text-primary;
}

DetailValueRow .detail-value-row-error {
    color: $ds-status-error-readable;
    width: $ds-width-fill;
    height: $ds-size-1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}


.detail-value-row-owner-actions {

    height: auto;
    align: right middle;
}

.detail-value-row-owner-actions .detail-owner-action-button {
    height: $ds-size-1;
    min-width: $ds-size-8;
    border: none;
    margin: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
}


DetailGroup {
    background: $ds-surface-panel;
    border: none;
    border-top: hkey $ds-grid-line;
    padding-bottom: $ds-space-0;
    margin-bottom: $ds-space-0;
}

DetailGroup Contents {
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-3;
}


.workbench-host-body {
    height: $ds-height-fill;
}

/* ===== MODULE: features/_code_repo.tcss ===== */





.repo-window-container {
    width: $ds-width-full;
    height: $ds-height-full;
    background: $surface;
    padding: $ds-space-0;
}



.repo-header {
    dock: top;
    height: $ds-size-7;
    background: $boost;
    padding: $ds-space-1;
    border-bottom: solid $primary;
}

.repo-header-content {
    layout: grid;
    grid-size: 4 2;
    grid-columns: 3fr 1fr 1fr 1fr;
    grid-rows: 3 2;
    grid-gutter: 1 1;
    width: $ds-width-full;
}

.repo-url-input {
    width: $ds-width-full;
}

#repo-url-input {
    width: $ds-width-full;
}

#load-repo-btn {
    min-width: $ds-size-10;
}

#token-config-btn {
    min-width: $ds-size-8;
}

#token-config-btn.token-configured {
    background: $success 20%;
    border: solid $success;
}

#branch-selector {
    min-width: $ds-size-15;
}

#repo-settings-btn {
    width: $ds-size-3;
    min-width: $ds-size-3;
}


.selection-summary {
    column-span: 4;
    layout: grid;
    grid-size: 3 1;
    grid-columns: 1fr 1fr 1fr;
    align: left middle;
    width: $ds-width-full;
}

.summary-stat {
    text-align: left;
    color: $text-muted;
}



.filter-bar {
    dock: top;
    height: $ds-size-3;
    background: $panel;
    layout: grid;
    grid-size: 6 1;
    grid-columns: 2fr 1fr 3 3 3 1fr;
    grid-gutter: 0 1;
    padding: $ds-space-0 $ds-space-1;
    border-bottom: solid $primary-darken-1;
}

#file-search {
    width: $ds-width-full;
}

#file-type-filter {
    width: $ds-width-full;
}

.filter-quick-btn {
    width: $ds-size-3;
    height: $ds-size-3;
    min-width: $ds-size-3;
    padding: $ds-space-0;
    background: $surface;
    border: solid $primary-darken-2;
}

.filter-quick-btn:hover {
    background: $primary 30%;
    border: solid $primary;
}



.main-content {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 2fr 3fr;
    height: $ds-height-fill;
    background: $background;
}


.tree-container {
    border-right: solid $primary;
    overflow: hidden;
    padding: $ds-space-1;
    background: $surface;
}

#repo-tree {
    height: $ds-height-full;
    width: $ds-width-full;
    border: none;
}


.preview-panel {
    padding: $ds-space-1;
    overflow: hidden;
    background: $surface;
    layout: vertical;
    height: $ds-height-full;
}


.aggregated-text-container {
    height: $ds-percent-50;
    margin-bottom: $ds-space-1;
    layout: vertical;
}


.file-preview-container {
    height: $ds-percent-50;
    layout: vertical;
}

.preview-header {
    height: $ds-size-3;
    border-bottom: dashed $primary-darken-2;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    align: left middle;
}

#preview-title {
    text-style: bold;
    color: $primary;
}

#compilation-title {
    text-style: bold;
    color: $primary;
}

.preview-content {
    height: $ds-height-fill;
    border: round $primary-darken-2;
    padding: $ds-space-1;
    background: $surface-darken-1;
    overflow-y: auto;
}

#file-preview {
    width: $ds-width-full;
    height: $ds-height-full;
    background: $surface-darken-1;
    padding: $ds-space-1;
}

#aggregated-text {
    width: $ds-width-full;
    height: $ds-height-full;
    background: $surface-darken-1;
    padding: $ds-space-1;
}



TreeView {
    height: $ds-height-full;
    width: $ds-width-full;
    overflow-y: auto;
    overflow-x: hidden;
    border: solid $primary-darken-2;
    padding: $ds-space-1;
    background: $surface;
}

.tree-container {
    width: $ds-width-full;
    height: auto;
}

.tree-loading {
    width: $ds-width-full;
    text-align: center;
    padding: $ds-space-2;
    color: $text-muted;
}

.tree-empty {
    width: $ds-width-full;
    text-align: center;
    padding: $ds-size-4;
    color: $text-muted;
}


TreeNode {
    height: $ds-size-3;
    width: $ds-width-full;
}

.tree-node-row {
    layout: grid;
    grid-size: 4 1;
    grid-columns: auto 3 3 1fr;
    height: $ds-size-3;
    align: left middle;
    width: $ds-width-full;
}

.tree-node-row:hover {
    background: $panel-lighten-1;
}

.tree-node-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.tree-indent {
    width: auto;
    content-align: left middle;
}

.tree-expand-btn {
    width: $ds-size-3;
    height: $ds-size-3;
    min-width: $ds-size-3;
    background: transparent;
    border: none;
    padding: $ds-space-0;
}

.tree-expand-btn:hover {
    background: $surface-lighten-1;
    color: $text;
}

.tree-expand-spacer {
    width: $ds-size-3;
    height: $ds-size-3;
}

.tree-checkbox {
    width: $ds-size-3;
    height: $ds-size-3;
}

.tree-content {
    padding-left: $ds-space-1;
    width: $ds-width-full;
    content-align: left middle;
}



.action-bar {
    dock: bottom;
    height: $ds-size-3;
    background: $panel;
    layout: grid;
    grid-size: 6 1;
    grid-columns: 1fr auto auto auto auto 1fr;
    grid-gutter: 0 1;
    align: center middle;
    padding: $ds-space-0 $ds-space-2;
    border-top: solid $primary;
}

.action-bar Button {
    min-width: $ds-size-15;
}

#reset-btn {
    min-width: $ds-size-10;
}

#generate-compilation-btn {
    min-width: $ds-size-20;
}



.loading-overlay {
    dock: top;
    width: $ds-width-full;
    height: $ds-height-full;
    background: $background 90%;
    align: center middle;
    layer: above;
}

.loading-overlay.hidden {
    display: none;
}

.loading-overlay LoadingIndicator {
    margin-bottom: $ds-space-2;
}

.loading-label {
    text-align: center;
    margin-top: $ds-space-2;
    text-style: bold;
    color: $text;
}



.error-message {
    color: $error;
    text-align: center;
    padding: $ds-space-2;
    text-style: bold;
}








#file-preview {

}

/* ===== MODULE: features/_coding.tcss ===== */





CodingWindow {
    layout: horizontal;
    height: $ds-height-full;
    width: $ds-width-full;
}


.coding-nav-pane {
    dock: left;
    width: $ds-percent-25;
    min-width: $ds-size-20;
    max-width: $ds-size-40;
    background: $boost;
    padding: $ds-space-1 $ds-space-2;
    border-right: thick $background-darken-1;
    height: $ds-height-full;
    overflow-y: auto;
    overflow-x: hidden;
}

.coding-nav-pane.collapsed {
    width: $ds-size-0 !important;
    min-width: $ds-size-0 !important;
    border-right: none !important;
    padding: $ds-space-0 !important;
    overflow: hidden !important;
    display: none;
}


.coding-nav-button {
    width: $ds-width-full;
    height: $ds-size-3;
    margin: $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-2;
    text-align: left;
    background: $surface;
}

.coding-nav-button:hover {
    background: $surface-lighten-1;
    color: $text;
}


.coding-content-pane {
    height: $ds-height-full;
    width: $ds-width-full;
    padding: $ds-space-2;
    background: $background;
}


#coding-sidebar-toggle-button {
    dock: left;
    width: $ds-size-3;
    height: $ds-size-3;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    padding: $ds-space-0;
    text-align: center;
    background: $surface;
}

#coding-sidebar-toggle-button.collapsed {
    dock: left;
    margin-left: $ds-space-0;
}


.coding-view-area {
    height: $ds-height-full;
    width: $ds-width-full;
    padding: $ds-space-1;
}


.coding-view-area .pane-title {
    text-style: bold underline;
    margin-bottom: $ds-space-1;
    width: $ds-width-full;
    text-align: center;
}


#coding-view-repo-copy-paste Vertical {
    height: auto;
    align: center middle;
    padding: $ds-space-2;
}

#coding-view-repo-copy-paste Label {
    margin-bottom: $ds-space-2;
    text-align: center;
}

#open-repo-selector {
    width: auto;
    min-width: $ds-size-30;
    height: $ds-size-3;
    margin-top: $ds-space-2;
}

/* ===== MODULE: features/_tab_dropdown.tcss ===== */





#tab-dropdown-container {
    dock: top;
    width: $ds-width-full;
    height: $ds-size-3;
    padding: $ds-space-0 $ds-space-1;
    background: $panel;
    border-bottom: solid $border;
    margin: $ds-space-0;
    align: center middle;
}


#tab-dropdown-select {
    width: $ds-size-30;
    height: $ds-height-full;
    background: $panel;
    color: $text;
    border: solid $border;
    border-bottom: solid $border;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
}


#tab-dropdown-select:hover {
    background: $panel-lighten-1;
    color: $text;
}


#tab-dropdown-select:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}


#tab-dropdown-select SelectOverlay {
    background: $background;
    border: solid $border;
    max-height: $ds-size-20;
    margin-top: $ds-space-0;
    width: auto;
    min-width: $ds-size-30;

}


#tab-dropdown-select SelectOverlay Option {
    padding: $ds-space-0 $ds-space-2;
    background: $panel;
    color: $text-muted;
    min-height: $ds-size-3;
}


#tab-dropdown-select SelectOverlay Option:hover {
    background: $surface-lighten-1;
    color: $text;
}


#tab-dropdown-select SelectOverlay Option.-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}


#tab-dropdown-select:disabled {
    opacity: 0.6;
    background: $panel-darken-1;
    color: $text-muted;
}


#tab-dropdown-select.-loading {
    color: $text-muted;
}




#content {
    margin-top: $ds-space-0;
}

/* ===== MODULE: features/_watchlists.tcss ===== */


#wc-empty-actions {
    height: auto;
    margin: $ds-space-1 $ds-space-0;
}

.watchlists-read-mode #content-body-scroll {
    height: $ds-height-fill;
    min-height: $ds-size-1;
    overflow-y: auto;
}


#content-actions {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-size-horizontal: 0;
}

#content-actions Button {
    width: auto;
    min-width: $ds-size-0;
}

#content-position {
    width: $ds-width-fill;
}

.watchlists-tab-strip .watchlists-tab.is-active {
    border: none;
    text-style: bold underline;
}

.watchlists-tab-strip .watchlists-tab.is-active:focus,
.watchlists-tab-strip .watchlists-tab.is-active:hover:focus {
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: bold underline;
    outline: none;
    border: none;
}


.watchlist-tree .watchlist-tree-root.is-active,
.watchlist-tree .watchlist-tree-watchlist.is-active,
.watchlist-tree .watchlist-tree-source.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
}


.watchlist-tree .watchlist-tree-root.is-active:focus,
.watchlist-tree .watchlist-tree-watchlist.is-active:focus,
.watchlist-tree .watchlist-tree-source.is-active:focus,
.watchlist-tree .watchlist-tree-root.is-active:hover:focus,
.watchlist-tree .watchlist-tree-watchlist.is-active:hover:focus,
.watchlist-tree .watchlist-tree-source.is-active:hover:focus {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold;
    outline: none;
}


WatchlistNameDialog,
WatchlistSourcePickerDialog,
WatchlistPickerDialog {
    align: center middle;
}


BriefingPresetModal {
    align: center middle;
}


KeptBriefingsModal {
    align: center middle;
}


SnapshotViewModal {
    align: center middle;
}

/* ===== MODULE: features/_lab.tcss ===== */


#lab-mode-strip Button.lab-mode-chip {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
}

#lab-mode-strip .lab-mode-chip.is-active {
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

#lab-mode-strip .lab-mode-chip.is-active:focus,
#lab-mode-strip .lab-mode-chip.is-active:hover:focus {
    outline: none;
    border: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}


#lab-mode-strip .lab-mode-chip:focus,
#lab-mode-strip .lab-mode-chip:hover:focus {
    text-style: bold;
    outline: none;
}



.lab-workbench {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

#lab-rail {
    width: $ds-width-fill;
    min-width: $ds-size-24;
    max-width: $ds-size-32;
    height: $ds-height-full;
    min-height: $ds-size-0;
    padding: $ds-space-0;
    background: $ds-surface-panel;
    border-right: solid $ds-column-line;
}

#lab-body {
    width: $ds-fr-4;
    min-width: $ds-size-0;
    height: $ds-height-full;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
}


#remote-variant-sort {
    width: $ds-size-24;
    min-width: $ds-size-18;
    margin-left: $ds-space-1;
    margin-bottom: $ds-space-0;
}

RemoteView.-narrow #remote-variant-sort {
    width: $ds-width-full;
    min-width: $ds-size-0;
    margin-left: $ds-space-0;
    margin-bottom: $ds-space-0;
}


#lab-inspector {
    width: $ds-fr-2;
    min-width: $ds-size-30;
    max-width: $ds-size-50;
    height: $ds-height-full;
    min-height: $ds-size-0;
}


.lab-rail Button.lab-rail-row {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-2;
    border: none;

    text-align: left;
    content-align: left middle;
}


.lab-rail .lab-rail-row.is-active {
    border: none;
    border-left: thick $accent;
    background: $primary;
    color: $ds-text-primary;
    text-style: bold;
}

.lab-rail .lab-rail-row.is-active:focus,
.lab-rail .lab-rail-row.is-active:hover:focus {
    outline: none;
    border: none;
    border-left: thick $accent;
    background: $primary;
    color: $ds-text-primary;
    text-style: bold;
}

.lab-rail .lab-rail-row:focus,
.lab-rail .lab-rail-row:hover:focus {
    outline: none;
    background: $ds-surface-raised;
    text-style: underline;
}


.lab-rail-section {
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin-top: $ds-space-1;
    color: $accent;
    text-style: bold;
}


#lab-header-row {
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-panel;
}

.lab-header-inline {
    layout: horizontal;
    width: $ds-width-fill;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    border: none;
    background: $ds-surface-panel;
}


#lab-header-row .lab-header-inline {
    padding: $ds-space-0;
}

.lab-header-inline .workbench-header-title {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
}

.lab-header-inline .workbench-header-subtitle {
    display: block;
    width: $ds-width-fill;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-left: $ds-space-2;
}

.lab-header-inline .workbench-header-status {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-left: $ds-space-2;
}


.lab-status-chip {
    width: auto;
    max-width: $ds-percent-40;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
    text-overflow: ellipsis;
}


.lab-header-inline .workbench-header-title {
    min-width: $ds-size-6;
}


.lab-mode-stts #lab-rail {
    min-width: $ds-size-28;
    max-width: $ds-size-34;
}


.lab-mode-evals #lab-rail {
    min-width: $ds-size-30;
    max-width: $ds-size-38;
}


#lab-rail #evals-library-pane,
#lab-body #evals-detail-pane,
#lab-inspector #evals-inspector-pane {
    border: none;
    background: transparent;
    min-height: $ds-size-0;
    padding: $ds-space-0;
}


#lab-rail #evals-library-pane,
#lab-inspector #evals-inspector-pane {
    height: auto;
}


#lab-body #evals-detail-pane {
    height: $ds-height-full;
}


#lab-rail .evals-rail-empty-actions {
    layout: vertical;
    height: auto;
}

#lab-rail .evals-rail-empty-actions Button {
    width: $ds-width-full;
}


.speech-pane {
    height: $ds-height-fill;
    padding: $ds-space-0 $ds-space-1;
    overflow-y: auto;
}

.speech-pane-title {
    height: $ds-size-1;
    min-height: $ds-size-1;
    text-style: bold;
    color: $ds-status-info;
}

#speech-playground-actions {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}


.speech-input {
    height: $ds-height-fill;
    min-height: $ds-size-5;
    margin: $ds-space-1 $ds-space-0;
    border: solid $ds-grid-line;
}

.speech-input:focus {
    border: solid $ds-input-focus-border;
}

.speech-chip-row {
    height: $ds-size-1;
    min-height: $ds-size-1;
}


.speech-chip {
    width: auto;
    max-width: $ds-size-30;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin-right: $ds-space-1;
    color: $ds-text-muted;
    background: $ds-surface-panel;
    text-overflow: ellipsis;
}

.speech-status-line {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-top: $ds-space-1;
    color: $ds-status-warning;
}

.speech-readiness-line {
    height: auto;
    min-height: $ds-size-1;
    margin-top: $ds-space-1;
    color: $ds-status-info;
}

.speech-detail-line {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
}

.audio-cpp-runtime-card {
    height: auto;
    min-height: $ds-size-1;
    margin-top: $ds-space-1;
}

.audio-cpp-runtime-status {
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-primary;
    text-style: bold;
}

.audio-cpp-runtime-pending,
.audio-cpp-runtime-reason {
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
}

.audio-cpp-diagnostics-warning {
    height: auto;
    min-height: $ds-size-1;
    color: $ds-status-warning;
}

.audio-cpp-diagnostics-lines {
    height: auto;
    min-height: $ds-size-1;
    max-height: $ds-size-12;
    overflow-y: auto;
    color: $ds-text-muted;
}

.audio-cpp-diagnostics-lines:focus {
    outline: heavy $ds-action-focus;
    background: $ds-focus-bg;
    color: $ds-text-primary;
    scrollbar-color-active: $ds-action-focus;
}

#audio-cpp-runtime-actions {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

#audio-cpp-runtime-actions Button.workbench-action {
    width: auto;
    min-width: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-2 $ds-space-0 $ds-space-0;
    border: none;
}

.speech-split-stacked #audio-cpp-runtime-actions {
    layout: vertical;
    height: $ds-size-3;
    min-height: $ds-size-3;
}

.speech-split-stacked #audio-cpp-runtime-actions Button.workbench-action {
    width: $ds-width-full;
    margin: $ds-space-0;
    text-align: left;
    content-align: left middle;
}


#speech-playground-actions Button.workbench-action {
    width: auto;
    min-width: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-2 $ds-space-0 $ds-space-0;
    border: none;
}



.speech-section-head {
