/* ===== MODULE: core/_variables.tcss ===== */
/* ========================================
 * CORE: Variables and Constants
 * ======================================== 
 * CSS variables, color definitions, and sizing constants
 * Used throughout the application
 * ======================================== */

$ds-surface-panel: $panel;
$ds-surface-raised: $surface;
$ds-surface-inspector: $surface;
$ds-grid-line: $surface-lighten-1;
$ds-column-line: $surface-lighten-2;
$ds-text-primary: $text;
$ds-text-muted: $text-muted;
$ds-text-disabled: $text-disabled;
$ds-action-focus: $primary;
$ds-focus-fg: $ds-text-primary;
/* TASK-345: the focus background must be visibly distinct from resting
   surfaces — it previously aliased $ds-surface-raised (= $surface), which
   nullified the non-obscuring focus contract's own mechanism (~1.1:1 focus
   shifts measured live; an invisible-focus Tab+Enter activated 'Save as…').
   A raised steel-blue, ~3:1 against the dark control/panel surfaces, still
   muted enough to keep the contract's no-accent character. */
$ds-focus-bg: #51677e;
$ds-focus-accent: $primary;
$ds-input-focus-border: $primary;
/* task-1586: this token still aliased $ds-surface-raised (= $surface),
   re-creating the exact nullified-focus failure the comment above
   documents — settings fields' focus bg swap was a no-op. Point it at
   the corrected focus surface. */
$ds-input-focus-bg: $ds-focus-bg;
$ds-input-focus-accent: $primary;
/* task-1586 control convention: editable fields carry a one-column left
   edge at rest — presence of the edge (a structural marker), not its
   color, distinguishes controls from prose. Muted at rest (cozy), the
   edge flips to thick $ds-action-focus on focus. Left borders cost a
   column, never a row, so dense one-row forms keep their height. */
$ds-control-edge: $surface-lighten-2;
$ds-status-ready: $success;
$ds-status-running: $primary;
$ds-status-info: $accent;
$ds-status-warning: $warning;
$ds-status-approval-required: $warning;
$ds-status-blocked: $error;
$ds-status-error: $error;
$ds-status-paused: $warning;
$ds-status-unsaved: $warning;
$ds-status-recovered: $success;
$ds-authority-local: $success;
$ds-authority-server: $primary;
$ds-authority-workspace: $accent;
$ds-authority-remote-only: $warning;
$ds-source-role-context: $accent;
$ds-source-role-evidence: $accent;
$ds-source-role-editable-target: $warning;
$ds-source-role-output-seed: $secondary;
$ds-destination-header-height: 1;
$ds-destination-compact-strip-height: 1;
$ds-home-dashboard-grid-height: 18;
$ds-home-control-button-height: 1;
$ds-home-compact-row-height: 1;
$ds-home-followup-row-height: 6;
$ds-console-workspace-grid-height: 1fr;
$ds-console-control-bar-height: 1;
$ds-console-composer-height: 5;
$ds-library-mode-chip-height: 1;
$ds-library-mode-chip-min-width: 10;
$ds-library-source-action-width: auto;
$ds-library-source-action-min-width: 0;
$ds-library-source-action-height: 1;
$ds-library-source-browser-width: 31;

/* ===== MODULE: core/_reset.tcss ===== */
/* ========================================
 * CORE: Reset/Normalize
 * ======================================== 
 * Base resets and default styles
 * ======================================== */

/* Visible non-obscuring keyboard focus fallback.
 *
 * "Non-obscuring" is the intent, not a guarantee: Textual paints an `outline`
 * OVER the widget's outermost rendered lines rather than around them, so for
 * any widget that draws meaningful content or click metadata on its own
 * perimeter this rule DOES obscure. `DataTable` is the case that bites --
 * see the TASK-1160 block in components/_lists.tcss, which opts every table
 * out of this rule and replaces the cue with content-safe recolouring. Prefer
 * that pattern over adding another screen-local `outline: none`. */
*:focus {
    outline: solid $ds-focus-accent;
}

/* REMOVED: These rules were causing layout shifts and visual issues */
/* *:hover { border: none; } */
/* *:focus-within { border: none; } */

/* Widgets should maintain consistent dimensions across all states */
/* Focus and hover states should only change colors, not layout */

/* ===== MODULE: core/_base.tcss ===== */
/* ========================================
 * CORE: Base Styles
 * ======================================== 
 * Root elements: Screen, Header, Footer
 * Foundation for the entire application
 * ======================================== */

Screen { layout: vertical; }
Header { dock: top; height: 1; background: $panel; }
Footer { dock: bottom; height: 1; background: $panel; }
#content { height: 1fr; width: 100%; }

/* App-wide scrollbar defaults (TASK-394). Consolidated here -- a deliberate
 * foundation rule -- from the two bare `VerticalScroll` selectors that had
 * leaked out of feature modules (the splash/theme module and _conversations);
 * this is the union of what both set, so the effective app-wide scrollbar is
 * unchanged. */
VerticalScroll {
    scrollbar-background: $surface-darken-1;
    scrollbar-color: $primary;
    scrollbar-color-hover: $primary-lighten-1;
    scrollbar-color-active: $primary-lighten-2;
    scrollbar-size: 1 1;
}

/* task-1562: keep transient toasts off the right-hand inspector rails.
 * The default bottom-right ToastRack stacks directly over the Scope
 * Inspector (Settings) and Inspector (Console) -- the panes that carry
 * recovery/boundary copy. Bottom-center floats over transient flowing
 * content instead of persistent guidance. */
Toast {
    /* task-1562: keep transient toasts off the right-hand inspector rails
     * (Scope Inspector in Settings, Inspector in Console) -- they carry
     * recovery/boundary copy. The rack's built-in right-bottom align and
     * its own margins resist app-tier overrides, but a margin on the
     * Toast itself reliably offsets it from that anchor; 46 cells clears
     * the inspector column at supported widths. */
    margin-right: 46;
    /* task-1625: full tinted border per severity instead of the stock
       side-stripe -- DESIGN.md's Don'ts prohibit side-stripe-only
       callouts (>1-cell colored border-left). */
    border: round $ds-grid-line;
    border-left: round $ds-grid-line;
}
Toast.-information {
    border: round $ds-status-info;
    border-left: round $ds-status-info;
}
Toast.-warning {
    border: round $ds-status-warning;
    border-left: round $ds-status-warning;
}
Toast.-error {
    border: round $ds-status-error;
    border-left: round $ds-status-error;
}
/* Qodo PR #1139: three call sites pass severity="success" -- not a
   Textual SeverityLevel, but the Toast still gains a "-success" class,
   which previously fell through unstyled. */
Toast.-success {
    border: round $ds-status-ready;
    border-left: round $ds-status-ready;
}

