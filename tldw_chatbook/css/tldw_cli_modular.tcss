/* ===== MODULE: core/_reset.tcss ===== */



*:focus {
    outline: solid $ds-focus-accent;
}








/* ===== MODULE: core/_base.tcss ===== */




Screen { layout: vertical; }
Header { dock: top; height: $ds-size-1; background: $panel; }
Footer { dock: bottom; height: $ds-size-1; background: $panel; }
#content { height: $ds-height-fill; width: $ds-width-full; }


VerticalScroll {
    scrollbar-background: $surface-darken-1;
    scrollbar-color: $primary;
    scrollbar-color-hover: $primary-lighten-1;
    scrollbar-color-active: $primary-lighten-2;
    scrollbar-size: 1 1;
}


Toast {

    margin-right: $ds-size-46;

    border: round $ds-grid-line;
    border-left: round $ds-grid-line;
}
Toast.-information {
    border: round $ds-status-info;
    border-left: round $ds-status-info;
}
Toast.-warning {
    border: round $ds-status-warning;
    border-left: round $ds-status-warning;
}
Toast.-error {
    border: round $ds-status-error;
    border-left: round $ds-status-error;
}

Toast.-success {
    border: round $ds-status-ready;
    border-left: round $ds-status-ready;
}

/* ===== MODULE: core/_typography.tcss ===== */


/* ===== MODULE: layout/_windows.tcss ===== */





.window {
    height: $ds-height-full;
    width: $ds-width-full;
    layout: horizontal;
    overflow: hidden;
}

.placeholder-window {
    align: center middle;
    background: $panel;
    display: none;
}

/* ===== MODULE: layout/_tabs.tcss ===== */




#tabs { dock: top; height: $ds-size-4; background: $background; padding: $ds-space-0 $ds-space-1; }
#tabs Button {
    width: $ds-width-fill;
    height: $ds-height-full;
    min-height: $ds-size-4;
    border: none;
    background: $panel;
    color: $text-muted;
    padding: $ds-space-0 $ds-space-1;
}
#tabs Button:hover {
    background: $panel-lighten-1;
    color: $text;
}
#tabs Button.-active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}


#tab-links-container {
    dock: top;
    height: $ds-size-4;
    background: $panel;
    padding: $ds-space-0 $ds-space-1;
    border: solid $accent;
}

#tab-links-inner {
    layout: horizontal;
    height: auto;
    width: auto;
    background: transparent;
    margin: $ds-space-0;
    padding: $ds-space-0;
}

#tab-links-inner > Static {
    width: auto;
    height: $ds-size-1;
    margin: $ds-space-0;
}

.tab-link {
    color: $text-muted;
    padding: $ds-space-0 $ds-space-1;
    text-style: none;
    width: auto;
    height: auto;
}

.tab-link:hover {
    color: $text;
    text-style: underline;
    background: $panel-lighten-1;
}

.tab-link.-active {
    color: $ds-focus-fg;
    text-style: bold underline;
    background: transparent;
}

.tab-link.-active:hover {
    text-style: bold underline;
}

Tab.-active,
Tabs:focus .-active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.tab-separator {
    color: $text-muted;
    padding: $ds-space-0;
    width: auto;
    height: $ds-size-1;
}


.tab-group-separator {
    color: $accent;
    padding: $ds-space-0 $ds-space-2;
    width: auto;
    height: $ds-size-1;
    text-style: bold;
}


#tabs .tab-group-separator {
    width: auto;
    min-width: $ds-size-3;
    height: $ds-height-full;
    min-height: $ds-size-4;
    background: transparent;
    color: $accent;
    border: none;
    padding: $ds-space-0 $ds-space-1;
}

/* ===== MODULE: layout/_sidebars.tcss ===== */







.enhanced-sidebar {
    height: $ds-height-full;
    background: $boost;
}


.sidebar-header {
    height: $ds-size-3;
    padding: $ds-space-0 $ds-space-1;
    background: $surface;
    border-bottom: solid $surface-lighten-1;
    align: center middle;
}

.sidebar-title {
    text-style: bold;
    color: $text;
    text-align: left;
}


.search-container {
    height: $ds-size-3;
    padding: $ds-space-0 $ds-space-1;
    background: transparent;
    border-bottom: none;
}

.search-input {
    width: $ds-width-full;
    border: round $surface-lighten-1;
    background: $background;
}




.quick-actions-bar {
    height: $ds-size-3;
