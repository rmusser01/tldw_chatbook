    grid-size: 2;
    grid-rows: 1;
    grid-gutter: 0 1;
    height: auto;
    margin-top: $ds-space-1;
}

.speech-split-stacked #speech-result-actions {
    grid-size: 1;
}


.speech-axis-cell {
    height: $ds-size-1;
    min-height: $ds-size-1;
}

.speech-axis-cell .speech-chip {
    width: $ds-size-10;
    max-width: $ds-size-10;
    margin: $ds-space-0;
    background: transparent;
}

.speech-axis-control {
