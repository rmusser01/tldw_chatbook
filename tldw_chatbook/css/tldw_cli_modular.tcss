    color: $text;
    background: $surface;
    text-style: bold;
    text-align: center;
}


#chat-notes-expand-button {
    color: $text !important;
}


.sidebar-button {
    width: $ds-width-full;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-2;
