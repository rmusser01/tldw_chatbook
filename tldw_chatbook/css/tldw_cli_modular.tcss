/* ========================================
 * Empty State Styles
 * ======================================== */

.empty-state-container {
    width: 100%;
    height: 100%;
    align: center middle;
    padding: 3;
}

.empty-state-content {
    align: center middle;
    width: auto;
}

.empty-state-icon {

