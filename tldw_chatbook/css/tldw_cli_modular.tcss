    height: $ds-height-full;
    max-height: $ds-height-full;
    padding: $ds-space-0 $ds-space-1;
}

ConsoleWorkspaceFilesModal.-short #console-workspace-files-fold {
    display: block;
}

ConsoleWorkspaceFilesModal.-short #console-workspace-files-body {
