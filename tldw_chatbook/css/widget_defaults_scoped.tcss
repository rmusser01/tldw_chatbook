    BuddyConversationModal #buddy-conversation { width: 90; max-width: 96%; height: 90%; max-height: 52;
        border: round $accent; background: $panel; padding: 0 1; }
    BuddyConversationModal #buddy-conversation-title { height: 2; text-style: bold; }
    BuddyConversationModal #buddy-activity, BuddyConversationModal #buddy-reply-notice { height: auto; }
    BuddyConversationModal #buddy-conversation-body { height: 1fr; min-height: 2; }
    BuddyConversationModal #buddy-transcript-navigation { height: 1; }
    BuddyConversationModal #buddy-transcript-navigation Button.buddy-conversation-modal-button { height: 1; min-width: 8; width: auto; }
    BuddyConversationModal #buddy-transcript { height: auto; padding: 1 0; }
    BuddyConversationModal #buddy-reply { height: 5; min-height: 3; }


    BuddyConversationModal #buddy-actions { height: 3; align-horizontal: right; }
    BuddyConversationModal #buddy-actions Button.buddy-conversation-modal-button { min-width: 8; width: auto; margin-left: 1; }
    BuddyConversationModal #buddy-reply-notice { color: $text-muted; }

/* ===== WIDGET: BuddyManagementModal (Widgets/Persona_Widgets/buddy_management_modal.py) ===== */


    BuddyManagementModal #buddy-management {
        width: 78; max-width: 96%; height: 90%; max-height: 48;
        border: round $accent; background: $panel; padding: 0 1;
    }
    BuddyManagementModal #buddy-management-title { height: 2; text-style: bold; padding-top: 1; }
    BuddyManagementModal #buddy-management-body { height: 1fr; padding-right: 1; }
    BuddyManagementModal .buddy-section { height: auto; margin-top: 1; text-style: bold; }
    BuddyManagementModal .buddy-help { height: auto; color: $text-muted; }
    BuddyManagementModal #buddy-management-body Select.buddy-management-modal-select, BuddyManagementModal #buddy-management-body Input.buddy-management-modal-input { width: 100%; }
    BuddyManagementModal .buddy-toggle-row { height: 3; align-vertical: middle; }
    BuddyManagementModal .buddy-toggle-row Static.buddy-management-modal-static { width: 1fr; height: auto; }
    BuddyManagementModal .buddy-toggle-row Switch { width: auto; }
    BuddyManagementModal #buddy-size { height: 3; }
    BuddyManagementModal #buddy-management-body #buddy-size Input.buddy-management-modal-input { width: 1fr; min-width: 4; }
    BuddyManagementModal #buddy-size Static.buddy-management-modal-static { width: 9; height: 3; content-align: left middle; }
    BuddyManagementModal #buddy-size #buddy-height-label { width: 10; padding-left: 1; }
    BuddyManagementModal #buddy-preview { height: auto; max-height: 12; content-align: center middle; }
    BuddyManagementModal #buddy-artwork-pages { height: 3; }
    BuddyManagementModal #buddy-artwork-pages Button.buddy-management-modal-button { width: auto; min-width: 10; }
    BuddyManagementModal #buddy-artwork-page { width: 1fr; content-align: center middle; }
    BuddyManagementModal #buddy-preview-actions { height: 3; }
    BuddyManagementModal #buddy-management-body #buddy-preview-state { width: 1fr; min-width: 10; }
    BuddyManagementModal #buddy-preview-button { width: auto; min-width: 11; }
    BuddyManagementModal #buddy-form-error, BuddyManagementModal #buddy-import-error { height: auto; color: $error; }
    BuddyManagementModal #buddy-advanced { height: auto; padding: 0; }
    BuddyManagementModal #buddy-preview-button:focus { text-style: bold reverse; }
    BuddyManagementModal #buddy-management-actions { height: 3; min-height: 3; align-horizontal: right; }
    BuddyManagementModal #buddy-management-actions Button.buddy-management-modal-button { width: auto; min-width: 10; margin-left: 1; }

/* ===== WIDGET: BuddyWorkspaceModal (Widgets/Persona_Widgets/buddy_workspace_modal.py) ===== */


    BuddyWorkspaceModal #buddy-inbox {
        width: 82; max-width: 96%; height: 85%; max-height: 42;
        border: round $accent; background: $panel; padding: 0 1;
    }
    BuddyWorkspaceModal #buddy-inbox-title { height: 2; text-style: bold; padding-top: 1; }
    BuddyWorkspaceModal #buddy-inbox-help { height: auto; color: $text-muted; }
    BuddyWorkspaceModal #buddy-inbox-list { height: 1fr; margin-top: 1; }
    BuddyWorkspaceModal #buddy-inbox-error { height: auto; color: $error; }
    BuddyWorkspaceModal #buddy-inbox-actions { height: 3; min-height: 3; align-horizontal: right; }
    BuddyWorkspaceModal #buddy-inbox-actions Button.buddy-workspace-modal-button { width: auto; min-width: 8; margin-left: 1; }

/* ===== WIDGET: ProjectSkillsImportModal (Widgets/project_skills_import_modal.py) ===== */



    ProjectSkillsImportModal #project-skills-modal {
        width: 76;
        height: auto;
        max-height: 34;
        border: tall gray;
        background: black;
        padding: 1 2;
    }

    ProjectSkillsImportModal #project-skills-provenance {
        color: $text-muted;
        margin: 0 0 1 0;
    }

    ProjectSkillsImportModal #project-skills-trust-line {
        color: $text-muted;
        margin: 0 0 1 0;
    }

    ProjectSkillsImportModal #project-skills-post-trust-line {
        color: $text-muted;
        margin: 0 0 1 0;
    }

    ProjectSkillsImportModal #project-skills-rows {
        height: auto;
        max-height: 18;
        margin: 0 0 1 0;
    }

    ProjectSkillsImportModal #project-skills-results {
        height: auto;
        max-height: 18;
        margin: 0 0 1 0;
    }

    ProjectSkillsImportModal #project-skills-footer {
        color: $text-muted;
        height: auto;
    }

    ProjectSkillsImportModal #project-skills-actions {
        height: auto;
        margin: 1 0 0 0;
        align-horizontal: right;
    }

/* ===== WIDGET: WorkspaceCreateModal (Widgets/workspace_create_modal.py) ===== */



    WorkspaceCreateModal #workspace-create-modal {
        width: 72;
        height: auto;
        max-height: 32;
        border: tall $surface-lighten-2;
        background: $surface;
        color: $text;
        padding: 1 2;
    }

    WorkspaceCreateModal #workspace-create-explainer {
        color: $text-muted;
        margin: 0 0 1 0;
    }

    WorkspaceCreateModal #workspace-create-error {
        color: $error;
        height: auto;
    }

    WorkspaceCreateModal #workspace-create-folder-row {
        height: auto;
    }

    WorkspaceCreateModal #workspace-create-folder-path {
        width: 1fr;
    }

    WorkspaceCreateModal #workspace-create-actions {
        height: auto;
        margin: 1 0 0 0;
        align-horizontal: right;
    }

    WorkspaceCreateModal #workspace-create-folder-list {
        height: auto;
    }

    WorkspaceCreateModal .workspace-create-folder-item {
        height: auto;
    }

    WorkspaceCreateModal .workspace-create-folder-locator {
        width: 1fr;
        content-align: left middle;
    }

/* ===== WIDGET: WorkspacePersonaDefaultModal (Widgets/workspace_persona_default.py) ===== */


    WorkspacePersonaDefaultModal #workspace-default-dialog { width: 68; max-width: 95%; height: auto; max-height: 95%;
        background: $surface; border: tall $primary; padding: 1 2; }
    WorkspacePersonaDefaultModal #workspace-default-form { height: 1fr; max-height: 17; }
    WorkspacePersonaDefaultModal #workspace-default-actions { height: 3; align-horizontal: right; }
    WorkspacePersonaDefaultModal #workspace-default-error { height: auto; color: $error; }
