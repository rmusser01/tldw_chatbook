    SkillRecoveryReviewModal #skills-recovery-review { width: 90%; max-width: 110; height: 90%; border: tall $accent; padding: 1 2; background: $surface; }
    SkillRecoveryReviewModal #skills-recovery-scroll { height: 1fr; }
    SkillRecoveryReviewModal #skills-recovery-scroll Static.skill-recovery-review-modal-static { height: auto; margin-bottom: 1; }
    SkillRecoveryReviewModal #skills-recovery-actions { height: 3; align-horizontal: right; }
    SkillRecoveryReviewModal #skills-recovery-actions Button.skill-recovery-review-modal-button { width: auto; margin-left: 1; }
    SkillRecoveryReviewModal #skills-recovery-status { height: auto; color: $warning; }

/* ===== WIDGET: TrajectoryScreen (UI/Screens/trajectory_screen.py) ===== */


    TrajectoryScreen #trajectory-screen {
        width: 100%;
        height: 100%;
        layout: vertical;
        padding: 0 1;
    }
    TrajectoryScreen #trajectory-title {
        height: auto;
        max-height: 3;
        color: $text;
        background: $panel;
    }
    TrajectoryScreen #trajectory-state {
