    }
    TrajectoryScreen #trajectory-inspector-content {
        width: 100%;
        height: auto;
    }
    TrajectoryScreen #trajectory-inspector-overflow {
        height: 1;
        color: $text-muted;
    }



    TrajectoryScreen #trajectory-hints {
        height: 1;
        color: $text-disabled;
