/* ===== WIDGET: MainNavigationBar (UI/Navigation/main_navigation.py) ===== */



    MainNavigationBar .main-nav {
        height: 100%;
        width: 1fr;
        layout: horizontal;
        align: left middle;
        padding: 0;
        margin: 0;
        overflow-x: auto;
        scrollbar-size-horizontal: 0;
    }

    MainNavigationBar .nav-button {
        margin: 0;
        padding: 0;
        min-width: 4;
        background: $surface-darken-1;
        border: solid $surface-lighten-2;
        height: 3;
        min-height: 3;
        content-align: center middle;
    }

    MainNavigationBar .nav-button:hover {
        background: $surface;
        border: solid $primary-lighten-1;
        text-style: bold;
    }

    MainNavigationBar .nav-button:focus {
        background: $surface;
        border: solid $primary;
        text-style: bold underline;
        color: $text;
        outline: none;
    }

    MainNavigationBar .nav-button.is-active {
        background: $primary-darken-1;
        border: solid $primary;
        text-style: bold;
        color: $text;
    }

    MainNavigationBar .nav-button.is-active:focus {
        background: $primary-darken-1;
        border: solid $primary;
        text-style: bold underline;
        color: $text;
        outline: none;
    }

    MainNavigationBar .nav-group-separator {
        margin: 0;
        padding: 0 1;
        color: $accent;
        width: auto;
        text-style: bold;
    }


    MainNavigationBar .nav-button.nav-button-clip-ghost,
    MainNavigationBar .nav-button.nav-button-clip-ghost:hover,
    MainNavigationBar .nav-button.nav-button-clip-ghost:focus,
    MainNavigationBar .nav-button.nav-button-clip-ghost.is-active,
    MainNavigationBar .nav-button.nav-button-clip-ghost.is-active:focus,
    MainNavigationBar .nav-button.nav-button-clip-ghost:disabled {
        background: $background !important;
        color: $background !important;
        text-style: none;
        opacity: 100% !important;
        text-opacity: 100% !important;
    }

    MainNavigationBar .nav-overflow-hint {
        width: auto;
        min-width: 0;
        padding: 0 1;
        height: 3;
        min-height: 3;
        content-align: center middle;
        color: $text-muted;
        background: transparent;
        border: none;
    }

    MainNavigationBar .nav-overflow-hint:hover {
        color: $text;
        background: $surface;
        text-style: bold;
    }

    MainNavigationBar .nav-overflow-hint:focus {
        background: $surface;
        color: $text;
        text-style: bold underline;
    }

