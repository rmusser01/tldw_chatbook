/* ========================================
 * CORE: Variables and Constants
 * ======================================== 
 * CSS variables, color definitions, and sizing constants
 * Used throughout the application
 * ======================================== */

$ds-surface-panel: $panel;
$ds-surface-raised: $surface;
$ds-surface-inspector: $surface;
$ds-grid-line: $surface-lighten-1;
$ds-column-line: $surface-lighten-2;
$ds-text-primary: $text;
$ds-text-muted: $text-muted;
$ds-text-disabled: $text-disabled;
$ds-action-focus: $primary;
$ds-focus-fg: $ds-text-primary;
/* TASK-345: the focus background must be visibly distinct from resting
   surfaces — it previously aliased $ds-surface-raised (= $surface), which
   nullified the non-obscuring focus contract's own mechanism (~1.1:1 focus
   shifts measured live; an invisible-focus Tab+Enter activated 'Save as…').
   task-31264: the steel-blue literal (#51677e) that replaced the alias was
   tuned for dark canvases only, and a `$name: value` here shadows every
   theme's variables dict for this source (per-source variable scope) — so
   light themes painted a frozen slate focus. Textual's generated
   block-cursor-blurred-background ($primary at 30%) gives a polarity-aware
   tint on every theme; the Button:focus rule's bold-underline cues carry
   the handful of themes whose primary sits close to their surface. */
$ds-focus-bg: $block-cursor-blurred-background;
$ds-focus-accent: $primary;
$ds-input-focus-border: $primary;
/* task-1586: this token still aliased $ds-surface-raised (= $surface),
   re-creating the exact nullified-focus failure the comment above
   documents — settings fields' focus bg swap was a no-op. Point it at
   the corrected focus surface. */
$ds-input-focus-bg: $ds-focus-bg;
$ds-input-focus-accent: $primary;
/* task-1586 control convention: editable fields carry a one-column left
   edge at rest — presence of the edge (a structural marker), not its
   color, distinguishes controls from prose. Muted at rest (cozy), the
   edge flips to thick $ds-action-focus on focus. Left borders cost a
   column, never a row, so dense one-row forms keep their height. */
$ds-control-edge: $surface-lighten-2;
$ds-status-ready: $success;
$ds-status-running: $primary;
$ds-status-info: $accent;
$ds-status-warning: $warning;
$ds-status-approval-required: $warning;
$ds-status-blocked: $error;
$ds-status-error: $error;
/* task-2230 (a11y): $error measures 3.06:1 on the app's dark canvases --
   an AA fail, and LESS readable than ordinary help text (7.21:1), which
   inverts the importance hierarchy. This token is the readable error
   foreground for text and marks that must be READ, while $ds-status-error
   stays the decorative status hue. task-31264: the original literal
   (#ff8fa3) was dark-canvas-only and, being a per-source definition, could
   not be overridden by any theme — light themes rendered error text at
   1.4–2.0:1. Textual's generated $text-error is the same idea computed per
   theme polarity (agentic_terminal resolves to #FF929C, within a hair of
   the old hand-tuned value). */
$ds-status-error-readable: $text-error;
/* task-14824 (3): Textual's stock placeholder colour ($text-disabled)
   measured 3.52:1 on an enabled ingest field and 3.49:1 on a disabled one
   -- below AA for normal text, and a 0.03 delta means a placeholder is
   also useless as a disabled-state cue. The token must clear AA against
   the field surfaces while staying obviously dimmer than a real value, so
   a placeholder still reads as an absent value rather than as content.
   task-31264: the grey literal (#8a8a8a) that implemented this was
   measured on dark surfaces only and shadowed every theme (per-source
   variable scope; 2.2–3.2:1 on the light themes). $text-muted is the same
   dimmer-but-readable role generated per theme polarity. */
$ds-text-placeholder: $text-muted;
/* TASK-25822 (a11y): `Button:disabled` stacked `opacity: 50%` ON TOP of an
   already-dim $text-disabled, compositing to a measured 1.34:1 -- a disabled
   primary read as ABSENT, not unavailable, while the dismissive action beside
   it stayed near 14:1 and inverted the dialog's hierarchy. The token must
   clear AA-large on the disabled surface while staying far dimmer than live
   label text, so "disabled" still reads as a state rather than as content.
   task-31264: same polarity story as $ds-text-placeholder above -- the grey
   literal was dark-tuned and theme-frozen; $text-muted is the generated
   polarity-aware equivalent. */
$ds-text-disabled-readable: $text-muted;
$ds-status-paused: $warning;
$ds-status-unsaved: $warning;
$ds-status-recovered: $success;
$ds-authority-local: $success;
$ds-authority-server: $primary;
$ds-authority-workspace: $accent;
$ds-authority-remote-only: $warning;
$ds-source-role-context: $accent;
$ds-source-role-evidence: $accent;
$ds-source-role-editable-target: $warning;
$ds-source-role-output-seed: $secondary;

/* Console transcript speaker accents. Textual exposes whether the active
   theme is dark or light as an App class; the two assistant tones keep the
   same warm semantic role while meeting ordinary-text contrast on both. */
$ds-chat-user-accent: $text-primary;
$ds-chat-user-accent-dark: #8bd5ff;
$ds-chat-user-accent-light: #004d6d;
$ds-chat-assistant-accent-dark: #ffc473;
$ds-chat-assistant-accent-light: #704000;
/* Inline roleplay semantics inside assistant / character Markdown. These are
   separate from the speaker accent so dialogue, action, and emphasis remain
   distinguishable without changing the transcript's structural grammar. */
$ds-chat-rp-speech-dark: #8bd5ff;
$ds-chat-rp-speech-light: #004d6d;
$ds-chat-rp-thought-dark: #2dd4bf;
$ds-chat-rp-thought-light: #0b5d4a;
$ds-chat-rp-action-dark: #d7b2ff;
$ds-chat-rp-action-light: #5e3578;
$ds-chat-rp-strong-dark: #fff0a6;
$ds-chat-rp-strong-light: #665000;
$ds-destination-header-height: 1;
$ds-destination-compact-strip-height: 1;
$ds-home-dashboard-grid-height: 18;
$ds-home-control-button-height: 1;
$ds-home-compact-row-height: 1;
$ds-home-followup-row-height: 6;
$ds-console-workspace-grid-height: 1fr;
$ds-console-composer-height: 1;
$ds-library-mode-chip-height: 1;
$ds-library-mode-chip-min-width: 10;
$ds-library-source-action-width: auto;
$ds-library-source-action-min-width: 0;
$ds-library-source-action-height: 1;
$ds-library-source-browser-width: 31;
