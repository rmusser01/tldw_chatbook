        text-style: bold;
        padding: 1;
        background: $boost;
        width: 100%;
    }
    
    FileExtractionDialog #file-list {
        height: 15;
        margin: 1 0;
    }
    
    FileExtractionDialog #file-preview {
        height: 15;
        border: solid $primary;
        padding: 1;
        margin: 1 0;
    }
    
    FileExtractionDialog .dialog-buttons {
        dock: bottom;
        height: 3;
        align: center middle;
        padding: 1;
    }
    
    FileExtractionDialog .dialog-buttons Button {
        margin: 0 1;
    }
    
    FileExtractionDialog #filename-input {
        width: 100%;
        margin: 1 0;
    }
    

