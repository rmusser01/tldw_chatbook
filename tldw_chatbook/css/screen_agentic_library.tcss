}

#library-collections-capture-url:focus,
#library-collections-capture-title:focus,
#library-collections-capture-tags:focus,
#library-collections-capture-note:focus,
#library-collections-filter-domain:focus,
#library-collections-filter-tags:focus,
#library-collections-filter-date-from:focus,
#library-collections-filter-date-to:focus,
#library-collections-highlight-quote:focus,
#library-collections-highlight-note:focus,
#library-collections-linked-note-id:focus {
    border: tall $ds-input-focus-accent;
    background: $ds-input-focus-bg;
}

#library-collections-items-scroll {
