}

#library-collections-quick-capture-form,
#library-collections-filters-form {
    width: $ds-width-full;
    height: auto;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
}

#library-collections-capture-url,
#library-collections-capture-title,
#library-collections-capture-tags,
