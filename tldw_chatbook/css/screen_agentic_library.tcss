    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
}

#library-collections-page-error,
#library-collections-reader-error,
#library-collections-hard-delete-copy {
    color: $ds-status-error;
}

#library-collections-page-range,
#library-collections-reader-identity,
#library-collections-reader-byline {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    color: $ds-text-muted;
}

#library-collections-reader-title {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-1;
    text-style: bold;
    color: $ds-text-primary;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

#library-collections-read-body,
#library-collections-info-body {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-1;
    margin-top: $ds-space-1;
    padding-bottom: $ds-space-1;
    color: $ds-text-primary;
}

#library-collections-freeform-note {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-6;
    min-height: $ds-size-4;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
}

#library-collections-freeform-note:focus {
    border: tall $ds-input-focus-accent;
    background: $ds-input-focus-bg;
}

#library-collections-primary-toolbar {
    margin-top: $ds-space-1;
    padding-bottom: $ds-space-1;
    border-bottom: solid $ds-grid-line;
}

#library-collections-mode-toolbar {
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

#library-collections-primary-toolbar > Button:focus,
#library-collections-secondary-toolbar > Button:focus,
#library-collections-mode-toolbar > Button:focus,
#library-collections-page-toolbar > Button:focus,
#library-collections-items-toolbar > Button:focus,
#library-collections-sort-toolbar > Button:focus,
#library-collections-archive-receipt > Button:focus {
    background: $ds-input-focus-bg;
    color: $ds-action-focus;
    text-style: bold;
    outline: none;
}

#library-collections-summarize,
#library-collections-listen,
#library-collections-save-offline,
#library-collections-retry-extraction,
#library-collections-hard-delete,
#library-collections-legacy-recovery,
#library-collections-capture-save,
#library-collections-capture-cancel,
#library-collections-capture-refresh,
#library-collections-capture-retry-confirm,
#library-collections-capture-retry-back,
#library-collections-filters-apply,
#library-collections-filters-clear,
#library-collections-highlight-save,
#library-collections-freeform-note-save,
#library-collections-linked-note-save,
#library-collections-legacy-recovery-export,
#library-collections-legacy-recovery-close,
.library-collections-highlight-delete,
.library-collections-linked-note-unlink {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
}

#library-collections-capture-save:focus,
#library-collections-capture-cancel:focus,
#library-collections-capture-refresh:focus,
#library-collections-capture-retry-confirm:focus,
#library-collections-capture-retry-back:focus,
#library-collections-filters-apply:focus,
#library-collections-filters-clear:focus,
#library-collections-highlight-save:focus,
#library-collections-freeform-note-save:focus,
#library-collections-linked-note-save:focus,
#library-collections-legacy-recovery-export:focus,
#library-collections-legacy-recovery-close:focus,
.library-collections-highlight-delete:focus,
.library-collections-linked-note-unlink:focus {
    background: $ds-input-focus-bg;
    color: $ds-action-focus;
    text-style: bold;
    outline: none;
}

#library-collections-action-status,
#library-collections-action-content,
#library-collections-capture-unknown,
#library-collections-capture-retry-warning,
#library-collections-legacy-recovery-heading,
#library-collections-legacy-recovery-content,
.library-collections-highlight-entry,
.library-collections-linked-note-entry {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-1;
}

#library-collections-action-status,
#library-collections-legacy-recovery-heading {
    margin-top: $ds-space-1;
    text-style: bold;
}

#library-collections-capture-unknown,
#library-collections-capture-retry-warning {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $ds-status-warning;
    text-style: bold;
}

#library-collections-action-content,
#library-collections-legacy-recovery-content {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

#library-collections-legacy-recovery-inspector {
    width: $ds-width-full;
    height: auto;
    margin-top: $ds-space-1;
    padding: $ds-space-1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
}

#library-collections-hard-delete-copy {
    width: $ds-width-full;
    height: auto;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    padding: $ds-space-1;
    border: tall $ds-status-error;
    background: $ds-surface-raised;
}

#library-collections-freeform-note-heading,
#library-collections-linked-notes-heading {
    width: $ds-width-full;
    height: auto;
    margin-top: $ds-space-1;
    color: $ds-text-primary;
    text-style: bold;
}

#library-collections-highlights-empty,
#library-collections-linked-notes-empty,
#library-collections-media-provenance {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-muted;
}

#library-collections-archive-receipt {
    margin-top: $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-muted;
}

/* Reader toolbars can be as narrow as 50 columns while Items remains open.
   Textual Button's default 16-column minimum pushed More and Info beyond the
   painted Reader at that width even though both widgets stayed mounted. Keep
   these compact, label-sized rows fully reachable without changing their
   text or focus geometry. task-31633 AC#3 added the More disclosure's own
   row: its four labels only fit the narrow Reader as label-sized buttons. */
#library-media-reader-primary-toolbar > Button,
#library-media-reader-mode-toolbar > Button,
#library-media-reader-more-actions > Button {
    width: auto;
    min-width: $ds-size-0;
    margin: $ds-space-0;
    padding: $ds-space-0;
}

/* task-4025: the Trash view's rows share the media list's row contract
   verbatim (one comma-joined rule, not a forked copy) -- the trash rows
   keep their OWN class only so `_focus_library_list_entry`'s
   `.library-media-row` query can never grab a trash row. */
.library-media-row, .library-media-trash-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-2;
    min-height: $ds-size-2;
    /* task-31633 (critique #5 P1): NO bottom margin. It bought a blank third
       row per item, so a 52-row terminal listed eleven of fifteen seeded
       items. The title/meta rhythm and the `▸` marker separate the items;
       the compact override below has always been margin-free. */
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.library-media-row-selected {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* task-2856 AC1/AC4: entering the Media list now parks real DOM focus on
   the first row and Up/Down move it between rows -- previously this class
   had no dedicated ``:focus`` rule at all and fell back to the generic
   ``*:focus{outline:solid}`` (core/_reset.tcss). `outline: none` suppresses
   the generic fallback (never `outline: heavy`, which eats a compact row's
   label -- round-3 lesson).
   task-31983 (critique #6 P1): `-selected` above uses this SAME background,
   so focus and selection were indistinguishable -- the row the keyboard was
   ON looked exactly like the open row and arrow-nav read as a dead key. The
   `border-left: thick $ds-action-focus` bar is the focus-only, non-colour
   cue `-selected` does NOT carry, so the two stay distinct even when a row
   is both focused AND selected (arrow onto the open row). The left edge
   replaces the 1-column left padding (`padding: 0 1` -> `0 1 0 0`), so the
   label neither shifts nor is clipped and the row never jumps focus<->blur --
   the house focus convention ($ds-control-edge comment, _variables.tcss). */
.library-media-row:focus, .library-media-trash-row:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border-left: thick $ds-action-focus;
    padding: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    outline: none;
}

.library-notes-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-2;
    min-height: $ds-size-2;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

/* task-2856 AC1/AC4: same readable-focus contract as .library-media-row:focus
   above -- entering the Notes list now parks DOM focus on the first row and
   Up/Down move it between rows. task-31983: same focus-only border-left cue
   (padding compensates so the label holds), distinct from any selection. */
.library-notes-row:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border-left: thick $ds-action-focus;
    padding: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    outline: none;
}

/* The adaptive Items pane has its own border and horizontal padding. Size
   the Notes canvas and its scroll owner from the remaining content box;
   `100%`/auto otherwise adds that inset back and clips the final two cells. */
#library-notes-canvas,
#library-notes-list {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    max-width: $ds-width-full;
}

/* task-32127/32128: Button's own 16-cell minimum made "New / Sort: Newest /
   Select" 48 cells wide -- wider than the list pane itself, so Select, the
   Title sort option and the delete receipt's Undo were painted past the
   pane edge. The compact stage already sized these to their content; the
   ordinary stage does the same now, since the pane is never wide enough to
   justify a 16-cell "New". */
#library-notes-canvas .library-canvas-action {
    width: auto;
    min-width: $ds-size-0;
}

/* ...except the branch pagers, which are full-width rows carrying wrapped
   range/status copy, not toolbar buttons. The rule above outranks
   `.library-notes-tree-pager` on specificity, so it has to say so here
   (review round 1). */
#library-notes-canvas .library-notes-tree-pager {
    width: $ds-width-full;
    max-width: $ds-width-full;
}

/* task-32144: a Trash row's title takes the width its Restore button leaves,
   so a long title ellipsizes rather than pushing that button off the pane --
   the same shape the delete receipt's copy uses below. */
.library-notes-trash-row-copy {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    padding: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

/* task-32123: the receipt's copy owns its own row above the two recovery
   actions, so a title too long for the pane ends in an ellipsis instead of
   pushing Undo off the edge. */
#library-notes-delete-receipt-copy {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* task-32127: the browse and transfer toolbars share one row. Each keeps
   its own id (and its compact-stage rules); the trailing group takes the
   leftover width so the raised toolbar background spans the row. */
#library-notes-action-rows {
    layout: horizontal;
    height: auto;
    width: $ds-width-fill;
    min-width: $ds-size-0;
}

.library-notes-folder-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

/* task-31983: same focus-only border-left cue; this row is height 1, so the
   padding swap (0 1 -> 0 1 0 0) keeps the single label cell intact. */
.library-notes-folder-row:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border-left: thick $ds-action-focus;
    padding: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    outline: none;
}

.library-notes-tree-note-row {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
}

.library-notes-tree-pager {
    width: $ds-width-full;
    min-width: $ds-size-0;
    max-width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    text-align: left;
    content-align: left middle;
    text-wrap: wrap;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-muted;
}

.library-notes-tree-pager:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

.library-notes-tree-connected {
    color: $ds-focus-accent;
}

.library-notes-tree-needs-attention {
    color: $ds-status-warning;
}


/* Same look as .library-notes-row, on a separate class: the notes Create
   view's Blank note / template rows must not also match the list view's
   ".library-notes-row" press handler (opening the editor for the pressed
   row's note_id), which would double-dispatch alongside the Create view's
   own handlers on every press. */
.library-notes-create-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-2;
    min-height: $ds-size-2;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

/* task-32052 AC#2: entering the New-note canvas now parks focus on Blank
   note and Up/Down walk the templates, so these rows need the same
   focus-only left-edge cue the other Library list rows carry
   (.library-notes-row:focus, task-31983). The border replaces the row's
   1-column left padding so the label never shifts or is clipped, and
   `outline: none` suppresses the generic `*:focus{outline:solid}`
   fallback (the task-2041 label-eating trap on a compact row). */
.library-notes-create-row:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border-left: thick $ds-action-focus;
    padding: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    outline: none;
}

/* Same look as .library-notes-row: prompts list rows (library_prompts_canvas.py). */
.library-prompt-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-2;
    min-height: $ds-size-2;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

/* task-2856 AC1/AC4: same readable-focus contract as .library-media-row:focus
   above -- entering the Prompts list now parks DOM focus on the first row
   and Up/Down move it between rows. task-31983: same focus-only border-left
   cue (padding compensates so the label holds), distinct from selection. */
.library-prompt-row:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    border-left: thick $ds-action-focus;
    padding: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    outline: none;
}

#library-notes-header {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    content-align: left middle;
}

/* Supporting Database-mode placement copy below the pinned authority row. */
#library-notes-database-purpose {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-muted;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#library-notes-authority {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
}

#library-notes-filter {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-notes-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-notes-status {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

#library-notes-empty {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

/* Prompts list canvas (library_prompts_canvas.py): same look as the notes
   list's header/filter/empty siblings above -- visual parity, not a
   separate design. */
#library-prompts-header {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    content-align: left middle;
}

#library-prompts-filter {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-prompts-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-prompts-empty {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

/* Toolbar Import… row (library_prompts_canvas.py, Task 5): the path Input
   matches the filter box's field look; the outcome line is muted like the
   editor's save-status Static. */
#library-prompts-import-path {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-prompts-import-path:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-prompts-import-status {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

/* Toolbar Import… row (library_skills_canvas.py, Task 5): the path Input
   matches the filter box's field look; the outcome line is muted like the
   editor's save-status Static. */
#library-skills-import-path {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-skills-import-path:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-skills-import-status {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

/* Skills list canvas (library_skills_canvas.py, Task 3): same look as the
   prompts list's header/filter/empty/row siblings above -- visual parity,
   not a separate design. */
.library-skills-list-mode {
    overflow-y: hidden;
}

#library-skills-list {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-height-fill;
    min-height: $ds-size-0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-text-muted;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

.library-skill-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    /* task-424: 1 high + no margin -- the secondary Static below it is
       part of the same row block (prompts pack both lines into one 2-high
       Button label instead; the separation margin lives on the secondary
       line here). */
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

/* task-2856 AC1/AC4: same readable-focus contract as .library-media-row:focus
   above -- entering the Skills list now parks DOM focus on the first row
   and Up/Down move it between rows. This class is only 1 row high (see the
   comment on the base rule above), which is exactly the shape `outline:
   heavy` eats the label on (round-3 lesson) -- background/color/text-style
   only, no outline geometry. */
.library-skill-row:focus {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
    outline: none;
}

/* Needs-review (trust-blocked) skills stay selectable -- the trust panel
   needs them visible -- but render dim, same modifier-class pattern as
   ``.console-prompt-picker-row-blocked``. */
.library-skill-row-blocked {
    color: $ds-text-muted;
}

/* Row secondary line: the flags/description Static rendered right below
   each skill row's Button. Same muted tier as every other secondary/empty
   line in this canvas family. */
.library-skill-row-secondary {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

#library-skills-header {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    content-align: left middle;
}

#library-skills-filter {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-skills-filter:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-skills-empty {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

/* Skill detail/trust editor (library_skills_canvas.py, Task 4): Name/
   Description/Argument hint/Allowed tools/Model share the SAME field look
   as the prompt editor's own Inputs (visual parity, not a separate
   design) -- dual-pinned against #library-prompt-name in
   test_library_skills_canvas.py. */
#library-skill-name,
#library-skill-description,
#library-skill-argument-hint,
#library-skill-allowed-tools,
#library-skill-model {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-skill-name:focus,
#library-skill-description:focus,
#library-skill-argument-hint:focus,
#library-skill-allowed-tools:focus,
#library-skill-model:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

/* Bounded editor: same floor/ceiling as #library-prompt-system/-user so the
   Body TextArea stays compact instead of ballooning to fill the canvas. */
#library-skill-body {
    height: auto;
    min-height: $ds-size-6;
    max-height: $ds-size-14;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* Advanced Skill tool restriction: one bounded native chooser regardless of
   catalog size. The outer editor owns page scrolling; this viewport owns the
   keyboard-scrolled tool rows. */
#library-skill-basic-fields,
#library-skill-argument-fields,
#library-skill-advanced-fields {
    width: $ds-width-full;
    height: auto;
}

#library-skill-tool-picker {
    width: $ds-width-full;
    height: $ds-size-10;
    min-height: $ds-size-4;
    max-height: $ds-size-10;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#library-skill-supporting,
#library-skill-save-status,
#library-skill-conflict-copy {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-muted;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* Warnings line (shadow-name / save-marks-needs-review): a warning tier
   color, not muted -- unlike the read-only supporting-files/status lines
   above, these are actionable, attention-worthy copy. */
#library-skill-warnings {
    width: $ds-width-full;
    height: auto;
    color: $ds-status-warning;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* Trust panel: state line dims while blocked/needs-review, same modifier-
   class pattern as .library-skill-row-blocked above. The changed-files
   line under it is muted like every other secondary line in this canvas
   family. */
#library-skill-trust-state {
    width: $ds-width-full;
    height: auto;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#library-skill-trust-state.library-skill-trust-state-blocked {
    color: $ds-text-muted;
}

#library-skill-trust-review-files {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* First-run trust setup state (Fix wave, Skills Phase-1 gate FIX 2): the
   explanation line replacing the normal changed-files line while
   ``trust_status == "trust_uninitialized"``. Same muted secondary-line
   look as #library-skill-trust-review-files above -- informational, not a
   warning tier (unlike #library-skill-warnings). */
#library-skill-trust-setup-explanation {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    color: $ds-text-muted;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#library-notes-create-header {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    content-align: left middle;
}

/* Note editor: title/keywords Inputs match the filter box's field look
   (tall border, focus accent) rather than defaulting to Textual's bare
   Input styling. */
#library-note-title,
#library-note-keywords {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-note-title:focus,
#library-note-keywords:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

/* task-32217 (critique #9 density rule): the Body is the primary content
   box of this pane and takes the pane. The old ceiling (`height: auto`,
   `max-height: 20`) was written when the keywords, meta line and action
   row still sat BELOW the TextArea and it had to leave them room; they
   moved into the Info region, so `#library-note-editor-region` ends at
   this field and the ceiling only bought blank pane. Measured live at
   235x52 on the seeded profile: a 3-line note got a 12-row box with 18
   empty rows under it, and the compact stage had already been given
   `1fr` for the same reason (see the `.library-notes-compact` rules). */
#library-note-body {
    height: $ds-height-fill;
    min-height: $ds-size-6;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* The read-only Markdown preview takes the TextArea's place one-for-one,
   so it takes the same height. The focusable wrapper is its sole scroll
   owner; Markdown grows naturally inside it so keyboard paging can reach
   the complete document. */
#library-note-preview-region {
    height: $ds-height-fill;
    min-height: $ds-size-6;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: solid $ds-grid-line;
    overflow-y: auto;
    overflow-x: hidden;
}

#library-note-context-region {
    border: solid $ds-grid-line;
}

#library-note-preview-region:focus,
#library-note-context-region:focus {
    border: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
}

#library-note-preview-body {
    height: auto;
    min-height: $ds-size-0;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    overflow-y: hidden;
    overflow-x: hidden;
}

/* Muted meta line: same tier as the media viewer's metadata block
   (#library-media-viewer-meta) so both editors read consistently.

   task-32143 AC#2: this rule named `#library-note-meta`, a Static whose
   container has been `display = False` unconditionally since the utilities
   moved into Info -- so the muting was being spent on a line nobody could
   see while Info's `#library-note-context-meta`, the one that renders, had
   no colour rule at all. The dead Static is gone; the COLOUR moves to the
   line it was always describing.

   Colour only. Review F2: carrying the old block's `width: 100%` and
   `margin: 0 0 1 0` across with it changed Info's wide layout -- measured
   at 170x48, the backlinks title and the "Reuse & Export"/"Danger" headers
   each moved down a row (20 -> 21, 21 -> 22, 25 -> 26) because
   `#library-note-context-meta` had never had a margin of its own. No
   compact test could see it: the compact sheet already pins
   `margin: 0` there with a more specific selector. */
#library-note-context-meta {
    color: $ds-text-muted;
}

/* task-32143: the editor chrome strip -- one row at the bottom of the body
   carrying "N words · L:C", right-aligned so the eye finds it in the same
   place whatever the note is called. Exactly one row: it is shown only
   while Edit is the open view on a terminal 80 columns or wider, and the
   body's `1fr` pays for it there (measured at 100x30: body 16 -> 15).
   Muted to the same tier as the meta line above -- chrome, not content. */
#library-note-chrome-facts {
    width: $ds-width-full;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    text-align: right;
    color: $ds-text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#library-note-conflict-copy,
#library-note-delete-confirm-copy {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-muted;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#library-note-conflict-copy:focus {
    outline: none;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Prompt editor (library_prompts_canvas.py): same field/meta/conflict look
   as the note editor's siblings above -- visual parity, not a separate
   design. Name/Author/Details/Keywords are single-line Inputs; System
   prompt/User prompt are the bounded TextAreas below. */
#library-prompt-name,
#library-prompt-author,
#library-prompt-details,
#library-prompt-keywords {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-prompt-name:focus,
#library-prompt-author:focus,
#library-prompt-details:focus,
#library-prompt-keywords:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

/* Dim one-line field labels above each Input/TextArea -- the prompt editor
   has several ambiguous text fields (unlike the note editor's single body),
   so each needs its own caption; muted like the note editor's meta line. */
.library-prompt-field-label {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-muted;
}

/* One-line dim hint under the System prompt/User prompt labels (Task 8c
   U7): explains the two-part prompt model to a new user. Same muted tier
   as .library-prompt-field-label above; the trailing margin separates it
   from the TextArea beneath it. */
.library-prompt-field-hint {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-muted;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* Bounded editors: same floor/ceiling as #library-note-body so System/User
   prompt stay compact instead of ballooning to fill the canvas. */
#library-prompt-system,
#library-prompt-user {
    height: auto;
    min-height: $ds-size-6;
    max-height: $ds-size-14;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#library-prompt-meta {
    width: $ds-width-full;
    color: $ds-text-muted;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#library-prompt-conflict-copy,
#library-prompt-save-status {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-muted;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* TASK-196: retained history is a compact disclosure inside the editor's
   existing scroll owner. It deliberately adds neither another card nor a
   VerticalScroll; the persistent action strip remains a sibling below. */
#library-prompt-history-region,
#library-prompt-history-collapsible {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-0;
}

#library-prompt-history-region {
    margin: $ds-space-1 $ds-space-0 $ds-space-1 $ds-space-0;
}

#library-prompt-history-collapsible > CollapsibleTitle {
    width: $ds-width-full;
    color: $ds-text-primary;
    text-style: bold;
}

.library-prompt-history-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    content-align: left middle;
}

#library-prompt-history-metadata,
#library-prompt-history-compatibility,
#library-prompt-history-restore-reason,
#library-prompt-history-outcome,
#library-prompt-history-keywords-disclosure,
#library-prompt-history-outcome-keywords,
.library-prompt-history-error,
.library-prompt-history-success {
    width: $ds-width-full;
    height: auto;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.library-prompt-history-metadata,
#library-prompt-history-compatibility,
#library-prompt-history-restore-reason,
#library-prompt-history-keywords-disclosure,
#library-prompt-history-outcome-keywords {
    color: $ds-text-muted;
}

.library-prompt-history-error {
    color: $ds-status-error-readable;
}

.library-prompt-history-success {
    color: $ds-status-ready;
}

#library-prompt-history-system,
#library-prompt-history-user {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-4;
    max-height: $ds-size-10;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#library-prompt-history-region .library-canvas-action {
    max-width: $ds-width-full;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* TASK-196 / TASK-1801: the reason line explains why restore is gated, but
   the disabled action label must remain discoverable too. Neutralise the
   app + Textual compound opacity stack and let the dark surface, rather
   than illegible ink, communicate the inert state. `$text-muted` measures
   above the product's 3:1 disabled-label floor on this surface. */
#library-prompt-history-restore:disabled {
    opacity: 100%;
    text-opacity: 100%;
    color: $text-muted;
    background: $surface-darken-1;
}

/* TASK-202: the prompt editor owns two rows. The only vertical scroll owner
   is the content row; the action area measures to its controls below it. This
   prevents a tall editor from pushing its completion controls past the canvas. */
#library-prompts-canvas,
#library-prompt-work-pane {
    height: $ds-height-fill;
    min-height: $ds-size-0;
    min-width: $ds-size-0;
}

/* Disabled labels carry a visible marker, so the two management actions
   must share the retained Items width instead of keeping intrinsic widths. */
#library-prompts-selection-management-actions {
    width: $ds-width-full;
    min-width: $ds-size-0;
}

#library-prompts-selection-management-actions > .library-canvas-action,
#library-shell-grid.library-notes-compact #library-prompts-selection-management-actions > .library-canvas-action {
    width: $ds-width-fill;
    min-width: $ds-size-0;
}

#library-prompts-delete-receipt-actions {
    width: $ds-width-full;
    min-width: $ds-size-0;
}

#library-prompts-delete-receipt-actions > .library-canvas-action {
    width: $ds-width-fill;
    min-width: $ds-size-0;
}

#library-prompt-editor-shell {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

#library-prompt-editor-content {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
    overflow-x: hidden;
}

#library-prompt-advanced-extras {
    height: auto;
    margin-bottom: $ds-space-1;
}

#library-prompt-editor-actions {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-0;
    padding: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    background: $ds-surface-raised;
}

/* The groups deliberately stack in source order at every width. This avoids
   a fragile wrapped Horizontal while keeping every long action label visible
   in narrow terminals. */
#library-prompt-actions-primary,
#library-prompt-actions-content,
#library-prompt-actions-lifecycle {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-0;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#library-prompt-actions-lifecycle {
    margin-bottom: $ds-space-0;
}

#library-prompt-editor-actions .library-canvas-action {
    width: $ds-width-full;
    min-width: $ds-size-0;
    margin: $ds-space-0;
}

#library-prompt-actions-lifecycle .library-media-action-danger {
    margin: $ds-space-0 $ds-space-0 $ds-space-0 $ds-size-4;
}

/* Ingest canvas: local-file ingest form + job queue. Mirrors the notes
   sync panel's render-safe stacked shape (VerticalScroll root -- L3a
   clipping lesson -- no Select, no Horizontal mixing 1fr + fixed-width
   children). */
#library-ingest-header {
    width: $ds-width-full;
    text-style: bold;
    color: $ds-text-primary;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.library-ingest-quiet-line {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-muted;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* task-14822: the tooling-warning wall folds to ONE line. This is the
   summary that replaces it -- environment context, so it keeps the quiet
   weight; its `⚠` glyph, not a colour, carries the severity (the
   monochrome rule). No bottom margin: the fold's title row belongs to it,
   and the blank row `.library-ingest-quiet-line` adds per line is exactly
   what turned 11 warnings into ~22 rows. */
.library-ingest-tooling-summary {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-muted;
    margin: $ds-space-0;
}

/* task-14822: the unsupported-file and empty-file lines are OUTCOMES of
   this import, not facts about the install -- they used to share
   `.library-ingest-quiet-line` with the tooling warnings and read at
   identical weight, so "5 unsupported files will be skipped" drowned in
   eleven amber environment notes. Bold + primary text is the same
   "this is about YOUR selection" weight `#library-ingest-header` uses. */
.library-ingest-outcome-line {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-primary;
    text-style: bold;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.library-ingest-field {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

/* task-3302 (MI-05): focus on these top-level fields was color-only -- the
   tall border swapped color but kept identical glyphs, so Tab produced a
   byte-identical plain-text pane (confirmed in two live walks). The heavy
   accent outline is DESIGN.md's focus contract and exactly what the panel
   option fields already get (`LibraryIngestCanvas Input:focus`, task-2014)
   -- that rule loses to this class selector on specificity, which is how
   these four fields shipped color-only. Outline draws OVER the widget's
   own edge cells, so dimensions stay stable on focus/blur. */
.library-ingest-field:focus {
    border: tall $ds-input-focus-accent;
    outline: heavy $ds-input-focus-accent;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

/* TASK-15702: persistent metadata labels survive populated values while a
   compact three-column row shortens the path-to-commit distance. */
#library-ingest-metadata-row {
    width: $ds-width-full;
    height: auto;
    layout: horizontal;
}

.library-ingest-metadata-field {
    width: $ds-width-fill;
    height: auto;
    margin-right: $ds-space-1;
}

.library-ingest-metadata-field:last-of-type {
    margin-right: $ds-space-0;
}

.library-ingest-metadata-field .library-ingest-field {
    margin-bottom: $ds-space-0;
}

/* Keep forecast, consent/error copy, and the primary action together at the
   viewport edge. The queue owns the space after a successful submission. */
#library-ingest-commit-bar {
    dock: bottom;
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-1;
    border-top: solid $ds-grid-line;
    background: $ds-surface-raised;
}

#library-ingest-commit-bar .library-ingest-quiet-line {
    margin-bottom: $ds-space-0;
}

/* Accent treatment mirrors .console-action-primary
   (the project's live "primary action button" convention) so Start ingest
   reads as the one button that matters on this canvas. */
#library-ingest-start {
    margin-top: $ds-space-0;
    background: $ds-action-focus 35%;
    color: $ds-text-primary;
    text-style: bold;
}

#library-ingest-start:disabled {
    background: $ds-surface-raised;
    color: $ds-text-disabled;
    text-style: none;
}

#library-ingest-queue-heading {
    width: $ds-width-full;
    text-style: bold;
    color: $ds-text-primary;
    border-top: solid $ds-grid-line;
    padding: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    margin: $ds-space-1 $ds-space-0 $ds-space-1 $ds-space-0;
}

#library-ingest-queue-counts {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-muted;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#library-ingest-queue-empty {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-muted;
}

.library-ingest-row {
    width: $ds-width-full;
    height: auto;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $ds-text-primary;
}

.library-ingest-progress {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-muted;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-2;
}

.library-ingest-row-with-progress {
    margin-bottom: $ds-space-0;
}

/* (L3b AB wave, A3) A row followed by action button(s) (Open in Library /
   Retry / Dismiss) trims its own bottom margin to 0 -- the actions
   wrapper's own `.library-ingest-row-actions` margin below supplies the
   spacing instead (tight gap above, blank line below), so the button(s)
   read as belonging to THIS row rather than the row underneath it. Plain
   rows (queued/running, or a defensively action-less done row) keep the
   base `.library-ingest-row` bottom margin for normal row-to-row
   spacing. */
.library-ingest-row-with-actions {
    margin: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-0;
}

/* (L5, fix batch F1b) The wrapper around a row's action button(s) --
   Retry+Dismiss on a failed row, or Open in Library alone on a done row
   (the two never coexist on the same row). Carries the spacing the
   individual `.library-ingest-row-action` buttons used to carry alone
   (A3, above) now applied once to the whole group: indented 2 cells so it
   visually nests under its row, no gap above (tight to the row it
   belongs to, whose own margin is trimmed via
   `.library-ingest-row-with-actions` above), one blank line below before
   whatever comes next (another row, or "Clear finished"). `height: auto`
   keeps it from inheriting `Horizontal`'s `1fr` default, which would
   otherwise fight every other row for the VerticalScroll's height. */
.library-ingest-row-actions {
    height: auto;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-2;
}

/* Shared by every per-row action button (Open in Library / Retry /
   Dismiss) inside `.library-ingest-row-actions` above -- now just a small
   right gap between same-row siblings (Retry from Dismiss) so the pair
   reads as two distinct buttons rather than running together; the
   wrapper itself supplies the row's own indent/top/bottom spacing. */
.library-ingest-row-action {
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

/* (L3b AB wave, B2) "Clear finished" sits below every queue row -- a top
   margin separates it from the last row's own action button instead of
   reading as one more per-row action. */
#library-ingest-clear-finished {
    margin-top: $ds-space-1;
}

/* task-31981: the always-visible reason line under a blocked Generate
   (Reader Analysis pane) or Analyze (select mode) -- mirrors the Export
   gate's inline "No destination chosen" line so a keyboard-first user
   reads WHY the action is off, not just a hover tooltip. */
.library-media-action-reason {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-muted;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#library-media-title {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    content-align: left middle;
}

#library-media-canvas {
    height: $ds-height-full;
    min-height: $ds-size-0;
}

#library-media-type-filter {
    width: auto;
    min-width: $ds-size-0;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* task-31270 (critique #4 P1): the delete / dismiss receipts are two rows
   (copy, then Undo · Dismiss) at full width. A single content-width
   Horizontal clipped Undo to "Und" at the Items pane's real width (live
   2026-09-04) -- the one recovery control was unreadable exactly where it
   renders. Same multi-row grammar as the toolbars (task-30043). */
#library-media-canvas .library-media-receipt {
    width: $ds-width-full;
    height: auto;
}
#library-media-canvas .library-media-receipt > .library-media-receipt-copy {
    width: $ds-width-full;
    height: auto;
}
#library-media-canvas .library-media-receipt > .library-media-receipt-actions {
    width: $ds-width-full;
    height: auto;
}

/* task-14900: Media list|preview side by side above the screen's one
   measured width regime. The workbench Horizontal (Collections'
   `#library-collections-workbench` grammar) splits its panes 1fr|1fr by
   default; the `library-notes-compact` class -- which the Library screen
   already maintains on `#library-canvas` at compose time and on every
   measured `on_resize` crossing of LIBRARY_NOTES_COMPACT_BREAKPOINT --
   switches it to the dense preview-free list. In the wide split each pane owns
   its own vertical scroll, which is the point: no more scrolling the whole
   canvas between list and preview while the right half sits blank. */
#library-media-workbench {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
}

#library-media-list,
#library-media-preview,
#library-media-detail-empty {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-height-full;
    min-height: $ds-size-0;
    overflow-y: auto;
    overflow-x: hidden;
}

#library-media-list {
    overflow-y: hidden;
}

#library-media-row-scroll {
    width: $ds-width-full;
    min-width: $ds-size-0;
    overflow-y: auto;
    overflow-x: hidden;
}

#library-media-preview,
#library-media-detail-empty {
    margin: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
}

/* The detail half's placeholder (Collections' "No Collection selected."
   grammar): muted, and hidden the moment the preview owns the pane. */
#library-media-detail-empty {
    color: $ds-text-muted;
}

/* Title: brightest + bold so it anchors the viewer; metadata recedes (muted)
   so the two read as distinct tiers instead of one wall of text. */
#library-media-viewer-title {
    width: $ds-width-full;
    text-style: bold;
    color: $ds-text-primary;
    /* task-31277 (critique #4 P2): no bottom margin. It bought separation
       from a byline row that is now composed only when the item HAS an
       author or URL, so on every other item it paid one blank row of the
       reading surface for nothing -- and a byline reads better hugging
       the title it belongs to anyway. */
    margin: $ds-space-0;
}

#library-media-viewer-meta {
    width: $ds-width-full;
    color: $ds-text-muted;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#library-media-content-search {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-media-content-search:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-media-content-search-status {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

/* TASK-31665 AC#15: visible thumb -- see the first of these rules. */
#library-media-viewer {
    height: $ds-height-full;
    overflow-y: auto;
    /* Never scroll horizontally: without this the vertical scroll container
       sizes its content to the widest child's natural width, so a long
       unbroken line (analysis summary, URL) sets a wide virtual width and
       width:100% children match it instead of wrapping. Constrain to the
       visible width so long lines wrap. */
    overflow-x: hidden;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-text-muted;
    scrollbar-color-hover: $ds-text-muted;
    scrollbar-color-active: $ds-action-focus;
}

/* Text bodies default to width:auto (shrink-to-content); fill the width so
   long lines wrap within the (now horizontally-constrained) viewer. */
#library-media-viewer Static {
    width: $ds-width-full;
}

/* Task 21665: an eligible local original is an additive reading aid. Keep it
   bounded inside the Reader's existing scroll surface; the complete stored
   text remains directly below it and owns its own established scroll region. */
#library-media-image-preview {
    width: $ds-width-full;
    height: auto;
    max-height: $ds-size-18;
    overflow: hidden;
    align: center middle;
    border: solid $ds-grid-line;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#library-media-image-preview-status {
    width: $ds-width-full;
    height: auto;
    color: $ds-text-muted;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#library-media-image-preview-toggle,
#library-media-image-preview-retry {
    width: auto;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* task-31221. The third widget bitten by core/_reset.tcss's
   ``*:focus { outline: solid }`` fallback, after TASK-1160 (DataTable) and
   TASK-2300 (SelectOverlay, components/_lists.tcss) -- read TASK-2300's
   block for the mechanics; this is its raw-OptionList sibling. The media
   type chooser opens at option-count height and the screen focuses it
   immediately, so the outline's top+bottom rows overwrote the FIRST and
   LAST options outright: with the common two-option catalogue the chooser
   rendered as a bare box with nothing in it and selection was blind
   (root-caused live 2026-09-03 via painted-text probes -- every REGION
   measured correct while the paint was covered, which is why no geometry
   assertion ever caught it). Focus stays visible the sanctioned way: the
   highlighted-option recolour already says which option is current. */
#library-media-type-choices:focus {
    outline: none;
}

/* task-31235: the sort chooser became the type chooser's OptionList twin
   (its horizontal strip clipped options off-pane), so it inherits the same
   focus-outline suppression -- at option-count height the outline's
   top+bottom rows would overwrite "Newest" and "Title Z-A". */
#library-media-sort-choices:focus {
    outline: none;
}

/* task-31222: the Read-mode wrapper held only a heading yet defaulted to
   1fr, inserting a blank band above the Find bar while the content sat in
   a fixed 18-row box below -- the Reader's product got ~1/3 of its pane. */
#library-media-reader-mode-read {
    height: auto;
}

/* task-31276: a bare Horizontal defaults to height:1fr, so this one-row
   Rendered|Raw toggle claimed the reader's whole remaining height (12 rows
   at 80x24, 18 once the Find bar mounted) and pushed the reading surface --
   and, once task-15774's dock was retired, the Find bar's match count and
   Prev/Next -- below the fold. The same unstyled-1fr-wrapper trap task-31222
   fixed one level up on #library-media-reader-mode-read. */
#library-media-content-mode-strip {
    height: auto;
}

#library-media-viewer-content {
    /* task-31237 (evolves task-31222's 75vh cap into a true fill): the
       content box takes exactly the pane's remaining height -- 75vh could
       overrun the remainder (double scroll: viewer AND box) or undershoot
       it (a stranded blank band below the reading surface, critique #3
       P2). With the 31222 height:auto wrappers above it in place, 1fr now
       resolves against the viewer's viewport remainder, so chrome stays
       pinned and overflow belongs to this box's own scroll (measured:
       viewer virtual == container at 200x52 with a 300-line document; the
       pre-31222 balloon came from the then-unstyled 1fr mode wrapper, not
       from 1fr here). */
    height: $ds-height-fill;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: solid $ds-grid-line;
    padding: $ds-space-0 $ds-space-1;
}

#library-media-reader-mode-analysis {
    /* task-32217 (critique #9 density rule) reverses task-31237's fill FOR
       THIS TAB ONLY -- see the sibling rule below for why. This wrapper
       takes the pane (explicit 1fr, not the unstyled default 31222 warned
       about) and, crucially, scrolls: it is the ONE thing that changed
       reachability, because the action row now lives in its scrolled flow
       instead of being clipped at the pane edge.

       There are TWO scrollers for a long analysis, not one. Measured on a
       400-line analysis (235x52 / 100x30 / 60x24): this wrapper carries
       only the last 4-5 rows (virt 45 vs h 41, 25 vs 20, 19 vs 14 --
       max_scroll_y 4/5/5), which is exactly the overhang of the action row
       and its reason line; the analysis TEXT is scrolled by the inner
       virtualized view (#library-media-viewer-content-text, virt 400 vs
       h 39/18/12 -- max_scroll_y 361/382/388), which paints its own
       scrollbar. The wheel bubbles from the inner view to this wrapper
       once the inner view bottoms out (Textual stops the event only when
       an inner scroll actually moved), so reading to the end of the text
       and then continuing brings the actions on screen; focusing the
       button scrolls it into view the same way. Verified live at 235x52:
       wheeling reached paragraph 119, the box's bottom border, then
       "Edit analysis / ○ Regenerate". */
    height: $ds-height-fill;
    overflow-y: auto;
}

#library-media-reader-mode-analysis #library-media-viewer-content {
    /* Analysis is the one tab with an action row BELOW the content box, so
       31237's 1fr fill pinned "Edit analysis" / "Generate" to the pane
       floor: measured at 235x52, a 2-line analysis got a 37-row box and
       its actions at y=47 against a content top of y=9 -- 33 rows of empty
       bordered box between the text and the controls that act on it. The
       box now hugs its text and the actions follow it directly.

       `max-height: 1fr` was tried first and does NOT work here: Textual
       resolves fr in max-height against the whole container, not the
       post-auto remainder, so the box took all 41 rows and pushed the
       action row one line past the pane (measured: edit.bottom 51 vs
       viewer.bottom 50). Hence the wrapper scroll above.

       `auto` hugs only while the text FITS. Past that the box fills the
       pane exactly as 1fr did (measured, 400-line analysis: h 41/20/14 at
       235x52/100x30/60x24, i.e. the whole pane) because
       VirtualizedRawContent._apply_height_cap caps its child at the
       parent's content height. That is fine and intended: the short case is
       the one 32217 is about, and in the long case the wrapper's scroll is
       what carries the actions on screen.

       Read keeps 1fr -- nothing sits under its box there, so hugging would
       only re-open the stranded blank band 31237 closed (critique #3 P2). */
    height: auto;
    /* Belt-and-braces only: this declaration is INERT today. Analysis always
       composes the body in raw mode, and LibraryMediaContentBody._apply_mode_
       overflow sets overflow_y="hidden" INLINE for raw, which outranks the
       stylesheet (measured: the box's _inline_styles already has the rule).
       It is kept so the box still cannot become a third scroller if that
       mode mapping ever changes -- but it is NOT what fixed reachability;
       the wrapper's `height: 1fr` + `overflow-y: auto` above is. */
    overflow-y: hidden;
}

/* task-31277 (critique #4 P2, AC#4): the reading measure. The bodies used
   the whole pane, so prose ran ~150 cells at 235 columns against DESIGN.md's
   65-75. The cap is on the TEXT bodies only -- #library-media-viewer-content
   keeps its full width so its border still spans the pane. */
#library-media-viewer-content-text,
#library-media-viewer-content-markdown {
    max-width: $ds-size-92;
}

/* task-31635 (critique #5 item 14): Textual's ``MarkdownH1`` DEFAULT_CSS is
   ``content-align: center middle``, so a document's own title floated to the
   middle of the 92-cell reading measure while every other line -- H2s
   included -- began at its left edge; the heading read as a detached banner
   rather than as the first line of the text it introduces. Scoped to the
   Library Reader's Markdown body, so every other Markdown surface in the app
   keeps Textual's default. */
#library-media-viewer-content-markdown MarkdownH1 {
    content-align: left middle;
}

/* task-31272 (critique #4, B cap_57): F6's first Reader stop IS this box
   (``_MEDIA_WORKBENCH_FOCUS_TARGETS``), but nothing on screen said so --
   a keyboard user could not tell the scroll keys had somewhere to land.
   The cue tints the border the box ALREADY draws: an outline would paint
   over the first and last TEXT rows of the document (the task-31221
   lesson, third widget bitten by ``*:focus { outline: solid }``), and a
   border on the inner ScrollView would cost two rows of reading surface.
   ``:focus-within`` covers both modes: Raw focuses the inner ScrollView,
   Rendered focuses this container itself (Textual's ``has_focus_within``
   is true for the node itself as well as its descendants). */
#library-media-viewer-content:focus-within {
    /* task-31634: HEAVY, not a recoloured solid. Critique #5 measured the
       old cue as colour-only -- 1.01:1 -> 6.96:1 on byte-identical ``┌──┐``
       glyphs -- so a monochrome or colour-blind reader got no signal that
       F6 had landed, while buttons on the same screen change glyphs. Heavy
       swaps the glyphs (``┏━━┓``) at the same one-cell border cost, so the
       state is visible in a plain-text capture and no reading row moves. */
    border: heavy $accent;
}

#library-media-viewer-content:focus,
#library-media-viewer-content-text:focus {
    outline: none;
}

#library-media-viewer-content-text {
    /* task-22500: the widget sets its own height from the wrap index,
       bounded by the room its parent actually has (the parent's max-height
       is an OUTER bound, so its border rows are not available to us);
       width must fill so the index is built at the real render width
       (task-31277 caps that width; the index is rebuilt from the widget's
       own scrollable content region, so the cap is what it indexes at). */
    width: $ds-width-full;
    /* The reader wraps, so horizontal scrolling has nothing to reach. A
       horizontal scrollbar here would also shrink the render width below
       the width the wrap index was built at, truncating every row. */
    overflow-x: hidden;
}

#library-media-edit-form {
    height: auto;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* Persistent per-field label: muted, bold, hugging its input above the row. */
.library-media-edit-label {
    width: $ds-width-full;
    height: $ds-size-1;
    color: $ds-text-muted;
    text-style: bold;
    margin: $ds-space-0;
}

/* Destructive Delete: pushed off the primary actions (a gap) and de-emphasized
   so it is neither adjacent to Edit nor visually competing with it. */
.library-media-action-danger {
    margin: $ds-space-0 $ds-space-0 $ds-space-0 $ds-size-4;
    color: $ds-text-muted;
}

/* task-31980 (critique #6 P2): the Reader's More strip zeroes every button's
   margin (`#library-media-reader-more-actions > Button` above, (1,0,1)), which
   also swallows the danger class's own left margin. Restore it id-scoped
   (1,1,0 beats that) so "Move to trash" reads apart from the neutral actions
   -- mirrors the RAG-profile delete-button separation (`margin-left: 2`). */
#library-media-reader-more-actions > .library-media-action-danger {
    margin: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-2;
}

/* task-31980 (critique #6 P2): the permanent-delete confirmation's commit
   button read in ordinary body ink one cell from a fully-styled Cancel -- the
   most destructive control was the least-marked. This is a DELIBERATE
   confirmation (Cancel focused, "This cannot be undone." above it), so the
   commit takes the readable $error role and reads as destructive. The id
   selector (1,0,0) beats `.library-canvas-action`'s $ds-text-primary; the
   >=3-cell gap off Cancel is set inline in the canvas. Readable token, not the
   3.06:1 `$ds-status-error`, per the a11y contrast rule (see TASK-31664). */
#library-media-trash-delete-confirm {
    color: $ds-status-error-readable;
}

/* Each highlight is an indented card so its quote, meta, and delete read as
   one unit -- a per-row delete then clearly belongs to a single highlight. */
.library-media-highlight-row {
    width: $ds-width-full;
    height: auto;
    border-left: solid $ds-grid-line;
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.library-media-highlight-meta {
    width: $ds-width-full;
    color: $ds-text-muted;
}

.library-media-highlight-delete {
    color: $ds-text-muted;
}

#library-media-edit-form Input {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-media-edit-form Input:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

/* TASK-31745 / final review I3: the "Rename speakers" legend is one label +
   one Input per speaker, `max_speakers` ships at 8, and Textual's default
   Input is 3 rows plus a border -- so an 8-speaker meeting squeezed the
   transcript body beside it down to about 3 rows. Bound the section and
   flatten its rows to one line each. ID/class-keyed only (no ancestor-scoped
   bare type), so ADR-097's fast-path ratchet is untouched. */
#library-media-speaker-legend {
    max-height: $ds-size-12;
    overflow-y: auto;
}

Input.library-media-speaker-input {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

/* Borderless rows still need a visible focus state (the reader's other
   Inputs get theirs from a border-colour change, which is gone here). */
Input.library-media-speaker-input:focus {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

#library-media-highlight-add-collapsible {
    height: auto;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#library-media-highlight-add-collapsible Input {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: tall $ds-grid-line;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#library-media-highlight-add-collapsible Input:focus {
    border: tall $ds-input-focus-accent;
    outline: none;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

/* task-32350 (critique #10 P1): the applied-scope line under the Media
   header. Quiet by design -- it is a statement of fact, not an action.
   `1fr`, not `auto`: this line is long (a filter term and a sort label),
   and an auto-width Static pushed its own Clear Button off the pane edge
   once the Reader narrowed Items (live-verified at 235x52). The squeeze
   lands on the Static, which ellipsises; the compact Button keeps its
   natural width, so task-4023's zero-width-Button hazard is not in play. */
.library-media-scope-line {
    color: $ds-text-muted;
    width: $ds-width-fill;
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.library-rag-region {
    width: $ds-width-full;
    min-width: $ds-size-0;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* Auto-height: the query row used to be a Horizontal (Input + Button side
 * by side) inside this container, sized with a hand-counted fixed height
 * (14, 17 with the recovery line). Stacking the query Input and Run button
 * as their own full-width rows (house canvas grammar) made that hand count
 * fragile -- content growth (e.g. the mode-toggle button) silently overflowed
 * the fixed height, clipping/overlapping the callout and Run button. Sizing
 * to content avoids re-counting rows by hand every time this region changes. */
#library-rag-query-controls {
    height: auto;
    min-height: $ds-size-0;
}

/* Auto-height: B2 replaced the fixed pipe-drawn scope table (heading +
 * summary + table header + 7 rows, hand-counted at 13/16 lines) with a
 * heading, a summary line, and three toggle buttons -- a fixed hand count
 * here would re-introduce the exact clipping bug `#library-rag-query-controls`
 * already hit once (see the comment above it). */
#library-rag-source-scope {
    height: auto;
    min-height: $ds-size-0;
}

#library-rag-results {
    height: auto;
    min-height: $ds-size-8;
}

/* PR-3 Task 3: the Answer region mounts as its own sibling BETWEEN
 * `#library-rag-source-scope` and `#library-rag-results` (never inside the
 * latter -- see the mount-point comment in `LibrarySearchRagPanel.compose()`
 * and `library_rag_answer_children`'s docstring). Auto-height like its
 * sibling regions above: absent entirely on the idle/keyword-mode canvas,
 * one quiet line while generating, a full card once an answer lands. */
#library-rag-answer {
    height: auto;
    min-height: $ds-size-0;
}

/* The answer IS the headline of rag mode (PR-3 Task 3) -- a raised card,
 * not a muted status line, so a grounded answer reads as this panel's
 * primary content rather than one more line among many. Reuses the same
 * surface/text tokens `.library-rag-result-row` already uses for its own
 * content-card treatment. */
#library-rag-answer-text {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-1 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

/* PR-3 Task 3: the provenance footer -- "provider · model · $cost (tokens)"
 * or the honest "pricing unknown"/no-usage shapes -- renders below
 * whatever status content the answer region already showed (answer text,
 * caution callout, abstention/no-evidence line, or failure + retry hint).
 * A hairline top divider (not `.library-rag-quiet-line`'s own margin/
 * padding alone) is what marks it as a FOOTER for that content rather than
 * one more quiet line among them. */
#library-rag-answer-provenance {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-1 $ds-space-1 $ds-space-0 $ds-space-1;
    border-top: solid $ds-grid-line;
}

#library-rag-query-input {
    width: $ds-width-full;
    min-width: $ds-size-0;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: solid $ds-grid-line;
    border-bottom: solid $ds-grid-line;
    background: $ds-surface-raised;
}

#library-rag-query-input:focus {
    border: solid $ds-input-focus-border;
    border-bottom: solid $ds-input-focus-accent;
    background: $ds-input-focus-bg;
}

#library-rag-scope-summary {
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.library-rag-scope-toggle {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-2;
    min-height: $ds-size-2;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    text-align: left;
    content-align: left middle;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.library-rag-scope-toggle:hover {
    background: $ds-action-focus 20%;
}

.library-rag-scope-toggle:disabled {
    color: $ds-text-disabled;
    background: $ds-surface-raised;
}

.library-rag-callout {
    width: $ds-width-full;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

.library-rag-quiet-line {
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

.library-rag-empty-guidance {
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

#library-rag-run-query {
    width: $ds-size-18;
    min-width: $ds-size-16;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    background: $ds-action-focus 35%;
    color: $ds-text-primary;
    text-style: bold;
}

/* task-32053 AC#4: Run painted byte-identically focused and blurred (the
   generic `*:focus{outline:solid}` cannot paint around a 1-row button).
   Same heavy SIDE rails the compact canvas actions use (task-3302 MI-05):
   they land on the button's own `padding: 0 1` cells, so the label
   survives and the dimensions never change on focus/blur. */
#library-rag-run-query:focus {
    outline-left: heavy $ds-focus-accent;
    outline-right: heavy $ds-focus-accent;
}

#library-rag-run-query:disabled {
    background: $ds-surface-raised;
    color: $ds-text-disabled;
    text-style: none;
}

/* Task 12/RAG-36: each evidence row's content+actions is wrapped in one
 * focusable card so Tab gives keyboard users a per-row cursor (previously
 * only the row's buttons were focusable, with no indication of "where"
 * keyboard focus sat among results). Idiom mirrors
 * `#console-native-transcript`/`#library-rag-query-input`: the base rule
 * already reserves a `border: solid` + `border-bottom: solid` box, so the
 * `:focus` rule only swaps the border COLOR to `$ds-focus-accent` -- never
 * adding a border edge the base didn't already have reserved, which is
 * what causes layout jitter on focus/blur (see the stable-border-geometry
 * contract in `Tests/UI/test_non_obscuring_focus_contract.py`). Left
 * without background/color changes on purpose: `.library-rag-result-row.
 * is-selected` below already owns the $ds-focus-bg/$ds-focus-fg "this
 * evidence is selected" treatment, so a plain border-color change keeps
 * "keyboard is here" and "this is the selected evidence" visually
 * distinct even though both reuse the same focus token family. */
.library-rag-result-card {
    width: $ds-width-full;
    height: auto;
    border: solid $ds-grid-line;
    border-bottom: solid $ds-grid-line;
}

/* task-32053 AC#1 (critique #8 row 4): the card was reachable in five Tabs
 * from the query box, but the ONLY cue was this border-colour swap -- a
 * colour-only signal, against the house rule, and the reason two live
 * reviewers read the cards as unreachable and the keys as inert. The left
 * edge becomes the house `thick` block bar (`█`, same non-colour cue as
 * `.library-media-row:focus`/`.library-notes-row:focus`, task-31983);
 * `thick` occupies the same single cell `solid` already reserved, so
 * nothing shifts on focus/blur. */
.library-rag-result-card:focus {
    border: solid $ds-focus-accent;
    border-bottom: solid $ds-focus-accent;
    border-left: thick $ds-focus-accent;
    /* Load-bearing, and the reason the card LOOKED colour-only: the generic
     * `*:focus { outline: solid $ds-focus-accent }` fallback
     * (core/_reset.tcss) paints its edges OVER this widget's own border
     * cells, so every edge -- including this one -- came out as the
     * outline's `│` recoloured to the accent, and the border rule above was
     * never visible at all. Every sibling row rule already suppresses it
     * for exactly this reason (`.library-media-row:focus`, task-2856). */
    outline: none;
}

/* task-7 PR-2 leftover: this title Static used to draw its own
 * `border: solid $ds-grid-line` base border, immediately nested inside
 * `.library-rag-result-card`'s own `border: solid $ds-grid-line` a few
 * cells out -- two thin boxes of the identical color/style, one drawn
 * right inside the other, reading as a rendering glitch rather than
 * intentional structure. The card is now the row's only box in the
 * unselected state. `.is-selected` below is untouched and still reads
 * as selected on its own: it fully overrides `border` with its own
 * `heavy $ds-focus-accent` value (plus the focus-bg/focus-fg/bold
 * treatment), so it never depended on this rule's now-removed border for
 * legibility -- it draws a heavy highlighted box around just the
 * selected row's title line, nested inside the card's thin border,
 * exactly as before. */
.library-rag-result-row {
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    background: $ds-surface-panel;
}

.library-rag-result-badges {
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: bold;
}

/* task-2859 item 10: the snippet had no rule of its own at all, so it sat
 * flush against the card's left border -- unlike its siblings above/below
 * (`.library-rag-result-row`, `.library-rag-result-badges`), both of which
 * already carry `padding: 0 1`. Matches that same padding for visual
 * consistency down the card. */
.library-rag-result-snippet {
    padding: $ds-space-0 $ds-space-1;
}

/* C1: content-first result rows -- Open (primary emphasis, reuses the live
 * `.console-action-primary` colors directly since that class is not
 * Console-screen-scoped) then Select evidence, as a Horizontal of
 * auto-width buttons. */
.library-rag-result-actions {
    width: $ds-width-full;
    height: auto;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

.library-rag-result-open {
    width: auto;
    min-width: $ds-size-10;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

.library-rag-result-action {
    width: auto;
    min-width: $ds-size-16;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.library-rag-recovery-action {
    width: $ds-size-28;
    min-width: $ds-size-18;
    background: $ds-status-warning 30%;
    color: $ds-text-primary;
    text-style: bold;
}

/* task-14 / spec AC 47 (chunking-template parity): the recovery-action
 * class gained a second consumer -- the re-chunk control
 * (#library-rag-rechunk-legacy), which is DISABLED mid-run by the panel
 * -- and its state set is completed here so both buttons define
 * rest/hover/focus/disabled from $ds-* tokens. Hover deepens the warning
 * tint rather than letting the generic `Button:hover` swap in
 * `$surface-lighten-1` (which would erase the "this is a recovery
 * action" colour); (0,2,0) beats `Button:hover`'s (0,1,1) per property. */
.library-rag-recovery-action:hover {
    background: $ds-status-warning 45%;
}

/* Structural focus cue, the task-3302 side-rail recipe
 * (`Button.library-canvas-action:focus` above): typed selector so
 * (0,2,1) plus later-in-bundle position beats both `Button:focus`
 * (0,1,1) and `Button:hover:focus` (0,2,1, earlier module), keeping the
 * rails visible while hovered too. Rails land on the button's own edge
 * cells, so dimensions never change on focus/blur (the non-obscuring
 * focus contract). */
Button.library-rag-recovery-action:focus {
    outline-left: heavy $ds-focus-accent;
    outline-right: heavy $ds-focus-accent;
}

/* Legible Disabled (TASK-1801/DESIGN.md), the task-4023 RC-07 Library
 * recipe: three dimmers compound on a disabled Button (the theme's
 * `text-disabled: auto 38%`, Textual's own `bold dim` + `color:
 * auto 50%`, and _buttons.tcss's `Button:disabled { opacity: 50% }`).
 * The re-chunk run disables this button for its whole batch, so the
 * label must stay readable next to the live "Re-chunking…" summary
 * line. Neutralise every layer, state a colour, let the darkened
 * surface carry "inert" -- same selectors/specificity as the
 * `Button.library-canvas-action:disabled` escape. */
Button.library-rag-recovery-action:disabled,
Button.library-rag-recovery-action:disabled:hover {
    opacity: 100%;
    text-opacity: 100%;
    text-style: none;
    color: $ds-text-muted;
    background: $surface-darken-1;
}

.library-rag-console-action {
    width: $ds-size-18;
    min-width: $ds-size-16;
    background: $ds-action-focus 35%;
    color: $ds-text-primary;
    text-style: bold;
}

.library-rag-center-console-action {
    width: $ds-size-24;
    min-width: $ds-size-18;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

.library-rag-console-action:disabled {
    background: $ds-surface-raised;
    color: $ds-text-disabled;
    text-style: none;
}

#library-rag-mode-toggle {
    width: auto;
    min-width: $ds-size-20;
    height: $ds-size-2;
    min-height: $ds-size-2;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    text-align: left;
    content-align: left middle;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

#library-rag-mode-toggle:hover {
    background: $ds-action-focus 20%;
}

#library-rag-searching-line {
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
    color: $ds-text-muted;
    text-style: italic;
}

#library-rag-history {
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

.library-rag-history-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-2;
    min-height: $ds-size-2;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    text-align: left;
    content-align: left middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: none;
    background: $ds-surface-panel;
    color: $ds-text-primary;
}

.library-rag-history-row:hover {
    background: $ds-action-focus 20%;
}

.library-rag-history-empty {
    color: $ds-text-muted;
    padding: $ds-space-0 $ds-space-1;
}

.library-rag-history-hint {
    color: $ds-text-muted;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.library-rag-history-clear {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-2;
    min-height: $ds-size-2;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    text-align: left;
    content-align: left middle;
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.library-rag-history-clear:hover {
    background: $ds-action-focus 20%;
}

/* task-14824 (3): the canvas-level path field's persistent label -- same
   dense-form convention as the option-panel field labels above, without
   their in-panel top margin (the field follows the header block). */
LibraryIngestCanvas .library-ingest-field-label {
    width: $ds-width-full;
    height: $ds-size-1;
    color: $text-muted;
}

/* task-2230 (a11y): failed/skipped rows carried no colour distinction
   from done rows. Colour is ADDED to the existing glyph+word, never
   replacing them (the round-4 lesson: severity must survive monochrome). */
LibraryIngestCanvas .library-ingest-row-failed {
    color: $ds-status-error-readable;
}
LibraryIngestCanvas .library-ingest-row-skipped {
    color: $text-muted;
}

/* task-3304 (MI-08): fold indicator, task-1623 convention. Docked chrome
   inside the VerticalScroll canvas -- a docked child never scrolls with
   the content -- shown by the canvas's own sync only while content
   overflows. Opaque background so the row reads as chrome, not as a
   content line. */
#library-ingest-fold-hint {
    dock: bottom;
    width: $ds-width-full;
    height: $ds-size-1;
    color: $text-muted;
    background: $ds-surface-raised;
    padding: $ds-space-0 $ds-space-1;
}

/* task-2223: Recent ingests two-line entries -- the muted full-path line
   under each basename row. */
LibraryIngestCanvas .library-ingest-recent-path {
    color: $text-muted;
    height: auto;
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-2;
}

/* task-2221: per-submission batch group headers + the latest-batch tally
   line that leads the queue section. */
LibraryIngestCanvas .library-ingest-batch-header {
    height: auto;
    text-style: bold;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}
LibraryIngestCanvas #library-ingest-latest-batch {
    height: auto;
    text-style: bold;
}

/* Presentation-only row wrappers keep the established wide stacked
   workbench. Compact rules below switch only these wrappers to rows. */
#library-notes-filter-row,
#library-notes-status-row,
#library-note-heading,
#library-note-title-row,
#library-note-context-keywords-row,
#library-notes-create-heading {
    layout: vertical;
    height: auto;
    min-height: $ds-size-0;
}

#library-notes-create-viewport {
    height: $ds-height-fill;
    min-height: $ds-size-0;
    overflow-y: auto;
    overflow-x: hidden;
}

/* TASK-19010: lasting Notes sync inherits the retained Neon Workbench canvas.
   Authority/status and the nearest valid action stay fixed; setup, review, and
   recovery effects share one bounded scroll owner at the 60x20 floor. */
.library-notes-lasting-sync-canvas {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
    overflow: hidden;
}

.library-notes-sync-review-row,
.library-notes-sync-root-row,
.library-notes-sync-root-actions {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.library-notes-sync-attention-actions {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
}

.library-notes-sync-conflict-choices,
.library-notes-sync-comparison,
.library-notes-sync-receipt,
.library-notes-sync-history-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-1;
    overflow: hidden;
}

.library-notes-sync-comparison,
.library-notes-sync-receipt,
.library-notes-sync-history-row {
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $surface-darken-1;
}

.library-notes-sync-root-status {
    color: $text-muted;
}

.library-notes-sync-root-actions > Button {
    width: $ds-width-full;
}

.library-notes-sync-attention-actions > Button {
    width: $ds-width-full;
}
