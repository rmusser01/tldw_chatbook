.tldw-agentic-split-preamble-end { }



#settings-category-pane {
    width: $ds-size-30;
    max-width: $ds-size-34;
    /* min-width (task-1342): worst label is "> Privacy & Security *" (22
       cells) plus Button line-pad (2), border (2), padding (2), list
       scrollbar (1) and pane border (2) -- 31; width:30 alone clips the
       dirty "*" marker off edited categories. */
    min-width: $ds-size-32;
    overflow-y: hidden;
    overflow-x: hidden;
}

#settings-category-list {
    width: $ds-width-full;
    height: $ds-height-fill;
    min-height: $ds-size-0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    /* task-1712: $ds-grid-line blended into the panel, hiding that four
       categories sit below the fold on common heights -- the overflow
       cue must actually read as one. */
    scrollbar-color: $ds-text-muted;
    scrollbar-color-hover: $ds-grid-line;
    scrollbar-color-active: $ds-action-focus;
}

/* Qodo PR #1147: both panes are fixed-header-over-scroll-body now (the
   detail pane since task-1716, the impact pane since task-1560) -- the
   scrollbar theming has to sit on the -body children that actually
   scroll, or the real scroll containers render stock scrollbars. The
   outer panes keep only their column width and clip. */
#settings-detail-pane {
    width: $ds-fr-6;
    overflow-y: hidden;
    overflow-x: hidden;
}

#settings-impact-pane {
    /* min-width: longest inspector word is "Read-only/WIP;" (14 cells) plus
       border (2), padding (2), scrollbar (1) and row padding (2), so words
       wrap on whitespace instead of folding mid-word (task-1342). */
    width: $ds-fr-2;
    min-width: $ds-size-21;
    overflow-y: hidden;
    overflow-x: hidden;
}

/* TASK-33003.7: the spec's Inspector width (36) as a floor wherever the
   detail pane can spare it (the class is set from
   SETTINGS_INSPECTOR_FLOOR_MIN_WIDTH, settings_screen.py). Below ~186
   columns the 2fr share is narrower: 25 at 140 columns, an 18-cell text
   column that wrapped each row 4-5 times and pushed the Overview boundary
   note below the fold. It never binds at 211 or 235 columns. */
#settings-impact-pane.settings-inspector-floor {
    min-width: $ds-size-36;
}

/* TASK-31665 AC#15: visible thumb -- see the first of these rules. */
#settings-detail-pane-body,
#settings-impact-pane-body {
    width: $ds-width-full;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-background: $ds-surface-panel;
    scrollbar-color: $ds-text-muted;
    scrollbar-color-hover: $ds-text-muted;
    scrollbar-color-active: $ds-action-focus;
}

/* TASK-33007.6: with Advanced closed, Providers & Models fits the pane, and
   the Model picker's open rows push it past the fold. Without a reserved
   gutter, focusing or leaving the picker added or removed the scrollbar,
   changed the content width and re-laid out the whole card: the blur
   restore ran ~150 ms late, measured. The gutter keeps the width fixed. */
#settings-detail-pane-body {
    scrollbar-gutter: stable;
}

/* Narrow-width compact workbench (task-1342), following the personas
   precedent (personas-workbench-compact): at <=100 cols the 3:6:2 split
   leaves slivers, so the category pane becomes a fixed-width sidebar, the
   inspector pane and its divider drop out, and the detail pane takes the
   rest. The search help/status rows hide so category rows stay visible at
   24-row heights. */
#settings-workbench.settings-workbench-compact {
    padding: $ds-space-0;
}

#settings-category-pane.settings-workbench-compact-pane {
    width: $ds-size-32;
    min-width: $ds-size-32;
    padding: $ds-space-0 $ds-space-1;
}

#settings-detail-pane.settings-workbench-compact-pane {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    padding: $ds-space-0 $ds-space-1;
}

#settings-impact-pane.settings-workbench-compact-pane,
#settings-workbench.settings-workbench-compact #settings-detail-impact-divider {
    display: none;
}

#settings-workbench.settings-workbench-compact .settings-category-search-help,
#settings-workbench.settings-workbench-compact .settings-category-search-status {
    display: none;
}

/* TASK-32593: a 24-column label leaves only seven editable cells in the
   default 80-column workbench. Keep the sidebar and complete labels, and
   spend vertical space on the Connect/Network field rows instead.
   TASK-32748 includes the nested Generation defaults rows, where the same
   fixed label otherwise leaves only the final digit of Temperature visible.
   Console Behavior and Storage use the same stacked field contract.
   Existing controls retain their compact border and focus contracts.
   TASK-33007.6: the Context window and Discover rows moved from the card
   into Advanced disclosures, so those two are named. A card-wide
   descendant selector would also stack Catalog refresh's and Custom
   endpoints' rows, which keep their own compact rules (fix round 1). */
.settings-workbench-compact #settings-providers-models-card > .settings-input-row,
.settings-workbench-compact #settings-generation-defaults .settings-input-row,
.settings-workbench-compact #settings-advanced-context-window .settings-input-row,
.settings-workbench-compact #settings-advanced-saved-models .settings-input-row,
.settings-workbench-compact #settings-network-card > .settings-input-row,
.settings-workbench-compact #settings-console-behavior-card .settings-input-row,
.settings-workbench-compact #settings-storage-card .settings-input-row {
    layout: vertical;
    height: auto;
    min-height: $ds-size-2;
    margin-bottom: $ds-space-stack;
}

.settings-workbench-compact #settings-providers-models-card > .settings-input-row > Input,
.settings-workbench-compact #settings-providers-models-card > .settings-input-row > Select,
.settings-workbench-compact #settings-generation-defaults .settings-input-row > Input,
.settings-workbench-compact #settings-generation-defaults .settings-input-row > Select,
.settings-workbench-compact #settings-advanced-context-window .settings-input-row > Input,
.settings-workbench-compact #settings-network-card > .settings-input-row > Input,
.settings-workbench-compact #settings-network-card > .settings-input-row > Select,
.settings-workbench-compact #settings-console-behavior-card .settings-input-row > Input,
.settings-workbench-compact #settings-console-behavior-card .settings-input-row > Select,
.settings-workbench-compact #settings-storage-card .settings-input-row > Input {
    width: $ds-width-full;
}

/* The narrow card can have 34 columns once its scrollbar appears. Its
   longest policy is 29 columns; one padding cell plus the existing border
   and arrow fits it without changing the value or removing focus chrome. */
.settings-workbench-compact #settings-network-ssl-mode > SelectCurrent {
    padding-right: $ds-space-0;
}

/* Settings density: the workbench panes themselves carry borders and
   padding, so the frame would only double them up. */
#settings-workbench {
    padding: $ds-space-0;
    border: none;
}

.settings-active-section {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

Button.settings-category-button {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    /* Textual 8 Buttons default to line-pad: 1, reserving one cell on each
       side of the label (line-pad: 0 is not expressible in CSS). The
       #settings-category-pane min-width absorbs those 2 cells so labels
       never wrap into this clipped second line (task-1342). */
    content-align: left middle;
    text-align: left;
    background: $ds-surface-panel;
    /* TASK-33003.6: the focus edge's column, blank (the row's own fill) at
       rest, so focus moves no label. */
    border-left: blank;
}

Button.settings-category-button.settings-active-section {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* TASK-33003.6 (WCAG 1.4.11): focus swapped only the fill (1.1:1). The cue
   is now a thick edge in the readable primary tint, 3:1 on panel, surface
   and the focus fill in every theme (test_theme_contrast.py). The text
   colour and weight come from `#settings-shell Button:focus`, which
   outranks these rules. */
Button.settings-category-button:focus {
    outline: none;
    border-left: thick $ds-active-fg;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

Button.settings-category-button.settings-active-section:focus,
Button.settings-category-button.settings-active-section:hover:focus {
    border-left: thick $ds-active-fg;
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

Button.settings-category-button.settings-active-section:hover {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

Button.settings-category-button.settings-primary-search-match {
    color: $ds-text-primary;
    text-style: bold;
}

Button.settings-category-button.settings-secondary-search-match {
    color: $ds-text-muted;
}

#settings-category-search {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    /* No border: at height 1 a border would clip the content row. The
       raised background carries the "this is a field" affordance, and
       focus/active below swap background+weight only, so the strip never
       changes height (stable-border-geometry contract). */
    border: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
}

#settings-category-search:focus {
    border: none;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
    text-style: bold;
    outline: none;
}

#settings-category-search.settings-category-search-active {
    border: none;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
}

.settings-category-search-help {
    width: $ds-width-full;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

.settings-category-search-status {
    width: $ds-width-full;
    min-height: $ds-size-2;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $ds-text-primary;
    background: $ds-surface-panel;
}

.settings-search-empty {
    width: $ds-width-full;
    min-height: $ds-size-3;
    padding: $ds-space-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-muted;
}

/* TASK-33003.6: no `background` here. It was `$ds-surface-raised`, the
   resting surface (design-language §2.7 forbids that alias): a focused
   primary lost its fill, and on light themes Textual's focus tint pulled a
   default button's fill toward the card (1.08:1 -> 1.02:1 in textual-light).
   The fill now comes from components/_buttons.tcss: the focus tint, or a
   variant's own colour. */
#settings-shell Button:focus,
#settings-shell Button:hover:focus {
    color: $ds-text-primary;
    text-style: bold underline;
    outline: none;
}

.settings-category-group-title {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
    text-style: bold;
}

/* Collapsible rail-group toggle (Domain Defaults): renders like a group
   heading but behaves like the compact category buttons. */
Button.settings-category-group-toggle {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    max-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    content-align: left middle;
    text-align: left;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
    text-style: bold;
}

Button.settings-category-group-toggle:focus {
    outline: none;
    background: $ds-surface-raised;
    color: $ds-text-primary;
    text-style: bold;
}

.settings-state-banner {
    width: $ds-width-full;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    /* task-1625: the State strip reads as a raised status surface (the
       task-345 focus steel at low alpha), not another flat prose row --
       it now leads with the persistence badge (task-1717), so it earns
       the emphasis. */
    background: $ds-focus-bg 30%;
    color: $ds-text-primary;
    text-style: bold;
}

/* ADR-161 task 9: the bare .settings-detail-row definition moved to
   components/_forms.tcss (documented variant of form-row; consumed on TWO
   production surfaces -- the Settings workbench and the STTS speech
   settings pane -- so it rides the boot bundle instead of the lazy
   settings screen sheet). TASK-33003.7 deleted the Scope Inspector's
   blank-row override (#settings-impact-pane .settings-detail-row, margin
   bottom 1): it cost 7 rows on Overview and cut the boundary note at the
   211x44 fold, so inspector rows now sit without a blank row between them. */

.settings-input-row {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
}

/* TASK-32948: Appearance's read-only Theme summary shares its row with the
   Open Theme button; a full-width detail row would push the button past the
   card edge (under the inspector, unclickable). */
#settings-appearance-theme-summary {
    width: $ds-width-fill;
}

/* Interface subviews must grow with their forms so the detail pane owns
   scrolling, including stacked Theme actions and the Splash gallery.
   TASK-32948: the editor now sits in the ThemePane's editor view, which
   must grow with it too (a 1fr Vertical there clips the editor). */
#settings-theme-editor,
#settings-theme-editor-view,
#settings-splash-screen-viewer {
    height: auto;
}

/* Compact toggles retain the full label and glyph without three-row
   chrome, including the rail-label control in the narrow Settings pane. */
#settings-console-stack-collapsed-rail-labels,
#settings-appearance-animations-enabled,
#settings-splash-enabled,
#settings-splash-show-progress,
#settings-splash-skip-on-keypress {
    width: auto;
    height: $ds-control-height-compact;
    min-height: $ds-control-height-compact;
    border: none;
    padding: $ds-space-0;
    margin: $ds-space-0;
}

/* Appearance has the same 24-column label constraint as Connect. Stack
   compact fields so the toggle buttons and editable values fit the card. */
.settings-workbench-compact #settings-appearance-card > .settings-input-row,
.settings-workbench-compact #settings-splash-card > .settings-select-row {
    layout: vertical;
    height: auto;
    min-height: $ds-size-2;
    margin-bottom: $ds-space-stack;
}

.settings-workbench-compact #settings-appearance-card > .settings-input-row > Input,
.settings-workbench-compact #settings-appearance-card > .settings-input-row > Select,
.settings-workbench-compact #settings-splash-default-select {
    width: $ds-width-full;
}

/* A stacked gallery gives compact terminals a useful card list and preview
   width; the list fits completely inside the detail pane when focused. */
.settings-workbench-compact #settings-splash-gallery {
    layout: vertical;
    height: auto;
    min-height: $ds-space-0;
}

.settings-workbench-compact #settings-splash-card-list {
    width: $ds-width-full;
    height: $ds-size-8;
}

.settings-workbench-compact #settings-splash-preview-scroll {
    width: $ds-width-full;
    height: $ds-size-12;
}

/* TASK-33007.2: Connect rows read label | one-row control | Source word |
   one-line help (spec §6). At 211x44 the card has 117 columns: the control
   column is 36 wide on every row, so the Source words line up, and the help
   gets 39. A narrower card (the inspector-beside-detail widths) shrinks the
   Source word and help first and keeps each control's text at least 20
   cells wide, the TASK-32593 floor. Nothing wraps, so each row stays one
   row. */
#settings-provider-search,
#settings-provider-auth-source,
#settings-provider-api-mode,
#settings-provider-credential-env-var,
#settings-provider-endpoint-value,
#settings-openai-reconnect-review,
#settings-model-picker {
    width: $ds-fr-2;
    min-width: $ds-size-24;
    max-width: $ds-size-36;
}

/* With its Clear button the API key column is the same 36 columns. */
#settings-provider-api-key {
    width: $ds-fr-2;
    min-width: $ds-size-14;
    max-width: $ds-size-28;
}

/* TASK-33007.3: the Default model picker is one row at rest, the field in
   the Connect control column. While it holds focus it opens across the row:
   the Source word and help step aside, the field keeps its whole width and
   Custom ID drops below it (so the TASK-32593 floor holds in a narrow card),
   then the picker's status line and the grouped list. The picker's own CSS
   makes its control 3 rows tall (R10). Its parts are named by type (the
   control row is its only Horizontal, Custom ID its only Button, the status
   line its only Static child) so every rule stays in the lazy Settings
   sheet: a picker id or class token would pin it to the boot bundle. */
/* Textual restyles a subtree on focus only from the outermost ancestor that
   itself carries a :focus-within rule, so the row needs one of its own or
   its Source word and help never hear that the picker took focus. */
#settings-model-row,
#settings-model-row:focus-within {
    height: auto;
}

#settings-model-picker > Horizontal {
    height: $ds-control-height-compact;
    min-height: $ds-control-height-compact;
}

#settings-model-picker Button,
#settings-model-picker > Static {
    display: none;
}

#settings-model-picker:focus-within > Horizontal {
    layout: vertical;
    height: auto;
}

#settings-model-picker:focus-within Button,
#settings-model-picker:focus-within > Static {
    display: block;
}

#settings-model-row:focus-within #settings-model-picker {
    width: $ds-width-fill;
    max-width: $ds-width-full;
}

#settings-model-row:focus-within .settings-source-word,
#settings-model-row:focus-within .settings-row-help {
    display: none;
}

#settings-providers-models-card .settings-source-word,
#settings-console-fallbacks .settings-source-word {
    width: $ds-width-fill;
    max-width: $ds-size-18;
    height: $ds-control-height-compact;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#settings-providers-models-card .settings-row-help,
#settings-providers-models-card .settings-key-check-verdict,
#settings-console-fallbacks .settings-row-help {
    width: $ds-width-fill;
    height: $ds-control-height-compact;
    padding: $ds-space-0 $ds-space-1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#settings-providers-models-card .settings-row-help,
#settings-console-fallbacks .settings-row-help {
    padding: $ds-space-0;
    color: $ds-text-muted;
}

/* TASK-33007.5: Model defaults rows read label | control | Source word |
   help (spec §6). Numbers and enums share one 16-cell control column, the
   enum size, so every Source word in the section lines up; the compact
   workbench rules above still stack a row and widen its field. Context
   window's field (captures review note 11) takes the same column, so its
   Source word lines up with theirs. */
#settings-generation-defaults .settings-compact-input,
#settings-generation-defaults .settings-compact-select,
#settings-advanced-context-window .settings-compact-input {
    width: $ds-size-16;
}

/* TASK-33007.7: Console Behavior's global fallbacks read the same rows as
   Model defaults (above), so their container grows with them and their
   Sampling disclosure costs one row closed, as the card's do (below). */
#settings-console-fallbacks {
    height: auto;
}

/* TASK-33007.5 (spec §6 "a closed disclosure costs 1 row"): the card's
   disclosures -- Model defaults, its Sampling, and (TASK-33007.6) the five
   Advanced ones -- drop the global components/_widgets.tcss Collapsible
   frame (round border, min-height 3, margin) and Textual's padding, as Chat
   settings does, so each title is a one-row section header and the opened
   rows line up with Connect's. A title set after mount keeps an auto width's
   first measure, so it spans its row; the builders keep it to one row and
   the ellipsis is the narrow-workbench safety net. */
#settings-providers-models-card Collapsible,
#settings-console-behavior-card Collapsible {
    min-height: $ds-size-0;
    margin: $ds-space-0;
    padding: $ds-space-0;
    border: none;
    background: $ds-surface-panel;
}

#settings-providers-models-card Collapsible > Contents,
#settings-console-behavior-card Collapsible > Contents {
    padding: $ds-space-0;
    background: $ds-surface-panel;
}

#settings-providers-models-card Collapsible > CollapsibleTitle,
#settings-console-behavior-card Collapsible > CollapsibleTitle {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-control-height-compact;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* TASK-33007.5 (R14): Settings inverted the Console's heights -- input rows
   one row, select rows three. On Providers & Models and Console Behavior a
   Select row is one row too: the compact Select keeps the compact input's
   left-edge convention (thin at rest, thick on focus) instead of a full
   border, which spent a row above and below on chrome. The row's label is
   named by type: the label class is pinned to the boot bundle, and these
   rules belong in the lazy Settings sheet (ADR-097). */
#settings-providers-models-card .settings-select-row,
#settings-providers-models-card .settings-select-row > Static,
#settings-console-behavior-card .settings-select-row,
#settings-console-behavior-card .settings-select-row > Static {
    height: $ds-control-height-compact;
    min-height: $ds-control-height-compact;
}

#settings-providers-models-card .settings-compact-select,
#settings-console-behavior-card .settings-compact-select {
    height: $ds-control-height-compact;
    min-height: $ds-control-height-compact;
    border: none;
    border-left: solid $ds-control-edge;
}

#settings-providers-models-card .settings-compact-select:focus,
#settings-console-behavior-card .settings-compact-select:focus {
    border: none;
    border-left: thick $ds-action-focus;
}

/* TASK-33007.4: the Applies-to row names the open chat and the pair it will
   use. It reads one row for a short chat title; a long title or model id
   wraps to a second row rather than cutting off the pair, which is the
   point of the row. */
#settings-model-applies-row {
    height: auto;
}

#settings-providers-models-card .settings-applies-to {
    width: $ds-width-fill;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
}

#settings-provider-api-key-clear,
#settings-test-provider,
#settings-model-context-window-reset {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-control-height-compact;
    min-height: $ds-control-height-compact;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

/* Capture fix 3: Review is the restored-connection row's control, in the
   Connect control column, so its Source word lines up with the others. */
#settings-openai-reconnect-review {
    height: $ds-control-height-compact;
    min-height: $ds-control-height-compact;
}

/* The list under the Provider control never takes focus (one Tab stop), so
   it draws no focus frame to hide any option's first character; its
   highlighted row keeps OptionList's own cursor colours ($ds-focus-bg). */
#settings-provider-picker {
    width: $ds-width-full;
    height: auto;
    max-height: $ds-size-10;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-panel;
}

.settings-select-row {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0;
}

/* ADR-161 task 9: the .settings-compact-input definitions (base, :focus,
   and its halves of the two .settings-invalid-input rules below) moved to
   components/_forms.tcss as the documented compact variant of form-input
   -- also composed by the pattern gallery, so it rides the boot bundle.
   The compact-SELECT stays here (Settings-only). */
.settings-compact-select.settings-invalid-input {
    background: $ds-status-error 18%;
    color: $ds-text-primary;
    text-style: bold;
    outline: none;
}

.settings-compact-select.settings-invalid-input:focus {
    /* task-1369: keep the error tint while focused so the invalid marker is
       not lost; slightly stronger than the unfocused 18% to still read as
       focused. */
    background: $ds-status-error 28%;
    color: $ds-text-primary;
    text-opacity: 1;
    text-style: bold;
    outline: none;
}

.settings-compact-select {
    width: $ds-width-fill;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0;
    padding: $ds-space-0;
    border: solid $ds-grid-line;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
}

.settings-compact-select > SelectCurrent {
    width: $ds-width-fill;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    border: none;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
    content-align: left middle;
}

.settings-compact-select:focus {
    border: solid $ds-action-focus;
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
    outline: none;
}

.settings-compact-select:focus > SelectCurrent {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
    text-style: bold;
}

.settings-compact-select > SelectOverlay {
    padding: $ds-space-0 $ds-space-1;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
    color: $ds-text-primary;
    min-width: $ds-size-30;
}

.settings-compact-select > SelectOverlay Option {
    padding: $ds-space-0 $ds-space-2;
    min-height: $ds-size-3;
    background: $ds-surface-inspector;
    color: $ds-text-primary;
}

.settings-compact-select > SelectOverlay Option:hover {
    background: $ds-input-focus-bg;
    color: $ds-text-primary;
}

.settings-provider-manual-hidden {
    display: none;
}

/* task-189: generation-profile rows a provider does not support are hidden
   entirely; the Generation defaults disclosure shows one summary line instead
   of per-row "Unavailable for <provider>" placeholders. */
.settings-gated-profile-hidden {
    display: none;
}

.settings-status-row {
    width: $ds-width-full;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0;
    background: $ds-surface-inspector;
    color: $ds-text-muted;
}

/* task-1341: intentional instant-apply controls are visually separated from
   staged fields with a bordered group plus an inline italic hint.
   task-1367: explicit height:auto -- the default Vertical 1fr never resolves
   inside the auto-height providers card and clipped every control. */
.settings-instant-apply-group {
    height: auto;
    border: solid $ds-column-line;
    background: $ds-surface-panel;
    padding: $ds-space-0 $ds-space-1;
}

/* TASK-33007.6 (spec §6 "one frame level", AC#8): inside the detail pane
   the Providers & Models card draws no frame of its own and no bordered
   group -- the pane border is the only frame, and each section starts with
   a one-row header. The instant-apply groups keep their class, hint line
   and place outside the draft (ADR-033); other focus cards keep frames. */
#settings-providers-models-card,
#settings-providers-models-card .settings-instant-apply-group {
    border: none;
}

#settings-providers-models-card .settings-instant-apply-group {
    padding: $ds-space-0;
}

/* The discovered-model list keeps the card's control edge -- thin at rest,
   thick on focus -- instead of a full-width box around its rows. The global
   focus outline would then sit on its first and last rows, so the thick
   edge and the highlighted row are its focus cue. */
#settings-discovered-models-list {
    border: none;
    border-left: solid $ds-control-edge;
}

#settings-discovered-models-list:focus {
    border: none;
    border-left: thick $ds-action-focus;
    outline: none;
}

/* Keep refresh controls inside the scrolled group at compact widths. */
#settings-model-catalog-group .settings-input-row {
    height: auto;
}

/* Every checkbox on the card is a one-row control with no box of its own
   (TASK-33007.6: Prompt-cache snapshots' joins Catalog refresh's). */
#settings-providers-models-card Checkbox {
    width: auto;
    max-width: $ds-width-full;
    height: $ds-control-height-compact;
    min-height: $ds-control-height-compact;
    border: none;
    padding: $ds-space-0;
    margin: $ds-space-0;
}

#settings-model-catalog-group Input {
    width: $ds-width-fill;
}

.settings-workbench-compact #settings-model-catalog-group .settings-input-row {
    layout: vertical;
}

.settings-instant-apply-hint {
    color: $ds-text-muted;
    text-style: italic;
    padding: $ds-space-0 $ds-space-1;
}

.settings-storage-check-result {
    min-height: $ds-size-7;
}

.settings-dirty-category {
    color: $ds-status-unsaved;
    text-style: bold;
}

/* RAG profile-manager region (task-2): read-only note for a built-in active
   profile -- attention-worthy like #library-skill-warnings above, not muted
   like the surrounding .settings-status-row lines. */
.settings-library-rag-readonly-banner {
    color: $ds-status-warning;
    text-style: bold;
}

/* RAG profile editor (task-3 review): reranker top-k vs default-results
   advisory -- same attention-worthy treatment as the readonly banner above.
   Purely informational (never gates Save; see soft_config_warnings). */
.settings-library-rag-soft-warning {
    color: $ds-status-warning;
    text-style: bold;
}

/* Task 4 (541 v2 UX AC1): profile-picker PREVIEW banner -- shown only while
   the editor is displaying a browsed, non-active profile read-only. Same
   attention-worthy treatment as the readonly banner above (hidden by
   default via Static.display, toggled by _set_library_rag_preview_banner). */
.settings-library-rag-preview-banner {
    color: $ds-status-warning;
    text-style: bold;
}

.settings-rag-profile-modal {
    width: $ds-size-60;
    height: auto;
    padding: $ds-space-1 $ds-space-2;
    border: thick $ds-action-focus;
    background: $ds-surface-panel;
}

/* TASK-33070: a name/path prompt's validation reason, shown in the dialog
   (hidden via Static.display until a submit is refused). */
.settings-rag-profile-name-error {
    height: auto;
    color: $ds-status-error-readable;
}

.settings-speech-credential-modal {
    width: $ds-size-70;
    max-width: $ds-percent-90;
    height: auto;
    padding: $ds-space-1 $ds-space-2;
    border: thick $ds-action-focus;
    background: $ds-surface-panel;
}

/* task-2835: keyboard-reachable mirror of the focused control's tooltip,
   one muted line pinned under the Settings workbench. */
#settings-focus-help {
    height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    color: $ds-text-muted;
    background: $ds-surface-panel;
}

.settings-focus-card {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

/* Overview shares the detail pane scroll owner; its primary rows must
   grow with wrapped status copy instead of shrinking as a 1fr child. */
#settings-overview-primary {
    height: auto;
}

/* Workspace rows share the detail pane scroll owner; keep every row inside
   the list's bounds so keyboard focus can reveal it beside a tall card. */
#settings-workspaces-list {
    height: auto;
}

#settings-workspaces-list .settings-workspace-row {
    max-width: $ds-width-full;
    height: auto;
    text-wrap: wrap;
}

/* Keep the selected option and its adjacent staging receipt together even
   when the user's Persona/profile catalog is long. */
#settings-workspace-persona-picker,
#settings-workspace-profile-picker {
    max-height: $ds-size-5;
    /* The generic focus outline paints over compact option text. */
    outline: none;
}

/* A Horizontal never wraps, so while the detail pane is narrower than its
   widest action row its rows stack (SettingsRegion sets settings-stacked-actions
   below SETTINGS_ACTION_ROWS_INLINE_MIN_WIDTH; this replaced the compact-only
   Overview rule). The theme card keeps its own width switch
   (components/_settings_splash_theme.tcss). */
.settings-stacked-actions .settings-action-row {
    layout: vertical;
    height: auto;
}

/* RAW CLI DANGER GATE START */
.settings-raw-cli-danger {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    padding: $ds-space-1;
    border: solid $surface-lighten-2;
    background: $surface;
}

.settings-raw-cli-danger.settings-raw-cli-armed {
    border: solid $error;
    background: $error 10%;
}

#settings-raw-cli-title,
#settings-raw-cli-state,
.settings-raw-cli-disclosure,
#settings-raw-cli-immediate {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-1;
    text-wrap: wrap;
}

#settings-raw-cli-title,
#settings-raw-cli-state {
    color: $error;
    text-style: bold;
}

.settings-raw-cli-disclosure {
    color: $text;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

#settings-raw-cli-permitted {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.settings-raw-cli-action-row {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: auto;
    min-height: $ds-size-0;
}

#settings-raw-cli-immediate {
    color: $text-muted;
}

#settings-shell Button#settings-raw-cli-arm {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0;
    border: none;
    outline: none;
    background: $error 20%;
    color: $text;
    text-style: bold;
}

#settings-shell Button#settings-raw-cli-arm:focus,
#settings-shell Button#settings-raw-cli-arm:hover,
#settings-shell Button#settings-raw-cli-arm:hover:focus {
    width: $ds-width-full;
    height: $ds-size-3;
    min-height: $ds-size-3;
    margin: $ds-space-0;
    border: none;
    outline: none;
    background: $error 20%;
    color: $text;
    text-style: bold underline;
}

/* App-tier Legible Disabled: Textual's Button dimming compounds with the
   theme's disabled opacity. The label itself states the recovery action,
   while the inert surface remains visibly distinct and above the measured
   3:1 disabled-label contrast floor. */
#settings-shell Button#settings-raw-cli-arm:disabled,
#settings-shell Button#settings-raw-cli-arm:disabled:hover,
#settings-shell Button#settings-raw-cli-arm:disabled:hover:focus {
    opacity: 100%;
    text-opacity: 100%;
    text-style: none;
    color: $text;
    background: $surface-darken-1;
    border: none;
    outline: none;
}

#settings-advanced-config-card {
    height: $ds-height-fill;
    min-height: $ds-size-0;
    border: none;
    padding: $ds-space-0;
    margin: $ds-space-0;
}

#settings-advanced-config-actions {
    grid-size: 2;
    grid-rows: 1;
    grid-gutter: 0 1;
    height: $ds-size-2;
}

#settings-advanced-config-actions Button {
    width: $ds-width-fill;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    border: none;
    padding: $ds-space-0;
}

#settings-advanced-guide {
    height: auto;
    max-height: $ds-size-8;
    overflow-y: auto;
    padding: $ds-space-0;
    margin: $ds-space-0;
    border: none;
}

#settings-advanced-guide Button {
    height: $ds-size-1;
    min-height: $ds-size-1;
    border: none;
}

#settings-advanced-config-validation-status,
#settings-advanced-config-result {
    height: auto;
    max-height: $ds-size-3;
    overflow-y: auto;
}

.settings-secondary-card {
    /* task-1625: border titles ("Profiles") were dim grey on the border
       line -- near-invisible in the critique captures. */
    border-title-color: $ds-text-primary;
    border-title-style: bold;
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    border: solid $ds-column-line;
    background: $ds-surface-panel;
}

/* Task 5 (541 v2 UX AC5): first-run starter panel -- replaces the "wall of
   disabled fields" a brand-new install used to show with a direct next
   step (Clone/Backfill). Accent border (same treatment as
   .settings-rag-profile-modal above) so it reads as the primary call to
   action, not just another secondary card. Hidden by default via
   Static.display, toggled by `_refresh_rag_first_run_panel_state`/composed
   directly by `_render_library_rag_detail`. */
.settings-library-rag-starter-panel {
    border: thick $ds-action-focus;
}

#settings-console-behavior-card {
    min-height: $ds-size-12;
}

/* Captures review note 9 (TASK-33007): Console Behavior reads with the
   Providers & Models card's grammar. The detail pane's border is the only
   frame -- the wrapper, the card and the instant-apply group draw none, and
   the wrapper's inset is the only inset -- and every one-row Input and
   Select sits in one control column instead of spanning the card. The
   column fits the longest option ("Memory with latest exchange", 27 cells
   plus 5 of chrome) whole. */
#settings-console-behavior-detail,
#settings-console-behavior-card,
#settings-console-behavior-card .settings-instant-apply-group {
    border: none;
}

#settings-console-behavior-card,
#settings-console-behavior-card .settings-instant-apply-group {
    padding: $ds-space-0;
}

#settings-console-behavior-card .settings-compact-input,
#settings-console-behavior-card .settings-compact-select {
    width: $ds-size-32;
}

/* Textual checkboxes measure one row. Compact borders and concise labels
   keep both the checkbox glyph and complete label inside the pane. */
#settings-console-behavior-card Checkbox {
    width: auto;
    max-width: $ds-width-full;
    height: auto;
    min-height: $ds-control-height-compact;
    border: none;
    padding: $ds-space-0;
    margin: $ds-space-0;
    text-wrap: wrap;
    text-overflow: clip;
}

#settings-console-context-memory-jump {
    max-width: $ds-width-full;
    height: auto;
    text-wrap: wrap;
}

.settings-action-row {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0;
}

.settings-action-row Button {
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-1 $ds-space-0 $ds-space-0;
}

/* TASK-33007.4: the Inspector's "config key" disclosure costs one row closed
   (spec §6): no global Collapsible frame, band or padding rows, and its rows
   sit one cell in under the title. */
.settings-config-key-disclosure {
    min-height: $ds-size-0;
    padding: $ds-space-0;
    margin: $ds-space-0;
    border: none;
    background: transparent;
}

.settings-config-key-disclosure > Contents {
    padding: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
    background: transparent;
}

/* TASK-33003.6: fill from components/_buttons.tcss, as above. */
.settings-action-row Button:focus,
#settings-impact-pane Button:focus {
    color: $ds-text-primary;
    text-style: bold underline;
    outline: none;
}

/* UX review item 7 (delete danger styling): visually separate the RAG
   profile-manager's destructive Delete button from the other three
   (Set active/Clone/Rename) in the same row -- variant="error" alone
   (settings_screen.py) gives it distinct color, but it still read as just
   another button in the row without the extra gap. */
.settings-library-rag-profile-delete-button {
    margin-left: $ds-space-2;
}

.settings-sync-safety-row {
    width: $ds-width-full;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-raised;
}

.settings-advanced-safety-status {
    background: $ds-status-unsaved 10%;
    color: $ds-status-unsaved;
    text-style: bold;
}

#settings-advanced-config-editor {
    height: $ds-height-fill;
    min-height: $ds-size-5;
    border: solid $ds-grid-line;
    background: $ds-surface-panel;
}

/* Settings > Image Gen: the whole panel and its nested backend-editor
   scroll region default to Textual's framework-level width/height
   fallback (1fr) since neither `Vertical`/`VerticalScroll` declares one
   in DEFAULT_CSS for a widget shaped like this -- fine for a SINGLE
   dominant 1fr child (see InternalPromptsPanel's #internal-prompts-list),
   but this panel has MANY siblings (Backends block, the backend-editor
   region, Generation defaults, Style templates, Save/Revert) all
   competing for the SAME bounded 1fr height, which starved the backend-
   editor region down to ~1 row (verified live: region height 1 vs
   virtual_size height 46) and clipped everything below it (Generation
   defaults, Save/Revert) off the bottom entirely -- `settings-detail-
   pane` (the ancestor Settings already scrolls the WHOLE category
   through) is the one and only scroll owner here. */
#settings-imagegen-panel {
    height: auto;
}

#settings-imagegen-editor {
    height: auto;
}

/* Web Search shares the Settings detail pane's scrolling document. */
#settings-web-search-panel,
#settings-web-search-fields {
    width: $ds-width-full;
    height: auto;
}

#settings-web-search-panel Select {
    width: $ds-width-full;
    margin: $ds-space-0;
}

#settings-web-search-panel Button {
    width: auto;
    max-width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    border: none;
    margin: $ds-space-0 $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
}

#settings-web-search-panel Link {
    margin: $ds-space-0 $ds-space-1;
    height: auto;
}

#settings-web-search-panel .settings-compact-input {
    width: $ds-width-full;
}

#settings-web-search-compact-actions {
    display: none;
    height: auto;
}

.settings-workbench-compact #settings-web-search-compact-actions {
    display: block;
}

/* Settings > Speech & TTS: the Settings detail pane is the single scroll
   owner. The panel must grow to its content instead of becoming a hidden-
   overflow 1fr viewport that strands Save below the terminal. */
#settings-speech-tts-panel {
    height: auto;
}

.settings-speech-provider-form,
.settings-speech-credential,
.settings-speech-control-stack {
    width: $ds-width-full;
    height: auto;
}

/* Mode-specific audio.cpp groups remain mounted so switching modes preserves
   focus and dormant values. They must size to their content; Textual's
   Vertical default of 1fr would otherwise add hundreds of blank rows and
   strand Save below the Settings scroll owner. */
#settings-speech-audio-cpp-external-fields,
#settings-speech-audio-cpp-managed-fields,
#settings-speech-audio-cpp-managed-lifecycle-fields,
#settings-speech-audio-cpp-manual-json-fields,
#settings-speech-audio-cpp-guided-fields,
#settings-speech-audio-cpp-guided-advanced-fields,
.settings-speech-audio-cpp-packages,
.settings-speech-audio-cpp-package-row {
    width: $ds-width-full;
    height: auto;
}

.settings-speech-audio-cpp-package-row {
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
    background: $ds-surface-panel;
}

.settings-speech-audio-cpp-package-copy {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
}

.settings-speech-audio-cpp-package-remove {
    width: auto;
    min-width: $ds-size-0;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
}

/* Field errors live below their control. As a third child of a Horizontal,
   the shared width:100% status row reduced otherwise usable controls to two
   cells even while empty. */
.settings-speech-input-row {
    height: auto;
    min-height: $ds-size-1;
    align: left top;
}

/* Leave room for the sibling label in horizontal forms. */
.settings-speech-input-row > .settings-speech-control-stack {
    width: $ds-width-fill;
    min-width: $ds-size-0;
}

.settings-speech-input-row.settings-select-row {
    min-height: $ds-size-3;
}

.settings-speech-field-error {
    display: none;
    width: $ds-width-full;
    min-height: $ds-size-1;
    margin: $ds-space-0;
    color: $ds-status-error;
}

.settings-speech-field-error-visible {
    display: block;
}

.settings-speech-path-control {
    width: $ds-width-full;
    height: $ds-size-1;
    min-height: $ds-size-1;
}

.settings-speech-path-control .settings-compact-input {
    width: $ds-width-fill;
}

.settings-speech-path-picker {
    width: auto;
    min-width: $ds-size-9;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
}

.settings-speech-stacked .settings-speech-input-row {
    layout: vertical;
    height: auto;
    min-height: $ds-size-3;
    margin-bottom: $ds-space-1;
}

.settings-speech-stacked #settings-speech-actions {
    layout: vertical;
    height: $ds-size-4;
}

.settings-speech-stacked #settings-speech-actions Button {
    width: $ds-width-full;
    min-width: $ds-size-0;
    margin-right: $ds-space-0;
}

/* This row includes a Select, so it cannot use an action row's single line. */
.settings-speech-voice-picker {
    height: auto;
}

.settings-speech-voice-picker > Select {
    width: $ds-width-fill;
    min-width: $ds-size-0;
}

.settings-speech-stacked .settings-speech-voice-picker {
    layout: vertical;
}

.settings-speech-stacked .settings-speech-voice-picker > Select,
.settings-speech-stacked .settings-speech-voice-picker > Button {
    width: $ds-width-full;
    min-width: $ds-size-0;
    margin-right: $ds-space-0;
}

#settings-speech-details,
#settings-speech-scope-inspector {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-3;
    margin: $ds-space-1 $ds-space-0 $ds-space-0 $ds-space-0;
    padding: $ds-space-0;
    border: none;
    background: transparent;
}

#settings-speech-inspector {
    width: $ds-width-full;
    height: auto;
}

#settings-speech-details > CollapsibleTitle,
#settings-speech-scope-inspector > CollapsibleTitle {
    width: $ds-width-full;
    min-width: $ds-size-0;
    height: $ds-size-3;
    min-height: $ds-size-3;
    padding: $ds-space-1;
}

#settings-speech-details > Contents,
#settings-speech-scope-inspector > Contents {
    width: $ds-width-full;
    height: auto;
    padding: $ds-space-0 $ds-space-1;
    background: transparent;
}

/* One row per backend inside the Backends block -- label, status badge,
   Enabled checkbox, default marker, Test button. height:auto (not the
   base .settings-input-row's fixed height:1) so the row never clips a
   wrapped Checkbox/Button. */
.settings-imagegen-backend-row {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    align: left middle;
}

/* min-width 6 (not Button's own default 16) + no left margin: at a
   120-column launch the "Preference Detail" pane is only ~53 columns
   wide, and this row packs 5 pieces (label, badge, checkbox, default
   marker, Test) -- every column here is contested (verified live:
   without this, the DEFAULT backend's row -- the one carrying "★
   Default" -- clipped Test entirely off the visible/clickable area). */
.settings-imagegen-backend-row Button {
    height: $ds-size-1;
    min-height: $ds-size-1;
    min-width: $ds-size-6;
    margin: $ds-space-0;
}

/* _conversations.tcss's bare `Checkbox { width: 100%; height: 2; }` (retired
   in TASK-18960) was an unscoped TYPE selector that reached every Checkbox
   app-wide (verified
   live: region.width computed to the ROW's full width, overlapping/
   clipping the marker and Test button that come after it in the SAME
   row) -- override both Enabled checkboxes (one per backend row) and the
   standalone "Context LLM enabled" checkbox back to a natural, single-
   line size within this panel specifically; never touching that shared
   global rule, which other screens may rely on. The backend-row Checkbox
   also drops its horizontal padding (unlike the roomier standalone
   context_llm_enabled one) -- same narrow-terminal column budget as the
   Button rule above. */
.settings-imagegen-backend-row Checkbox {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-bottom: $ds-space-0;
    border: none;
    padding: $ds-space-0;
}



#settings-imagegen-context_llm_enabled {
    width: auto;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin-bottom: $ds-space-0;
    border: none;
    padding: $ds-space-0 $ds-space-1;
}

/* No horizontal padding (final review): "Not configured" (14 chars) is
   the longest value this ever holds -- padding just wasted 2 more
   contested columns in the narrow-terminal row budget above. */
.settings-imagegen-badge {
    width: auto;
    min-width: $ds-size-14;
    color: $ds-text-muted;
}

/* No min-width (final review): reserving 10 columns even when this row
   isn't the default (the common case -- 5 of 6 rows) was pure waste on a
   narrow terminal, where every column in a backend row is contested; let
   it shrink to 0 for an empty marker and grow only for "★ Default". */
.settings-imagegen-default-marker {
    width: auto;
    color: $ds-status-info;
    text-style: bold;
}

.settings-imagegen-hint {
    width: $ds-width-full;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
    color: $ds-text-muted;
}

.settings-imagegen-key-source {
    color: $ds-status-warning;
}

/* Task 5: the secret field's row grows an inline Clear button next to the
   masked Input -- Button's own default min-width (16) plus the fixed-
   width label would overflow the base .settings-input-row's width:100%/
   height:1 (no wrap headroom), so this row gets its own auto-height class
   and the Clear button gets a narrower min-width. */
.settings-imagegen-secret-row {
    width: $ds-width-full;
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.settings-imagegen-secret-row Button.settings-imagegen-clear-button {
    width: auto;
    min-width: $ds-size-8;
    height: $ds-size-1;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-0 $ds-space-1;
}

/* SwarmUI's swarm_token is optional for local installs -- its "missing"
   source line must not read as an error like the four remote API keys. */
.settings-imagegen-key-source-neutral {
    color: $ds-text-muted;
}


.settings-hooks-review-modal { align: center middle; }
    #console-hooks-review {
        width: $ds-percent-90; max-width: $ds-size-110; height: $ds-percent-90;
        background: $ds-surface-panel; border: round $ds-grid-line;
        padding: $ds-space-inset;
    }
    #console-hooks-title { height: auto; text-style: $ds-text-strong; }
    #console-hooks-notice { height: auto; color: $ds-status-warning; }
    #console-hooks-tabs, #console-hooks-actions {
        height: $ds-control-height; width: $ds-width-full;
    }
    #console-hooks-list { height: $ds-height-fill; }
    .hook-review-row {
        height: auto; border: round $ds-grid-line;
        margin-bottom: $ds-space-stack; padding: $ds-space-0 $ds-space-inset;
    }
    .hook-review-heading, .hook-review-controls { height: $ds-control-height; }
    .hook-review-select { width: $ds-width-fill; }
    .hook-review-details { min-width: $ds-size-9; width: auto; }
    .hook-review-state, .hook-review-detail { height: auto; }
    .hook-review-state { color: $ds-text-muted; }
    .hook-review-detail { background: $ds-surface-sunken; padding: $ds-space-inset; }
    .hook-review-action {
        width: auto; min-width: $ds-size-9; height: $ds-control-height;
        margin-right: $ds-space-inline;
        background: $ds-surface-raised; color: $ds-text-primary;
    }
    .hook-review-action:hover { background: $ds-hover-bg; color: $ds-hover-fg; }
    .hook-review-action:focus {
        background: $ds-focus-bg; color: $ds-focus-fg;
    }
    .hook-review-action:disabled {
        background: $ds-disabled-bg; color: $ds-text-disabled-readable;
    }
    #console-hooks-review #console-hooks-settings { height: $ds-control-height-compact; border: none; }

.settings-hooks-panel { height: auto; }
    .settings-hooks-panel .settings-hooks-actions {
        height: auto; margin-bottom: $ds-space-1; }
    .settings-hooks-panel .settings-hooks-actions .settings-hooks-action {
        min-width: $ds-size-9; margin-right: $ds-space-1; }
    .settings-hooks-panel #settings-hooks-list { height: $ds-size-6; margin-bottom: $ds-space-1; }
    .settings-hooks-panel #settings-hooks-editor { height: auto; }
    .settings-hooks-panel #settings-hooks-command { height: $ds-textarea-min-height; margin-bottom: $ds-space-1; }
    .settings-hooks-panel .settings-hooks-field {
        margin-bottom: $ds-space-1; }
    .settings-hooks-panel .settings-hooks-copy {
        height: auto; color: $ds-text-muted; margin-bottom: $ds-space-1; }

/* Hook review follows the existing wide modal cap ladder. */
App.-wide-viewport #console-hooks-review {
    width: $ds-percent-85;
    max-width: $ds-size-170;
}
