/* ========================================
 * LAYOUT: Tab System
 * ======================================== 
 * Tab navigation and tab button styles
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


#tabs { dock: top; height: $ds-size-4; background: $background; padding: $ds-space-0 $ds-space-1; }
#tabs Button { 
    width: $ds-width-fill; 
    height: $ds-height-full; 
    min-height: $ds-size-4;
    border: none;  /* No border for tab buttons */
    background: $panel; 
    color: $text-muted; 
    padding: $ds-space-0 $ds-space-1;
}
#tabs Button:hover { 
    background: $panel-lighten-1; 
    color: $text;
}
#tabs Button.-active { 
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Single-line tab links navigation */
#tab-links-container {
    dock: top;
    height: $ds-size-4;
    background: $panel;
    padding: $ds-space-0 $ds-space-1;
    border: solid $accent;
}

#tab-links-inner {
    layout: horizontal;
    height: auto;
    width: auto;
    background: transparent;
    margin: $ds-space-0;
    padding: $ds-space-0;
}

#tab-links-inner > Static {
    width: auto;
    height: $ds-size-1;
    margin: $ds-space-0;
}

.tab-link {
    color: $text-muted;
    padding: $ds-space-0 $ds-space-1;
    text-style: none;
    width: auto;
    height: auto;
}

.tab-link:hover {
    color: $text;
    text-style: underline;
    background: $panel-lighten-1;
}

.tab-link.-active {
    color: $ds-focus-fg;
    text-style: bold underline;
    background: transparent;
}

.tab-link.-active:hover {
    text-style: bold underline;
}

Tab.-active,
Tabs:focus .-active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

.tab-separator {
    color: $text-muted;
    padding: $ds-space-0;
    width: auto;
    height: $ds-size-1;
}

/* Group separators - visually heavier than within-group separators */
.tab-group-separator {
    color: $accent;
    padding: $ds-space-0 $ds-space-2;
    width: auto;
    height: $ds-size-1;
    text-style: bold;
}

/* Group separator in button-based tab bar */
#tabs .tab-group-separator {
    width: auto;
    min-width: $ds-size-3;
    height: $ds-height-full;
    min-height: $ds-size-4;
    background: transparent;
    color: $accent;
    border: none;
    padding: $ds-space-0 $ds-space-1;
}
