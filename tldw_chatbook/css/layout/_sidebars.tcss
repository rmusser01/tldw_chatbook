/* ========================================
 * LAYOUT: Sidebars
 * ========================================
 * Generic sidebar patterns and collapsible behavior
 * Used across multiple features
 * ======================================== */
/* ADR-161 §3.10 in-place literal migration (2026-09-13): every dimension
   value below is a $ds token (space/size/percent scales), transcribed
   value-identically from the raw literals; comments stay load-bearing. */


/* ----------------------------------------
 * Enhanced Sidebar Styles
 * ---------------------------------------- */

/* Enhanced sidebar container */
.enhanced-sidebar {
    height: $ds-height-full;
    background: $boost;
}

/* Sidebar header with improved visibility */
.sidebar-header {
    height: $ds-size-3;
    padding: $ds-space-0 $ds-space-1;
    background: $surface;
    border-bottom: solid $surface-lighten-1;
    align: center middle;
}

.sidebar-title {
    text-style: bold;
    color: $text;
    text-align: left;
}

/* Search container with better visibility */
.search-container {
    height: $ds-size-3;
    padding: $ds-space-0 $ds-space-1;
    background: transparent;
    border-bottom: none;
}

.search-input {
    width: $ds-width-full;
    border: round $surface-lighten-1;
    background: $background;
}

/* ----------------------------------------
 * Visual Grouping & Organization
 * ---------------------------------------- */

/* Quick Actions Bar */
.quick-actions-bar {
    height: $ds-size-3;
    padding: $ds-space-0 $ds-space-1;
    margin-bottom: $ds-space-1;
    background: $primary 10%;
    border-bottom: solid $primary;
}

.quick-action-btn {
    width: auto;
    margin: $ds-space-0 $ds-space-1;
    padding: $ds-space-0 $ds-space-1;
}

/* Search Input */
.sidebar-search-input {
    width: $ds-width-full;
    margin: $ds-space-1 $ds-space-0;
    border: round $accent;
}

/* Group Headers */
.group-header {
    text-style: bold;
    color: $text-muted;
    margin: $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
}

/* Section Dividers */
.sidebar-section-divider {
    height: $ds-size-1;
    margin: $ds-space-2 $ds-space-0;
    border-top: solid $primary 30%;
    opacity: 50%;
}

/* Settings Groups with Enhanced Visibility */
.settings-group {
    padding-left: $ds-space-1;
    margin: $ds-space-1 $ds-space-0;
}

/* Improved contrast - from 5% to 15-20% */
.primary-group {
    background: $success 15%;
}

.secondary-group {
    background: $primary 15%;
}

.advanced-group {
    background: $warning 15%;
}

/* Enhanced setting groups with clear visual hierarchy */
.setting-group {
    margin: $ds-space-2 $ds-space-0;
    padding: $ds-space-1;
}

.setting-group-essential {
    border-left: solid $success;
    background: transparent;
}

.setting-group-common {
    border-left: solid $primary;
    background: transparent;
}

.setting-group-advanced {
    border-left: solid $warning;
    background: transparent;
}

/* Priority Indicators */
.priority-high > CollapsibleTitle {
    text-style: bold;
    border-left: thick $success;
    padding-left: $ds-space-1;
}

/* Nested indentation */
.settings-group .settings-collapsible {
    margin-left: $ds-space-1;
}

/* Fix for Collapsible widgets in sidebars */
.settings-collapsible {
    height: auto;
    min-height: $ds-size-3;  /* Ensure title is visible */
}

.settings-collapsible CollapsibleTitle {
    height: auto;
    min-height: $ds-size-1;
    padding: $ds-space-0 $ds-space-1;
}

.settings-collapsible Contents {
    height: auto;
    padding: $ds-space-1;
}

/* Ensure checkboxes and other controls are visible */
.settings-collapsible Checkbox {
    height: auto;
    min-height: $ds-size-1;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.settings-collapsible Input {
    height: auto;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

.settings-collapsible Select {
    height: auto;
    min-height: $ds-size-3;
    margin: $ds-space-0 $ds-space-0 $ds-space-1 $ds-space-0;
}

/* Sidebar Styling */
/* Generic .sidebar (used by #chat-left-sidebar and potentially others) */
.sidebar {
    dock: left;
    /* Layout law (ADR-150): standard shell sidebar geometry is tokenized. */
    width: $ds-sidebar-width; /* Reduced from 35% for better chat area space */
    min-width: $ds-sidebar-min-width; /* Reduced from 45 */
    max-width: $ds-sidebar-max-width; /* Maximum width (optional) */
    background: $boost;
    padding: $ds-space-0 $ds-space-inline;
    border-right: solid $surface;
    height: $ds-height-full;
    overflow-y: auto;
    overflow-x: hidden;
}
/* Collapsed state for the existing left sidebar */
.sidebar.collapsed {
    width: $ds-size-0 !important;
    min-width: $ds-size-0 !important; /* Ensure min-width is also 0 */
    border-right: none !important;
    padding: $ds-space-0 !important;
    overflow: hidden !important;
    display: none; /* ensures it doesn't grab focus */
}

/* Common sidebar elements */
.sidebar-title { text-style: bold; margin-bottom: $ds-space-1; width: $ds-width-full; text-align: left; }

/* Sidebar header with resize controls */
.sidebar-header-with-resize {
    height: $ds-size-2;
    align: left middle;
    margin-bottom: $ds-space-1;
}

.sidebar-header-with-resize .flex-grow {
    width: $ds-width-fill;
}

.sidebar-label { margin-top: $ds-space-1; text-style: bold; }
.sidebar-input {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    border: solid $primary-lighten-2;
    border-bottom: solid $primary-lighten-2;
}
.sidebar-textarea {
    width: $ds-width-full;
    height: $ds-size-5;  /* Default height for text areas */
    border: round $surface;
    margin-bottom: $ds-space-1;
}

/* Notes expand button */
/* T169: the two legacy "notes content header"/"notes content label"
 * classes previously declared here were pruned -- pre-workbench Notes tab
 * CSS (Notes_Window.py, since removed) with zero live references anywhere
 * in tldw_chatbook/*.py. .notes-expand-button below is still live (Chat
 * sidebar's "Notes" expand control). */
.notes-expand-button {
    width: auto;
    min-width: $ds-size-12;
    height: $ds-size-3;
    margin-left: $ds-space-1;
    padding: $ds-space-0 $ds-space-2;
    color: $text;
    background: $surface;
    text-style: bold;
    text-align: center;
}

/* Ensure button text is visible */
#chat-notes-expand-button {
    color: $text !important;
}

/* General sidebar button styling.
 * ADR-161 task 6: margin-bottom replaces the old `margin: 1 0` shorthand --
 * features/_conversations.tcss's deleted duplicate overrode it with a bare
 * `margin-bottom: 1`, and Textual applies a cross-rule longhand as a
 * full-group replacement, so the computed margin was already (0, 0, 1, 0).
 * The folded form reproduces exactly that. */
.sidebar-button {
    width: $ds-width-full;
    height: $ds-size-3;
    margin-bottom: $ds-space-1;
    padding: $ds-space-0 $ds-space-2;
    text-align: center;
}

/* Notes textarea states */
.notes-textarea-normal {
    height: $ds-size-10;
}

.notes-textarea-expanded {
    height: $ds-size-25;
    border: round $accent;
}
.sidebar Select {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    border: solid $primary-lighten-2;
    border-bottom: solid $primary-lighten-2;
}

.prompt-display-textarea {
    height: $ds-size-7; /* Example height */
    border: round $primary-lighten-2;
    background: $primary-background;
}

/* ADR-161 task 6: folded the winning declarations of the deleted
 * features/_conversations.tcss duplicate (margin, border color); the
 * computed styles are unchanged. */
.sidebar-listview {
    height: $ds-size-10; /* Example height for listviews in sidebars */
    margin-bottom: $ds-space-1;
    border: round $surface;
    background: $primary-background;
}

/* Enhanced sidebar sections with UX improvements */
.sidebar-section-collapsible {
    margin-bottom: $ds-space-1;
    border: round $surface-lighten-1;
    background: $surface;
}

.sidebar-section-collapsible:focus-within {
    border: round $ds-focus-accent;
    background: $ds-focus-bg;
}

/* Section loading state */
.section-loading {
    align: center middle;
    height: $ds-size-3;
}

.loading-fade {
    opacity: 50%;
}

/* Search mode indicator */
.sidebar.search-active {
    border: solid $warning;
}

/* ----------------------------------------
 * Enhanced Sidebar Components
 * ---------------------------------------- */

/* Tab content styling */
.tab-content {
    padding: $ds-space-1;
    height: $ds-height-full;
}

.setting-input {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    border: solid $primary-lighten-1;
    border-bottom: solid $primary-lighten-1;
}

/* Modified settings indicator */
.setting-modified {
    border: solid $accent !important;
    background: $accent 10% !important;
}

/* Temperature visual indicator */
.temperature-container {
    height: $ds-size-3;
    align: left middle;
}

.temperature-input {
    width: $ds-percent-70;
}

.temp-indicator {
    width: $ds-percent-30;
    text-align: center;
    padding-left: $ds-space-1;
}

/* System prompt styling */
.system-prompt-input {
    width: $ds-width-full;
    height: $ds-size-8;
    border: round $surface;
    margin-bottom: $ds-space-1;
    background: $background 5%;
}

/* New chat buttons */
.new-chat-buttons {
    height: $ds-size-3;
    margin: $ds-space-1 $ds-space-0;
    align: center middle;
}

.primary-button {
    width: $ds-percent-45;
    margin: $ds-space-0 $ds-space-1;
}

.secondary-button {
    width: $ds-percent-45;
    margin: $ds-space-0 $ds-space-1;
}

/* Info display fields */
.info-display {
    width: $ds-width-full;
    margin-bottom: $ds-space-1;
    background: $surface 20%;
    color: $text-muted;
}

/* Checkbox styling */
.streaming-toggle, .advanced-toggle {
    margin: $ds-space-1 $ds-space-0;
    padding: $ds-space-0 $ds-space-1;
}

/* TabbedContent customization */
TabbedContent {
    height: auto;
}

TabbedContent > TabPane {
    padding: $ds-space-0;
    height: auto;
}

TabbedContent Tabs {
    background: $surface 10%;
    height: $ds-size-3;
}

TabbedContent Tab {
    padding: $ds-space-0 $ds-space-1;
}

TabbedContent Tab.-active {
    background: $ds-focus-bg;
    color: $ds-focus-fg;
    text-style: bold underline;
}

/* Hide the tab underline indicator */
TabbedContent Underline {
    height: $ds-size-0;
    display: none;
}

/* Search results styling */
.search-results {
    padding: $ds-space-1;
}

.search-result-item {
    margin: $ds-space-1 $ds-space-0;
    padding: $ds-space-1;
    background: $surface 10%;
    border: round $surface-lighten-1;
}

.search-result-item:hover {
    background: $surface-lighten-1;
    color: $text;
    border: round $surface-lighten-2;
}

/* Highlight matched text in search */
.search-highlight {
    background: $warning 30%;
    text-style: bold;
}

/* Loading indicator for lazy tabs */
.tab-loading {
    align: center middle;
    height: $ds-size-10;
}

/* Reset button styling */
.reset-button {
    width: auto;
    min-width: $ds-size-3;
    height: $ds-size-2;
    padding: $ds-space-0 $ds-space-1;
    background: $warning 20%;
    border: tall $warning;
}

.reset-button:hover {
    background: $surface-lighten-1;
    color: $text;
}

/* Note: Textual doesn't support @media queries for responsive design
   These rules would need to be applied programmatically based on screen size */

/* --- End of Sidebar Styling --- */
