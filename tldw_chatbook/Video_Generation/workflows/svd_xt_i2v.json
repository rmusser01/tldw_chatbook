{
  "1": {
    "class_type": "LoadImage",
    "inputs": {"image": "example.png"},
    "_meta": {"title": "Input Image"}
  },
  "2": {
    "class_type": "ImageOnlyCheckpointLoader",
    "inputs": {"ckpt_name": "svd_xt.safetensors"},
    "_meta": {"title": "SVD XT Model"}
  },
  "3": {
    "class_type": "SVD_img2vid_Conditioning",
    "inputs": {"width": 1024, "height": 576, "video_frames": 25, "motion_bucket_id": 127, "fps": 6, "augmentation_level": 0.0, "clip_vision": ["2", 1], "init_image": ["1", 0], "vae": ["2", 2]},
    "_meta": {"title": "Width Height Frames FPS"}
  },
  "4": {
    "class_type": "KSampler",
    "inputs": {"seed": 0, "steps": 20, "cfg": 2.5, "sampler_name": "euler", "scheduler": "karras", "denoise": 1.0, "model": ["2", 0], "positive": ["3", 0], "negative": ["3", 1], "latent_image": ["3", 2]},
    "_meta": {"title": "Seed"}
  },
  "5": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["4", 0], "vae": ["2", 2]},
    "_meta": {"title": "Decode"}
  },
  "6": {
    "class_type": "SaveAnimatedWEBP",
    "inputs": {"images": ["5", 0], "filename_prefix": "video/svd_xt_i2v", "fps": 6, "lossless": false, "quality": 90, "method": "default"},
    "_meta": {"title": "FPS"}
  }
}
