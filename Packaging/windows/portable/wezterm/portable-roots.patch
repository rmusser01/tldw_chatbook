+//! Process-local roots and socket addresses for the Windows Chatbook prototype.
+use std::io::{Error, ErrorKind};
+use std::path::{Component, Path, PathBuf};
+
+pub(crate) fn path_override(name: &str) -> std::io::Result<Option<PathBuf>> {
+    let Some(value) = std::env::var_os(name) else {
+        return Ok(None);
+    };
+    let path = PathBuf::from(value);
+    if !path.is_absolute() {
+        return Err(invalid(format!("{name} must be a nonempty absolute path")));
+    }
+    Ok(Some(path))
+}
+
+fn invalid(message: impl Into<String>) -> Error {
+    Error::new(ErrorKind::InvalidInput, message.into())
+}
+
+/// Shorten only the syscall address; filesystem and published paths stay absolute.
+pub fn socket_address(path: &Path) -> std::io::Result<PathBuf> {
+    let root = path_override("CHATBOOK_WEZTERM_RUNTIME_DIR")?;
+    if root.is_none() {
+        return Ok(path.to_path_buf());
+    }
+    socket_address_for(path, root.as_deref(), &std::env::current_dir()?)
+}
+
+fn socket_address_for(path: &Path, root: Option<&Path>, cwd: &Path) -> std::io::Result<PathBuf> {
+    let Some(root) = root else {
+        return Ok(path.to_path_buf());
+    };
+    if !root.is_absolute()
+        || !path.is_absolute()
+        || !cwd.is_absolute()
+        || !path.starts_with(root)
+        || [path, root, cwd]
+            .iter()
+            .any(|path| path.components().any(|part| part == Component::ParentDir))
+    {
+        return Err(invalid(
+            "portable socket must be inside its absolute runtime root",
+        ));
+    }
+    let relative = path.strip_prefix(cwd).map_err(|_| {
+        invalid("portable socket requires a working directory above its runtime root")
+    })?;
+    let bytes = relative
+        .to_str()
+        .ok_or_else(|| invalid("socket path must be UTF-8"))?;
+    // The pinned uds_windows uses sockaddr_un.sun_path[108], including the NUL.
+    if bytes.is_empty() || bytes.len() >= 108 {
+        return Err(invalid(
+            "portable socket address must contain 1 to 107 UTF-8 bytes",
+        ));
+    }
+    Ok(relative.to_path_buf())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn portable_path_override_accepts_only_absolute_nonempty_roots() {
+        const NAME: &str = "CHATBOOK_WEZTERM_TEST_ROOT";
+        std::env::remove_var(NAME);
+        assert_eq!(path_override(NAME).unwrap(), None);
+        for invalid in ["", "relative", "C:relative", r"\rooted"] {
+            std::env::set_var(NAME, invalid);
+            let error = path_override(NAME).unwrap_err();
+            assert_eq!(error.kind(), ErrorKind::InvalidInput);
+            assert!(error.to_string().contains(NAME));
+        }
+        for valid in [r"C:\portable space ü\Data\wezterm", r"\\server\share\Data"] {
+            std::env::set_var(NAME, valid);
+            assert_eq!(path_override(NAME).unwrap(), Some(PathBuf::from(valid)));
+        }
+        std::env::remove_var(NAME);
+    }
+
+    #[test]
+    fn deep_unicode_socket_uses_a_short_data_relative_address() {
+        let data = PathBuf::from(format!(r"C:\{}\Data", "deep space ü\\".repeat(30)));
+        let root = data.join("wezterm/runtime");
+        let path = root.join("gui-sock-42");
+        assert!(path.to_str().unwrap().len() > 108);
+        assert_eq!(
+            socket_address_for(&path, Some(&root), &data).unwrap(),
+            PathBuf::from("wezterm/runtime/gui-sock-42")
+        );
+        assert_eq!(socket_address_for(&path, None, &data).unwrap(), path);
+    }
+
+    #[test]
+    fn portable_socket_rejects_outside_root_wrong_cwd_and_parent_traversal() {
+        let data = Path::new(r"C:\Data");
+        let root = data.join("runtime");
+        for path in [data.join("outside/sock"), root.join("../outside/sock")] {
+            assert_eq!(
+                socket_address_for(&path, Some(&root), data)
+                    .unwrap_err()
+                    .kind(),
+                ErrorKind::InvalidInput
+            );
+        }
+        assert!(
+            socket_address_for(&root.join("sock"), Some(&root), Path::new(r"C:\Other")).is_err()
+        );
+    }
+
+    #[test]
+    fn portable_socket_enforces_the_exact_utf8_byte_limit() {
+        let data = Path::new(r"C:\Data");
+        let root = data.join("r");
+        let at_limit = root.join(format!("{}x", "é".repeat(52)));
+        let address = socket_address_for(&at_limit, Some(&root), data).unwrap();
+        assert_eq!(address.to_str().unwrap().len(), 107);
+        let too_long = root.join(format!("{}xx", "é".repeat(52)));
+        assert!(socket_address_for(&too_long, Some(&root), data).is_err());
+    }
+}
