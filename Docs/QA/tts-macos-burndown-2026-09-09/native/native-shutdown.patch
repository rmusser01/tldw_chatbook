diff --git a/tests/unittests/test_http_shutdown.cpp b/tests/unittests/test_http_shutdown.cpp
new file mode 100644
index 0000000..623fd0b
--- /dev/null
+++ b/tests/unittests/test_http_shutdown.cpp
@@ -0,0 +1,248 @@
+// A request must finish before serve_http returns and destroys its handler.
+// Exercise the real transport without loading a model or running inference.
+#include "../../app/server/http.h"
+
+#include <atomic>
+#include <chrono>
+#include <csignal>
+#include <future>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <thread>
+
+#ifdef _WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+using socket_t = SOCKET;
+constexpr socket_t invalid_socket = INVALID_SOCKET;
+#else
+#include <arpa/inet.h>
+#include <sys/select.h>
+#include <sys/socket.h>
+#include <unistd.h>
+using socket_t = int;
+constexpr socket_t invalid_socket = -1;
+#endif
+
+namespace {
+using namespace std::chrono_literals;
+
+std::atomic<bool> stop{false};
+std::atomic<int> polls{0};
+bool fail_accept_loop = false;
+
+bool stop_requested() {
+    polls.fetch_add(1);
+    if (stop.load() && fail_accept_loop) {
+        throw std::runtime_error("test accept-loop failure");
+    }
+    return stop.load();
+}
+
+void close_socket(socket_t socket) {
+#ifdef _WIN32
+    closesocket(socket);
+#else
+    close(socket);
+#endif
+}
+
+void require(bool condition, const char * message) {
+    if (!condition) {
+        throw std::runtime_error(message);
+    }
+}
+
+class GateHandler final : public minitts::server::IHttpHandler {
+public:
+    std::promise<void> entered;
+    std::promise<void> released;
+    std::shared_future<void> gate = released.get_future().share();
+
+    minitts::server::HttpResponse handle(const minitts::server::HttpRequest & request) override {
+        if (request.path == "/throw") {
+            throw std::runtime_error("test handler failure");
+        }
+        if (request.path == "/blocked") {
+            entered.set_value();
+            gate.wait();
+        }
+        auto response = minitts::server::json_response("{\"ok\":true}");
+        if (request.path == "/stream") {
+            response.stream_body = [this](minitts::server::HttpStreamWriter & writer) {
+                entered.set_value();
+                gate.wait();
+                writer.write("finished");
+            };
+        }
+        return response;
+    }
+};
+
+socket_t connect_client(int port) {
+    sockaddr_in address{};
+    address.sin_family = AF_INET;
+    address.sin_port = htons(static_cast<uint16_t>(port));
+    inet_pton(AF_INET, "127.0.0.1", &address.sin_addr);
+    const auto deadline = std::chrono::steady_clock::now() + 3s;
+    do {
+        const socket_t socket = ::socket(AF_INET, SOCK_STREAM, 0);
+        require(socket != invalid_socket, "could not create client socket");
+        if (connect(socket, reinterpret_cast<sockaddr *>(&address), sizeof(address)) == 0) {
+            return socket;
+        }
+        close_socket(socket);
+        std::this_thread::sleep_for(5ms);
+    } while (std::chrono::steady_clock::now() < deadline);
+    throw std::runtime_error("test listener did not become ready");
+}
+
+void send_request(socket_t socket, const std::string & request) {
+    size_t offset = 0;
+    while (offset < request.size()) {
+        const int written = static_cast<int>(send(
+            socket, request.data() + offset, static_cast<int>(request.size() - offset), 0));
+        require(written > 0, "client send failed");
+        offset += static_cast<size_t>(written);
+    }
+}
+
+std::string receive_reply(socket_t socket) {
+    std::string reply;
+    char buffer[4096];
+    for (;;) {
+        const int received = static_cast<int>(recv(socket, buffer, sizeof(buffer), 0));
+        if (received <= 0) {
+            return reply;
+        }
+        reply.append(buffer, static_cast<size_t>(received));
+    }
+}
+
+bool peer_closed(socket_t socket) {
+    fd_set readers;
+    FD_ZERO(&readers);
+    FD_SET(socket, &readers);
+    timeval timeout{0, 400000};
+#ifdef _WIN32
+    const int ready = select(0, &readers, nullptr, nullptr, &timeout);
+#else
+    const int ready = select(socket + 1, &readers, nullptr, nullptr, &timeout);
+#endif
+    if (ready <= 0) {
+        return false;
+    }
+    char byte;
+    return recv(socket, &byte, 1, MSG_PEEK) <= 0;
+}
+
+void await_accepted(int previous_polls) {
+    const auto deadline = std::chrono::steady_clock::now() + 2s;
+    while (polls.load() < previous_polls + 2) {
+        require(std::chrono::steady_clock::now() < deadline, "accept loop did not advance");
+        std::this_thread::sleep_for(1ms);
+    }
+}
+
+}  // namespace
+
+int main(int argc, char ** argv) {
+    if (argc != 3) {
+        std::cerr << "usage: http_shutdown_test <case> <port>\n";
+        return 2;
+    }
+#ifdef _WIN32
+    WSADATA wsa;
+    WSAStartup(MAKEWORD(2, 2), &wsa);
+#endif
+#ifdef SIGPIPE
+    std::signal(SIGPIPE, SIG_IGN);
+#endif
+    const std::string scenario = argv[1];
+    const int port = std::stoi(argv[2]);
+    fail_accept_loop = scenario == "accept-loop-exception";
+    GateHandler handler;
+    auto entered = handler.entered.get_future();
+    std::promise<void> returned;
+    auto finished = returned.get_future();
+    std::thread server([&] {
+        try {
+            minitts::server::serve_http("127.0.0.1", port, handler, stop_requested, 1024 * 1024);
+            returned.set_value();
+        } catch (...) {
+            returned.set_exception(std::current_exception());
+        }
+    });
+    socket_t client = invalid_socket;
+    bool gate_released = false;
+    std::string failure;
+    try {
+        client = connect_client(port);
+        if (scenario == "active-handler" || scenario == "stream-callback" || fail_accept_loop) {
+            const std::string path = scenario == "stream-callback" ? "/stream" : "/blocked";
+            send_request(client, "GET " + path + " HTTP/1.1\r\nHost: test\r\n\r\n");
+            require(entered.wait_for(2s) == std::future_status::ready, "handler did not enter its gate");
+            stop.store(true);
+            const bool returned_early = finished.wait_for(600ms) == std::future_status::ready;
+            handler.released.set_value();
+            gate_released = true;
+            // Drain even on the failing baseline so its detached worker unwinds
+            // before the test destroys the handler it is deliberately protecting.
+            (void) receive_reply(client);
+            require(finished.wait_for(2s) == std::future_status::ready, "server did not finish after gate release");
+            require(!returned_early, "serve_http returned while the accepted request was still blocked");
+        } else if (scenario == "idle-client" || scenario == "partial-header" || scenario == "partial-body") {
+            if (scenario == "partial-header") {
+                send_request(client, "POST /blocked HTTP/1.1\r\nHost:");
+            } else if (scenario == "partial-body") {
+                send_request(client, "POST /blocked HTTP/1.1\r\nHost: test\r\nContent-Length: 12\r\n\r\nabc");
+            }
+            await_accepted(polls.load());
+            stop.store(true);
+            require(finished.wait_for(2s) == std::future_status::ready, "shutdown remained blocked on incomplete client I/O");
+            require(peer_closed(client), "serve_http returned but the incomplete client socket remained open");
+        } else if (scenario == "idle" || scenario == "completed-request" || scenario == "handler-exception") {
+            const std::string path = scenario == "handler-exception" ? "/throw" : "/";
+            send_request(client, "GET " + path + " HTTP/1.1\r\nHost: test\r\n\r\n");
+            const std::string response = receive_reply(client);
+            require(response.find(scenario == "handler-exception" ? "500" : "200") != std::string::npos,
+                    "ordinary response status changed");
+            close_socket(client);
+            client = invalid_socket;
+            stop.store(true);
+            require(finished.wait_for(2s) == std::future_status::ready, "idle shutdown did not finish");
+        } else {
+            throw std::runtime_error("unknown test case");
+        }
+    } catch (const std::exception & ex) {
+        failure = ex.what();
+    }
+    if (!gate_released) {
+        handler.released.set_value();
+    }
+    if (client != invalid_socket) {
+        close_socket(client);
+    }
+    stop.store(true);
+    server.join();
+    try {
+        finished.get();
+        if (fail_accept_loop && failure.empty()) {
+            failure = "accept-loop failure was lost";
+        }
+    } catch (const std::exception & ex) {
+        if (!fail_accept_loop || std::string(ex.what()) != "test accept-loop failure") {
+            failure = ex.what();
+        }
+    }
+#ifdef _WIN32
+    WSACleanup();
+#endif
+    std::cout << (failure.empty() ? "PASS " : "FAIL ") << scenario;
+    if (!failure.empty()) {
+        std::cout << ": " << failure;
+    }
+    std::cout << "\n";
+    return failure.empty() ? 0 : 1;
+}
