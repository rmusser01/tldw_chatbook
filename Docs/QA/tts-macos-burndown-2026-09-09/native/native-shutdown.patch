+// The handler belongs to serve_http's caller. Keep every request (including its
+// streaming callback) joined before that caller can destroy model/backend state.
+class ClientWorkers {
+public:
+    ~ClientWorkers() {
+        shutdown_and_join();
+    }
+
+    void start(UniqueSocket socket, IHttpHandler & handler, uint64_t max_request_body_bytes) {
+        auto worker = std::make_unique<Worker>(std::move(socket));
+        auto * entry = worker.get();
+        workers_.push_back(std::move(worker));
+        try {
+            entry->thread = std::thread([this, entry, &handler, max_request_body_bytes] {
+                handle_client(entry->socket, handler, max_request_body_bytes);
+                // Serialize close with shutdown: otherwise a recycled descriptor
+                // could refer to an unrelated socket when the server drains.
+                std::lock_guard<std::mutex> lock(socket_mutex_);
+                entry->socket = UniqueSocket{};
+                entry->finished.store(true, std::memory_order_release);
+            });
+        } catch (...) {
+            workers_.pop_back();
+            throw;
+        }
+    }
+
+    void reap_finished() {
+        for (auto it = workers_.begin(); it != workers_.end();) {
+            if ((*it)->finished.load(std::memory_order_acquire)) {
+                (*it)->thread.join();
+                it = workers_.erase(it);
+            } else {
+                ++it;
+            }
+        }
+    }
+
+    void shutdown_and_join() {
+        {
+            std::lock_guard<std::mutex> lock(socket_mutex_);
+            for (const auto & worker : workers_) {
+                const auto socket = worker->socket.get();
+                if (socket != kInvalidSocket) {
+#ifdef _WIN32
+                    shutdown(socket, SD_BOTH);
+#else
+                    shutdown(socket, SHUT_RDWR);
+#endif
+                }
+            }
+        }
+        // Never hold the socket lock while joining: finishing workers need it.
+        // Native inference may still finish here; the supervising process owns
+        // the hard deadline if a backend cannot return from computation.
+        for (const auto & worker : workers_) {
+            if (worker->thread.joinable()) {
+                worker->thread.join();
+            }
+        }
+        workers_.clear();
+    }
+
+private:
+    struct Worker {
+        explicit Worker(UniqueSocket client) : socket(std::move(client)) {}
+        UniqueSocket socket;
+        std::thread thread;
+        std::atomic<bool> finished{false};
+    };
+
+    std::mutex socket_mutex_;
+    std::vector<std::unique_ptr<Worker>> workers_;
+};
