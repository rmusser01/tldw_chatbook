+    stream->streamFinishedArmed = 1;
+
     return paNoError;
 #undef ERR_WRAP
 }
@@ -2807,6 +2893,13 @@ static PaError FinishStoppingStream( PaMacCoreStream *stream )
     stream->xrunFlags = 0;
