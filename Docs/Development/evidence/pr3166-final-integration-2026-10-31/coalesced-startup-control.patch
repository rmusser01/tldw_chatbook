+async def _event_within(event, *, timeout=10.0):
+    """Observe an existing completion event without periodic UI work."""
+    try:
+        await asyncio.wait_for(event.wait(), timeout)
+    except TimeoutError:
+        return event.is_set()
+    return True
+
+
+async def _readiness_settled(console, projection, *, no_replay, deadline=None):
+    """Keep the original setup predicate/deadline while awaiting its owners.
+
+    Pilot.pause(0.01) repeatedly waits on UI pumps while the native reader runs. The
+    Windows clock can resolve only 15.625ms; existing worker completion is the
+    relevant signal, and asyncio.wait never cancels those production tasks.
+    """
+    def ready():
+        return (
+            not projection.pending
+            and not console._console_sync_in_progress
+            and (not no_replay or not getattr(
+                console, "_console_control_bar_replay_whole_sync", False
+            ))
+        )
+
+    if deadline is None:
+        deadline = time.monotonic() + 10.0
+    while not ready():
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            return ready()
+        tasks = {
+            worker._task for worker in console.workers
+            if worker.node is console and not worker.is_finished
+            and worker.group in {
+                "console-sync", "console-readiness-config",
+                "console-readiness-publication",
+            }
+            and worker._task is not None and not worker._task.done()
+        }
+        if tasks:
+            done, _ = await asyncio.wait(
+                tasks, timeout=remaining, return_when=asyncio.FIRST_COMPLETED
+            )
+            if not done:
+                return ready()
+        else:
+            # A queued after-refresh callback may start the next owner.
+            refreshed = asyncio.Event()
+            console.call_after_refresh(refreshed.set)
+            if not await _event_within(refreshed, timeout=remaining):
+                return ready()
+    return True
+
+
+async def _finish_startup_publication(console, *, deadline):
+    """Finish the exact attach owner before holding its downstream Surface lock.
+
+    Attach schedules FULL on the screen pump via call_after_refresh. Taking
+    the Surface lock before that callback retires blocks real Pilot delivery.
+    This prerequisite shares the original ten-second readiness deadline.
+    """
+    while not console._console_attach_reconciled:
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            return False
+        tasks = {
+            worker._task for worker in console.workers
+            if worker.node is console and not worker.is_finished
+            and worker.group in {
+                "console-attach-reconciliation", "console-sync",
+                "console-readiness-config", "console-readiness-publication",
+            }
+            and worker._task is not None and not worker._task.done()
+        }
+        if tasks:
+            done, _ = await asyncio.wait(
+                tasks, timeout=remaining, return_when=asyncio.FIRST_COMPLETED
+            )
+            if not done:
+                return False
+        else:
+            refreshed = asyncio.Event()
+            console.call_after_refresh(refreshed.set)
+            if not await _event_within(refreshed, timeout=remaining):
+                return False
+    # The reconciler schedules startup FULL before marking itself reconciled.
+    # A later callback on that same pump proves this publication has retired.
+    published = asyncio.Event()
+    console.call_after_refresh(published.set)
+    remaining = deadline - time.monotonic()
+    return (
+        remaining > 0 and await _event_within(published, timeout=remaining)
+        and console._console_attach_view_started
+        and console._console_attach_reconciled
+    )
+
+
