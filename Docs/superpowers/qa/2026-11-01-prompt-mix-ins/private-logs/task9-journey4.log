character = True

    @pytest.mark.asyncio
    @pytest.mark.parametrize("character", [False, True])
    async def test_local_queue_retry_current_regenerate_reopen(local_journey, character):
        h = local_journey
        if character:
            h.store.set_session_character_name("session-1", character_name="Detective", global_default="User")
            h.store.seed_character_roleplay(
                "session-1", system_template="You are a detective.", greeting_template="", global_default="User"
            )
        toggle(h, False)
        baseline = await h.controller.submit_draft("baseline", session_id="session-1")
        assert baseline.provider_started
        h.entries.clear()
        toggle(h, True)
        other = h.store.create_session(title="Other", ephemeral=True)
        registry = h.controller.prompt_queue_registry
        registry.begin_chain("session-1", context_epoch=h.store.conversation_context_epoch("session-1"), expected_revision=0)
        queued = await h.controller.queue_prompt(
            "session-1", text="input", expected_revision=registry.snapshot("session-1").revision
        )
        assert queued.applied
        registry.pause("session-1", reason=PromptQueuePauseReason.MANUAL, expected_revision=registry.snapshot("session-1").revision)
        await edit_source(h)
        toggle(h, False)
        h.store.switch_session(other.id)
        h.adapter_error = True
        resumed = await h.controller.prompt_queue_coordinator.resume_and_drain("session-1")
        assert len(h.entries) == 1, resumed
        reply = next(row for row in h.store.messages_for_session("session-1") if row.role.value == "assistant")
