<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!-- Capture-only alias for Rich's exported Fira Code name. No system config
     is included or changed. capture.py supplies an ephemeral XDG_CACHE_HOME.
     Menlo is the installed macOS fixed-pitch face; SVG cell geometry is kept. -->
<fontconfig>
  <dir>/System/Library/Fonts</dir>
  <cachedir prefix="xdg">fontconfig</cachedir>
  <match target="pattern">
    <test name="family" compare="eq"><string>Fira Code</string></test>
    <edit name="family" mode="assign" binding="strong"><string>Menlo</string></edit>
  </match>
  <alias>
    <family>monospace</family>
    <prefer><family>Menlo</family></prefer>
  </alias>
</fontconfig>
