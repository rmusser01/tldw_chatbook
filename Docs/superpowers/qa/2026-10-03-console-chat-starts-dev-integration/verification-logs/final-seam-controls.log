        builder = _ProfileContextBuilder()
    
        class _PreviewBridge:
            def __init__(self) -> None:
                self.calls = []
    
            @staticmethod
            def native_tool_schemas():
                return []
    
            def build_personal_context_preview_snapshot(self, **kwargs):
                self.calls.append(kwargs)
