        captured_followup, monkeypatch, interruption
    ):
        rig = captured_followup
        await rig.send("Find my archived conversations.")
        first_user = next(
            m
            for m in rig.store.messages_for_session(rig.source.id)
            if m.role is ConsoleMessageRole.USER
