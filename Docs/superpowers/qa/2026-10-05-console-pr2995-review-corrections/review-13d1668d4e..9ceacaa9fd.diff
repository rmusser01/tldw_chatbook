+    def __init__(self) -> None:
+        self.started = threading.Event()
+        self.release = threading.Event()
+
+    def __call__(self, **_kwargs):
+        self.started.set()
+        self.release.wait(30)
+        raise RuntimeError("image backend unreachable")
