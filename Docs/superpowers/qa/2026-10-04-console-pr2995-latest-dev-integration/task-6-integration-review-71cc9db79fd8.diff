+)
+EXPECTED_ROLLBACK_CONTRACT = tuple(
+    sorted(
+        ("_submit_draft_body", guards, _ROLLBACK_CALL)
+        for guards in (
+            ("echoed_user is not None", "thinking_block is not None"),
