     def catalog_key(sql):
         match = re.match(
             r'CREATE (?:UNIQUE |VIRTUAL )?(INDEX|TABLE|TRIGGER) (?:IF NOT EXISTS )?["`]?([^"` (]+)',
             sql,
         )
         assert match is not None
         return match[1].lower(), match[2]
 
