                 },
             }
 
         async def moved_exact(conversation_id: str, **_kwargs):
             assert conversation_id == "chat-a"
             return {
                 "items": [records[0]],
                 "pagination": {
                     "limit": 20,
                     "offset": 20,
                     "page": 2,
                     "total": 21,
                     "target_index": 20,
