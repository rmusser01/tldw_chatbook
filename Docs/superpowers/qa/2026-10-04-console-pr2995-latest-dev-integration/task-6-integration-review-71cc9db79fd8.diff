   ui-fast-lane:
     # TASK-32908. Until now `Tests/UI` -- 25,917 collected tests, the biggest
     # directory in the tree -- gated NOTHING on a pull request.
     #
     # It looks covered twice over and is covered neither time:
     #   * test.yml has a 12-shard `ui-tests` job, but that workflow is
     #     `on: push: branches: ["main"]` + workflow_dispatch. It does not accept
     #     pull_request events, so nothing in it is a PR gate.
     #   * nightly-deep.yml runs `pytest ./Tests/` on a schedule -- with no
     #     --continue-on-collection-errors, so one bad import aborts the session.
     #     It has been doing exactly that: run 35706024071 (2026-09-22) reported
     #     `collected 101851 items / 1 error` then `Interrupted`, ZERO tests
     #     executed, six consecutive nights.
     #
     # The whole directory cannot come into the gate: measured 25,917 tests /
     # ~5.5 CPU-hours. What comes in is a verified-green subset, listed in
     # scripts/ui_pr_gate_census.txt.
     #
     # Deliberately SERIAL and on the same minimal dependency set as
     # pr-fast-lane. No xdist, no pytest-randomly in requirements-test.txt, and
     # a pinned file ORDER -- so the run CI performs is the same run the census
     # was verified against. A gate whose green was only ever observed under a
     # different plugin set and a different test order is a gate that lands red,
     # and a red gate trains people to ignore it.
     #
     # Its own job rather than another step on pr-fast-lane: that lane measured
     # ~20 min against a 30-min cap, and spending its last headroom here would
     # make the required check fail on a timeout the first time either half grew.
+    #
+    # TASK-34353: the serial census itself then reached 14-19 min against this
+    # job's 20-min cap, and PRs adding census files timed out with zero failing
+    # tests (#2992 three times). So the census runs as round-robin shards
+    # (`check_ui_pr_gate_census.py --shard`): each shard is a subsequence of
+    # the census, in census order, on the same minimal dependency set. What
+    # changes is only which files run before a given file -- a file that needed
+    # a particular predecessor was relying on leaked state, which is a bug the
+    # split surfaces, not hides. Add a shard (not minutes) when one nears the cap.
     name: UI Fast Lane
     if: github.event_name == 'pull_request'
     runs-on: ubuntu-latest
     timeout-minutes: 20
+    strategy:
+      # Report every shard, so one red shard does not hide another.
+      fail-fast: false
+      matrix:
+        shard: [1, 2]
 
     steps:
       - uses: actions/checkout@v4
 
       - uses: actions/setup-python@v5
         with:
           python-version: '3.12'
           cache: pip
 
       # Same line as pr-fast-lane, on purpose: the census is verified against
       # this dependency set. Adding a package here can only be done by
       # re-verifying the census under it.
       - name: Install fast-lane dependencies
         run: python -m pip install -e . pytest pytest-asyncio pytest-timeout packaging
 
       - name: Run the gated Tests/UI slice
         run: |
           # Census order is the run order; see the checker for why it may not
-          # silently shrink.
-          mapfile -t UI_FILES < <(grep -vE '^\s*(#|$)' scripts/ui_pr_gate_census.txt)
-          echo "Gating ${#UI_FILES[@]} Tests/UI files."
-          pytest "${UI_FILES[@]}" \
+          # silently shrink. Written to a file first so a failing checker fails
+          # the step (bash -e) instead of yielding an empty list.
+          python scripts/check_ui_pr_gate_census.py --shard \
+            "${{ strategy.job-index }}" "${{ strategy.job-total }}" \
+            > "$RUNNER_TEMP/ui-shard.txt"
+          mapfile -t SHARD < "$RUNNER_TEMP/ui-shard.txt"
+          # An empty shard would make bare `pytest` collect the whole tree.
+          test "${#SHARD[@]}" -gt 0
+          echo "Gating shard $(( ${{ strategy.job-index }} + 1 ))/${{ strategy.job-total }}: ${#SHARD[@]} Tests/UI files."
+          pytest "${SHARD[@]}" \
             --timeout=180 \
             --tb=short
 
   derived-artifacts:
     # This job's name is the string the owner enters under branch protection ->
     # required status checks. Renaming it silently detaches the gate, so keep it
     # stable.
     name: Derived artifacts reproduce from their sources
     needs: [pr-fast-lane, ui-fast-lane]
     if: ${{ always() }}
     runs-on: ubuntu-latest
     timeout-minutes: 10
 
     steps:
       - uses: actions/checkout@v4
 
       - uses: actions/setup-python@v5
         with:
           # The Mermaid builder's immutable input manifest pins 3.12.11 byte
           # generation. No `cache: pip` -- nothing is installed.
           python-version: '3.12.11'
 
       - name: Require successful PR fast lane
         if: ${{ github.event_name == 'pull_request' && needs.pr-fast-lane.result != 'success' }}
         run: |
           echo "PR Fast Lane result: ${{ needs.pr-fast-lane.result }}"
           echo "::error::The required PR fast lane did not succeed."
           exit 1
 
       # TASK-32908: same shape as the step above. Without it the new UI job
       # would report its own red square while the REQUIRED check stayed green,
       # which is the "guard nobody is gated on" failure this workflow exists to
       # avoid.
       - name: Require successful UI fast lane
         if: ${{ github.event_name == 'pull_request' && needs.ui-fast-lane.result != 'success' }}
