+    forwarded: list = []
+
+    def capture(**kwargs):
+        forwarded.append(kwargs.get("api_key"))
+        return "captured"
+
+    monkeypatch.setattr(local, "_chat_with_openai_compatible_local_server", capture)
+
+    error = _outcome(
+        lambda: getattr(local, function_name)(MESSAGES, api_key=None, model="m")
+    )
