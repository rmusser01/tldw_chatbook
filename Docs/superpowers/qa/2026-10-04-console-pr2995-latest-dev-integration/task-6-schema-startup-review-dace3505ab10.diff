+    )
+    modern = (
+        "llama_cpp",
+        "koboldcpp",
+        "tabbyapi",
+        "tabby_api",
+        "vllm",
+        "ollama",
+        "custom",
+    )
+    config = {name: dict(section) for name in legacy}
+    config["api_settings"] = {name: dict(section) for name in modern}
+    return config
