+                    tuple(row)
+                    for row in connection.execute("SELECT * FROM messages ORDER BY id")
+                )
+                == before[1]
+            )
+            assert not connection.execute("PRAGMA foreign_key_check").fetchall()
+        finally:
+            db.close_connection()
+
