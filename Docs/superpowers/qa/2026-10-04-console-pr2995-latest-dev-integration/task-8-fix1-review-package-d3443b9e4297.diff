+            assert controller.request_chat_create_confirm(prepared) == {
+                "allow": True,
+                "remember": actor.kind == "primary",
+            }
+            assert len(cards) == (
+                0 if path == "remembered" and actor.kind == "primary" else 1
+            )
+    assert lock_states and not any(lock_states)
