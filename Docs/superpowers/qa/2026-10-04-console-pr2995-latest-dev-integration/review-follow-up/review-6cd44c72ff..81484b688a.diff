+    gh = FakeGh([_node(1, state="BLOCKED", threads=(True,))], checks={OLD: [_check()]})
+    assert _run(gh)[0][1].kind == "wait"
+    assert gh.calls == []
+
+
+def test_gh_argument_typing():
