+        _rebase(gh, pr, log)
+    elif action.kind in ("dispatch", "retry"):
+        dispatch(gh, REQUIRED_WORKFLOW, pr.head_ref, pr.number)
+        if action.kind == "retry":
+            comment_once(
+                gh, pr.number, "retry", pr.head_sha,
