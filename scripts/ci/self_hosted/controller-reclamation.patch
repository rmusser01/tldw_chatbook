+func TestRunOneReclaimsDeregisteredRunner(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		api := &fakeAPI{status: "online"}
+		vm := newFakeVM() // Guest never powers itself off.
+		defer vm.exit()
+		prov := &fakeProv{vm: vm}
+		p := testPool(api, prov)
+		done := make(chan error, 1)
+		go func() { done <- p.runOne(context.Background(), 0) }()
+		time.Sleep(50 * time.Millisecond)
+		api.setGetErr(fmt.Errorf("runner 42: %w", github.ErrNotFound))
+		time.Sleep(50 * time.Millisecond)
+		synctest.Wait()
+		select {
+		case err := <-done:
+			if err != nil {
+				t.Fatal(err)
+			}
+		default:
+			t.Fatal("deregistered runner left its guest alive")
+		}
+		if !vm.wasKilled() || prov.cleanedCount() != 1 {
+			t.Fatal("host must kill the uncooperative guest and remove its state")
+		}
+	})
+}
+
+func TestRunOnePreservesRunnerDuringTransientAPIError(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		api := &fakeAPI{status: "online"}
+		vm := newFakeVM()
+		defer vm.exit()
+		p := testPool(api, &fakeProv{vm: vm})
+		done := make(chan error, 1)
+		go func() { done <- p.runOne(context.Background(), 0) }()
+		time.Sleep(50 * time.Millisecond)
+		api.setGetErr(errors.New("temporary API outage"))
+		time.Sleep(time.Second)
+		synctest.Wait()
+		if vm.wasKilled() || vm.wasPowered() {
+			t.Fatal("API failure must not be treated as a missing runner")
+		}
+		api.setGetErr(nil)
+		time.Sleep(50 * time.Millisecond)
+		vm.exit()
+		if err := <-done; err != nil {
+			t.Fatal(err)
+		}
+	})
+}
