 def _rows_below_the_fold(canvas, widget) -> int:
     """How far ``widget`` starts past the canvas viewport's bottom edge."""
     fold = canvas.scroll_offset.y + canvas.container_size.height
     return widget.virtual_region.y - fold + 1
