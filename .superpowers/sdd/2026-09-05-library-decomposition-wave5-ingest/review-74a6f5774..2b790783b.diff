+    def _set_library_ingest_panels_collapsed(
+        self, groups: Sequence[str], collapsed: bool
+    ) -> None:
+        for group in groups:
+            try:
+                panel = self.query_one(f"#type-group-{group}", Collapsible)
+            except (NoMatches, QueryError):
